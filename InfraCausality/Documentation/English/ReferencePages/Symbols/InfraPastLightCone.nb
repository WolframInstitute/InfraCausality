Cell[TextData[{
 StyleBox["e", "TI"],
 " lies on the past light cone of ",
 StyleBox["v", "TI"],
 " exactly when ",
 StyleBox["v", "TI"],
 " lies on the future light cone of ",
 StyleBox["e", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"760e8948-2cec-41f8-9c4f-b7243bdeaa95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
     " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "v"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}], ",", " ", "e"}], "]"}], 
        " ", "===", "\n", "      ", 
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraFutureLightCone", "[", "e", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}], ",", " ", "v"}], "]"}]}]}],
       "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e98ffd6d-7977-4a92-ba7c-d35d30fdefc7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"37dfc2ac-6120-4865-853a-38d6ecee3822"]
}, Open  ]],

Cell[TextData[{
 "Every incoming ray ends at ",
 StyleBox["v", "TI"],
 " and passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLightRayQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
