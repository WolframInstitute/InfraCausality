Notebook[{

Cell[CellGroupData[{
Cell["InfraPastLightCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"777cb413-992c-4222-abb4-984d4d7d8b5a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPastLightCone"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraPastLightCone", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "338f5041-14eb-4508-b971-e94812c90b3c"],
 "\[LineSeparator]",
 "is the past light cone of the event ",
 StyleBox["v", "TI"],
 ": the events whose causal diamond with ",
 StyleBox["v", "TI"],
 " is a chain, carried by the incoming light rays of ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c56bc20f-94bf-47e4-99b9-8ae3e063ff42"],

Cell[TextData[{
 "Definition: the past light cone of an event ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 " : [",
 StyleBox["e", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "] is a chain}, the events of the causal past that reach ",
 StyleBox["v", "TI"],
 " along a single route. Its members, the incoming light rays of ",
 StyleBox["v", "TI"],
 ", are the maximal chains of ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") that end at ",
 StyleBox["v", "TI"],
 ", listed in causal order."
}], "Notes",ExpressionUUID->"607d5999-b8f8-43a4-a6f7-bca7db4115d9"],

Cell[TextData[{
 "The past light cone is the time reverse of the future light cone: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPastLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraPastLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ee02ef0-33b4-44f0-b7f0-bb85b0d284ec"],
 " on a graph is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc3adede-aaac-46b7-9d3c-5bed5b8b1d8c"],
 " on the graph with every edge reversed, with each ray read backwards. It \
holds the events that can send a light signal to ",
 StyleBox["v", "TI"],
 "; on the diamond lattice these are the two null lines below ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"be17fbff-aa68-438b-97d7-faee46ac1fc4"],

Cell[TextData[{
 "The head holds its event and computes nothing. Its graph, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f3b4d85-0e4b-47e7-b2ca-8781ebcb2b0e"],
 ", is the Hasse diagram restricted to ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 "), with the edge directions of the graph: a tree whose edges all lead into ",
 StyleBox["v", "TI"],
 ". Its leaf-to-root paths are the incoming light rays."
}], "Notes",ExpressionUUID->"8ee2dacf-4f48-4f32-9ec2-ca45fe40e018"],

