Cell["\<\
The past light cone of an event one slice below the top, on the diamond \
lattice, a sprinkling into two-dimensional Minkowski space and the cylinder \
lattice.\
\>", "ExampleText",ExpressionUUID->"513d8ea8-c807-4db3-aba3-ba2876c28a41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
               " ", "1"}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", " ", "v"}], 
         "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"972dab35-8824-48e4-9e47-8d96048687e4"],

