       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"180b2c9b-a322-4086-aaf0-b344dc8dc48c"],

