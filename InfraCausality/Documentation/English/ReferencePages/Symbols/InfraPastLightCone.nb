Cell["\<\
Both light cones of one event of the cylinder lattice. The future cone wraps \
around the cylinder; the past cone stops at the bottom row.\
\>", "ExampleText",ExpressionUUID->"7af7430e-82f1-46ef-95df-51e5d5ffe0aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraFutureLightCone", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraPastLightCone", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"84bb235c-9135-4419-9dc9-5ef02e40db3c"],

