}], "ExampleText",ExpressionUUID->"049972a9-f5a7-4493-9bf7-aca75482508d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rays", " ", "=", " ", 
          RowBox[{"RandomInfraPastLightCone", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", " ", "All"}], 
           "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"rays", ",", " ", 
           RowBox[{"ray", " ", "|->", " ", 
            RowBox[{
             RowBox[{"Last", "[", "ray", "]"}], " ", "===", " ", "v"}]}]}], 
          "]"}], " ", "&&", " ", 
         RowBox[{"InfraLightRayQ", "[", 
          RowBox[{"g", ",", " ", "rays"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
