Cell["\<\
The past light cone on a graph is the future light cone on the reversed \
graph, with every ray read backwards.\
\>", "ExampleText",ExpressionUUID->"041a4c7f-5ae4-4139-8785-680a06bf62ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", "\n", "      ", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"RandomInfraPastLightCone", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", " ", "All"}], 
           "]"}], "]"}], " ", "===", "\n", "        ", 
         RowBox[{"Sort", "[", 
          RowBox[{"Reverse", " ", "/@", " ", 
           RowBox[{"RandomInfraFutureLightCone", "[", 
            RowBox[{
             RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", 
             RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", " ", 
             "All"}], "]"}]}], "]"}]}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5d8b10ab-2c57-491b-b1af-49617d4d4c8b"],

