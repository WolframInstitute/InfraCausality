Cell[TextData[{
 StyleBox["e", "TI"],
 " lies on the past light cone of ",
 StyleBox["v", "TI"],
 " exactly when ",
 StyleBox["v", "TI"],
 " lies on the future light cone of ",
 StyleBox["e", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"7c45c9c6-dfe6-4615-86e3-fd42d9e4b675"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
     " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "v"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}], ",", " ", "e"}], "]"}], 
        " ", "===", "\n", "      ", 
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraFutureLightCone", "[", "e", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}], ",", " ", "v"}], "]"}]}]}],
       "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9b9f4de3-28a3-4ef7-a018-645872c3e324"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ef56cf70-8d69-4c1a-afe6-1a30d0482cd3"]
}, Open  ]],

Cell[TextData[{
 "Every incoming ray ends at ",
 StyleBox["v", "TI"],
 " and passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLightRayQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
