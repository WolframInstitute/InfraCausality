 "."
}], "ExampleText",ExpressionUUID->"784fd819-81f8-4847-a67b-6568939dfa39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rays", " ", "=", " ", 
          RowBox[{"RandomInfraPastLightCone", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPastLightCone", "[", "v", "]"}], ",", " ", "All"}], 
           "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"rays", ",", " ", 
           RowBox[{"ray", " ", "|->", " ", 
            RowBox[{
             RowBox[{"Last", "[", "ray", "]"}], " ", "===", " ", "v"}]}]}], 
          "]"}], " ", "&&", " ", 
         RowBox[{"InfraLightRayQ", "[", 
          RowBox[{"g", ",", " ", "rays"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
