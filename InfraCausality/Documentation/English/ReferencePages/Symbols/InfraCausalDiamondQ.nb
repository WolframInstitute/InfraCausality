Cell["\<\
Every nonempty diamond passes, and its least and greatest events are the \
corners it was built from.\
\>", "ExampleText",ExpressionUUID->"913c5326-5ef2-42c5-9202-83a1e1a2a062"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraCausalFuture", "[", 
         RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
        RowBox[{"q", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"diamond", " ", "=", " ", 
             RowBox[{"RandomInfraCausalDiamond", "[", 
              RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{"InfraCausalDiamondQ", "[", 
             RowBox[{"g", ",", " ", "diamond"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"diamond", ",", " ", 
               RowBox[{"e", " ", "|->", " ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"VertexOutComponent", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "diamond"}], 
                 "]"}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", "p", "}"}]}], " ", "&&", "\n", "          ", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"diamond", ",", " ", 
               RowBox[{"e", " ", "|->", " ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"VertexInComponent", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "diamond"}], 
                 "]"}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", "q", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c8690d49-6ece-4409-bf63-984723010f05"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d3a375d6-e7d0-49df-be90-b71ded0f17ec"]
}, Open  ]],

Cell["\<\
A set passes exactly when it is its own causal hull and the hull has a least \
and a greatest event. Checked on every set of at most three events of the \
sprinkling.\
\>", "ExampleText",ExpressionUUID->"df560cb6-0f2d-4c04-a3a9-491ac03fd2a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"set", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraCausalDiamondQ", "[", 
        RowBox[{"g", ",", " ", "set"}], "]"}], " ", "===", "\n", "      ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", "set", "]"}]}], "]"}], " ", "===",
           " ", 
          RowBox[{"Sort", "[", "set", "]"}]}], " ", "&&", "\n", "        ", 
         RowBox[{"AnyTrue", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"e", " ", "|->", " ", 
            RowBox[{"SubsetQ", "[", 
             RowBox[{
              RowBox[{"VertexOutComponent", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "set"}], 
             "]"}]}]}], "]"}], " ", "&&", " ", 
         RowBox[{"AnyTrue", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"e", " ", "|->", " ", 
            RowBox[{"SubsetQ", "[", 
             RowBox[{
              RowBox[{"VertexInComponent", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "set"}], 
             "]"}]}]}], "]"}]}], ")"}]}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ee501c3f-ca67-43a7-8cc0-a4566d4ac33e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"aa4b9154-5c48-40e0-bbb5-0775dab2e9ad"]
}, Open  ]],

Cell["\<\
A set that is both a causal future and a causal past is a diamond, and so is \
every light ray.\
\>", "ExampleText",ExpressionUUID->"90e011c6-d45a-4ca2-8656-6890c2918e44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"sets", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraCausalFutureQ", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&&", " ", 
             RowBox[{"InfraCausalPastQ", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",",
          " ", 
         RowBox[{
          RowBox[{"InfraCausalDiamondQ", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], " ", "&&",
        "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"v", " ", "|->", " ", 
          RowBox[{"InfraCausalDiamondQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"RandomInfraFutureLightCone", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], 
           "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
