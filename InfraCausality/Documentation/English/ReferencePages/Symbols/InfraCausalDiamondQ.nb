Cell["\<\
On each substrate: a causal diamond, the pair of its corners alone, and the \
union of the causal futures of two incomparable events.\
\>", "ExampleText",ExpressionUUID->"d6fc133d-168c-4f8a-85df-0668276430dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}], ",", " ", "2"}], 
          "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalDiamondQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"InfraCausalDiamondQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}], ",", "\n", "     ", 
       RowBox[{"InfraCausalDiamondQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalFuture", "[", "s", "]"}]}], "]"}]}], "]"}]}], 
      "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9dbed5d3-59ab-426c-ad56-128f4626825a"],

Cell[BoxData[
 RowBox[{"{", 
