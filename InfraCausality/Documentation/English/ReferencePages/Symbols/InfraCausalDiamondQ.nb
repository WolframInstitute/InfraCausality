Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["S", "TI"],
 " is a causal diamond when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", some ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["S", "TI"],
 " precedes every event of ",
 StyleBox["S", "TI"],
 ", some ",
 StyleBox["q", "TI"],
 " in ",
 StyleBox["S", "TI"],
 " follows every event of ",
 StyleBox["S", "TI"],
 ", and ",
 StyleBox["S", "TI"],
 " = [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 "). Order and repetition in the list do not matter."
}], "Notes",ExpressionUUID->"40ee6ad4-055e-4da4-8988-3a1dae722e63"],

Cell[TextData[{
 "The two extreme events are unique, so a diamond determines its endpoints. \
Having a least and a greatest element is not enough: the pair {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} of a comparable pair with events between them has both and is not a \
diamond, because it leaves out the events in between. The last condition is \
convexity: with any two of its events a diamond contains every event between \
them."
}], "Notes",ExpressionUUID->"4c2109e4-da0c-46c6-b666-ca884bed6338"],

Cell[TextData[{
 "The predicate takes a set, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamondQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalDiamond", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0659985-0e55-4121-8634-0cb821675bb4"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"0daeffd2-d7bd-48b4-9435-8056a2b93e92"],

Cell[TextData[{
 "The set predicates form a small hierarchy. A set that passes both ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFutureQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f9a6f0f-dd1b-49e6-a2f8-c2cee7339f0c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalPastQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "207bd683-088d-499e-be0a-59db61c40d71"],
 " is a diamond; a single event is the diamond [",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "]; and the events of a light ray are a diamond, since ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLightRayQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d91fe1e6-02ee-4fee-bb9c-d844b3da748c"],
 " says exactly that the diamond of the first and last events of the ray is \
the ray."
}], "Notes",ExpressionUUID->"d8389370-10d5-4a21-b33d-b51cbe8321f9"]
}, Open  ]],

