Cell["\<\
A list is a chain exactly when its events are pairwise comparable and listed \
in causal order, so every sublist of a chain is a chain. Checked on every \
subset of a worldline of each substrate.\
\>", "ExampleText",ExpressionUUID->"efa5f410-6074-4509-9be4-ec8b59d6e1d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"member", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"member", ",", " ", 
             RowBox[{"UpTo", "[", "8", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "Infinity"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraChainQ", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], " ", "&&",
        "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"member", ",", " ", 
             RowBox[{"UpTo", "[", "8", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"pair", " ", "|->", " ", 
          RowBox[{"!", " ", 
           RowBox[{"InfraChainQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Reverse", " ", "@", " ", "pair"}]}], "]"}]}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b19b1717-26b4-46c5-b47f-3128e8e630af"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7289d1c3-2d77-4ace-90cb-a21852fbad15"]
}, Open  ]],

Cell["\<\
The causal hull of a chain is the diamond of its first and last events.\
\>", "ExampleText",ExpressionUUID->"ea253d8d-8bcf-4c02-b575-1204e9177915"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraObserver", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"chain", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraChainQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "&&", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"RandomInfraCausalDiamond", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalDiamond", "[", "chain", "]"}]}], "]"}], " ", 
           "===", " ", 
           RowBox[{"RandomInfraCausalDiamond", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", "chain"}], ",", " ", 
             RowBox[{"Last", " ", "@", " ", "chain"}]}], "]"}]}]}]}]}], 
       "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bee3a86b-90aa-41b2-b12d-6b8a91339a6e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8b139591-4e8e-45ce-86c6-4adf1cf6d13d"]
}, Open  ]],

Cell["\<\
A chain and an antichain share at most one event: every slice of the \
universal foliation meets a chain at most once.\
\>", "ExampleText",ExpressionUUID->"d7d60c6e-03a8-4f7d-8949-4412f29c00c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraObserver", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{"{", 
          RowBox[{"members", ",", " ", 
           RowBox[{"UniversalFoliation", "[", "g", "]"}]}], "}"}], "]"}], ",",
         " ", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"chain", ",", " ", "slice"}], "}"}], " ", "|->", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"InfraChainQ", "[", 
            RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "&&", " ", 
           RowBox[{"InfraAntichainQ", "[", 
            RowBox[{"g", ",", " ", "slice"}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Intersection", "[", 
              RowBox[{"chain", ",", " ", "slice"}], "]"}], "]"}], " ", "<=", 
            " ", "1"}]}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3618aef2-903a-4005-b9b8-a3b901e59728"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f9cc4691-f5da-4914-8ab6-2b08591570f6"]
}, Open  ]]
}, Open  ]],

