Cell["\<\
A list of chains is tested chain by chain; a single event is a chain.\
\>", "ExampleText",ExpressionUUID->"298a1a2a-4a94-48ac-92ba-bb81f131ce3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "3"}], "]"}]}], 
        ")"}]}], "]"}], ",", " ", 
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"239b1cc7-8ec3-4d66-97df-41459f092132"],

