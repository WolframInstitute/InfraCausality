Cell["\<\
A chain on the diamond lattice that steps diagonally: it skips events, so it \
is a chain but not an observer.\
\>", "ExampleText",ExpressionUUID->"fb43262b-d341-4183-9da5-ee2b91654588"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chain", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "0", ",", " ", "6", ",", " ", "2"}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"chain", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", "chain"}], ",", " ", 
           RowBox[{"Last", " ", "@", " ", "chain"}]}], "]"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", "chain"}], "]"}], ",", " ", 
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", "chain"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"383c4071-a7e5-4940-8641-32ae6890ef3c"],

