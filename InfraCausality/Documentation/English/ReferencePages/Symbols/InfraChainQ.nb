Cell["\<\
On each substrate: every second event of a longest chain of the graph, the \
same events in reverse order, and the same events with the last one repeated.\
\
\>", "ExampleText",ExpressionUUID->"70931058-f998-4596-bcd1-fc6231e065c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"member", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"chain", " ", "=", " ", 
       RowBox[{"member", "[", 
        RowBox[{"[", 
         RowBox[{"1", " ", ";;", " ", 
          RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", "chain"}], "]"}], ",", " ", 
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Reverse", " ", "@", " ", "chain"}]}], "]"}], ",", " ", 
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"chain", ",", " ", 
           RowBox[{"Last", " ", "@", " ", "chain"}]}], "]"}]}], "]"}]}], 
      "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e27b2a0f-fa15-45ef-9433-86e18881fd04"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}], ",", 
