Cell[TextData[{
 "With ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "302f8636-5841-47fd-9efa-d0be2cbd5edc"],
 " the members come in the sorted order of their images, and the strict count \
of the whole cardinality enumerates them."
}], "ExampleText",ExpressionUUID->"1baf7946-e406-40a3-915b-362aaa104f16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraMessageFunction", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraMessageFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "10", ",", " ", 
      RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
     "]"}], " ", "===", "\n", "    ", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"RandomInfraMessageFunction", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], ",", 
      " ", "Values"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8f59970b-396a-465b-946d-5ad3b6edc6f2"],

