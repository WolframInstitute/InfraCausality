    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "625e2954-7722-4719-abda-42e10601d278"],
 "."
}], "ExampleText",ExpressionUUID->"5c25ace2-2887-4de4-a55f-82268670085e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"members", " ", "=", " ", 
         RowBox[{"RandomInfraMessageFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], ",",
         "\n", "     ", 
        RowBox[{"relation", " ", "=", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
             " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"position", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"b", ",", " ", 
           RowBox[{"Range", " ", "@", " ", 
            RowBox[{"Length", "[", "b", "]"}]}]}], "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMessageFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", "members"}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}], ",", " ", 
           RowBox[{"f", " ", "|->", " ", 
            RowBox[{"LessEqual", " ", "@@", " ", 
             RowBox[{"(", 
              RowBox[{"position", " ", "/@", " ", 
               RowBox[{"Values", "[", "f", "]"}]}], ")"}]}]}]}], "]"}]}]}], 
       " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"members", ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{"InfraMessageFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraMessageFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c86c893-7b72-4b02-b060-d9a1adf73053"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f803236a-43dd-45bd-be31-d3b45a296b34"]
}, Open  ]],

Cell[TextData[{
 "The count contract: a strict count above the cardinality gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a598c615-5270-46dd-972f-cf895825fde6"],
 ", ",
 Cell[BoxData["UpTo"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc55e75-d6a4-46b3-be72-c1510e3c4aed"],
 " caps at the cardinality, and a draw is reproducible under ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e072854-da87-4ea5-8c3b-41ae67e8086c"],
 "."
}], "ExampleText",ExpressionUUID->"8e8b76ab-1089-4ebf-9eed-6b5a1b3f0594"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"head", " ", "=", " ", 
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"card", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "head", ",", " ", "\"\<Cardinality\>\""}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInfraMessageFunction", "[", 
         RowBox[{"g", ",", " ", "head", ",", " ", 
          RowBox[{"card", " ", "+", " ", "1"}]}], "]"}], " ", "===", " ", 
        RowBox[{"{", "}"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"RandomInfraMessageFunction", "[", 
          RowBox[{"g", ",", " ", "head", ",", " ", 
           RowBox[{"UpTo", "[", 
            RowBox[{"card", " ", "+", " ", "5"}], "]"}]}], "]"}], "]"}], " ", 
        "==", " ", "card"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"RandomInfraMessageFunction", "[", 
           RowBox[{"g", ",", " ", "head", ",", " ", "card"}], "]"}], "]"}]}], 
        " ", "==", " ", "card"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraMessageFunction", "[", 
           RowBox[{"g", ",", " ", "head", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]}], ")"}], " ", "===", 
        " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraMessageFunction", "[", 
           RowBox[{"g", ",", " ", "head", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]}], ")"}]}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ac19d9c8-e6ff-4712-8541-442cdc76d7c2"],

