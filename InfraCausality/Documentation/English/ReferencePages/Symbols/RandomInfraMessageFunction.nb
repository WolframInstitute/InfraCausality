Cell["Experimental: selections.", "Notes",ExpressionUUID->"052568aa-d628-4006-832d-b112e8eb1863"],

Cell[TextData[{
 "Definition: the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMessageFunction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a1fc90-6d7b-4508-bbc6-a8930ca36886"],
 " are the monotone single-valued selections ",
 StyleBox["f", "TI"],
 " of the message relation ",
 StyleBox["M", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") \:2229 ",
 StyleBox["b", "TI"],
 ", defined on the ticks with ",
 StyleBox["M", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[NotEqual] \[EmptySet] (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c08a2b6-284d-4735-b801-201edb31948d"],
 "). They are the source-to-sink paths of a layered selection graph: one \
layer per tick with a message, one node per admissible image, and an edge \
between consecutive layers when the image does not move backwards on ",
 StyleBox["b", "TI"],
 ". The sampler draws these paths with the chain engine of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89d43b54-d512-4b8f-b871-96c1dceec6c7"],
 ", uniformly, by path-count weights, and reads each path back as an \
association."
}], "Notes",ExpressionUUID->"8383604f-c96e-4dea-b81e-622cfb3a8736"],

Cell["\<\
The count contract and the option are those of the chain samplers:\
\>", "Notes",ExpressionUUID->"be1d0b4b-4b8f-45a6-af81-033d99c61f51"],

