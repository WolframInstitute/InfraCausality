Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "deae8c38-8bde-4352-a3c3-eea10698f981"],
 " enumerates exactly the monotone selections of the relation, as many as the \
",
