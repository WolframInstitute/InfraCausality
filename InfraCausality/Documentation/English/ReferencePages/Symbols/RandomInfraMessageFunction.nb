Cell["\<\
The draws are uniform: 200 draws of the ten message functions between the \
cylinder observers.\
\>", "ExampleText",ExpressionUUID->"c7a876ec-d977-46ed-b0d7-f8d30ae5817a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraMessageFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}], ",", " ", "200"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"Values", " ", "/@", " ", "draws"}], "]"}]}]}], ",", " ", 
     RowBox[{"ChartStyle", " ", "->", " ", "StandardBlue"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<member\>\"", ",", " ", "\"\<draws\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"0368f8b2-6303-4887-8dd7-e4ec3898d8ca"],

