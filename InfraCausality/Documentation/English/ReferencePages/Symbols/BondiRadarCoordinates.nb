Cell[TextData[{
 "Radar time and radar distance are the half-sum and the half-difference of \
the emission and return arc lengths, and the radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa8a623b-6396-4341-a33e-830f33647999"],
 "."
}], "ExampleText",ExpressionUUID->"498dd009-6333-4ac4-8f25-d49c882bd1ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "+", " ", 
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
        RowBox[{"x", " ", 
         RowBox[{"Cot", "[", "phi", "]"}]}]}]}], "}"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0b5be87a-c3c6-4b3f-ad25-c17bbc96e137"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5ed06ce9-29cc-4a4c-b427-0479bb055418"]
}, Open  ]],

Cell["\<\
The rest worldline is at radar distance 0, and its radar time is its arc \
length.\
\>", "ExampleText",ExpressionUUID->"f40bbfbc-bf6c-4dcc-97fa-9d5c9b1b12f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"7", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], " ", "==", " ", 
         "y"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5dcbde47-cee8-4ca3-bd0f-17d9ced15c9a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"22e04890-2009-4951-a065-1646f59c8e0f"]
}, Open  ]],

Cell[TextData[{
 "The worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times radar time, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"1031552e-936d-4b50-b205-535595757574"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"Through", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
             RowBox[{"WorldlineAngle", "[", 
              RowBox[{
               RowBox[{"3", "/", "5"}], ",", " ", 
               RowBox[{"Pi", "/", "3"}]}], "]"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"3", "/", "5"}], " ", 
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", 
            RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}], "}"}]}], "]"}],
     ",", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e55b56eb-058b-4c3b-9d4f-57895e65b8f8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"313da090-5085-4727-b9d0-bb73f91ca9ee"]
}, Open  ]],

Cell["\<\
Moving along a rightgoing light ray keeps the emission arc length, and along \
a leftgoing one the return arc length.\
\>", "ExampleText",ExpressionUUID->"0e256781-88a0-4e21-a86b-b73181d0f74a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", "phi", "]"}], ",", " ", 
              RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}]}], ",", " ", 
          "phi"}], "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<EmitArcLength\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sin", "[", "phi", "]"}]}], ",", " ", 
              RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}]}], ",", " ", 
          "phi"}], "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", 
       " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9922a26a-2efb-4265-af75-ebca5d132758"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"b4c5bc72-950b-41bb-980c-1cca65a91886"]
