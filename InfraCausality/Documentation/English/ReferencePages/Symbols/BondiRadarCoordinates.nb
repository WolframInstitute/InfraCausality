     FontSize->0.9 Inherited,ExpressionUUID->
     "8ad16025-ea7a-4930-9722-1e7d1b918063"]], "TableText",ExpressionUUID->
     "d7683513-f6b6-4640-badd-2df2973b5a06"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c4a4eada-2824-4710-9f31-963d2be390af"], Cell[TextData[Cell[
    BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26af473f-c942-4193-8414-9964b08c891e"]], "TableText",ExpressionUUID->
     "ea809603-17f3-4e60-afae-3f3539b0f845"], Cell[TextData[StyleBox[
