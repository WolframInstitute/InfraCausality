Notebook[{

Cell[CellGroupData[{
Cell["BondiRadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ad699229-7916-47cc-a576-3929048894aa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", 
      StyleBox["y", "TI"]}], "}"}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "001986d3-0fbc-41c2-9fd5-58a7bcf856b8"],
 "\[LineSeparator]",
 "gives the radar time, the radar distance and the emission and return arc \
lengths of the plane event {",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 "} for the observer at rest, with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b846611e-7017-445a-8b20-5a0e4a4003f1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     StyleBox["y", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d946020-eeea-4a4f-ac4b-f78971d4e40d"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"ccbebe15-cafa-42d4-9b4d-b712d6a5278e"],

Cell[TextData[{
 "Definition: the observer at rest, the time axis, sends light at arc length ",
 StyleBox["e", "TI"],
 " that reaches the event and receives its echo at arc length ",
 StyleBox["r", "TI"],
 ". The radar time is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67637a44-7b80-4e31-b404-10141b0d5fbc"],
 " and the radar distance the half-difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", 
    StyleBox["e", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb3b895-e2dc-411b-bac4-1040828e9262"],
 ": Einstein's synchronisation with the speed of light 1. Since light runs at \
the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "=", 
   StyleBox["y", "TI"], "-", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8de7a4bf-6c53-4bc1-be4d-f20dc6cca8b9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["y", "TI"], "+", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d51f1b-0c53-4eee-8ee1-5b04fa89a8ff"],
 ", so the radar time is ",
 StyleBox["y", "TI"],
 " and the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "627463e7-09b7-4de0-bb76-72733d001167"],
 "."
}], "Notes",ExpressionUUID->"9de80deb-a75e-4961-a6f5-e2d8c22211ed"],

Cell["The result is an association:", "Notes",ExpressionUUID->"5c185e74-e23b-4943-86c0-b1b9bccac130"],

