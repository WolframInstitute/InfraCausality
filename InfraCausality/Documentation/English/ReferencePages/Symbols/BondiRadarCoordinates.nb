       FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
     
     FontSize->0.9 Inherited,ExpressionUUID->
     "daafe49b-8f3e-4c16-995e-bd98da9ca207"]], "TableText",ExpressionUUID->
     "31d5209f-2c65-4e0e-9fa5-c3f57eb24369"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f03e4310-c96e-4f41-848a-f5d95d57f054"], Cell[TextData[Cell[
    BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "354ee6d6-a218-48de-beca-f1755f3826ec"]], "TableText",ExpressionUUID->
