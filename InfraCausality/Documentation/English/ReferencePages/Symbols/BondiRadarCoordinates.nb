    BoxData["\"\<ReturnArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6800549f-42f5-443c-9607-737cb7cbc94a"]], "TableText",ExpressionUUID->
