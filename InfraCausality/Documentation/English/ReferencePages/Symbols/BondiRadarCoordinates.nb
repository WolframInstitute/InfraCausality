Notebook[{

Cell[CellGroupData[{
Cell["BondiRadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9a1b55c-9241-438e-b553-91ae3c2d55d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", 
      StyleBox["y", "TI"]}], "}"}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0349697b-8482-48d0-ac8c-f24b891b94f5"],
 "\[LineSeparator]",
 "gives the radar time, the radar distance and the emission and return arc \
lengths of the plane event {",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 "} for the observer at rest, with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7add957a-a7cb-488a-8d55-cb8afa2ba596"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     StyleBox["y", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d237f71a-3f8e-484c-a0d8-69ab6ec321f0"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"ede9c332-e5ab-42f4-8d27-6bfad97ced1d"],

Cell[TextData[{
 "Definition: the observer at rest, the time axis, sends light at arc length ",
 StyleBox["e", "TI"],
 " that reaches the event and receives its echo at arc length ",
 StyleBox["r", "TI"],
 ". The radar time is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddf8bb82-4667-4c24-b8d3-04fc96406306"],
 " and the radar distance the half-difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", 
    StyleBox["e", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9453b5b5-6877-40d7-b464-7a93467f3647"],
 ": Einstein's synchronisation with the speed of light 1. Since light runs at \
the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "=", 
   StyleBox["y", "TI"], "-", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31c617c9-9a90-43ea-a896-09e66f2c08d6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["y", "TI"], "+", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd673398-1081-4176-a24e-5ed39bf36992"],
 ", so the radar time is ",
 StyleBox["y", "TI"],
 " and the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36944edb-412d-4985-a0a6-8a668f53d01d"],
 "."
}], "Notes",ExpressionUUID->"e8c6c7b0-ce09-4a95-941d-3f7001843ad0"],

Cell["The result is an association:", "Notes",ExpressionUUID->"3dff16ed-9c3d-4c49-8410-01e099c3f11f"],

