     "b9a805e4-3af9-4dce-8a9d-f0f1ca81a4f7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f605d5cc-1603-4a34-a6a9-db6c230c8419"], Cell[TextData[Cell[
    BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "667f9e2d-28c8-4108-9b1f-193d0c63cd49"]], "TableText",ExpressionUUID->
