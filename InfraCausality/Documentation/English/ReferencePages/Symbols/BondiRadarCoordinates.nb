     "d7362427-ee4d-411a-9c9a-454b99a7e744"]], "TableText",ExpressionUUID->
     "4992850e-5a0f-4bd6-9a7f-efbf2667c004"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "62bb7916-57f1-4239-8512-3b09434372bd"], Cell[TextData[Cell[
    BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "95fc4819-a9f4-4d70-9d83-5e3344af3195"]], "TableText",ExpressionUUID->
