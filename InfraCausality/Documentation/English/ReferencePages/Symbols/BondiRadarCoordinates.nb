Cell[TextData[{
 "Radar time and radar distance are the half-sum and the half-difference of \
the emission and return arc lengths, and the radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "658e9ca6-da2c-4004-ba1e-c788f79b956c"],
 "."
}], "ExampleText",ExpressionUUID->"72b2d53e-490a-454f-a565-643047013f4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "+", " ", 
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
        RowBox[{"x", " ", 
         RowBox[{"Cot", "[", "phi", "]"}]}]}]}], "}"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a001b613-f26d-41e1-998a-1ca57424b0f1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a31436e1-b64b-44aa-9fec-015f3605fe7e"]
}, Open  ]],

Cell["\<\
The rest worldline is at radar distance 0, and its radar time is its arc \
length.\
\>", "ExampleText",ExpressionUUID->"b4ae18a3-8921-408c-bf30-0ee817014b6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"7", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], " ", "==", " ", 
         "y"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"63260393-3e10-48c3-a6ef-619b81670465"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b67524e1-9baf-4380-bc62-968eaab2b273"]
}, Open  ]],

Cell[TextData[{
 "The worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times radar time, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"6edb08ad-2d58-4e17-904e-ce61f311b509"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{
             RowBox[{"3", "/", "5"}], ",", " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"3", "/", "5"}], " ", 
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", 
            RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}], "}"}]}], "]"}],
     ",", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"318a0cbf-c604-4a83-b881-a974fad88106"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c38faeb2-b99c-4150-a1e8-f62dd7300406"]
}, Open  ]],

Cell["\<\
Moving along a rightgoing light ray keeps the emission arc length, and along \
a leftgoing one the return arc length.\
\>", "ExampleText",ExpressionUUID->"461c2cea-4490-430e-b9ad-2bd914a64425"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
         "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<EmitArcLength\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}],
          "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"7cfce856-55fa-4169-8003-cceee21ddb30"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"c5e56ab8-f456-4d92-8368-4764d0af7c0f"]
}, Open  ]]
}, Open  ]],

