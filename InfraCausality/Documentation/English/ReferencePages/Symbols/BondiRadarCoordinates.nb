fcde092671de"],

Cell[TextData[{
 "A negative ",
 StyleBox["x", "TI"],
 " gives a negative radar distance, the event on the left. The graph \
counterpart is the radar chart ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bba60c-4130-46e5-91f4-7fccd3c0d530"],
 " of the Infra Observers guide, which reads the same two numbers off the \
emission and reception ticks of an observer chain."
}], "Notes",ExpressionUUID->"36247eba-4a47-4dc0-83e7-6a77c6035ac9"]
}, Open  ]],

