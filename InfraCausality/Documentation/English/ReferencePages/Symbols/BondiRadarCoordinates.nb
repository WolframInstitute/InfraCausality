Cell["\<\
The event {1, 3} is reached by light sent at arc length 2 and echoed back at \
4.\
\>", "ExampleText",ExpressionUUID->"0066c544-f01e-47b0-b150-8187bdb21873"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BondiRadarCoordinates", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2a09fcfc-9458-4879-9cfc-232d97f400fc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RadarTime\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"EmitArcLength\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"ReturnArcLength\"\>", "\[Rule]", "4"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b49f4fab-d9df-4065-b943-f6d1caeb39e8"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/3 the radar time is the same and the radar \
distance shrinks by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b734bc-0fe9-4fa7-84b0-adf710a68d63"],
 "."
}], "ExampleText",ExpressionUUID->"ba822dcc-5d16-4f60-8f40-8b5a83ffc05e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BondiRadarCoordinates", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Pi", "/", "3"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7442b69c-9a7c-4c23-bc23-582e76db4c98"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RadarTime\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
    FractionBox["1", 
     SqrtBox["3"]]}], ",", 
   RowBox[{"\<\"EmitArcLength\"\>", "\[Rule]", 
    RowBox[{"3", "-", 
     FractionBox["1", 
      SqrtBox["3"]]}]}], ",", 
   RowBox[{"\<\"ReturnArcLength\"\>", "\[Rule]", 
    RowBox[{"3", "+", 
     FractionBox["1", 
      SqrtBox["3"]]}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9f08f8a1-3d21-42e8-ac42-fcfec33cda69"]
}, Open  ]]
}, Open  ]],

