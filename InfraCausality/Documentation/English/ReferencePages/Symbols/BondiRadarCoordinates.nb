Cell["\<\
The event {1, 3} is reached by light sent at arc length 2 and echoed back at \
4.\
\>", "ExampleText",ExpressionUUID->"7b6a968a-54a2-4ab9-806c-08a4a5ba9cf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BondiRadarCoordinates", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d54cf96-01fb-4dd4-a9dc-361badbd58f3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RadarTime\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"EmitArcLength\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"ReturnArcLength\"\>", "\[Rule]", "4"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e69a1cc0-74f6-44a0-8f78-8242942e2fc1"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/3 the radar time is the same and the radar \
distance shrinks by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2111768d-d4ce-4cd2-8373-850aba7470c9"],
 "."
}], "ExampleText",ExpressionUUID->"f0dac875-c350-4712-9eff-e158efedd64f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BondiRadarCoordinates", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Pi", "/", "3"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0de19a69-52f1-4645-a663-689c0ce58dbd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RadarTime\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
    FractionBox["1", 
     SqrtBox["3"]]}], ",", 
   RowBox[{"\<\"EmitArcLength\"\>", "\[Rule]", 
    RowBox[{"3", "-", 
     FractionBox["1", 
      SqrtBox["3"]]}]}], ",", 
   RowBox[{"\<\"ReturnArcLength\"\>", "\[Rule]", 
    RowBox[{"3", "+", 
     FractionBox["1", 
      SqrtBox["3"]]}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"186cd4a4-324c-4a06-8e7c-241ff865c19b"]
}, Open  ]]
}, Open  ]],

