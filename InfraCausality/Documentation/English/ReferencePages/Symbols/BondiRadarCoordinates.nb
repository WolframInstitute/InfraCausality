Cell[TextData[{
 "Radar time and radar distance are the half-sum and the half-difference of \
the emission and return arc lengths, and the radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e7ce030-4118-4676-aff9-2626be7f47e1"],
 "."
}], "ExampleText",ExpressionUUID->"ab56ff26-6955-4111-9171-fedae29ba50d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "+", " ", 
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
        RowBox[{"x", " ", 
         RowBox[{"Cot", "[", "phi", "]"}]}]}]}], "}"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e2ceaa17-ee89-4d74-b74c-7eccf0075853"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"651517db-0399-484b-963b-9d4a5a8a1499"]
}, Open  ]],

Cell["\<\
The rest worldline is at radar distance 0, and its radar time is its arc \
length.\
\>", "ExampleText",ExpressionUUID->"a03fb2e0-b6ef-4dc3-b079-0d600c4b6a7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"7", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], " ", "==", " ", 
         "y"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8c8cf83f-549e-44e7-8ae7-dee4c1ff5ee3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3a52b9e1-94df-4ebe-a9a4-465cc9de4f21"]
}, Open  ]],

Cell[TextData[{
 "The worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times radar time, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"80bfb605-c77c-47f9-a422-e7340c5c62c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{
             RowBox[{"3", "/", "5"}], ",", " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"3", "/", "5"}], " ", 
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", 
            RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}], "}"}]}], "]"}],
     ",", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c55fc020-5642-474c-b7ff-b91b75e1655e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"ee959382-adb5-456d-b7d7-8b2450ca91d9"]
}, Open  ]],

Cell["\<\
Moving along a rightgoing light ray keeps the emission arc length, and along \
a leftgoing one the return arc length.\
\>", "ExampleText",ExpressionUUID->"da4a5468-e490-48d8-98ab-616753a73f86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
         "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<EmitArcLength\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}],
          "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b3a92f75-c322-4b87-b262-a9f01d783896"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"4ae65a32-8bf4-4807-b409-262e1ffd4e99"]
}, Open  ]]
}, Open  ]],

