Cell[TextData[{
 "Radar time and radar distance are the half-sum and the half-difference of \
the emission and return arc lengths, and the radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1053ad9b-ee2d-4b84-aeeb-7bc4a4891518"],
 "."
}], "ExampleText",ExpressionUUID->"9672a82e-7ee8-47de-bb66-b921dd2ab733"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "+", " ", 
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
        RowBox[{"x", " ", 
         RowBox[{"Cot", "[", "phi", "]"}]}]}]}], "}"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"494826ef-af4b-4a66-847b-5a6316b5870b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c00f8c62-c0d0-406c-8e24-618d47e6497f"]
}, Open  ]],

Cell["\<\
The rest worldline is at radar distance 0, and its radar time is its arc \
length.\
\>", "ExampleText",ExpressionUUID->"1649a5e1-5a28-471b-a8d2-0666248048ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"7", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], " ", "==", " ", 
         "y"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"608b07c2-3c1e-4801-9a5e-393ce026cd72"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"86cd2dd1-2bd0-4236-a483-2a2b004656e1"]
}, Open  ]],

Cell[TextData[{
 "The worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times radar time, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"22b48324-08ff-4a51-9671-42b5d01d599d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{
             RowBox[{"3", "/", "5"}], ",", " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"3", "/", "5"}], " ", 
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", 
            RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}], "}"}]}], "]"}],
     ",", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ad2b381b-f6a0-42e1-96b3-3e4e4149ba5a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"8adc6190-a82a-4577-9a4e-02d11c440f4a"]
}, Open  ]],

Cell["\<\
Moving along a rightgoing light ray keeps the emission arc length, and along \
a leftgoing one the return arc length.\
\>", "ExampleText",ExpressionUUID->"1d1acbb8-3de8-4aca-a814-dcf795bd462e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
         "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<EmitArcLength\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}],
          "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"608be87f-d90a-4af4-9123-64d269f6f1b7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0a4e107a-aab4-44ef-b6ac-1cbef0c58391"]
}, Open  ]]
}, Open  ]],

