Notebook[{

Cell[CellGroupData[{
Cell["BondiRadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d093c1e-fe9f-45ba-8e84-d1f23c28c65c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", 
      StyleBox["y", "TI"]}], "}"}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1bd027c-aaf6-4402-96d8-81ea3eb0045f"],
 "\[LineSeparator]",
 "gives the radar time, the radar distance and the emission and return arc \
lengths of the plane event {",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 "} for the observer at rest, with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c24756c7-5b94-4b4b-a960-7465528d0471"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     StyleBox["y", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4a85427-ddd8-4c37-a773-3f3174505dec"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"1bac96f4-0674-4cd5-a048-1dc9cdbfd7e3"],

Cell[TextData[{
 "Definition: the observer at rest, the time axis, sends light at arc length ",
 StyleBox["e", "TI"],
 " that reaches the event and receives its echo at arc length ",
 StyleBox["r", "TI"],
 ". The radar time is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff82af6b-075f-4f8b-b938-832f06a1ec21"],
 " and the radar distance the half-difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", 
    StyleBox["e", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f059016c-9b23-4c08-9844-6a079ff0a336"],
 ": Einstein's synchronisation with the speed of light 1. Since light runs at \
the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "=", 
   StyleBox["y", "TI"], "-", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67fed62b-5fac-40d5-9518-648f25f00db7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["y", "TI"], "+", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b97cbf57-c951-4921-b031-ca1813feb627"],
 ", so the radar time is ",
 StyleBox["y", "TI"],
 " and the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6372344c-fba8-4cc0-b3e3-b4e60c7988e2"],
 "."
}], "Notes",ExpressionUUID->"6d4ea9c0-a7da-449c-83f9-7de5f28af70b"],

Cell["The result is an association:", "Notes",ExpressionUUID->"46eaa940-12f0-41f9-8433-c9a17d3ec341"],

