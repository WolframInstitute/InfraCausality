     "8326e72a-c6ab-49e4-9326-1c35a0403380"]], "TableText",ExpressionUUID->
     "e1bbd242-6a5f-41e9-9e73-4d9757efa077"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "22a03547-7438-460c-be12-1f81faac5e2a"], Cell[TextData[Cell[
    BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f6c3c914-9c2a-4809-ab64-ca9195b58e85"]], "TableText",ExpressionUUID->
