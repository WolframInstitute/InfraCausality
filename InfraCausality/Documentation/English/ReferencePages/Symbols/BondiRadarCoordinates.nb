Notebook[{

Cell[CellGroupData[{
Cell["BondiRadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"33fbd533-9c65-4236-85f7-56fa295ed8e7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", 
      StyleBox["y", "TI"]}], "}"}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5de828-1cce-4eca-b861-7952b43d6a2a"],
 "\[LineSeparator]",
 "gives the radar time, the radar distance and the emission and return arc \
lengths of the plane event {",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 "} for the observer at rest, with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8b637e20-72a4-4365-8614-b85d2a62b0e0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     StyleBox["y", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "127342c6-8f79-411e-8a5a-f04c01336bba"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"3a85feab-9367-4fb0-8dfb-c1e43bb5a843"],

Cell[TextData[{
 "Definition: the observer at rest, the time axis, sends light at arc length ",
 StyleBox["e", "TI"],
 " that reaches the event and receives its echo at arc length ",
 StyleBox["r", "TI"],
 ". The radar time is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afb70d81-c6c9-4816-bfe8-a8813dded1ab"],
 " and the radar distance the half-difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", 
    StyleBox["e", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65af67cd-036c-4091-97eb-927568444716"],
 ": Einstein's synchronisation with the speed of light 1. Since light runs at \
the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "=", 
   StyleBox["y", "TI"], "-", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b82577d5-8359-437d-941f-fc349d5821d0"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["y", "TI"], "+", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca4b5f3e-d35b-48d9-acdd-73107279a9af"],
 ", so the radar time is ",
 StyleBox["y", "TI"],
 " and the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d36bd89-c2af-4f61-baaf-3f720ed1ceb3"],
 "."
}], "Notes",ExpressionUUID->"1fb1fcb5-1a19-4b42-9ac6-d611297f4f86"],

Cell["The result is an association:", "Notes",ExpressionUUID->"3f24b202-964c-407b-b670-03449b8fdd60"],

