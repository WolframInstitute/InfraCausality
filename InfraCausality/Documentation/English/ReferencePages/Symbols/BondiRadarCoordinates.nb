Notebook[{

Cell[CellGroupData[{
Cell["BondiRadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eb19fdc2-4df1-40a6-8c70-53b34fe45c45"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", 
      StyleBox["y", "TI"]}], "}"}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fa38c5f-350b-4f39-a1b9-7368e7bccecc"],
 "\[LineSeparator]",
 "gives the radar time, the radar distance and the emission and return arc \
lengths of the plane event {",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 "} for the observer at rest, with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"63ef3354-cd1d-462a-be10-145feb3095a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiRadarCoordinates"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     StyleBox["y", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d1b0bf8-0b35-44fb-aced-906ea48e3aba"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"60fee0ee-e630-4213-8659-e0c2d72c56a8"],

Cell[TextData[{
 "Definition: the observer at rest, the time axis, sends light at arc length ",
 StyleBox["e", "TI"],
 " that reaches the event and receives its echo at arc length ",
 StyleBox["r", "TI"],
 ". The radar time is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5292dd69-e77c-4352-a43e-f519eb37f8d0"],
 " and the radar distance the half-difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", 
    StyleBox["e", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "527cd73e-bf50-41df-99ca-2230aa2f2b4d"],
 ": Einstein's synchronisation with the speed of light 1. Since light runs at \
the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "=", 
   StyleBox["y", "TI"], "-", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa26036c-5cc2-4e7f-b4f6-11c5832b40dc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["y", "TI"], "+", 
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58384571-3a2f-4c16-bf51-bccd13aea5df"],
 ", so the radar time is ",
 StyleBox["y", "TI"],
 " and the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b838cea3-d4c6-4a81-a281-bb0798b4473e"],
 "."
}], "Notes",ExpressionUUID->"7b022474-b579-464b-b3dd-9ea44982b338"],

Cell["The result is an association:", "Notes",ExpressionUUID->"04fde191-5d21-4d3b-98a7-112620f712cf"],

