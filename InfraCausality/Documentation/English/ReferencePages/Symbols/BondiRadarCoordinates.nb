Cell[TextData[{
 "A negative ",
 StyleBox["x", "TI"],
 " gives a negative radar distance, the event on the left. The graph \
counterpart is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdd5c8ab-4632-40d0-91f9-03dd07ce7f44"],
 " of the EPS Axiomatics guide, which reads the same two numbers off the \
emission and reception ticks of an observer chain."
}], "Notes",ExpressionUUID->"3213772a-cb25-4feb-a560-ea78c1ff1dc6"]
}, Open  ]],

