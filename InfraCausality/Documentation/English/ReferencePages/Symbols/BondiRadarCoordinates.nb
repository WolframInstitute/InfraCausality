Cell[TextData[{
 "Radar time and radar distance are the half-sum and the half-difference of \
the emission and return arc lengths, and the radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f42a078-9b92-40a6-bb9b-903b2afda499"],
 "."
}], "ExampleText",ExpressionUUID->"277b8b3f-b294-4ab3-a133-8860b6c7e301"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "+", " ", 
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
         RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
        RowBox[{"x", " ", 
         RowBox[{"Cot", "[", "phi", "]"}]}]}]}], "}"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b476dd00-ef22-4fb5-b4bb-b0a138d66a40"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a69f6f58-79c9-4321-81fa-83f8f51bdcde"]
}, Open  ]],

Cell["\<\
The rest worldline is at radar distance 0, and its radar time is its arc \
length.\
\>", "ExampleText",ExpressionUUID->"90aefe5e-c339-4c7c-9362-eaf33b86df50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"7", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], " ", "==", " ", 
         "y"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d0f62f7c-8536-4195-a062-b4f7ced2f424"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"082c9b57-bdfb-4409-9a42-779007ee1303"]
}, Open  ]],

Cell[TextData[{
 "The worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times radar time, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"a51c9987-04ef-4fc3-8b1c-2c00db27eb5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{
             RowBox[{"3", "/", "5"}], ",", " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"3", "/", "5"}], " ", 
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", 
            RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}], "}"}]}], "]"}],
     ",", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"45bb33de-ead5-45eb-9674-5599ce20a087"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"5c5038ea-758b-4daa-a49b-9ad613b25153"]
}, Open  ]],

Cell["\<\
Moving along a rightgoing light ray keeps the emission arc length, and along \
a leftgoing one the return arc length.\
\>", "ExampleText",ExpressionUUID->"3fcfc92f-5663-4c5f-9cbb-5a0f103631b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
         "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<EmitArcLength\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
           RowBox[{"l", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}],
          "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
        "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"7afd2244-f97e-4d96-84e2-4d7649215cb2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"b862d254-7a31-4045-a6c0-979d398d635a"]
}, Open  ]]
}, Open  ]],

