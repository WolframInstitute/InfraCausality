     FontSize->0.9 Inherited,ExpressionUUID->
     "fd0ab0bd-4537-4b6f-a17a-75b6bf711e7e"]], "TableText",ExpressionUUID->
     "b9887db6-0b6c-4a9b-987d-16e8e8ea69e2"], Cell[TextData[StyleBox[
