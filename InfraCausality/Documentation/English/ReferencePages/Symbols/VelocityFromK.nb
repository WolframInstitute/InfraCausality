Cell["\<\
The k-factor 2 is the velocity 3/5, and its inverse the velocity \[Minus]3/5.\
\
\>", "ExampleText",ExpressionUUID->"60ab25bd-c2fc-4577-886b-813ef37b113a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"VelocityFromK", "[", "2", "]"}], ",", " ", 
   RowBox[{"VelocityFromK", "[", 
    RowBox[{"1", "/", "2"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"033e4950-8cbf-4e6e-bfd5-87d2a7c1cdc3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["3", "5"], ",", 
   RowBox[{"-", 
    FractionBox["3", "5"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cf49954d-f8a3-44b1-b8ad-f91a172677d5"]
}, Open  ]],

Cell[TextData[{
 "The velocity over the k-factor: it tends to the speed of light as ",
 StyleBox["k", "TI"],
 " grows."
}], "ExampleText",ExpressionUUID->"786590b9-a5b3-47d0-a326-9b3aa96a1605"],

