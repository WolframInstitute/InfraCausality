Cell[TextData[{
 Cell[BoxData["VelocityFromK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "459ad538-cad2-4ca0-8b07-df947bb394be"],
 " inverts ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "258f0132-51c5-4fde-bb3d-073adf798b4e"],
 "."
}], "ExampleText",ExpressionUUID->"0e16f05f-2a4a-4add-8353-468ccaca4692"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VelocityFromK", "[", 
      RowBox[{"KFactor", "[", "v", "]"}], "]"}], " ", "==", " ", "v"}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"KFactor", "[", 
      RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", 
     "k"}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", 
    " ", 
    RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f38201c2-1e28-4b64-829e-3f33233a81f0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"adb4d4e6-6b31-4f67-a30e-9d9ba2a74b49"]
}, Open  ]],

Cell["Inverting the k-factor reverses the velocity.", "ExampleText",ExpressionUUID->"f4c86c0c-3154-4898-b2ea-0c3d8c1c2471"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"VelocityFromK", "[", 
    RowBox[{"1", "/", "k"}], "]"}], " ", "==", " ", 
   RowBox[{"-", 
    RowBox[{"VelocityFromK", "[", "k", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b1fa014a-ea4e-4587-bcd9-e5473ff64267"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"13e5b0dc-f1ae-40d4-b21e-f6e0b232a159"]
}, Open  ]],

Cell["\<\
The velocity of the product of two k-factors is the relativistic sum of their \
velocities.\
\>", "ExampleText",ExpressionUUID->"018e820a-918b-4c31-bee0-3f19f4ba6091"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"VelocityFromK", "[", 
     RowBox[{
      RowBox[{"KFactor", "[", "v1", "]"}], " ", 
      RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"eb9906e1-fba5-4c6a-865c-603a4520e2d4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"4c63c8e7-65e9-47b8-9d34-4546b54db731"]
}, Open  ]],

Cell[TextData[{
 "The radar distance and the radar time of the echo at ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "823e1a89-09c6-48d6-980e-fc346822b6ce"],
 " have the ratio ",
 Cell[BoxData[
  RowBox[{"VelocityFromK", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7678e2-d025-4b6e-94c8-e1d86d6061c5"],
 "."
}], "ExampleText",ExpressionUUID->"b68f5088-39bd-49a7-bdd7-9eb65baacd1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
       RowBox[{"T", "/", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
       RowBox[{"T", "/", "2"}]}], ")"}]}], " ", "==", " ", 
    RowBox[{"VelocityFromK", "[", "k", "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"T", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
