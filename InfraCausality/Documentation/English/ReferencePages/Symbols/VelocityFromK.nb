Notebook[{

Cell[CellGroupData[{
Cell["VelocityFromK", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1be077ff-1cc7-462b-8fdc-2a8ccad88975"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62518a71-bed2-4b60-9602-d1c043b94f79"],
 "\[LineSeparator]",
 "gives the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21a2c8ef-8c31-40cd-b999-e47b5e702c9b"],
 " of the Bondi factor ",
 StyleBox["k", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c80ca715-aba9-4865-a950-71ad1cd8210d"],

Cell[TextData[{
 "Definition: the velocity ",
 StyleBox["v", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0dbdec0-70b9-446b-8edb-18019d9b61f8"],
 " = ",
 StyleBox["k", "TI"],
 ". Solving ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3ccc1a1-8b99-4260-9103-ddf03e8bb8d0"],
 " for ",
 StyleBox["v", "TI"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa43de7-8f28-4a04-9d85-0d65ccfbeeb9"],
 ", a velocity in (\[Minus]1, 1) for every ",
 StyleBox["k", "TI"],
 " > 0, in units with the speed of light 1."
}], "Notes",ExpressionUUID->"38100232-04c4-4052-b598-7fad48ff1994"],

Cell[TextData[{
 "Radar reads the velocity this way: an observer who sends a signal at proper \
time ",
 StyleBox["T", "TI"],
 " and receives its echo at ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e786189-d6bc-4cc1-ba4b-31833fbff8cf"],
 " assigns the reflecting observer the radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe9e6721-be74-4d64-bb67-1c22c674a055"],
 " at the radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a542686-ea5b-4770-b4cf-419dc4a88661"],
 ", whose ratio is the velocity."
}], "Notes",ExpressionUUID->"b362277b-7f11-45af-bdac-498ad0474737"],

Cell[TextData[{
 "The relativistic sum of two velocities is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"KFactor", "[", 
     StyleBox["v1", "TI"], "]"}], " ", 
    RowBox[{"KFactor", "[", 
     StyleBox["v2", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cbefeb-a3f7-4dd6-8849-8e7b99257205"],
 ", since k-factors multiply."
}], "Notes",ExpressionUUID->"9071e336-63b5-4755-a4c9-b1233d83b440"]
}, Open  ]],

