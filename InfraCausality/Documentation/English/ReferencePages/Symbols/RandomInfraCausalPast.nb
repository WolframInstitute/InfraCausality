Cell[TextData[{
 "The proper-time cuts of the causal past of the top event of the sprinkling, \
at ",
 StyleBox["t", "TI"],
 " = 1, 3 and 5."
}], "ExampleText",ExpressionUUID->"d751825f-3395-4ec8-9fb6-c14f843d11cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", 
           RowBox[{"Max", " ", "@", " ", 
            RowBox[{"UniversalTime", " ", "@", " ", "g"}]}], "]"}]}], 
         "]"}]}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraCausalPast", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalPast", "[", 
             RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", "v"}], 
         "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"8728457b-a5f1-4353-b803-d921e70365e7"],

