Cell[TextData[{
 "Definition: a causal past denotes one vertex set, its support ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 "}, the events from which ",
 StyleBox["v", "TI"],
 " can be reached, ",
 StyleBox["v", "TI"],
 " included. The sampler returns that support as a sorted vertex list, the \
keys of ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalPast", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a0c1862-fe71-4387-86f4-f0ee4a98aae2"],
 "."
}], "Notes",ExpressionUUID->"36c5343a-9d17-4bb9-8715-b6f8baf445cd"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f90d6d9-76b7-4c8c-b2ec-fb40bdaab0ed"],
 " sampler shares. With a single member it reads:"
}], "Notes",ExpressionUUID->"e100fdcf-c246-465e-a213-f2665b9b5643"],

