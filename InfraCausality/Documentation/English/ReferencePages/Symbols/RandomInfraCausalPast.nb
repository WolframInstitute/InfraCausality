Cell[TextData[{
 "The draw involves no randomness. The option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f46f6db3-9271-431f-9e26-783c90a12e61"],
 " is accepted with the values of the chain samplers and changes nothing \
here; ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomChoice"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f281df-d5b9-47b9-920f-8254937b7520"],
 " together with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd78893a-f73a-46af-ba21-356f811b443e"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"8573964e-95a6-4e28-a3b9-2c9cb839dc9f"],

Cell[TextData[{
 "The anchor may be an event, a set of events, whose causal past is the union \
of theirs, or a chain. The cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4fa7d63-246c-4019-93d1-85addf5ff571"],
 " keeps the events of ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") from which ",
 StyleBox["v", "TI"],
 " is reached within proper time ",
 StyleBox["t", "TI"],
 ". The past is the future of the time-reversed graph: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce43bf81-122a-43c3-b1df-13f3ed2740f3"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"`ReverseGraph`", "[", 
     StyleBox["g", "TI"], "]"}], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac583e8f-345b-4582-a492-9c8a3de9a080"],
 "."
}], "Notes",ExpressionUUID->"ab0518c0-9d6d-4380-819a-b4e6c07730f5"],

