Cell[TextData[{
 "The support is the in-component of the event, it passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalPastQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17fbcff4-1109-40b5-9455-3258d1f9d413"],
 ", and its size is the causal volume of the head."
}], "ExampleText",ExpressionUUID->"c64f9f8c-2d83-442a-9a6f-5238dc9d5275"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"past", " ", "=", " ", 
             RowBox[{"RandomInfraCausalPast", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "v", "]"}]}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{"past", " ", "===", " ", 
             RowBox[{"Sort", "[", 
              RowBox[{"VertexInComponent", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"{", "v", "}"}]}], "]"}], "]"}]}], " ", "&&", " ", 
            RowBox[{"InfraCausalPastQ", "[", 
             RowBox[{"g", ",", " ", "past"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Length", "[", "past", "]"}], " ", "==", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
               " ", "\"\<CountingMeasure\>\""}], "]"}]}]}]}], "]"}]}]}], 
       "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7ca006ce-e6ea-4af1-86ac-5c301fbb2566"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"59a297ac-ecde-444e-bcfd-4627bb05bf21"]
}, Open  ]],

Cell["\<\
The causal past on a graph is the causal future on the reversed graph, cut \
for cut.\
\>", "ExampleText",ExpressionUUID->"18bf2b93-0685-4952-88f9-d6a418d323cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"t", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{"RandomInfraCausalPast", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", 
                RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}], " ", "===", " ", 
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{
               RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", 
               RowBox[{"InfraCausalFuture", "[", 
                RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}]}]}]}], "]"}]}]}],
        "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a4e0ed33-a0d1-430e-a29d-2e16f62f5ada"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c57a01bb-57e7-45fa-808e-bb14f5d35e39"]
}, Open  ]],

Cell[TextData[{
 "An event ",
 StyleBox["u", "TI"],
 " lies in the causal past of ",
 StyleBox["v", "TI"],
 " exactly when ",
 StyleBox["v", "TI"],
 " lies in the causal future of ",
 StyleBox["u", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"d197c6a5-6fd8-4fb0-9dca-bc9cacc844e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
        " ", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], " ", "|->", "\n", "      ", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalPast", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", "u"}], "]"}], 
           " ", "===", " ", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "u"}], "]"}], ",", " ", "v"}], "]"}]}]}],
          "]"}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"59a3367b-6e8f-4967-a85c-dc0f7a983f75"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"dd0e1500-e51d-4396-8403-850bd324104c"]
}, Open  ]]
