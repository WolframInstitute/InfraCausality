Cell["The k-factor form equals the familiar one.", "ExampleText",ExpressionUUID->"9551198a-385e-4ae6-8b3a-080ba1fc0111"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"LorentzGamma", "[", "v", "]"}], " ", "==", " ", 
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"v", "^", "2"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"61ab63d6-5bf5-4fa2-841d-d197168fd07a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"85609359-48bc-4335-b4e1-a7e65993323c"]
}, Open  ]],

Cell["The Lorentz factor is the hyperbolic cosine of the rapidity.", \
"ExampleText",ExpressionUUID->"82645b97-ff88-461e-a1ba-cac96f503e73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"LorentzGamma", "[", "v", "]"}], " ", "==", " ", 
    RowBox[{"Cosh", "[", 
     RowBox[{"Rapidity", "[", "v", "]"}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<", " ", "v", " ", "<", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4b0eaf3a-53a2-4d9d-aa36-f729cb2170e1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"eb0add99-4050-409b-9f80-e6658bbd8aa4"]
}, Open  ]],

Cell[TextData[{
 "On the worldline of velocity ",
 StyleBox["v", "TI"],
 ", drawn with light at any angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", the radar time of the event at arc length ",
 StyleBox["s", "TI"],
 " is \[Gamma] times its proper time ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"ProperTimeScale", "[", 
    RowBox[{
     StyleBox["v", "TI"], ",", " ", 
     StyleBox["\[CurlyPhi]", "TR"]}], "]"}], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9056c29f-9dc7-4dfd-8bc6-1e6224451b34"],
 "."
}], "ExampleText",ExpressionUUID->"bc187658-9c23-408d-8d16-7847f9874c90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v", ",", " ", "phi"}], "]"}], " ", "s"}], ")"}]}], 
         ")"}], "^", "2"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"LorentzGamma", "[", "v", "]"}], "^", "2"}]}]}], "]"}], "]"}],
    ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a40f8270-ba91-44ae-b699-ca890a4ab6d3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"499daba0-3d5f-46e6-a9b4-378e52f55bf1"]
}, Open  ]]
}, Open  ]],

