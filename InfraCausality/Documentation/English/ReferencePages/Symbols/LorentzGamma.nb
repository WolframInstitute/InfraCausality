Notebook[{

Cell[CellGroupData[{
Cell["LorentzGamma", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e3b8f4ee-5a5f-43f4-8c1b-83ed143d7da5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86aa2944-f1ba-417d-9ea5-b1d3786b8355"],
 "\[LineSeparator]",
 "gives the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef553434-f29e-4075-8ef0-d2080eb6cbf9"],
 " of the velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa84948c-9879-496b-ab0a-8974bef469ff"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"131158a1-2662-4fff-850b-4a9bfbe1a91b"],

Cell[TextData[{
 "Definition: an observer at rest sends a signal at proper time ",
 StyleBox["T", "TI"],
 " to an observer of velocity ",
 StyleBox["v", "TI"],
 " who left the same event; it is reflected at the moving observer's proper \
time ",
 StyleBox["kT", "TI"],
 " and returns at ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfa42c75-6930-4439-9ea8-4ef12c07d4b4"],
 ". The rest observer's radar time of the reflection is the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["T", "TI"], "+", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    StyleBox["T", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7764aa44-8337-467b-964f-2fcfff82ba90"],
 ", so the ratio of radar time to the moving observer's proper time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b33af18-c1e3-49aa-84c1-764e84e9bb59"],
 ". This is time dilation, and it equals ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "448d8386-ebd8-444e-be44-72769d8e7b4a"],
 "."
}], "Notes",ExpressionUUID->"0f5a95d4-c87b-476e-9fbc-81ec902fa31a"],

Cell[TextData[{
 "The Lorentz factor is the hyperbolic cosine of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99242649-c120-423a-ade9-f4ae60a0cddd"],
 ", and it is even in ",
 StyleBox["v", "TI"],
 ", since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", 
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d860b-30bc-4a38-a532-e065e3d7e726"],
 "."
}], "Notes",ExpressionUUID->"33e0c3d8-51cb-4f81-903c-e690fff794e5"]
}, Open  ]],

