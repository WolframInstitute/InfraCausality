Cell["\<\
The Lorentz factors of the velocities 3/5 and 4/5, whose k-factors are 2 and \
3.\
\>", "ExampleText",ExpressionUUID->"4ce882bf-587e-43c8-afb2-5e68a82a54d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"4", "/", "5"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e55c7df1-8298-4342-8bd9-ded58efc7411"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", 
   FractionBox["5", "3"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5c5ab839-9e80-458e-a4f1-9cebdf10b278"]
}, Open  ]],

