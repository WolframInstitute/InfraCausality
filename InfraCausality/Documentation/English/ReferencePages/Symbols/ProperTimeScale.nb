Notebook[{

Cell[CellGroupData[{
Cell["ProperTimeScale", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98253ad3-1f30-4529-aaa8-148002c760e1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb718cbe-38dd-48bb-b998-fd5603150637"],
 "\[LineSeparator]",
 "gives the ratio of proper time to Euclidean arc length on the worldline of \
velocity ",
 StyleBox["v", "TI"],
 " for light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "+", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "-", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "932c94de-f6f1-4fb9-a398-a64624876763"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"84a4f4e1-ace6-44a4-ae7b-00dff063dc2a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "465d2aa1-8abc-46ce-813b-1eb2b8d7e223"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"3a6c137c-4dcf-41b8-8d59-810b5b01580d"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"KFactor", "[", 
    RowBox[{
     StyleBox["v", "TI"], ",", " ", 
     StyleBox["\[CurlyPhi]", "TR"]}], "]"}], " ", "/", " ", 
   RowBox[{"OutgoingRatio", "[", 
    RowBox[{
     StyleBox["v", "TI"], ",", " ", 
     StyleBox["\[CurlyPhi]", "TR"]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff2156e3-d035-4eeb-b292-1c63b73b7727"],
 ". Proper time is the Minkowski length ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb6650b2-8754-46fd-9087-c57059beb9f7"],
 " of the radar coordinates (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ffc4eeb2-a444-4369-a81a-939a7006fde7"],
 "), and on a straight worldline through the origin it is linear in Euclidean \
arc length: the event at arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " has proper time ",
 Cell[BoxData[
  RowBox[{"ProperTimeScale", "[", 
   RowBox[{"v", ",", " ", "phi"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4f3cf47-4bbb-4910-a31b-616a0ffeda4b"],
 " ",
 StyleBox["s", "TI"],
 " exactly."
}], "Notes",ExpressionUUID->"178c48e8-47c5-478f-b58c-5789c26583c7"],

Cell[TextData[{
 "So proper-time ticks are evenly spaced along each worldline; the rest \
worldline has scale 1, and the scale of a moving worldline is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"], "/", 
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[CurlyPhi]"}]], "<", 
   "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6e4421b-924d-4079-b17f-d8e103ffc7d7"],
 ", equal to ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31889cc3-5600-4d4c-b6fc-a328b67b8800"],
 " at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4. What grows logarithmically with arc length is the bounce count \
of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a537b135-dc10-4118-a7af-df7248dcd769"],
 ", not the proper time."
}], "Notes",ExpressionUUID->"136c8c44-5d95-469d-a099-ae6a8b56d1c2"]
}, Open  ]],

