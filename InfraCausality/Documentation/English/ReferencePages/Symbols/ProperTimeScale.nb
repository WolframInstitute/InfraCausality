Cell[TextData[{
 "The radar interval of the event at arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " is ",
 Cell[BoxData["ProperTimeScale"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec5234f-69fa-4b4a-8941-76113f991a73"],
 " times ",
 StyleBox["s", "TI"],
 ": proper time is linear in arc length."
}], "ExampleText",ExpressionUUID->"55d9f80e-0600-4d0a-bd06-f084cfbd86a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"interval", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", " ", "phi", ",", " ", "s"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"WorldlineDirection", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
           "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
         " ", 
         RowBox[{
          RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"interval", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"Pi", "/", "3"}], ",", " ", "s"}], "]"}], "]"}], " ", "==", 
       " ", 
       RowBox[{
        RowBox[{"ProperTimeScale", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}], ",", " ", 
      RowBox[{"s", " ", ">", " ", "0"}]}], "]"}], " ", "&&", "\n", "    ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"TrigExpand", "[", 
       RowBox[{
        RowBox[{"interval", "[", 
         RowBox[{"v", ",", " ", "phi", ",", " ", "s"}], "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"ProperTimeScale", "[", 
           RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
         RowBox[{"s", "^", "2"}]}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
        RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6c36d44b-49ab-4f42-af34-ceb2f397cf1c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"89908e13-a6e3-480a-9997-bca15ccdfdaa"]
}, Open  ]],

Cell["\<\
Arc length is proper time on the rest worldline at every light angle.\
\>", "ExampleText",ExpressionUUID->"7b5dbed7-483a-4cab-91c6-c04aba4025d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ProperTimeScale", "[", 
     RowBox[{"0", ",", " ", "phi"}], "]"}], " ", "==", " ", "1"}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"76f9dd9d-fdcb-43c8-9d3e-58b28f509ead"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c58a8f55-1321-47f1-81c0-449dd614569b"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/4 the scale is ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfa1d7d0-e9e7-4171-9f99-9c4b56aa4145"],
 ", and at every light angle it is ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Alpha]", "TI"], "/", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[CurlyPhi]"}]]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c721fc-425e-456f-a40a-6a9ebdbcb533"],
 "."
}], "ExampleText",ExpressionUUID->"f1e47c7e-4f1e-41e9-97c3-c042f809c799"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"TrigExpand", "[", 
      RowBox[{"ProperTimeScale", "[", 
       RowBox[{"v", ",", " ", 
        RowBox[{"Pi", "/", "4"}]}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"v", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}]}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}]}], "]"}], " ", "&&",
   "\n", "  ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"TrigExpand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", "==", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"WorldlineAngle", "[", 
           RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "^", "2"}], "/", 
        RowBox[{
         RowBox[{"Sin", "[", "phi", "]"}], "^", "2"}]}]}]}], "]"}], ",", " ", 
    
    RowBox[{
     RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
      RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"bded9770-c4d6-4bf9-822d-55614ecd4ee9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fb37abc6-3856-44f1-90fe-313f4a78234e"]
}, Open  ]],

Cell[TextData[{
 "The scale converts both arc-length ratios to the k-factor: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "\[CenterDot]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c10d8000-0f75-4bad-94df-38868a84ddd9"],
 " scale ",
 Cell[BoxData[
  RowBox[{"=", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e96b11a8-21da-4026-b2c0-cc94fd789bd9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   StyleBox["k", "TI"], "\[CenterDot]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641e5767-4148-49ac-aefa-8728df879d1f"],
 " scale."
}], "ExampleText",ExpressionUUID->"248caeef-c227-435a-9cb1-87c72e0e530e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"TrigExpand", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"OutgoingRatio", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ")"}], "^", "2"}], " ", "==",
         " ", 
        RowBox[{
         RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"IncomingRatio", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"KFactor", "[", "v", "]"}], " ", 
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ")"}], "^", "2"}]}]}], 
      "}"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
      RowBox[{"Pi", "/", "2"}]}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"4ed3c19f-d9d0-4d22-8a22-314aade74170"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"809c1a89-5036-4b50-b069-8a98a3d1e251"]
}, Open  ]]
}, Open  ]],

