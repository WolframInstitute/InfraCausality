Cell["\<\
The proper-time scale of the velocity 3/5 at the default light angle.\
\>", "ExampleText",ExpressionUUID->"be216c77-7b87-4c69-99e5-401d26e3b728"],

Cell[CellGroupData[{

Cell[BoxData[
