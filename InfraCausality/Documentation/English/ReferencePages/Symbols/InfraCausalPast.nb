Cell["\<\
The causal past is a down-set containing its anchor: every in-neighbour of \
one of its events is one of its events.\
\>", "ExampleText",ExpressionUUID->"cdf736cb-bb75-4e4e-b0ea-48e6675fc164"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", "\n", "      ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"past", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"past", ",", " ", "v"}], "]"}], " ", "&&", " ", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{"past", ",", " ", 
             RowBox[{"Union", " ", "@@", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"VertexInComponent", "[", 
                  RowBox[{"g", ",", " ", "#", ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", 
