    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa37a260-455e-4c1c-a0c3-3d7f190a9223"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c7ce9a6d-e9e3-4e74-8234-2f96b4a6d3e0"]
}, Open  ]],

Cell[TextData[{
 StyleBox["u", "TI"],
 " lies in the causal past of ",
 StyleBox["v", "TI"],
 " exactly when ",
 StyleBox["v", "TI"],
 " lies in the causal future of ",
 StyleBox["u", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"ffa41b46-79d2-439f-b2d7-15f69700f970"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
     " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "u"}], "]"}], 
        " ", "===", " ", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalFuture", "[", "u", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "v"}], 
         "]"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7b2d43cb-8306-4734-a344-8ec4f6e016fb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ccb3ed6d-0f1f-4919-8248-48e2d710b1cc"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the causal past of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} is a rectangle of (",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"ac29649e-33e3-4ae8-952a-58c5c72bcbb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", "v", "]"}], " ", "+", " ", "1"}], ")"}], " ", 
        
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Last", "[", "v", "]"}], " ", "+", " ", "1"}], 
         ")"}]}]}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0062992b-9da0-464f-b0b2-6f53b648b084"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"82aace07-a6dc-4bc9-b451-efb75b8e3c5c"]
}, Open  ]]
}, Open  ]],

