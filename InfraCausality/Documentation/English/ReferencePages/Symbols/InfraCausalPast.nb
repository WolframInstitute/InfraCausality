    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "891039a0-4ec9-4b7d-9e89-1b595fd818fe"]], "TableText",ExpressionUUID->
     "a63d754b-0421-4394-bb9d-68d2da18e460"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e27c35cf-1f4c-4cc3-a171-\
7577176e84dd"],

Cell[TextData[{
 "A set head has one member, its support, so no sampler draws it. The three \
readings of the causal past on a graph are ",
 Cell[BoxData[
  RowBox[{"InfraSubgraph", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalPast", "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d96c2725-f779-46a6-a999-500f497b20ad"],
 " (InfraGeometry), the induced subgraph; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Keys",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     RowBox[{"InfraCausalPast", "[", 
      StyleBox["v", "TI"], "]"}], ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89037efa-152a-40b1-93ed-50c823635196"],
 ", the sorted vertex list; and ",
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalPast", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d07af25c-193f-4bad-8755-1f0406cf25d2"],
 " (InfraGeometry), ",
 StyleBox["n", "TI"],
 " distinct random events of it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalPastQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9dcec77f-994f-42f2-a4be-11c9311e559b"],
 " recognises a vertex set that is the causal past of one of its events."
}], "Notes",ExpressionUUID->"92cf976f-c712-477d-8b6d-02d468d4ec63"],

