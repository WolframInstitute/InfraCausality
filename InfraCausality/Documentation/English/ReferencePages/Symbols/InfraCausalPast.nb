Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalPast", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa4e6b9e-708e-4312-9076-247d27bf4b0d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b49dea0d-c382-4911-83b3-f2ebf2b509dc"],
 "\[LineSeparator]",
 "is the causal past of the event ",
 StyleBox["v", "TI"],
 ": every event that can reach ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " included.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d7e4d253-9e03-4ac5-a547-5554cd69d6ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69d20415-b5b3-4539-a09d-6fd38131cc87"],
 "\[LineSeparator]",
 "is the causal past of a set of events, the union of their causal pasts.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"23acdb24-f4ec-42eb-86c4-fdce79a89b65"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851feb0c-577e-4131-be4a-c035be375280"],
 "\[LineSeparator]",
 "keeps the events of the causal past within proper time ",
 StyleBox["t", "TI"],
 " of ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"a1cd0d0a-e9e7-4c0b-b338-9cfd6748e47f"],

Cell[TextData[{
 "Definition: the causal past of an event ",
 StyleBox["v", "TI"],
 " of a directed acyclic graph is ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 "}, the events ",
 StyleBox["e", "TI"],
 " joined to ",
 StyleBox["v", "TI"],
 " by a directed path from ",
 StyleBox["e", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " itself included."
}], "Notes",ExpressionUUID->"432a5fc9-1604-4058-95b7-f498f7858cef"],

Cell[TextData[{
 "The causal past is the in-component of ",
 StyleBox["v", "TI"],
 ", and a down-set: with every event it contains every event that can reach \
it. It is the time reverse of the causal future: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalPast"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e87e9cdf-c2f0-40d2-bac1-02c95dd90731"],
 " on a graph is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFuture"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7ef87186-215e-4d6b-a332-5adf46a1476e"],
 " on the graph with every edge reversed, and every reading below is the \
reversed reading of the causal future. The events of the causal past are the \
events that can send a signal to ",
 StyleBox["v", "TI"],
 "; on a sprinkling into Minkowski space they are the sprinkled points inside \
the past light cone of ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"f929c5ee-72f6-4dbc-b122-694d30c69257"],

Cell[TextData[{
 "The cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPast"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPast", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24c05bbe-4db0-4984-9ef8-6bf6f368da47"],
 " keeps the events whose longest chain to ",
 StyleBox["v", "TI"],
 " has at most ",
 StyleBox["t", "TI"],
 " edges."
}], "Notes",ExpressionUUID->"184f6d77-b514-457a-bcd8-07dc973ef4a3"],

Cell[TextData[{
 "The head holds its anchor and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c45fdfe0-3539-4502-bffb-23131f9cc4d5"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"a891391b-dfdb-4252-9ccc-507d793773c6"],

