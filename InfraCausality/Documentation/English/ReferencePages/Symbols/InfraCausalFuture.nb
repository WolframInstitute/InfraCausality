Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalFuture", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8f0514c1-da79-4c13-a030-9ff572a66e56"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "830c9b93-ed29-4ac1-ae39-746c0783d2f4"],
 "\[LineSeparator]",
 "is the causal future of the event ",
 StyleBox["v", "TI"],
 ": every event that ",
 StyleBox["v", "TI"],
 " can reach, ",
 StyleBox["v", "TI"],
 " included.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"01c4a830-f24f-4980-8b06-b2ee263bc03c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c8b0515-3bf1-4784-8762-75a2d3dd923d"],
 "\[LineSeparator]",
 "is the causal future of a set of events, the union of their causal futures.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7f9692cd-3032-418c-b3f5-e684f112cca6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37be2291-ecfa-40d3-8fd4-ddc9dd2c5b3b"],
 "\[LineSeparator]",
 "keeps the events of the causal future within proper time ",
 StyleBox["t", "TI"],
 " of ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"6e0b1467-c075-4706-ab96-2007afcbcd6f"],

Cell[TextData[{
 "Definition: the causal future of an event ",
 StyleBox["v", "TI"],
 " of a directed acyclic graph is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["v", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 "}, the events ",
 StyleBox["e", "TI"],
 " joined to ",
 StyleBox["v", "TI"],
 " by a directed path, ",
 StyleBox["v", "TI"],
 " itself included."
}], "Notes",ExpressionUUID->"8c3f62d7-3402-446e-a8a2-1a5486f97fba"],

Cell[TextData[{
 "The causal order ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " is reachability, so the causal future is the out-component of ",
 StyleBox["v", "TI"],
 ". It is an up-set: with every event it contains every event the event can \
reach. On a light-cone lattice it is the quadrant above ",
 StyleBox["v", "TI"],
 "; on a sprinkling into Minkowski space it is the set of sprinkled points \
inside the future light cone of ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"779e8cda-19f9-4b9d-8a92-c6741063d39c"],

Cell[TextData[{
 "The cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cad24747-163f-4eec-a176-28ad595fdeb4"],
 " keeps the events ",
 StyleBox["e", "TI"],
 " of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") whose longest chain from ",
 StyleBox["v", "TI"],
 " has at most ",
 StyleBox["t", "TI"],
 " edges. The number of edges of a longest chain is the proper time of the \
graph, so the cut is the cone of proper-time height ",
 StyleBox["t", "TI"],
 ": the events of the causal future that ",
 StyleBox["v", "TI"],
 " reaches within proper time ",
 StyleBox["t", "TI"],
 ". On the diamond lattice the longest chain from {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} to {",
 StyleBox["i'", "TI"],
 ", ",
 StyleBox["j'", "TI"],
 "} has (",
 StyleBox["i'", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") + (",
 StyleBox["j'", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 ") edges, and the cut is a triangle."
}], "Notes",ExpressionUUID->"99bbfe14-a1cc-452e-ad53-94850c8ceb40"],

Cell[TextData[{
 "The head holds its anchor and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c890e9d0-b594-41e7-8a17-acb74149ddc3"],
 " reads it on a graph, and the anchor is read through its vertex density, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["anchor", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c1efee6-2aad-4848-8b12-c5eabc7fa818"],
 ", so a vertex, a vertex list or a chain all serve:"
}], "Notes",ExpressionUUID->"54631c77-3795-4b75-9464-c5f1c607d07d"],

