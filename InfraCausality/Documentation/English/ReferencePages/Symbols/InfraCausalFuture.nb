Cell["\<\
The causal volume of the future of every event of the bottom row of the \
cylinder lattice. It is the same for all of them: the cylinder is homogeneous \
in space.\
\>", "ExampleText",ExpressionUUID->"4c4757cb-306a-46f7-9582-09e29548df7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{"v", " ", "|->", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", " ", 
      RowBox[{"RandomInfraSlice", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6cf8c355-4785-4957-926f-2b4176073e61"],

