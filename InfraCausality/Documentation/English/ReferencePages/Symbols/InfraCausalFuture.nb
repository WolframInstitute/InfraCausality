Cell["\<\
The causal future is an up-set containing its anchor: every out-neighbour of \
one of its events is one of its events.\
\>", "ExampleText",ExpressionUUID->"c40a196c-edf4-4db5-9231-3483b9e3e81b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", "\n", "      ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"future", " ", "=", " ", 
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraCausalFuture", "[", "v", "]"}]}], "]"}]}], "}"}], 
          ",", "\n", "        ", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"future", ",", " ", "v"}], "]"}], " ", "&&", " ", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{"future", ",", " ", 
             RowBox[{"Union", " ", "@@", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"VertexOutComponent", "[", 
                  RowBox[{"g", ",", " ", "#", ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", 
                " ", "future"}], ")"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"acc9d080-3a34-4cd8-a354-ba4b4f0a1a62"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b7214ece-95f4-4489-af2c-40238e9ce980"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice of size 6 the causal future of the event {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} is a rectangle of (7 \[Minus] ",
 StyleBox["i", "TI"],
 ")(7 \[Minus] ",
 StyleBox["j", "TI"],
 ") events."
}], "ExampleText",ExpressionUUID->"dfe816ff-936e-4e3d-93c0-d1f91569f694"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"7", " ", "-", " ", 
          RowBox[{"First", "[", "v", "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"7", " ", "-", " ", 
          RowBox[{"Last", "[", "v", "]"}]}], ")"}]}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aa874bd8-ebf1-4514-8b4c-26e24dd4361b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f7e76d4d-41f5-45a4-a68b-0b45cc2f2842"]
}, Open  ]],

Cell["\<\
The causal future on a graph is the causal past on the reversed graph.\
\>", "ExampleText",ExpressionUUID->"d86340d0-7fc5-4076-a321-32f27e6830f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraCausalFuture", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "v", "]"}]}], "]"}], " ", "===", 
       " ", 
       RowBox[{"RandomInfraCausalPast", "[", 
        RowBox[{
         RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", 
         RowBox[{"InfraCausalPast", "[", "v", "]"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5184b464-1592-490f-bc99-1eb410cde072"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0ce0c43b-6119-42bc-8d28-d5849a93efb5"]
}, Open  ]],

Cell[TextData[{
 "Every event of the proper-time cut lies at universal time at most ",
 StyleBox["t", "TI"],
 " in the subgraph of the causal future, and the cut grows to the whole \
causal future."
}], "ExampleText",ExpressionUUID->"4b871d9f-e82c-47d8-b371-e0d07c9c9439"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"time", " ", "=", " ", 
     RowBox[{"UniversalTime", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
        " ", "\"\<Subgraph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalFuture", "[", 
            RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"time", "[", "e", "]"}], " ", "<=", " ", "t"}]}]}], "]"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", 
         RowBox[{"Max", " ", "@", " ", "time"}]}], "}"}]}], "]"}]}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"RandomInfraCausalFuture", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalFuture", "[", 
        RowBox[{"v", ",", " ", 
         RowBox[{"Max", " ", "@", " ", "time"}]}], "]"}]}], "]"}], " ", "===",
      " ", 
     RowBox[{"RandomInfraCausalFuture", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalFuture", "[", "v", "]"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"e873d07e-c8e0-42d1-b9fd-d18d264ccaf8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"87bc7fdb-488f-4922-b965-e804b199207a"]
}, Open  ]]
}, Open  ]],

