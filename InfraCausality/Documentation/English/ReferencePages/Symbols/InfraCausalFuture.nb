Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalFuture", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"85c84bbf-ac42-42b2-96d4-58be4a21c312"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26e44649-f134-4946-a462-29421b358c35"],
 "\[LineSeparator]",
 "is the causal future of the event ",
 StyleBox["v", "TI"],
 ": every event that ",
 StyleBox["v", "TI"],
 " can reach, ",
 StyleBox["v", "TI"],
 " included.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75a72d4a-72d5-40d6-a179-87a90be94a21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe99d3da-ea5e-4cdb-a5d7-654829ed20c9"],
 "\[LineSeparator]",
 "is the causal future of a set of events, the union of their causal futures.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b003fb78-8cbb-467c-a6b4-34fc13f5ba5c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425f7a5c-5b00-46f6-90bd-4b648e4e27d8"],
 "\[LineSeparator]",
 "keeps the events of the causal future within proper time ",
 StyleBox["t", "TI"],
 " of ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"e1080cda-272a-4d53-907c-e94e563e798b"],

Cell[TextData[{
 "Definition: the causal future of an event ",
 StyleBox["v", "TI"],
 " of a directed acyclic graph is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["v", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 "}, the events ",
 StyleBox["e", "TI"],
 " joined to ",
 StyleBox["v", "TI"],
 " by a directed path, ",
 StyleBox["v", "TI"],
 " itself included."
}], "Notes",ExpressionUUID->"3cfbf0db-f54e-4450-b3aa-3c53c277809d"],

Cell[TextData[{
 "The causal order ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " is reachability, so the causal future is the out-component of ",
 StyleBox["v", "TI"],
 ". It is an up-set: with every event it contains every event the event can \
reach. On a light-cone lattice it is the quadrant above ",
 StyleBox["v", "TI"],
 "; on a sprinkling into Minkowski space it is the set of sprinkled points \
inside the future light cone of ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"dfef283c-5077-40c7-8af3-643fd28a680c"],

Cell[TextData[{
 "The cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432c7d61-6330-4abd-9d89-17bf2a94de66"],
 " keeps the events ",
 StyleBox["e", "TI"],
 " of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") whose longest chain from ",
 StyleBox["v", "TI"],
 " has at most ",
 StyleBox["t", "TI"],
 " edges. The number of edges of a longest chain is the proper time of the \
graph, so the cut is the cone of proper-time height ",
 StyleBox["t", "TI"],
 ": the events of the causal future that ",
 StyleBox["v", "TI"],
 " reaches within proper time ",
 StyleBox["t", "TI"],
 ". On the diamond lattice the longest chain from {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} to {",
 StyleBox["i'", "TI"],
 ", ",
 StyleBox["j'", "TI"],
 "} has (",
 StyleBox["i'", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") + (",
 StyleBox["j'", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 ") edges, and the cut is a triangle."
}], "Notes",ExpressionUUID->"c8adaf9f-136a-4482-82d5-6604b6b5a283"],

Cell[TextData[{
 "The head holds its anchor and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34c524c7-e7c0-4b0c-bc5b-b6d620f6a599"],
 " reads it on a graph, and the anchor is read through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDensity"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d72359c8-a1d2-43a3-a9e0-66eba2b22e5d"],
 ", so a vertex, a vertex list or a chain all serve:"
}], "Notes",ExpressionUUID->"8cf4dd2a-1a84-40cb-ab33-f8a1fed3bfd2"],

