Cell["\<\
The causal future is an up-set containing its anchor: every out-neighbour of \
one of its events is one of its events.\
\>", "ExampleText",ExpressionUUID->"db1c7f4b-fc5a-4dc9-b0a7-582b83492f5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", "\n", "      ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"future", " ", "=", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"future", ",", " ", "v"}], "]"}], " ", "&&", " ", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{"future", ",", " ", 
             RowBox[{"Union", " ", "@@", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"VertexOutComponent", "[", 
                  RowBox[{"g", ",", " ", "#", ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", 
                " ", "future"}], ")"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d495079-246c-4f9a-a9b0-372074eb20d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ebc3a9ae-c688-498b-97ec-544b3f454706"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice of size 6 the causal future of the event {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} is a rectangle of (7 \[Minus] ",
 StyleBox["i", "TI"],
 ")(7 \[Minus] ",
 StyleBox["j", "TI"],
 ") events."
}], "ExampleText",ExpressionUUID->"865b48e7-57a0-457f-b2a5-d7597e29fea7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"7", " ", "-", " ", 
          RowBox[{"First", "[", "v", "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"7", " ", "-", " ", 
          RowBox[{"Last", "[", "v", "]"}]}], ")"}]}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"43f38bd8-afd3-4e21-ba51-752a971a084d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"550b2f3f-9f98-495b-9a39-c23e7fcd6b40"]
}, Open  ]],

Cell["\<\
The causal future on a graph is the causal past on the reversed graph.\
\>", "ExampleText",ExpressionUUID->"538e50fd-941a-4a52-b19a-0915977aca87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{
          RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", 
          RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4360c7ae-8fdf-40be-99c4-23851b36601c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"750c443a-9c94-4a7c-92ac-906fd45b7929"]
}, Open  ]],

Cell[TextData[{
 "Every event of the proper-time cut lies at causal height at most ",
 StyleBox["t", "TI"],
 " in the subgraph of the causal future, and the cut grows to the whole \
causal future."
}], "ExampleText",ExpressionUUID->"21f22b97-ef63-4d7b-b2f6-9ba20cd7165c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"time", " ", "=", " ", 
     RowBox[{"CausalHeight", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
        " ", "\"\<Subgraph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", 
             RowBox[{"v", ",", " ", "t"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"time", "[", "e", "]"}], " ", "<=", " ", "t"}]}]}], "]"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", 
         RowBox[{"Max", " ", "@", " ", "time"}]}], "}"}]}], "]"}]}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalFuture", "[", 
         RowBox[{"v", ",", " ", 
          RowBox[{"Max", " ", "@", " ", "time"}]}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"beba0415-d372-4afd-b007-98aa6a0ec2bb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"eec3c32e-1d0c-4fbd-b669-6ddbea9c4d9c"]
}, Open  ]]
}, Open  ]],

