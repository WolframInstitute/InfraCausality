Cell["\<\
The causal future of two events of the sprinkling is the union of their \
causal futures.\
\>", "ExampleText",ExpressionUUID->"1960806c-09b9-407f-b5df-4ccde13790ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "2", "]"}], ",", " ", "2"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalFuture", "[", "s", "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"First", " ", "@", " ", "s"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"Last", " ", "@", " ", "s"}], "}"}], "]"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7ce7ce8a-c56d-4e35-842e-420cf5c5d82f"],

