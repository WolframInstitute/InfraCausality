  }]], "2ColumnTableMod",ExpressionUUID->"748ac088-c92c-4a97-b2af-\
57c434d17993"],

Cell[TextData[{
 "A set head has one member, its support, so no sampler draws it. The three \
readings of the causal future on a graph are ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalFuture", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", "\"\<Subgraph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eabb11f-75ea-4bef-9395-65671af612cd"],
 " (InfraGeometry), the induced subgraph; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Keys",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     RowBox[{"InfraCausalFuture", "[", 
      StyleBox["v", "TI"], "]"}], ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f22a8cc2-01ec-4ea0-ab7e-c15945d8631d"],
 ", the sorted vertex list; and ",
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalFuture", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1e8dd0-d53a-4055-abbb-3758980f66c3"],
 " (InfraGeometry), ",
 StyleBox["n", "TI"],
 " distinct random events of it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFutureQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c5ec3db-6410-49ee-8324-70d1261f3161"],
 " recognises a vertex set that is the causal future of one of its events."
}], "Notes",ExpressionUUID->"d4393278-adcc-4878-ada8-a21285618172"],

