Cell["\<\
The causal volume of the future of every event of the bottom row of the \
cylinder lattice. It is the same for all of them: the cylinder is homogeneous \
in space.\
\>", "ExampleText",ExpressionUUID->"e4aec18b-e0f6-430f-8837-4d12c13773df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{"v", " ", "|->", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "0", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"9d0ea7c0-e776-49bd-bfc4-c0213df3cba6"],

Cell[BoxData[
 RowBox[{"{", 
