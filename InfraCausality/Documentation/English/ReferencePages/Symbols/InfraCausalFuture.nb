Cell["\<\
The causal future of two events of the sprinkling is the union of their \
causal futures.\
\>", "ExampleText",ExpressionUUID->"5b7fa973-3c11-429f-9c7a-6380c5ffb543"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}], ",", " ", "2"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalFuture", "[", "s", "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"First", " ", "@", " ", "s"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"Last", " ", "@", " ", "s"}], "}"}], "]"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"545f5d3c-8859-4a8d-816a-7ec2ff70ebe1"],

