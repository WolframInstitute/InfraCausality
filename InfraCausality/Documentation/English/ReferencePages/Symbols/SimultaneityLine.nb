Cell["\<\
Every point of the line has its radar midpoint at the base point.\
\>", "ExampleText",ExpressionUUID->"464b3c6b-4d81-4145-821a-ae09218be384"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"midpoint", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SimultaneityLine", "[", 
           RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], 
           "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
        "]"}], " ", "==", " ", "s"}], ",", " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
        RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
       RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}], " ", "&&", "\n", "    ", 
    
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"midpoint", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"3", "/", "5"}], ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
        RowBox[{"SimultaneityLine", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", 
          RowBox[{"Pi", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}], "]"}], " ", "===", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f5ebd89f-8d9b-46a9-a50a-efdf897d2b2a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e9ccae3b-127c-42a1-b2e2-5588c0d73fa4"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/4 the line has slope ",
 StyleBox["v", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"7ef7d1ed-3786-4582-b6f6-849c40c9c2f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", 
         RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ")"}]}], " ", "==", 
      " ", "v"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ffc466a5-ee72-4ca4-ba0f-c8e314711753"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"29b540f7-c786-4b73-83a4-3aa88f070766"]
}, Open  ]],

Cell[TextData[{
 "The base point is the middle element, and the ends are ",
 StyleBox["extent", "TI"],
 " away."
}], "ExampleText",ExpressionUUID->"5ecf2478-1fc4-45ed-bb04-cfbb64d224ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}]}],
       "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sl", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"WorldlinePoint", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi"}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}], " ",
       "&&", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}]}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9f0e6f53-d408-435c-aff7-668c1d218e43"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f337d546-2537-4aab-872b-58c8b8ae5a72"]
}, Open  ]]
