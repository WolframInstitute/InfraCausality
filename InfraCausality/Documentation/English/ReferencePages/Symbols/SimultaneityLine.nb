Cell["\<\
Every point of the line has its radar midpoint at the base point.\
\>", "ExampleText",ExpressionUUID->"e9e87d13-ed50-444d-8d08-e5d3a366c499"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"midpoint", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SimultaneityLine", "[", 
           RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], 
           "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
        "]"}], " ", "==", " ", "s"}], ",", " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
        RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
       RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}], " ", "&&", "\n", "    ", 
    
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"midpoint", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"3", "/", "5"}], ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
        RowBox[{"SimultaneityLine", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", 
          RowBox[{"Pi", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}], "]"}], " ", "===", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0dd2a325-44e5-4cd4-bbc9-5b64e1ce7cee"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"04513849-8aaf-416d-afcf-452eb59c1346"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/4 the line has slope ",
 StyleBox["v", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"d2a39f72-c831-4eb2-8c5a-8bfe06da87fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", 
         RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ")"}]}], " ", "==", 
      " ", "v"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a93c2565-f043-4723-a3d0-4329408437c0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c91bfa8d-3f57-4e69-9e95-93b422ca8b7c"]
}, Open  ]],

Cell[TextData[{
 "The base point is the middle element, and the ends are ",
 StyleBox["extent", "TI"],
 " away."
}], "ExampleText",ExpressionUUID->"ae8ca9c5-bd77-4489-9250-0d320046aa1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}]}],
       "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sl", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"WorldlinePoint", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi"}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}], " ",
       "&&", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}]}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"13dfd3b8-59f0-4fef-93ee-88666759c765"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"30454766-00df-4eed-8cc1-86d22440c5c4"]
