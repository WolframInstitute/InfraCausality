Cell["\<\
The simultaneity line through the point at arc length 1 on the worldline of \
velocity 3/5.\
\>", "ExampleText",ExpressionUUID->"7650fe90-aca5-46cd-8f9d-5e83a2addda3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SimultaneityLine", "[", 
  RowBox[{
   RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", 
   RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"371f9bf0-11fd-4a10-bfcc-65ad509fd301"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     SqrtBox[
      FractionBox["2", "17"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", 
      SqrtBox["34"]], ",", 
     FractionBox["5", 
      SqrtBox["34"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"30c96dde-f671-4e0a-ad1b-8108674f74db"]
}, Open  ]],

Cell["\<\
The simultaneity lines of the velocities 0, 0.3, 0.6 through the point at arc \
length 1, light at \[Pi]/4.\
\>", "ExampleText",ExpressionUUID->"8f65e1d5-ee6b-4227-92ea-b070bad563ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "StandardBlue", ",", " ", "StandardOrange", ",", " ", 
             "StandardRed"}], "}"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0.3", ",", " ", "0.6"}], "}"}], "[", 
