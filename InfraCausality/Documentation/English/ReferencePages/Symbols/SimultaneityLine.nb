Cell[CellGroupData[{
Cell["SimultaneityLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9a2e3475-1928-4507-bdc3-f5f75223a6b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"], ",", " ", 
    StyleBox["extent", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5f3ee82-100b-4fae-8c72-bf0df8102abc"],
 "\[LineSeparator]",
 "gives {left end, base point, right end} of the simultaneity line through \
the point at arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 ": the events whose radar midpoint on that worldline is the base point, \
along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775fe581-774c-46d2-956f-897a0174b0e3"],
 " with ",
 StyleBox["extent", "TI"],
 " to each side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b6b8eb57-275e-46f1-9675-1c0e01d1bddc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "727d8e14-a6b8-4a5a-a0e9-5954f5a8b223"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["extent", "TI"],
 " 1, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc1c6aea-379e-4004-8b74-2afe643984a9"],
 " also ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"03e8abdd-e013-4de4-b6bb-9715698b30ce"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"f7c6de29-9417-409d-ab3c-4112519bd521"],

Cell[TextData[{
 "Definition: the observer of velocity ",
 StyleBox["v", "TI"],
 " assigns an event ",
 StyleBox["E", "TI"],
 " the radar time of the midpoint of the emission and the return of light \
sent to ",
 StyleBox["E", "TI"],
 " and echoed back. The events with radar midpoint at the base point ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af6d9fc8-9d4e-4601-badf-874ffc63f254"],
 " form a line through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fe6e0dd-6902-46bf-ada8-02aa8a1696ed"],
 ": with ",
 StyleBox["d", "TI"],
 " the worldline direction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", 
   StyleBox["B", "TI"], "+", 
   StyleBox["c", "TI"], " ", 
   StyleBox["w", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8088707-0ef7-4b60-b0c7-73f1aef79d37"],
 " has emission and return at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[MinusPlus]", 
   StyleBox["c", "TI"], " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ca52f60-5b6a-414b-ac9b-d1c90b93c1b3"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "-", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bc6d38e-d0b0-4e73-8663-6f1e6f7b8127"],
 " is rightgoing light and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "+", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fb5c06a-25b0-4a40-ba4d-dd0554d39417"],
 " leftgoing, which gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"], "/", 
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce47b881-1ba9-4e63-a754-db3a1a42f970"],
 " using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["v", "TI"], 
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da22769f-e21a-477d-8363-c32bab40d59e"],
 ". The ends are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[PlusMinus]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d3837c7-cce1-4b1a-99f1-6c1880378568"],
 " ",
 StyleBox["extent", "TI"],
 " times the unit vector along it."
}], "Notes",ExpressionUUID->"2fc3327d-982f-4a23-afc4-0e10fd715ae0"],

Cell[TextData[{
 "At rest the line is horizontal; at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 it has slope ",
 StyleBox["v", "TI"],
 ", the mirror image of the worldline in the light direction. It is not the \
Euclidean normal (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineNormal"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40e13225-a006-4141-9e9e-2b3a6c5504f9"],
 ") unless ",
 StyleBox["v", "TI"],
 " = 0."
}], "Notes",ExpressionUUID->"263bbcfa-1b73-47a0-81c6-9f2ebde4a343"]
}, Open  ]],

