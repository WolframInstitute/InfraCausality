Cell["\<\
The simultaneity line through the point at arc length 1 on the worldline of \
velocity 3/5.\
\>", "ExampleText",ExpressionUUID->"2d5202ae-c48c-4665-8ee8-6638071a3c41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SimultaneityLine", "[", 
  RowBox[{
   RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", 
   RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8b093e6d-cae9-4c69-9817-0dd2ec68ccd5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     SqrtBox[
      FractionBox["2", "17"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", 
      SqrtBox["34"]], ",", 
     FractionBox["5", 
      SqrtBox["34"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"056c6c10-bb06-49ef-b6c2-f619731c8c20"]
}, Open  ]],

Cell["\<\
The simultaneity lines of the velocities 0, 0.3, 0.6 through the point at arc \
length 1, light at \[Pi]/4.\
\>", "ExampleText",ExpressionUUID->"d5e8930f-5a16-4b11-830a-622f3d1847dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "StandardBlue", ",", " ", "StandardOrange", ",", " ", 
             "StandardRed"}], "}"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0.3", ",", " ", "0.6"}], "}"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
