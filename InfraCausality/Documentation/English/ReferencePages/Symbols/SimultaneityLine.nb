Notebook[{

Cell[CellGroupData[{
Cell["SimultaneityLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a24c566f-347e-4991-8919-f00100b13d82"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"], ",", " ", 
    StyleBox["extent", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0046d1f9-5db0-471b-ad4a-eb86dec50435"],
 "\[LineSeparator]",
 "gives {left end, base point, right end} of the simultaneity line through \
the point at arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 ": the events whose radar midpoint on that worldline is the base point, \
along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01557d85-ef67-44a8-be08-19880b129a46"],
 " with ",
 StyleBox["extent", "TI"],
 " to each side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d301a5b6-0966-47cf-a204-645916997132"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a255ab76-e366-46a0-99fe-7f5a28af4349"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["extent", "TI"],
 " 1, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888b4548-8050-4e37-bf4e-3f55773ea202"],
 " also ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"ab1dfed7-a257-4f33-9f2b-8c2bc528a774"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"b6e8bc10-c2ee-453b-a6bb-8077981fcc58"],

Cell[TextData[{
 "Definition: the observer of velocity ",
 StyleBox["v", "TI"],
 " assigns an event ",
 StyleBox["E", "TI"],
 " the radar time of the midpoint of the emission and the return of light \
sent to ",
 StyleBox["E", "TI"],
 " and echoed back. The events with radar midpoint at the base point ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24fbec8e-b3ba-40b8-9e9a-e44e8c1ff9da"],
 " form a line through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48e528ee-cfd8-4deb-9ef7-cc48d4e811f9"],
 ": with ",
 StyleBox["d", "TI"],
 " the worldline direction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", 
   StyleBox["B", "TI"], "+", 
   StyleBox["c", "TI"], " ", 
   StyleBox["w", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "558f3ae8-9a79-4a7f-907c-28f5fb2b2941"],
 " has emission and return at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[MinusPlus]", 
   StyleBox["c", "TI"], " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "226777bd-a7fe-4a99-84e4-10ae7ed19c1f"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "-", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1803862-90b8-4c00-8b82-0db74859e8ec"],
 " is rightgoing light and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "+", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7383aba6-9c77-4ab7-a7e6-4c62079fc924"],
 " leftgoing, which gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"], "/", 
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4532d1e-692c-4870-bf08-23ef9a8c87d6"],
 " using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["v", "TI"], 
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013cfe12-476f-45d6-b00b-0551b37023f2"],
 ". The ends are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[PlusMinus]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e628459b-d05c-4f6d-adb4-d3830ee0e1f2"],
 " ",
 StyleBox["extent", "TI"],
 " times the unit vector along it."
}], "Notes",ExpressionUUID->"25412a4d-d21a-4a29-a4cb-74f0be6c58b7"],

Cell[TextData[{
 "At rest the line is horizontal; at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 it has slope ",
 StyleBox["v", "TI"],
 ", the mirror image of the worldline in the light direction. It is not the \
Euclidean normal (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineNormal"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db18bd28-61f7-45fe-9690-4b64de80548a"],
 ") unless ",
 StyleBox["v", "TI"],
 " = 0."
}], "Notes",ExpressionUUID->"51e1a214-cd05-4ede-bcdf-bb07c8ca98ed"]
}, Open  ]],

