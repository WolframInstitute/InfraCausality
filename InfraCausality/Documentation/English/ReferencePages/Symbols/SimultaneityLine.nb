Cell["\<\
The simultaneity line through the point at arc length 1 on the worldline of \
velocity 3/5.\
\>", "ExampleText",ExpressionUUID->"78308736-0f9d-449a-b1fc-b6f1b58917f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SimultaneityLine", "[", 
  RowBox[{
   RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", 
   RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"91e5d51f-1ec2-44c4-ab7e-2aa80621054d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     SqrtBox[
      FractionBox["2", "17"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", 
      SqrtBox["34"]], ",", 
     FractionBox["5", 
      SqrtBox["34"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}], ",", 
     RowBox[{"4", " ", 
      SqrtBox[
       FractionBox["2", "17"]]}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"763adbaf-27df-4ddc-b58c-fe4ee4c8d710"]
}, Open  ]],

Cell["\<\
The simultaneity lines of the velocities 0, 0.3, 0.6 through the point at arc \
length 1, light at \[Pi]/4.\
\>", "ExampleText",ExpressionUUID->"47376541-c259-47e6-accf-6c4e3b5e58a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "StandardBlue", ",", " ", "StandardOrange", ",", " ", 
             "StandardRed"}], "}"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
