Notebook[{

Cell[CellGroupData[{
Cell["SimultaneityLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"272e28f9-fa93-40d6-9cf4-bc61bb3d877a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"], ",", " ", 
    StyleBox["extent", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7923875c-489f-4a63-9761-56d222a2992b"],
 "\[LineSeparator]",
 "gives {left end, base point, right end} of the simultaneity line through \
the point at arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 ": the events whose radar midpoint on that worldline is the base point, \
along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab9c500-2144-4c99-96df-34b075c5833a"],
 " with ",
 StyleBox["extent", "TI"],
 " to each side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f7a3dbe6-68bc-44d8-b6c9-c9b272290bcf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "072e6af3-6f63-4645-b2ab-362ec36ccd15"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["extent", "TI"],
 " 1, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityLine"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd1d8fde-eec3-4bac-b4f4-840aee8d413f"],
 " also ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"a63538cc-eddf-4e1c-a04b-0f89f9b1161c"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"50e94841-75b0-4d0e-8a04-50b42954a65e"],

Cell[TextData[{
 "Definition: the observer of velocity ",
 StyleBox["v", "TI"],
 " assigns an event ",
 StyleBox["E", "TI"],
 " the radar time of the midpoint of the emission and the return of light \
sent to ",
 StyleBox["E", "TI"],
 " and echoed back. The events with radar midpoint at the base point ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57fa9f04-c883-4eab-bbf2-8d9e95da4dda"],
 " form a line through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea30083a-27ac-4ffb-958d-c6b4ff86a80d"],
 ": with ",
 StyleBox["d", "TI"],
 " the worldline direction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", 
   StyleBox["B", "TI"], "+", 
   StyleBox["c", "TI"], " ", 
   StyleBox["w", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73dc3607-9c29-43d2-830a-61c3028a8ff9"],
 " has emission and return at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[MinusPlus]", 
   StyleBox["c", "TI"], " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5163f3ed-ce0b-4f32-a4e1-6581d02aa232"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "-", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fead4fb-88fe-4294-ac41-0eda00db3fbd"],
 " is rightgoing light and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["B", "TI"], "+", 
    StyleBox["c", "TI"], " ", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ecdfbfb-23a1-471b-a939-ff4f40a3507e"],
 " leftgoing, which gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"], "/", 
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ac7aa1-316b-4f50-8992-f1cd3e65494f"],
 " using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["v", "TI"], 
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d1d836-7b50-44be-aab4-598c2d27e70b"],
 ". The ends are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "\[PlusMinus]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "844ff520-cba7-4606-9549-cf1916efc662"],
 " ",
 StyleBox["extent", "TI"],
 " times the unit vector along it."
}], "Notes",ExpressionUUID->"4ec20cb8-74e7-4349-9939-7733142d6726"],

Cell[TextData[{
 "At rest the line is horizontal; at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 it has slope ",
 StyleBox["v", "TI"],
 ", the mirror image of the worldline in the light direction. It is not the \
Euclidean normal (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineNormal"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d2699da-459a-44d4-9620-40dc6e9c3b66"],
 ") unless ",
 StyleBox["v", "TI"],
 " = 0."
}], "Notes",ExpressionUUID->"a1086f53-e23d-43bb-9990-a6f0fd2107ac"]
}, Open  ]],

