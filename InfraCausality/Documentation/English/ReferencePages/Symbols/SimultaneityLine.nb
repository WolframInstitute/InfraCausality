Cell["\<\
Every point of the line has its radar midpoint at the base point.\
\>", "ExampleText",ExpressionUUID->"afd28195-b2c1-43da-acb6-7df00e03b572"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"midpoint", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SimultaneityLine", "[", 
           RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], 
           "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
        "]"}], " ", "==", " ", "s"}], ",", " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
        RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
       RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}], " ", "&&", "\n", "    ", 
    
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"midpoint", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"3", "/", "5"}], ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}]}], ",", " ", 
        RowBox[{"SimultaneityLine", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", 
          RowBox[{"Pi", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}], "]"}], " ", "===", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cc76958b-dcb5-467c-8b98-b5f66d00218d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"767076d6-34aa-451e-bc97-15fda8b3e2c4"]
}, Open  ]],

Cell[TextData[{
 "At the light angle \[Pi]/4 the line has slope ",
 StyleBox["v", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"745c7f59-2134-4d2b-8a77-fd89088d3080"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", 
         RowBox[{"Pi", "/", "4"}], ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ")"}]}], " ", "==", 
      " ", "v"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d3123673-0c4a-44d6-9ef9-7aa74c8699be"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f48971e7-284a-4230-93b9-0ff53776da6b"]
}, Open  ]],

Cell[TextData[{
 "The base point is the middle element, and the ends are ",
 StyleBox["extent", "TI"],
 " away."
}], "ExampleText",ExpressionUUID->"5f626b7d-8963-4df5-af32-07e0644757e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sl", " ", "=", " ", 
       RowBox[{"SimultaneityLine", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}]}],
       "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sl", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "==", " ", 
       RowBox[{"WorldlinePoint", "[", 
        RowBox[{"v", ",", " ", "s", ",", " ", "phi"}], "]"}]}], " ", "&&", 
      " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}], " ",
       "&&", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"sl", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"sl", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "c"}]}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fe32875a-e00e-4dac-8d9a-b426bd03ec19"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7330fd64-bcfc-4551-b6fb-495ce95d51fb"]
