Cell[TextData[{
 "Sending every tick to its earliest image is always a message function: the \
images of a tick are an initial segment of its causal future on ",
 StyleBox["b", "TI"],
 ", so the first image moves forward along ",
 StyleBox["b", "TI"],
 " as the tick does."
}], "ExampleText",ExpressionUUID->"5075d5dd-f2f9-4c72-98bc-eaa046a5fc6e"],

