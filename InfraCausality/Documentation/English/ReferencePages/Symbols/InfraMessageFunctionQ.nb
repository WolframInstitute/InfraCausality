Cell["\<\
A message function of the lattice observers drawn as the light rays from each \
tick to its image (red).\
\>", "ExampleText",ExpressionUUID->"bcb8ce26-3079-43f6-9272-b9672228a72b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraMessageFunction", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraMessageFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Labeled", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "w"}], "}"}], " ", "|->", " ", 
            RowBox[{
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{
               RowBox[{"{", "v", "}"}], ",", " ", 
               RowBox[{"{", "w", "}"}]}], "]"}], " ", "->", " ", "Red"}]}], ",",
            " ", "f"}], "]"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
            "StandardBlue"}], ",", " ", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
            "StandardGreen"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"87153657-4937-4c3a-b05f-d9c62e44455a"],

