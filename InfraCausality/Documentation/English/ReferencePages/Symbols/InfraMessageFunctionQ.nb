 "."
}], "ExampleText",ExpressionUUID->"e495196e-85bb-4428-9a78-eebfde0ae57f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"relation", " ", "=", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
             " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"position", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"b", ",", " ", 
           RowBox[{"Range", " ", "@", " ", 
            RowBox[{"Length", "[", "b", "]"}]}]}], "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
           "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"selections", ",", " ", 
          RowBox[{"f", " ", "|->", " ", 
           RowBox[{"InfraMessageFunctionQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}],
          "]"}], "]"}], " ", "===", "\n", "      ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"selections", ",", " ", 
          RowBox[{"f", " ", "|->", " ", 
           RowBox[{"LessEqual", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{"position", " ", "/@", " ", 
              RowBox[{"Values", "[", "f", "]"}]}], ")"}]}]}]}], "]"}], "]"}], 
       " ", "===", "\n", "      ", 
       RowBox[{"Sort", "[", 
        RowBox[{"KeySort", " ", "/@", " ", 
         RowBox[{"RandomInfraMessageFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
