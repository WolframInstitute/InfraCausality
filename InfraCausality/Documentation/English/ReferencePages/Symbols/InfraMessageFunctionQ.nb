Cell[TextData[{
 "The consecutive ticks {1, 4} and {2, 4} of the lattice observer ",
 StyleBox["a", "TI"],
 " have the same three images {4, 4}, {5, 4}, {6, 4}. Sent in order they give \
a message function; sent crosswise they do not, although each image is \
admissible."
}], "ExampleText",ExpressionUUID->"649c668c-e35b-4146-8a7b-79d054421520"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMessageFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "4"}], "}"}]}]}], "|>"}]}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "4"}], "}"}]}]}], "|>"}]}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e47cf2dd-7ed7-4cde-97b3-32cd036e79f5"],

