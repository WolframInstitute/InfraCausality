Cell[TextData[{
 "The consecutive ticks {1, 4} and {2, 4} of the lattice observer ",
 StyleBox["a", "TI"],
 " have the same three images {4, 4}, {5, 4}, {6, 4}. Sent in order they give \
a message function; sent crosswise they do not, although each image is \
admissible."
}], "ExampleText",ExpressionUUID->"4f27342d-fe28-4968-9af5-6a8f80419c22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMessageFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "4"}], "}"}]}]}], "|>"}]}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "4"}], "}"}]}]}], "|>"}]}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e3786403-fa51-4e3b-bb42-a4b4c8cc1dd8"],

