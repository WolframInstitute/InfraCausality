Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"relation", " ", "=", " ", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraMessageFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
            " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
          RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
           "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"selections", ",", " ", 
          RowBox[{"f_", " ", "/;", " ", 
           RowBox[{"InfraMessageFunctionQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}],
          "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMessageFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"selections", ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraMemberQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], 
           " ", "===", " ", 
           RowBox[{"InfraMessageFunctionQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], 
            "]"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f67c2189-85b5-4a0a-b5e2-95df1977b6b0"],

