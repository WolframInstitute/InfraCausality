Cell["\<\
A message function of the lattice observers drawn as the light rays from each \
tick to its image (red).\
\>", "ExampleText",ExpressionUUID->"d253b7f1-4e2f-42b2-b7b1-e23325e1997b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraMessageFunction", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraMessageFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Labeled", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "w"}], "}"}], " ", "|->", " ", 
            RowBox[{
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{
               RowBox[{"{", "v", "}"}], ",", " ", 
               RowBox[{"{", "w", "}"}]}], "]"}], " ", "->", " ", "Red"}]}], ",",
            " ", "f"}], "]"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
            "StandardBlue"}], ",", " ", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
            "StandardGreen"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c0d18abd-b523-4919-a860-6b5860ebdf8f"],

