  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The rapidity of the relativistic sum of two velocities is the sum of their \
rapidities.\
\>", "ExampleText",ExpressionUUID->"ac1fa654-6fe8-48fc-8c72-161d8a637a9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
     RowBox[{"Rapidity", "[", "v2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"191df9a3-d076-426c-8f13-e83f2a1315b5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d9b5ece6-1e1b-4273-9142-1b491ad94545"]
}, Open  ]],

Cell["\<\
The rapidity is the logarithm of the k-factor, and its hyperbolic tangent is \
the velocity.\
\>", "ExampleText",ExpressionUUID->"d2aac46a-2ff5-414e-a190-c5098dfbbbcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RapidityFromK", "[", 
      RowBox[{"KFactor", "[", "v", "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Rapidity", "[", "v", "]"}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Tanh", "[", 
      RowBox[{"Rapidity", "[", "v", "]"}], "]"}], " ", "==", " ", "v"}]}], ",",
    " ", 
   RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"308e4cba-77a6-4332-a9ed-fb9bf58896b0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9f101b89-1978-473b-a9ea-714d522dd666"]
}, Open  ]]
}, Open  ]],

