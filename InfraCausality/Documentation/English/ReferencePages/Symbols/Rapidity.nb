Notebook[{

Cell[CellGroupData[{
Cell["Rapidity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ba69ed48-45d1-4e3e-b035-7f2a90fc6b10"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Rapidity"]], 
     "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5823a21c-bb1f-4af3-9e58-7f539a39bc84"],
 "\[LineSeparator]",
 "gives the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0278c46-3870-4c12-8207-c7ee2d905602"],
 " of the velocity ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"95ed8688-5c5f-4c01-9933-70d2f5ba1250"],

Cell[TextData[{
 "Definition: the rapidity is the hyperbolic angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e9e653a-6314-40d4-b64c-41cad1aa3a63"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4330e9ec-9a55-4231-867f-ebc8c3cac4f8"],
 ". It is the logarithm of the k-factor, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03e16b54-0268-42d2-beb3-48a229681105"],
 ", so rapidities add where k-factors multiply: the rapidity is the additive \
parameter of the boosts of the Minkowski plane."
}], "Notes",ExpressionUUID->"13dda5a9-65e3-46fc-a108-d872d9b33ae4"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"ArcTanh", "[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce866e01-6954-443d-86df-74bd9de16963"],
 ", exact for exact ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"815543d0-26bd-457a-854c-c523b5a826af"]
}, Open  ]],

