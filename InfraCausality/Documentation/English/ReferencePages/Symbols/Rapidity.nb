Cell["\<\
The rapidity of the velocity 3/5 is log 2, the logarithm of its k-factor 2.\
\>", "ExampleText",ExpressionUUID->"27f73dc6-f9e3-43c9-b3e5-6c295cfcc2d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Rapidity", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
      RowBox[{"3", "/", "5"}], "]"}], " ", "==", " ", 
     RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d750480-7394-40bd-b1e7-e9b009699008"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ArcTanh", "[", 
    FractionBox["3", "5"], "]"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"da887ef7-bab4-4510-b226-2e4da8839364"]
}, Open  ]],

Cell["\<\
The rapidity over the velocity; it diverges at the speed of light.\
\>", "ExampleText",ExpressionUUID->"efcd77b7-16fc-4a1e-8da5-a1af5a612b8d"],

