Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["S", "TI"],
 " is a causal future when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and ",
 StyleBox["S", "TI"],
 " = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["v", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 "} for some ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["S", "TI"],
 ". Order and repetition in the list do not matter."
}], "Notes",ExpressionUUID->"ebc2033a-7422-486a-ac18-41c035344423"],

Cell[TextData[{
 "Such a ",
 StyleBox["v", "TI"],
 " is unique: it is the least element of ",
 StyleBox["S", "TI"],
 ", since every event of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") follows it, and two events with the same causal future precede each other \
and coincide. So the predicate says that ",
 StyleBox["S", "TI"],
 " is an up-set, closed under passing to the future, with a least element; an \
up-set with two minimal events, such as the causal future of a pair of \
incomparable events, fails."
}], "Notes",ExpressionUUID->"bcb6bf69-e9dc-436e-97cd-7471ea5336d8"],

Cell[TextData[{
 "The predicate takes a set, never an object: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFutureQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalFuture", "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab0bdc7-763f-40d6-a164-dc395784b941"],
 " stays unevaluated. Test the support, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eff34e18-09d6-4569-a978-6028202ea532"],
 ", or ask ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a225c68-d155-4fae-adb5-2c73bb097d9f"],
 " whether a set is the causal future of one particular event."
}], "Notes",ExpressionUUID->"8e66cdfd-f18c-42d3-b1fd-4d599f33f8bc"],

Cell[TextData[{
 "The set predicates of the guide form a small hierarchy. A set that is both \
a causal future and a causal past, ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") = ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 "), is the causal diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] and passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cac2677c-6c30-4f09-bde1-5d8e0227b6b3"],
 "; a single event passes all three. A proper-time cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da069af9-8cbc-42a0-ae1d-7dc0f450ad9c"],
 " below the height of the future is not an up-set and fails."
}], "Notes",ExpressionUUID->"ac4682bc-4364-455c-9dfa-ce3d81e4dd70"]
}, Open  ]],

