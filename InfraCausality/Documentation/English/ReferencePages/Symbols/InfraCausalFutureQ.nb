Cell["\<\
A list of sets is tested set by set, and a density by its keys.\
\>", "ExampleText",ExpressionUUID->"5c72b52e-29d0-4119-a540-c84fb8d2c035"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraCausalFutureQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraCausalFutureQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "5", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4629c25d-b3fe-4f4d-b3b2-1853a9b48c40"],

