Cell[TextData[{
 "On each substrate: the causal future of an event, the causal future of two \
incomparable events, and the proper-time cut at ",
 StyleBox["t", "TI"],
 " = 2 of the causal future of an event at height 1."
}], "ExampleText",ExpressionUUID->"f4defd3d-d21f-47a0-b192-dc5d9669cf0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}], ",", " ", "2"}], 
          "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalFutureQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", "s"}]}], "]"}]}], "]"}], ",", "\n",
        "     ", 
       RowBox[{"InfraCausalFutureQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalFuture", "[", "s", "]"}]}], "]"}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"InfraCausalFutureQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalFuture", "[", 
            RowBox[{"v", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ca6bfe56-4499-4429-a68e-614401bf5545"],

