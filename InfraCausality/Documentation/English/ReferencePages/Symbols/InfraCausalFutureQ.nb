Cell["\<\
The causal future of every event passes, and the event is the unique least \
element of the set.\
\>", "ExampleText",ExpressionUUID->"f1e1385f-6325-4b9b-adad-78c00164596d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"future", " ", "=", " ", 
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"InfraCausalFutureQ", "[", 
             RowBox[{"g", ",", " ", "future"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"future", ",", " ", 
               RowBox[{"e", " ", "|->", " ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"VertexOutComponent", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "future"}], 
                 "]"}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", "v", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2bc0ae80-d02b-4c31-943f-7939b465554a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"10ea09f6-3635-420a-9c7c-322fd7a5bda9"]
}, Open  ]],

Cell["\<\
A set that passes is an up-set: every out-neighbour of one of its events is \
one of its events.\
\>", "ExampleText",ExpressionUUID->"d05f39ff-dcb5-4357-ad73-f9c3d540c84b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"sets", ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalFutureQ", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", 
        " ", 
        RowBox[{"set", " ", "|->", "\n", "      ", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"Union", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"VertexOutComponent", "[", 
                RowBox[{"g", ",", " ", "#", ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ",
               "set"}], ")"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a353d992-4b47-4e29-8a80-b69f087442e4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"93c8d1c6-1182-4b6d-824b-d2e569146bcb"]
}, Open  ]],

Cell["\<\
A set that is both a causal future and a causal past is a causal diamond.\
\>", "ExampleText",ExpressionUUID->"43b52591-8cf0-4446-a8d9-0c3583d764e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"sets", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraCausalFutureQ", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&&", " ", 
            RowBox[{"InfraCausalPastQ", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"InfraCausalDiamondQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"18bf31fd-c615-4142-972d-d2cb804deae9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9a787dd9-33a4-40aa-aec4-9c0f990bdff7"]
}, Open  ]],

Cell["\<\
The proper-time cuts of the causal future of an event pass only at and above \
the height of the future.\
\>", "ExampleText",ExpressionUUID->"be9a5830-b374-453f-a5ad-448272a08044"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"height", " ", "=", " ", 
        RowBox[{"Max", " ", "@", " ", 
         RowBox[{"UniversalTime", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
            " ", "\"\<Subgraph\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraCausalFutureQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"RandomInfraCausalFuture", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalFuture", "[", 
              RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "height"}], "}"}]}], "]"}], 
       " ", "===", "\n", "      ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"False", ",", " ", "height"}], "]"}], ",", " ", "True"}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"414e6ab3-7fae-4c1b-9f59-221b153da770"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"83a9a4a2-1997-429a-b8f2-025ed163cb09"]
}, Open  ]]
}, Open  ]],

