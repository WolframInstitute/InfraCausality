Cell["\<\
The direction is a unit vector, at the worldline angle from the time axis.\
\>", "ExampleText",ExpressionUUID->"88e698a9-98d4-442e-bea6-fa189663161e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"WorldlineDirection", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], " ", "==", " ", "1"}], 
    " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"WorldlineDirection", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], " ", "==", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"WorldlineAngle", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9752b5e3-6980-49f5-aa4a-302f47e34e6e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"52d2ff7b-3375-4a32-a768-70ec21427536"]
}, Open  ]],

Cell[TextData[{
 "Along the direction the radar distance is ",
 StyleBox["v", "TI"],
 " times the radar time."
}], "ExampleText",ExpressionUUID->"8fd926dd-b879-46c6-a82d-0eb3e180849f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"WorldlineDirection", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", "phi"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{
      RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
      RowBox[{"v", " ", 
       RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"92761e4b-a9bd-4cab-853f-9683292e16f4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"76c4c70b-546e-4ace-b115-40b2f6b2b22c"]
