Cell["\<\
The direction of the rest worldline and of the worldline of velocity 3/5.\
\>", "ExampleText",ExpressionUUID->"9367a123-c739-41e0-a239-ae68a1ff91c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"WorldlineDirection", "[", "0", "]"}], ",", " ", 
   RowBox[{"WorldlineDirection", "[", 
    RowBox[{"3", "/", "5"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ff23d643-f724-42ab-ad18-3d367776bb9a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", 
      SqrtBox["34"]], ",", 
     FractionBox["5", 
      SqrtBox["34"]]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3ea6c632-c2b6-419f-aeaf-133f785ae0e6"]
}, Open  ]],

Cell["\<\
The directions of the velocities 0, 0.2, \[Ellipsis], 0.8 at the light angle \
\[Pi]/4, with the two light directions dashed.\
\>", "ExampleText",ExpressionUUID->"dd157e47-cfbc-4b32-8235-9d6705558154"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Hue", "[", 
          RowBox[{"0.6", " ", "-", " ", 
           RowBox[{"0.6", " ", "v"}]}], "]"}], ",", " ", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"WorldlineDirection", "[", "v", "]"}]}], "}"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", "0", ",", " ", "0.8", ",", " ", "0.2"}], 
        "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"StandardYellow", ",", " ", "Dashed", ",", " ", 
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{
            RowBox[{"Pi", "/", "4"}], ",", " ", "True"}], "]"}]}], "}"}], 
        "]"}], ",", " ", 
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{
            RowBox[{"Pi", "/", "4"}], ",", " ", "False"}], "]"}]}], "}"}], 
        "]"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6301fee1-7347-476c-bfd2-063c8f805605"],

Cell[BoxData[
 GraphicsBox[{{
    {Hue[0.6], ArrowBox[{{0, 0}, {0., 1.}}]}, 
    {Hue[0.48], 
     ArrowBox[{{0, 0}, {0.19611613513818404`, 0.9805806756909201}}]}, 
    {Hue[0.36], ArrowBox[{{0, 0}, {0.3713906763541037, 0.9284766908852593}}]}, 
