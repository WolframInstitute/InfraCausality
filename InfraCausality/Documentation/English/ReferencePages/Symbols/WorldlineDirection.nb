Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"490ba7da-52d7-46a3-805b-87524ed0c7cb"],

Cell[TextData[{
 "Definition: the Euclidean unit vector along the worldline of velocity ",
 StyleBox["v", "TI"],
 " through the origin, in the picture where the rest observer is the time \
axis {0, 1} and light runs at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to it. A negative ",
 StyleBox["v", "TI"],
 " points to the left."
}], "Notes",ExpressionUUID->"09318c43-1fa0-47ac-8c57-e1bfff85bc63"]
}, Open  ]],

