Cell["\<\
Every entry at size \"Small\" is acyclic, transitively reduced and weakly \
connected, and its default drawing has every edge pointing upward.\
\>", "ExampleText",ExpressionUUID->"61974bba-eaba-43aa-ac77-a27e26670f58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"y", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{"AcyclicGraphQ", "[", "g", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeCount", "[", "g", "]"}], " ", "==", " ", 
        RowBox[{"EdgeCount", " ", "@", " ", 
         RowBox[{"TransitiveReductionGraph", "[", "g", "]"}]}]}], " ", "&&", 
       " ", 
       RowBox[{"WeaklyConnectedGraphQ", "[", "g", "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
           RowBox[{"y", "[", 
            RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0722d651-8019-4141-bd3b-7a6b6033d2c4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"694bc9ad-a91f-45fc-9ed6-f6f364c27b99"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the causal order is the product order, and the \
lattice has (",
 StyleBox["n", "TI"],
 " + 1)\.b2 events."
}], "ExampleText",ExpressionUUID->"0fb2e00e-43fb-422a-b663-fbe3e34a9692"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"VertexCount", "[", "g", "]"}], " ", "==", " ", 
     RowBox[{"7", "^", "2"}]}], " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
      RowBox[{"v", " ", "|->", " ", 
       RowBox[{
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"VertexOutComponent", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "v", "}"}]}], "]"}]}], " ", "===", " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"w", " ", "|->", " ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{"v", " ", "<=", " ", "w"}], "]"}]}]}]}], "]"}]}]}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"685091cd-b77e-4389-9f87-e8073164a0a3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"cca9c990-53f5-41fc-88b7-031e3f8c2502"]
}, Open  ]],

Cell[TextData[{
 "On the sprinkling the causal order is the light-cone order of the sprinkled \
points: ",
 StyleBox["u", "TI"],
 " \[Precedes] ",
 StyleBox["v", "TI"],
 " exactly when ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["u", "TI"],
 ") > |",
 StyleBox["x", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["x", "TI"],
 "(",
 StyleBox["u", "TI"],
 ")|."
}], "ExampleText",ExpressionUUID->"2000e2aa-5713-4078-a2ba-51db9038264a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"VertexOutComponent", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", "u", "}"}]}], "]"}], ",", " ", "v"}], "]"}], " ", "===",
         " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", 
            RowBox[{"c", "[", "v", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"Last", "[", 
            RowBox[{"c", "[", "u", "]"}], "]"}]}], " ", ">", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"c", "[", "v", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"First", "[", 
             RowBox[{"c", "[", "u", "]"}], "]"}]}], "]"}]}], ")"}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"dde5dc0d-9370-44fe-8439-1d69f6e2201c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"867e52d2-3017-4afa-997c-842d37dbc6f9"]
}, Open  ]],

Cell["\<\
On the cylinder lattice every event above the bottom row has two direct \
predecessors, and the rows are the slices of the universal time.\
\>", "ExampleText",ExpressionUUID->"63b242ef-e097-4274-a216-5ca71d788107"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{
          RowBox[{"Last", "[", "v", "]"}], " ", ">", " ", "0"}]}]}], "]"}], ",",
       " ", 
      RowBox[{"v", " ", "|->", " ", 
       RowBox[{
        RowBox[{"VertexInDegree", "[", 
         RowBox[{"g", ",", " ", "v"}], "]"}], " ", "==", " ", "2"}]}]}], 
     "]"}], " ", "&&", "\n", "    ", 
    RowBox[{
     RowBox[{"UniversalTime", "[", "g", "]"}], " ", "===", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"Last", ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"bc38c32b-455e-4076-a726-007671fa0654"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0babbfb3-1d00-49df-b924-06246e2339c4"]
}, Open  ]],

Cell["\<\
On a spray graph the universal time is the graph distance from the centre of \
the undirected substrate.\
\>", "ExampleText",ExpressionUUID->"8e8cf50a-65a1-492f-9ab1-5845a38264b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<SquareTilingSprayGraph\>\"", ",", 
     " ", "\"\<HexagonalTilingSprayGraph\>\"", ",", 
     " ", "\"\<SquareMeshSprayGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{"name", ",", " ", 
             
             RowBox[{"\"\<SprayGraph\>\"", " ", "->", 
              " ", "\"\<Graph\>\""}]}], "]"}], ",", " ", "\"\<Small\>\""}], 
          "]"}]}], ",", " ", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "s", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"UniversalTime", "[", "g", "]"}], " ", "===", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"v", " ", "|->", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"s", ",", " ", "c", ",", " ", "v"}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"e0a21773-916f-438d-a626-b6bf783c85f7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"7641a769-13c0-4652-84cd-5208e3179ed2"]
}, Open  ]],

Cell["The held code builds the entry.", "ExampleText",ExpressionUUID->"30f667f7-e007-4761-bfe4-ec031c92fe61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"VertexList", "[", "h", "]"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"EdgeList", "[", "h", "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[6]:= ",ExpressionUUID->"181db62c-93bd-48f4-bc4e-c4397ba04938"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"1e2a4ba0-0dfb-4778-879e-56fb562c13ff"]
}, Open  ]]
}, Open  ]],

