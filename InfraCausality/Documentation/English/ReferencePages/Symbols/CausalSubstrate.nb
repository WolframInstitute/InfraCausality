     " + 1, ",
     StyleBox["j", "TI"],
     "), (",
     StyleBox["i", "TI"],
     ", ",
     StyleBox["j", "TI"],
     " + 1); the 1 + 1 light-cone lattice with ",
     StyleBox["x", "TI"],
     " = (",
     StyleBox["j", "TI"],
     " \[Minus] ",
     StyleBox["i", "TI"],
     ")/2, ",
     StyleBox["t", "TI"],
     " = (",
     StyleBox["i", "TI"],
     " + ",
     StyleBox["j", "TI"],
     ")/2"
    }], "TableText",ExpressionUUID->"e7743996-451a-41cc-b464-ab5607484db6"], 
    Cell[TextData[{
     StyleBox["n", "TI"],
     " = 6, 10, 16"
    }], "TableText",ExpressionUUID->"5e24032a-3e1c-441e-8c81-8a5d11d995e1"]},
   {Cell["", "TableText",ExpressionUUID->
     "058370cc-98b5-4c73-9dd1-7ea6569c1640"], Cell[TextData[Cell[
    BoxData["\"\<CylinderLatticeGraph\>\""], "InlineFormula",
