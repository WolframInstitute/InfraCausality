Cell[TextData[{
 "A causal substrate is the Hasse diagram of a finite causal order: its \
vertices are the events, its edges the covering pairs ",
 StyleBox["u", "TI"],
 " \[Precedes] ",
 StyleBox["v", "TI"],
 " with nothing between, so the order is reachability and every directed path \
is a chain. Every entry is acyclic, transitively reduced and weakly \
connected, and it is drawn with time upward in the style ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "267f1da5-e00f-44d3-bca3-ac631fb8122e"],
 " of its size. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrateCode"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateCode", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1725341-0459-40fa-a348-87ff1d346148"],
 " gives the code that builds it; it is the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71d41c46-0b65-48fc-8d41-5df978484372"],
 " for directed graphs."
}], "Notes",ExpressionUUID->"feab6b60-1b29-4279-b256-6ba5a9f7a281"],

Cell[BoxData[GridBox[{
   {Cell["Group", "TableText",
