Notebook[{

Cell[CellGroupData[{
Cell["CausalSubstrate", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d849aa50-22f3-41c3-a784-a4346d392d74"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrate"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c748a347-54e8-4e06-bacf-16dbff2f88fb"],
 "\[LineSeparator]",
 "gives the named causal graph at size \"Small\", \"Medium\" or \"Large\", a \
transitively reduced DAG.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2535aec1-dfce-4d9f-b7a0-21498f661835"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrate"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a81d6446-4f50-4c89-90e9-c3cdfd269f14"],
 "\[LineSeparator]",
 "lists the names by group."
}], "Usage",ExpressionUUID->"f61c936b-9279-4cfb-97ea-2cc8de612ef2"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741037bb-e10c-4389-920c-435c08e4eeca"],
 " the entries ",
 Cell[BoxData["\"\<CubicLatticeGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221e7989-7c66-4b2e-bc16-3a2d6941309a"],
 " and ",
 Cell[BoxData["\"\<MinkowskiSprinkling3D\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dda268b7-e637-495c-9a93-79802a6ea5d5"],
 " keep their full point (",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ", ",
 StyleBox["t", "TI"],
 "), and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4277731-0f70-4a22-b8bb-92e2ae127bd5"],
 " draws them in the plane by the cabinet projection (",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ", ",
 StyleBox["t", "TI"],
 ") \[RightTeeArrow] (",
 StyleBox["x", "TI"],
 " + ",
 StyleBox["y", "TI"],
 "/(2\[Sqrt]2), ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["y", "TI"],
 "/(2\[Sqrt]2)), time up and the second space axis receding at 45\[Degree] \
with half its length, while the substrate itself keeps the 3D point."
}], "Notes",ExpressionUUID->"a9ebba4f-0a52-4e47-b6a5-cbaccc0a0200"],

Cell[TextData[{
 "Experimental: the ",
 Cell[BoxData["\"\<WolframModel\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56faae4e-9f1d-4daa-9b9c-636319ec6440"],
 " group holds the causal graphs of six notable universes of the Wolfram \
Physics registry, \"wm3467\", \"wm7978\", \"wm4735\", \"wm1529\", \"wm3975\" \
and \"wm2216\", evolved for a fixed number of events per size and reduced to \
the Hasse diagram of their causal order. The vertices are the event numbers, \
a linear extension of the order. The edge lists ship with the paclet as the \
asset ",
 Cell[BoxData["\"\<WolframModelCausalGraphs\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dce8e11-5cee-4cd0-bb11-ed0713ff597c"],
 ", so no evolution runs at load time. The causal orders of \"wm3467\", \
\"wm7978\" and \"wm4735\" are two-dimensional: their largest antichain and \
their longest chain both grow like the square root of the number of events \
(for \"wm7978\" at 100, 300 and 800 events the width is 12, 22 and 37 and the \
height 18, 29 and 46)."
}], "Notes",ExpressionUUID->"dfd2bc37-4f01-42fb-8c18-fd0f80592e74"]
}, Open  ]],

