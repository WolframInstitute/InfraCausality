Cell["\<\
The causal graph of the universe \"wm3467\" at size \"Small\", with its slice \
at height 5 and the causal future of event 10.\
\>", "ExampleText",ExpressionUUID->"0e557c1b-6999-4ae0-9825-057d14315ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<wm3467\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSlice", "[", "5", "]"}], ",", " ", 
       RowBox[{"InfraCausalFuture", "[", "10", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"30c5ffd5-8189-43ed-9d1b-a768ca37d795"],

