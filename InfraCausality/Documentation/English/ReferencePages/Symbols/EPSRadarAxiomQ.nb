Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} of the diamond lattice folds the lattice along itself and fails the \
axiom; a staircase worldline breaks the mirror and satisfies it; two \
observers resolve the fold."
}], "ExampleText",ExpressionUUID->"580c0ce9-9f2c-4331-8056-7d32138a61c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diagonal", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"staircase", " ", "=", " ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Catenate", " ", "@", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "i"}], "}"}]}], 
            "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"shifted", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"m", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EPSRadarAxiomQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "diagonal", "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"EPSRadarAxiomQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "staircase", "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"EPSRadarAxiomQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"diagonal", ",", " ", "shifted"}], "}"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1c48f008-f72f-4398-ac60-68e7f5708230"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2e94f55d-b644-492c-8e9b-f39ce3a37f96"]
}, Open  ]],

Cell["\<\
The domain of the diagonal at its chart positions, distance across and time \
up: the two halves of the lattice lie on top of each other, the fold the \
predicate detects.\
\>", "ExampleText",ExpressionUUID->"c8a6d37a-abec-4f90-9454-2a32f3da9a91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "diagonal", "]"}], ",", 
       " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
       "StandardRed"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ebc4c953-48cc-40c7-ab7f-11add570f535"],

