Cell[CellGroupData[{
Cell["EPSRadarAxiomQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f0969b9-0e7f-4dd7-b30b-9fb0baf9e7d8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EPSRadarAxiomQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/EPSRadarAxiomQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraRadarCoordinates", "[", 
     StyleBox["a", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbca483a-8b38-4d52-9463-ef556d3596e3"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9b5a7b-7dc6-4eb8-b054-e20866394376"],
 " if axiom D2 holds on ",
 StyleBox["g", "TI"],
 ": the radar coordinates of the observer ",
 StyleBox["a", "TI"],
 " are injective on its radar domain.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0a8cc587-c2ff-41e7-9e80-2b9b8f9bb4e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EPSRadarAxiomQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/EPSRadarAxiomQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraRadarCoordinates", "[", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["a", "TI"], ",", " ", 
       StyleBox["b", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b8cc94d-6eb5-44f2-9dca-ff1c5cc9cedb"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac2afad9-a1cf-4c37-81d4-2e4f19a53b9b"],
 " if the joined radar coordinates of the observers are injective on their \
common radar domain."
}], "Usage",ExpressionUUID->"ff8e1120-ad2d-4c52-a3d1-3a7cbdf96157"],

Cell[TextData[{
 "Statement: with ",
 StyleBox["e", "TI"],
 " \[RightArrow] {(",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2, (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2} the radar coordinates of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26bc92d1-a1ec-46cc-bd09-a7ac010b0781"],
 " on the radar domain, the axiom holds when two distinct events of the \
domain never get the same coordinates, so that the coordinates are a chart of \
the domain. For a list of observers the coordinates are the concatenated \
vectors on the intersection of the domains."
}], "Notes",ExpressionUUID->"aaf67159-8980-4f6f-a347-e111a72d0b24"],

Cell[TextData[{
 "The axiom is a statement about the observer space, the ",
 Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d79acd7-53ff-4d39-9e03-0ea49a740018"],
 " reading of the head: it holds exactly when every fiber is a single event, \
when the domain has as many coordinate cells as events, and when the observer \
space is a fiber bundle with a point as fiber. The predicate tests the \
observers; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96cc1cda-995f-4561-8f56-49c48452cf84"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fba35db-574b-45fc-95f1-9ccb4da42a1d"],
 " test the space they build."
}], "Notes",ExpressionUUID->"2be0310b-518a-4b59-bc01-6cc89ad8fb2c"],

Cell["\<\
Radar distance is unsigned, so a single observer in 1 + 1 dimensions sees the \
two sides of its worldline folded onto each other and fails the axiom unless \
the graph breaks the mirror; a second observer off the first separates the \
sides. An observer that satisfies the axiom on its own keeps it when more \
observers are joined, since the coordinates only grow.\
\>", "Notes",ExpressionUUID->"f6a01064-0828-45a4-91a2-5e3abf76a4fa"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"caaf940c-3b70-486f-8041-4efd51d69b97"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b603f201-de66-4213-8468-bfcf9141c5b7"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"9c0ee883-5733-46ab-9de9-6809f2f8096c"],
     Cell["Name", "TableText",
     FontWeight->Bold,ExpressionUUID->"e45a863d-3162-4106-98c7-1b7934b37813"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"31ac68ca-8af2-4752-b05a-18c207f13a41"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0d1d95dc-a2c2-488d-b991-9b6ff945fa85"], Cell[
    "EPS", "TableText",ExpressionUUID->
     "db2aa85d-9f5b-442e-98b1-7f3fb7f6d06a"], Cell[
    "Axiom D2", "TableText",ExpressionUUID->
     "1eeabeb3-1583-48aa-9a84-15fc1e420bf7"], Cell["\<\
The message and echo functions of finitely many particles give every event of \
a neighbourhood coordinates that distinguish it from every other event, the \
radar coordinates.\
\>", "TableText",ExpressionUUID->"2c1deba6-9d68-49c2-8566-7697d55b4871"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "888bb784-7ced-4865-80cd-2a16cf1c9ab9"], Cell[
    "Minkowski space", "TableText",ExpressionUUID->
     "dacf2ded-dd20-4ad3-afb6-da44ec936d5a"], Cell[
    "Radar coordinates", "TableText",ExpressionUUID->
     "a3ad788f-35c4-4e09-bc45-37c2a9708eee"], Cell["\<\
An inertial observer in the plane locates an event up to the mirror in its \
worldline by the times it sends and receives light reflected there; a second \
observer off the worldline fixes the side.\
\>", "TableText",ExpressionUUID->"a0ec19b1-042c-4e8c-b0d5-0080bbf60f58"]}
  }]], "3ColumnTableMod",ExpressionUUID->"cb19f293-025a-49d8-b0a3-\
ba555385324b"]
}, Open  ]],

