Cell["\<\
The axiom holds exactly when every fiber of the observer space is one event, \
and then the space is a fiber bundle with a point as fiber.\
\>", "ExampleText",ExpressionUUID->"aec26e61-279e-4f75-81e4-73b35ef9aca6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diagonal", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"staircase", " ", "=", " ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Catenate", " ", "@", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "i"}], "}"}]}], 
            "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"shifted", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"m", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraRadarCoordinates", "[", "diagonal", "]"}], ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "staircase", "]"}], ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"diagonal", ",", " ", "shifted"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"diagonal", ",", " ", "staircase"}], "}"}], "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"chart", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fib", " ", "=", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", "chart", ",", " ", "\"\<Fibration\>\""}], 
           "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"EPSRadarAxiomQ", "[", 
           RowBox[{"g", ",", " ", "chart"}], "]"}], " ", "===", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"InfraFibers", "[", "fib", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"VertexCount", "[", "#", "]"}], " ", "==", " ", "1"}], 
             " ", "&"}]}], "]"}]}], " ", "&&", " ", 
         RowBox[{"Implies", "[", 
          RowBox[{
           RowBox[{"EPSRadarAxiomQ", "[", 
            RowBox[{"g", ",", " ", "chart"}], "]"}], ",", " ", 
           RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "]"}]}]}], 
       "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c5a2c60-6019-442f-be9d-c751b60ccd1e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cfaff220-5dd9-4e50-8601-9432ed35142e"]
}, Open  ]],

Cell["\<\
The axiom holds exactly when the base graph has one cell per event of the \
domain.\
\>", "ExampleText",ExpressionUUID->"d56c75e5-f134-4962-a734-cc46b1f39481"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"EPSRadarAxiomQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarCoordinates", "[", "a", "]"}]}], "]"}], " ", "===",
       " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VertexCount", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
           " ", "\"\<BaseGraph\>\""}], "]"}]}], " ", "==", " ", 
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
           " ", "\"\<Domain\>\""}], "]"}]}]}], ")"}]}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a8d2daf1-7fd9-40e5-8b7a-3560a35bb7aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2691da17-6fda-465e-a5f7-c77203cb374f"]
}, Open  ]],

Cell[TextData[{
 "The fibers of the diagonal are the mirror pairs (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "): the fold is the whole failure."
}], "ExampleText",ExpressionUUID->"7d18b839-8cdd-4f0d-9186-2ee69fa03c3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"InfraFibers", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarCoordinates", "[", "diagonal", "]"}], ",", 
         " ", "\"\<Fibration\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", "fibers"}], ",", " ", 
     RowBox[{"fiber", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Sort", "[", "fiber", "]"}], " ", "===", " ", 
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", "fiber"}], ",", " ", 
           RowBox[{"Reverse", " ", "@", " ", 
            RowBox[{"First", " ", "@", " ", "fiber"}]}]}], "}"}]}]}]}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7f4735a6-c5ce-4587-bbb2-800e55d63438"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c592e08a-f43f-4e8d-8058-b8c27a59af7c"]
}, Open  ]]
}, Open  ]],

