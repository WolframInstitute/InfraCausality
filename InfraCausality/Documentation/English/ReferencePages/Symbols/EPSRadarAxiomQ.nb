Cell["\<\
A random timelike geodesic of each substrate: on the lattices its chart is \
injective, on the sprinkling the observer identifies events.\
\>", "ExampleText",ExpressionUUID->"196b1b0f-ca67-467d-9832-9a146e211e84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EPSRadarAxiomQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarCoordinates", "[", "a", "]"}]}], "]"}], ",", "\n",
        "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
          " ", "\"\<Domain\>\""}], "]"}]}], ",", " ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"InfraFibers", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
           " ", "\"\<Fibration\>\""}], "]"}]}]}]}], "}"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c331e8bf-c040-4d75-9b6c-0d5011ad87e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "49", ",", "49"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"False", ",", "23", ",", "15"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "16", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f4fbe440-7895-43ff-93da-43a6b7f39e68"]
}, Open  ]],

Cell["\<\
Joining a second observer of the sprinkling: the common domain, the cells of \
the first observer on it and the cells of the joined coordinates.\
\>", "ExampleText",ExpressionUUID->"867b2f6a-8cdd-4384-9e49-d9f947731720"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"domain", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", 
       " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
