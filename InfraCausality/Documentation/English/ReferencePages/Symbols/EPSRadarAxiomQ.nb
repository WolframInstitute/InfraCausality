     RowBox[{"EPSRadarAxiomQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "domain"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
            " ", "\"\<Coordinates\>\""}], "]"}], ",", " ", "domain"}], 
