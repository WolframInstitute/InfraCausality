Cell["\<\
On the sprinkling the causal height grows with the coordinate time of the \
event, but not monotonically: an event near the edge of the diamond has a \
short past.\
\>", "ExampleText",ExpressionUUID->"c3dad750-8f93-4f79-89c8-6109ff53f5e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"CausalHeight", "[", "g", "]"}]}]}], "}"}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<coordinate time\>\"", ",", " ", "\"\<causal height\>\""}],
        "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "StandardBlue"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c5ba0ced-cc2e-474d-a413-e40c7a20f37a"],

