    "Height", "TableText",ExpressionUUID->
     "aad567ab-1794-41c7-a39d-da5c0e43d349"], Cell["\<\
The length of a longest chain ending at an element, the rank function of a \
graded order.\
\>", "TableText",ExpressionUUID->"66c05cad-74aa-4b4d-b536-45d09f9dc20d"]}
  }]], "3ColumnTableMod",ExpressionUUID->"40036fcf-771c-454e-b255-\
9ea0433953b2"]
}, Open  ]],

