Cell["\<\
The causal height increases along every edge and vanishes exactly on the \
sources.\
\>", "ExampleText",ExpressionUUID->"dca5097c-705a-475e-b4be-a7e603ae85f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"CausalHeight", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"First", " ", "@", " ", "e"}], "]"}], " ", "<", " ", 
           RowBox[{"t", "[", 
            RowBox[{"Last", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}], " ", "&&",
        "\n", "      ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"VertexInDegree", "[", "g", "]"}], ",", " ", "0"}], 
          "]"}]}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"688ec84d-be2f-48e2-9f88-3453b15c758b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"58d4bcbd-9885-4fc5-b4c7-c2c3883f70f0"]
}, Open  ]],

Cell["\<\
It is the length of a longest chain from a source, by brute force over all \
paths.\
\>", "ExampleText",ExpressionUUID->"4ec697e0-ffbe-4b22-9797-95305e77bc1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"CausalHeight", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"sources", " ", "=", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"VertexInDegree", "[", "g", "]"}], ",", " ", "0"}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"t", "[", "v", "]"}], " ", "==", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{
             RowBox[{"Length", " ", "/@", " ", 
              RowBox[{"Catenate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"FindPath", "[", 
                  RowBox[{
                  "g", ",", " ", "#", ",", " ", "v", ",", " ", "Infinity", ",",
                    " ", "All"}], "]"}], " ", "&"}], " ", "/@", " ", 
                "sources"}], "]"}]}], " ", "-", " ", "1"}]}], "]"}]}]}]}], 
       "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e8412d22-66e8-43f9-b022-e3505cfeaeb7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"aecb1bfd-9e9d-4c9a-bc23-901c0cf86745"]
}, Open  ]],

Cell["\<\
Every event off the sources has a direct predecessor exactly one slice below \
it.\
\>", "ExampleText",ExpressionUUID->"5ebd4282-606c-49b3-be8b-1415d37bc765"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"CausalHeight", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"v", " ", "|->", " ", 
           RowBox[{
            RowBox[{"t", "[", "v", "]"}], " ", ">", " ", "0"}]}]}], "]"}], ",",
         " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{
          RowBox[{"t", "[", "v", "]"}], " ", "==", " ", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"t", " ", "/@", " ", 
             RowBox[{"VertexInComponent", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"{", "v", "}"}], ",", " ", 
               RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b7426dc9-b0af-4638-95c2-e77ec80f5c25"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1709e346-609d-4e6c-8032-925321ab8977"]
}, Open  ]],

Cell[TextData[{
 "With the causal height of the reversed graph, the depth below the sinks, \
the sum is at most the length ",
 StyleBox["h", "TI"],
 " of a longest chain, with equality exactly on the events of the longest \
chains. On the two lattices every event lies on one; on the sprinkling some \
do not."
}], "ExampleText",ExpressionUUID->"d91c3eda-494b-49cf-b8b8-38353736bc1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sum", " ", "=", " ", 
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"CausalHeight", "[", "g", "]"}], ",", " ", 
             RowBox[{"CausalHeight", "[", 
              RowBox[{"ReverseGraph", "[", "g", "]"}], "]"}]}], "}"}], ",", 
           " ", "Total"}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"CausalHeight", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", "sum", "]"}], " ", "==", " ", "h"}], " ", "&&", 
       " ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"sum", ",", " ", 
            RowBox[{"EqualTo", "[", "h", "]"}]}], "]"}]}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Union", " ", "@@", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", "]"}], ",", " ", "All"}], 
          "]"}]}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"0a9922e5-60fc-46d5-b8eb-2c4083755f6a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"9aa0fb24-1365-47dc-82a7-af30a1eab665"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the causal height of (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") is ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ", and on the cylinder lattice it is the row."
}], "ExampleText",ExpressionUUID->"3fdddecb-7815-4c46-a112-4670542b5f52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"cylinder", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"CausalHeight", "[", "diamond", "]"}], " ", "===", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"Total", ",", " ", 
       RowBox[{"VertexList", "[", "diamond", "]"}]}], "]"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"CausalHeight", "[", "cylinder", "]"}], " ", "===", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"Last", ",", " ", 
       RowBox[{"VertexList", "[", "cylinder", "]"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"c418f700-0753-4dd0-b45c-9a88c0317456"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"31e95d63-3f77-4eb9-8018-19e5b344e9ed"]
}, Open  ]],

Cell[TextData[{
 "On a timelike geodesic from a source the causal height of the ",
 StyleBox["m", "TI"],
 "-th tick is ",
 StyleBox["m", "TI"],
 " \[Minus] 1: the ticks of a geodesic observer from the beginning count the \
causal height."
}], "ExampleText",ExpressionUUID->"b9bc89e0-f16a-474a-ae23-d56704de5455"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"CausalHeight", "[", "g", "]"}], " ", "/@", " ", "a"}], " ", "===",
        " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "a", "]"}], " ", "-", " ", "1"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"dfe52260-8e2d-4927-9940-d0faf4f76e05"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"f06c5912-f9e1-4d70-b7ad-5d12f6eaa787"]
}, Open  ]]
}, Open  ]],

