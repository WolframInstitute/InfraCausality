Cell["\<\
On each substrate: an observer passes, the same observer with an inner tick \
removed fails, and so does the observer read backwards.\
\>", "ExampleText",ExpressionUUID->"2c240dda-2a99-4726-99e6-5272eb5553a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"member", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", "member"}], "]"}], ",", " ", 
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Delete", "[", 
          RowBox[{"member", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Reverse", " ", "@", " ", "member"}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1bf7e3b3-fa94-445c-a5b8-3bfd9955a327"],

Cell[BoxData[
 RowBox[{"{", 
