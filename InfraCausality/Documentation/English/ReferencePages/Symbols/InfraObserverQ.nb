Cell[CellGroupData[{
Cell["InfraObserverQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"927311bb-23e3-4d43-9076-5d29f0a85bbd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserverQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bd41f81-686b-4ef5-b12e-1e3e55efec29"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01c63cb4-1cc9-47b6-94d4-d47a360a1a8d"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 ", each pair of consecutive events an edge of the Hasse diagram.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"58e279a8-6300-4f50-9ae3-634c76c9779c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserverQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1d6621a-62a4-42e8-a6f6-dc2f43ef5768"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"6a88d2d2-6746-4670-9db1-029fd58c23c5"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is an observer when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and each consecutive pair is a covering pair: ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "460b86c0-2b23-4ae1-b198-a56dd75e1c3f"],
 " \[Precedes] ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "10b328dc-13f9-4cf3-9699-eb3b2ac3989f"],
 " with no event strictly between them, so that the diamond [",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "7498d48f-465b-4527-a89d-3c30d8a25f6b"],
 ", ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "8cbbb83f-9a89-4bcf-8597-eee135f214c5"],
 "] has exactly two events. The covering pairs are the edges of the Hasse \
diagram, ",
 Cell[BoxData["TransitiveReductionGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70a37131-5727-4c1b-8dce-8f60595a191d"],
 "[",
 StyleBox["g", "TI"],
 "]; on a transitively reduced graph, such as every ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f5fcc96c-c02f-4527-9a37-71864efbb294"],
 ", they are the edges of ",
 StyleBox["g", "TI"],
 " itself."
}], "Notes",ExpressionUUID->"f62d93b3-7aed-4633-a54d-ff8006904293"],

Cell[TextData[{
 "An observer is a clock: it ticks at every event it passes and skips none it \
could have passed. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserverQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93cae8dd-fe84-41c6-9db2-cddf3240be87"],
 " is ",
 Cell[BoxData[
  RowBox[{"InfraMemberQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraObserver", "[", 
     RowBox[{
      RowBox[{
       ButtonBox["First",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}], ",", " ", 
      RowBox[{
       ButtonBox["Last",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}]}], "]"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74dd6202-25c8-4b32-b2af-6748bc24c1f6"],
 ". A single event is an observer; the empty list is not."
}], "Notes",ExpressionUUID->"633eed8a-73e1-48d6-84b1-a65223bce65a"],

Cell[TextData[{
 "The predicate takes a chain, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserverQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraObserver", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ec46269-8469-477c-971c-561b45e4e4cc"],
 " stays unevaluated. A list of chains, the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraObserver"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraObserver", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70fc8d18-3ce3-40b1-b0e7-715829605580"],
 " returns with a count, can be passed straight in."
}], "Notes",ExpressionUUID->"72ae54ed-2bcf-4813-82d1-1b6d5de6f95a"],

Cell["\<\
The chain predicates form a hierarchy, each condition stronger than the next:\
\
\>", "Notes",ExpressionUUID->"59c3a3b2-955d-4fe8-86a7-4a3f66048008"],

