Cell["\<\
On a substrate the covering pairs are the edges, so a list is an observer \
exactly when it is a directed path of the graph. Checked on every path \
between two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"4a6597aa-7109-4a68-a7e3-f65765e50b23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"chains", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalDiamond", "[", 
             RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraChainQ", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"chains", ",", " ", 
        RowBox[{"chain", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraObserverQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"chain", ",", " ", "2", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"EdgeQ", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"DirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
             "&"}]}], "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"48b0aa34-3d54-4281-b4aa-05d571676a53"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3a578fe9-937e-4eb8-8224-626895ebaa0c"]
}, Open  ]],

Cell["\<\
The predicate is membership in the observer family of the endpoints.\
\>", "ExampleText",ExpressionUUID->"1a20e7de-4fb7-4fe3-b709-4535430fd460"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"chains", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalDiamond", "[", 
             RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraChainQ", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "p"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}]}], " ", 
           "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"chains", ",", " ", 
        RowBox[{"chain", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraObserverQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraObserver", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "chain"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"953a5ad4-f23b-4079-bbfb-fc2ef9e3244a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6934c08c-8caf-4526-a386-daa97e9ddd77"]
}, Open  ]],

Cell["\<\
Every worldline is an observer, and every observer is a chain.\
\>", "ExampleText",ExpressionUUID->"a455f62d-a948-4dc3-96a0-80883a37c81b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}], " ", "&&", " ", 
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"660c7d19-2fc9-4fab-90ab-e97cdcdbe2e8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e3ee0b56-0e95-45ee-980e-3079e943ceb3"]
}, Open  ]]
}, Open  ]],

