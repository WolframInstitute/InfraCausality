Cell[TextData[{
 "The point is at distance ",
 StyleBox["s", "TI"],
 " from the origin, and its radar interval is its proper time."
}], "ExampleText",ExpressionUUID->"4c049988-578c-4063-a5b7-996be614400f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"WorldlinePoint", "[", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", " ", "s", ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Norm", "[", "p", "]"}], " ", "==", " ", "s"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
         " ", 
         RowBox[{
          RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], 
        "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"ProperTimeScale", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], " ", "s"}]}]}]}], "]"}], ",", 
   " ", 
   RowBox[{"s", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"438a4b4b-8503-4217-a9e2-b559af03e2ce"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cdeef9c0-2fc9-40ce-a329-1f2b8991350a"]
}, Open  ]],

