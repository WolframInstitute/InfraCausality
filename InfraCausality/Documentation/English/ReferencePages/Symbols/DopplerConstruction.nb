Cell["DopplerConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a63c8db-8b16-4061-8826-1aba2745578a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a02a4300-aedc-45fc-8b6e-749ffd3c3b25"],
 "\[LineSeparator]",
 "draws ",
 StyleBox["n", "TI"],
 " evenly spaced light pulses from the rest worldline to the worldline of \
velocity ",
 StyleBox["v", "TI"],
 ", showing the Bondi factor as a ratio of pulse spacings.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"40d91927-9ace-4dc8-abc8-8629b0a0576f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee407fba-5200-4bf2-95bf-9a71cf1a479a"],
 "\[LineSeparator]",
 "draws 6 pulses."
}], "Usage",ExpressionUUID->"74311b12-1cee-4505-ba1a-d83defbd9b20"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"bccc8204-9645-48d0-9c82-31af79c47196"],

Cell[TextData[{
 "Definition: the rest observer (\"Alice\", blue) emits ",
 StyleBox["n", "TI"],
 " pulses at the arc lengths ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], "+", "\[CapitalDelta]"}], ",", 
   "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e5b722c-f99a-428a-85e5-f24b08039b09"],
 ", equally spaced in her proper time; each pulse runs to the right at the \
light angle and is received by the observer of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) at arc length ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9abda059-1541-4c0b-8e73-241dc135d2a1"],
 " times its emission. The received pulses are equally spaced too, and in \
Bob's proper time (arc length times ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2c57451-cb62-4b34-bb02-07050540cb03"],
 ") their spacing is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8851b99-8156-4772-af29-d6882258850a"],
 ": the k-factor is the ratio of received to emitted period, the relativistic \
Doppler factor. The first spacing is marked on both worldlines, \"\
\[CapitalDelta]\[Tau]\" and \"k \[CapitalDelta]\[Tau]\"."
}], "Notes",ExpressionUUID->"1faba7b3-6724-4f84-8894-06912063eb40"],

