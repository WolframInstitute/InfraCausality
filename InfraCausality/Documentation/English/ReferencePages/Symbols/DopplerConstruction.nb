Cell[TextData[{
 "The receptions lie on the moving worldline, and their spacing in proper \
time is ",
 StyleBox["k", "TI"],
 " times the emission spacing."
}], "ExampleText",ExpressionUUID->"5e97319b-e094-444b-8dbb-75fe86b054c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"disks", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"DopplerConstruction", "[", 
            RowBox[{"v", ",", " ", "6", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
            " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"alice", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"disks", ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"bob", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"disks", ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bob", "]"}], " ", "==", " ", "6"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bob", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", "6"}], 
              "]"}]}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Differences", "[", 
             RowBox[{
              RowBox[{"ProperTimeScale", "[", 
               RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
              RowBox[{"Map", "[", 
               RowBox[{"Norm", ",", " ", "bob"}], "]"}]}], "]"}], " ", "-", 
            " ", 
            RowBox[{
             RowBox[{"KFactor", "[", "v", "]"}], " ", 
             RowBox[{"Differences", "[", 
              RowBox[{"alice", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
           "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"86663fb3-ed41-4064-a95a-b5511b22dccd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"97a08a5e-9f7d-4435-9a51-69d0160e317a"]
}, Open  ]],

