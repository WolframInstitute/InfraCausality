Cell["DopplerConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da7aab2b-1e3a-4772-aba7-ef7c5f60e109"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61a6fc35-8a73-4e7a-aa9a-0830cecffcf9"],
 "\[LineSeparator]",
 "draws ",
 StyleBox["n", "TI"],
 " evenly spaced light pulses from the rest worldline to the worldline of \
velocity ",
 StyleBox["v", "TI"],
 ", showing the Bondi factor as a ratio of pulse spacings.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a7e80bcc-4ddf-445e-85c2-031d6877cd42"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0aac7b-e910-4512-9b1a-a3c31fc23350"],
 "\[LineSeparator]",
 "draws 6 pulses."
}], "Usage",ExpressionUUID->"60320a3a-04a4-4eb1-a54b-c21a96966f45"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"ddc61766-5d2e-409a-9e7f-bbcdaf11f6a6"],

Cell[TextData[{
 "Definition: the rest observer (\"Alice\", blue) emits ",
 StyleBox["n", "TI"],
 " pulses at the arc lengths ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], "+", "\[CapitalDelta]"}], ",", 
   "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd0b8cec-d814-4ea0-988e-e28075cd99ef"],
 ", equally spaced in her proper time; each pulse runs to the right at the \
light angle and is received by the observer of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) at arc length ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8014ee9-3a3e-47c5-967e-fee1e82bcb3f"],
 " times its emission. The received pulses are equally spaced too, and in \
Bob's proper time (arc length times ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "158ba16e-da37-4651-b6d1-9e99bc9ca2cd"],
 ") their spacing is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea1caccb-fdb2-4207-8280-40b25ee36c93"],
 ": the k-factor is the ratio of received to emitted period, the relativistic \
Doppler factor. The first spacing is marked on both worldlines, \"\
\[CapitalDelta]\[Tau]\" and \"k \[CapitalDelta]\[Tau]\"."
}], "Notes",ExpressionUUID->"15769e0f-6974-43d3-bbc1-081346784be7"],

