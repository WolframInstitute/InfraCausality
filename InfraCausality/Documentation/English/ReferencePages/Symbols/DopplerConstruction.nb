Cell[TextData[{
 "The receptions lie on the moving worldline, and their spacing in proper \
time is ",
 StyleBox["k", "TI"],
 " times the emission spacing."
}], "ExampleText",ExpressionUUID->"3b91a6f2-5de9-406e-b722-553a045bca77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"disks", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"DopplerConstruction", "[", 
            RowBox[{"v", ",", " ", "6", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
            " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"alice", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"disks", ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"bob", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"disks", ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bob", "]"}], " ", "==", " ", "6"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bob", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", "6"}], 
              "]"}]}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Differences", "[", 
             RowBox[{
              RowBox[{"ProperTimeScale", "[", 
               RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
              RowBox[{"Map", "[", 
               RowBox[{"Norm", ",", " ", "bob"}], "]"}]}], "]"}], " ", "-", 
            " ", 
            RowBox[{
             RowBox[{"KFactor", "[", "v", "]"}], " ", 
             RowBox[{"Differences", "[", 
              RowBox[{"alice", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
           "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"33b18558-0683-42f0-a65a-4cf1da95e08f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eb21fec8-9854-476a-9d2e-4666ed9d1d19"]
}, Open  ]],

