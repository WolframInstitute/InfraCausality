Cell["DopplerConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"096d2b04-cd5a-439a-a05e-550d3d52d0df"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a35c31ed-ad58-44d0-aebf-69ecf7544fcd"],
 "\[LineSeparator]",
 "draws ",
 StyleBox["n", "TI"],
 " evenly spaced light pulses from the rest worldline to the worldline of \
velocity ",
 StyleBox["v", "TI"],
 ", showing the Bondi factor as a ratio of pulse spacings.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b4602a3a-4ce7-4e07-9941-f3ffcca4ede5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DopplerConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94512c2c-3223-480d-b142-4a314f8f94e5"],
 "\[LineSeparator]",
 "draws 6 pulses."
}], "Usage",ExpressionUUID->"f225e3a3-9c04-4f86-9d2d-5e8ec185a8ca"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"f1de6f43-9a6d-4685-834e-2c585b244d52"],

Cell[TextData[{
 "Definition: the rest observer (\"Alice\", blue) emits ",
 StyleBox["n", "TI"],
 " pulses at the arc lengths ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], "+", "\[CapitalDelta]"}], ",", 
   "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c469d102-b4ff-491e-b099-1febd2b51e96"],
 ", equally spaced in her proper time; each pulse runs to the right at the \
light angle and is received by the observer of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) at arc length ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47f4e4ee-d9e6-44b8-a9ce-f0dd15a489c9"],
 " times its emission. The received pulses are equally spaced too, and in \
Bob's proper time (arc length times ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6a8c723-e6a0-42c0-982f-3c90ba42ed94"],
 ") their spacing is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0f96702-e9c2-4304-97c2-e52309bf9ea6"],
 ": the k-factor is the ratio of received to emitted period, the relativistic \
Doppler factor. The first spacing is marked on both worldlines, \"\
\[CapitalDelta]\[Tau]\" and \"k \[CapitalDelta]\[Tau]\"."
}], "Notes",ExpressionUUID->"3179a194-7aa2-43b2-a55a-9c5c84fb7b70"],

