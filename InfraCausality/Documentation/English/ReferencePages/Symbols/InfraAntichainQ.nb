Cell["\<\
An antichain need not lie in one slice: two events of the sprinkling at \
heights 1 and 3 that no signal joins, drawn with their causal futures, \
neither of which contains the other event.\
\>", "ExampleText",ExpressionUUID->"6ca0d6d4-fe9a-4ec7-b1b3-0ff8ef333fef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Tuples", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "1", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "3", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{"InfraAntichainQ", "[", 
            RowBox[{"g", ",", " ", "p"}], "]"}]}]}], "]"}]}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Labeled", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraCausalFuture", "[", 
           RowBox[{"First", " ", "@", " ", "pair"}], "]"}], " ", "->", " ", 
          "Red"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraCausalFuture", "[", 
           RowBox[{"Last", " ", "@", " ", "pair"}], "]"}], " ", "->", " ", 
          "StandardBlue"}], ",", " ", 
         RowBox[{"pair", " ", "->", " ", "StandardMagenta"}]}], "}"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"InfraAntichainQ", "[", 
      RowBox[{"g", ",", " ", "pair"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"af2dc9f0-4d9c-4916-b237-d07818ea03b7"],

