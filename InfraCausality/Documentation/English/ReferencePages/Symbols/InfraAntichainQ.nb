Cell["\<\
On each substrate: the slice at height 3, a two-event chain, and the empty \
list.\
\>", "ExampleText",ExpressionUUID->"c6088096-b9e9-49eb-b195-cca2ee010704"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraAntichainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "3", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"InfraAntichainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"List", " ", "@@", " ", "e"}]}], "]"}], ",", " ", 
       RowBox[{"InfraAntichainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"02ab81c7-e1cc-49c3-b6b9-f290b9d6cc0c"],

Cell[BoxData[
 RowBox[{"{", 
