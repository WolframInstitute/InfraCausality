Cell["\<\
The predicate is pairwise incomparability, checked on every set of at most \
three events of the sprinkling.\
\>", "ExampleText",ExpressionUUID->"75fed0e3-9840-43fc-b7f5-18546f5c6061"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"comparableQ", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "v"}], "}"}], " ", "|->", " ", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"VertexOutComponent", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "u", "}"}]}], "]"}], ",", " ", "v"}], "]"}], " ", "||",
        " ", 
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"VertexOutComponent", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "v", "}"}]}], "]"}], ",", " ", "u"}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"set", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraAntichainQ", "[", 
        RowBox[{"g", ",", " ", "set"}], "]"}], " ", "===", " ", 
       RowBox[{"NoneTrue", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"Apply", "[", "comparableQ", "]"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fbdafd3f-6023-47c5-8795-12dbc2c226da"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a07d0af4-536e-4bbb-bc02-690ab84a53bb"]
}, Open  ]],

Cell["\<\
Every slice of the height foliation is an antichain, every edge is not, and a \
subset of an antichain is an antichain.\
\>", "ExampleText",ExpressionUUID->"a7a88177-9f9a-4507-a115-ec1f9c280de1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalHeightFoliation", "[", "g", "]"}], ",", " ", 
         RowBox[{"s", " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraAntichainQ", "[", 
            RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Subsets", "[", 
              RowBox[{"s", ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"sub", " ", "|->", " ", 
              RowBox[{"InfraAntichainQ", "[", 
               RowBox[{"g", ",", " ", "sub"}], "]"}]}]}], "]"}]}]}]}], "]"}], 
       " ", "&&", "\n", "      ", 
       RowBox[{"NoneTrue", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"InfraAntichainQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"List", " ", "@@", " ", "e"}]}], "]"}]}]}], "]"}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"504d4377-a112-4853-8e79-62762c3c928b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"368dd9a9-53f2-4bb7-9913-a48518475a7d"]
}, Open  ]],

Cell["A chain and an antichain share at most one event.", "ExampleText",ExpressionUUID->"515c9b1c-12bf-4bdb-a39b-c1fdf4f20296"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"CausalHeightFoliation", "[", "g", "]"}], ",", " ", 
        RowBox[{"s", " ", "|->", " ", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Intersection", "[", 
            RowBox[{"a", ",", " ", "s"}], "]"}], "]"}], " ", "<=", " ", 
          "1"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"29acfb7a-1412-4513-865f-7a07b2b7de6f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"5dc7c965-1c4b-4c0e-aaca-fe2e816486b5"]
}, Open  ]],

Cell["\<\
The widest slice is at most the width of the order, the number of events \
minus a maximum matching of the comparability relation. On the two lattices \
the widest slice attains it.\
\>", "ExampleText",ExpressionUUID->"93c129a2-6cb6-4c52-b4ba-40ef0a3e6636"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"width", " ", "=", " ", 
        RowBox[{
         RowBox[{"VertexCount", "[", "g", "]"}], " ", "-", " ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindIndependentEdgeSet", " ", "@", " ", 
           RowBox[{"Graph", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"UndirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", 
                  RowBox[{"First", " ", "@", " ", "#"}]}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"2", ",", " ", 
                  RowBox[{"Last", " ", "@", " ", "#"}]}], "}"}]}], "]"}], " ",
               "&"}], " ", "/@", " ", 
             RowBox[{"EdgeList", " ", "@", " ", 
              RowBox[{"TransitiveClosureGraph", "[", "g", "]"}]}]}], 
            "]"}]}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"widest", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Length", " ", "/@", " ", 
          RowBox[{"CausalHeightFoliation", "[", "g", "]"}]}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{"widest", " ", "<=", " ", "width"}], " ", "&&", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"name", " ", "===", " ", "\"\<MinkowskiSprinkling2D\>\""}], 
         " ", "||", " ", 
         RowBox[{"widest", " ", "==", " ", "width"}]}], ")"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"7e8431b8-b498-4983-86cd-b0871fd823bc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0135e2c9-a9c5-46f2-8d4f-a72b5b0f7f86"]
}, Open  ]]
}, Open  ]],

