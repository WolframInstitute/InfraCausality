Cell["\<\
A list of chains is tested chain by chain, and a single event is a worldline.\
\
\>", "ExampleText",ExpressionUUID->"f3f679f8-af02-4cc2-b191-c17269ebc4dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraWorldlineQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "5"}], "]"}]}], 
        ")"}]}], "]"}], ",", " ", 
     RowBox[{"InfraWorldlineQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e94d6d3b-699f-4890-874b-122b3184abe3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"48057237-52c7-4f64-b1b8-40ed2a4759f1"]
}, Open  ]]
}, Open  ]],

