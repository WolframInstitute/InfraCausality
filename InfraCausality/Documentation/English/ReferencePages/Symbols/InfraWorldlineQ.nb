   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "True"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"76f4d888-e046-4b05-8db3-711cb337058e"]
}, Open  ]],

Cell["\<\
On the sprinkling the observers between two events have clocks of different \
lengths. The shortest one is saturated but is not a worldline; the longest \
one is.\
\>", "ExampleText",ExpressionUUID->"ecb89a1e-7835-4b19-9d96-d33e275e490c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
