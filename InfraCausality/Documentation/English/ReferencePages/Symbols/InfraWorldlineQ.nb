Cell[CellGroupData[{
Cell["InfraWorldlineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"adecb929-ea17-425a-8fca-014738d73a7d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7750c95e-8166-4950-bfc0-6d560e86a95d"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa423568-0c24-47db-a70d-c67ffce20e2d"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 ", each pair of consecutive events an edge of the Hasse diagram.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1cc8322f-0e86-4c02-9179-4d9a9b4d11c9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e89bcc55-2bb8-4966-b235-5daf834d7937"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"17aceacd-6223-4130-989b-d18e29c6a3dc"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a worldline when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and each consecutive pair is a covering pair: ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "b2c6961e-0b0c-4345-855a-90d32de540dc"],
 " \[Precedes] ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "0a71e62f-7679-464a-ae7d-73d35bb0cf50"],
 " with no event strictly between them, so that the diamond [",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "b7b3e8b7-ed26-4367-a9c2-cb03145aa047"],
 ", ",
 StyleBox["e", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "b6a271a8-e20e-4060-bd2b-cb4d50b35b53"],
 "] has exactly two events. The covering pairs are the edges of the Hasse \
diagram, ",
 Cell[BoxData["TransitiveReductionGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775bf7c0-5597-4261-955e-47334b945535"],
 "[",
 StyleBox["g", "TI"],
 "]; on a transitively reduced graph, such as every ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b1963eeb-3673-4810-910a-3fc6c52e6bbd"],
 ", they are the edges of ",
 StyleBox["g", "TI"],
 " itself."
}], "Notes",ExpressionUUID->"c57b06e7-45ab-4f18-bd6a-ac413780715f"],

Cell[TextData[{
 "A worldline passes every event it could have passed; read as an observer, \
it is a clock that ticks at each of them. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b60016e-eb0c-4b44-8bcc-0ede7a72d468"],
 " is ",
 Cell[BoxData[
  RowBox[{"InfraMemberQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraWorldline", "[", 
     RowBox[{
      RowBox[{
       ButtonBox["First",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}], ",", " ", 
      RowBox[{
       ButtonBox["Last",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}]}], "]"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85bb92e9-10f1-4b57-a2d5-418175b421bc"],
 ". A single event is a worldline; the empty list is not."
}], "Notes",ExpressionUUID->"aa5bd5f6-833f-46b0-a501-9eb5b5879428"],

Cell[TextData[{
 "The predicate takes a chain, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraWorldline", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dbb7c52-42f2-40f2-9c0e-5b9e21a0e7e9"],
 " stays unevaluated. A list of chains, the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d36d6638-f54d-4537-ba4d-97c8fc71bec3"],
 " returns with a count, can be passed straight in."
}], "Notes",ExpressionUUID->"7ae1b6f9-65a0-45e3-a6a5-d90c5219b0c3"],

Cell["\<\
The chain predicates form a hierarchy, each condition stronger than the next:\
\
\>", "Notes",ExpressionUUID->"b72f27fb-c754-4085-8924-9e0a8a3844e7"],

