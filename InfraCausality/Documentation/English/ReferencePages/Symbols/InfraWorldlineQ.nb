Cell[CellGroupData[{
Cell["InfraWorldlineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a74b020e-0e77-4548-98af-a38f6554690e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b211d8-acce-4b99-a55d-c0a808fa6382"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9f35f57-bfd6-427b-8f0d-d5fa146db053"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a longest chain of ",
 StyleBox["g", "TI"],
 " between its first and its last event.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"51a1430c-e8d7-4792-81f6-3ebd7a8d7a7a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e95bf86-878e-44f3-bed5-3b693034f722"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"09041c43-3c2a-4b15-b2f6-b25ac493b2e3"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a worldline when it is a saturated chain of ",
 StyleBox["g", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5269c7f3-6646-4b06-a754-8559bff97f05"],
 " tests, and its number of edges ",
 StyleBox["k", "TI"],
 " equals the proper time \[Tau](",
 StyleBox["e", "TI"],
 "0, ",
 StyleBox["ek", "TI"],
 "), the number of edges of a longest chain from ",
 StyleBox["e", "TI"],
 "0 to ",
 StyleBox["ek", "TI"],
 ". No chain between the same two events is longer."
}], "Notes",ExpressionUUID->"f2f2f582-d605-4aab-97fb-194e1431a617"],

Cell[TextData[{
 "The saturation condition is implied by the length: a chain that skipped an \
event between two of its consecutive events could be lengthened by inserting \
it. So a worldline is any chain, in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraChainQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraChainQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ad73a33-5854-4d41-b527-f1358af12ec7"],
 ", of maximal length between its endpoints, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b418bf5-9b06-49d1-b6f1-16c2e29543be"],
 " is ",
 Cell[BoxData[
  RowBox[{"InfraMemberQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraWorldline", "[", 
     RowBox[{
      RowBox[{
       ButtonBox["First",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}], ",", " ", 
      RowBox[{
       ButtonBox["Last",
        BaseStyle->"Link"], "[", 
       StyleBox["c", "TI"], "]"}]}], "]"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d60a2d9-f4d3-457a-82f6-453acbb17fc9"],
 ". A single event is a worldline, the only member of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1d3a9b5-e919-4653-bb09-f31d94bf1e03"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "]; the empty list is not."
}], "Notes",ExpressionUUID->"4252a8aa-9331-4847-b252-ae264481cbe5"],

Cell[TextData[{
 "The predicate takes a chain, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldlineQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraWorldline", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8fcfb6a-ed3d-4f0b-9363-79771a5da536"],
 " stays unevaluated. A list of chains is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2ad6438-a39b-4c09-b08e-c4b9c14c9b5c"],
 " returns with a count, so it can be passed straight in. A member of a \
polyline worldline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b597014-83fd-45b9-9524-f8b9d9f17f8d"],
 " passes only when it happens to be as long as a worldline from ",
 StyleBox["p", "TI"],
 "1 to ",
 StyleBox["pk", "TI"],
 "; ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb6df534-2391-416b-a840-e8decac57b93"],
 " on the polyline head recognises its members."
}], "Notes",ExpressionUUID->"804f96bb-e002-4503-a266-b8fd54ae5e8b"],

Cell["\<\
The chain predicates form a hierarchy, each condition stronger than the next:\
\
\>", "Notes",ExpressionUUID->"71cfd3ab-9339-43af-9d26-d6fa5cd3b016"],

