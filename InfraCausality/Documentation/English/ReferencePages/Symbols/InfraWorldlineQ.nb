Cell["\<\
On a substrate the covering pairs are the edges, so a list is a worldline \
exactly when it is a directed path of the graph. Checked on every path \
between two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"6765bcf9-706b-4026-a37e-f66049d16133"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"chains", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalDiamond", "[", 
                RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraChainQ", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"chains", ",", " ", 
        RowBox[{"chain", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraWorldlineQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"chain", ",", " ", "2", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"EdgeQ", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"DirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
             "&"}]}], "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2825ba1b-1e6d-4f02-8d51-372b9953dc23"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c69a7a96-c7e4-484b-8f9b-918e7300e442"]
}, Open  ]],

Cell["\<\
The predicate is membership in the worldline family of the endpoints.\
\>", "ExampleText",ExpressionUUID->"0dc6b115-ef3c-412a-87a2-8ab79639a09d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"chains", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalDiamond", "[", 
                RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraChainQ", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "p"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}]}], " ", 
           "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"chains", ",", " ", 
        RowBox[{"chain", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraWorldlineQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "chain"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3a0d4549-9199-4f76-8749-0018eabac4aa"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0fffe752-8a2d-446e-a3c3-2ad323b9a8f9"]
}, Open  ]],

Cell["\<\
Every timelike geodesic is a worldline, and every worldline is a chain.\
\>", "ExampleText",ExpressionUUID->"ed9aec88-6e1d-4ec9-b2b9-76102e5f6828"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}], " ", "&&", " ", 
       RowBox[{"InfraChainQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e8751c5e-ee84-4518-a4ad-f0758afdd83a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7f10fb40-5504-4497-aee1-412735b02261"]
}, Open  ]]
}, Open  ]],

