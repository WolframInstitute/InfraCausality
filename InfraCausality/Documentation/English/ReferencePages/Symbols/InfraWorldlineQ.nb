Cell["\<\
The predicate is membership in the worldline family of the endpoints. Checked \
on every observer between two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"a0c330b8-fe57-4cd8-83c6-0fad5b2614eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraObserver", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraObserver", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",",
         " ", 
        RowBox[{"chain", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraWorldlineQ", "[", 
           RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "chain"}], "]"}], 
          " ", "===", "\n", "        ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "chain", "]"}], " ", "-", " ", "1"}], " ",
             "==", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraWorldline", "[", 
               RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
              " ", "\"\<Length\>\""}], "]"}]}], ")"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa7d3855-3e43-4858-8892-0b8f65e21261"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8c6e5a1-594d-44e2-b6d1-aad0eed93a8a"]
}, Open  ]],

Cell["\<\
The hierarchy: every light ray is a worldline, every worldline an observer, \
every observer a chain. Checked on every path of the graph between two events \
of each substrate.\
\>", "ExampleText",ExpressionUUID->"c09e61a3-9056-4662-85cc-46c2791ef00c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"FindPath", "[", 
         RowBox[{
         "g", ",", " ", "p", ",", " ", "q", ",", " ", "Infinity", ",", " ", 
          "All"}], "]"}], ",", " ", 
        RowBox[{"chain", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"Implies", "[", 
           RowBox[{
            RowBox[{"InfraLightRayQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}], ",", " ", 
            RowBox[{"InfraWorldlineQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}]}], "]"}], " ", "&&", " ", 
          RowBox[{"Implies", "[", 
           RowBox[{
            RowBox[{"InfraWorldlineQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}], ",", " ", 
            RowBox[{"InfraObserverQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}]}], "]"}], " ", "&&", 
          "\n", "        ", 
          RowBox[{"Implies", "[", 
           RowBox[{
            RowBox[{"InfraObserverQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}], ",", " ", 
            RowBox[{"InfraChainQ", "[", 
             RowBox[{"g", ",", " ", "chain"}], "]"}]}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fffcaaf0-c1fd-4dca-9cf7-399254594235"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a76caa92-b017-439b-8cd2-5996c56899dc"]
}, Open  ]],

Cell["\<\
On the two lattices every observer is a worldline; on the sprinkling there \
are observers that are not.\
\>", "ExampleText",ExpressionUUID->"b1920ce2-2ffc-46b7-9fe2-331a1c6a0c41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"counts", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"CausalSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
         "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"p", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
             RowBox[{"RandomChoice", " ", "@", " ", 
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
             RowBox[{"RandomChoice", " ", "@", " ", 
              RowBox[{"Intersection", "[", 
               RowBox[{
                RowBox[{"RandomInfraCausalFuture", "[", 
                 RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
                RowBox[{"RandomInfraSlice", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}],
             ")"}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraObserver", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",",
            " ", 
           RowBox[{"chain_", " ", "/;", " ", 
            RowBox[{"!", " ", 
             RowBox[{"InfraWorldlineQ", "[", 
              RowBox[{"g", ",", " ", "chain"}], "]"}]}]}]}], "]"}]}], "]"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
           " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
           " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"First", "[", "counts", "]"}], " ", "==", " ", 
    RowBox[{"Last", "[", "counts", "]"}], " ", "==", " ", "0", " ", "<", " ", 
    
    RowBox[{"counts", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"211b15e7-d632-449c-b612-649aece98d4e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"93acacda-0b32-499f-9289-0c95954a0101"]
}, Open  ]]
}, Open  ]],

