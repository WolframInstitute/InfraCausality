Cell["\<\
On each substrate: a worldline passes, the same worldline with an inner event \
removed fails, and so does the worldline read backwards.\
\>", "ExampleText",ExpressionUUID->"92a40afd-23cd-42e3-8ef0-8c2d8f7d09f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{
             RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
             RowBox[{"InfraSlice", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", " ",
                "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"member", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", "member"}], "]"}], ",", " ", 
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Delete", "[", 
          RowBox[{"member", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Reverse", " ", "@", " ", "member"}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8f87496c-25d7-4670-b2b8-d47588851939"],

