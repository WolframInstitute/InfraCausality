Cell["\<\
The universal time increases along every edge and vanishes exactly on the \
sources.\
\>", "ExampleText",ExpressionUUID->"edfbbb55-dcae-4920-a6b8-223f57901cf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"UniversalTime", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"First", " ", "@", " ", "e"}], "]"}], " ", "<", " ", 
           RowBox[{"t", "[", 
            RowBox[{"Last", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}], " ", "&&",
        "\n", "      ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"t", ",", " ", 
            RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"VertexInDegree", "[", "g", "]"}], ",", " ", "0"}], 
          "]"}]}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6781ec41-ba08-4f22-94fe-ad338405f0c4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"02375e0e-0033-492c-bd3c-d08cf02f8d8a"]
}, Open  ]],

Cell["\<\
It is the length of a longest chain from a source, by brute force over all \
paths.\
\>", "ExampleText",ExpressionUUID->"8e505ec9-37c4-4270-87d2-2fe93fc2a3e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"UniversalTime", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"sources", " ", "=", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"VertexInDegree", "[", "g", "]"}], ",", " ", "0"}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"t", "[", "v", "]"}], " ", "==", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{
             RowBox[{"Length", " ", "/@", " ", 
              RowBox[{"Catenate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"FindPath", "[", 
                  RowBox[{
                  "g", ",", " ", "#", ",", " ", "v", ",", " ", "Infinity", ",",
                    " ", "All"}], "]"}], " ", "&"}], " ", "/@", " ", 
                "sources"}], "]"}]}], " ", "-", " ", "1"}]}], "]"}]}]}]}], 
       "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4f31a4ff-3e6f-41d7-9e1e-5746047ef9a6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"15909bfb-d3fa-4461-9adf-c5f785d60a35"]
}, Open  ]],

Cell["\<\
Every event off the sources has a direct predecessor exactly one slice below \
it.\
\>", "ExampleText",ExpressionUUID->"282c324a-5c4e-412c-b0b3-70f75c3da766"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"UniversalTime", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"v", " ", "|->", " ", 
           RowBox[{
            RowBox[{"t", "[", "v", "]"}], " ", ">", " ", "0"}]}]}], "]"}], ",",
         " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{
          RowBox[{"t", "[", "v", "]"}], " ", "==", " ", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"t", " ", "/@", " ", 
             RowBox[{"VertexInComponent", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"{", "v", "}"}], ",", " ", 
               RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d8912746-c361-4666-a449-eefd23ea65fe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9338ce5e-b881-4ce8-9619-820c56fdd977"]
}, Open  ]],

Cell[TextData[{
 "With the universal time of the reversed graph, the depth below the sinks, \
the sum is at most the length ",
 StyleBox["h", "TI"],
 " of a longest chain, with equality exactly on the events of the longest \
chains. On the two lattices every event lies on one; on the sprinkling some \
do not."
}], "ExampleText",ExpressionUUID->"f18d5858-2784-4263-ba18-7209ef30b917"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sum", " ", "=", " ", 
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"UniversalTime", "[", "g", "]"}], ",", " ", 
             RowBox[{"UniversalTime", "[", 
              RowBox[{"ReverseGraph", "[", "g", "]"}], "]"}]}], "}"}], ",", 
           " ", "Total"}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"UniversalTime", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", "sum", "]"}], " ", "==", " ", "h"}], " ", "&&", 
       " ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"sum", ",", " ", 
            RowBox[{"EqualTo", "[", "h", "]"}]}], "]"}]}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Union", " ", "@@", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}], ",", " ", "All"}], 
          "]"}]}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"910bf6c8-070e-47a0-be8c-160f447e1601"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"cb014ba2-80b4-4406-8448-a32b7738f20e"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the universal time of (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") is ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ", and on the cylinder lattice it is the row."
}], "ExampleText",ExpressionUUID->"9b20cf52-93dc-476e-8efa-7e7ebb32b359"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"cylinder", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"UniversalTime", "[", "diamond", "]"}], " ", "===", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"Total", ",", " ", 
       RowBox[{"VertexList", "[", "diamond", "]"}]}], "]"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"UniversalTime", "[", "cylinder", "]"}], " ", "===", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"Last", ",", " ", 
       RowBox[{"VertexList", "[", "cylinder", "]"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"fafe0541-7ba2-44e4-8435-ab86186162f3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"46c03b73-f2b4-4b33-a36f-d52f059682c4"]
}, Open  ]],

Cell[TextData[{
 "On a worldline from a source the universal time of the ",
 StyleBox["m", "TI"],
 "-th tick is ",
 StyleBox["m", "TI"],
 " \[Minus] 1: the ticks of a geodesic observer from the beginning count \
universal time."
}], "ExampleText",ExpressionUUID->"e7a63e96-75f1-4f96-9c99-fb9a1555741b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"UniversalTime", "[", "g", "]"}], " ", "/@", " ", "a"}], " ", 
       "===", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "a", "]"}], " ", "-", " ", "1"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"a38b8acc-497a-4644-9b44-5168ddd17c66"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"2347ad89-31af-4e63-94e0-53e643e60772"]
}, Open  ]]
}, Open  ]],

