Cell["\<\
On the sprinkling the universal time grows with the coordinate time of the \
event, but not monotonically: an event near the edge of the diamond has a \
short past.\
\>", "ExampleText",ExpressionUUID->"ae8db702-1999-415c-815d-5aab13315d3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "}"}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<coordinate time\>\"", ",", 
        " ", "\"\<universal time\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "StandardBlue"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"804dd42e-85f9-4c7c-b22e-d760009b0ae9"],

