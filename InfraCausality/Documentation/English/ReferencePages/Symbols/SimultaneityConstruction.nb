Cell[CellGroupData[{
Cell["SimultaneityConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"86d789dd-9d90-4560-9ab7-6d33441ec93f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f47f26a2-d89d-4826-af65-5980e57e4a0e"],
 "\[LineSeparator]",
 "draws the simultaneity lines of the rest observer and of the observer of \
velocity ",
 StyleBox["v", "TI"],
 " at a common arc length, illustrating the relativity of simultaneity.",
 "\n"
}], "Usage",ExpressionUUID->"b8aed57e-4d52-4367-8301-4183549374a4"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"85a96623-00ad-4c3d-94cf-b0e9280702ba"],

Cell[TextData[{
 "Definition: on each worldline the figure marks the event at arc length ",
 Cell[BoxData["\"\<ArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "618120bf-3f59-4976-8c00-999779e1f498"],
 " and draws through it the observer's line of simultaneity (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c1e3942-691e-431c-9765-c0861bbb0d42"],
 "), the events whose radar emission and return are equally far before and \
after it on that worldline. For the rest observer (\"Alice's now\") the line \
is horizontal; for the observer of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob's now\") it runs along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d91bd841-f197-4f19-b847-784d59abd6ec"],
 ", the slope ",
 StyleBox["v", "TI"],
 " at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4: the mirror image of the worldline in the light direction. The \
two observers disagree on which events are simultaneous."
}], "Notes",ExpressionUUID->"0739a8be-fd3c-43f2-b537-c0a441749b06"],

