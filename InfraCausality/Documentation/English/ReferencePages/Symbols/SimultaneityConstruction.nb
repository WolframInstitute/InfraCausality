Cell[CellGroupData[{
Cell["SimultaneityConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01a50369-8295-4142-b049-bc1c92d012b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SimultaneityConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/SimultaneityConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "175bd73d-340f-479d-8dac-14be914f6f39"],
 "\[LineSeparator]",
 "draws the simultaneity lines of the rest observer and of the observer of \
velocity ",
 StyleBox["v", "TI"],
 " at a common arc length, illustrating the relativity of simultaneity.",
 "\n"
}], "Usage",ExpressionUUID->"31fae647-cb9c-42bb-9793-8d9b44316d70"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"ea7f2000-41b9-4605-89f8-5111a3c75e8f"],

Cell[TextData[{
 "Definition: on each worldline the figure marks the event at arc length ",
 Cell[BoxData["\"\<ArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f24ab9d7-fd2e-472d-9086-8ff6cfe10c65"],
 " and draws through it the observer's line of simultaneity, the events whose \
radar emission and return are equally far before and after it on that \
worldline. For the rest observer (\"Alice's now\") the line is horizontal; \
for the observer of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob's now\") it runs along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b315f11-80a5-4984-80e6-19b388dd8a6a"],
 ", the slope ",
 StyleBox["v", "TI"],
 " at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4: the mirror image of the worldline in the light direction. The \
two observers disagree on which events are simultaneous."
}], "Notes",ExpressionUUID->"1ac9f816-b4d8-4927-adb6-e93986149016"],

