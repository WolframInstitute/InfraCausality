Cell["\<\
Every point of each drawn line has its radar midpoint on that observer's \
worldline at the marked event: light sent from the worldline to the point and \
returned to it leaves and arrives equally far before and after the event.\
\>", "ExampleText",ExpressionUUID->"e5a41738-f54d-4893-b025-3b7048e4c2b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"SimultaneityConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pts", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_", ",", " ", "_"}], "}"}]}], "]"}], 
            " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"midpoint", " ", "=", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "u"}], "}"}], " ", "|->", " ", 
          RowBox[{"Mean", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"right", " ", "|->", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Through", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
                    RowBox[{"WorldlineAngle", "[", 
                    RowBox[{"u", ",", " ", "phi"}], "]"}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{"right", ",", " ", "1", ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}], " ", 
                    RowBox[{"Sin", "[", "phi", "]"}]}], ",", " ", 
                    RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}], "}"}], "]"}],
                  ",", " ", "p"}], "]"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "lines", "]"}], " ", "==", " ", "2"}], " ", "&&",
         " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"lines", ",", " ", 
