       "\n", "    ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"pts", " ", "|->", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pts", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"pts", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
