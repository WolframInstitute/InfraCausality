Cell["\<\
Every point of each drawn line has its radar midpoint on that observer's \
worldline at the marked event: light sent from the worldline to the point and \
returned to it leaves and arrives equally far before and after the event.\
\>", "ExampleText",ExpressionUUID->"d8c6e9c6-b541-4b02-a874-aebd42c1b15c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"SimultaneityConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pts", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_", ",", " ", "_"}], "}"}]}], "]"}], 
            " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"midpoint", " ", "=", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "u"}], "}"}], " ", "|->", " ", 
          RowBox[{"Mean", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"right", " ", "|->", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"WorldlineDirection", "[", 
                    RowBox[{"u", ",", " ", "phi"}], "]"}], ",", " ", 
                    RowBox[{"LightDirection", "[", 
                    RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}],
                  ",", " ", "p"}], "]"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "lines", "]"}], " ", "==", " ", "2"}], " ", "&&",
         " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "v"}], "}"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"Apply", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"pts", ",", " ", "u"}], "}"}], " ", "|->", "\n", 
            "      ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"pts", ",", " ", 
              RowBox[{"p", " ", "|->", " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"midpoint", "[", 
                   RowBox[{"p", ",", " ", "u"}], "]"}], " ", "-", " ", 
                  "0.7"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"088f2b37-c71c-4921-8249-f7977a48e8e3"],

