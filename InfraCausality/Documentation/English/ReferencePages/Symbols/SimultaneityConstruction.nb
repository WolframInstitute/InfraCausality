   RowBox[{"{", 
    RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
   RowBox[{"v", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lines", " ", "=", " ", 
        RowBox[{"Cases", "[", 
