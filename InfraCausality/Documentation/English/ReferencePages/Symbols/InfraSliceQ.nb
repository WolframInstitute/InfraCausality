Cell["\<\
On each substrate: the slice at height 2, the same slice without its first \
event, and the slice at height 2 joined with an event of height 3.\
\>", "ExampleText",ExpressionUUID->"ceef7e51-5db2-40ff-a3c2-e0f77c46acac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"RandomInfraSlice", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSliceQ", "[", 
        RowBox[{"g", ",", " ", "s"}], "]"}], ",", " ", 
       RowBox[{"InfraSliceQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Rest", "[", "s", "]"}]}], "]"}], ",", " ", 
       RowBox[{"InfraSliceQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"s", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "]"}]}], "]"}]}], 
      "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
