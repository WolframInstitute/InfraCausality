Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["S", "TI"],
 " is a slice when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and ",
 StyleBox["S", "TI"],
 " = {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["s", "TI"],
 ")} for one, hence every, ",
 StyleBox["s", "TI"],
 " in ",
 StyleBox["S", "TI"],
 ", where ",
 StyleBox["t", "TI"],
 " is the universal time. Order does not matter; a repeated event makes the \
list fail."
}], "Notes",ExpressionUUID->"f54623b2-ff1e-4c4c-8a57-5836f631f90c"],

Cell[TextData[{
 "A slice is an antichain, so the predicate implies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntichainQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraAntichainQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b7d858ce-bca9-4802-b73f-052057cec761"],
 ". The converse fails twice over: a part of a slice is an antichain and no \
slice, and an antichain can mix heights. Even a maximal antichain, one no \
event can be added to, need not be a slice: on the diamond lattice {(0, 6), \
(1, 4), (2, 3), (3, 2), (4, 1), (5, 0)} is maximal and its events have \
heights 6 and 5. The slices are the antichains that the universal time \
singles out."
}], "Notes",ExpressionUUID->"413b81ef-10c0-4c1c-bcaf-e64ec25c8d9b"],

Cell[TextData[{
 "The predicate takes a set, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSliceQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraSliceQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSlice", "[", 
     StyleBox["k", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbc83348-810f-437f-b260-8cb8799f9947"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"31bc2c45-3198-419b-b8f3-be030a68a3b8"]
}, Open  ]],

