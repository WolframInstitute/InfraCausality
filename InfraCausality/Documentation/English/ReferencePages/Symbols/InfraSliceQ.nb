Cell["\<\
Every slice passes, the empty list fails, and a set passes exactly when it \
equals the slice through its first event.\
\>", "ExampleText",ExpressionUUID->"860fcc62-d07f-4951-bf17-e2198125ae21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"UniversalTime", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"UniversalFoliation", "[", "g", "]"}], ",", " ", 
         RowBox[{"s", " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraSliceQ", "[", 
            RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
           RowBox[{"InfraSliceQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Reverse", "[", "s", "]"}]}], "]"}]}]}]}], "]"}], " ", "&&",
        " ", 
       RowBox[{"!", " ", 
        RowBox[{"InfraSliceQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "}"}]}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"set", " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraSliceQ", "[", 
            RowBox[{"g", ",", " ", "set"}], "]"}], " ", "===", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sort", "[", "set", "]"}], " ", "===", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"t", "[", 
                RowBox[{"First", " ", "@", " ", "set"}], "]"}]}], "]"}]}], 
            ")"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8795425e-e5c5-4b9d-b7c9-b1faac72e208"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b9256579-6c26-4825-9a4e-c4271032e285"]
}, Open  ]],

Cell["\<\
A slice is an antichain; a proper nonempty part of a slice of more than one \
event is an antichain and no slice.\
\>", "ExampleText",ExpressionUUID->"28128de6-59a5-438e-b2ce-b484d4babb74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"UniversalFoliation", "[", "g", "]"}], ",", " ", 
          RowBox[{"s", " ", "|->", " ", 
           RowBox[{
            RowBox[{"Length", "[", "s", "]"}], " ", ">", " ", "1"}]}]}], 
         "]"}], ",", " ", 
        RowBox[{"s", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraAntichainQ", "[", 
           RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
          RowBox[{"InfraAntichainQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Rest", "[", "s", "]"}]}], "]"}], " ", "&&", " ", 
          RowBox[{"!", " ", 
           RowBox[{"InfraSliceQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Rest", "[", "s", "]"}]}], "]"}]}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7d9fb2a0-f6c0-42ca-a896-a9cc7abd83d1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f3507e88-e311-4240-8b06-fdb12f8ba782"]
}, Open  ]],

Cell["\<\
On the two lattices every slice is a maximal antichain: every event off it is \
comparable with some event of it. The maximal antichain of the diamond \
lattice above is no slice.\
\>", "ExampleText",ExpressionUUID->"9f1d1354-541a-44c3-9775-334076a4b528"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"maximalQ", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "s"}], "}"}], " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraAntichainQ", "[", 
        RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "s"}], "]"}], ",",
          " ", 
         RowBox[{"v", " ", "|->", " ", 
          RowBox[{"!", " ", 
           RowBox[{"InfraAntichainQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Append", "[", 
              RowBox[{"s", ",", " ", "v"}], "]"}]}], "]"}]}]}]}], "]"}]}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"cylinder", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"UniversalFoliation", "[", "diamond", "]"}], ",", " ", 
      RowBox[{"s", " ", "|->", " ", 
       RowBox[{"maximalQ", "[", 
        RowBox[{"diamond", ",", " ", "s"}], "]"}]}]}], "]"}], " ", "&&", " ", 
    
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"UniversalFoliation", "[", "cylinder", "]"}], ",", " ", 
      RowBox[{"s", " ", "|->", " ", 
       RowBox[{"maximalQ", "[", 
        RowBox[{"cylinder", ",", " ", "s"}], "]"}]}]}], "]"}], " ", "&&", 
    "\n", "    ", 
    RowBox[{"maximalQ", "[", 
     RowBox[{"diamond", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}], " ", "&&", 
    " ", 
    RowBox[{"!", " ", 
     RowBox[{"InfraSliceQ", "[", 
      RowBox[{"diamond", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "6"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"dcd38cca-d910-4c6b-b74d-be6a4b448060"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"3dc58c40-de34-4713-9569-4ae236d9e50f"]
}, Open  ]]
}, Open  ]],

