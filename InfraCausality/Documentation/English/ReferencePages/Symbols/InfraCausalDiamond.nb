Cell[CellGroupData[{

Cell["Experimental readings", "ExampleSubsection",ExpressionUUID->"e8413f98-48c2-4715-aefa-85aace15218c"],

Cell[TextData[{
 "The ordering fraction of the full diamond lattice, exact: with ",
 StyleBox["n", "TI"],
 " + 1 events on a side, the related pairs are the comparable pairs of a \
product of two chains, ((",
 StyleBox["n", "TI"],
 " + 1)(",
 StyleBox["n", "TI"],
 " + 2)/2)\.b2 \[Minus] (",
 StyleBox["n", "TI"],
 " + 1)\.b2 of them. It tends to 1/2, the Minkowski value, but slowly."
}], "ExampleText",ExpressionUUID->"58d62be3-0ffd-4851-bed1-df9759556469"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", "\"\<OrderingFraction\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fcbe211b-1297-4086-849f-346781955803"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["5", "6"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     FractionBox["3", "4"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["7", "10"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     FractionBox["2", "3"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     FractionBox["9", "14"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", 
     FractionBox["5", "8"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2e38efee-d507-49d8-9397-7ca57a83532a"]
}, Open  ]],

Cell["\<\
A sprinkling of 300 events into the two-dimensional flat diamond, read as one \
causal set: the ordering fraction is near 1/2, both dimension estimators near \
2, and the action an integer that fluctuates from seed to seed around its \
mean 2.\
\>", "ExampleText",ExpressionUUID->"451c4aa6-b520-4cf3-8809-c23b820a25df"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<OrderingFraction\>\"", ",", 
       " ", "\"\<MyrheimMeyerDimension\>\"", ",", 
       " ", "\"\<MidpointScalingDimension\>\"", ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"177ccb06-77dc-4ffd-ade1-578f4385a446"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
    FractionBox["1729", "3450"]}], ",", 
   RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "1.996911266984622`"}],
    ",", 
   RowBox[{"\<\"MidpointScalingDimension\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Log", "[", 
      FractionBox["300", "73"], "]"}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", 
   RowBox[{"\<\"BenincasaDowkerAction\"\>", "\[Rule]", "336"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2003d774-608a-423e-8371-63dcddf21f2e"]
}, Open  ]],

Cell["\<\
The same in three dimensions: the ordering fraction is near 8/35 and the \
estimators near 3.\
\>", "ExampleText",ExpressionUUID->"bac85344-796f-4e63-9c79-641f9d935254"],

