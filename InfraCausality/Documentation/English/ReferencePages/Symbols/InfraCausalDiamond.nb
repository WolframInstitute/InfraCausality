Cell["\<\
The causal diamond between an event at height 1 and an event of its future \
one slice below the top, on the diamond lattice, a sprinkling into \
two-dimensional Minkowski space and the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"85d91f46-7e22-4931-9d07-fe5909f07702"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a34ababa-de4b-4aeb-a405-9ca84af75416"],

