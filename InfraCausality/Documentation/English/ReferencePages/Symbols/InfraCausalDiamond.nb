Cell[CellGroupData[{

Cell["Experimental readings", "ExampleSubsection",ExpressionUUID->"fd420802-6270-450f-972c-c03dbb4432e3"],

Cell[TextData[{
 "The ordering fraction of the full diamond lattice, exact: with ",
 StyleBox["n", "TI"],
 " + 1 events on a side, the related pairs are the comparable pairs of a \
product of two chains, ((",
 StyleBox["n", "TI"],
 " + 1)(",
 StyleBox["n", "TI"],
 " + 2)/2)\.b2 \[Minus] (",
 StyleBox["n", "TI"],
 " + 1)\.b2 of them. It tends to 1/2, the Minkowski value, but slowly."
}], "ExampleText",ExpressionUUID->"3403fffe-a69c-457e-b446-d3b02649e66e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", "\"\<OrderingFraction\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55f845d9-fe10-4973-adf9-1173b317dcaa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["5", "6"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     FractionBox["3", "4"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["7", "10"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     FractionBox["2", "3"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     FractionBox["9", "14"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", 
     FractionBox["5", "8"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aac6c6c1-3a3c-43fa-9699-17491822a179"]
}, Open  ]],

Cell["\<\
A sprinkling of 300 events into the two-dimensional flat diamond, read as one \
causal set: the ordering fraction is near 1/2, both dimension estimators near \
2, and the action an integer that fluctuates from seed to seed around its \
mean 2.\
\>", "ExampleText",ExpressionUUID->"7368f0e6-96eb-41fd-a517-28c5aa13baca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<OrderingFraction\>\"", ",", 
       " ", "\"\<MyrheimMeyerDimension\>\"", ",", 
       " ", "\"\<MidpointScalingDimension\>\"", ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"941d232e-faa7-4fef-8e04-e7a6202e48a5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
    FractionBox["1729", "3450"]}], ",", 
   RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "1.996911266984622`"}],
    ",", 
   RowBox[{"\<\"MidpointScalingDimension\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Log", "[", 
      FractionBox["300", "73"], "]"}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", 
   RowBox[{"\<\"BenincasaDowkerAction\"\>", "\[Rule]", "336"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"49dd14aa-d5d5-4c27-9229-04d52d1b4c8d"]
}, Open  ]],

Cell["\<\
The same in three dimensions: the ordering fraction is near 8/35 and the \
estimators near 3.\
\>", "ExampleText",ExpressionUUID->"ac360024-773e-4454-abbe-2656b1ca41f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
