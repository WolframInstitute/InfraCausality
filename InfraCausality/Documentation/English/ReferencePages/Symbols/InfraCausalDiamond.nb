Cell["Experimental readings", "ExampleSubsection",ExpressionUUID->"de016f01-d908-4fb3-bf05-033cd661ee44"],

Cell[TextData[{
 "The ordering fraction of the full diamond lattice, exact: with ",
 StyleBox["n", "TI"],
 " + 1 events on a side, the related pairs are the comparable pairs of a \
product of two chains, ((",
 StyleBox["n", "TI"],
 " + 1)(",
 StyleBox["n", "TI"],
 " + 2)/2)\.b2 \[Minus] (",
 StyleBox["n", "TI"],
 " + 1)\.b2 of them. It tends to 1/2, the Minkowski value, but slowly."
}], "ExampleText",ExpressionUUID->"f0ee514c-2fc1-4560-a26e-1ccd70879a34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", "\"\<OrderingFraction\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"95693e02-8b15-457f-b59c-0aa2a9967066"],

