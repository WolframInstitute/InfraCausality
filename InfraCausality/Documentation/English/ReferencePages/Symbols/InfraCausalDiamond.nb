Cell["\<\
The interval volume of the diamonds from the bottom event of the diamond \
lattice to every event of the slice at height 6.\
\>", "ExampleText",ExpressionUUID->"42346497-9669-4e08-a0ca-6cccb9fe6af3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"RandomInfraSlice", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"25bdba00-0e44-46ef-ba91-b2fc5ab6d924"],

