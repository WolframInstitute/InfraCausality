Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", for every pair of events."
}], "ExampleText",ExpressionUUID->"94e1a817-7f4d-4545-a83e-b76631923ee9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalDiamond", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "q", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ef439998-8976-4fd5-85fc-6c6160a7902d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"50e73ea4-4c9c-4c59-9e3d-77b143a57a52"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} \[PrecedesSlantEqual] {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is a rectangle of (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"93223033-273e-42b3-bf83-527222add9e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a5a0baae-c060-4bbc-a512-22ac582f68d6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"03bbd699-ea9a-44de-90bd-d78a77befcd1"]
}, Open  ]],

Cell["\<\
The diamond is convex: an event between two of its events is one of its \
events.\
\>", "ExampleText",ExpressionUUID->"3fb29a7e-6603-4aca-b1c4-c0ff8fc0e253"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalDiamond", "[", 
         RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], " ", "|->", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"diamond", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"u", ",", " ", "w"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"15fda421-27bf-45ce-861e-9f42ce781190"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f0570ab3-6d38-4444-8503-40ec7da0e4a2"]
}, Open  ]],

Cell[TextData[{
 "The causal hull of every timelike geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond of its tips."
}], "ExampleText",ExpressionUUID->"f9e9eea5-cc3a-4df3-90d3-5b57f77b1cdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraTimelikeGeodesic", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTimelikeGeodesic", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"chain", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", "chain", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2a4319a0-c45b-44ee-8c03-fa3ef2356066"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"3824d902-c70b-48a0-8bf6-f39b31105b21"]
}, Open  ]],

Cell["\<\
The discrete curvature is the operator applied to the constant field \
\[Minus]2, and the action is half its total, in both dimensions.\
\>", "ExampleText",ExpressionUUID->"68b0ab11-c2df-41db-966b-3e4345fba6fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"dim", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", 
             " ", "\"\<BenincasaDowkerDAlembertian\>\"", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"ricci", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\"", ",",
              " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], 
            "]"}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Values", "[", "ricci", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"B", " ", ".", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "300"}], "]"}]}]}]}], "]"}]}], " ", "===",
           " ", 
          RowBox[{"{", "0", "}"}]}], " ", "&&", "\n", "        ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{
             "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerAction\>\"", ",",
               " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}], 
            " ", "-", " ", 
            RowBox[{
             RowBox[{"Total", "[", "ricci", "]"}], "/", "2"}]}], "]"}], " ", "===",
           " ", "0"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"55c5f3e1-12bb-41de-822f-4a71916ee2a2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"03c870c4-d532-4c52-bb4a-c1bdc2c56fa4"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer dimension inverts the exact ordering fractions: 1/2 \
gives 2, 8/35 gives 3, 1/10 gives 4.\
\>", "ExampleText",ExpressionUUID->"bd48584f-100d-4ead-8e66-aca3b80b223e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"star", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "3"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"sparse", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"8", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"9", " ", "->", " ", "10"}]}], "}"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"lone", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<OrderingFraction\>\"", ",", 
         " ", "\"\<MyrheimMeyerDimension\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"star", ",", " ", "sparse", ",", " ", "lone"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"36e1b324-86c4-4fcb-ae4e-8c7c2a9b36d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "2.`"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["8", "35"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", 
      "2.999999999999999`"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "10"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "4.`"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"187e7d86-772b-453a-a306-01bd49863bde"]
}, Open  ]]
}, Open  ]],

