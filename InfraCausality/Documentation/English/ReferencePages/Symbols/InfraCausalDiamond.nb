     "ab5b886e-ddf6-4105-a2a7-0f2fc2b17999"]], "TableText",ExpressionUUID->
     "2d218e32-950b-46f5-b53d-8c5d5b8aa9fe"], Cell[
    "1 on every edge between two events of the diamond", "TableText",
     ExpressionUUID->"c20f8e3f-a1c9-45ac-8aee-aac7df0f89df"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "469a8cec-2f10-4eca-b7dc-31f7371d8679"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "da1bf260-4f5c-463a-8002-0d7f1374c9a6"]], "TableText",ExpressionUUID->
     "602326c3-b317-46f5-9a7d-e8dff79c83f2"], Cell[
    "the subgraph induced on the diamond", "TableText",ExpressionUUID->
     "328c536a-7b2c-4d4b-9188-4f95214dc866"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4a25670c-cc06-4847-91a3-fdd07aa4a250"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a4dd8caf-4fdf-4d24-b717-10008c431550"]], "TableText",ExpressionUUID->
     "95562aeb-7852-436a-9a03-3e910efc078c"], Cell[
    "the interval volume, the number of events of the diamond", "TableText",
     ExpressionUUID->"6fd3a0f9-860a-42a3-8995-3a25fc3e7a9d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2da36972-ddae-4206-95df-96c30bb42441"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b7d5320c-ae3a-4e82-8739-25b251779fed"]], "TableText",ExpressionUUID->
     "e01d8b5f-1f27-45da-8317-a30f504230d9"], Cell[
    "1: the diamond is a set, and its support is its only member", 
     "TableText",ExpressionUUID->"540c959f-d583-4cf8-b895-31ac42e4293a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1667f651-c560-47e1-ae32-7a8e8c16779e"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7abc301a-f838-4d8d-836d-b27a6d373587"]], "TableText",ExpressionUUID->
     "c4485169-7c43-4966-a4a5-e0e89d420212"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0a884f96-32ac-4d7a-8134-8296c5dd9518"]], "TableText",ExpressionUUID->
     "7a03412d-7240-4eab-a63a-4410e95dbbcf"]}
  }]], "2ColumnTableMod",ExpressionUUID->"9e6b38a8-70a5-4a46-b817-\
01366aadc2e7"],

Cell[TextData[{
 "The interval volume is the quantity causal-set theory reads proper time and \
dimension from: in a sprinkling of density \[Rho] into ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space the expected number of events of [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] is \[Rho] times the spacetime volume of the diamond, which is \
proportional to the ",
 StyleBox["d", "TI"],
 "-th power of the proper time between the tips."
}], "Notes",ExpressionUUID->"52a4208a-16a4-4ed8-9754-4f9b824244ce"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCausalDiamond"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalDiamond", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c24b9259-f430-4b7e-b230-66ed77bdacfd"],
 " returns the support as a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02c2aa0b-67ea-4570-b04e-f988630929c7"],
 " recognises a vertex set that is the diamond of its least and greatest \
events."
}], "Notes",ExpressionUUID->"24812a77-3352-4d3b-b269-0890da55107f"],

Cell[TextData[{
 "Experimental: the causal-set estimators are further readings of the \
diamond, on its ",
 StyleBox["N", "TI"],
 " events with the order restricted to them. ",
 StyleBox["R", "TI"],
 " is the number of related pairs ",
 StyleBox["x", "TI"],
 " \[Precedes] ",
 StyleBox["y", "TI"],
 " of the diamond and ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
  "24a09255-c251-412e-8e7c-4a91d3b9db72"],
 " the number of related pairs with exactly ",
 StyleBox["k", "TI"],
 " events strictly between them, so ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "5741364f-af34-4124-9d8e-895199467ebe"],
 " counts the links."
}], "Notes",ExpressionUUID->"e5c18612-cf8d-4b8d-8daa-d37edddb0086"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81338f09-eca4-40eb-a555-d86f28a9eb99"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"03624c42-01c5-431b-9ebc-f7111837970f"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"adb816e5-13f1-40d8-b238-2cf4c263b4d3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "595a4745-ae21-4df7-8c44-44bce7634bb7"], Cell[TextData[Cell[
    BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a54064b0-6002-4af2-87a6-40bdf377d3b7"]], "TableText",ExpressionUUID->
     "42623df9-36e5-4e52-88af-b1b77bbcb09f"], Cell[TextData[{
     StyleBox["r", "TI"],
     " = ",
     StyleBox["R", "TI"],
     " / (",
     StyleBox["N", "TI"],
     " choose 2), the fraction of related pairs, exact"
    }], "TableText",ExpressionUUID->"68f8029d-3553-479f-8312-d89be722b628"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "23f7807f-83f9-425e-b218-53c8c537aa5b"], Cell[TextData[Cell[
    BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1fe9a56d-954f-4bc6-9354-108f6c5c5c73"]], "TableText",ExpressionUUID->
     "1751aec7-6904-459f-983b-9efd20658e8d"], Cell[TextData[{
     "the ",
     StyleBox["d", "TI"],
     " with \[CapitalGamma](",
     StyleBox["d", "TI"],
     " + 1) \[CapitalGamma](",
     StyleBox["d", "TI"],
     "/2) / (2 \[CapitalGamma](3",
     StyleBox["d", "TI"],
     "/2)) = ",
     StyleBox["r", "TI"],
     ", the dimension of the Minkowski space whose sprinkled intervals have \
ordering fraction ",
     StyleBox["r", "TI"],
     ": ",
     StyleBox["r", "TI"],
     " = 1, 1/2, 8/35, 1/10 at ",
     StyleBox["d", "TI"],
     " = 1, 2, 3, 4; it is 1 on a chain and \[Infinity] on an antichain"
    }], "TableText",ExpressionUUID->"87f02c27-6ff5-43c7-8d8d-fd534653205f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0785ccf2-69e5-4633-b287-a66db7146aeb"], Cell[TextData[Cell[
    BoxData["\"\<MidpointScalingDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0dbf1a2b-f31a-4d4e-8e90-86a25bca3ba9"]], "TableText",ExpressionUUID->
     "2c45d48d-fb89-4b20-be14-9611a79591ee"], Cell[TextData[{
     "log",
     Cell[BoxData[
      SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
      "d6d4f05c-4ddf-4547-a1ff-bec826fd4cc2"],
     "(",
     StyleBox["N", "TI"],
     " / ",
     StyleBox["N", "TI"],
     "\[Prime]), where ",
     StyleBox["N", "TI"],
     "\[Prime] is the largest over the events ",
     StyleBox["m", "TI"],
     " of the smaller of the cardinalities of ",
     StyleBox["J", "TI"],
     "\:207b(",
     StyleBox["m", "TI"],
     ") and ",
     StyleBox["J", "TI"],
     "\:207a(",
     StyleBox["m", "TI"],
     ") within the diamond: halving the proper time divides the volume by 2",
     Cell[BoxData[
      SuperscriptBox["", 
       RowBox[{"*", "d", "*"}]]], "InlineFormula",ExpressionUUID->
      "5b208675-9217-44c1-a44c-8e98c902e9aa"]
    }], "TableText",ExpressionUUID->"26cfd054-05ac-4d51-9cdc-3fbeee59c132"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "94af494b-5ea5-4e50-9c51-ed2ce6e2a123"], Cell[TextData[Cell[
    BoxData["\"\<IntervalAbundances\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "39fcf4a5-9377-4191-9ee3-50704c52d45a"]], "TableText",ExpressionUUID->
     "6bce2508-fd5c-47e2-a7fc-a85480a6f9d2"], Cell[TextData[{
     "the association from ",
     StyleBox["k", "TI"],
     " to ",
     StyleBox["N", "TI"],
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
      "12d14812-9f12-46e1-bf70-a5ce7f3219cd"],
     ", for ",
     StyleBox["k", "TI"],
     " = 0, \[Ellipsis], ",
     StyleBox["N", "TI"],
     " \[Minus] 2"
    }], "TableText",ExpressionUUID->"615b966e-f117-4f27-bb9a-5572967cbfc8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5910087c-021e-494b-97d9-818f99224de9"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerDAlembertian\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1aba017c-db50-44a9-8f04-e3f8d12f7e79"]], "TableText",ExpressionUUID->
     "b45bd2f4-f05c-4c09-99ce-ecea58a81792"], Cell[TextData[{
     "the matrix of the Benincasa\[Dash]Dowker operator ",
     StyleBox["B", "TI"],
     " in the basis of the diamond's events, in the order of the keys of ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a8e5cc78-7de7-4940-892f-da137c3fc314"],
     ", with \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"081f7843-fd33-42e7-9c14-8d7529298da7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0f22b438-91bf-4175-89c2-0c8d3f5d24c8"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerRicci\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "772709f0-74a7-4dab-8f0f-785669c6c094"]], "TableText",ExpressionUUID->
     "4e0ca86a-6476-4d38-a0d0-61cf76a346cf"], Cell[TextData[{
     "the association from each event ",
     StyleBox["x", "TI"],
     " to ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     ") = \[Minus]2 (",
     StyleBox["B", "TI"],
     " ",
     StyleBox["1",
      FontWeight->"Bold"],
     ")(",
     StyleBox["x", "TI"],
     "), the discrete scalar curvature"
    }], "TableText",ExpressionUUID->"91e15eae-c403-4998-a102-75ebe8a1a44b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f331d5db-a571-4965-bd66-ec9d10107e52"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerAction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4939f6f2-06cd-4da6-8053-e56201c441d4"]], "TableText",ExpressionUUID->
     "e50a6310-90ba-4d1e-96ff-b590392c8bff"], Cell[TextData[{
     StyleBox["S", "TI"],
     " = \.bd \[CapitalSigma]",
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "x", "*"}]]], "InlineFormula",ExpressionUUID->
      "5f4c25db-e84a-4e12-81ea-b9f61b89ca4d"],
     " ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     "), the Benincasa\[Dash]Dowker action in units \:0127 = \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"1bf9d169-b551-4d81-97a9-bd8806e850bd"]}
  }]], "2ColumnTableMod",ExpressionUUID->"694a8a23-f836-4bfe-a58c-\
8b41edf5dc61"],

Cell[TextData[{
 "The last three take the option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
   RowBox[{"2", " ", "|", " ", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5f3486d-c201-467b-89b7-643e82adef3f"],
 " as a fourth argument of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d806693-25c3-4c73-bf24-7c1f0447e33c"],
 ". In two dimensions ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = 4 (\[Minus]\.bd \[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "b60a7d92-4712-4474-8e56-c7af7f7cd323"],
 " \[Minus] 2 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "11264970-2af6-4c16-88f4-7ec0eed67548"],
 " + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "e184e92c-0d50-4a43-a23e-3d59a4e2bbe1"],
 ") and in four ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = (4/\[Sqrt]6)(\[Minus]\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "843ebaf9-1709-4645-bdfa-ee874648f500"],
 " \[Minus] 9 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "ed6d83dc-b42e-41ba-a0dc-e860aefcfd28"],
 " + 16 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "9576537b-d111-4353-9bc6-ff9b2220a56f"],
 " \[Minus] 8 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "6b5d18dd-f611-4b14-aa3d-c2a08fb552d6"],
 "), where \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "190ac55e-e213-488b-9c1f-5c5b2b856d6a"],
 " is the sum of \[CurlyPhi] over the ",
 StyleBox["i", "TI"],
 "-th past layer of ",
 StyleBox["x", "TI"],
 ", the events ",
 StyleBox["y", "TI"],
 " \[Precedes] ",
 StyleBox["x", "TI"],
 " of the diamond with ",
 StyleBox["i", "TI"],
 " \[Minus] 1 events strictly between (Benincasa and Dowker 2010, Eqs. 2, 3 \
and 10). The operator is retarded: row ",
 StyleBox["x", "TI"],
 " of the matrix is supported on ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["x", "TI"],
 "). In a sprinkling into a curved spacetime its mean tends to \
(\[EmptySquare] \[Minus] \.bd ",
 StyleBox["R", "TI"],
 ") \[CurlyPhi], which is why ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") = ",
 StyleBox["B", "TI"],
 "(\[Minus]2)(",
 StyleBox["x", "TI"],
 "); summing gives ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "85ee9caf-5098-43d5-b836-88088d7a3445"],
 " = 2 (",
 StyleBox["N", "TI"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "0bb31476-6779-468d-8fcd-c0e62bd84c8c"],
 " + 4 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "2b004e2a-edb9-4cd4-acbc-9dd8fe150c86"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "dbdf04a0-31d2-4b23-a567-b2ed2ec4e2de"],
 ") and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "48ba89c6-9ac8-41f4-9024-2e71d77a195b"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "0d2e2578-b90c-418e-82b4-b7ea899c1762"],
 " + 9 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "1a72daf1-eec1-4f63-8d7f-19187f8bb13a"],
 " \[Minus] 16 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "b2f8995e-de81-48fc-bde4-6373fe5f4ed0"],
 " + 8 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "5a2b1fed-fc49-4146-b39a-97edf11a48bc"],
 "), the alternating sums of Benincasa and Dowker's Eqs. 13 and 14 with their \
order-one prefactors restored. On a chain of ",
 StyleBox["N", "TI"],
 " events ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "0e4b5601-2644-464b-96d2-dcef1706f5b5"],
 " = 2 ",
 StyleBox["N", "TI"],
 " and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "e961f174-6fff-4f45-80ca-1991b6d75a8c"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1). On ",
 StyleBox["N", "TI"],
 " points sprinkled into a flat two-dimensional causal diamond the mean of ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "9eb62f8e-eb87-4027-929b-46586aabd6dd"],
 " is exactly 2 for every ",
 StyleBox["N", "TI"],
 " (Brightwell's theorem, quoted by Benincasa, Dowker and Schmitzer 2011), \
while its standard deviation grows like 2 ",
 StyleBox["N", "TI"],
 ": the unsmeared operator fluctuates, and the mean curvature 2 ",
 StyleBox["S", "TI"],
 " / ",
 StyleBox["N", "TI"],
 " of a flat diamond is 4 / ",
 StyleBox["N", "TI"],
 " in expectation."
}], "Notes",ExpressionUUID->"15aab040-d454-437d-8914-f6e6b4b865be"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"887dcc61-b1e0-4442-991a-536fce1c8742"],

