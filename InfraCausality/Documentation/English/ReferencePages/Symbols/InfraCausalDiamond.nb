     "0d5f5a81-18e5-4aac-a310-1cab4cc6e5c3"]], "TableText",ExpressionUUID->
     "8579394c-3c45-4284-befc-e65fe57a2452"], Cell[
    "1 on every edge between two events of the diamond", "TableText",
     ExpressionUUID->"913fd73b-faa4-454a-838e-017261f111b9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08a8ad66-da64-4484-ab46-eab1991b1190"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "319b747f-26e0-486f-aabf-f23dae45bbf8"]], "TableText",ExpressionUUID->
     "8de2a413-db98-464e-8978-bf3d6db9556e"], Cell[
    "the subgraph induced on the diamond", "TableText",ExpressionUUID->
     "e87a7178-d2ed-4014-810f-0d8f210ee7fa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e8598c24-3263-4b7b-8f02-c7ac0c74951c"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1d629606-7606-4efa-8604-871e382f415f"]], "TableText",ExpressionUUID->
     "fb639414-f1d2-41bb-8edd-3374cb780f19"], Cell[
    "the interval volume, the number of events of the diamond", "TableText",
     ExpressionUUID->"60e502c1-1298-4343-b23a-bf57ea6ee8a7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "387350e7-39bd-4024-bfb1-9c3047d8a966"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8b763eb2-5f09-4620-b1b9-4e14d326d4e5"]], "TableText",ExpressionUUID->
     "b127a957-1bdf-4d2a-9dee-5161702271b8"], Cell[
    "1: the diamond is a set, and its support is its only member", 
     "TableText",ExpressionUUID->"fafc1598-bfeb-4c64-ac82-f7ed1e81fd1c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c6b7870c-5bd7-4b94-be3d-11a0931f9e08"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "29a8ccdb-b7cd-4008-93aa-756bf8378ae5"]], "TableText",ExpressionUUID->
     "629c6ee0-07fd-468c-b71c-3e99a66c11a2"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e64852ea-6b49-40fa-a8ed-8efeec8bc456"]], "TableText",ExpressionUUID->
     "f0736ac1-406b-4f2f-b7be-03c288ec5c9f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a586fcb5-66e4-408c-9098-\
061facec5181"],

Cell[TextData[{
 "The interval volume is the quantity causal-set theory reads proper time and \
dimension from: in a sprinkling of density \[Rho] into ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space the expected number of events of [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] is \[Rho] times the spacetime volume of the diamond, which is \
proportional to the ",
 StyleBox["d", "TI"],
 "-th power of the proper time between the tips."
}], "Notes",ExpressionUUID->"35f078b5-e12a-4176-b38b-a5b2519cb142"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCausalDiamond"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalDiamond", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75490a80-3ffe-4c40-b631-3c5a8f511221"],
 " returns the support as a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "607b68ee-da20-443f-b55f-b8edce19ee3f"],
 " recognises a vertex set that is the diamond of its least and greatest \
events."
}], "Notes",ExpressionUUID->"6114d167-c9fb-412d-b6e8-ed60449d40b0"],

Cell[TextData[{
 "Experimental: the causal-set estimators are further readings of the \
diamond, on its ",
 StyleBox["N", "TI"],
 " events with the order restricted to them. ",
 StyleBox["R", "TI"],
 " is the number of related pairs ",
 StyleBox["x", "TI"],
 " \[Precedes] ",
 StyleBox["y", "TI"],
 " of the diamond and ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
  "f92b641e-8633-4a8a-9c92-84689f3b312d"],
 " the number of related pairs with exactly ",
 StyleBox["k", "TI"],
 " events strictly between them, so ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "d86d6a4a-0cc9-4b75-b045-fc98464da722"],
 " counts the links."
}], "Notes",ExpressionUUID->"feddc6ba-b692-4724-8106-0def2ea57b99"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a405a90d-d4d5-4300-af4f-1269978467f4"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"290fff0f-b665-4d80-a514-14da213fba44"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"c9b15bf7-c9ed-4b2c-a015-4dcf96ca71d9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "86980a8a-1447-4528-b5c2-3209abf8eeab"], Cell[TextData[Cell[
    BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "689277b5-55d0-4d67-8595-99059b7cb408"]], "TableText",ExpressionUUID->
     "17ed5bda-ea30-40f0-a82b-7ddd27d92090"], Cell[TextData[{
     StyleBox["r", "TI"],
     " = ",
     StyleBox["R", "TI"],
     " / (",
     StyleBox["N", "TI"],
     " choose 2), the fraction of related pairs, exact"
    }], "TableText",ExpressionUUID->"dbac46a6-9c36-4c92-be66-14a578458e1c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b2a5ef7e-4535-4d3c-8bc1-4c6b6ec55116"], Cell[TextData[Cell[
    BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "17315fe2-5bda-4248-998f-d60c5bf1763d"]], "TableText",ExpressionUUID->
     "8e3878bd-f8b1-4d65-90d6-3bf7aac77df6"], Cell[TextData[{
     "the ",
     StyleBox["d", "TI"],
     " with \[CapitalGamma](",
     StyleBox["d", "TI"],
     " + 1) \[CapitalGamma](",
     StyleBox["d", "TI"],
     "/2) / (2 \[CapitalGamma](3",
     StyleBox["d", "TI"],
     "/2)) = ",
     StyleBox["r", "TI"],
     ", the dimension of the Minkowski space whose sprinkled intervals have \
ordering fraction ",
     StyleBox["r", "TI"],
     ": ",
     StyleBox["r", "TI"],
     " = 1, 1/2, 8/35, 1/10 at ",
     StyleBox["d", "TI"],
     " = 1, 2, 3, 4; it is 1 on a chain and \[Infinity] on an antichain"
    }], "TableText",ExpressionUUID->"5d43bbdb-e259-4c56-b971-216f9e22cfcb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fab4abab-02cd-437f-a8e0-5cf1a1c76bcb"], Cell[TextData[Cell[
    BoxData["\"\<MidpointScalingDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4b7aefe7-c0f0-4144-bf15-6b2b913978b3"]], "TableText",ExpressionUUID->
     "df4e38a4-3d2f-4feb-b8f2-89bf4f02bdde"], Cell[TextData[{
     "log",
     Cell[BoxData[
      SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
      "2474a287-9348-4796-8f51-3bf312b2ff3d"],
     "(",
     StyleBox["N", "TI"],
     " / ",
     StyleBox["N", "TI"],
     "\[Prime]), where ",
     StyleBox["N", "TI"],
     "\[Prime] is the largest over the events ",
     StyleBox["m", "TI"],
     " of the smaller of the cardinalities of ",
     StyleBox["J", "TI"],
     "\:207b(",
     StyleBox["m", "TI"],
     ") and ",
     StyleBox["J", "TI"],
     "\:207a(",
     StyleBox["m", "TI"],
     ") within the diamond: halving the proper time divides the volume by 2",
     Cell[BoxData[
      SuperscriptBox["", 
       RowBox[{"*", "d", "*"}]]], "InlineFormula",ExpressionUUID->
      "83c682cc-5393-48e5-8a4c-e3f26c26556a"]
    }], "TableText",ExpressionUUID->"fd7e99c5-6fe5-486b-aaac-2ff0c01c7041"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1c10aa3f-773e-453b-951c-1812cb34f847"], Cell[TextData[Cell[
    BoxData["\"\<IntervalAbundances\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "563d197b-695f-43db-9b97-db70f5ff83eb"]], "TableText",ExpressionUUID->
     "b1615810-71d0-4425-9ecd-c6846d0afbd6"], Cell[TextData[{
     "the association from ",
     StyleBox["k", "TI"],
     " to ",
     StyleBox["N", "TI"],
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
      "e5743ce6-8c3d-4707-b977-2acb8cefaab3"],
     ", for ",
     StyleBox["k", "TI"],
     " = 0, \[Ellipsis], ",
     StyleBox["N", "TI"],
     " \[Minus] 2"
    }], "TableText",ExpressionUUID->"57bc0ed7-3aa6-4744-a7a3-13b196a1fa40"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9000b019-16fc-46d0-855c-27b51b14b880"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerDAlembertian\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cd378dd0-2d24-4325-9376-91cf2c3a62e0"]], "TableText",ExpressionUUID->
     "7cf13c64-4f2f-4768-95b9-66ef75a85fad"], Cell[TextData[{
     "the matrix of the Benincasa\[Dash]Dowker operator ",
     StyleBox["B", "TI"],
     " in the basis of the diamond's events, in the order of the keys of ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8119f59e-4580-47eb-a050-59dbd4ef3250"],
     ", with \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"1c311ee0-c96c-49a1-a44f-c78095abb9c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c0e26930-42dd-439d-885f-4c6b12ba964e"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerRicci\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b3b52948-16b8-4fa4-9a4d-5969594dcf7c"]], "TableText",ExpressionUUID->
     "3d37618b-2eac-411b-9604-e10ab02d6d06"], Cell[TextData[{
     "the association from each event ",
     StyleBox["x", "TI"],
     " to ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     ") = \[Minus]2 (",
     StyleBox["B", "TI"],
     " ",
     StyleBox["1",
      FontWeight->"Bold"],
     ")(",
     StyleBox["x", "TI"],
     "), the discrete scalar curvature"
    }], "TableText",ExpressionUUID->"8cca1948-31e5-47ea-a104-2979111a4743"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fbfcfdc7-c485-4463-89bb-8ac14b538738"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerAction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d9ed73d2-2b9c-4b62-b08c-e3c5df3c3196"]], "TableText",ExpressionUUID->
     "b5cc9a84-0bf9-479f-8019-b03219ed9740"], Cell[TextData[{
     StyleBox["S", "TI"],
     " = \.bd \[CapitalSigma]",
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "x", "*"}]]], "InlineFormula",ExpressionUUID->
      "30e7f2fe-8504-4e33-8d18-10582585a031"],
     " ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     "), the Benincasa\[Dash]Dowker action in units \:0127 = \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"5fa9b294-7c61-440c-9b22-e5ebdb1b40e8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"27281526-5592-409c-9b82-\
599ce525d880"],

Cell[TextData[{
 "The last three take the option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
   RowBox[{"2", " ", "|", " ", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53ffc46e-b3d9-4f1b-9895-94c1678384dd"],
 " as a fourth argument of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe42996-f48b-4380-beba-79e0ba49221a"],
 ". In two dimensions ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = 4 (\[Minus]\.bd \[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "47cf6606-70e5-44f0-a90a-5da378ff4a5c"],
 " \[Minus] 2 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "be1c8eee-4bee-4188-8b1f-bce6725920e0"],
 " + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "b400854b-fd17-4e83-a727-38a365f77f5b"],
 ") and in four ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = (4/\[Sqrt]6)(\[Minus]\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "70204646-02f2-4230-a7c5-c067bdc1e70e"],
 " \[Minus] 9 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "036e0c5c-5917-47e5-be02-171423074d2f"],
 " + 16 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "712a02dc-479c-4c84-ab6f-9ef5a4b0c696"],
 " \[Minus] 8 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "107b073d-b3cf-4329-ba4a-f95f354c61c4"],
 "), where \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "3d9d8f28-9790-49f1-ab93-d3940e807c5f"],
 " is the sum of \[CurlyPhi] over the ",
 StyleBox["i", "TI"],
 "-th past layer of ",
 StyleBox["x", "TI"],
 ", the events ",
 StyleBox["y", "TI"],
 " \[Precedes] ",
 StyleBox["x", "TI"],
 " of the diamond with ",
 StyleBox["i", "TI"],
 " \[Minus] 1 events strictly between (Benincasa and Dowker 2010, Eqs. 2, 3 \
and 10). The operator is retarded: row ",
 StyleBox["x", "TI"],
 " of the matrix is supported on ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["x", "TI"],
 "). In a sprinkling into a curved spacetime its mean tends to \
(\[EmptySquare] \[Minus] \.bd ",
 StyleBox["R", "TI"],
 ") \[CurlyPhi], which is why ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") = ",
 StyleBox["B", "TI"],
 "(\[Minus]2)(",
 StyleBox["x", "TI"],
 "); summing gives ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "ff2c18c3-cee4-4e6c-9c09-74715241a9c0"],
 " = 2 (",
 StyleBox["N", "TI"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "c068aae5-4174-41a2-8e86-be926979e70e"],
 " + 4 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "89f723d1-7d08-478d-8bc7-852e4d731dac"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "be99340d-74c3-4d5e-a6f9-137f146f8e58"],
 ") and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "bc94d861-808b-4a39-9321-523e2677be51"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "864309ae-454d-4524-a7f1-48acbb19ec7b"],
 " + 9 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "87fdf35d-8410-4b20-815e-a9f2bbd3b798"],
 " \[Minus] 16 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "c0326748-b9e8-4917-a1ba-015d4efdad99"],
 " + 8 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "c859c407-d5ef-452e-baf7-47b72d5bd218"],
 "), the alternating sums of Benincasa and Dowker's Eqs. 13 and 14 with their \
order-one prefactors restored. On a chain of ",
 StyleBox["N", "TI"],
 " events ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "0837c590-c42e-479d-90d1-6eea8c0d6d49"],
 " = 2 ",
 StyleBox["N", "TI"],
 " and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "4607dda4-edc3-45c7-8984-8624e1d2505a"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1). On ",
 StyleBox["N", "TI"],
 " points sprinkled into a flat two-dimensional causal diamond the mean of ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "f9c53519-2a22-4cb1-b468-b664503fa8f0"],
 " is exactly 2 for every ",
 StyleBox["N", "TI"],
 " (Brightwell's theorem, quoted by Benincasa, Dowker and Schmitzer 2011), \
while its standard deviation grows like 2 ",
 StyleBox["N", "TI"],
 ": the unsmeared operator fluctuates, and the mean curvature 2 ",
 StyleBox["S", "TI"],
 " / ",
 StyleBox["N", "TI"],
 " of a flat diamond is 4 / ",
 StyleBox["N", "TI"],
 " in expectation."
}], "Notes",ExpressionUUID->"60ecc5c4-7aa8-4b9e-904b-2cd8a8faf455"],

