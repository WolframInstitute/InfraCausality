Cell[CellGroupData[{

Cell["Experimental readings", "ExampleSubsection",ExpressionUUID->"bcb243f8-83a9-4836-b546-46c661906643"],

Cell[TextData[{
 "The ordering fraction of the full diamond lattice, exact: with ",
 StyleBox["n", "TI"],
 " + 1 events on a side, the related pairs are the comparable pairs of a \
product of two chains, ((",
 StyleBox["n", "TI"],
 " + 1)(",
 StyleBox["n", "TI"],
 " + 2)/2)\.b2 \[Minus] (",
 StyleBox["n", "TI"],
 " + 1)\.b2 of them. It tends to 1/2, the Minkowski value, but slowly."
}], "ExampleText",ExpressionUUID->"8cbfba84-8c76-47a1-a5d2-d631e3a66104"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", "\"\<OrderingFraction\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ebc63128-f42d-4a1d-bd3f-f10d669b3543"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["5", "6"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     FractionBox["3", "4"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["7", "10"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     FractionBox["2", "3"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     FractionBox["9", "14"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", 
     FractionBox["5", "8"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8d972dd-ed83-43e3-8ccf-f517bfff3d8f"]
}, Open  ]],

Cell["\<\
A sprinkling of 300 events into the two-dimensional flat diamond, read as one \
causal set: the ordering fraction is near 1/2, both dimension estimators near \
2, and the action an integer that fluctuates from seed to seed around its \
mean 2.\
\>", "ExampleText",ExpressionUUID->"0b885986-0631-44ba-8c52-0c90180db138"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<OrderingFraction\>\"", ",", 
       " ", "\"\<MyrheimMeyerDimension\>\"", ",", 
       " ", "\"\<MidpointScalingDimension\>\"", ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2e66fbb3-813a-421f-8903-5c9c0cd3719d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
    FractionBox["1729", "3450"]}], ",", 
   RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "1.996911266984622`"}],
    ",", 
   RowBox[{"\<\"MidpointScalingDimension\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Log", "[", 
      FractionBox["300", "73"], "]"}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", 
   RowBox[{"\<\"BenincasaDowkerAction\"\>", "\[Rule]", "336"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f92f4b5d-c43d-4fb5-a04b-810258ad46e5"]
}, Open  ]],

Cell["\<\
The same in three dimensions: the ordering fraction is near 8/35 and the \
estimators near 3.\
