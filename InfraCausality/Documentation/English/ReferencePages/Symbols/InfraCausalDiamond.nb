Cell["\<\
The Benincasa\[Dash]Dowker operator of the 2 \[Times] 2 diamond: \[Minus]2 on \
the diagonal, 4 on each link below the diagonal in the sorted event order, \
and the discrete curvature it assigns to each event.\
\>", "ExampleText",ExpressionUUID->"9e9a03f1-63c9-4afb-b479-4972fbfb03f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
       "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerDAlembertian\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d62cf419-6e8f-46ab-8885-03e921cc247f"],

