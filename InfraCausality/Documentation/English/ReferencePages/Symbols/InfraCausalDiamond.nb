Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", for every pair of events."
}], "ExampleText",ExpressionUUID->"4332a0a1-218c-453d-a36d-6dd63c90ee98"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], " ", "===", 
          " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "q"}], "]"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9762d25d-db94-4689-8450-948c81980e17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6f9a31b9-f46a-4023-b46d-56dc8b15081f"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} \[PrecedesSlantEqual] {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is a rectangle of (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"efa5a687-ae2f-4805-938f-a92b75bb26c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"63142cd9-1971-4544-b174-637dada7e36a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e2a88f3d-3a10-4946-9b22-93db5620ebf9"]
}, Open  ]],

Cell["\<\
The diamond is convex: an event between two of its events is one of its \
events.\
\>", "ExampleText",ExpressionUUID->"c90f0512-a6a2-4956-ad83-da0371bd3e62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], " ", "|->", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"diamond", ",", " ", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "u", ",", " ", "w"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a8f419b3-1801-4bb6-8307-c519e6f9f1ae"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"482e2515-0891-4f2d-a664-16f00f188a16"]
}, Open  ]],

Cell[TextData[{
 "The causal hull of every worldline from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond of its tips."
}], "ExampleText",ExpressionUUID->"debce044-c2be-496f-a16c-3adff271d8e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraWorldline", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraWorldline", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"chain", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", "chain", "]"}]}], "]"}], " ", "===",
        " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"242f8f85-fc3b-4566-89f0-531741dbb945"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0750973d-3f68-4aca-ba42-c24b5f4ba971"]
}, Open  ]],

Cell["\<\
The discrete curvature is the operator applied to the constant field \
\[Minus]2, and the action is half its total, in both dimensions.\
\>", "ExampleText",ExpressionUUID->"fbb4496c-1e49-412f-8c10-692e547b64af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"dim", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", 
             " ", "\"\<BenincasaDowkerDAlembertian\>\"", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"ricci", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\"", ",",
              " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], 
            "]"}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Values", "[", "ricci", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"B", " ", ".", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "300"}], "]"}]}]}]}], "]"}]}], " ", "===",
           " ", 
          RowBox[{"{", "0", "}"}]}], " ", "&&", "\n", "        ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{
             "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerAction\>\"", ",",
               " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}], 
            " ", "-", " ", 
            RowBox[{
             RowBox[{"Total", "[", "ricci", "]"}], "/", "2"}]}], "]"}], " ", "===",
           " ", "0"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f5ef41b2-74bf-4140-9a45-1ffd7addcfa0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"2e3affbc-136d-467c-b52d-3a80e506bc03"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer dimension inverts the exact ordering fractions: 1/2 \
gives 2, 8/35 gives 3, 1/10 gives 4.\
\>", "ExampleText",ExpressionUUID->"16ea842f-84f7-4ac4-a949-932885db1013"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"star", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "3"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"sparse", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"8", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"9", " ", "->", " ", "10"}]}], "}"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"lone", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<OrderingFraction\>\"", ",", 
         " ", "\"\<MyrheimMeyerDimension\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"star", ",", " ", "sparse", ",", " ", "lone"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"00cb4317-9ba6-48c3-9821-197552dcd5a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "2.`"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["8", "35"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", 
      "2.999999999999999`"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "10"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "4.`"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"e739c540-5001-46d8-becc-a228db36d9c4"]
}, Open  ]]
}, Open  ]],

