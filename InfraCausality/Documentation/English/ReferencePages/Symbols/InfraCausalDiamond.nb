Cell["\<\
The interval volume of the diamonds from the bottom event of the diamond \
lattice to every event of the slice at height 6.\
\>", "ExampleText",ExpressionUUID->"a32d34c9-ce5d-40d4-9a42-a459d38754ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"RandomInfraSlice", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"529e9ea5-b5a7-4b96-bda6-d4558d31d282"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "7", ",", "12", ",", "15", ",", "16", ",", "15", ",", "12", ",", "7"}], 
  "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"3d55e551-2ad5-4f83-9738-3f305c850a89"]
}, Open  ]]
}, Open  ]],

