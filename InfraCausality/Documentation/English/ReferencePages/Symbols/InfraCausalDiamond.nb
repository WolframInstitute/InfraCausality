Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalDiamond", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5f00ae0-86d1-4d18-a278-917fd4e6a705"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d78cf2-8d09-46c2-a125-173dc9808f40"],
 "\[LineSeparator]",
 "is the causal diamond of the events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every event that lies after ",
 StyleBox["p", "TI"],
 " and before ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"77891885-10c9-40d5-b109-73d8ccce4294"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e87ee877-9cd9-446a-adf8-e8b098802f64"],
 "\[LineSeparator]",
 "is the causal hull of a set of events: every event that lies after one of \
them and before one of them."
}], "Usage",ExpressionUUID->"dcd30acb-2629-4beb-9fdd-8bd5ca46b3e7"],

Cell[TextData[{
 "Definition: the causal diamond of two events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " of a directed acyclic graph is [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 "}, the Alexandrov interval of the causal order."
}], "Notes",ExpressionUUID->"627e9dd3-6170-4cbd-a2df-de5e8e2ecda2"],

Cell[TextData[{
 "It is empty unless ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 ", and it is the single event ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ". It is convex: with two of its events ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["w", "TI"],
 " it contains every event between them. Every causal chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " runs inside it, so it carries the worldlines and the timelike geodesics \
between its tips, and it is the radar domain of an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"61d632c5-7d6f-4ab2-9512-4222020c7361"],

Cell[TextData[{
 "The causal hull of a set ",
 StyleBox["S", "TI"],
 " is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the smallest convex set containing ",
 StyleBox["S", "TI"],
 ". The hull of a chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]."
}], "Notes",ExpressionUUID->"903e8660-3b42-4617-a732-5dc84819df25"],

Cell[TextData[{
 "The head holds its tips and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "864890f1-b9d7-4c29-b370-49cd74dc4586"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"f9f547d5-ac6d-4ac0-80e8-2642a9ab9caa"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8c8403a1-4f6e-44f7-8af6-f0e37a45eaa0"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"7d37040c-11ea-4fe2-8b28-c19ea7f997b6"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"275ca35b-6284-42e9-90a8-44468466c60a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "48bc5052-fa12-4127-b54d-dc39218f84b2"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "923b4c29-849c-4298-b8b3-381e1a586a58"]], "TableText",ExpressionUUID->
     "b3de9cb9-2d57-4fd2-8606-c62244109ab2"], Cell[
    "1 on every event of the diamond, keys sorted", "TableText",
     ExpressionUUID->"8f472fd9-4ffc-4673-a1b4-2f1169a82bc6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "89e1c350-b35f-4936-80bc-7904731e91f9"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04f07bbb-313c-489c-bdfa-543d08f1bd37"]], "TableText",ExpressionUUID->
     "81a31db8-8509-42d5-bbda-7ec8445221fb"], Cell[
    "1 on every edge between two events of the diamond", "TableText",
     ExpressionUUID->"d5f99539-0818-4425-85b2-05543dc694c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "594d8904-c942-4d8b-9cab-c6477eda6543"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c3a76892-2181-453b-9bf3-33cef895dbca"]], "TableText",ExpressionUUID->
     "0ffc412e-cd29-4c93-a61e-4bda82e34bdb"], Cell[
    "the subgraph induced on the diamond", "TableText",ExpressionUUID->
     "87254030-9e14-4b73-8ba4-af76b80c172d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "870b5d50-9855-4b32-9b7b-9af9d5ffaa48"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d9a95a32-0d59-4451-a7c1-377099429b36"]], "TableText",ExpressionUUID->
     "aa9b2b24-44be-4a92-8359-692239b885ff"], Cell[
    "the interval volume, the number of events of the diamond", "TableText",
     ExpressionUUID->"7783c324-82af-41e2-9339-256a0cefdf90"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ee395617-9593-48a6-a275-c16085d2559d"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e78336e3-3a55-4723-b3f5-89fb6907e22d"]], "TableText",ExpressionUUID->
     "501b3048-9ae3-40bd-9523-63a1413ffe92"], Cell[
    "1: the diamond is a set, and its support is its only member", 
     "TableText",ExpressionUUID->"7bee2064-db23-49df-bb1f-2b7e99d68aa0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "89602d4a-76cc-4d0b-a1cf-6725f6410ee2"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0600d44c-4983-4fc1-8c7a-740a5ab9dd46"]], "TableText",ExpressionUUID->
     "bc5a7137-db46-4825-af77-d395c2033a43"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a956ef1d-d645-4f0d-a2f1-bec79c0203d8"]], "TableText",ExpressionUUID->
     "73cf420d-7100-4e06-8759-624750cf5fc7"]}
  }]], "2ColumnTableMod",ExpressionUUID->"fb3d62fb-3fc4-40e7-a64d-\
02c232e20857"],

Cell[TextData[{
 "The interval volume is the quantity causal-set theory reads proper time and \
dimension from: in a sprinkling of density \[Rho] into ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space the expected number of events of [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] is \[Rho] times the spacetime volume of the diamond, which is \
proportional to the ",
 StyleBox["d", "TI"],
 "-th power of the proper time between the tips."
}], "Notes",ExpressionUUID->"ede765d2-ade4-4ed2-84f5-578a5f247b33"],

Cell[TextData[{
 "A set head has one member, its support, so no sampler draws it. The three \
readings of the diamond on a graph are ",
 Cell[BoxData[
  RowBox[{"InfraSubgraph", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalDiamond", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "915fd72a-9497-41db-b418-39b696cdbe15"],
 " (InfraGeometry), the induced subgraph; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Keys",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       StyleBox["p", "TI"], ",", " ", 
       StyleBox["q", "TI"]}], "]"}], ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594c437b-2fd4-4075-92a9-21141c1fc1d4"],
 ", the sorted vertex list; and ",
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalDiamond", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b582073-671a-466b-b63c-eeaedf2c9793"],
 " (InfraGeometry), ",
 StyleBox["n", "TI"],
 " distinct random events of it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca81ac0c-39cf-4ff3-870b-53f06c045712"],
 " recognises a vertex set that is the diamond of its least and greatest \
events."
}], "Notes",ExpressionUUID->"c85e5753-4bd2-40d3-98c9-97d812159615"],

Cell[TextData[{
 "Experimental: the causal-set estimators are further readings of the \
diamond, on its ",
 StyleBox["N", "TI"],
 " events with the order restricted to them. ",
 StyleBox["R", "TI"],
 " is the number of related pairs ",
 StyleBox["x", "TI"],
 " \[Precedes] ",
 StyleBox["y", "TI"],
 " of the diamond and ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
  "624939e5-4d34-45cd-8c1e-67de811f068a"],
 " the number of related pairs with exactly ",
 StyleBox["k", "TI"],
 " events strictly between them, so ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "e5a0f5d3-f82f-41da-bf97-64f254881c68"],
 " counts the links."
}], "Notes",ExpressionUUID->"d263dd4a-5659-4f7d-80ac-31b467ec8a4e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e2dce41d-0061-4ac7-8b3d-6653a9af889e"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"ba424c21-751f-4b94-a79b-3c53f35c8d9c"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"1996f207-b356-4aca-9d45-14a03c1860c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7443b042-d352-4137-9caa-c243f98ddfc0"], Cell[TextData[Cell[
    BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fe6d8573-91c9-4656-abb8-7a1dda126147"]], "TableText",ExpressionUUID->
     "8077aa7f-1131-4840-8bc1-d402ba521442"], Cell[TextData[{
     StyleBox["r", "TI"],
     " = ",
     StyleBox["R", "TI"],
     " / (",
     StyleBox["N", "TI"],
     " choose 2), the fraction of related pairs, exact"
    }], "TableText",ExpressionUUID->"809dca12-f4ef-458a-ab4e-8fdf4c7b3a8f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0d0b0ba1-526c-4321-baf7-268d6615e060"], Cell[TextData[Cell[
    BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b31224c0-950f-4752-b6aa-7b932df853f2"]], "TableText",ExpressionUUID->
     "4d95a2e8-1991-4695-bb94-35594ca2e04f"], Cell[TextData[{
     "the ",
     StyleBox["d", "TI"],
     " with \[CapitalGamma](",
     StyleBox["d", "TI"],
     " + 1) \[CapitalGamma](",
     StyleBox["d", "TI"],
     "/2) / (2 \[CapitalGamma](3",
     StyleBox["d", "TI"],
     "/2)) = ",
     StyleBox["r", "TI"],
     ", the dimension of the Minkowski space whose sprinkled intervals have \
ordering fraction ",
     StyleBox["r", "TI"],
     ": ",
     StyleBox["r", "TI"],
     " = 1, 1/2, 8/35, 1/10 at ",
     StyleBox["d", "TI"],
     " = 1, 2, 3, 4; it is 1 on a chain and \[Infinity] on an antichain"
    }], "TableText",ExpressionUUID->"0810e9e7-a726-4ebd-a3a8-52ed5ad47043"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ca521425-29f6-4860-89ff-ec878aae74a9"], Cell[TextData[Cell[
    BoxData["\"\<MidpointScalingDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a69973d4-9c75-4a4e-a70d-f590f2c44703"]], "TableText",ExpressionUUID->
     "33cf04b7-be88-420a-9768-c798f6c3a99d"], Cell[TextData[{
     "log",
     Cell[BoxData[
      SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
      "06586017-0192-404f-8262-9054141b8661"],
     "(",
     StyleBox["N", "TI"],
     " / ",
     StyleBox["N", "TI"],
     "\[Prime]), where ",
     StyleBox["N", "TI"],
     "\[Prime] is the largest over the events ",
     StyleBox["m", "TI"],
     " of the smaller of the cardinalities of ",
     StyleBox["J", "TI"],
     "\:207b(",
     StyleBox["m", "TI"],
     ") and ",
     StyleBox["J", "TI"],
     "\:207a(",
     StyleBox["m", "TI"],
     ") within the diamond: halving the proper time divides the volume by 2",
     Cell[BoxData[
      SuperscriptBox["", 
       RowBox[{"*", "d", "*"}]]], "InlineFormula",ExpressionUUID->
      "be16542d-161e-4730-bd44-47b4940dc692"]
    }], "TableText",ExpressionUUID->"8894e040-e1a0-4013-8e64-c5bb86e08417"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2cfe4b2d-0b75-4b60-a19a-c006911050a5"], Cell[TextData[Cell[
    BoxData["\"\<IntervalAbundances\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "47a37f2a-a066-4dd0-a06d-3e801af76e91"]], "TableText",ExpressionUUID->
     "d5af1ffb-03aa-47f0-b09b-618d942580ca"], Cell[TextData[{
     "the association from ",
     StyleBox["k", "TI"],
     " to ",
     StyleBox["N", "TI"],
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
      "050b4254-d239-49f0-b415-a739dac48101"],
     ", for ",
     StyleBox["k", "TI"],
     " = 0, \[Ellipsis], ",
     StyleBox["N", "TI"],
     " \[Minus] 2"
    }], "TableText",ExpressionUUID->"6c74a67c-4eb8-44c3-98cb-1f9e9627bef4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9728576-4e9b-44a9-83a4-af055d824fbf"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerDAlembertian\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "555787da-8f2e-4dea-b39c-458c13bd5b44"]], "TableText",ExpressionUUID->
     "ff39a8fc-6b63-4b4e-b70a-ed6f0dc50875"], Cell[TextData[{
     "the matrix of the Benincasa\[Dash]Dowker operator ",
     StyleBox["B", "TI"],
     " in the basis of the diamond's events, in the order of the keys of ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f6353131-6785-4fc3-a5c3-cd8bd473cfe4"],
     ", with \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"c1c230cc-b526-4465-a465-b178c3697f0f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1fbeb0ce-45b7-4e39-a38d-2b658d6d18b3"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerRicci\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2d8d27b0-aa5b-4467-8bed-6e75f11016b2"]], "TableText",ExpressionUUID->
     "94de8d52-2b93-42c8-8bcb-3c9dacd6645a"], Cell[TextData[{
     "the association from each event ",
     StyleBox["x", "TI"],
     " to ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     ") = \[Minus]2 (",
     StyleBox["B", "TI"],
     " ",
     StyleBox["1",
      FontWeight->"Bold"],
     ")(",
     StyleBox["x", "TI"],
     "), the discrete scalar curvature"
    }], "TableText",ExpressionUUID->"dc8cb498-238c-494e-8c2c-f7ab0fd0c4f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5b6b259c-063f-4de0-b7fa-9eacf6ca01bd"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerAction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ec76a829-1831-4677-9658-68ca33d643df"]], "TableText",ExpressionUUID->
     "6b5f2ac7-4239-4298-bb67-c3c7592a95b3"], Cell[TextData[{
     StyleBox["S", "TI"],
     " = \.bd \[CapitalSigma]",
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "x", "*"}]]], "InlineFormula",ExpressionUUID->
      "9881200b-21a0-4633-b2b8-6c309df51b41"],
     " ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     "), the Benincasa\[Dash]Dowker action in units \:0127 = \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"4feaacdb-610d-487d-9afa-a833ec040a51"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e79a0b5f-6630-4ff2-9ab8-\
cafacd79cab2"],

Cell[TextData[{
 "The last three take the option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
   RowBox[{"2", " ", "|", " ", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7bec7e7-14e3-4e50-a5f4-bec8b4dbd849"],
 " as a fourth argument of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ebf0af5-3c5e-4f0e-baf8-20d7c72871b9"],
 ". In two dimensions ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = 4 (\[Minus]\.bd \[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "2376ab2f-4324-4cd2-b4c0-cfabe1123d86"],
 " \[Minus] 2 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "2e2c363d-d2c5-4120-b65d-bb7e1d70e820"],
 " + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "758ac52b-4b8c-4c4c-afb4-0886b3fdfa5b"],
 ") and in four ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = (4/\[Sqrt]6)(\[Minus]\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "53eaf616-1632-42ee-afcf-6f2a3051f890"],
 " \[Minus] 9 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "23351385-3e59-4d50-a11b-f70290281be6"],
 " + 16 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "0d807e1d-c46a-45ee-afaa-9e4a027da77d"],
 " \[Minus] 8 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "59edff2f-d09b-4b93-8052-d75b55b415ac"],
 "), where \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "80360dea-5865-4f73-89e5-0baa33edd5b5"],
 " is the sum of \[CurlyPhi] over the ",
 StyleBox["i", "TI"],
 "-th past layer of ",
 StyleBox["x", "TI"],
 ", the events ",
 StyleBox["y", "TI"],
 " \[Precedes] ",
 StyleBox["x", "TI"],
 " of the diamond with ",
 StyleBox["i", "TI"],
 " \[Minus] 1 events strictly between (Benincasa and Dowker 2010, Eqs. 2, 3 \
and 10). The operator is retarded: row ",
 StyleBox["x", "TI"],
 " of the matrix is supported on ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["x", "TI"],
 "). In a sprinkling into a curved spacetime its mean tends to \
(\[EmptySquare] \[Minus] \.bd ",
 StyleBox["R", "TI"],
 ") \[CurlyPhi], which is why ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") = ",
 StyleBox["B", "TI"],
 "(\[Minus]2)(",
 StyleBox["x", "TI"],
 "); summing gives ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "03a5a4a5-8489-4687-a346-a4c5d9927afd"],
 " = 2 (",
 StyleBox["N", "TI"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "5580c830-153b-4d00-852e-86fcf9e39507"],
 " + 4 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "add6ee5a-6050-4123-958d-44af52cd5177"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "d176ab78-26ef-42cb-b046-4c6a097cff81"],
 ") and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "2ed65850-db72-4e13-91d4-68063c973c84"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "22772b9c-4638-4181-a94c-6c3591bcba6e"],
 " + 9 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "7611dd29-2c6e-45ca-ace5-663034e27f45"],
 " \[Minus] 16 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "614a9c97-b2c3-4977-bf23-1a280289fb7e"],
 " + 8 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "504ebf4d-806a-452a-b863-6ed43e3fae6d"],
 "), the alternating sums of Benincasa and Dowker's Eqs. 13 and 14 with their \
order-one prefactors restored. On a chain of ",
 StyleBox["N", "TI"],
 " events ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "ce66c50c-aded-451c-a13d-6422e369dc58"],
 " = 2 ",
 StyleBox["N", "TI"],
 " and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "78d4e675-8379-4cf0-b582-b9c11341667b"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1). On ",
 StyleBox["N", "TI"],
 " points sprinkled into a flat two-dimensional causal diamond the mean of ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "a280d0f7-c728-4927-8c0f-ef742d4940d9"],
 " is exactly 2 for every ",
 StyleBox["N", "TI"],
 " (Brightwell's theorem, quoted by Benincasa, Dowker and Schmitzer 2011), \
while its standard deviation grows like 2 ",
 StyleBox["N", "TI"],
 ": the unsmeared operator fluctuates, and the mean curvature 2 ",
 StyleBox["S", "TI"],
 " / ",
 StyleBox["N", "TI"],
 " of a flat diamond is 4 / ",
 StyleBox["N", "TI"],
 " in expectation."
}], "Notes",ExpressionUUID->"7df3bcda-fd1c-468a-82f7-504071511053"],

