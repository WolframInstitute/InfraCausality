Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", for every pair of events."
}], "ExampleText",ExpressionUUID->"557bf5b0-5cd5-4ec8-8b8c-31efc4369958"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], " ", "===", 
          " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "q"}], "]"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"87da72f2-508f-43ad-add6-7ac4de615708"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c561c192-7459-4743-9b33-208cdf1d61e2"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} \[PrecedesSlantEqual] {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is a rectangle of (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"4947d9e3-0d6d-4306-8fa0-71b391194439"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6cbefdcb-d328-4a91-a1fe-13f3ba796448"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4c844208-3f4a-4dc1-a662-d9892a6443a6"]
}, Open  ]],

Cell["\<\
The diamond is convex: an event between two of its events is one of its \
events.\
\>", "ExampleText",ExpressionUUID->"4b26cebe-1237-41c5-844e-cca92d77c50a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], " ", "|->", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"diamond", ",", " ", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "u", ",", " ", "w"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2f2656a5-a41d-41b2-b6e1-f9be8bae4304"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"3e964d14-82ee-4fd0-9c4c-bb0750981881"]
}, Open  ]],

Cell[TextData[{
 "The causal hull of every worldline from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond of its tips."
}], "ExampleText",ExpressionUUID->"6c37748a-b80b-416f-93fd-27f2e98003f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraWorldline", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraWorldline", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"chain", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", "chain", "]"}]}], "]"}], " ", "===",
        " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"8c76a8fb-29cb-4120-a2c6-21717a2f2cf1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"507ac21e-5c35-495c-a4d4-ecab94c1748c"]
}, Open  ]],

Cell["\<\
The discrete curvature is the operator applied to the constant field \
\[Minus]2, and the action is half its total, in both dimensions.\
\>", "ExampleText",ExpressionUUID->"810c9bca-6d1e-479d-926e-cbd77a34e94c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"dim", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", 
             " ", "\"\<BenincasaDowkerDAlembertian\>\"", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"ricci", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\"", ",",
              " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], 
            "]"}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Values", "[", "ricci", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"B", " ", ".", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "300"}], "]"}]}]}]}], "]"}]}], " ", "===",
           " ", 
          RowBox[{"{", "0", "}"}]}], " ", "&&", "\n", "        ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{
             "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerAction\>\"", ",",
               " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}], 
            " ", "-", " ", 
            RowBox[{
             RowBox[{"Total", "[", "ricci", "]"}], "/", "2"}]}], "]"}], " ", "===",
           " ", "0"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b94e0ef5-e5d5-4bcb-a393-183a363de6c3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"42a92936-de5a-4988-8b20-923f7879bac6"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer dimension inverts the exact ordering fractions: 1/2 \
gives 2, 8/35 gives 3, 1/10 gives 4.\
\>", "ExampleText",ExpressionUUID->"5887ce54-f588-4256-a3be-eb837920e66a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"star", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "3"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"sparse", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"8", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"9", " ", "->", " ", "10"}]}], "}"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"lone", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<OrderingFraction\>\"", ",", 
         " ", "\"\<MyrheimMeyerDimension\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"star", ",", " ", "sparse", ",", " ", "lone"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"d2f348ab-5937-4d0c-9ece-0730992225c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "2.`"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["8", "35"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", 
      "2.999999999999999`"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "10"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "4.`"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"5e6c1244-5532-4dda-899a-fdd0cf94fd09"]
}, Open  ]]
}, Open  ]],

