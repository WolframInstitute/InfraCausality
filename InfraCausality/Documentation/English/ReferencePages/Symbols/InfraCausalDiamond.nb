     "b5844e6d-1b8b-4490-bbc7-cd93cb895dd9"]], "TableText",ExpressionUUID->
     "0e563a48-9793-4149-8cef-23fa523e184a"], Cell[
    "1 on every edge between two events of the diamond", "TableText",
     ExpressionUUID->"8f82f53a-2786-40a3-b29a-a4e198515880"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e70cfa1c-3e5d-45f4-9ecd-92086a89c83b"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f8f95ecc-0526-4f05-86bd-07a8982b5eae"]], "TableText",ExpressionUUID->
     "9e1c14bc-1f1b-4da1-b0ef-73dc721c3dbd"], Cell[
    "the subgraph induced on the diamond", "TableText",ExpressionUUID->
     "e3c62511-2974-420f-abe6-51f362d19d2a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8a75e8ba-324c-426b-be45-e5479ddece42"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "18558744-934f-48bf-96b2-60fcedfbcf4b"]], "TableText",ExpressionUUID->
     "056ff338-e0c4-42d4-b55d-92e89c48cc8d"], Cell[
    "the interval volume, the number of events of the diamond", "TableText",
     ExpressionUUID->"35cfafb7-89c4-4130-958f-c2526e5cfeaa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bee8c2f4-8460-44d5-9187-6390a87d6975"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "586c09a1-17db-4ec9-88fd-172840ec03f5"]], "TableText",ExpressionUUID->
     "ed72855b-d508-4c56-921f-b6045c1252b5"], Cell[
    "1: the diamond is a set, and its support is its only member", 
     "TableText",ExpressionUUID->"b7d029df-b846-4e2b-84d7-c1e37adc124c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f2c1fb2a-6229-4463-8b4f-1e69706a5911"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3f484cc3-151f-4ae9-a12b-fc832149b39e"]], "TableText",ExpressionUUID->
     "0c04a101-e03d-4ec8-9d84-417c19ad2c47"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2233d762-87c9-46c9-bab6-d3fec1a43089"]], "TableText",ExpressionUUID->
     "5ab8ac12-ac09-4b31-b0f1-07f5c463ed42"]}
  }]], "2ColumnTableMod",ExpressionUUID->"50b67253-373f-4a28-b1e6-\
b92f11b070e7"],

Cell[TextData[{
 "The interval volume is the quantity causal-set theory reads proper time and \
dimension from: in a sprinkling of density \[Rho] into ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space the expected number of events of [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] is \[Rho] times the spacetime volume of the diamond, which is \
proportional to the ",
 StyleBox["d", "TI"],
 "-th power of the proper time between the tips."
}], "Notes",ExpressionUUID->"bf8a64ac-5b06-47b8-8d15-77b5da845779"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCausalDiamond"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalDiamond", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a29c5507-a2ba-4817-ba27-febcd98b6a98"],
 " returns the support as a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57f1d7b7-4c51-4b20-9ab0-4b87a54b94b6"],
 " recognises a vertex set that is the diamond of its least and greatest \
events."
}], "Notes",ExpressionUUID->"1478b914-a391-4f5c-b496-0a0f406e8a4a"],

Cell[TextData[{
 "Experimental: the causal-set estimators are further readings of the \
diamond, on its ",
 StyleBox["N", "TI"],
 " events with the order restricted to them. ",
 StyleBox["R", "TI"],
 " is the number of related pairs ",
 StyleBox["x", "TI"],
 " \[Precedes] ",
 StyleBox["y", "TI"],
 " of the diamond and ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
  "2bdab0c6-c7ed-43a7-a590-4cd9cd333970"],
 " the number of related pairs with exactly ",
 StyleBox["k", "TI"],
 " events strictly between them, so ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "a5663d91-380f-486f-84de-0e03d232fa3d"],
 " counts the links."
}], "Notes",ExpressionUUID->"4a86b45f-d6b4-437d-a5db-4bd1591f6e9b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0eb2db71-af6e-4fae-b57b-12fd3ed88db6"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"71535724-cadd-4875-b52f-9bb778795589"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"e61e1e65-306b-430a-95ed-4d5998e7ca41"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9feb8b80-0569-46db-9967-1e18158a72f6"], Cell[TextData[Cell[
    BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c4118f41-2f32-4c2e-833f-ec009dfabc07"]], "TableText",ExpressionUUID->
     "081198de-ddd8-4446-bf69-6badf7debf48"], Cell[TextData[{
     StyleBox["r", "TI"],
     " = ",
     StyleBox["R", "TI"],
     " / (",
     StyleBox["N", "TI"],
     " choose 2), the fraction of related pairs, exact"
    }], "TableText",ExpressionUUID->"21aca808-992f-447f-878f-df18f803cac0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6dba9fe9-d6b1-4e2b-b6cf-2f9b95ef9502"], Cell[TextData[Cell[
    BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "372a2b8b-ec42-47a2-9975-5d820b22fb48"]], "TableText",ExpressionUUID->
     "f2759238-dc6f-4ef1-a504-dfd0e0d85d43"], Cell[TextData[{
     "the ",
     StyleBox["d", "TI"],
     " with \[CapitalGamma](",
     StyleBox["d", "TI"],
     " + 1) \[CapitalGamma](",
     StyleBox["d", "TI"],
     "/2) / (2 \[CapitalGamma](3",
     StyleBox["d", "TI"],
     "/2)) = ",
     StyleBox["r", "TI"],
     ", the dimension of the Minkowski space whose sprinkled intervals have \
ordering fraction ",
     StyleBox["r", "TI"],
     ": ",
     StyleBox["r", "TI"],
     " = 1, 1/2, 8/35, 1/10 at ",
     StyleBox["d", "TI"],
     " = 1, 2, 3, 4; it is 1 on a chain and \[Infinity] on an antichain"
    }], "TableText",ExpressionUUID->"efe3597c-1656-4b9d-ade6-54d7c94bf8e1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "447bbeee-19ab-43a6-a2b0-6da631f97180"], Cell[TextData[Cell[
    BoxData["\"\<MidpointScalingDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f15b9a8b-781c-44bf-9b89-55bfcaafc14f"]], "TableText",ExpressionUUID->
     "b97aae2c-2b73-4882-8431-61c921071a26"], Cell[TextData[{
     "log",
     Cell[BoxData[
      SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
      "da7f0310-c5fe-46b4-91c8-fe71cc63ad86"],
     "(",
     StyleBox["N", "TI"],
     " / ",
     StyleBox["N", "TI"],
     "\[Prime]), where ",
     StyleBox["N", "TI"],
     "\[Prime] is the largest over the events ",
     StyleBox["m", "TI"],
     " of the smaller of the cardinalities of ",
     StyleBox["J", "TI"],
     "\:207b(",
     StyleBox["m", "TI"],
     ") and ",
     StyleBox["J", "TI"],
     "\:207a(",
     StyleBox["m", "TI"],
     ") within the diamond: halving the proper time divides the volume by 2",
     Cell[BoxData[
      SuperscriptBox["", 
       RowBox[{"*", "d", "*"}]]], "InlineFormula",ExpressionUUID->
      "80b7428e-4d82-418d-b915-981d46c931c1"]
    }], "TableText",ExpressionUUID->"8505bd03-db3f-4a7b-ae0f-e1237d62fad1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5285f551-afab-477f-9e3e-e1534b2d1058"], Cell[TextData[Cell[
    BoxData["\"\<IntervalAbundances\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a11863c6-cba8-466b-aa9c-ee72868459f4"]], "TableText",ExpressionUUID->
     "fbfacf10-3d7f-4bd0-86bb-c8b70f3f41b9"], Cell[TextData[{
     "the association from ",
     StyleBox["k", "TI"],
     " to ",
     StyleBox["N", "TI"],
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
      "cb87da6e-a55c-470e-8a03-49659721578e"],
     ", for ",
     StyleBox["k", "TI"],
     " = 0, \[Ellipsis], ",
     StyleBox["N", "TI"],
     " \[Minus] 2"
    }], "TableText",ExpressionUUID->"97f1c576-75fd-47ff-9a2c-283240112e81"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cc2e1d56-4a34-422f-af53-4c1a3eade915"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerDAlembertian\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f88226c3-d58c-4269-b32a-5914903dc17b"]], "TableText",ExpressionUUID->
     "89a8eb06-b04d-4a6b-b619-0b35588b78f6"], Cell[TextData[{
     "the matrix of the Benincasa\[Dash]Dowker operator ",
     StyleBox["B", "TI"],
     " in the basis of the diamond's events, in the order of the keys of ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b02cc465-d8ab-4671-966e-8c91f53126e8"],
     ", with \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"809e3830-b84e-4ce7-9db5-e334a667ed1c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f4ad9b67-f912-4151-adc7-4d8078761e04"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerRicci\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f9f2148f-b1c1-42e1-97d4-0ee73f478498"]], "TableText",ExpressionUUID->
     "b89c196f-73e7-4c40-ba6e-17e734b09517"], Cell[TextData[{
     "the association from each event ",
     StyleBox["x", "TI"],
     " to ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     ") = \[Minus]2 (",
     StyleBox["B", "TI"],
     " ",
     StyleBox["1",
      FontWeight->"Bold"],
     ")(",
     StyleBox["x", "TI"],
     "), the discrete scalar curvature"
    }], "TableText",ExpressionUUID->"1f49b885-0d43-497f-a03c-11f2c5b2dcdf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b5ff93c7-b975-472f-88a7-76ba7a5c6d6c"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerAction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5a80a00e-6491-4068-9d09-b1e65a888f43"]], "TableText",ExpressionUUID->
     "db7b033f-f327-46b7-a3db-d18b842ad49d"], Cell[TextData[{
     StyleBox["S", "TI"],
     " = \.bd \[CapitalSigma]",
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "x", "*"}]]], "InlineFormula",ExpressionUUID->
      "54ee8487-18f4-41f7-a9e0-8857298cc0ed"],
     " ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     "), the Benincasa\[Dash]Dowker action in units \:0127 = \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"5bd59a64-0496-4f7c-81bf-9e346e6535fd"]}
  }]], "2ColumnTableMod",ExpressionUUID->"5d9c295b-3c20-4dc5-aea9-\
94662afce8d1"],

Cell[TextData[{
 "The last three take the option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
   RowBox[{"2", " ", "|", " ", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd51c29f-c331-4b57-b4d0-e8d7048e64d0"],
 " as a fourth argument of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dbb3826-60e9-4bd0-af5b-2ca5c94bd5e3"],
 ". In two dimensions ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = 4 (\[Minus]\.bd \[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "e423484b-bec3-4f9c-9b53-d61aeca642fe"],
 " \[Minus] 2 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "2280bfa1-f181-4872-adf8-6a49f8cdfadc"],
 " + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "555b1b24-de6c-47c3-aae0-68b8d9ec0d2d"],
 ") and in four ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = (4/\[Sqrt]6)(\[Minus]\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "3a1242b0-540c-4877-a316-3642056ff896"],
 " \[Minus] 9 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "db206bd9-048c-4c1b-882c-1819dc7ffc28"],
 " + 16 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "fdb750a8-833b-44bb-b8ab-3656c79f2a94"],
 " \[Minus] 8 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "04cf39f6-34a8-4142-a5e3-200c707ddc08"],
 "), where \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "a4536953-598a-47f5-bb2b-3b45d2fbc80a"],
 " is the sum of \[CurlyPhi] over the ",
 StyleBox["i", "TI"],
 "-th past layer of ",
 StyleBox["x", "TI"],
 ", the events ",
 StyleBox["y", "TI"],
 " \[Precedes] ",
 StyleBox["x", "TI"],
 " of the diamond with ",
 StyleBox["i", "TI"],
 " \[Minus] 1 events strictly between (Benincasa and Dowker 2010, Eqs. 2, 3 \
and 10). The operator is retarded: row ",
 StyleBox["x", "TI"],
 " of the matrix is supported on ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["x", "TI"],
 "). In a sprinkling into a curved spacetime its mean tends to \
(\[EmptySquare] \[Minus] \.bd ",
 StyleBox["R", "TI"],
 ") \[CurlyPhi], which is why ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") = ",
 StyleBox["B", "TI"],
 "(\[Minus]2)(",
 StyleBox["x", "TI"],
 "); summing gives ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "9534f662-94c6-425a-b079-c8624c9c6496"],
 " = 2 (",
 StyleBox["N", "TI"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "208bed95-0402-4dee-b935-aa960ce387b3"],
 " + 4 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "3eef83b0-764b-4bf3-a58b-b376009fd90f"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "44b8b3b0-b4a8-4967-9a3d-ffbeeb888030"],
 ") and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "c0f7741e-6e0f-458c-a901-7605ca24ec28"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "a82cb7c7-ab74-4093-a35f-eb27f45079ca"],
 " + 9 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "5ed28a68-80e5-47ea-9025-e6cbec150e9b"],
 " \[Minus] 16 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "a3441261-4cb0-42d0-a2b6-05fbdda04a1c"],
 " + 8 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "5ac73bd4-71cd-46d0-9c58-1efe032e7329"],
 "), the alternating sums of Benincasa and Dowker's Eqs. 13 and 14 with their \
order-one prefactors restored. On a chain of ",
 StyleBox["N", "TI"],
 " events ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "7460efe1-fcd3-41b1-be17-65184b374719"],
 " = 2 ",
 StyleBox["N", "TI"],
 " and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "20731778-5554-4a7d-8683-c5a7160c3b9a"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1). On ",
 StyleBox["N", "TI"],
 " points sprinkled into a flat two-dimensional causal diamond the mean of ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "989705c4-ceca-40b6-8521-d1ffaa928b27"],
 " is exactly 2 for every ",
 StyleBox["N", "TI"],
 " (Brightwell's theorem, quoted by Benincasa, Dowker and Schmitzer 2011), \
while its standard deviation grows like 2 ",
 StyleBox["N", "TI"],
 ": the unsmeared operator fluctuates, and the mean curvature 2 ",
 StyleBox["S", "TI"],
 " / ",
 StyleBox["N", "TI"],
 " of a flat diamond is 4 / ",
 StyleBox["N", "TI"],
 " in expectation."
}], "Notes",ExpressionUUID->"0cea9344-17d6-4703-90df-4cd91c36493d"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"b0f5cb24-d4f7-4117-a36f-8b84a94c614f"],

