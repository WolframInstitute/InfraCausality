Cell["Dimension", "ExampleSubsection",ExpressionUUID->"bd3a574f-d1c7-4895-b630-f91d35e64e86"],

Cell[TextData[{
 "The Benincasa\[Dash]Dowker readings use the two-dimensional layer \
coefficients by default; ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b68e9abb-5458-4dbd-8711-3970da283924"],
 " uses the four-dimensional ones. On a chain of ten events the actions are 2 \
",
 StyleBox["N", "TI"],
 " = 20 and (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1) = 6 \[Sqrt]6."
}], "ExampleText",ExpressionUUID->"0685383e-74c3-49b3-b767-2b3e3282d8a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",", " ", 
       RowBox[{"DirectedEdges", " ", "->", " ", "True"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\"", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ef8f79e6-f1f3-490c-aa5c-e570ceb8d867"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", 
   RowBox[{"6", " ", 
    SqrtBox["6"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"14cbc5b0-ff9b-42f8-8027-5ab6d113f0d4"]
