Cell[CellGroupData[{

Cell["Experimental readings", "ExampleSubsection",ExpressionUUID->"3aaa0880-b562-4973-92cb-c3ad0a113bbf"],

Cell[TextData[{
 "The ordering fraction of the full diamond lattice, exact: with ",
 StyleBox["n", "TI"],
 " + 1 events on a side, the related pairs are the comparable pairs of a \
product of two chains, ((",
 StyleBox["n", "TI"],
 " + 1)(",
 StyleBox["n", "TI"],
 " + 2)/2)\.b2 \[Minus] (",
 StyleBox["n", "TI"],
 " + 1)\.b2 of them. It tends to 1/2, the Minkowski value, but slowly."
}], "ExampleText",ExpressionUUID->"b652a2a3-d648-4806-9c8c-b4968929600d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", "\"\<OrderingFraction\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9afb4214-3566-4e5f-bc2b-5521985a3768"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["5", "6"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     FractionBox["3", "4"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["7", "10"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     FractionBox["2", "3"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     FractionBox["9", "14"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", 
     FractionBox["5", "8"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a4bb01ed-338a-4ca6-95c7-30cae424b697"]
}, Open  ]],

Cell["\<\
A sprinkling of 300 events into the two-dimensional flat diamond, read as one \
causal set: the ordering fraction is near 1/2, both dimension estimators near \
2, and the action an integer that fluctuates from seed to seed around its \
mean 2.\
\>", "ExampleText",ExpressionUUID->"b601e90f-dab4-4b80-9d5a-9547d9e121dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<OrderingFraction\>\"", ",", 
       " ", "\"\<MyrheimMeyerDimension\>\"", ",", 
       " ", "\"\<MidpointScalingDimension\>\"", ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"82728c47-3ef5-426b-a4fa-9726cc61eb24"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
    FractionBox["1729", "3450"]}], ",", 
   RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "1.996911266984622`"}],
    ",", 
   RowBox[{"\<\"MidpointScalingDimension\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Log", "[", 
      FractionBox["300", "73"], "]"}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", 
   RowBox[{"\<\"BenincasaDowkerAction\"\>", "\[Rule]", "336"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"393cf1d9-9d71-476c-af2a-5991ddde29db"]
}, Open  ]],

