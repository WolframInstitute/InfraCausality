Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalDiamond", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"49dc80aa-f981-450e-a0d8-5152a3581906"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6097327-d3a7-4f03-98e0-a610a37b536f"],
 "\[LineSeparator]",
 "is the causal diamond of the events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every event that lies after ",
 StyleBox["p", "TI"],
 " and before ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"95ad57e3-2f42-4493-a999-ab2c4d2df3fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ff0ef6-990f-4026-b94a-50d976a90d14"],
 "\[LineSeparator]",
 "is the causal hull of a set of events: every event that lies after one of \
them and before one of them."
}], "Usage",ExpressionUUID->"da1f38f2-6c90-424d-a7c5-1e0a18186b88"],

Cell[TextData[{
 "Definition: the causal diamond of two events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " of a directed acyclic graph is [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 "}, the Alexandrov interval of the causal order."
}], "Notes",ExpressionUUID->"460a72c8-1d7f-45a2-9385-7dbc72fe170f"],

Cell[TextData[{
 "It is empty unless ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 ", and it is the single event ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ". It is convex: with two of its events ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["w", "TI"],
 " it contains every event between them. Every causal chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " runs inside it, so it carries the worldlines and the timelike geodesics \
between its tips, and it is the radar domain of an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"0ea2ae74-13ae-403d-94ad-79b48425c2c0"],

Cell[TextData[{
 "The causal hull of a set ",
 StyleBox["S", "TI"],
 " is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the smallest convex set containing ",
 StyleBox["S", "TI"],
 ". The hull of a chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]."
}], "Notes",ExpressionUUID->"edce3969-c68b-41ca-8093-db39c01af975"],

Cell[TextData[{
 "The head holds its tips and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b87a41a-d2e8-4162-a558-2dffc40e7bb8"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"c3f53f9f-4a3c-495e-9e4f-618855619f2c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aec16e30-7393-4c79-b199-07535e22372c"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"de9afeab-c5af-4ee5-a847-d94e958816b3"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"d28f5f79-d369-4430-9e78-7494019a72f8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9b698af-3ff5-401a-91c2-008a1f75f2d4"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "889089f0-84bd-426d-b92d-f56aff91bc10"]], "TableText",ExpressionUUID->
     "5a72cda9-94a9-45a3-98d9-6721edef1a0b"], Cell[
    "1 on every event of the diamond, keys sorted", "TableText",
     ExpressionUUID->"a1bf6782-3879-492f-968c-b17f3c99597f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "25b2c8c7-e755-40be-a013-46f2b4cbfb21"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3e841b43-964e-446c-b279-48bff962c4b0"]], "TableText",ExpressionUUID->
     "61574b9c-0f9a-4877-a7ff-cd660c7a1080"], Cell[
    "1 on every edge between two events of the diamond", "TableText",
     ExpressionUUID->"601f2727-1753-480b-a53a-1c0c1d2ec11f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a2543c7f-e9ae-4f59-a6c8-f9369891a172"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a9e4a2c7-29f5-4225-b80e-d22e1fe21bbe"]], "TableText",ExpressionUUID->
     "bcb6bfc8-03bd-4aec-b48f-ced560de3fc7"], Cell[
    "the subgraph induced on the diamond", "TableText",ExpressionUUID->
     "10a15a14-060f-4884-bf3f-7a652a29ac3b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08b0106a-12a6-4627-a4f3-7ea005e46283"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f9e14100-13bd-4d7c-ad31-ca4e600efc8e"]], "TableText",ExpressionUUID->
     "ef2c5e92-5652-4087-947c-6cbcd25bb520"], Cell[
    "the interval volume, the number of events of the diamond", "TableText",
     ExpressionUUID->"605f89c2-90b8-41f4-b7b8-ed71dc7e29a9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d3ac4df6-8ed7-47a4-a3bb-4cdf90789434"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "859f9a1a-d6a4-4be2-a51c-da69e35dedec"]], "TableText",ExpressionUUID->
     "7ffdba41-c483-4ac5-a4d1-e8242e2d1a7e"], Cell[
    "1: the diamond is a set, and its support is its only member", 
     "TableText",ExpressionUUID->"47fa276e-3fff-4923-a6d9-7b5c10c3e17b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c524e1b-45ff-4f86-b220-6126de487a55"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f2ebcf06-8e16-4039-97e3-e9f94fd040a6"]], "TableText",ExpressionUUID->
     "bc243576-9788-4806-b731-17a2c4ca61b7"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "013cdef1-3e7b-42c1-8dc1-70608846af10"]], "TableText",ExpressionUUID->
     "fff8654d-ad9c-4f8f-ae11-040a8a2a1baf"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ef613159-7484-4d2b-b290-\
35345b7c60cf"],

Cell[TextData[{
 "The interval volume is the quantity causal-set theory reads proper time and \
dimension from: in a sprinkling of density \[Rho] into ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space the expected number of events of [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] is \[Rho] times the spacetime volume of the diamond, which is \
proportional to the ",
 StyleBox["d", "TI"],
 "-th power of the proper time between the tips."
}], "Notes",ExpressionUUID->"db1899e9-b134-47de-8bf0-15a6e9cc39ba"],

Cell[TextData[{
 "A set head has one member, its support, so no sampler draws it. The three \
readings of the diamond on a graph are ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalDiamond", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", "\"\<Subgraph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9268db70-c774-49b1-ac77-1b746367c557"],
 " (InfraGeometry), the induced subgraph; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Keys",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       StyleBox["p", "TI"], ",", " ", 
       StyleBox["q", "TI"]}], "]"}], ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c46329-177b-4b43-a306-03cfb3dfe422"],
 ", the sorted vertex list; and ",
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalDiamond", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4378dcc-86f3-45e6-b549-aed3ea7b4aa5"],
 " (InfraGeometry), ",
 StyleBox["n", "TI"],
 " distinct random events of it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e3cbc00-2be6-4f6d-ba8f-d7c45444308a"],
 " recognises a vertex set that is the diamond of its least and greatest \
events."
}], "Notes",ExpressionUUID->"422ca1b2-63cb-4227-b606-8b88a20208d4"],

Cell[TextData[{
 "Experimental: the causal-set estimators are further readings of the \
diamond, on its ",
 StyleBox["N", "TI"],
 " events with the order restricted to them. ",
 StyleBox["R", "TI"],
 " is the number of related pairs ",
 StyleBox["x", "TI"],
 " \[Precedes] ",
 StyleBox["y", "TI"],
 " of the diamond and ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
  "c7d85ebe-f91e-4d1b-88d1-9d6f1d9b000f"],
 " the number of related pairs with exactly ",
 StyleBox["k", "TI"],
 " events strictly between them, so ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "da98d462-238d-43ae-bfee-07995b16e995"],
 " counts the links."
}], "Notes",ExpressionUUID->"b5d0c364-0d49-48e8-8406-f59ff74f10ac"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "760023e9-a461-473b-a6c9-75757e7d1060"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"13b2040d-ac72-4d41-b717-3d1b5c887ebb"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"a4a686b9-b2d4-4251-bd89-116ce91dcc8e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eb75b935-4225-4e15-8dcd-1ab7042e690a"], Cell[TextData[Cell[
    BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c5fc4819-2d65-484f-8f1a-2e4c87e51258"]], "TableText",ExpressionUUID->
     "ab2eab6e-a382-44e0-bed6-8b890d8093a3"], Cell[TextData[{
     StyleBox["r", "TI"],
     " = ",
     StyleBox["R", "TI"],
     " / (",
     StyleBox["N", "TI"],
     " choose 2), the fraction of related pairs, exact"
    }], "TableText",ExpressionUUID->"b37946ff-7e19-4459-a938-70e39fc769d8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "581ba94d-81d3-42d0-8318-239962072a03"], Cell[TextData[Cell[
    BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9d50dc22-2b5d-40a9-a8b8-2f70aafacfde"]], "TableText",ExpressionUUID->
     "5ff6a4c5-ef54-4afe-a42a-01cf0f982df2"], Cell[TextData[{
     "the ",
     StyleBox["d", "TI"],
     " with \[CapitalGamma](",
     StyleBox["d", "TI"],
     " + 1) \[CapitalGamma](",
     StyleBox["d", "TI"],
     "/2) / (2 \[CapitalGamma](3",
     StyleBox["d", "TI"],
     "/2)) = ",
     StyleBox["r", "TI"],
     ", the dimension of the Minkowski space whose sprinkled intervals have \
ordering fraction ",
     StyleBox["r", "TI"],
     ": ",
     StyleBox["r", "TI"],
     " = 1, 1/2, 8/35, 1/10 at ",
     StyleBox["d", "TI"],
     " = 1, 2, 3, 4; it is 1 on a chain and \[Infinity] on an antichain"
    }], "TableText",ExpressionUUID->"7c5fdb32-5fd6-4659-a5fc-2373f431dafc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7b98f7b2-bcf7-44fc-a381-a8dfd770382c"], Cell[TextData[Cell[
    BoxData["\"\<MidpointScalingDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b9beea5e-0f06-4079-9464-bb981c9aa115"]], "TableText",ExpressionUUID->
     "f24df86d-5d29-4674-b975-a2edaef8e4b6"], Cell[TextData[{
     "log",
     Cell[BoxData[
      SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
      "6c7d6bcc-d3d7-4fde-b7a8-a17497c59ac3"],
     "(",
     StyleBox["N", "TI"],
     " / ",
     StyleBox["N", "TI"],
     "\[Prime]), where ",
     StyleBox["N", "TI"],
     "\[Prime] is the largest over the events ",
     StyleBox["m", "TI"],
     " of the smaller of the cardinalities of ",
     StyleBox["J", "TI"],
     "\:207b(",
     StyleBox["m", "TI"],
     ") and ",
     StyleBox["J", "TI"],
     "\:207a(",
     StyleBox["m", "TI"],
     ") within the diamond: halving the proper time divides the volume by 2",
     Cell[BoxData[
      SuperscriptBox["", 
       RowBox[{"*", "d", "*"}]]], "InlineFormula",ExpressionUUID->
      "2db46a3c-65c2-4daf-8575-a97dfe77cfba"]
    }], "TableText",ExpressionUUID->"9f671499-55a3-4d6b-8e64-9f0743edd52a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5be008de-6372-4cbf-a467-68d630584f37"], Cell[TextData[Cell[
    BoxData["\"\<IntervalAbundances\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8879eb67-d05e-4dd8-88f4-c83da2362939"]], "TableText",ExpressionUUID->
     "e0eff04a-13c8-499c-a5fb-6e0932854c5c"], Cell[TextData[{
     "the association from ",
     StyleBox["k", "TI"],
     " to ",
     StyleBox["N", "TI"],
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "k", "*"}]]], "InlineFormula",ExpressionUUID->
      "3f8cd87a-c63d-42e0-b5d0-b2b79d9bf8af"],
     ", for ",
     StyleBox["k", "TI"],
     " = 0, \[Ellipsis], ",
     StyleBox["N", "TI"],
     " \[Minus] 2"
    }], "TableText",ExpressionUUID->"e2d4d50b-4b6c-450b-98ab-134f9bd39411"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "265fb4f2-d050-44e9-899d-6f01a7072b04"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerDAlembertian\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9756d057-3751-4ade-bfa2-4f03bb336640"]], "TableText",ExpressionUUID->
     "3482ace8-9449-40fd-afd6-2d4dbcec2338"], Cell[TextData[{
     "the matrix of the Benincasa\[Dash]Dowker operator ",
     StyleBox["B", "TI"],
     " in the basis of the diamond's events, in the order of the keys of ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0a1bbe90-a149-4720-bc02-d004db31f728"],
     ", with \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"5f8e5f4a-a0a2-4afd-8451-2168703830ae"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "36346622-00f9-4b90-82d8-1645511c9970"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerRicci\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "712ddfd9-89be-4570-a08c-1b79b9edd768"]], "TableText",ExpressionUUID->
     "bc37cd08-9fc9-4f38-9969-64468d58082a"], Cell[TextData[{
     "the association from each event ",
     StyleBox["x", "TI"],
     " to ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     ") = \[Minus]2 (",
     StyleBox["B", "TI"],
     " ",
     StyleBox["1",
      FontWeight->"Bold"],
     ")(",
     StyleBox["x", "TI"],
     "), the discrete scalar curvature"
    }], "TableText",ExpressionUUID->"bb1877dd-3a0f-44b7-aef6-7bc04ce16aaa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3e299e6d-0733-4f1a-9e20-1961120dc1f8"], Cell[TextData[Cell[
    BoxData["\"\<BenincasaDowkerAction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9a11b4a2-a320-400b-890f-df80167c1739"]], "TableText",ExpressionUUID->
     "ed542167-2389-4337-b570-d484f2e7d5cb"], Cell[TextData[{
     StyleBox["S", "TI"],
     " = \.bd \[CapitalSigma]",
     Cell[BoxData[
      SubscriptBox["", 
       RowBox[{"*", "x", "*"}]]], "InlineFormula",ExpressionUUID->
      "26a07b21-b74e-4bf9-87e9-9472cc743b30"],
     " ",
     StyleBox["R", "TI"],
     "(",
     StyleBox["x", "TI"],
     "), the Benincasa\[Dash]Dowker action in units \:0127 = \[ScriptL] = 1"
    }], "TableText",ExpressionUUID->"c367b39b-332b-4315-a194-90b229892cf5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e2d2837a-99e9-4260-9618-\
e89c5751e67e"],

Cell[TextData[{
 "The last three take the option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
   RowBox[{"2", " ", "|", " ", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eddced5-5e40-47e9-9191-6ed56110086b"],
 " as a fourth argument of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fc5f8b0-8037-49df-97d7-e77540f927ec"],
 ". In two dimensions ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = 4 (\[Minus]\.bd \[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "3195a46d-d8d7-4235-b714-e11c6e546d5b"],
 " \[Minus] 2 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "8ec040d7-c38f-4ddb-928c-9fc8b08d1528"],
 " + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "b0939d24-356a-4bde-b295-33fd62008f8e"],
 ") and in four ",
 StyleBox["B", "TI"],
 "\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") = (4/\[Sqrt]6)(\[Minus]\[CurlyPhi](",
 StyleBox["x", "TI"],
 ") + \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "785c302c-7988-4864-ab0f-60fc09ac0c9d"],
 " \[Minus] 9 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "d079834d-0d77-4fe4-b1aa-2709c3b0e171"],
 " + 16 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "f32c23b0-4c60-4b59-a391-97984c91326b"],
 " \[Minus] 8 \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "e513c5ac-baec-4ba1-9ce8-9fb75fc54245"],
 "), where \[CapitalSigma]",
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "7393870c-89eb-485e-90ef-97f5b6c1ae3a"],
 " is the sum of \[CurlyPhi] over the ",
 StyleBox["i", "TI"],
 "-th past layer of ",
 StyleBox["x", "TI"],
 ", the events ",
 StyleBox["y", "TI"],
 " \[Precedes] ",
 StyleBox["x", "TI"],
 " of the diamond with ",
 StyleBox["i", "TI"],
 " \[Minus] 1 events strictly between (Benincasa and Dowker 2010, Eqs. 2, 3 \
and 10). The operator is retarded: row ",
 StyleBox["x", "TI"],
 " of the matrix is supported on ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["x", "TI"],
 "). In a sprinkling into a curved spacetime its mean tends to \
(\[EmptySquare] \[Minus] \.bd ",
 StyleBox["R", "TI"],
 ") \[CurlyPhi], which is why ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") = ",
 StyleBox["B", "TI"],
 "(\[Minus]2)(",
 StyleBox["x", "TI"],
 "); summing gives ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "c3446923-c6e0-4c5d-a8db-60a3826cea4b"],
 " = 2 (",
 StyleBox["N", "TI"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "c7047900-06cf-4270-86ee-9891c5008c64"],
 " + 4 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "6b699bf0-fba2-4817-90d3-b2cadb73f04b"],
 " \[Minus] 2 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "60b5a725-8a8c-491d-b149-15cd36eb9113"],
 ") and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "c1d64e53-f862-4db9-83eb-6f16c9e9a6e3"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "0"]], "InlineFormula",ExpressionUUID->
  "fc92b15e-e08b-44e6-bb31-f53adfda5494"],
 " + 9 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "63c9ff7a-930b-4c16-a0da-44b7394d1f9b"],
 " \[Minus] 16 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "ffc316ce-21f3-4dee-8897-a99c26a393f7"],
 " + 8 ",
 StyleBox["N", "TI"],
 Cell[BoxData[
  SubscriptBox["", "3"]], "InlineFormula",ExpressionUUID->
  "21ce3a89-a0b5-42a4-b0a4-1168a3a9f9ed"],
 "), the alternating sums of Benincasa and Dowker's Eqs. 13 and 14 with their \
order-one prefactors restored. On a chain of ",
 StyleBox["N", "TI"],
 " events ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "3c920409-985f-48b3-b94d-5550854a2868"],
 " = 2 ",
 StyleBox["N", "TI"],
 " and ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "4"]], "InlineFormula",ExpressionUUID->
  "53bc8de1-e1f1-4a96-a6b0-335eeec09eab"],
 " = (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1). On ",
 StyleBox["N", "TI"],
 " points sprinkled into a flat two-dimensional causal diamond the mean of ",
 StyleBox["S", "TI"],
 Cell[BoxData[
  SubscriptBox["", "2"]], "InlineFormula",ExpressionUUID->
  "3f853847-1ad4-4e1f-9877-671a88a01522"],
 " is exactly 2 for every ",
 StyleBox["N", "TI"],
 " (Brightwell's theorem, quoted by Benincasa, Dowker and Schmitzer 2011), \
while its standard deviation grows like 2 ",
 StyleBox["N", "TI"],
 ": the unsmeared operator fluctuates, and the mean curvature 2 ",
 StyleBox["S", "TI"],
 " / ",
 StyleBox["N", "TI"],
 " of a flat diamond is 4 / ",
 StyleBox["N", "TI"],
 " in expectation."
}], "Notes",ExpressionUUID->"9a58585f-df53-4eed-9736-f149a8d1ce36"],

