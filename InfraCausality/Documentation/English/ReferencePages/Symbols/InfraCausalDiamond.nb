Cell["Dimension", "ExampleSubsection",ExpressionUUID->"893f6d5d-d3e9-44fd-a781-dbe1e6f3dae0"],

Cell[TextData[{
 "The Benincasa\[Dash]Dowker readings use the two-dimensional layer \
coefficients by default; ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e62b2af-3b7a-4748-9505-20b644a9dd34"],
 " uses the four-dimensional ones. On a chain of ten events the actions are 2 \
",
 StyleBox["N", "TI"],
 " = 20 and (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1) = 6 \[Sqrt]6."
}], "ExampleText",ExpressionUUID->"7e8c084f-4ec8-45ef-a4e2-bece8ee9eb09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",", " ", 
       RowBox[{"DirectedEdges", " ", "->", " ", "True"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\"", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"08e17082-a8a9-4cb7-a560-e4720c768001"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", 
   RowBox[{"6", " ", 
    SqrtBox["6"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"74cf91fb-e8a9-4e6d-a7ac-7b6e7737fdd6"]
}, Open  ]]
