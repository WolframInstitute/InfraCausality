Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalDiamond", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c0e7fada-ac06-4473-8e6b-e54a0bd7fbe4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45ef1610-a580-4219-92d0-de836adc1ead"],
 "\[LineSeparator]",
 "is the causal diamond of the events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every event that lies after ",
 StyleBox["p", "TI"],
 " and before ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c15eb0db-7712-49d6-96e4-2ac4fe1ab760"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2844d37-8f1e-46c5-adc0-fcdbc0053d6e"],
 "\[LineSeparator]",
 "is the causal hull of a set of events: every event that lies after one of \
them and before one of them."
}], "Usage",ExpressionUUID->"c3ca8ca6-c3c4-499b-8ee5-753c876ede46"],

Cell[TextData[{
 "Definition: the causal diamond of two events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " of a directed acyclic graph is [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 "}, the Alexandrov interval of the causal order."
}], "Notes",ExpressionUUID->"476a3336-c379-4326-957c-4e771c70a351"],

Cell[TextData[{
 "It is empty unless ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 ", and it is the single event ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ". It is convex: with two of its events ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["w", "TI"],
 " it contains every event between them. Every causal chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " runs inside it, so it carries the worldlines and the observers between its \
tips, and it is the radar domain of an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"944b9d35-9793-4b8b-af5c-869e6ac37e18"],

Cell[TextData[{
 "The causal hull of a set ",
 StyleBox["S", "TI"],
 " is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the smallest convex set containing ",
 StyleBox["S", "TI"],
 ". The hull of a chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]."
}], "Notes",ExpressionUUID->"285bff08-ba29-486b-9158-788bb8b10acf"],

Cell[TextData[{
 "The head holds its tips and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d981e11-7082-4dc5-a9ab-443ddd5cfd93"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"c62110f8-af89-4935-8415-eaf3036eded8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bd6f054e-b15f-4e19-8cac-6169ea93db01"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"927c57c5-4e08-40f5-bb98-356ce1c59a0c"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"bbfe6ed3-a0a0-4b27-93f3-594dcb78b527"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d984de47-dd5f-40d4-ae7b-0783d0eae652"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "87e99c5c-302c-4aa2-9218-06fe05d26603"]], "TableText",ExpressionUUID->
     "cbe152e2-90bd-4780-bec3-67c6286bf1ff"], Cell[
    "1 on every event of the diamond, keys sorted", "TableText",
     ExpressionUUID->"1ae37dfa-0bcb-48cc-980f-6c0c3f26c890"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2611668c-ff89-41d2-a816-7c7dde09c5ab"], Cell[TextData[Cell[
