Cell[TextData[{
 "The Benincasa\[Dash]Dowker readings use the two-dimensional layer \
coefficients by default; ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea0123f4-5138-4cd4-a839-8f1b3907f73c"],
 " uses the four-dimensional ones. On a chain of ten events the actions are 2 \
",
 StyleBox["N", "TI"],
 " = 20 and (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1) = 6 \[Sqrt]6."
}], "ExampleText",ExpressionUUID->"f29a046b-d296-4d98-b779-7d5e2fcf58b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",", " ", 
       RowBox[{"DirectedEdges", " ", "->", " ", "True"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\"", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d7d9e7d2-bd3f-43a3-b751-08c7e249414c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", 
   RowBox[{"6", " ", 
    SqrtBox["6"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"54401776-8e12-44ce-953f-a2a1e7dcf1d4"]
}, Open  ]]
