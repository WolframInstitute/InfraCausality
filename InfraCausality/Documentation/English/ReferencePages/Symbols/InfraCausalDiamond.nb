Cell[CellGroupData[{

Cell["Dimension", "ExampleSubsection",ExpressionUUID->"9f8e94fa-539c-48d7-acd5-d951aa88b67b"],

Cell[TextData[{
 "The Benincasa\[Dash]Dowker readings use the two-dimensional layer \
coefficients by default; ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d14c4082-d4be-4504-b4a9-4378bea811e0"],
 " uses the four-dimensional ones. On a chain of ten events the actions are 2 \
",
 StyleBox["N", "TI"],
 " = 20 and (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1) = 6 \[Sqrt]6."
}], "ExampleText",ExpressionUUID->"37c67569-5972-4046-851b-c0153e888324"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",", " ", 
       RowBox[{"DirectedEdges", " ", "->", " ", "True"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\"", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"96a84a6a-b726-4851-8193-380e498c476e"],

