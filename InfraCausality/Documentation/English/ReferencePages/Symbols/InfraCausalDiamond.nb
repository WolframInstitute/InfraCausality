Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", for every pair of events."
}], "ExampleText",ExpressionUUID->"c748dbfa-8281-423d-a74f-9caf14047ee6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalDiamond", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "q", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"34807f7f-2d5d-4f89-85de-b7b67e89c8b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"60218775-cab3-45bb-af39-daa1c55b24d8"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} \[PrecedesSlantEqual] {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is a rectangle of (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"4164f8f0-719b-4e50-97a8-d0af157cfc6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0e953f2c-7dd9-4f3a-ae05-009e9d2f2b1d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f6e6c406-61a0-47a0-a61c-3f654a2833b0"]
}, Open  ]],

Cell["\<\
The diamond is convex: an event between two of its events is one of its \
events.\
\>", "ExampleText",ExpressionUUID->"80e0589e-e7e3-4ffa-969f-80b1be34ab96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCausalDiamond", "[", 
         RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], " ", "|->", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"diamond", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"u", ",", " ", "w"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b069633d-25c7-42ba-b470-3c3ccfdca48c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"801b50d4-bf8c-4ea0-84eb-7d95794183fd"]
}, Open  ]],

Cell[TextData[{
 "The causal hull of every timelike geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond of its tips."
}], "ExampleText",ExpressionUUID->"efde71b0-9ac2-403a-933a-eb034e04af62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraTimelikeGeodesic", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTimelikeGeodesic", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"chain", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", "chain", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9a03ad4e-b0a3-4e6f-91bc-3cde5337de9b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"b571f9d8-147c-47f6-bf44-ade69997de9c"]
}, Open  ]],

Cell["\<\
The discrete curvature is the operator applied to the constant field \
\[Minus]2, and the action is half its total, in both dimensions.\
\>", "ExampleText",ExpressionUUID->"ff672559-b238-41a8-9d2d-13bcfcd9d713"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"dim", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", 
             " ", "\"\<BenincasaDowkerDAlembertian\>\"", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"ricci", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\"", ",",
              " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], 
            "]"}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Values", "[", "ricci", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"B", " ", ".", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "300"}], "]"}]}]}]}], "]"}]}], " ", "===",
           " ", 
          RowBox[{"{", "0", "}"}]}], " ", "&&", "\n", "        ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{
             "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerAction\>\"", ",",
               " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}], 
            " ", "-", " ", 
            RowBox[{
             RowBox[{"Total", "[", "ricci", "]"}], "/", "2"}]}], "]"}], " ", "===",
           " ", "0"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f9c63fc1-f744-4d1a-aad2-44f3243f2f9a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"e0698d31-f347-4066-848b-7943fb61b742"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer dimension inverts the exact ordering fractions: 1/2 \
gives 2, 8/35 gives 3, 1/10 gives 4.\
\>", "ExampleText",ExpressionUUID->"6e6b8bef-eae7-49f3-a03c-1f42627a9278"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"star", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "3"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"sparse", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"8", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"9", " ", "->", " ", "10"}]}], "}"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"lone", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<OrderingFraction\>\"", ",", 
         " ", "\"\<MyrheimMeyerDimension\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"star", ",", " ", "sparse", ",", " ", "lone"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"e48a18c6-e356-4b0f-99f8-6597ef953a10"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "2.`"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["8", "35"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", 
      "2.999999999999999`"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "10"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "4.`"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"1ffc04ac-a2d4-4b95-b317-6030e20cb9db"]
}, Open  ]]
}, Open  ]],

