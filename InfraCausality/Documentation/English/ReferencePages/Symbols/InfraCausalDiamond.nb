Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", for every pair of events."
}], "ExampleText",ExpressionUUID->"423e3214-6c12-4850-b2ce-55f623c88e75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], " ", "===", 
          " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "q"}], "]"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a3ef8e2-16be-47c1-90db-06150835fb53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"083658c9-905d-45bb-89f8-00d63804231b"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} \[PrecedesSlantEqual] {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is a rectangle of (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"400e64fb-9cd3-4bd2-a445-988135fc8604"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"18bd2d60-5be6-44eb-83b7-fa964e93e315"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a7ebc7b8-95f6-4255-9863-3a39930e041f"]
}, Open  ]],

Cell["\<\
The diamond is convex: an event between two of its events is one of its \
events.\
\>", "ExampleText",ExpressionUUID->"c850ed6e-01da-43fd-a2aa-5cf02124fcf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "w"}], "}"}], " ", "|->", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"diamond", ",", " ", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "u", ",", " ", "w"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a5940577-d9da-4926-b574-80b7fafee848"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"59252d93-cc43-4dec-910f-288344d83add"]
}, Open  ]],

Cell[TextData[{
 "The causal hull of every worldline from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond of its tips."
}], "ExampleText",ExpressionUUID->"19490199-790e-413c-af72-fc48db23f8bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "0", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraWorldline", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraWorldline", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"chain", " ", "|->", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalDiamond", "[", "chain", "]"}]}], "]"}], " ", "===",
        " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"903c0c62-b1ae-4bb4-8fa7-414835bb26d2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"70e4f6c8-0726-40c1-9be1-5d77c1d27c9a"]
}, Open  ]],

Cell["\<\
The discrete curvature is the operator applied to the constant field \
\[Minus]2, and the action is half its total, in both dimensions.\
\>", "ExampleText",ExpressionUUID->"418d9901-c2d6-4ac8-9ea1-34155a39b2cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"RandomCausalGraph", "[", 
      RowBox[{"300", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"dim", " ", "|->", "\n", "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", 
             " ", "\"\<BenincasaDowkerDAlembertian\>\"", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"ricci", " ", "=", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
            "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\"", ",",
              " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], 
            "]"}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Values", "[", "ricci", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"B", " ", ".", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "300"}], "]"}]}]}]}], "]"}]}], " ", "===",
           " ", 
          RowBox[{"{", "0", "}"}]}], " ", "&&", "\n", "        ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{
             "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerAction\>\"", ",",
               " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "dim"}]}], "]"}], 
            " ", "-", " ", 
            RowBox[{
             RowBox[{"Total", "[", "ricci", "]"}], "/", "2"}]}], "]"}], " ", "===",
           " ", "0"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f8637c3c-c684-481e-90d3-8b4d3d502097"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"7ad2fc0d-a43b-4256-8dab-8fb5022242b6"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer dimension inverts the exact ordering fractions: 1/2 \
gives 2, 8/35 gives 3, 1/10 gives 4.\
\>", "ExampleText",ExpressionUUID->"2e691d3d-e44c-4f5f-96f3-fb98cc8135e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"star", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"0", " ", "->", " ", "3"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"sparse", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"8", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"9", " ", "->", " ", "10"}]}], "}"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"lone", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<OrderingFraction\>\"", ",", 
         " ", "\"\<MyrheimMeyerDimension\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"star", ",", " ", "sparse", ",", " ", "lone"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"54edaf2b-2834-45f7-b250-a3ea00d0ed72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "2.`"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["8", "35"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", 
      "2.999999999999999`"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"OrderingFraction\"\>", "\[Rule]", 
      FractionBox["1", "10"]}], ",", 
     RowBox[{"\<\"MyrheimMeyerDimension\"\>", "\[Rule]", "4.`"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"43585cbe-ab82-4ddc-ad29-371330460f54"]
}, Open  ]]
}, Open  ]],

