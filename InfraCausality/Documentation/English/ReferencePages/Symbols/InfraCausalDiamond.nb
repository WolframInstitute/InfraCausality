Cell["\<\
The diamond is the overlap of the causal future of its lower tip and the \
causal past of its upper tip.\
\>", "ExampleText",ExpressionUUID->"d191bb19-741b-439c-9435-63ebdb8918a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
          RowBox[{"InfraCausalPast", "[", "q", "]"}]}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5aac3e0d-11e2-42e9-adce-a35f240d6115"],

