Cell[CellGroupData[{

Cell["Dimension", "ExampleSubsection",ExpressionUUID->"4518641e-0fbe-4f8f-8769-102e8a85256b"],

Cell[TextData[{
 "The Benincasa\[Dash]Dowker readings use the two-dimensional layer \
coefficients by default; ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dab93575-f0b5-4da7-b85b-d247eb349781"],
 " uses the four-dimensional ones. On a chain of ten events the actions are 2 \
",
 StyleBox["N", "TI"],
 " = 20 and (4/\[Sqrt]6)(",
 StyleBox["N", "TI"],
 " \[Minus] 1) = 6 \[Sqrt]6."
}], "ExampleText",ExpressionUUID->"7b8a8af0-0121-4012-9ce4-174305e27f6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",", " ", 
       RowBox[{"DirectedEdges", " ", "->", " ", "True"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{"1", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<BenincasaDowkerAction\>\"", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "4"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4aefb0c3-3f28-4748-a4a1-0631607772f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", 
   RowBox[{"6", " ", 
    SqrtBox["6"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b347bdee-75e0-4f0b-907a-fd85b4ce44d1"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

