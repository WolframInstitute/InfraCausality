Cell["\<\
The interval volume of the diamonds from the bottom event of the diamond \
lattice to every event of the slice at height 6.\
\>", "ExampleText",ExpressionUUID->"cef0205e-fb68-4a59-9763-282b74f34281"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "6", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"d370482d-dc58-43e6-ab69-f7872231dcd3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "7", ",", "12", ",", "15", ",", "16", ",", "15", ",", "12", ",", "7"}], 
  "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0625827c-e8f4-4406-91ba-2006ecc64d88"]
}, Open  ]]
}, Open  ]],

