Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalDiamond", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94cc7bdb-d62b-4820-a8e0-ba3df0a26013"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d4c469c-b8fc-4d8b-8c7c-74cc32457bc2"],
 "\[LineSeparator]",
 "is the causal diamond of the events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every event that lies after ",
 StyleBox["p", "TI"],
 " and before ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"90da68d4-66af-4962-9e65-94e42e64619d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf3a31d6-5589-4f7f-b156-fc5164dcb9b8"],
 "\[LineSeparator]",
 "is the causal hull of a set of events: every event that lies after one of \
them and before one of them."
}], "Usage",ExpressionUUID->"d2da6ed9-d342-4cc7-8828-acd8a2c7947f"],

Cell[TextData[{
 "Definition: the causal diamond of two events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " of a directed acyclic graph is [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 "}, the Alexandrov interval of the causal order."
}], "Notes",ExpressionUUID->"bc233fce-6fa4-44ca-9800-2ed0eb008fc0"],

Cell[TextData[{
 "It is empty unless ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 ", and it is the single event ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ". It is convex: with two of its events ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["w", "TI"],
 " it contains every event between them. Every causal chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " runs inside it, so it carries the worldlines and the observers between its \
tips, and it is the radar domain of an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"b5db8b17-c36d-4d88-ada0-9a5b4a9d7b81"],

Cell[TextData[{
 "The causal hull of a set ",
 StyleBox["S", "TI"],
 " is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the smallest convex set containing ",
 StyleBox["S", "TI"],
 ". The hull of a chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]."
}], "Notes",ExpressionUUID->"454c459c-fb36-4cf5-9c46-d8d19b27db54"],

Cell[TextData[{
 "The head holds its tips and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "53973531-7a68-4226-9651-37476e008ffd"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"24e44c29-3a4e-4db1-90bf-acb24e1c45c0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f1cd13e3-0b11-4f2f-b8b0-86ac337da664"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"531c225e-f417-41e4-9dfe-cf469f977742"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"a52d4656-73a7-4eaa-8d3d-967f2bb3c393"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8b77a0d7-afa2-4673-8e6b-4e3dcf62e673"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fbbb4380-4bad-44aa-95d5-2d82da609ae4"]], "TableText",ExpressionUUID->
     "51b00f7a-c010-4c67-919f-6a566eaea0a2"], Cell[
    "1 on every event of the diamond, keys sorted", "TableText",
     ExpressionUUID->"54194a42-18f7-4bf6-a0fe-4e24588fbf2b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3deee4b5-a8e4-456f-93fb-9ffcc2d0885f"], Cell[TextData[Cell[
