       "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerDAlembertian\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\""}], 
