Cell["\<\
The interval volume of the diamonds from the bottom event of the diamond \
lattice to every event of the slice at height 6.\
\>", "ExampleText",ExpressionUUID->"d643e62b-f873-4821-addb-d56ca793c5fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCausalDiamond", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"RandomInfraSlice", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"43a9234a-bb1b-44f7-8f29-9da5f7a16e9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "7", ",", "12", ",", "15", ",", "16", ",", "15", ",", "12", ",", "7"}], 
  "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"c389e137-32f4-4250-a220-81f795fa5a6a"]
}, Open  ]]
}, Open  ]],

