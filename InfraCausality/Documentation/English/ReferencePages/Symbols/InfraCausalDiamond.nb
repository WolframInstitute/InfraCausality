     "d69c4189-aa83-4b78-adc3-22525a21789e"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "83ba9a7e-858b-451f-ac20-b3fe10351b7f"]], "TableText",ExpressionUUID->
     "624b4e17-a020-4a81-a52f-1d6765f7f7a7"], Cell[
    "1 on every event of the diamond, keys sorted", "TableText",
     ExpressionUUID->"44ad78ea-33c8-42bb-bff8-da6dd8cf7606"]},
