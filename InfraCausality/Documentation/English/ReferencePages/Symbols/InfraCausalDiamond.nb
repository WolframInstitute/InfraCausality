Notebook[{

Cell[CellGroupData[{
Cell["InfraCausalDiamond", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"86928543-d0a6-4039-a0c9-07ec089007c7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79ffa592-a20e-4f97-b5e4-1c4bd3b8c802"],
 "\[LineSeparator]",
 "is the causal diamond of the events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every event that lies after ",
 StyleBox["p", "TI"],
 " and before ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c9f56c21-e4d4-4d2b-8bf4-927c1888ae5c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0baa5bab-0415-451b-a458-a66966b85db6"],
 "\[LineSeparator]",
 "is the causal hull of a set of events: every event that lies after one of \
them and before one of them."
}], "Usage",ExpressionUUID->"d4a34802-f89f-4621-9752-cb5d09e17983"],

Cell[TextData[{
 "Definition: the causal diamond of two events ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " of a directed acyclic graph is [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 "}, the Alexandrov interval of the causal order."
}], "Notes",ExpressionUUID->"083b8f13-69c9-4685-95ba-de91c71a2647"],

Cell[TextData[{
 "It is empty unless ",
 StyleBox["p", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["q", "TI"],
 ", and it is the single event ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ". It is convex: with two of its events ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["w", "TI"],
 " it contains every event between them. Every causal chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " runs inside it, so it carries the worldlines and the observers between its \
tips, and it is the radar domain of an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"19ec34cd-31ce-431b-a215-ea48952f95bd"],

Cell[TextData[{
 "The causal hull of a set ",
 StyleBox["S", "TI"],
 " is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the smallest convex set containing ",
 StyleBox["S", "TI"],
 ". The hull of a chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]."
}], "Notes",ExpressionUUID->"e600d9c4-ccf6-46b7-a81c-f047668d5520"],

Cell[TextData[{
 "The head holds its tips and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e8de05ab-26b3-41fb-bddf-143bb683698d"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"3a4f0699-3471-4542-9347-378ca0b27307"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "604e8351-441a-4aa1-99ac-8f976e6d7de3"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"b4012233-c24c-4568-bf54-2a611c427421"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"c89d8c21-c953-4957-be57-f28cd711970c"]},
