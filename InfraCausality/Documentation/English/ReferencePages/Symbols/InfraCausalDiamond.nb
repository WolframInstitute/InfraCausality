Cell["\<\
The Benincasa\[Dash]Dowker operator of the 2 \[Times] 2 diamond: \[Minus]2 on \
the diagonal, 4 on each link below the diagonal in the sorted event order, \
and the discrete curvature it assigns to each event.\
\>", "ExampleText",ExpressionUUID->"59868d7f-c07d-4147-a86e-6956cd987b68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
       "g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerDAlembertian\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "d", ",", " ", "\"\<BenincasaDowkerRicci\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"5ca400e4-fb45-49a6-a205-56e354e86ec1"],

