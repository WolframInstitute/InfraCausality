Cell[TextData[{
 "A member is a vertex list in causal order; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraObserver"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraObserver", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8cd806f2-6ec5-40bc-99f4-4ebd179142f7"],
 " draws members uniformly, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d6bdc10-0a20-447a-a364-8dbb5a980b16"],
 " recognises one. Observers are the clocks of the Infra Observers guide: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99a75ac5-8db9-4e5a-a6c0-c50e497a72f4"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af494a28-aa9d-4c53-bcad-1a6cf623268f"],
 " take them as arguments."
}], "Notes",ExpressionUUID->"a604d8b2-ecf8-47d5-a557-3a49d2fe979a"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"ef955b7b-756d-4da6-bf72-73f9ca038ee1"],

