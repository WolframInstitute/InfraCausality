Cell["\<\
On the sprinkling the observers between two events carry clocks of different \
lengths: the shortest observer beside a worldline.\
\>", "ExampleText",ExpressionUUID->"ef79c5e8-dc95-4f30-ba45-b67d0459cc7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraObserver", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraObserver", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraWalk", "[", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{"members", ",", " ", "Length"}], "]"}]}], "]"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraWalk", "[", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"MaximalBy", "[", 
            RowBox[{"members", ",", " ", "Length"}], "]"}]}], "]"}], "}"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c7a8821d-6b82-4b9f-88e2-8a6b80d1edf6"],

