Cell[TextData[{
 "Every member passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98bbb142-ac63-4653-a9cc-5f3594d6ec2e"],
 ", the cardinality is the number of members, and every worldline is an \
observer."
}], "ExampleText",ExpressionUUID->"8416e820-96a7-488d-8adf-ca19514c5ed7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"members", " ", "=", " ", 
       RowBox[{"RandomInfraObserver", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraObserverQ", "[", 
       RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", "\n", "      ", 
      RowBox[{
       RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
      RowBox[{"SubsetQ", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1e84c509-142b-4b9a-8846-c0e2abad1779"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"629ee69b-7105-486d-bb4e-e629a82f7729"]
}, Open  ]],

Cell[TextData[{
 "Dropping an inner tick leaves a chain that is no longer saturated: it \
passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraChainQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraChainQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a33e0ef2-db73-46dd-879c-6b7181dad30a"],
 " and fails ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aca59278-27b8-4fd2-b8d6-d04bd396055a"],
 "."
}], "ExampleText",ExpressionUUID->"34a24b41-9af4-411e-98ab-dcc58edef47f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chain", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraObserver", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Delete", "[", 
        RowBox[{"chain", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"InfraObserverQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Delete", "[", 
        RowBox[{"chain", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6a21b7e6-5c5b-49d6-b88d-dbbac2a49630"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e9b79701-f412-4b23-ab74-e7ad78d61e66"]
}, Open  ]],

Cell["\<\
The observers between two events all run inside their causal diamond.\
\>", "ExampleText",ExpressionUUID->"e3260372-b680-4a27-b302-e79a526d0441"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SubsetQ", "[", 
    RowBox[{
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], ",", " ", 
     RowBox[{"Union", " ", "@@", " ", 
      RowBox[{"RandomInfraObserver", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraObserver", "[", 
         RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"77564c27-d2a7-4fd1-9471-8bb3d95742da"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"6bd0221c-5fdf-4095-8446-210908daa605"]
