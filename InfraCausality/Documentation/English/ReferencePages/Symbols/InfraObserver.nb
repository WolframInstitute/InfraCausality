Notebook[{

Cell[CellGroupData[{
Cell["InfraObserver", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1aa4a92c-2747-4942-97f4-71bd1a76217c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserver"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserver", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "deeed0cf-5312-4d5e-a309-a62dc0f45bf8"],
 "\[LineSeparator]",
 "is the family of observers from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every saturated chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c94b6ba5-0fbc-4284-b50b-5f2dad8884b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserver"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserver", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42a491ed-be54-4ee8-8b50-ceff6376f07b"],
 "\[LineSeparator]",
 "is the family of inextendible saturated chains of the whole graph, each \
from a source to a sink."
}], "Usage",ExpressionUUID->"f973f640-bd46-452e-a827-22bcdca0e95e"],

Cell[TextData[{
 "Definition: an observer from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a saturated chain ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] ",
 StyleBox["e", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ": each pair of consecutive events is a covering pair, an edge of the Hasse \
diagram, so no event lies strictly between them."
}], "Notes",ExpressionUUID->"92bcb75e-67e4-4ce7-8a56-6b169a0ddbed"],

Cell[TextData[{
 "An observer is the discrete analogue of a timelike curve with a clock: its \
events are the ticks, and their positions along the chain are the readings of \
the clock. A saturated chain skips no event it could have passed through, so \
the clock ticks at every event on the way. Observers between the same two \
events need not have the same number of ticks; the longest ones are the \
worldlines of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2409e11-138b-4f7a-bf0d-534a15e002ff"],
 ", the timelike geodesics."
}], "Notes",ExpressionUUID->"fb6c9b77-e6a9-40a1-9adf-26440c463aba"],

Cell[TextData[{
 "The head holds its two events and computes nothing. Its graph, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["o", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2818c1a-f7e3-4ef0-b612-1e36e6401e98"],
 ", is the Hasse diagram of the graph restricted to the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]. Its paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " are exactly the saturated chains, each once, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19f086a8-b4b3-4828-9311-12362e5db8a2"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a569b600-3321-41ee-aefa-8f50c729c540"],
 ", and every count is read off that graph by dynamic programming."
}], "Notes",ExpressionUUID->"bcb0e90e-e284-4e30-a266-f783e135ab3b"],

