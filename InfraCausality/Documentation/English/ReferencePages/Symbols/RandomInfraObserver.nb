Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19926e14-6522-47b0-8eeb-fb76dec9d014"],
 " gives ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c47d400e-7a5f-445e-a5bb-d404ddee49cc"],
 " distinct members, each passing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5441632-b408-4dec-8cb3-f630f6af977e"],
 ", and the worldlines between the same events are among them."
}], "ExampleText",ExpressionUUID->"f9e64c06-939d-457b-bfad-159faa41be98"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraObserver", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraObserver", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraObserver", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"InfraObserverQ", "[", 
        RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"members", ",", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"770f6d9d-4d5c-470d-acf4-078fbdd98aeb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7b3aa11a-398a-4525-a388-961dbbced17b"]
}, Open  ]],

Cell[TextData[{
 "The distinct numbers of edges of the members are the ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0a44cfd-c113-4be3-b4c9-54365faeb935"],
 " reading of the head."
}], "ExampleText",ExpressionUUID->"b97b55f1-2be1-4d09-9d10-5f74e3c41f61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"Length", " ", "/@", " ", 
            RowBox[{"RandomInfraObserver", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraObserver", "[", 
               RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], 
             "]"}]}], " ", "-", " ", "1"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "one_", "}"}], " ", ":>", " ", "one"}]}], "]"}], " ", "===",
        "\n", "      ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Length\>\""}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2cfd8349-f43b-4032-b715-4d432fc6d96f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3fb9e7a8-a46d-47a1-a78c-cff138a8b868"]
}, Open  ]],

Cell["\<\
The default draw is uniform over observers: over 1500 draws each of the \
observers from {0, 0} to {1, 2} of the cylinder lattice appears with \
frequency within 0.05 of 1/2.\
\>", "ExampleText",ExpressionUUID->"6c59f689-a1d6-4939-ae09-aa25582d03ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1500"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], "]"}], " ", "===", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraObserver", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}]}], 
    " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#", "/", "1500"}], " ", "-", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}], " ", "<", " ", "0.05"}], " ", 
       "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e99981ce-b862-409c-aec0-6b15d6bf6f82"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"225e8d71-66db-4421-9e16-ed3e3b4a0713"]
}, Open  ]],

Cell["\<\
The inextendible observers run from a source to a sink, and each one is an \
observer between its own two ends.\
\>", "ExampleText",ExpressionUUID->"8383a920-31b7-4f48-a720-23e8ed9984a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraObserver", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"VertexInDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"VertexOutDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}], " ", "&&", "\n", "        ", 
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraObserver", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "member"}], ",", " ", 
              RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], ",", " ", 
            "member"}], "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2522843d-ce4c-47e1-8c6a-9e5929a75f12"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"6134e81e-0cc4-42d0-986c-21a4c4b8bdbd"]
}, Open  ]]
}, Open  ]],

