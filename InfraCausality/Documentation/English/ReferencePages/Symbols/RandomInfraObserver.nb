Cell[TextData[{
 "Definition: the members of an observer head are its saturated chains, the \
paths from source to sink of ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["o", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "4944ecf5-a87f-4a9d-b975-7a29cc89710a"],
 ", the Hasse diagram on the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "]. A member is a vertex list in causal order whose consecutive events are \
covering pairs; its positions are the ticks of the observer's clock. For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraObserver"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraObserver", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5499d5a8-79ed-44ab-b4e9-53d8582aa258"],
 " the members are the saturated chains from a source of the graph to a sink, \
the observers that cannot be extended at either end."
}], "Notes",ExpressionUUID->"8a2fd2e9-e007-4126-b509-c7b74ce505dc"],

Cell[TextData[{
 "The default draw is uniform over the members: each next event is chosen \
with probability proportional to the number of members through it, counted \
once by dynamic programming. Observers between the same events can have \
different numbers of ticks, and the draw is uniform over observers, not over \
lengths. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7af1304-0d96-459e-9d5b-46b4c3bf3cb9"],
 " to reproduce a draw."
}], "Notes",ExpressionUUID->"353fa5ea-b9c8-494c-83be-f5948f12c48a"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32f71ac3-24ab-4a2c-a656-fe292fb93c23"],
 " sampler shares:"
}], "Notes",ExpressionUUID->"0e165a8c-1d7b-4894-a31b-7023ac566021"],

