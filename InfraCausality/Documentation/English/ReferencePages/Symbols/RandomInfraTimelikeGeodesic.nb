 "."
}], "ExampleText",ExpressionUUID->"1862dafc-aeab-4a76-aad7-14a0011805b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraTimelikeGeodesic", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraTimelikeGeodesic", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Length\>\""}], "]"}], " ", "+", " ", "1"}], "}"}]}], 
       " ", "&&", "\n", "      ", 
       RowBox[{"InfraTimelikeGeodesicQ", "[", 
        RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"members", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraTimelikeGeodesic", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "#"}], "]"}], " ",
           "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"168f8ea9-873e-4cfe-a253-8af2dcc2b336"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e4f734c0-667a-4842-851c-70071636aed5"]
}, Open  ]],

Cell["\<\
The default draw is uniform: over 1500 draws each of the three timelike \
geodesics from {0, 0} to {1, 2} of the diamond lattice appears with frequency \
within 0.05 of 1/3.\
\>", "ExampleText",ExpressionUUID->"e6d70eb6-1b0d-4527-9b4f-d3fae95f8cf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1500"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], "]"}], " ", "===", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraTimelikeGeodesic", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}]}], 
    " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#", "/", "1500"}], " ", "-", " ", 
          RowBox[{"1", "/", "3"}]}], "]"}], " ", "<", " ", "0.05"}], " ", 
       "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f179284b-1985-4c97-90c4-9fb1609a91a9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"77087afb-300c-49cd-94b3-ea2343c621d6"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cc521ba-9fd3-4779-b802-e3d5122eb8d9"],
 " takes the members in sorted order, and the same seed gives the same draw."
}], "ExampleText",ExpressionUUID->"90f0c7ff-3eca-4e30-a824-ef63e5dbe00b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"3", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraTimelikeGeodesic", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Cardinality\>\""}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInfraTimelikeGeodesic", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n", ",", " ", 
          
          RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
           "Identity"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"RandomInfraTimelikeGeodesic", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}],
           ",", " ", "n"}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraTimelikeGeodesic", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}], " ", "===", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraTimelikeGeodesic", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"64b14656-01b3-478b-82bc-8e9ad5038f91"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fed12a51-bc93-4174-9e3b-31c7f255bae9"]
}, Open  ]],

Cell["\<\
Every timelike geodesic lies in the causal diamond of its endpoints, and the \
longest chains of the whole graph run from a source to a sink.\
\>", "ExampleText",ExpressionUUID->"3053b64f-d39f-4b05-bd0c-1460b8f78f1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalDiamond", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", "member"}], ",", " ", 
                 RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "member"}], 
           "]"}], " ", "&&", "\n", "        ", 
          RowBox[{
           RowBox[{"VertexInDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"VertexOutDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b86e1c35-8884-48e2-94be-5a6ee717a95f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"deb34090-8ec1-4249-9ced-4da579b272ae"]
}, Open  ]]
}, Open  ]],

