Cell[TextData[{
 "Definition: the members of a timelike-geodesic head are its longest chains, \
the paths from source to sink of ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["geo", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1234fa0e-c864-4cb9-9680-3ba5158747f2"],
 ". A member is a vertex list ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " = ",
 StyleBox["q", "TI"],
 " in causal order, with ",
 StyleBox["k", "TI"],
 " = \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "). The same sampler draws every form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTimelikeGeodesic"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "caa3bab5-82b0-43bb-ae9d-5177f5e0180a"],
 ": the two-event form, the whole-graph form, and the experimental polyline \
and from-event forms."
}], "Notes",ExpressionUUID->"710212d6-6fa5-45c2-b01a-abff052b2940"],

Cell[TextData[{
 "The default draw is uniform over the members. It descends the graph of the \
head from a source, choosing each next event with probability proportional to \
the number of members through it, which dynamic programming counts once; so \
each member is drawn with probability 1/",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a77aa01-976b-4f34-9c86-ad275b73f976"],
 ". Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3f06fb7-9169-469a-a91c-2c25715a9246"],
 " to reproduce a draw."
}], "Notes",ExpressionUUID->"69adac62-8524-4995-a759-8bf1be511394"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ffbb6a2-bf82-49fc-a32c-3db61f763d97"],
 " sampler shares:"
}], "Notes",ExpressionUUID->"18580a2f-aaa3-4e4a-b9db-225d68d3e6ba"],

