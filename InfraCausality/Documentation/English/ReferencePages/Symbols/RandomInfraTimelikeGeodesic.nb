Cell[TextData[{
 "There are three timelike geodesics from {0, 0} to {1, 2}, so a strict count \
of 4 gives the empty list and ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "4", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42976d6d-ffe1-4390-ab76-e12e96330491"],
 " gives all three."
}], "ExampleText",ExpressionUUID->"2f98c16b-7703-434d-9882-147ac92e95ed"],

