Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4efd4c1-c932-4a95-907e-76b663ef2033"],
 " gives ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10521220-008a-4d0f-9c5d-7677bbd428e5"],
 " distinct members, each a chain of \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") + 1 events that passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTimelikeGeodesicQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesicQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
