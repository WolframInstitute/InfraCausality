Cell[TextData[{
 "Alice's arc lengths grow by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab3a4e75-2215-4034-a871-926f29da36bf"],
 " per round trip, at every light angle."
}], "ExampleText",ExpressionUUID->"2f1d6ddc-2528-4b69-8d25-05b8adbc2718"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"arcs", " ", "=", " ", 
         RowBox[{"Lookup", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"LightZigzag", "[", 
              RowBox[{"v", ",", " ", "1", ",", " ", "8", ",", " ", "phi"}], 
              "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
               " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
           " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"Ratios", "[", "arcs", "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], " ", "===",
         " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"76eede79-b665-442b-9d5e-f57e68637bf5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"df0298c7-c8e4-4db7-8592-50d242f8da11"]
}, Open  ]],

Cell["\<\
The events alternate between the observers and lie at their arc lengths from \
the origin.\
\>", "ExampleText",ExpressionUUID->"e338b5aa-aa39-4d6c-965a-42d9f82882ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{"events", ",", " ", "\"\<Observer\>\""}], "]"}], " ", "===", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\""}], "}"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}], " ", ".", " ", 
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"#", "[", "\"\<ArcLength\>\"", "]"}], "^", "2"}]}], ")"}], 
        " ", "&"}], " ", "/@", " ", "events"}], "]"}], " ", "===", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"15a95923-a709-4448-9c36-3340826c7b62"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"df123e15-a362-40e4-a229-ea79f24fbe4d"]
}, Open  ]],

Cell["\<\
Each reflection on the moving worldline has its radar emission and return at \
the neighbouring events of the zigzag.\
\>", "ExampleText",ExpressionUUID->"a27dbcf7-dbab-44ba-9448-20930bb90974"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", "6", ",", " ", 
       RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"BondiRadarCoordinates", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"events", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Point\>\"", "]"}], ",",
              " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}]}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2437fa7f-f10a-4d45-866e-5608a051b3a1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"00cefbbe-2491-4ef1-8f3e-2d6df89b2300"]
}, Open  ]]
}, Open  ]],

