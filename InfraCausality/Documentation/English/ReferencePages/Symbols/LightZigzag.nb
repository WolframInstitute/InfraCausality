Cell[BoxData[
 RowBox[{
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"LightZigzag", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "4"}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Observer\>\"", ",", " ", "\"\<ArcLength\>\""}], "}"}]}], 
