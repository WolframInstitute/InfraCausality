Cell[TextData[{
 "Alice's arc lengths grow by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0453545-f869-4b21-837c-e9257dc5fb31"],
 " per round trip, at every light angle."
}], "ExampleText",ExpressionUUID->"6cadb437-8dcc-48a8-8e30-a8af7b546ae5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"arcs", " ", "=", " ", 
         RowBox[{"Lookup", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"LightZigzag", "[", 
              RowBox[{"v", ",", " ", "1", ",", " ", "8", ",", " ", "phi"}], 
              "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
               " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
           " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"Ratios", "[", "arcs", "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], " ", "===",
         " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a83770c7-6292-4453-9442-a09cf46f1802"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a72f0d00-b2c4-4ffa-879b-e0c847684949"]
}, Open  ]],

Cell["\<\
The events alternate between the observers and lie at their arc lengths from \
the origin.\
\>", "ExampleText",ExpressionUUID->"0c4cfe94-2209-49fc-9468-aa0837257030"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{"events", ",", " ", "\"\<Observer\>\""}], "]"}], " ", "===", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\""}], "}"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}], " ", ".", " ", 
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"#", "[", "\"\<ArcLength\>\"", "]"}], "^", "2"}]}], ")"}], 
        " ", "&"}], " ", "/@", " ", "events"}], "]"}], " ", "===", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"68cc7673-fda3-4c1a-b3c7-d88a3534da23"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e5416231-a660-4a85-9329-08afdda3930a"]
}, Open  ]],

Cell["\<\
Each reflection on the moving worldline has its radar emission and return at \
the neighbouring events of the zigzag.\
\>", "ExampleText",ExpressionUUID->"ccc5efc8-bb0b-451e-adcf-92feea4ff02b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", "6", ",", " ", 
       RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"BondiRadarCoordinates", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"events", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Point\>\"", "]"}], ",",
              " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}]}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3a4fb5b0-6717-4b8b-be8c-c03373c42c84"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a6aecc18-4dfd-48fc-8c3e-e8bc2b724788"]
}, Open  ]]
}, Open  ]],

