Cell[TextData[{
 "The arc length grows by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bca36c45-95df-4412-875c-c8c048dbf2ad"],
 " on the way out and by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61ec5211-4b72-45c5-b7a0-82d192e98234"],
 " on the way back, so Alice's arc lengths grow geometrically by the \
round-trip factor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbe440ac-7d99-4c67-8bea-29a989b3b96a"],
 ". The bounce count up to arc length ",
 StyleBox["s", "TI"],
 " is therefore ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3fabe24-7778-4a2c-b7d6-246fc956928c"],
 ", logarithmic in ",
 StyleBox["s", "TI"],
 ", while the proper time (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "247ab351-cec6-4a93-8c9a-575c7e12526f"],
 ") is linear in it. Every reflection on Bob's worldline is the radar event \
of the emission before it and the return after it."
}], "Notes",ExpressionUUID->"c8f9c8ba-54c4-46bc-9fca-f82d04eff163"]
}, Open  ]],

