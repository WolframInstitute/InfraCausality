Cell[TextData[{
 "Alice's arc lengths grow by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c865a3f-dce1-4693-a4bd-a03264a45c1b"],
 " per round trip, at every light angle."
}], "ExampleText",ExpressionUUID->"f38c4f06-5da0-4bbf-8cd2-8516f9dc3d3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"arcs", " ", "=", " ", 
         RowBox[{"Lookup", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"LightZigzag", "[", 
              RowBox[{"v", ",", " ", "1", ",", " ", "8", ",", " ", "phi"}], 
              "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
               " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
           " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"Ratios", "[", "arcs", "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], " ", "===",
         " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c25bd50-fddc-474e-b27f-96463dfe2c1d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e50caa62-bcd9-40fc-94c8-03b0a6261023"]
}, Open  ]],

Cell["\<\
The events alternate between the observers and lie at their arc lengths from \
the origin.\
\>", "ExampleText",ExpressionUUID->"ab5d7142-9b79-46f9-b771-417458c49980"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{"events", ",", " ", "\"\<Observer\>\""}], "]"}], " ", "===", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\""}], "}"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}], " ", ".", " ", 
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"#", "[", "\"\<ArcLength\>\"", "]"}], "^", "2"}]}], ")"}], 
        " ", "&"}], " ", "/@", " ", "events"}], "]"}], " ", "===", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fd3414ac-52e9-4409-b4e3-c221e1d59286"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2e8acbd3-0bad-4e32-9d25-8e7c7b7742fa"]
}, Open  ]],

Cell["\<\
Each reflection on the moving worldline has its radar emission and return at \
the neighbouring events of the zigzag.\
\>", "ExampleText",ExpressionUUID->"387a2534-12fd-49c6-a68d-c8e0a181fb86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", "6", ",", " ", 
       RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"BondiRadarCoordinates", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"events", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Point\>\"", "]"}], ",",
              " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}]}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3a107b5f-3ba9-4c90-9ea3-cb5713940a80"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"97809884-3be6-44c0-926e-49337ad9f548"]
}, Open  ]]
}, Open  ]],

