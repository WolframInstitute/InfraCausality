Cell[TextData[{
 "The arc length grows by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfcbbf80-ed79-4828-86a8-35cc545ca6e2"],
 " on the way out and by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96a1c885-0c87-4ff9-aaae-beffc9bca20b"],
 " on the way back, so Alice's arc lengths grow geometrically by the \
round-trip factor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "740f585f-ad52-487d-bd1a-70f90eba30ae"],
 ". The bounce count up to arc length ",
 StyleBox["s", "TI"],
 " is therefore ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160c3645-9a00-4575-b2df-602db9f3d078"],
 ", logarithmic in ",
 StyleBox["s", "TI"],
 ", while the proper time (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f0a7cb3-42d5-494d-8b34-83bd276e57be"],
 ") is linear in it. Every reflection on Bob's worldline is the radar event \
of the emission before it and the return after it."
}], "Notes",ExpressionUUID->"f150a2d8-cd3c-460e-9b83-0fd708f01ec6"]
}, Open  ]],

