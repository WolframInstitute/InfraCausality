Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     SqrtBox[
      FractionBox["17", "2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     RowBox[{"2", " ", 
      SqrtBox["34"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"543e8115-f66b-413b-b7b4-e2e19ba8269f"]
}, Open  ]],

Cell["\<\
The zigzag of velocity 3/5 at the light angle \[Pi]/3, drawn from its points.\
\
\>", "ExampleText",ExpressionUUID->"a9f9fc09-0e49-4e1d-bd97-79072566a0df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"LightZigzag", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"1", "/", "10"}], ",", " ", "6", ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", "\"\<Point\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"StandardBlue", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"1.1", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
             "}"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardRed", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"1.1", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Norm", " ", "/@", " ", "points"}], "]"}], " ", 
             RowBox[{"WorldlineDirection", "[", 
              RowBox[{
               RowBox[{"3", "/", "5"}], ",", " ", 
               RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], "}"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardYellow", ",", " ", 
         RowBox[{"Line", "[", "points", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"StandardPurple", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", "0.02"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "points"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"ae134108-ab8d-40cd-b8f1-1b37f3614a6e"],

