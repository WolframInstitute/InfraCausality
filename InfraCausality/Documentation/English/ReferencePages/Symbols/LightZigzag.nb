Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94438232-211a-4080-8bf2-2c02f016b849"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightZigzag"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s0", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131d75fc-adf8-40b9-af29-60f8897e6968"],
 "\[LineSeparator]",
 "gives the ",
 StyleBox["n", "TI"],
 " + 1 reflection events of light bouncing between the rest worldline and the \
worldline of velocity ",
 StyleBox["v", "TI"],
 ", starting at arc length ",
 StyleBox["s", "TI"],
 "0 on the rest worldline, as associations.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ea987402-f412-4fe6-b1cf-68a2e67ab779"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightZigzag"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s0", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d5410a8-b7c1-47c7-8a9b-187e11a4d381"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"70dcb222-ebca-4154-9232-180abede92dc"],

Cell[TextData[{
 "Definition: the first event is the emission at arc length ",
 StyleBox["s", "TI"],
 "0 on the rest worldline (\"Alice\"); each further event is the reception of \
the previous one's light on the other worldline, rightgoing from Alice to the \
moving observer (\"Bob\") and leftgoing back. Each event is an association \
with the keys:"
}], "Notes",ExpressionUUID->"8e7d7ccb-53fb-4010-ad9b-1c611967441c"],

