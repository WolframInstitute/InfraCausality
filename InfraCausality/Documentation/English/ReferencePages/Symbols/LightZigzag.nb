Cell["LightZigzag", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6148cda-88d0-41e9-8c02-18e4309dbf5f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightZigzag"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s0", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13c92397-7539-4df7-92d7-602c47518f59"],
 "\[LineSeparator]",
 "gives the ",
 StyleBox["n", "TI"],
 " + 1 reflection events of light bouncing between the rest worldline and the \
worldline of velocity ",
 StyleBox["v", "TI"],
 ", starting at arc length ",
 StyleBox["s", "TI"],
 "0 on the rest worldline, as associations.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5d93600a-5606-47b9-8ee9-a698e4878260"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightZigzag"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["s0", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4226d5bc-e283-4765-afc5-19523328280e"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"af7c8031-50bf-47a2-b551-128da1bbca94"],

Cell[TextData[{
 "Definition: the first event is the emission at arc length ",
 StyleBox["s", "TI"],
 "0 on the rest worldline (\"Alice\"); each further event is the reception of \
the previous one's light on the other worldline, rightgoing from Alice to the \
moving observer (\"Bob\") and leftgoing back. Each event is an association \
with the keys:"
}], "Notes",ExpressionUUID->"c8c837cb-7ac2-439f-afc9-f050b6c0e1bb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9798220-4a1e-4638-85af-153e6da36011"], Cell["Key", "TableText",
