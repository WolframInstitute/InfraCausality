Cell[TextData[{
 "The first four bounces between the rest observer and the observer of \
velocity 3/5, from arc length 1; Alice's arc lengths are 1, 4, 16, since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d331caa-f8a8-494b-9484-c17268a65e67"],
 "."
}], "ExampleText",ExpressionUUID->"06c9b010-9fd7-4acf-9854-09a8ca29733f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"LightZigzag", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "4"}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Observer\>\"", ",", " ", "\"\<ArcLength\>\""}], "}"}]}], 
   "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3d9a6de4-818b-4740-a984-fdcb650a9427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     SqrtBox[
      FractionBox["17", "2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     RowBox[{"2", " ", 
      SqrtBox["34"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2d56d750-9c0f-457e-8005-f1ceb0b414e3"]
}, Open  ]],

Cell["\<\
The zigzag of velocity 3/5 at the light angle \[Pi]/3, drawn from its points.\
\
\>", "ExampleText",ExpressionUUID->"52495005-393e-4d69-a7ac-6bdb13e65a9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"LightZigzag", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"1", "/", "10"}], ",", " ", "6", ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", "\"\<Point\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"StandardBlue", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"1.1", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
             "}"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardRed", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"1.1", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Norm", " ", "/@", " ", "points"}], "]"}], " ", 
             RowBox[{"WorldlineDirection", "[", 
              RowBox[{
               RowBox[{"3", "/", "5"}], ",", " ", 
               RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], "}"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardYellow", ",", " ", 
         RowBox[{"Line", "[", "points", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"StandardPurple", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", "0.02"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "points"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"bc49f72a-2439-418e-8a63-d8159b58b569"],

