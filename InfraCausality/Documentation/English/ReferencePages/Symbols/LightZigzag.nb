Cell[TextData[{
 "The first four bounces between the rest observer and the observer of \
velocity 3/5, from arc length 1; Alice's arc lengths are 1, 4, 16, since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40a688d0-f642-447e-9ef2-505fddf65d48"],
 "."
}], "ExampleText",ExpressionUUID->"ae8b3d5f-663c-4907-965d-cf1ebb053540"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"LightZigzag", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "4"}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Observer\>\"", ",", " ", "\"\<ArcLength\>\""}], "}"}]}], 
   "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6cd17714-b463-4a27-9258-ffd5f9a295f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     SqrtBox[
      FractionBox["17", "2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     RowBox[{"2", " ", 
      SqrtBox["34"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8f589e7-f64e-4f91-9801-8cf39fb3f80d"]
}, Open  ]],

Cell["\<\
The zigzag of velocity 3/5 at the light angle \[Pi]/3, drawn from its points.\
\
\>", "ExampleText",ExpressionUUID->"b0acf957-da04-456a-890d-24c460989cba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"LightZigzag", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"1", "/", "10"}], ",", " ", "6", ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", "\"\<Point\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"StandardBlue", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"1.1", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
             "}"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardRed", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"1.1", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Norm", " ", "/@", " ", "points"}], "]"}], " ", 
             RowBox[{"WorldlineDirection", "[", 
              RowBox[{
               RowBox[{"3", "/", "5"}], ",", " ", 
               RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], "}"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardYellow", ",", " ", 
         RowBox[{"Line", "[", "points", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"StandardPurple", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", "0.02"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "points"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"0bd82504-f3c3-4e0f-9faa-8b1deda92740"],

