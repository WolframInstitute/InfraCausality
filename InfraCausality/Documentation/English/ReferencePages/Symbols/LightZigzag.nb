Cell[TextData[{
 "The arc length grows by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "821b6396-cd43-414b-9df4-920cab25c634"],
 " on the way out and by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe2227f6-42dc-4dad-8238-70a524c509ff"],
 " on the way back, so Alice's arc lengths grow geometrically by the \
round-trip factor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cc22b0-c914-4c00-8245-3b6bb3b427ac"],
 ". The bounce count up to arc length ",
 StyleBox["s", "TI"],
 " is therefore ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0406784-dd7b-4c06-9c5a-30678a0b3033"],
 ", logarithmic in ",
 StyleBox["s", "TI"],
 ", while the proper time (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7456df13-3e07-4f4d-9d0f-6bd8ed227eae"],
 ") is linear in it. Every reflection on Bob's worldline is the radar event \
of the emission before it and the return after it."
}], "Notes",ExpressionUUID->"59878e34-2b28-44d5-8197-8d8f1d12fcf7"]
}, Open  ]],

