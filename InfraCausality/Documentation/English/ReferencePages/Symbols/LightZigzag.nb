Cell[TextData[{
 "The arc length grows by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "929727b5-9b84-445d-b5c7-1e12d421689f"],
 " on the way out and by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e059c51-dd78-484b-8527-d7289f870da5"],
 " on the way back, so Alice's arc lengths grow geometrically by the \
round-trip factor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d95334b-05c1-4da2-b2a3-a8a94410a5f0"],
 ". The bounce count up to arc length ",
 StyleBox["s", "TI"],
 " is therefore ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a90af9-8b57-4d15-abda-34ccdc662d32"],
 ", logarithmic in ",
 StyleBox["s", "TI"],
 ", while the proper time (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74a8167a-2d3f-4e2c-bf70-b3fd032dbfb9"],
 ") is linear in it. Every reflection on Bob's worldline is the radar event \
of the emission before it and the return after it."
}], "Notes",ExpressionUUID->"19c2aaa4-925f-4130-ad92-2a283b7a753d"]
}, Open  ]],

