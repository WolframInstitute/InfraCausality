  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "Alice's arc lengths grow by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ab9aa2-b5af-448f-bb39-4dd8a9710259"],
 " per round trip, at every light angle."
}], "ExampleText",ExpressionUUID->"8ef785b5-4892-4012-82e1-af5a21bfb712"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"arcs", " ", "=", " ", 
         RowBox[{"Lookup", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"LightZigzag", "[", 
              RowBox[{"v", ",", " ", "1", ",", " ", "8", ",", " ", "phi"}], 
              "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
               " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
           " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"Ratios", "[", "arcs", "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"BondiKFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], " ", 
        "===", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4a254d06-d3d6-4703-a42b-4b6cbcfe1b95"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4e7da52a-957c-4f1f-9e04-865f8e05ad7a"]
}, Open  ]],

Cell["\<\
The events alternate between the observers and lie at their arc lengths from \
the origin.\
\>", "ExampleText",ExpressionUUID->"611ade55-bc10-414c-ab6b-f3935b239245"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{"events", ",", " ", "\"\<Observer\>\""}], "]"}], " ", "===", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\"", ",", 
       " ", "\"\<Alice\>\"", ",", " ", "\"\<Bob\>\""}], "}"}]}], " ", "&&", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}], " ", ".", " ", 
           RowBox[{"#", "[", "\"\<Point\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"#", "[", "\"\<ArcLength\>\"", "]"}], "^", "2"}]}], ")"}], 
        " ", "&"}], " ", "/@", " ", "events"}], "]"}], " ", "===", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"678d7937-4056-4f30-aa44-9c064afcd231"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0c1f6769-f737-44e1-96b3-65225da56f21"]
}, Open  ]],

Cell["\<\
Each reflection on the moving worldline has its radar emission and return at \
the neighbouring events of the zigzag.\
\>", "ExampleText",ExpressionUUID->"bf5297b4-cf03-4887-8d99-9fd37e1ab848"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"events", " ", "=", " ", 
     RowBox[{"LightZigzag", "[", 
      RowBox[{
       RowBox[{"3", "/", "5"}], ",", " ", "2", ",", " ", "6", ",", " ", 
       RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"BondiRadarCoordinates", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"events", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Point\>\"", "]"}], ",",
              " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"events", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], 
             "[", "\"\<ArcLength\>\"", "]"}]}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}]}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"db131d34-d4ff-4815-a6a1-91a3ffc3edc1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0e799188-38bb-4a4f-bfdd-e0efaae1c61f"]
}, Open  ]]
}, Open  ]],

