Cell[TextData[{
 "The first four bounces between the rest observer and the observer of \
velocity 3/5, from arc length 1; Alice's arc lengths are 1, 4, 16, since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f919b14-6ef0-4289-a100-5fc0c3d23cad"],
 "."
}], "ExampleText",ExpressionUUID->"72ce138b-16fa-4922-bf66-538357f8ad9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"LightZigzag", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "4"}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Observer\>\"", ",", " ", "\"\<ArcLength\>\""}], "}"}]}], 
   "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"17bd68d0-fe50-41e7-83b5-64ef7b8e1219"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     SqrtBox[
      FractionBox["17", "2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Bob\"\>", ",", 
     RowBox[{"2", " ", 
      SqrtBox["34"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Alice\"\>", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"70791e3d-c144-4c69-9076-8202e439a074"]
}, Open  ]],

Cell["\<\
The zigzag of velocity 3/5 at the light angle \[Pi]/3, drawn from its points.\
\
\>", "ExampleText",ExpressionUUID->"3def8627-d239-4406-aae1-47999f67894b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"LightZigzag", "[", 
         RowBox[{
          RowBox[{"3", "/", "5"}], ",", " ", 
          RowBox[{"1", "/", "10"}], ",", " ", "6", ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", "\"\<Point\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"StandardBlue", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"1.1", " ", 
               RowBox[{"Max", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
             "}"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardRed", ",", " ", 
         RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"1.1", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"Norm", " ", "/@", " ", "points"}], "]"}], " ", 
             RowBox[{"Through", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
               RowBox[{"WorldlineAngle", "[", 
                RowBox[{
                 RowBox[{"3", "/", "5"}], ",", " ", 
                 RowBox[{"Pi", "/", "3"}]}], "]"}], "]"}], "]"}]}]}], "}"}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"StandardYellow", ",", " ", 
         RowBox[{"Line", "[", "points", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"StandardPurple", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", "0.02"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "points"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"55e1fa6e-b971-433d-8f08-c51faaea1e42"],

