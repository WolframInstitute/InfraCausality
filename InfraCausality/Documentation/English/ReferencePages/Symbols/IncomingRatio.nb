          RowBox[{"Pi", "/", "6"}], ",", " ", 
          RowBox[{"Pi", "/", "4"}], ",", " ", 
          RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}]}], "]"}]}], ",", " ", 
