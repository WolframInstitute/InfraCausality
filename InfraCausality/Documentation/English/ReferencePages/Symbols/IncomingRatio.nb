Cell[CellGroupData[{
Cell["IncomingRatio", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6c45134e-f619-454a-895a-f66a4cdb5b8e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7d23210-1ad6-4f51-9237-ca7d761fbfc8"],
 "\[LineSeparator]",
 "gives the arc-length ratio ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ebec4c7-6df9-471d-b3af-543283e2a221"],
 " from an emission on the worldline of velocity ",
 StyleBox["v", "TI"],
 " to its reception on the rest worldline, with ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4f21fef-e3e8-49fa-b257-8db5c535feb0"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b56317b1-228c-4e26-8b35-84edebfdb9b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncomingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3abf837e-5247-43f7-9972-93c715ab0457"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"dcc716d7-67d0-40ee-be5d-8da7e44ee1e3"],

Cell[TextData[{
 "Definition: light emitted at Euclidean arc length ",
 StyleBox["s", "TI"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " and running to the left at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " meets the rest worldline at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cde031be-00ac-4db2-88e0-b7a435b0f587"],
 ". In the triangle of the origin, the emission and the reception the angle \
at the origin is ",
 StyleBox["\[Alpha]", "TI"],
 " and the angle at the reception is ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", so the angle at the emission is ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "-", "\[CurlyPhi]", "-", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1168870a-5b4c-4b41-a8d0-25091bd03441"],
 " and the sine rule gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f566f48f-1796-4b5b-9942-d917833a9c17"],
 "."
}], "Notes",ExpressionUUID->"7d7a8ed5-6232-4da6-8225-6ace8dc5f9da"],

Cell[TextData[{
 "As with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5043638-5f98-41da-8e58-1cf0b3bd4d62"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], 
   StyleBox[
    RowBox[{"i", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "771d2b8f-e92c-4bad-aaac-a69a30b48d90"],
 " compares Euclidean arc lengths. In proper times, the reception on the rest \
worldline is ",
 StyleBox["k", "TI"],
 " times the emission's proper time ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"ProperTimeScale", "[", 
    RowBox[{
     StyleBox["v", "TI"], ",", " ", 
     StyleBox["\[CurlyPhi]", "TR"]}], "]"}], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af7ab713-4ea4-4c19-b3e9-531110ca7bca"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], "=", 
   StyleBox["k", "TI"], "\[CenterDot]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "617b0a25-1d0b-4663-8219-fb2149ab9384"],
 " ",
 Cell[BoxData["ProperTimeScale"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0845055f-7119-48dc-87f2-69de2d5b816d"],
 ", the symmetry of the two observers that defines the k-factor."
}], "Notes",ExpressionUUID->"df821191-6917-4167-8f25-10b29618bfb2"]
}, Open  ]],

