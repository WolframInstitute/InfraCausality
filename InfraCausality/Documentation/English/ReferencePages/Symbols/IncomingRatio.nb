Cell["\<\
The incoming ratio of the velocity 3/5 at the default light angle and at the \
light angle \[Pi]/3.\
\>", "ExampleText",ExpressionUUID->"d5b65f37-ab01-499c-ad04-fa72de4d8d6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"IncomingRatio", "[", 
     RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
    RowBox[{"IncomingRatio", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", 
      RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"59dfe8a3-87e0-428f-b42c-0b23d1d9a933"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"4", " ", 
    SqrtBox[
     FractionBox["2", "17"]]}], ",", 
   FractionBox["4", 
    SqrtBox["13"]]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d0d5389f-b22e-4d8a-ba80-ae53e5c878e7"]
}, Open  ]],

Cell["The incoming ratio over the velocity for three light angles.", \
"ExampleText",ExpressionUUID->"8192760e-f1e9-4b09-be94-3ee7df27dcab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"IncomingRatio", "[", 
