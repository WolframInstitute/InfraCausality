   "d5715ee2-1cae-4f33-89b2-0e99ea9caa6e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "The reception at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2329596f-5252-4d99-ad86-862102993fe9"],
 " lies on the leftgoing light ray from the emission on the moving \
worldline."
}], "ExampleText",ExpressionUUID->"1580cd7a-36a2-463a-92d5-4c7e9602f119"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", " ", "=", " ", 
        RowBox[{"s", " ", 
         RowBox[{"WorldlineDirection", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}]}]}], ",", " ", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"s", " ", 
           RowBox[{"IncomingRatio", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", "-", " ", "e"}], ",", " ", 
         RowBox[{"LightDirection", "[", 
          RowBox[{"phi", ",", " ", "False"}], "]"}]}], "}"}], "]"}], " ", "==",
       " ", "0"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"740429b7-a795-43d3-8e02-53342e3879bd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d4d3048e-256b-4a84-8b8f-aa76a578d24f"]
}, Open  ]],

Cell["In proper times the incoming light is the k-factor again.", \
"ExampleText",ExpressionUUID->"e44a4ed9-1abb-4b83-9eb1-145282402482"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"IncomingRatio", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KFactor", "[", "v", "]"}], " ", 
        RowBox[{"ProperTimeScale", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}]}], ")"}], "^", "2"}]}], "]"}], 
   ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"13160fa2-c4e0-47b0-8ae0-84cc3665e13b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d026531c-8d2e-4a11-82b4-eebde7bb3fdd"]
}, Open  ]],

Cell[TextData[{
 "The two ratios multiply to ",
 StyleBox["k", "TI"],
 "\.b2 at every light angle."
}], "ExampleText",ExpressionUUID->"2194ec0c-f70c-4600-983d-f1a6176206f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TrigExpand", "[", 
     RowBox[{
      RowBox[{"OutgoingRatio", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
      RowBox[{"IncomingRatio", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"94b946c2-705d-4df7-bfec-d05f5b314900"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"72bcfa8b-f5dc-43e1-9e73-870c9308d398"]
}, Open  ]]
}, Open  ]],

