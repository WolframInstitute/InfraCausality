Cell[CellGroupData[{
Cell["InfraWorldline", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"849ddcb5-550b-46bb-8f8e-8d6644baf977"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c38d7f12-8a36-46a4-8742-87970e2ab7c3"],
 "\[LineSeparator]",
 "is the family of timelike geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every longest chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"559dd1d5-e1e2-4208-8338-1d1a28a8cff1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c804b100-0d11-41f4-9c79-a177ded7afe0"],
 "\[LineSeparator]",
 "is the family of longest chains of the whole graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"86c4df1a-9e7b-4a97-9b19-30f1d72a3cf5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07218481-fe56-40ad-b1a7-c86b6c00fa22"],
 "\[LineSeparator]",
 "is the family of piecewise geodesics through the knots ",
 StyleBox["p", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["pk", "TI"],
 ": a longest chain from each knot to the next, concatenated.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7df05ba8-19b8-4d8d-b8dd-33b73b13226a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be18d0f5-a7bd-41d0-813c-bea7bf834001"],
 "\[LineSeparator]",
 "is the family of longest chains starting at ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"a2fbfd49-3be7-45ff-84f3-2929856dc362"],

Cell[TextData[{
 "Definition: a worldline from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a chain ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] ",
 StyleBox["e", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " = ",
 StyleBox["q", "TI"],
 " of maximal length ",
 StyleBox["k", "TI"],
 ". The maximal length is the proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "), the number of edges of a longest directed path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"f1c16acf-4da9-43b7-a752-7a188609771b"],

Cell["\<\
The proper time is the discrete analogue of the length of a timelike curve, \
and a longest chain is the analogue of a timelike geodesic: in Minkowski \
space the straight worldline between two events maximises the proper time, \
and every other route is shorter. On a graph the longest chain is rarely \
unique. The head carries all of them, equally admissible, so nothing \
distinguishes one.\
\>", "Notes",ExpressionUUID->"36129d7a-3b9d-4890-aabf-14de08f88daf"],

Cell[TextData[{
 "The head holds its two events and computes nothing. Its graph, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "867ad9fe-e98c-44a0-a037-7df0e11f3ad2"],
 ", keeps the events ",
 StyleBox["v", "TI"],
 " of the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] with \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") + \[Tau](",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") = \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") and the edges along which \[Tau](",
 StyleBox["p", "TI"],
 ", \[CenterDot]) rises by one. Its paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " are exactly the longest chains, each once, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45737953-c821-4b35-a4cd-de7e2965332e"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e5d7235-dcc7-487e-9c8e-d8b7258f18fc"],
 ", and every count is read off that graph by dynamic programming, never by \
enumeration."
}], "Notes",ExpressionUUID->"1abd7ca7-12b5-4c33-9b2d-df91d1bf7109"],

