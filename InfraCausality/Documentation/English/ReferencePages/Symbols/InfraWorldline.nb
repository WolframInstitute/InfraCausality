Cell[TextData[{
 "The longest chains starting at ",
 StyleBox["p", "TI"],
 " are worldlines from ",
 StyleBox["p", "TI"],
 " to events of its future at the largest proper time from ",
 StyleBox["p", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"48f3b565-9e1f-4108-b440-592d208c02fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", "p", "]"}], ",", " ", "All"}], 
         "]"}]}], ",", "\n", "     ", 
       RowBox[{"height", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", 
              RowBox[{"p", ",", " ", "#"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", "p"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n",
      "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", "p", "]"}], ",", 
         " ", "\"\<Length\>\""}], "]"}], " ", "==", " ", "height"}], " ", "&&",
       "\n", "      ", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
       
       RowBox[{"{", 
        RowBox[{"height", " ", "+", " ", "1"}], "}"}]}], " ", "&&", " ", 
      RowBox[{"InfraWorldlineQ", "[", 
       RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{
         RowBox[{"InfraMemberQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "p", "]"}], ",", " ", "#"}], "]"}], 
         " ", "&"}]}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
