Cell["\<\
The proper time of the polyline is the sum of its legs' proper times, and its \
cardinality is their product, 5 times 21.\
\>", "ExampleText",ExpressionUUID->"ed5ef59d-c4b3-486b-8684-c556c6dd24cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Values", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraWorldline", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Length\>\"", ",", " ", "\"\<Cardinality\>\""}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8487571f-0901-49a7-b712-c6952afa8755"],

