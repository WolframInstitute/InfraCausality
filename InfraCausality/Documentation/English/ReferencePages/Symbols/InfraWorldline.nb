   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "3", "]"}]}], "]"}]}], "]"}]}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "q"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", " ", 
          "All"}], "]"}]}], ",", "\n", "     ", 
       RowBox[{"cuts", " ", "=", " ", 
        RowBox[{"Accumulate", " ", "@", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}], ",", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", 
              RowBox[{"q", ",", " ", "r"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}]}], "}"}]}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", "\n", "        ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"q", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}]}], " ", "&&", "\n", "      ", 
      
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<Length\>\""}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"Last", "[", "cuts", "]"}], " ", "-", " ", "1"}]}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraWorldlineQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"member", ",", " ", 
              RowBox[{"cuts", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}]}], "]"}]}],
            "]"}], " ", "&&", " ", 
          RowBox[{"InfraWorldlineQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"member", ",", " ", 
              RowBox[{"cuts", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}]}], "]"}]}],
            "]"}]}]}]}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2988ea62-01a1-4879-8807-708e03bd0343"],

