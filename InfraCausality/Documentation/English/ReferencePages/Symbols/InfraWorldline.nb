Cell[CellGroupData[{

Cell["Experimental: polyline worldlines", "ExampleSubsection",ExpressionUUID->"99e31c9f-fa3e-4f13-a562-55500adadb35"],

Cell["\<\
The piecewise geodesics through three knots of the diamond lattice: a \
worldline from the first knot to the second, then from the second to the \
third. Every member passes the middle knot.\
\>", "ExampleText",ExpressionUUID->"c83ee878-309f-46ed-8d99-04b5946cb531"],

