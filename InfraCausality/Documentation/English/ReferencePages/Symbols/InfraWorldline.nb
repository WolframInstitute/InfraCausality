Cell["\<\
The proper time and the number of worldlines between the same events.\
\>", "ExampleText",ExpressionUUID->"25a419dc-119e-4ad3-85b2-bac75ceebc5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraWorldline", "[", 
         RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Length\>\"", ",", " ", "\"\<Cardinality\>\""}], "}"}]}],
        "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2cc997d6-07d6-4517-9f78-904b97b5fd89"],

