    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a677e773-1eaf-4056-a61d-0d85fb3fcae3"]], "TableText",ExpressionUUID->
     "cb51a0a4-7266-4729-8fbd-5553bcd4a818"], Cell[TextData[{
     "the directed acyclic graph whose ",
     StyleBox["p", "TI"],
     "-to-",
     StyleBox["q", "TI"],
     " paths are the longest chains"
    }], "TableText",ExpressionUUID->"d0c7cf97-d841-4743-afb2-c9f7091a5421"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d623ba74-28d9-46b3-a406-df45a083f44b"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26619b31-62a6-4600-95e4-e0069a31c19d"]], "TableText",ExpressionUUID->
     "ac07c4f4-c655-4e2a-bc18-6b8bd87f88b2"], Cell[TextData[{
     "the proper time \[Tau](",
     StyleBox["p", "TI"],
     ", ",
     StyleBox["q", "TI"],
     "); ",
     Cell[BoxData[
      RowBox[{"-", "Infinity"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c8b3150f-0044-4850-a2db-16258e294dd7"],
     " when ",
     StyleBox["q", "TI"],
     " does not follow ",
     StyleBox["p", "TI"]
    }], "TableText",ExpressionUUID->"d0485212-9b60-4b81-a89d-ad3c26898a7f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "71433a61-4fca-42d8-ad5d-607b464c9a5d"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3ca34d19-998e-4349-8878-160e2abc2df1"]], "TableText",ExpressionUUID->
     "5a5a232a-b93f-4fae-98f1-a9967500bdd1"], Cell[
    "the number of longest chains", "TableText",ExpressionUUID->
     "50979d37-e5f1-412e-95aa-0b4d506dc683"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "930e65de-90da-4f3e-8a94-037560d4e8ff"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "926c639e-853d-46ba-9a9d-d31813a2737e"]], "TableText",ExpressionUUID->
     "8d040fe9-7802-4c44-8cce-dfe114a9284e"], Cell[
    "for each event, the number of longest chains through it", "TableText",
     ExpressionUUID->"ee4424c8-f662-46d2-9ff7-866b77f9fd49"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "23e05970-d2da-4ec4-a495-73b6c448ce3b"], Cell[TextData[Cell[
