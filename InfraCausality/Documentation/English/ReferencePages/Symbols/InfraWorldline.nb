Cell["\<\
The worldlines from an event at height 1 to an event of its future one slice \
below the top, on the diamond lattice, a sprinkling into two-dimensional \
Minkowski space and the cylinder lattice. An edge is drawn as strongly as the \
number of longest chains through it.\
\>", "ExampleText",ExpressionUUID->"9bf0c8f0-2b6d-4ae0-842a-9a21d03af3e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bfcc4599-4401-4369-a794-0178081c1688"],

