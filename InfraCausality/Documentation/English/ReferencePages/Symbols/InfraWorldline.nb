     FontSize->0.9 Inherited,ExpressionUUID->
     "f639536e-66f8-4221-a3f3-cc29b0898828"]], "TableText",ExpressionUUID->
     "54d0699b-8dde-4b9e-a1c7-e25aa37d7400"], Cell[
    "for each edge, the number of longest chains through it", "TableText",
     ExpressionUUID->"23be5e8f-300d-4130-a0fd-5b8118cd1b67"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f6fcf1b6-a217-4f69-bdc0-6d5400bdc0bc"], Cell[TextData[Cell[
