Cell[TextData[{
 "The cardinality is the number of members, and every member is a chain of \
\[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") + 1 events that passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldlineQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1f08f0f-c7d7-4739-8e85-d08b98f73723"],
 "."
}], "ExampleText",ExpressionUUID->"152b9bfb-9565-449a-969e-3b1ff5242839"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"members", " ", "=", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Length\>\""}],
           "]"}], " ", "+", " ", "1"}], "}"}]}], " ", "&&", "\n", "      ", 
      RowBox[{"InfraWorldlineQ", "[", 
       RowBox[{"g", ",", " ", "members"}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94131f32-73f1-40c9-8e57-a4beeeaf71c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"660f6b67-1072-4817-8fd7-22975ba66c15"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice every maximal chain from {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} to {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is longest, and there are Binomial[(",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") + (",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 "), ",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 "] of them."
}], "ExampleText",ExpressionUUID->"d8c1317c-a619-47dd-a694-d1a9df6050a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"q", " ", "-", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"First", "[", 
           RowBox[{"q", " ", "-", " ", "p"}], "]"}]}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a2c4d5d8-8ba6-4504-a862-c2c3ec0f7042"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"883a807b-d61d-4ea3-bf47-1cd70af3f737"]
}, Open  ]],

Cell[TextData[{
 "The proper time is the universal time of ",
 StyleBox["q", "TI"],
 " in the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "], whose only source is ",
 StyleBox["p", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"e3c42a56-e570-40b7-b9e1-4c2bca754921"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"RandomInfraCausalFuture", "[", 
            RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", "q"}], "]"}]}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Length\>\""}], 
         "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"UniversalTime", "[", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Subgraph\>\""}], "]"}], "]"}], "[", "q", "]"}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f4eaa4e1-d74d-4b76-a12c-b222512dbffa"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"05ed331f-9cc0-4966-ab29-3c5f0f81c084"]
}, Open  ]],

Cell["\<\
The members of a polyline are the concatenations of one worldline per leg: \
the cardinality is the product of the legs' cardinalities, the proper time \
their sum, and splitting a member at the knots gives a worldline on each leg.\
\
\>", "ExampleText",ExpressionUUID->"67ebf27e-1137-4628-9870-542dab0f380d"],

