Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbe22191-3165-449f-9207-1947caca05c6"],
 " is the same construction on the whole graph: the chains from a source to a \
sink whose length is the height of the graph, the maximum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalTime"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalTime", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "485288c8-ea30-4f6e-8819-a50808c18270"],
 "."
}], "Notes",ExpressionUUID->"23b5db16-ea71-4a45-a31e-844eede6ec92"],

Cell[TextData[{
 "A member is a vertex list in causal order; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "508ef3ed-61c8-473d-ac6e-ac385dee35ad"],
 " draws members uniformly, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldlineQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "136c6f2d-6ad6-489d-b146-5cccdb8bd2a7"],
 " recognises one. Every worldline is an observer, a saturated chain; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserver"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserver", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e80ccb4-307b-430e-b73d-d7c00bf3c82c"],
 "."
}], "Notes",ExpressionUUID->"a21e282b-1b44-4927-8630-59ac6aebd8b1"],

Cell[TextData[{
 "Experimental: the two further call forms are the same construction on other \
graphs. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20d6a421-0208-4272-aaad-20f7fc026901"],
 ", with ",
 StyleBox["k", "TI"],
 " \[GreaterEqual] 3, is the polyline whose legs are the worldlines from ",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "bde291df-673b-43ff-aa0d-03397835813e"],
 " to ",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "6d2a71f0-4d9c-4b65-ac9c-ba65cb8d5a88"],
 "; its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f582c3c-fea2-41e0-a92b-539b7070dac3"],
 " is the union of the legs' graphs, which meet only at the knots, so every \
path from ",
 StyleBox["p", "TI"],
 "1 to ",
 StyleBox["pk", "TI"],
 " passes every knot and is a member, ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b421ab94-f774-4f5e-9289-34ce9a196484"],
 " is the sum \[Tau](",
 StyleBox["p", "TI"],
 "1, ",
 StyleBox["p", "TI"],
 "2) + \[Ellipsis] + \[Tau](",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*", 
    RowBox[{"\[Minus]", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "43e60110-ff8a-4bcc-a540-da68bf163495"],
 ", ",
 StyleBox["pk", "TI"],
 ") of the legs' proper times and ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f90401-b5ae-406f-b8e5-da1906f41cf6"],
 " the product of their cardinalities. A member is a piecewise geodesic, the \
discrete twin who turns at the knots; between the same endpoints it is at \
most as long as a worldline. When some knot does not precede the next the \
family is empty. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWorldline"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98d8aa85-7d5e-486d-978d-1dd8d28f540b"],
 " is the family of longest chains that start at ",
 StyleBox["p", "TI"],
 ": with ",
 StyleBox["h", "TI"],
 " the largest proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") over the causal future of ",
 StyleBox["p", "TI"],
 ", its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee0f9ff-4ac3-4b3d-9d29-5cdf06909ab3"],
 " keeps the events ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") with \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") + \[Tau]\:207b(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["h", "TI"],
 ", where \[Tau]\:207b(",
 StyleBox["v", "TI"],
 ") is the longest chain from ",
 StyleBox["v", "TI"],
 " inside ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 "), and the edges along which \[Tau](",
 StyleBox["p", "TI"],
 ", \[CenterDot]) rises by one; its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a879a64c-259a-4553-9597-5395e35e2ff5"],
 " is ",
 StyleBox["h", "TI"],
 ". Both forms are sampled by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2dbd0f0c-4d33-4cc9-b99b-f377d4eda198"],
 " and recognised by ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a610b85-abde-4a72-8089-e41f1267eb8f"],
 " like the two-event form."
}], "Notes",ExpressionUUID->"19006973-de05-42cc-be07-f95bcaf3bd59"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"bd8a97d6-d1f0-4142-88c8-2879987808fd"],

