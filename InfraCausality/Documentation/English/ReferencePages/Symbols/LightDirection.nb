Cell[TextData[{
 "The light directions are unit vectors at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to the time axis, mirror images in it."
}], "ExampleText",ExpressionUUID->"7f1bc105-243b-415b-b448-4d5db9c5ba8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}], "]"}], " ", "==", " ", "1"}],
     " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], " ", "==", " ", 
     RowBox[{"Cos", "[", "phi", "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{"LightDirection", "[", 
      RowBox[{"phi", ",", " ", "False"}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], " ", 
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}]}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2b924784-4c74-4a7c-9d5c-61e203b04058"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8cc9d153-31dc-44c5-9d62-d146defeb2e5"]
}, Open  ]],

Cell["\<\
Rightgoing rays keep the emission arc length and leftgoing rays the return \
arc length.\
\>", "ExampleText",ExpressionUUID->"3dfe7e48-4836-4f1b-aa40-864d1373931f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
         RowBox[{"l", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
       "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
      "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
         RowBox[{"l", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}], 
       "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
      "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8c296ac1-3ac6-49fa-845c-e6320ae0650e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9f452e1c-da77-4300-a09a-96cafb15a471"]
}, Open  ]],

Cell[TextData[{
 "Every worldline of velocity 0 < ",
 StyleBox["v", "TI"],
 " < 1 lies strictly between the time axis and the rightgoing light direction."
}], "ExampleText",ExpressionUUID->"6c6a0697-e661-4163-a0e8-765728052dab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"WorldlineDirection", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], "]"}], " ", ">", " ", 
     "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"LightDirection", "[", 
         RowBox[{"phi", ",", " ", "True"}], "]"}], ",", " ", 
        RowBox[{"WorldlineDirection", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}]}], "}"}], "]"}], " ", ">", " ",
      "0"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ab84efc8-b6b9-4b77-a02a-f9f5990ab24f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0f23c75f-dc94-4c31-8d5c-4b98afde8b21"]
}, Open  ]]
}, Open  ]],

