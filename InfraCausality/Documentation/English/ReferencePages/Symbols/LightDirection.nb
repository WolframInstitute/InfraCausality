  FontSize->0.9 Inherited,ExpressionUUID->
  "106f4cd9-8770-4a0b-8f27-50dc67725734"],
 "\[LineSeparator]",
 "gives the unit direction of a light ray at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to the time axis, pointing to positive ",
 StyleBox["x", "TI"],
 " when ",
 StyleBox["right", "TI"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e42d5e7-a816-48ef-80d9-9e8a8f22d543"],
