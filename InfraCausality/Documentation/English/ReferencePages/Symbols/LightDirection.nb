Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"16a00d07-9211-4cf4-b74a-388680baf021"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightDirection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightDirection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[CurlyPhi]", "TR"], ",", " ", 
    StyleBox["right", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e876aa26-6a79-4498-aa44-0b536237045a"],
 "\[LineSeparator]",
 "gives the unit direction of a light ray at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to the time axis, pointing to positive ",
 StyleBox["x", "TI"],
 " when ",
 StyleBox["right", "TI"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a40b536-2382-4c2c-bd6a-b2e3f678b032"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0221af1c-7a5d-4cc1-a0be-04be9db8618f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightDirection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightDirection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\[CurlyPhi]", "TR"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f83109d7-2d0d-4046-827f-db767dc68270"],
 "\[LineSeparator]",
 "gives the rightgoing direction."
}], "Usage",ExpressionUUID->"d85a288f-fdd0-4bb0-8257-292b0d65539f"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"0665143e-7170-4302-a653-93c2cb6e9c45"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee0a8e2-c9d0-43fb-87f0-6a7ed634b925"],
 " when ",
 StyleBox["right", "TI"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "daeb3d11-f01f-4325-9695-41a3e9ae310e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78354325-8507-4633-87e9-541b9ed88dc5"],
 " otherwise. The two directions span the light cone of the drawing: every \
worldline of velocity |",
 StyleBox["v", "TI"],
 "| < 1 lies between them."
}], "Notes",ExpressionUUID->"fe97e010-8893-4049-87e4-87b3d4406074"],

Cell[TextData[{
 "Along a rightgoing ray the emission arc length of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
