Cell["\<\
The two light directions at the light angle \[Pi]/4, and the leftgoing one at \
\[Pi]/3.\
\>", "ExampleText",ExpressionUUID->"7cf661c8-66d1-4068-95e9-17581007a5ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LightDirection", "[", 
    RowBox[{"Pi", "/", "4"}], "]"}], ",", " ", 
   RowBox[{"LightDirection", "[", 
    RowBox[{
     RowBox[{"Pi", "/", "4"}], ",", " ", "False"}], "]"}], ",", " ", 
   RowBox[{"LightDirection", "[", 
    RowBox[{
     RowBox[{"Pi", "/", "3"}], ",", " ", "False"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a911fba8-b12c-42b0-ba9b-58fcb81b7e5c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SqrtBox["3"], "2"]}], ",", 
     FractionBox["1", "2"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"75491d2e-71ce-482d-80f8-a854ff562cea"]
}, Open  ]]
