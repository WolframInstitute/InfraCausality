Cell["\<\
The two light directions at the light angle \[Pi]/4, and the leftgoing one at \
\[Pi]/3.\
\>", "ExampleText",ExpressionUUID->"1736845f-ffd9-4f62-af70-aaff033851d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LightDirection", "[", 
    RowBox[{"Pi", "/", "4"}], "]"}], ",", " ", 
   RowBox[{"LightDirection", "[", 
    RowBox[{
     RowBox[{"Pi", "/", "4"}], ",", " ", "False"}], "]"}], ",", " ", 
   RowBox[{"LightDirection", "[", 
    RowBox[{
     RowBox[{"Pi", "/", "3"}], ",", " ", "False"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f8f504aa-d1d7-4246-8d9e-78c206b5cfb2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SqrtBox["3"], "2"]}], ",", 
     FractionBox["1", "2"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c0cdad74-bba9-4c12-9cbc-9c9060533c53"]
}, Open  ]]
