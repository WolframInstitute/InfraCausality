Cell[TextData[{
 "The light directions are unit vectors at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to the time axis, mirror images in it."
}], "ExampleText",ExpressionUUID->"7ddb40c7-f773-4cc7-9965-17f120d8a6ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}], "]"}], " ", "==", " ", "1"}],
     " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], " ", "==", " ", 
     RowBox[{"Cos", "[", "phi", "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{"LightDirection", "[", 
      RowBox[{"phi", ",", " ", "False"}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], " ", 
      RowBox[{"LightDirection", "[", 
       RowBox[{"phi", ",", " ", "True"}], "]"}]}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5df52011-c936-4382-a3d0-778430e294fc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"190d3b10-0651-4087-8048-06fc97c0d52e"]
}, Open  ]],

Cell["\<\
Rightgoing rays keep the emission arc length and leftgoing rays the return \
arc length.\
\>", "ExampleText",ExpressionUUID->"8d33edc5-e8b1-4cad-9024-5a95c7fce77e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
         RowBox[{"l", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], ",", " ", "phi"}], 
       "]"}], "[", "\"\<EmitArcLength\>\"", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
      "[", "\"\<EmitArcLength\>\"", "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "+", " ", 
         RowBox[{"l", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "False"}], "]"}]}]}], ",", " ", "phi"}], 
       "]"}], "[", "\"\<ReturnArcLength\>\"", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"BondiRadarCoordinates", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "phi"}], "]"}], 
      "[", "\"\<ReturnArcLength\>\"", "]"}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0b13a57b-c787-4519-ad93-5f523893b8d1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"32c6cd29-3844-4701-81e5-5888562c3055"]
}, Open  ]],

Cell[TextData[{
 "Every worldline of velocity 0 < ",
 StyleBox["v", "TI"],
 " < 1 lies strictly between the time axis and the rightgoing light direction."
}], "ExampleText",ExpressionUUID->"3b25e78d-433e-4dfe-8961-5347b05bd1ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"WorldlineDirection", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], "]"}], " ", ">", " ", 
     "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"LightDirection", "[", 
         RowBox[{"phi", ",", " ", "True"}], "]"}], ",", " ", 
        RowBox[{"WorldlineDirection", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}]}], "}"}], "]"}], " ", ">", " ",
      "0"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7d3676d3-03c4-4e0e-95ba-7291fc364877"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"856db27f-603f-40e0-a506-da949e47082b"]
