 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LightDirection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LightDirection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\[CurlyPhi]", "TR"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "091ea3d2-5dd0-4f89-8187-967542d1a9cc"],
 "\[LineSeparator]",
 "gives the rightgoing direction."
}], "Usage",ExpressionUUID->"67720670-d80b-42d6-93cd-f0fab7ae2f82"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"565fbb23-167f-45f4-aa57-222912f3bbc2"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c55085d2-ebe0-4a8c-a0d0-5473f8f70664"],
 " when ",
 StyleBox["right", "TI"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77c0450c-e16b-404e-a901-ec30b2846c9f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c5e8d1-10ac-42db-903c-0679fa1a062f"],
 " otherwise. The two directions span the light cone of the drawing: every \
worldline of velocity |",
 StyleBox["v", "TI"],
 "| < 1 lies between them."
}], "Notes",ExpressionUUID->"20d73ce2-1126-4265-9c04-47eda228884d"],

Cell[TextData[{
 "Along a rightgoing ray the emission arc length of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
