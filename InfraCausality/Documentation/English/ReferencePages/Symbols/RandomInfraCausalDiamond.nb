  FontSize->0.9 Inherited,ExpressionUUID->
  "0590081b-4db2-4064-9205-fd53de448317"],
 " sampler shares. With a single member it reads:"
}], "Notes",ExpressionUUID->"b80f42d6-612b-4b0e-8b17-ee725667bc1f"],

