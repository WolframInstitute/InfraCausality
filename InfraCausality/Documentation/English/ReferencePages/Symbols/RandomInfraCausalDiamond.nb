  FontSize->0.9 Inherited,ExpressionUUID->
  "94287d4a-9935-4e00-a8ae-911b4a95f6cf"],
 "."
}], "Notes",ExpressionUUID->"fa6d226e-500a-4345-8b06-f49b04e40cf1"],

Cell[TextData[{
 "The draw involves no randomness. The option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c85454b1-282c-42d2-8f33-be6f18c60ff0"],
 " is accepted with the values of the chain samplers and changes nothing \
here; ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomChoice"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f81e6ef-8879-4b4c-a905-09df81f58234"],
 " together with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e560035a-2c75-45ce-81e9-d26e50ad93ca"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"323bb4ca-779c-48b0-8644-0496ccb47839"],

