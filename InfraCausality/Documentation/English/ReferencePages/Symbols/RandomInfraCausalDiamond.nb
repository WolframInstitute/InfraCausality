Cell["\<\
On the diamond lattice the diamond of {1, 2} and {3, 3} is a 3 \[Times] 2 \
rectangle.\
\>", "ExampleText",ExpressionUUID->"fa80df62-1edd-4108-b77a-de9720d6b8f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomInfraCausalDiamond", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
    ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6b8d24d2-68f6-4215-b213-467a73043ce5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e2eab6f8-d7a5-4f1f-9c44-e83321a67e47"]
}, Open  ]],

Cell["\<\
The diamond of an event and an event that does not follow it is empty.\
\>", "ExampleText",ExpressionUUID->"6ac35f01-8d09-4099-81c5-2e3e20e460d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"RandomInfraCausalDiamond", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
