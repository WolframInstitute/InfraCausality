Cell[TextData[{
 "When ",
 StyleBox["q", "TI"],
 " does not follow ",
 StyleBox["p", "TI"],
 " the diamond is empty: its member is the empty set, so the count-less call \
gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e96c979-5e6a-4aa7-8065-6fea4fa88bc2"],
