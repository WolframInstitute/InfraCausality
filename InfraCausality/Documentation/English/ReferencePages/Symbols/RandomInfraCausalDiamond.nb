Cell[TextData[{
 "The diamond is the intersection of the causal future of ",
 StyleBox["p", "TI"],
 " and the causal past of ",
 StyleBox["q", "TI"],
 ", and it passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e11ae99-9f99-4cd6-85bd-8c63923de071"],
 " whenever it is nonempty."
}], "ExampleText",ExpressionUUID->"f5505c6c-dfa9-4b7c-8df1-fb11b0691650"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"q", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"diamond", " ", "=", " ", 
             RowBox[{"RandomInfraCausalDiamond", "[", 
              RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{"diamond", " ", "===", " ", 
             RowBox[{"Intersection", "[", 
              RowBox[{
               RowBox[{"RandomInfraCausalFuture", "[", 
                RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
               RowBox[{"RandomInfraCausalPast", "[", 
                RowBox[{"g", ",", " ", "q"}], "]"}]}], "]"}]}], " ", "&&", 
            "\n", "          ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"diamond", " ", "===", " ", 
               RowBox[{"{", "}"}]}], " ", "||", " ", 
              RowBox[{"InfraCausalDiamondQ", "[", 
               RowBox[{"g", ",", " ", "diamond"}], "]"}]}], ")"}]}]}], 
          "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"39e95758-792e-457a-8cce-c9552d3d915f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0521bc86-9f3c-4785-947b-c8ef508b5088"]
}, Open  ]],

Cell["\<\
A diamond is convex: the diamond of any two of its events lies inside it, and \
so does every worldline between them.\
\>", "ExampleText",ExpressionUUID->"5fc65eb3-f678-41d7-95a8-9b1b381cea3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"diamond", " ", "=", " ", 
        RowBox[{"RandomInfraCausalDiamond", "[", 
         RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{"diamond", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], " ", "|->", "\n", "      ", 
          RowBox[{
           RowBox[{"SubsetQ", "[", 
            RowBox[{"diamond", ",", " ", 
             RowBox[{"RandomInfraCausalDiamond", "[", 
              RowBox[{"g", ",", " ", "x", ",", " ", "y"}], "]"}]}], "]"}], 
           " ", "&&", "\n", "        ", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{"diamond", ",", " ", 
             RowBox[{"Union", " ", "@@", " ", 
              RowBox[{"RandomInfraWorldline", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraWorldline", "[", 
                 RowBox[{"x", ",", " ", "y"}], "]"}], ",", " ", "All"}], 
               "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6bfcdef4-90e1-4047-a6f7-5a92040c57f4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"02d85fe7-f595-4192-9a4f-19fe7f8fbb9c"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the diamond of {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} and {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} with ",
 StyleBox["i", "TI"],
 " \[LessEqual] ",
 StyleBox["k", "TI"],
 " and ",
 StyleBox["j", "TI"],
 " \[LessEqual] ",
 StyleBox["l", "TI"],
 " has (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "ExampleText",ExpressionUUID->"0cebb79b-f087-415b-ad39-e218bf86e209"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], "]"}], " ", "==",
         " ", 
        RowBox[{"Times", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"q", " ", "-", " ", "p", " ", "+", " ", "1"}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"68c6bfe4-eec5-472c-a1aa-85bdb9e881a1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"34e904e6-2e82-496c-ba21-4b89a582aa3a"]
}, Open  ]],

Cell["\<\
The hull of a comparable pair is its diamond, and the hull of a diamond is \
the diamond.\
\>", "ExampleText",ExpressionUUID->"9e2142e9-3da1-4206-8751-523bf367aa08"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraCausalFuture", "[", 
         RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
        RowBox[{"q", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"{", 
              RowBox[{"p", ",", " ", "q"}], "}"}], "]"}]}], "]"}], " ", "===",
           " ", 
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], " ", "===", 
          "\n", "        ", 
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"RandomInfraCausalDiamond", "[", 
              RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], "]"}]}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"90556148-7bd3-4d00-b9b3-ca12c19d68d6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"43a463e9-9931-414b-931e-b49556a51326"]
}, Open  ]]
}, Open  ]],

