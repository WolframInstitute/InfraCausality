Cell["\<\
The causal hull of two incomparable events of the cylinder lattice is the \
pair itself; the hull of the pair and an event of their common future is the \
union of two diamonds.\
\>", "ExampleText",ExpressionUUID->"d93fc00a-419f-4734-9b53-41f05eb63610"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}], ",", " ", "2"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"top", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", "s"}]}], "]"}], ",", " ", 
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "s"}]}], "]"}]}], "]"}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalDiamond", "[", "s", "]"}]}], "]"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraCausalDiamond", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"Append", "[", 
              RowBox[{"s", ",", " ", "top"}], "]"}], "]"}]}], "]"}], ",", " ",
           "top"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"7c2dc4ea-b01d-468b-9477-18281aae1f74"],

