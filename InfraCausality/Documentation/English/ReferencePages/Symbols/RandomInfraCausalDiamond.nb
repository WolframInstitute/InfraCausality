Cell[TextData[{
 "Definition: a causal diamond denotes one vertex set, its support [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 "), the events that lie between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". The sampler returns that support as a sorted vertex list. For the hull ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalDiamond"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792c2612-1ab9-46da-85d2-2aa86113281c"],
 " of a set ",
 StyleBox["S", "TI"],
 " the support is ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["S", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["S", "TI"],
 "), the events that lie between two events of ",
 StyleBox["S", "TI"],
 "."
}], "Notes",ExpressionUUID->"ccd0dd9f-5847-46ff-90d2-8d5ff3822ab8"],

Cell[TextData[{
 "The count contract is the one every ",
