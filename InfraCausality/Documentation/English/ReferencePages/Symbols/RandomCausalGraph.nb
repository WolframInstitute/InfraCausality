             "]"}]}], ")"}]}], "}"}], ",", " ", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalDiamond", "[", 
            RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", 
           " ", "\"\<OrderingFraction\>\""}], "]"}]}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "10"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
