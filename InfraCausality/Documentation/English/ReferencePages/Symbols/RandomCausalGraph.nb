Cell[TextData[{
 "The four forms on 25 events: the default percolation, a percolation with ",
 StyleBox["p", "TI"],
 " = 0.2, an orientation of a graph with 40 edges and a two-dimensional \
sprinkling."
}], "ExampleText",ExpressionUUID->"aea832c9-9570-45aa-b03d-b27a152d9944"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"(", 
