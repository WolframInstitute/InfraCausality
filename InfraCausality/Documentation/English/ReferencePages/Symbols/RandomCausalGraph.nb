Cell[TextData[{
 "The universal foliation of a percolation of 60 events with ",
 StyleBox["p", "TI"],
 " = 0.08."
}], "ExampleText",ExpressionUUID->"ed31a5de-5684-4a4b-bd34-da6419406840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", 
        RowBox[{"{", 
         RowBox[{"60", ",", " ", "0.08"}], "}"}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"UniversalFoliation", "[", "g", "]"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"813ae28d-8aec-43b6-99be-f5c6de4492c7"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
