Cell[CellGroupData[{
Cell["RandomCausalGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"63c60944-cb9f-4eae-a998-6bf2cb8b5d0a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomCausalGraph"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7610c31-27fe-433e-b7f4-596d2fd3adfd"],
 "\[LineSeparator]",
 "gives the Hasse diagram of a transitive percolation on the events 1, \
\[Ellipsis], ",
 StyleBox["n", "TI"],
 " with link probability log ",
 StyleBox["n", "TI"],
 " / ",
 StyleBox["n", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"758e5b14-5495-4154-a716-3c63103cc234"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomCausalGraph"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["n", "TI"], ",", " ", 
     StyleBox["p", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de3f367-21a7-4334-86f4-720e196cd714"],
 "\[LineSeparator]",
 "gives the Hasse diagram of a transitive percolation with link probability \
",
 StyleBox["p", "TI"],
 ", 0 < ",
 StyleBox["p", "TI"],
 " < 1.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f6d5bee5-a345-4eec-bb16-d2c9301d5858"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomCausalGraph"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["n", "TI"], ",", " ", 
     StyleBox["m", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1fadd5c-4c61-4e25-b8e5-e46de6903272"],
 "\[LineSeparator]",
 ", with ",
 StyleBox["m", "TI"],
 " an integer, gives the Hasse diagram of an acyclic orientation of a random \
connected graph with ",
 StyleBox["m", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"566d20e0-b0f7-4eec-90f6-0b2902fec822"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomCausalGraph"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Sprinkling\>\"", ",", " ", 
       StyleBox["d", "TI"]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d6130e-fa1d-497f-96f7-dc9bc6fc6f40"],
 "\[LineSeparator]",
 "gives the Hasse diagram of ",
 StyleBox["n", "TI"],
 " points sprinkled into the unit causal diamond of ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space."
}], "Usage",ExpressionUUID->"5649a9e8-ff41-43b6-8d1c-dfacd77da5af"],

Cell[TextData[{
 "Every form returns a random finite order as its Hasse diagram, a \
transitively reduced directed acyclic graph on the events 1, \[Ellipsis], ",
 StyleBox["n", "TI"],
 ", numbered in a linear extension of the order, so every edge ",
 StyleBox["i", "TI"],
 " \[RightArrow] ",
 StyleBox["j", "TI"],
 " has ",
 StyleBox["i", "TI"],
 " < ",
 StyleBox["j", "TI"],
 ". The graph has the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "39071abe-f341-49ea-ab0f-425ff67e05fb"],
 " of its size. Randomness comes from the ambient generator: ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7041ca8b-cbdd-4b58-a049-8004d65c2fbe"],
 " before the call fixes the graph. ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec077b32-ea93-422f-9460-59e549bedd21"],
 " options pass through."
}], "Notes",ExpressionUUID->"6aeb2965-599e-4015-9d7f-547b4b0b7935"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9872de05-bca2-4ff7-b79b-0178e3c4744e"], Cell["Form", "TableText",
     FontWeight->Bold,ExpressionUUID->"427aff18-1ad7-45dd-bf89-c280924690e2"],
     Cell["Order", "TableText",
     FontWeight->Bold,ExpressionUUID->"6406b5d6-9c43-4e2f-b031-1e221a89b78a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c5777d90-b4c9-4954-9e2b-a3b5a03aa26a"], Cell[TextData[StyleBox[
    "n", "TI"]], "TableText",ExpressionUUID->
     "65d5365b-c0a7-49a4-ab58-0476fcea444e"], Cell[TextData[{
     "transitive percolation (Rideout\[Dash]Sorkin) with ",
     StyleBox["p", "TI"],
     " = log ",
     StyleBox["n", "TI"],
     " / ",
     StyleBox["n", "TI"],
     "; the same as ",
     Cell[BoxData[
      RowBox[{"Method", " ", "->", " ", "\"\<Percolation\>\""}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "426ae966-c7a3-4a7e-a83c-64206fdad192"]
    }], "TableText",ExpressionUUID->"7f51986c-aafb-4be3-a7bf-2a15f7245a1f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5caf248b-4362-44bf-a026-83d5fe8522ef"], Cell[TextData[{
     "{",
     StyleBox["n", "TI"],
     ", ",
     StyleBox["p", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"fe3cb1ad-e98d-4f4e-a240-0076536a2aff"], 
    Cell[TextData[{
     "each pair ",
     StyleBox["i", "TI"],
     " < ",
     StyleBox["j", "TI"],
     " is linked independently with probability ",
     StyleBox["p", "TI"],
     ", and the order is the transitive closure of the links"
    }], "TableText",ExpressionUUID->"410e7044-7ad7-4536-9982-2bbb434406f6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "769451c2-9599-43d7-a303-534f6ecb702e"], Cell[TextData[{
     "{",
     StyleBox["n", "TI"],
     ", ",
     StyleBox["m", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"d1c39a85-ee44-4392-bd71-3b827cb0faa6"], 
    Cell[TextData[{
     "a random connected graph with ",
     StyleBox["n", "TI"],
     " vertices and ",
     StyleBox["m", "TI"],
     " edges (clipped to [",
     StyleBox["n", "TI"],
     " \[Minus] 1, ",
     StyleBox["n", "TI"],
     "(",
     StyleBox["n", "TI"],
     " \[Minus] 1)/2]), oriented acyclically; the Hasse diagram keeps fewer \
than ",
     StyleBox["m", "TI"],
     " edges when some are implied"
    }], "TableText",ExpressionUUID->"f3ece74e-65ff-4cc7-83be-52e4e4ef7685"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "af65bc7e-1b10-487e-9fdb-4350955aac1e"], Cell[TextData[{
     StyleBox["n", "TI"],
     ", ",
     Cell[BoxData[
      RowBox[{"Method", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Sprinkling\>\"", ",", " ", "d"}], "}"}]}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "baa74094-2154-435a-b5ee-02023c03a445"]
    }], "TableText",ExpressionUUID->"82692569-39b4-4d2d-99ce-02a811195dc3"], 
    Cell[TextData[{
     StyleBox["n", "TI"],
     " points uniform in the diamond {(",
     StyleBox["x", "TI"],
     ", ",
     StyleBox["t", "TI"],
     ") : |",
     StyleBox["x", "TI"],
     "| < min(",
     StyleBox["t", "TI"],
     ", 1 \[Minus] ",
     StyleBox["t", "TI"],
     ")} of ",
     StyleBox["d", "TI"],
     "-dimensional Minkowski space, ",
     StyleBox["x", "TI"],
     " \[Element] \:211d^(",
     StyleBox["d", "TI"],
     "\[Minus]1), with ",
     StyleBox["u", "TI"],
     " \[Precedes] ",
     StyleBox["v", "TI"],
     " iff ",
     StyleBox["t", "TI"],
     "(",
     StyleBox["v", "TI"],
     ") \[Minus] ",
     StyleBox["t", "TI"],
     "(",
     StyleBox["u", "TI"],
     ") > |",
     StyleBox["x", "TI"],
     "(",
     StyleBox["v", "TI"],
     ") \[Minus] ",
     StyleBox["x", "TI"],
     "(",
     StyleBox["u", "TI"],
     ")|; ",
     Cell[BoxData[
      RowBox[{"Method", " ", "->", " ", "\"\<Sprinkling\>\""}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a3a39902-0845-4ce4-8034-2a908c23de26"],
     " is ",
     StyleBox["d", "TI"],
     " = 2"
    }], "TableText",ExpressionUUID->"d6f3c005-60cd-459c-824e-cd95cc70cb78"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a84e122d-aa60-4ce8-8632-\
ce5fc79cbe55"],

Cell[TextData[{
 "In a transitive percolation the probability that 1 \[Precedes] 2 is ",
 StyleBox["p", "TI"],
 ", since only a direct link can relate them, and the probability that 1 \
\[Precedes] 3 is 1 \[Minus] (1 \[Minus] ",
 StyleBox["p", "TI"],
 ")(1 \[Minus] ",
 StyleBox["p", "TI"],
 "\.b2), a direct link or a path through 2. A sprinkling has ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdd4a2d1-7a5b-471e-a3ce-bad3e0ea4f5f"],
 " the sprinkled point {",
 StyleBox["x", "TI"],
 "1, \[Ellipsis], ",
 StyleBox["x", "TI"],
 "(",
 StyleBox["d", "TI"],
 " \[Minus] 1), ",
 StyleBox["t", "TI"],
 "} for ",
 StyleBox["d", "TI"],
 " \[LessEqual] 3, and {",
 StyleBox["x", "TI"],
 "1, ",
 StyleBox["t", "TI"],
 "} beyond; a sprinkling is the standard model of a causal set that is \
faithfully embedded in Minkowski space."
}], "Notes",ExpressionUUID->"cf67dd45-1ed7-4f47-9eef-17d67819d219"],

Cell[TextData[{
 "The ordering fraction ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["R", "TI"],
 " / (",
 StyleBox["n", "TI"],
 " choose 2) of an order, ",
 StyleBox["R", "TI"],
 " the number of related pairs, estimates the dimension of a sprinkling: \
Myrheim and Meyer showed that its expectation in the causal diamond of ",
 StyleBox["d", "TI"],
 "-dimensional Minkowski space is \[CapitalGamma](",
 StyleBox["d", "TI"],
 " + 1) \[CapitalGamma](",
 StyleBox["d", "TI"],
 "/2) / (2 \[CapitalGamma](3",
 StyleBox["d", "TI"],
 "/2)), which is 1/2 for ",
 StyleBox["d", "TI"],
 " = 2, 8/35 for ",
 StyleBox["d", "TI"],
 " = 3 and 1/10 for ",
 StyleBox["d", "TI"],
 " = 4. The experimental reading ",
 Cell[BoxData["\"\<OrderingFraction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85c57cd0-37c2-456b-b5e5-d87e77866a71"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamond"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamond", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79b26171-7e75-42d8-bd3c-e8e4a5f8da58"],
 " computes it, and ",
 Cell[BoxData["\"\<MyrheimMeyerDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3042e166-3740-4180-a862-116cb601d285"],
 " inverts the formula."
}], "Notes",ExpressionUUID->"6d8ed845-6a26-4b76-841f-a3133f798cf7"]
}, Open  ]],

