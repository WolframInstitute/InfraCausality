Cell["\<\
The ordering fractions of ten sprinklings of 200 points in two and in three \
dimensions, beside the Myrheim\[Dash]Meyer values 1/2 and 8/35.\
\>", "ExampleText",ExpressionUUID->"22bf1cee-8163-43a6-84f7-973b75b1cda2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Mean", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"g", " ", "=", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"RandomCausalGraph", "[", 
             RowBox[{"200", ",", " ", 
              RowBox[{"Method", " ", "->", " ", 
               RowBox[{"{", 
