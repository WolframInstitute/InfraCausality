Cell["\<\
A sprinkling of 100 points into the two-dimensional diamond, in its \
coordinates, with the causal future of event 20.\
\>", "ExampleText",ExpressionUUID->"e07c68dd-5369-40e0-8c42-fa881b5710a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", 
        RowBox[{"100", ",", " ", 
         RowBox[{"Method", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Sprinkling\>\"", ",", " ", "2"}], "}"}]}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalFuture", "[", "20", "]"}], " ", "->", " ", 
        "StandardOrange"}], ",", " ", "20"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d7776c5e-9e15-40c0-9d60-4ceb2f3a0b94"],

