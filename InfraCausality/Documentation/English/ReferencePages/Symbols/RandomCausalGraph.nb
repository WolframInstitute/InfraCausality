             RowBox[{"{", 
              RowBox[{"\"\<Sprinkling\>\"", ",", " ", "3"}], "}"}]}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"g", " ", "|->", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
         RowBox[{"Range", "[", "30", "]"}]}], " ", "&&", " ", 
        RowBox[{"AcyclicGraphQ", "[", "g", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"EdgeCount", "[", "g", "]"}], " ", "==", " ", 
         RowBox[{"EdgeCount", " ", "@", " ", 
          RowBox[{"TransitiveReductionGraph", "[", "g", "]"}]}]}], " ", "&&", 
        "\n", "      ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
          RowBox[{"e", " ", "|->", " ", 
           RowBox[{
            RowBox[{"First", "[", "e", "]"}], " ", "<", " ", 
            RowBox[{"Last", "[", "e", "]"}]}]}]}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89e0d7d9-5f6c-40ce-aa2d-80841dd64e70"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ecc9fe25-ebc1-438b-800b-ac884fbf6294"]
}, Open  ]],

Cell[TextData[{
 "The percolation probabilities: over 2000 percolations of 5 events with ",
 StyleBox["p", "TI"],
 " = 0.3, the frequencies of 1 \[Precedes] 2 and of 1 \[Precedes] 3 are \
within 0.04 of ",
 StyleBox["p", "TI"],
 " = 0.3 and of 1 \[Minus] (1 \[Minus] ",
 StyleBox["p", "TI"],
 ")(1 \[Minus] ",
 StyleBox["p", "TI"],
 "\.b2) = 0.363."
}], "ExampleText",ExpressionUUID->"b01a033c-c172-4b7c-b73a-8a8373bc3aa8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", "0.3"}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gs", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomCausalGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "p"}], "}"}], "]"}], ",", " ", "2000"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"#", ",", " ", "1", ",", " ", "2"}], "]"}], " ", "<", 
            " ", "Infinity"}], "]"}], " ", "&"}], " ", "/@", " ", "gs"}], 
        "]"}], " ", "-", " ", "p"}], "]"}], " ", "<", " ", "0.04"}], " ", "&&",
     "\n", "    ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"#", ",", " ", "1", ",", " ", "3"}], "]"}], " ", "<", 
            " ", "Infinity"}], "]"}], " ", "&"}], " ", "/@", " ", "gs"}], 
        "]"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "p"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"p", "^", "2"}]}], ")"}]}]}], ")"}]}], "]"}], " ", "<", 
     " ", "0.04"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b36e3a98-96ea-4ed4-a21b-1105af93a770"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"736ecb4b-bfce-49c8-aef2-03ab7f6e6621"]
}, Open  ]],

Cell[TextData[{
 "The extremes of the percolation: ",
 StyleBox["p", "TI"],
 " near 1 gives a chain, ",
 StyleBox["p", "TI"],
 " near 0 an antichain."
}], "ExampleText",ExpressionUUID->"6cf86c48-ac06-4627-a115-e1d632e6345b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EdgeList", "[", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"{", 
      RowBox[{"6", ",", " ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "}"}], "]"}], "]"}], " ", "===", " ", 
   RowBox[{"DirectedEdge", " ", "@@@", " ", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"Range", "[", "6", "]"}], ",", " ", "2", ",", " ", "1"}], 
     "]"}]}]}], " ", "&&", " ", 
  RowBox[{
   RowBox[{"EdgeCount", "[", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"{", 
      RowBox[{"6", ",", " ", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "12"}]}]}], "}"}], "]"}], "]"}], " ", "==", " ", 
   "0"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"02c40ab0-9486-4149-b41f-1f020f7ccc26"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c2d04f58-e2a0-4a0a-a64e-d916be57e0e4"]
}, Open  ]],

Cell["\<\
The sprinkled order is the light-cone order of the sprinkled points, in two \
and in three dimensions.\
\>", "ExampleText",ExpressionUUID->"6bdc1fc2-0f75-464c-af82-e59eca5790ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"d", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomCausalGraph", "[", 
           RowBox[{"30", ",", " ", 
            RowBox[{"Method", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Sprinkling\>\"", ",", " ", "d"}], "}"}]}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Permutations", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], " ", "|->", "\n", "      ", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"VertexOutComponent", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"{", "u", "}"}]}], "]"}], ",", " ", "v"}], "]"}], " ", 
           "===", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", 
               RowBox[{"c", "[", "v", "]"}], "]"}], " ", "-", " ", 
              RowBox[{"Last", "[", 
               RowBox[{"c", "[", "u", "]"}], "]"}]}], " ", ">", " ", 
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"Most", "[", 
                RowBox[{"c", "[", "v", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"Most", "[", 
                RowBox[{"c", "[", "u", "]"}], "]"}]}], "]"}]}], ")"}]}]}], 
         "]"}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3eabc419-8d4f-49ac-bf07-0b5be8fd97d3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"75b97087-7334-44a7-b501-f15ecb6d351e"]
}, Open  ]],

Cell["\<\
The Myrheim\[Dash]Meyer ordering fractions: the mean ordering fraction of ten \
sprinklings of 200 points is within 0.02 of 1/2 in two dimensions and of 8/35 \
in three.\
\>", "ExampleText",ExpressionUUID->"21b06b31-036d-47a2-80d0-5e499e444399"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", 
       RowBox[{"8", "/", "35"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "r"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"r", " ", "-", " ", 
        RowBox[{"Mean", " ", "@", " ", 
         RowBox[{"Table", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"g", " ", "=", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
                 RowBox[{"RandomCausalGraph", "[", 
                  RowBox[{"200", ",", " ", 
                   RowBox[{"Method", " ", "->", " ", 
                    RowBox[{"{", 
                    RowBox[{"\"\<Sprinkling\>\"", ",", " ", "d"}], "}"}]}]}], 
                  "]"}]}], ")"}]}], "}"}], ",", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalDiamond", "[", 
                RowBox[{"VertexList", "[", "g", "]"}], "]"}], ",", 
               " ", "\"\<OrderingFraction\>\""}], "]"}]}], "]"}], ",", "\n", 
           "    ", 
           RowBox[{"{", 
            RowBox[{"seed", ",", " ", "10"}], "}"}]}], "]"}]}]}], "]"}], " ", 
      "<", " ", "0.02"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f23cbad0-76ce-4ecd-81c3-a687026602ff"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"7e0bc0ec-4b55-47e1-8a70-5070b3afc0cf"]
}, Open  ]],

Cell[TextData[{
 "The orientation form is connected, and its Hasse diagram has at most ",
 StyleBox["m", "TI"],
 " edges."
}], "ExampleText",ExpressionUUID->"621d750e-b249-4f4f-bd25-1edcc953f8bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Range", "[", "5", "]"}], ",", " ", 
   RowBox[{"seed", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
          RowBox[{"RandomCausalGraph", "[", 
           RowBox[{"{", 
            RowBox[{"25", ",", " ", "40"}], "}"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexCount", "[", "g", "]"}], " ", "==", " ", "25"}], " ", "&&",
        " ", 
       RowBox[{"WeaklyConnectedGraphQ", "[", "g", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeCount", "[", "g", "]"}], " ", "<=", " ", "40"}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"aad87029-8a78-4e24-9135-13b7e886148d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"8db31bce-bc5c-4851-9de0-5ade7c6b5171"]
}, Open  ]]
}, Open  ]],

