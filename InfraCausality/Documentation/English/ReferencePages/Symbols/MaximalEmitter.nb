Cell["\<\
The maximal emitters of every slice (orange) on the diamond lattice, a \
sprinkling into two-dimensional Minkowski space and the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"325e83a6-f473-460c-b1db-af61a3da9f79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Catenate", " ", "@", " ", 
           RowBox[{"Values", " ", "@", " ", 
            RowBox[{"MaximalEmitter", "[", "g", "]"}]}]}], " ", "->", " ", 
          "StandardOrange"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7d16e5c-20b0-4b3f-8523-423425208110"],

