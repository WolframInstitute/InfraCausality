Cell[CellGroupData[{
Cell["MaximalEmitter", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"376846bd-430b-4363-8172-bcd9a56ab0e1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaximalEmitter"]], 
     "paclet:WolframInstitute/InfraCausality/ref/MaximalEmitter", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68b464d3-1222-4467-bb74-38f8a5103db5"],
 "\[LineSeparator]",
 "gives, for each slice ",
 StyleBox["k", "TI"],
 " of the universal foliation, the sorted events of the slice whose causal \
future has the most vertices.",
 "\n"
}], "Usage",ExpressionUUID->"99a8e6c2-1ed7-4632-b0ac-b58df7799f88"],

Cell["\<\
Experimental: extremal events. The notion is unsettled; the function reads \
one count per event and may change.\
\>", "Notes",ExpressionUUID->"42778881-3317-4ce1-81bf-44f41d323a71"],

Cell[TextData[{
 "Definition: for each height ",
 StyleBox["k", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["h", "TI"],
 " of the universal time ",
 StyleBox["t", "TI"],
 ", the maximal emitters of the slice ",
 StyleBox["S", "TI"],
 "(",
 StyleBox["k", "TI"],
 ") are the events ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["S", "TI"],
 "(",
 StyleBox["k", "TI"],
 ") for which the number of events of the causal future ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 "), ",
 StyleBox["v", "TI"],
 " included, is largest. The result is the association ",
 StyleBox["k", "TI"],
 " \[RightArrow] the sorted list of them, keys in increasing order; every \
list is nonempty, and ties keep all their events."
}], "Notes",ExpressionUUID->"03aa19b7-782c-4a85-8f7b-62dbb76e48ea"],

Cell[TextData[{
 "An emitter is an event that can influence the most events: the event of its \
slice whose light reaches furthest. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaximalAbsorber"]], 
    "paclet:WolframInstitute/InfraCausality/ref/MaximalAbsorber", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f753e90-d4bc-4882-9ce5-e34ae2299ccf"],
 " is the time-reversed reading. The slices are those of the universal time, \
counted from the sources, so the emitters of ",
 StyleBox["g", "TI"],
 " are not in general the absorbers of the reversed graph, whose slices are \
counted from the sinks; they are when every event lies on a longest chain, as \
on the two lattices."
}], "Notes",ExpressionUUID->"1e79940d-4df4-4e84-af19-6f5caf8571a7"]
}, Open  ]],

