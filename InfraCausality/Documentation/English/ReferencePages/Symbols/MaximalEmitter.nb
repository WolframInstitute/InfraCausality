Cell["\<\
The keys are the heights of the universal time, and the values are exactly \
the events of each slice with the largest causal future, by brute force.\
\>", "ExampleText",ExpressionUUID->"2c7760b4-231c-4945-95e8-8e281c05da18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"size", " ", "=", " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"VertexOutComponent", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", "v", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{
       RowBox[{
        RowBox[{"Keys", "[", 
         RowBox[{"MaximalEmitter", "[", "g", "]"}], "]"}], " ", "===", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "]"}]}], " ", "&&", 
       "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", 
          RowBox[{"MaximalEmitter", "[", "g", "]"}]}], ",", " ", 
         RowBox[{"Apply", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "vs"}], "}"}], " ", "|->", "\n", 
           "        ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"slice", " ", "=", " ", 
               RowBox[{"RandomInfraSlice", "[", 
                RowBox[{"g", ",", " ", "k"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"vs", " ", "=!=", " ", 
               RowBox[{"{", "}"}]}], " ", "&&", " ", 
              RowBox[{"vs", " ", "===", " ", 
               RowBox[{"Sort", " ", "@", " ", 
                RowBox[{"Select", "[", 
                 RowBox[{"slice", ",", " ", 
                  RowBox[{"v", " ", "|->", " ", 
                   RowBox[{
                    RowBox[{"size", "[", "v", "]"}], " ", "==", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"size", " ", "/@", " ", "slice"}], "]"}]}]}]}], 
                 "]"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73585102-dd8c-4d3d-a04e-5b5a2fd5899b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d794a2ec-3bb1-426d-a0c0-6593d92eec67"]
}, Open  ]],

Cell[TextData[{
 "The size of the causal future read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f066894a-4bc8-4133-b93e-ddc866f18029"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFuture"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40ef3c03-f598-4e76-b3b6-97ef886db0b5"],
 " is the same count."
}], "ExampleText",ExpressionUUID->"1a812106-70fb-4730-9706-ed9bdd1c7da4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", " ", 
          RowBox[{"Length", " ", "@", " ", 
           RowBox[{"VertexOutComponent", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", "v", "}"}]}], "]"}]}]}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dd8f7e90-4387-4d74-ad8b-942099edb1c2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"7b140b67-490c-47c8-b0be-56c6b228b3a8"]
}, Open  ]],

Cell[TextData[{
 "When every event lies on a longest chain, as on the two lattices, the \
emitters of ",
 StyleBox["g", "TI"],
 " are the absorbers of the reversed graph with the heights reversed."
}], "ExampleText",ExpressionUUID->"04b8a702-1ee3-46f3-8b28-6bd515b8c3e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"Max", " ", "@", " ", 
         RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"MaximalEmitter", "[", "g", "]"}], " ", "===", " ", 
       RowBox[{"KeySort", " ", "@", " ", 
        RowBox[{"KeyMap", "[", 
         RowBox[{
          RowBox[{"k", " ", "|->", " ", 
           RowBox[{"h", " ", "-", " ", "k"}]}], ",", " ", 
          RowBox[{"MaximalAbsorber", "[", 
           RowBox[{"ReverseGraph", "[", "g", "]"}], "]"}]}], "]"}]}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9b96f8ae-3da1-4a15-80fb-68da6039ed16"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9d682ecc-4cd4-4f7c-bd92-cd97b1141de7"]
}, Open  ]]
}, Open  ]],

