Cell["\<\
The emitter of the slice at height 1 of the sprinkling with its causal future.\
\>", "ExampleText",ExpressionUUID->"44d11467-4bc1-4aa9-ba3e-330328312406"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{
       RowBox[{"MaximalEmitter", "[", "g", "]"}], "[", "1", "]"}]}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSlice", "[", "1", "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraCausalFuture", "[", "v", "]"}], " ", "->", " ", 
        "StandardOrange"}], ",", " ", "v"}], "}"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"53a1ebd8-c421-463e-817f-56c1625755c0"],

