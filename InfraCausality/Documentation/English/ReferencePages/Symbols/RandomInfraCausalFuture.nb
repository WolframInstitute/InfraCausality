Cell["A set anchor and a proper-time cut on the cylinder lattice.", \
"ExampleText",ExpressionUUID->"510297e7-46ba-411c-9d31-11d53c61e34b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}], ",", " ", "2"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", "s", "]"}]}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", 
           RowBox[{"{", 
            RowBox[{"First", " ", "@", " ", "s"}], "}"}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", 
           RowBox[{"{", 
            RowBox[{"Last", " ", "@", " ", "s"}], "}"}], "]"}]}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "s"}], ",", " ", "2"}], "]"}]}],
            "]"}], ",", " ", 
          RowBox[{"First", " ", "@", " ", "s"}]}], "}"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9e55f6d0-5715-4e0e-a9a1-cb6aab8873fe"],

