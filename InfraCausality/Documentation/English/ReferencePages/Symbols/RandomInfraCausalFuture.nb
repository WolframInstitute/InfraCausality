Cell[TextData[{
 "The draw involves no randomness, since there is nothing to choose; the \
sampler exists so that the set heads and the chain heads are drawn through \
the same interface. The option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a71734f-4529-4a0f-b1f8-eb22d2fc1c0c"],
 " is accepted with the values of the chain samplers (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "925d3eb6-975e-4cc4-be8e-0280f80528d2"],
 ") and changes nothing here; ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomChoice"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "088c7d67-86fc-4329-be3f-dfcda28edea1"],
 " together with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3158513-d9fe-4233-b132-14b150e29311"],
 " stays unevaluated, as it does for the chain samplers."
}], "Notes",ExpressionUUID->"4aace36c-9cc0-43ea-bac2-58a32acbf00d"],

Cell[TextData[{
 "The anchor is read through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDensity"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "85ca788f-2778-4f68-8970-e320b7381aad"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", 
     StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6415540d-cab8-4e63-80c7-e5bd80f30b84"],
 " gives the union of the causal futures, and the proper-time cut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8418a1e7-863e-4c61-b6a5-ac9470376ca8"],
 " gives the events of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") within proper time ",
 StyleBox["t", "TI"],
 ". The shortcut ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a06cfc32-ef97-4bcb-8851-d0cdb5038b41"],
 " wraps any anchor that is not a head in ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFuture"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFuture", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d72042-99c6-4830-9c72-ad9e1b3d19a0"],
 "."
}], "Notes",ExpressionUUID->"a9ed489a-207e-4b16-a83d-3b276627091a"],

