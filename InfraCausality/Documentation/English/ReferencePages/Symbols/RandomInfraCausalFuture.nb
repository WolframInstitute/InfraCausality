Cell[TextData[{
 "The support is the out-component of the event, it passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFutureQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da4baef3-aec3-49c4-aee3-e5538a6587b8"],
 ", and it is the member that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97ea3ee8-dc45-4a11-80c4-9e10f33f53a5"],
 " recognises."
}], "ExampleText",ExpressionUUID->"1b347ce7-24ca-4d9b-b1a5-1b474eceb687"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"future", " ", "=", " ", 
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "v", "]"}]}], "]"}]}], "}"}],
            ",", "\n", "        ", 
           RowBox[{
            RowBox[{"future", " ", "===", " ", 
             RowBox[{"Sort", "[", 
              RowBox[{"VertexOutComponent", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"{", "v", "}"}]}], "]"}], "]"}]}], " ", "&&", " ", 
            RowBox[{"InfraCausalFutureQ", "[", 
             RowBox[{"g", ",", " ", "future"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{"InfraMemberQ", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", " ", 
              "future"}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84c319a0-89e9-4b38-883e-08133bf6c2b1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"02a0ffcb-1560-4899-93c5-607859b4a3d8"]
}, Open  ]],

Cell[TextData[{
 "The number of events of the support is the causal volume, the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2329bd-88ac-4be3-a639-8f98eefff7fc"],
 " of the head, and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eeb4633-0bde-4e33-9cbb-f85107981311"],
 " has ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "852a4de1-027a-484d-b28b-fcdc85b27f60"],
 " members."
}], "ExampleText",ExpressionUUID->"be5d4d7d-564b-430e-a45c-ded2f1ddd727"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "v"}], "]"}], "]"}], " ", "==", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}]}], " ", "&&", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"Length", "[", 
