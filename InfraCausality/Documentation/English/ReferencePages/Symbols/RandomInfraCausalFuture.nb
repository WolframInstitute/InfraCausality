Cell[TextData[{
 "Definition: the members of a set head are the vertex sets it denotes, and a \
causal future denotes one set, its support ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["v", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 "}. The sampler returns that support as a sorted vertex list, the keys of ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalFuture", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff96461-c5d1-4b50-95d5-a9833454e040"],
 "."
}], "Notes",ExpressionUUID->"ad84c48d-9233-4248-bed8-15aae3225d4d"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb4275e3-0a10-464f-a3c2-2d57da1c4c6e"],
 " sampler shares. With a single member it reads:"
}], "Notes",ExpressionUUID->"dfdd063c-c160-4feb-97c4-de7ac34cf163"],

