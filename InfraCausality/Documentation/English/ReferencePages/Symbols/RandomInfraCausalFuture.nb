Cell["\<\
The causal future of a set of events is the union of their causal futures.\
\>", "ExampleText",ExpressionUUID->"eb928ed3-57b0-47b2-9c70-08df1d5949eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "2", "]"}]}], "]"}], ",", " ", "2"}],
            "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraCausalFuture", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCausalFuture", "[", "s", "]"}]}], "]"}], " ", "===", 
       " ", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", "s"}]}], "]"}], ",", " ", 
         RowBox[{"RandomInfraCausalFuture", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Last", " ", "@", " ", "s"}]}], "]"}]}], "]"}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e06f48b4-cb34-4da5-8c06-840b7e59592a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0b6a40c6-88e5-48f8-b320-e6fd3f4fadd1"]
}, Open  ]],

Cell[TextData[{
 "The proper-time cuts grow with ",
 StyleBox["t", "TI"],
 " and reach the whole causal future at the height of the future."
}], "ExampleText",ExpressionUUID->"d037b97e-eec4-4ff8-a91c-1a7cf6c3bab5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"height", " ", "=", " ", 
        RowBox[{"Max", " ", "@", " ", 
         RowBox[{"UniversalTime", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
            " ", "\"\<Subgraph\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"{", 
       RowBox[{"cuts", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomInfraCausalFuture", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalFuture", "[", 
             RowBox[{"v", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "height"}], "}"}]}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"cuts", ",", " ", "2", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Apply", "[", 
          RowBox[{
           RowBox[{"SubsetQ", "[", 
            RowBox[{"#2", ",", " ", "#1"}], "]"}], " ", "&"}], "]"}]}], "]"}],
        " ", "&&", " ", 
       RowBox[{
        RowBox[{"Last", "[", "cuts", "]"}], " ", "===", " ", 
        RowBox[{"RandomInfraCausalFuture", "[", 
         RowBox[{"g", ",", " ", "v"}], "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"0fc21ce3-6080-4d79-a966-68a14b1e470b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"652b20a0-3781-4674-8805-5f3a51256126"]
}, Open  ]]
}, Open  ]],

