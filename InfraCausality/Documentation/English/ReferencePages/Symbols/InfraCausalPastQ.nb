Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["S", "TI"],
 " is a causal past when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and ",
 StyleBox["S", "TI"],
 " = ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 "} for some ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["S", "TI"],
 ". Order and repetition in the list do not matter."
}], "Notes",ExpressionUUID->"30f9e9f7-d845-4178-9a2b-bf16ad890ba6"],

Cell[TextData[{
 "Such a ",
 StyleBox["v", "TI"],
 " is the greatest element of ",
 StyleBox["S", "TI"],
 ", and it is unique. So the predicate says that ",
 StyleBox["S", "TI"],
 " is a down-set, closed under passing to the past, with a greatest element; \
the causal past of two incomparable events fails."
}], "Notes",ExpressionUUID->"c993b3c1-38b4-435b-a370-e1af0223ea03"],

Cell[TextData[{
 "The predicate is the time reverse of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFutureQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "903304a4-1fc5-4b95-8504-ec1486d0b7b1"],
 ": ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPastQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "S"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbf1390-0d65-45b2-ac70-88e6c5fa5c77"],
 " equals ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFutureQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"`ReverseGraph`", "[", 
     StyleBox["g", "TI"], "]"}], ",", " ", "S"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4070df5-3c72-4961-b61e-5d751a01b1a3"],
 ". It takes a set, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPastQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalPast", "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "623c12c6-b4ba-4e7e-b575-56c521d1c1e8"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"1ce7f47c-330b-49cf-99ee-a7cc2ee41273"],

Cell[TextData[{
 "A set that is both a causal past and a causal future, ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 "), is the causal diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] and passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalDiamondQ", 
