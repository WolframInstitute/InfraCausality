Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["S", "TI"],
 " is a causal past when it is nonempty, its elements are events of ",
 StyleBox["g", "TI"],
 ", and ",
 StyleBox["S", "TI"],
 " = ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["v", "TI"],
 ") = {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 "} for some ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["S", "TI"],
 ". Order and repetition in the list do not matter."
}], "Notes",ExpressionUUID->"1658177e-bbe8-4de6-8657-8931d7463f0c"],

Cell[TextData[{
 "Such a ",
 StyleBox["v", "TI"],
 " is the greatest element of ",
 StyleBox["S", "TI"],
 ", and it is unique. So the predicate says that ",
 StyleBox["S", "TI"],
 " is a down-set, closed under passing to the past, with a greatest element; \
the causal past of two incomparable events fails."
}], "Notes",ExpressionUUID->"27e23216-3383-4115-a2fd-d94b7647cfe6"],

Cell[TextData[{
 "The predicate is the time reverse of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalFutureQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb35b0c9-8df9-4165-830d-6aabc5dd9771"],
 ": ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPastQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "S"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a2c759a-6f66-46dc-a54a-b01aad7da240"],
 " equals ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalFutureQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalFutureQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"`ReverseGraph`", "[", 
     StyleBox["g", "TI"], "]"}], ",", " ", "S"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03f9d31a-3912-440e-b8eb-c82a933fa19d"],
 ". It takes a set, never an object; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCausalPastQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraCausalPastQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCausalPast", "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cc2bf4c-1aed-4a6d-89e1-4a237a597df4"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"75b6bb17-c3ba-49ae-9b3d-bf5f988f6346"],

Cell[TextData[{
 "A set that is both a causal past and a causal future, ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 "), is the causal diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] and passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCausalDiamondQ"]], 
