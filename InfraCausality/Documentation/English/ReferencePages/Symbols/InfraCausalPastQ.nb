}, Open  ]],

Cell["\<\
The causal past of two events of the cylinder lattice has two maximal events \
and fails; the past of each one passes.\
\>", "ExampleText",ExpressionUUID->"bed37ffe-a12d-4dbe-b942-050d097847a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "4", "]"}], ",", " ", "2"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "set", "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraCausalPastQ", "[", 
         RowBox[{"g", ",", " ", "set"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"set", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalPast", "[", 
              RowBox[{"First", " ", "@", " ", "s"}], "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalPast", "[", 
              RowBox[{"Last", " ", "@", " ", "s"}], "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalPast", "[", "s", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c06e64fc-4e65-4fc6-a064-27a0f999c7ea"],

