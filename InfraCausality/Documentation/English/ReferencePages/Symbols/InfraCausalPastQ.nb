Cell["\<\
The causal past of every event passes, and the event is the unique greatest \
element of the set.\
\>", "ExampleText",ExpressionUUID->"77f9498f-9445-4fa9-8930-aa8762847b9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"past", " ", "=", " ", 
             RowBox[{"RandomInfraCausalPast", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"InfraCausalPastQ", "[", 
             RowBox[{"g", ",", " ", "past"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"past", ",", " ", 
               RowBox[{"e", " ", "|->", " ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"VertexInComponent", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "past"}], 
                 "]"}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", "v", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b36c1e01-bda3-4612-b9d8-b641eeaf0148"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e4cce540-a417-4c73-9b22-cc6713dd8f6f"]
}, Open  ]],

Cell["\<\
The predicate on a graph is the future predicate on the reversed graph.\
\>", "ExampleText",ExpressionUUID->"808992ad-a0f9-4638-8904-75ff2487d3de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"sets", ",", " ", 
        RowBox[{"set", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraCausalPastQ", "[", 
           RowBox[{"g", ",", " ", "set"}], "]"}], " ", "===", " ", 
          RowBox[{"InfraCausalFutureQ", "[", 
           RowBox[{
            RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", "set"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"eba4829e-ff82-4b49-a7e3-64a13e749c65"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2f81a9e5-02ce-4416-816d-a261907f9d7c"]
}, Open  ]],

Cell["\<\
A set that passes is a down-set: every in-neighbour of one of its events is \
one of its events.\
\>", "ExampleText",ExpressionUUID->"6907b1f0-22f8-42f4-92bd-31603b84e14f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"sets", ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalPastQ", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", 
        " ", 
        RowBox[{"set", " ", "|->", "\n", "      ", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"Union", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"VertexInComponent", "[", 
                RowBox[{"g", ",", " ", "#", ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ",
               "set"}], ")"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8885839c-ceb5-4be7-a8d2-4b642a09e5e9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a67b0fbb-f962-4b66-b2da-da766346f065"]
}, Open  ]]
}, Open  ]],

