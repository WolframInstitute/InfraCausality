Cell["\<\
On each substrate: the causal past of an event, the causal past of two \
incomparable events, and a proper-time cut.\
\>", "ExampleText",ExpressionUUID->"5698081d-8dd1-4ad1-a9af-cc35a16bc95b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "4", "]"}], ",", " ", "2"}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalPast", "[", 
             RowBox[{"First", " ", "@", " ", "s"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalPast", "[", "s", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalPast", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "s"}], ",", " ", "1"}], "]"}], ",",
             " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a98950d2-2e75-4ef9-a3b6-15e8d6c195de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}]}], "}"}]], "Output",
