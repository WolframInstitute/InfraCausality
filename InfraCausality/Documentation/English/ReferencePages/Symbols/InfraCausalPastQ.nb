Cell["\<\
The causal past of two events of the cylinder lattice has two maximal events \
and fails; the past of each one passes.\
\>", "ExampleText",ExpressionUUID->"082164ac-63e5-4185-9274-8bdf66eb0c2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}], ",", " ", "2"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "set", "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraCausalPastQ", "[", 
         RowBox[{"g", ",", " ", "set"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"set", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraCausalPast", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", "s"}]}], "]"}], ",", " ", 
          RowBox[{"RandomInfraCausalPast", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "s"}]}], "]"}], ",", " ", 
          RowBox[{"RandomInfraCausalPast", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalPast", "[", "s", "]"}]}], "]"}]}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"00adf096-7504-409d-9751-909797ec5f9a"],

