Cell["\<\
On each substrate: the causal past of an event, the causal past of two \
incomparable events, and a proper-time cut.\
\>", "ExampleText",ExpressionUUID->"39cccbeb-6404-455b-8d19-a3c8901ea0b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}], ",", " ", "2"}], 
          "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalPast", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", "s"}]}], "]"}]}], "]"}], ",", "\n",
        "     ", 
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalPast", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalPast", "[", "s", "]"}]}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"InfraCausalPastQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomInfraCausalPast", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCausalPast", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", "s"}], ",", " ", "1"}], "]"}]}], 
          "]"}]}], "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94ac880d-0d19-453d-bb4a-65ccfe0d1dab"],

Cell[BoxData[
 RowBox[{"{", 
