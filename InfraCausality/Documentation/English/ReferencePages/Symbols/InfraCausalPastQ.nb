Cell["\<\
The causal past of every event passes, and the event is the unique greatest \
element of the set.\
\>", "ExampleText",ExpressionUUID->"7bb54ad0-f72b-4a46-923f-6fb769914846"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"past", " ", "=", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraCausalPast", "[", "v", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"InfraCausalPastQ", "[", 
             RowBox[{"g", ",", " ", "past"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"past", ",", " ", 
               RowBox[{"e", " ", "|->", " ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"VertexInComponent", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", "past"}], 
                 "]"}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", "v", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7d13bf0f-06d5-4952-8d3a-a936568bb4c8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"990e1203-ad28-415c-b4d2-406744b51e1e"]
}, Open  ]],

Cell["\<\
The predicate on a graph is the future predicate on the reversed graph.\
\>", "ExampleText",ExpressionUUID->"f6de706d-8b0a-472d-9bb3-6fa4ef51d9ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "#", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "#", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"sets", ",", " ", 
        RowBox[{"set", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraCausalPastQ", "[", 
           RowBox[{"g", ",", " ", "set"}], "]"}], " ", "===", " ", 
          RowBox[{"InfraCausalFutureQ", "[", 
           RowBox[{
            RowBox[{"ReverseGraph", "[", "g", "]"}], ",", " ", "set"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"31b60a6d-2687-47e4-81a0-61a199cdd337"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4ed92f9a-3acb-437e-bb58-2af0d13fe2c3"]
}, Open  ]],

Cell["\<\
A set that passes is a down-set: every in-neighbour of one of its events is \
one of its events.\
\>", "ExampleText",ExpressionUUID->"86fbf9fb-a2d3-43d3-bb42-31a9643894a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sets", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "#", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalPast", "[", "#", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"sets", ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalPastQ", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", 
        " ", 
        RowBox[{"set", " ", "|->", "\n", "      ", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{"set", ",", " ", 
           RowBox[{"Union", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"VertexInComponent", "[", 
                RowBox[{"g", ",", " ", "#", ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ",
               "set"}], ")"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c5646010-e59e-4526-8887-03a665b2b5e4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c1426e57-80ac-4bdf-9142-d668fc522ce8"]
}, Open  ]]
}, Open  ]],

