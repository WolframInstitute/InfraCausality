Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<SquareTilingSprayGraph\>\"", ",", " ", "\"\<Small\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<wm3467\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9d14c884-f956-4667-a74d-ef2e7eb00bed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", "=", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\<\"SquareTilingGraph\"\>", ",", "\<\"Small\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", 
        RowBox[{"First", "[", 
         RowBox[{"GraphCenter", "[", "g", "]"}], "]"}]}], "]"}]}], "]"}],
    HoldForm], ",", 
   TagBox[
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{
         "PacletObject", "[", "\<\"WolframInstitute/InfraCausality\"\>", 
          "]"}], "[", 
         RowBox[{"\<\"AssetLocation\"\>", 
          ",", "\<\"WolframModelCausalGraphs\"\>"}], "]"}], "]"}], 
       "[", "\<\"wm3467\"\>", "]"}], "[", "\<\"Small\"\>", "]"}], "]"}],
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a87d621b-44c5-4b4f-8b6f-df72382ff06c"]
}, Open  ]],

