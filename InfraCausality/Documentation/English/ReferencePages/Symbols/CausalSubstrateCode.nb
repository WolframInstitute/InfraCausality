Cell[TextData[{
 "The code is wrapped in ",
 Cell[BoxData["HoldForm"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b61e92f6-7736-4633-9aab-fa9e1511f435"],
