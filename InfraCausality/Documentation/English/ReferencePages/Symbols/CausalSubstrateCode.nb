Cell["\<\
For every name the released code has the vertices and the edges of the \
substrate.\
\>", "ExampleText",ExpressionUUID->"7cc094c2-3101-4346-9576-eeacebe5bf23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"VertexList", "[", "h", "]"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"EdgeList", "[", "h", "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"df138df8-a8c1-4872-88ff-a4e584cd38a0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a7a3419-4f09-436b-bae0-552ead886f83"]
}, Open  ]],

Cell["\<\
The code is free of private symbols, and the seeded codes rebuild the same \
random substrate however the ambient generator is seeded.\
\>", "ExampleText",ExpressionUUID->"0e1e8ac0-57bf-42fa-b2c3-c333d2923785"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "  ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{
          RowBox[{"Context", "[", 
           RowBox[{"Unevaluated", " ", "@", " ", "s"}], "]"}], ",", 
          " ", "\"\<Private\>\""}], "]"}]}], ",", " ", "Infinity", ",", " ", 
       RowBox[{"Heads", " ", "->", " ", "True"}]}], "]"}]}]}], "]"}], " ", "&&",
   "\n", "  ", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
      " ", "\"\<MinkowskiSprinkling3D\>\"", ",", 
      " ", "\"\<PercolationGraph\>\""}], "}"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "    ", 
     RowBox[{
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3678169d-ee92-4de9-a11d-b1f7c769798c"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"18fe1e49-6a31-4a89-86a3-ff20255945aa"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba80d94b-4c19-4b72-bed3-1820495b6b25"],
 " the released code carries the coordinates of the substrate."
}], "ExampleText",ExpressionUUID->"af3122ea-acdb-484c-b3e2-e83fe26b4be6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"ReleaseHold", " ", "@", " ", 
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "]"}], " ", "==", "\n", "    ", 
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
