Cell[TextData[{
 "The code is wrapped in ",
 Cell[BoxData["HoldForm"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5c7bc9e-e667-4197-972a-631a8af3e5bc"],
