Cell["\<\
For every name the released code has the vertices and the edges of the \
substrate.\
\>", "ExampleText",ExpressionUUID->"02b0d33e-7fb4-4200-9181-5ee238bcd35e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"VertexList", "[", "h", "]"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"EdgeList", "[", "h", "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"1a460e3f-eee3-4b94-addf-3f6be6be9372"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c6adbcd1-6a45-4c80-a8f8-303f0ad0a6f1"]
}, Open  ]],

Cell["\<\
The code is free of private symbols, and the seeded codes rebuild the same \
random substrate however the ambient generator is seeded.\
\>", "ExampleText",ExpressionUUID->"c0b19db9-c6b3-4d68-ba8a-32144399b450"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "  ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{
          RowBox[{"Context", "[", 
           RowBox[{"Unevaluated", " ", "@", " ", "s"}], "]"}], ",", 
          " ", "\"\<Private\>\""}], "]"}]}], ",", " ", "Infinity", ",", " ", 
       RowBox[{"Heads", " ", "->", " ", "True"}]}], "]"}]}]}], "]"}], " ", "&&",
   "\n", "  ", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
      " ", "\"\<MinkowskiSprinkling3D\>\"", ",", 
      " ", "\"\<PercolationGraph\>\""}], "}"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "    ", 
     RowBox[{
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0f2f3036-dd03-4b58-b626-a67245eff8be"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2e1fce97-3177-4746-b93f-596ec261199a"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3790b7c-b913-4eb9-a302-766ff1641a54"],
 " the released code carries the coordinates of the substrate."
}], "ExampleText",ExpressionUUID->"b5eff8f6-79c6-4898-8274-f5bc427e6e2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"ReleaseHold", " ", "@", " ", 
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "]"}], " ", "==", "\n", "    ", 
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"52d8acb1-08c2-4a85-a99c-a8609324a569"],

