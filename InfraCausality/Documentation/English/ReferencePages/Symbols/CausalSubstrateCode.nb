  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "59ccd841-fdb4-4986-8bf7-d11075dcd65a"],
