 Cell[BoxData["ReleaseHold"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "223470d3-669a-4738-a328-c3389c049771"],
 " evaluates it. It contains only public symbols: a lattice is an explicit ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dd8fa7f-50b5-457e-9d47-e0a6fc053943"],
