Cell["\<\
The code of the sprinkling: a fixed seed and a call to the random sprinkling.\
\
\>", "ExampleText",ExpressionUUID->"78483361-4257-412e-a831-1b246de7e3ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"41a12e37-0ef1-4aae-8d5a-338bea7dc22e"],

Cell[BoxData[
 TagBox[
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "102", "]"}], ";", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"25", ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\<\"Sprinkling\"\>", ",", "2"}], "}"}]}]}], "]"}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6735ee93-0e9d-4202-bce8-4c5a24408ccf"]
}, Open  ]],

Cell["The code of the diamond lattice.", "ExampleText",ExpressionUUID->"b49dc7f0-59da-4eab-8b32-ba44a3cea6b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"88f3b66e-bbdb-482f-970c-c09b07a09b78"],

Cell[BoxData[
 TagBox[
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Catenate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "j"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"j", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"VertexCoordinates", "\[Rule]", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"j", "-", "i"}], "2"], ",", 
          FractionBox[
           RowBox[{"i", "+", "j"}], "2"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}]}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"eedb0704-1748-4a4c-8b69-d46e8bcabce2"]
}, Open  ]],

