  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", "\[Ellipsis]"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851250f6-406c-421d-8310-0b90efcf08cb"],
