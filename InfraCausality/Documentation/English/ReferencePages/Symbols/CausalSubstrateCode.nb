Cell["\<\
For every name the released code has the vertices and the edges of the \
substrate.\
\>", "ExampleText",ExpressionUUID->"177fa262-1ad3-4964-91bb-5aa9e2030fc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"VertexList", "[", "h", "]"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"EdgeList", "[", "h", "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"0e1bbe64-0596-450f-aedb-65915d2f3d6d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ed756dad-adce-4ae4-b029-0f9ee5f5cc4e"]
}, Open  ]],

Cell["\<\
The code is free of private symbols, and the seeded codes rebuild the same \
random substrate however the ambient generator is seeded.\
\>", "ExampleText",ExpressionUUID->"371e42b7-8509-455e-aa0d-661f70302778"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "  ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{
          RowBox[{"Context", "[", 
           RowBox[{"Unevaluated", " ", "@", " ", "s"}], "]"}], ",", 
          " ", "\"\<Private\>\""}], "]"}]}], ",", " ", "Infinity", ",", " ", 
       RowBox[{"Heads", " ", "->", " ", "True"}]}], "]"}]}]}], "]"}], " ", "&&",
   "\n", "  ", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
      " ", "\"\<MinkowskiSprinkling3D\>\"", ",", 
      " ", "\"\<PercolationGraph\>\""}], "}"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "    ", 
     RowBox[{
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"93c112f9-1548-4081-9079-51884c5dea04"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b8d84d56-9766-4306-b410-413e8022fda3"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10abc67d-c17a-408b-b4bd-8ebdf341e1e0"],
 " the released code carries the coordinates of the substrate."
}], "ExampleText",ExpressionUUID->"7832a3aa-5414-4f17-8f5d-db17ce4c29ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"ReleaseHold", " ", "@", " ", 
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "]"}], " ", "==", "\n", "    ", 
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
