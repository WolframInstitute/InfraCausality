Cell[TextData[{
 "The code is wrapped in ",
 Cell[BoxData["HoldForm"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7a55465-e19f-46a0-b357-e0b85f5260d4"],
