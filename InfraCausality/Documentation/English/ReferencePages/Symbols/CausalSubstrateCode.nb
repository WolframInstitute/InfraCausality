Cell["\<\
For every name the released code has the vertices and the edges of the \
substrate.\
\>", "ExampleText",ExpressionUUID->"2d611416-8a10-4bec-a683-e12a2d1c8aac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"CausalSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", " ", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"VertexList", "[", "h", "]"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"EdgeList", "[", "g", "]"}], " ", "===", " ", 
        RowBox[{"EdgeList", "[", "h", "]"}]}]}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"0b4f7d90-a6eb-4456-92e0-6b3442efbee4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6b69777a-c4f0-4077-a29c-e32d83294d0d"]
}, Open  ]],

Cell["\<\
The code is free of private symbols, and the seeded codes rebuild the same \
random substrate however the ambient generator is seeded.\
\>", "ExampleText",ExpressionUUID->"6542de60-9f1a-4048-9968-77860d3b86d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "  ", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{
          RowBox[{"Context", "[", 
           RowBox[{"Unevaluated", " ", "@", " ", "s"}], "]"}], ",", 
          " ", "\"\<Private\>\""}], "]"}]}], ",", " ", "Infinity", ",", " ", 
       RowBox[{"Heads", " ", "->", " ", "True"}]}], "]"}]}]}], "]"}], " ", "&&",
   "\n", "  ", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
      " ", "\"\<MinkowskiSprinkling3D\>\"", ",", 
      " ", "\"\<PercolationGraph\>\""}], "}"}], ",", " ", 
    RowBox[{"name", " ", "|->", "\n", "    ", 
     RowBox[{
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
         RowBox[{"ReleaseHold", " ", "@", " ", 
          RowBox[{"CausalSubstrateCode", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ")"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a12e0e00-0d11-4417-9ec2-861fa7085807"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f2235ade-514b-4297-aa5f-31fb45290942"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fca092-9642-4bd5-9718-3f1f45c559f4"],
 " the released code carries the coordinates of the substrate."
}], "ExampleText",ExpressionUUID->"6715dd67-1110-49d5-a283-557530514b07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"ReleaseHold", " ", "@", " ", 
       RowBox[{"CausalSubstrateCode", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "]"}], " ", "==", "\n", "    ", 
     RowBox[{"GraphEmbedding", "[", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ba7b875b-7086-4864-9646-40bcd3570d9a"],

