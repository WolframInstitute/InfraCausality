Cell["\<\
The code of the sprinkling: a fixed seed and a call to the random sprinkling.\
\
\>", "ExampleText",ExpressionUUID->"953022ff-2073-4715-90c7-d3bf2f884e2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"31837ccc-f2c4-4fd8-8afb-d3a0345f5a45"],

Cell[BoxData[
 TagBox[
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "102", "]"}], ";", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"25", ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\<\"Sprinkling\"\>", ",", "2"}], "}"}]}]}], "]"}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"22c0d0a8-b9c4-4f93-a986-c507ff27faef"]
}, Open  ]],

Cell["The code of the diamond lattice.", "ExampleText",ExpressionUUID->"f26d0a86-b919-417c-b611-2b36c9456e67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4df23a52-c71d-4bab-a4b1-f147d4c4cd38"],

Cell[BoxData[
 TagBox[
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Catenate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "j"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"j", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"VertexCoordinates", "\[Rule]", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"j", "-", "i"}], "2"], ",", 
          FractionBox[
           RowBox[{"i", "+", "j"}], "2"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}]}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e5b00e39-39b9-433c-a19c-dece4513554d"]
}, Open  ]],

Cell["The code of a spray graph and of a Wolfram model entry.", "ExampleText",ExpressionUUID->"c450e8c2-761e-42e2-a9c0-31548124f210"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<SquareTilingSprayGraph\>\"", ",", " ", "\"\<Small\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<wm3467\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0640e1a5-ade7-4693-95fa-c218a1c4ea08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", "=", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\<\"SquareTilingGraph\"\>", ",", "\<\"Small\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", 
        RowBox[{"First", "[", 
         RowBox[{"GraphCenter", "[", "g", "]"}], "]"}]}], "]"}]}], "]"}],
    HoldForm], ",", 
   TagBox[
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{
         "PacletObject", "[", "\<\"WolframInstitute/InfraCausality\"\>", 
          "]"}], "[", 
         RowBox[{"\<\"AssetLocation\"\>", 
          ",", "\<\"WolframModelCausalGraphs\"\>"}], "]"}], "]"}], 
       "[", "\<\"wm3467\"\>", "]"}], "[", "\<\"Small\"\>", "]"}], "]"}],
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"35c8223b-08a5-4b1b-9b9f-b77470ffcf98"]
}, Open  ]],

