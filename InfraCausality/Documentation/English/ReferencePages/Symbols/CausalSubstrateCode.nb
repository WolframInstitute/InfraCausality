Cell[TextData[{
 "The code is wrapped in ",
 Cell[BoxData["HoldForm"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9982d66b-956e-4314-8713-cee4699ad9a7"],
