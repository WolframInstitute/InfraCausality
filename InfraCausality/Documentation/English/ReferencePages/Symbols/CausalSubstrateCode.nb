    RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", "\[Ellipsis]"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c4397e-c27f-4cc0-85e0-3b410f527772"],
 ", a spray graph a ",
