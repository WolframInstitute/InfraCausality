Cell["\<\
The code of the sprinkling: a fixed seed and a call to the random sprinkling.\
\
\>", "ExampleText",ExpressionUUID->"9050a0e3-0288-40c8-a702-805c6b59816d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"05324809-e351-4b9d-a68b-6cb70b48a3b7"],

Cell[BoxData[
 TagBox[
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "102", "]"}], ";", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"25", ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\<\"Sprinkling\"\>", ",", "2"}], "}"}]}]}], "]"}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"17334328-c446-4a9d-b1a5-7ce36629fd1b"]
}, Open  ]],

Cell["The code of the diamond lattice.", "ExampleText",ExpressionUUID->"c185a0f9-a701-4f2e-90d6-854b7c75adcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"07b75b56-a27d-4e99-a71c-18e3cb233d66"],

Cell[BoxData[
 TagBox[
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Catenate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "j"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"j", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"VertexCoordinates", "\[Rule]", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"j", "-", "i"}], "2"], ",", 
          FractionBox[
           RowBox[{"i", "+", "j"}], "2"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}]}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8b61511b-fd4c-4988-b650-1a326bf09576"]
}, Open  ]],

Cell["The code of a spray graph and of a Wolfram model entry.", "ExampleText",ExpressionUUID->"e3a4a434-8c18-4d17-9b05-f70233b54034"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<SquareTilingSprayGraph\>\"", ",", " ", "\"\<Small\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<wm3467\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"46a96fb7-de3c-4fba-b4f4-f857daca5439"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", "=", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\<\"SquareTilingGraph\"\>", ",", "\<\"Small\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", 
        RowBox[{"First", "[", 
         RowBox[{"GraphCenter", "[", "g", "]"}], "]"}]}], "]"}]}], "]"}],
    HoldForm], ",", 
   TagBox[
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{
         "PacletObject", "[", "\<\"WolframInstitute/InfraCausality\"\>", 
          "]"}], "[", 
         RowBox[{"\<\"AssetLocation\"\>", 
          ",", "\<\"WolframModelCausalGraphs\"\>"}], "]"}], "]"}], 
       "[", "\<\"wm3467\"\>", "]"}], "[", "\<\"Small\"\>", "]"}], "]"}],
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"086c15cd-f745-4712-bce2-91c31081c641"]
}, Open  ]],

