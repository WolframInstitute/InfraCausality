Cell["\<\
The code of the sprinkling: a fixed seed and a call to the random sprinkling.\
\
\>", "ExampleText",ExpressionUUID->"f3b502c9-066a-4148-8882-2d4abbc6d9d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"08f8ef5b-26bd-4bf8-863c-1f320fea8489"],

Cell[BoxData[
 TagBox[
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "102", "]"}], ";", 
    RowBox[{"RandomCausalGraph", "[", 
     RowBox[{"25", ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\<\"Sprinkling\"\>", ",", "2"}], "}"}]}]}], "]"}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"115ad8a2-d6c0-40df-aaea-72dc924a0a2e"]
}, Open  ]],

Cell["The code of the diamond lattice.", "ExampleText",ExpressionUUID->"9b699a78-2fe6-46ab-9ef3-c798ee2013a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateCode", "[", 
  RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"400fcd9c-fcda-4138-9fd2-b07d336e72dd"],

Cell[BoxData[
 TagBox[
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Catenate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "j"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"j", "<", "6"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[DirectedEdge]", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"VertexCoordinates", "\[Rule]", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"j", "-", "i"}], "2"], ",", 
          FractionBox[
           RowBox[{"i", "+", "j"}], "2"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}]}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0a029691-dd44-4433-a65c-dd4ee63feb1d"]
}, Open  ]],

Cell["The code of a spray graph and of a Wolfram model entry.", "ExampleText",ExpressionUUID->"7f9abcb2-1aee-4659-af11-0588ee5a7d2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<SquareTilingSprayGraph\>\"", ",", " ", "\"\<Small\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"CausalSubstrateCode", "[", 
    RowBox[{"\"\<wm3467\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3fc70294-f3e4-45f5-a2cb-f67702c89022"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", "=", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\<\"SquareTilingGraph\"\>", ",", "\<\"Small\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", 
        RowBox[{"First", "[", 
         RowBox[{"GraphCenter", "[", "g", "]"}], "]"}]}], "]"}]}], "]"}],
    HoldForm], ",", 
   TagBox[
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{
         "PacletObject", "[", "\<\"WolframInstitute/InfraCausality\"\>", 
          "]"}], "[", 
         RowBox[{"\<\"AssetLocation\"\>", 
          ",", "\<\"WolframModelCausalGraphs\"\>"}], "]"}], "]"}], 
       "[", "\<\"wm3467\"\>", "]"}], "[", "\<\"Small\"\>", "]"}], "]"}],
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a3cea6b0-3ff8-4d19-9d97-7f107ec7a50a"]
}, Open  ]],

