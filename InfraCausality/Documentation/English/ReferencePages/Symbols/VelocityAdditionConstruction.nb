Cell[TextData[{
 "In proper times, Bob's reception is ",
 StyleBox["k", "TI"],
 "1 times Alice's emission and Carol's is ",
 StyleBox["k", "TI"],
 "2 times Bob's."
}], "ExampleText",ExpressionUUID->"38dcaf0f-eaab-40f6-b00f-7390b14b3f40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"vsum", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"v1", " ", "v2"}]}], ")"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], " ", "-", " ", 
           
           RowBox[{"BondiKFactor", "[", "v1", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"vsum", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ProperTimeScale", "[", 
                RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
               RowBox[{"Norm", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}]}], " ", "-",
            " ", 
           RowBox[{"BondiKFactor", "[", "v2", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0f86ef7f-eba8-40c9-8d6e-39c26a380b69"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"818fdfe4-6b07-435a-a342-2f4f6350b20b"]
}, Open  ]],

Cell["\<\
The signal is one light ray: Alice's emission, Bob's reception and Carol's \
reception are collinear along the rightgoing light direction.\
\>", "ExampleText",ExpressionUUID->"1629153f-a962-43b6-a013-cd984212cac2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", " ", 
         RowBox[{"ray", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", "phi", "]"}], ",", " ", 
            RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"p", " ", "|->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", " ", 
            RowBox[{"Rest", "[", "d", "]"}]}], "]"}], "]"}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e5d14bb-5db6-4d54-98de-5ffcde29921a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f15a5860-9973-49a5-81cf-3e726f35bc04"]
}, Open  ]],

Cell["The k-factors multiply, so the rapidities add.", "ExampleText",ExpressionUUID->"2b758259-65ac-4ba4-bb1e-26b8224bd739"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{
         RowBox[{"BondiKFactor", "[", "v1", "]"}], " ", 
         RowBox[{"BondiKFactor", "[", "v2", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"Rapidity", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}]}], "]"}]}], 
     "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
     RowBox[{"Rapidity", "[", "v2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c5a153e8-659f-4fb8-bd4c-c60f599816e5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a8c0134f-2f11-463a-95d8-13570d7296da"]
}, Open  ]]
