Cell[TextData[{
 "In proper times, Bob's reception is ",
 StyleBox["k", "TI"],
 "1 times Alice's emission and Carol's is ",
 StyleBox["k", "TI"],
 "2 times Bob's."
}], "ExampleText",ExpressionUUID->"1e219ac3-f05e-43b7-b23c-39a31b088d36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"vsum", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"v1", " ", "v2"}]}], ")"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], " ", "-", " ", 
           
           RowBox[{"KFactor", "[", "v1", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"vsum", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ProperTimeScale", "[", 
                RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
               RowBox[{"Norm", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}]}], " ", "-",
            " ", 
           RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3d202838-7007-4fe6-9578-3f3ae219d46a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"677df4e8-abd9-46ff-b8f5-8f73b242af7b"]
}, Open  ]],

Cell["\<\
The signal is one light ray: Alice's emission, Bob's reception and Carol's \
reception are collinear along the rightgoing light direction.\
\>", "ExampleText",ExpressionUUID->"94944520-7d2f-43f5-8a11-3424d692faf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", " ", 
         RowBox[{"ray", " ", "=", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"p", " ", "|->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", " ", 
            RowBox[{"Rest", "[", "d", "]"}]}], "]"}], "]"}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"56e83f8c-5793-4502-b78c-a419d80a08d6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"77cb6672-43d8-44a7-a62c-bd82f5608d4b"]
}, Open  ]],

Cell["The k-factors multiply, so the rapidities add.", "ExampleText",ExpressionUUID->"1e71bd61-e641-4972-824e-8c7373d8e30d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
