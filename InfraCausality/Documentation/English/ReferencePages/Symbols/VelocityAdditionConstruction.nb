Cell[TextData[{
 "In proper times, Bob's reception is ",
 StyleBox["k", "TI"],
 "1 times Alice's emission and Carol's is ",
 StyleBox["k", "TI"],
 "2 times Bob's."
}], "ExampleText",ExpressionUUID->"e87e147b-dc88-4b22-98c0-3b9e19a60f9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"vsum", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"v1", " ", "v2"}]}], ")"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], " ", "-", " ", 
           
           RowBox[{"KFactor", "[", "v1", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"vsum", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ProperTimeScale", "[", 
                RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
               RowBox[{"Norm", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}]}], " ", "-",
            " ", 
           RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"17272a29-f133-44e0-8bb4-445c5cf9dd86"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1c5ab5c6-9020-4eab-890e-53cc649e7f8e"]
}, Open  ]],

Cell["\<\
The signal is one light ray: Alice's emission, Bob's reception and Carol's \
reception are collinear along the rightgoing light direction.\
\>", "ExampleText",ExpressionUUID->"4003d11d-3a3c-458e-ad10-6f693f688eb4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", " ", 
         RowBox[{"ray", " ", "=", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"p", " ", "|->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", " ", 
            RowBox[{"Rest", "[", "d", "]"}]}], "]"}], "]"}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fb2c2e10-d0fe-430b-ab23-75f5567108b2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"18cdb014-857f-48cd-a041-5dc105463c61"]
}, Open  ]],

Cell["The k-factors multiply, so the rapidities add.", "ExampleText",ExpressionUUID->"deafaa72-7065-426b-8629-b25da17fb49e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
