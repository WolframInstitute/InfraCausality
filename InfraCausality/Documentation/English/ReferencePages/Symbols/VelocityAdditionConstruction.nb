Cell["VelocityAdditionConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9607efb-80cf-425a-b353-7bef9b3b4fa0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityAdditionConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/\
VelocityAdditionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v1", "TI"], ",", " ", 
    StyleBox["v2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b93ef72-375d-4248-8a6f-9ddf79119277"],
 "\[LineSeparator]",
 "draws three worldlines with Bondi factors ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2 and ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2, illustrating that composing velocities multiplies Bondi factors.",
 "\n"
}], "Usage",ExpressionUUID->"7e2d5afc-a210-4f3f-95c3-92ad369464b8"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"495672bd-e083-4798-b998-8142ed960b95"],

Cell[TextData[{
 "Definition: \"Bob\" (red) moves at ",
 StyleBox["v", "TI"],
 "1 relative to the rest observer \"Alice\" (blue), and \"Carol\" (green) at ",
 StyleBox["v", "TI"],
 "2 relative to Bob. One light signal leaves Alice at arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee38cf26-5e02-446d-85fb-f1463d929858"],
 ", passes Bob and reaches Carol. Bob receives it at ",
 StyleBox["k", "TI"],
 "1 times Alice's emission time, and Carol at ",
 StyleBox["k", "TI"],
 "2 times Bob's reception time, each in the receiver's proper time; so \
Carol's reception is ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 times Alice's emission, and Carol's velocity relative to Alice is ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "\[CirclePlus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e12b26-e640-414b-8a19-11a4d71905f3"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65673928-29ae-4491-9e35-50274f65c867"],
 " = ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c524fb44-0469-4540-bd17-2c348cbaebf9"],
 ". The panel on the left prints ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2, ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "\[CirclePlus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c2431e1-dc6c-48bf-88c1-aa6c6f03704c"],
 "."
}], "Notes",ExpressionUUID->"ffc41ab4-f475-4eec-90f2-dad71398fb7a"],

