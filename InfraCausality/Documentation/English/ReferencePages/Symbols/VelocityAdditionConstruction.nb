VelocityAdditionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v1", "TI"], ",", " ", 
    StyleBox["v2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c822d88-b7c8-4e78-8aaf-a0652373da77"],
 "\[LineSeparator]",
 "draws three worldlines with Bondi factors ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2 and ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2, illustrating that composing velocities multiplies Bondi factors.",
 "\n"
}], "Usage",ExpressionUUID->"35891901-fa20-4caf-bc3e-a117318295bb"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"d62b36bd-4a98-4f58-8052-c4d88a37694e"],

Cell[TextData[{
 "Definition: \"Bob\" (red) moves at ",
 StyleBox["v", "TI"],
 "1 relative to the rest observer \"Alice\" (blue), and \"Carol\" (green) at ",
 StyleBox["v", "TI"],
 "2 relative to Bob. One light signal leaves Alice at arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90558a4b-c0ad-414c-b259-b93a7eecd25f"],
 ", passes Bob and reaches Carol. Bob receives it at ",
 StyleBox["k", "TI"],
 "1 times Alice's emission time, and Carol at ",
 StyleBox["k", "TI"],
 "2 times Bob's reception time, each in the receiver's proper time; so \
Carol's reception is ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 times Alice's emission, and Carol's velocity relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["v", "TI"], "\[CirclePlus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], "1"], 
       SubscriptBox[
        StyleBox["k", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], "1"], 
       SubscriptBox[
        StyleBox["k", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5030b6ec-e65c-4f3e-8af5-51db0b19a08e"],
 ". The panel on the left prints ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2, ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "\[CirclePlus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96e38820-91d2-4377-8675-942b6dc80c2f"],
 "."
}], "Notes",ExpressionUUID->"2fdffed3-11e1-417c-8e55-9d276055a7a6"],

