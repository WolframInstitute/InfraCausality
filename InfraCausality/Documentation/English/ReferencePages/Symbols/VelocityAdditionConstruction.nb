Cell[TextData[{
 "In proper times, Bob's reception is ",
 StyleBox["k", "TI"],
 "1 times Alice's emission and Carol's is ",
 StyleBox["k", "TI"],
 "2 times Bob's."
}], "ExampleText",ExpressionUUID->"c7878290-6868-4682-9211-e9236dc833e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"vsum", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"v1", " ", "v2"}]}], ")"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], " ", "-", " ", 
           
           RowBox[{"KFactor", "[", "v1", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"vsum", ",", " ", "phi"}], "]"}], " ", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ProperTimeScale", "[", 
                RowBox[{"v1", ",", " ", "phi"}], "]"}], " ", 
               RowBox[{"Norm", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}]}], " ", "-",
            " ", 
           RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f1af76fd-ece0-43df-8214-912a3415ed91"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"15aecf57-dfd7-432a-a54f-db6e330509bb"]
}, Open  ]],

Cell["\<\
The signal is one light ray: Alice's emission, Bob's reception and Carol's \
reception are collinear along the rightgoing light direction.\
\>", "ExampleText",ExpressionUUID->"437f96da-db51-498c-808b-d96128aad2ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.4", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VelocityAdditionConstruction", "[", 
             RowBox[{"v1", ",", " ", "v2", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Disk", "[", 
              RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
             " ", "Infinity"}], "]"}]}], ",", " ", 
         RowBox[{"ray", " ", "=", " ", 
          RowBox[{"LightDirection", "[", 
           RowBox[{"phi", ",", " ", "True"}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"p", " ", "|->", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", " ", "-", " ", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"ray", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", " ", 
            RowBox[{"Rest", "[", "d", "]"}]}], "]"}], "]"}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"02e42384-22ca-4f5a-98ec-41bdd56ebda9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"20154450-0aa6-4ef3-8dfc-939531ee65a2"]
}, Open  ]],

Cell["The k-factors multiply, so the rapidities add.", "ExampleText",ExpressionUUID->"01b23039-c1bd-4d5a-96d5-37a6761c92df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
