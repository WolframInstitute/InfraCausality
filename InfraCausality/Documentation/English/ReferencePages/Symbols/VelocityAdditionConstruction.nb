Cell["VelocityAdditionConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27772250-4f5d-4132-bc91-c0a95594c2cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
