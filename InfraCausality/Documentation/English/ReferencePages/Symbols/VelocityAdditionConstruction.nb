      TextData["VelocityAdditionConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/\
VelocityAdditionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v1", "TI"], ",", " ", 
    StyleBox["v2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "019ce082-42e9-4f19-95f7-9b94e8c747e5"],
 "\[LineSeparator]",
 "draws three worldlines with Bondi factors ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2 and ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2, illustrating that composing velocities multiplies Bondi factors.",
 "\n"
}], "Usage",ExpressionUUID->"cc0186b2-25cb-4d65-9d7b-5476be6ab6d2"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"0e6cecf9-29f1-465a-a15b-eee723a536f6"],

Cell[TextData[{
 "Definition: \"Bob\" (red) moves at ",
 StyleBox["v", "TI"],
 "1 relative to the rest observer \"Alice\" (blue), and \"Carol\" (green) at ",
 StyleBox["v", "TI"],
 "2 relative to Bob. One light signal leaves Alice at arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebc67751-bfef-4272-a2da-944881c7e812"],
 ", passes Bob and reaches Carol. Bob receives it at ",
 StyleBox["k", "TI"],
 "1 times Alice's emission time, and Carol at ",
 StyleBox["k", "TI"],
 "2 times Bob's reception time, each in the receiver's proper time; so \
Carol's reception is ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 times Alice's emission, and Carol's velocity relative to Alice is ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "\[CirclePlus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62581bd6-3713-4483-9ce6-69342ace174d"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab65a4b7-e3c6-4a45-a9cb-1f8c12231cd1"],
 " = ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0e5def2-98e1-401a-82c1-f4d47c0f4f6a"],
 ". The panel on the left prints ",
 StyleBox["k", "TI"],
 "1, ",
 StyleBox["k", "TI"],
 "2, ",
 StyleBox["k", "TI"],
 "1 ",
 StyleBox["k", "TI"],
 "2 and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "\[CirclePlus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dfc9a8c-cba9-422d-848e-c1980d476290"],
 "."
}], "Notes",ExpressionUUID->"0568ab93-a426-4315-a05f-a718b91da44f"],

