Cell[CellGroupData[{
Cell["CausalSubstrateStyle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4e517f05-e1d1-48d0-9052-8f917495bfbb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6923323c-cc16-4388-9506-95d95b62ff05"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44805ff5-2e84-45a0-b677-bb48fdcba1b6"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "467d4a8d-17a0-4b87-9f81-ea638ef8f9d3"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80adea50-f7f7-41c2-8c5e-ecdd433f4d9d"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d4597bd-2382-4a29-a3c1-0028797d4ce4"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"23691559-5a70-4c7f-836a-bb33de60244b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1504c399-bbbc-49e4-96a2-5ea18831d30a"],
 "\[LineSeparator]",
 "gives those of a named substrate."
}], "Usage",ExpressionUUID->"03a482d6-08ff-487e-a36a-6e3369b26d0f"],

Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af20e0c-b498-42f4-a527-867516bd78ea"],
 " option rules: ",
 Cell[BoxData["VertexStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72148ecd-f561-4a1a-b55f-ce4fa42ff273"],
 " and ",
 Cell[BoxData["EdgeStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dddc633d-4f0d-41e0-92cc-1de3a2f48c51"],
 " in the causal-graph colours of the Wolfram Physics Project (events ",
 Cell[BoxData[
  RowBox[{"Hue", "[", 
   RowBox[{"0.11", ",", " ", "1", ",", " ", "0.97"}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbaedd1b-082e-4bb0-a9c2-9a110bfb0142"],
 ", causal edges ",
 Cell[BoxData[
  RowBox[{"Hue", "[", 
   RowBox[{"0", ",", " ", "1", ",", " ", "0.56"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b79ee5c1-46a5-4867-b445-c86d3caae006"],
 ", the values of SetReplace's ",
 Cell[BoxData["\"\<CausalGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a37e3d-f60e-48b6-82ab-ef6e31967b4d"],
 " style and of the causal graphs of the Technical Introduction) with \
arrowheads, a ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cfc30ce-026f-4762-8272-dddd1aecc50c"],
 " that shrinks with the size so that larger graphs stay legible, and ",
 Cell[BoxData[
  RowBox[{"GraphLayout", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
     RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "679905ab-6d12-4e18-b3a8-8547e13bc414"],
 ", which draws a directed acyclic graph in layers with time upward. It is \
the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateStyle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d54aab5-53ef-424c-94d1-1a6191fb3dc5"],
 "."
}], "Notes",ExpressionUUID->"e2257634-eafc-4284-9004-3f4dcaf24399"],

Cell[TextData[{
 "The style depends on the size alone: every named substrate of one size has \
the same colours, and the edge opacity and the arrowheads shrink with the \
size. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ce8d7bb-1e95-4b62-a6f9-1d43e745631e"],
 " applies it, and so does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca2df4aa-e0a5-4bf6-a9a3-3db962fb5709"],
 ", with the size chosen by the number of events (",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baa863d6-171a-4113-aae0-8fc317c6dc59"],
 " up to 250, ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d051ad7-2c97-4684-8c08-fab8320b673b"],
 " up to 800, ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888a5b89-cfe0-4773-afe8-a7114e9ae6eb"],
 " beyond). A layout given by ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565d3fc2-c582-4ccb-a43f-8a5af2febdfa"],
 ", as under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01162a6b-f21b-4d12-822a-ebc77e138684"],
 ", takes precedence over the layered embedding."
}], "Notes",ExpressionUUID->"fe29c03f-f0d4-43a6-be5c-d65336a6b011"],

Cell[TextData[{
 "Highlights read best in the same palette: light cones, light rays and the \
current slice of a foliation in ",
 Cell[BoxData["Red"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0089e67-b1f4-41c8-9c0f-f0ac47790ec3"],
 ", the colour of the causal cones and foliations of the Technical \
Introduction; the past in the Project's blue ",
 Cell[BoxData[
  RowBox[{"RGBColor", "[", 
   RowBox[{"0.259", ",", " ", "0.576", ",", " ", "1"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dfad44f-0fd3-406b-9cda-4ebdb1be93e7"],
 "; worldlines and observers in ",
 Cell[BoxData["StandardBlue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e8264cd-09f3-4f2f-a3f0-600216cefae7"],
 " and ",
 Cell[BoxData["StandardGreen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b20b574f-464e-4998-a664-58d793cdaa19"],
 "."
}], "Notes",ExpressionUUID->"2e13404f-2005-4aac-bd49-8ec28da4b4ac"]
}, Open  ]],

