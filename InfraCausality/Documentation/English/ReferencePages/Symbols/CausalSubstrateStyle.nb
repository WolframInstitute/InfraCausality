Cell["The style of a \"Small\" substrate.", "ExampleText",ExpressionUUID->"eb69aff2-e4fa-4fb6-aff0-c3dcf0f27b9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"36144cd1-4fb6-44e6-88d2-edbc243c871d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EdgeStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0, 1, 0.56]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.7`", "]"}], ",", 
      RowBox[{"Arrowheads", "[", "0.02`", "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
          "HueColorSwatchTemplate"], ",", 
         RowBox[{"Opacity", "[", "1", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Scaled\"\>", ",", "0.015`"}], "}"}]}], ",", 
   RowBox[{"GraphLayout", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"LayeredDigraphEmbedding\"\>", ",", 
      RowBox[{"\<\"Orientation\"\>", "\[Rule]", "Bottom"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7aa4fb9e-e243-4a67-a980-7d3cda2242ac"]
}, Open  ]],

Cell["A plain directed graph drawn in the style of each size.", "ExampleText",ExpressionUUID->"7d4be160-12f8-457e-905b-0d4a1c773ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"size", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"7f551a20-8be7-4a47-81dc-f19329f606d0"],

