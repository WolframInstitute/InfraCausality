    RowBox[{"size", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ae43eeaf-a48e-4d9b-b52b-44ebc455d999"],

