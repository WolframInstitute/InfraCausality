Cell["The style of a \"Small\" substrate.", "ExampleText",ExpressionUUID->"8bf3707a-23b7-4065-b807-ce259aca725f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cdcefd5-53a8-4b20-a1a1-d747c94fda76"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EdgeStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> GrayLevel[0.62]|>,
       "GrayLevelColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.5`", "]"}], ",", 
      RowBox[{"Arrowheads", "[", "0.02`", "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> GrayLevel[0.62]|>,
       "GrayLevelColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.6`", "]"}], ",", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[<|"color" -> RGBColor[0.248, 0.248, 0.248]|>,
          "RGBColorSwatchTemplate"], ",", 
         RowBox[{"Opacity", "[", "0.65`", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Scaled\"\>", ",", "0.015`"}], "}"}]}], ",", 
   RowBox[{"GraphLayout", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"LayeredDigraphEmbedding\"\>", ",", 
      RowBox[{"\<\"Orientation\"\>", "\[Rule]", "Bottom"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0e613b7a-be0f-41e1-a4c9-e302d538949b"]
}, Open  ]],

Cell["A plain directed graph drawn in the style of each size.", "ExampleText",ExpressionUUID->"68acb00f-395b-44b9-9382-dfb1c01f4d96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"size", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"6c97b901-ff8d-434b-b91e-f3b0bbe1e3b7"],

