Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01925203-924a-4376-8dd6-877285827c05"],
 " option rules, the same for every named substrate of a size, with time \
upward."
}], "ExampleText",ExpressionUUID->"8168783e-c145-451f-a63b-8c302417e4a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
     " ", "\"\<Large\>\""}], "}"}], ",", " ", 
   RowBox[{"size", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"style", " ", "=", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"style", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"_Rule", " ", "|", " ", "_RuleDelayed"}], ")"}], " ", 
           ".."}], "}"}]}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Options", "[", "Graph", "]"}]}], ",", " ", 
         RowBox[{"Keys", "[", "style", "]"}]}], "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
         RowBox[{"name", " ", "|->", " ", 
          RowBox[{
           RowBox[{"CausalSubstrateStyle", "[", 
            RowBox[{"name", ",", " ", "size"}], "]"}], " ", "===", " ", 
           "style"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"GraphLayout", " ", "/.", " ", "style"}], ")"}], " ", "===", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
          RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], 
         "}"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8e399cee-c158-4206-8d0d-da32d35a6b79"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2b15ea14-ea30-4e41-80a1-b860363dd5bb"]
}, Open  ]],

Cell["\<\
A random causal graph of 25 events carries the \"Small\" style, and in that \
style every edge points upward.\
\>", "ExampleText",ExpressionUUID->"ba848b9b-dcc5-43d7-9791-12566f7a1fb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", "25", "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"Options", "[", 
        RowBox[{"g", ",", " ", "GraphLayout"}], "]"}]}], ")"}], " ", "===", 
     " ", 
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}], ")"}]}],
     " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{"e", " ", "|->", " ", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
        RowBox[{"y", "[", 
         RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d30baeaa-8346-4cf5-bc20-f4243c2970b0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a0829c66-7975-4af4-950f-575fd4a03dc5"]
}, Open  ]]
}, Open  ]],

