Cell[CellGroupData[{
Cell["CausalSubstrateStyle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"af77e6e9-9770-4ed3-888d-e684e4151df0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d73775cb-67ee-40e9-9025-9cd3fa676a7f"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "489e0579-f3b6-411d-bbf1-5f4c6ca850c9"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de3e6007-ef44-4799-90b8-949ddb616544"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7696e8d1-9908-4156-99e0-663b99381702"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5d2435-d2f9-4c31-8634-748a88b7f068"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"79d03f72-168f-411c-9d40-adb08aa9b146"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "139e035f-1ae3-4bca-a4d4-c2754a39e919"],
 "\[LineSeparator]",
 "gives those of a named substrate."
}], "Usage",ExpressionUUID->"393b9bdb-a3e8-441c-b65d-83982b9094d9"],

Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abe0ebdd-db3b-4523-9a8e-6caecd542700"],
 " option rules: ",
 Cell[BoxData["EdgeStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a60d9887-0062-457b-814c-b95cc12c0fcd"],
 " and ",
 Cell[BoxData["VertexStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64274276-91d8-4b54-a937-c84fc6fb09cf"],
 " in ",
 Cell[BoxData["StandardGray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68d3825f-fd8d-45c3-a80e-f1716cbe6163"],
 " with arrowheads, a ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84948b3d-d3eb-4d07-94d6-e0ca3b2e442b"],
 " that shrinks with the size so that larger graphs stay legible, and ",
 Cell[BoxData[
  RowBox[{"GraphLayout", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
     RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f13c326-5fcd-4948-8fc4-38be4ab3cc9d"],
 ", which draws a directed acyclic graph in layers with time upward. It is \
the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateStyle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "307aaed2-43b5-4517-801f-d1f8b782be66"],
 "."
}], "Notes",ExpressionUUID->"becd81ad-7b3c-4052-a99f-5a81f933dc32"],

Cell[TextData[{
 "The style depends on the size alone: every named substrate of one size has \
the same style. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef2cf802-90a6-4d01-bfe3-79f2908ee095"],
 " applies it, and so does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "134649c0-2a7f-4d1d-86d4-e689e8b353fb"],
 ", with the size chosen by the number of events (",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d810c33c-867e-4b39-a9a6-3585db266a1f"],
 " up to 250, ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347093b0-d90c-49db-8389-fe48c1ef9ca7"],
 " up to 800, ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f754d4fc-1834-43b7-838d-b0bd4bd565da"],
 " beyond). A layout given by ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4607d1d1-4eb2-497f-810f-7ada7b29aa34"],
 ", as under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ea7be5e-6db8-4a57-819d-d8f0b6a18e35"],
 ", takes precedence over the layered embedding."
}], "Notes",ExpressionUUID->"7c8160d8-7e22-417f-8328-615b8a4918c3"]
}, Open  ]],

