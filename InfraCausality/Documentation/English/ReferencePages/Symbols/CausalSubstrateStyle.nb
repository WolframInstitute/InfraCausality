Cell[CellGroupData[{
Cell["CausalSubstrateStyle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"90439c44-0f1c-46c8-9196-94c9007eda3b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdcde944-e92e-4432-91bc-f32731d2c81c"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2a7e2dd-1a78-41ee-87f7-b3bd75f021d1"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7da815-767d-458e-8699-2317c3ac9345"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a7e30c-0f87-48b1-9816-15f79e3bed67"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a334b8c7-5196-4bbf-a508-f2cebdb14bd5"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"128ff15e-dd95-48dc-832d-5d9c286d84f5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac279fe1-b33a-44c0-a09d-70d68dc029ae"],
 "\[LineSeparator]",
 "gives those of a named substrate."
}], "Usage",ExpressionUUID->"c4e540ad-554c-48df-bb6e-7b28bb3b2a84"],

Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8a9fdd5-8b52-4e7f-b050-4ba8762fae0b"],
 " option rules: ",
 Cell[BoxData["EdgeStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f52dcd5-4ca0-445b-ab6c-6f98a7ab08e6"],
 " and ",
 Cell[BoxData["VertexStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31a5f3a2-7c4c-4290-971b-e226830bd7c5"],
 " in ",
 Cell[BoxData["StandardGray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d57f683-a35a-4b50-ae96-d7f12c8f63f8"],
 " with arrowheads, a ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e47134f-2378-435a-b542-5fbaf3152098"],
 " that shrinks with the size so that larger graphs stay legible, and ",
 Cell[BoxData[
  RowBox[{"GraphLayout", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
     RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9a3dcb4-01f1-4da2-a82e-7f97c33492f7"],
 ", which draws a directed acyclic graph in layers with time upward. It is \
the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateStyle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb559370-7ba7-4410-9929-a253ff81e953"],
 "."
}], "Notes",ExpressionUUID->"75962d31-206f-48b3-bca3-1db2fdf1576c"],

Cell[TextData[{
 "The style depends on the size alone: every named substrate of one size has \
the same style. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd478241-3ad3-4fe8-8f19-d50852fbedef"],
 " applies it, and so does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8627f4bf-fd04-4711-aabe-465df6eebf7f"],
 ", with the size chosen by the number of events (",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45a3eed3-796c-4e75-bae4-d46dd7b37014"],
 " up to 250, ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae488ba0-c682-47b0-90f2-aae637e2bb3f"],
 " up to 800, ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be6ac30-cf1c-4fc5-af10-cb8ea3cb8f2c"],
 " beyond). A layout given by ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d19381d-6f53-497f-a0ed-7907053e3368"],
 ", as under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "956be94e-fd67-4812-8ced-116c177ac072"],
 ", takes precedence over the layered embedding."
}], "Notes",ExpressionUUID->"870b66bd-a68d-46a5-9db3-ccd4cff77d1a"]
}, Open  ]],

