Cell[CellGroupData[{
Cell["CausalSubstrateStyle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00176503-8f09-4ec3-bdca-fd2caea51afd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad03918f-dda5-414b-8398-b878ca7f58d5"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44bf79e7-ff7f-4bcc-8946-3f05f863279f"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f2cb7d-5d8c-4d7e-b0e2-dde137e7d0b6"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7942f607-9f94-4e94-9371-d2a9d2fa52dd"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e95d9878-bec8-4ec9-882a-88d37563dfe0"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4c92f85d-7c9a-42a8-a1db-e0201e16b03a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9dfaee-b954-4c16-b42a-6320c36e5a4d"],
 "\[LineSeparator]",
 "gives those of a named substrate."
}], "Usage",ExpressionUUID->"ce885c4c-71cd-414b-8532-24f1f79c6f06"],

Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "214b023e-e76c-449a-8311-ebcb675f6790"],
 " option rules: ",
 Cell[BoxData["EdgeStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3668450-f0a0-47b9-a4ff-828eb86e3748"],
 " and ",
 Cell[BoxData["VertexStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cde2b6d-4442-4251-a698-4c949d425865"],
 " in ",
 Cell[BoxData["StandardGray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0d592f8-0479-4379-a863-25809800491b"],
 " with arrowheads, a ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "111718a4-9518-44fb-af38-d7019c3a1da2"],
 " that shrinks with the size so that larger graphs stay legible, and ",
 Cell[BoxData[
  RowBox[{"GraphLayout", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
     RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a47843-d88a-416c-813b-a29b97b554b9"],
 ", which draws a directed acyclic graph in layers with time upward. It is \
the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateStyle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "05fcce22-e5d7-45d5-a226-1d3dbf706641"],
 "."
}], "Notes",ExpressionUUID->"98978a41-7930-490d-a23b-b927ae845c61"],

Cell[TextData[{
 "The style depends on the size alone: every named substrate of one size has \
the same style. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cbea8c04-9e49-4377-8acc-9f2cd736e915"],
 " applies it, and so does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88c2a165-737d-41ee-81f7-71de28db79e0"],
 ", with the size chosen by the number of events (",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d60fef95-c56f-44bc-a90f-617b9bb0faf2"],
 " up to 250, ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "854935b3-104b-4d3e-b755-7a8f8e4ef71e"],
 " up to 800, ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c9863be-e1d6-4325-9349-4b6c079a7bb5"],
 " beyond). A layout given by ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a47432e8-c689-44e3-9425-283eeb250577"],
 ", as under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8091ccf-e488-4209-89d1-4815b54364f4"],
 ", takes precedence over the layered embedding."
}], "Notes",ExpressionUUID->"040aa86e-df98-4646-acc1-6b80847a6672"]
}, Open  ]],

