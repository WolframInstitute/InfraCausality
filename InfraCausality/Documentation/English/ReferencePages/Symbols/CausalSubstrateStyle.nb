       " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"424e3a27-6a7f-4b94-a1be-c8b125c3d2b7"],

