Cell["The style of a \"Small\" substrate.", "ExampleText",ExpressionUUID->"6d310de7-935e-4ff8-a02e-7150fda9ea4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"566416ce-de3a-497a-ac26-958740c7b68a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EdgeStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0, 1, 0.56]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.7`", "]"}], ",", 
      RowBox[{"Arrowheads", "[", "0.02`", "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
          "HueColorSwatchTemplate"], ",", 
         RowBox[{"Opacity", "[", "1", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Scaled\"\>", ",", "0.015`"}], "}"}]}], ",", 
   RowBox[{"GraphLayout", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"LayeredDigraphEmbedding\"\>", ",", 
      RowBox[{"\<\"Orientation\"\>", "\[Rule]", "Bottom"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4a97e338-3a35-4855-b4f2-fbb070234a42"]
}, Open  ]],

Cell["A plain directed graph drawn in the style of each size.", "ExampleText",ExpressionUUID->"97b9c725-fd21-4490-94d3-c40852b1c17e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"size", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"d94855f6-4d7e-4dd6-a542-ac5d24dffa1b"],

