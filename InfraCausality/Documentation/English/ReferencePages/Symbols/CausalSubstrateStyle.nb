Cell["The style of a \"Small\" substrate.", "ExampleText",ExpressionUUID->"5024ab1e-4148-425f-b3ba-560ee0e28c94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"19058fe2-6ec0-49d6-ab76-53e223f3b208"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EdgeStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0, 1, 0.56]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.7`", "]"}], ",", 
      RowBox[{"Arrowheads", "[", "0.02`", "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
       "HueColorSwatchTemplate"], ",", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[<|"color" -> Hue[0.11, 1, 0.97]|>,
          "HueColorSwatchTemplate"], ",", 
         RowBox[{"Opacity", "[", "1", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Scaled\"\>", ",", "0.015`"}], "}"}]}], ",", 
   RowBox[{"GraphLayout", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"LayeredDigraphEmbedding\"\>", ",", 
      RowBox[{"\<\"Orientation\"\>", "\[Rule]", "Bottom"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8d2d226-0540-4d95-b854-2b01baa1efa7"]
}, Open  ]],

Cell["A plain directed graph drawn in the style of each size.", "ExampleText",ExpressionUUID->"58df4031-9e10-4a99-8180-b70694127aa6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"size", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"28f5b7b4-e96b-41c0-83c1-a5b97ecd6452"],

