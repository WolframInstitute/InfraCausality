Cell[CellGroupData[{
Cell["CausalSubstrateStyle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b80414d8-b6c2-405b-aad2-7709f11044ed"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c2b5e9d-1ed4-45f5-bf62-9bb1d4b21958"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62552915-bdad-4da7-93bb-d9625010c907"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070e29cb-5dfe-487a-939a-e7103287f604"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32a6e357-6a38-4cc4-9279-4bf3691fb9ec"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d43055c3-1cbd-425d-9a38-a8419ddfea88"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"faae7cfe-b23e-4017-a3eb-2a6d2c6895b8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f36c44a0-aac0-42bc-bbe6-953b9a6316db"],
 "\[LineSeparator]",
 "gives those of a named substrate."
}], "Usage",ExpressionUUID->"043a7c95-19d2-4a71-9f27-021a8f34c43f"],

Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608b381e-273a-4580-adb0-191ff07e874d"],
 " option rules: ",
 Cell[BoxData["EdgeStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef19d6a7-d345-46f1-b9a9-2d458dc25727"],
 " and ",
 Cell[BoxData["VertexStyle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c90d3b-7963-4f8f-8edd-f43eca8001a3"],
 " in ",
 Cell[BoxData["StandardGray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91e2ab5f-3f5f-419a-9e00-6cbada9b8a82"],
 " with arrowheads, a ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d202a638-e542-4a98-96ed-1d5c140516f2"],
 " that shrinks with the size so that larger graphs stay legible, and ",
 Cell[BoxData[
  RowBox[{"GraphLayout", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
     RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd382d84-824a-40e8-89f4-1a6fbbc585d0"],
 ", which draws a directed acyclic graph in layers with time upward. It is \
the analogue of InfraGeometry's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateStyle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateStyle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b29eeb1a-d895-4775-891c-321872b1e495"],
 "."
}], "Notes",ExpressionUUID->"db46a378-5b12-4747-b2ea-e46e7fc96731"],

Cell[TextData[{
 "The style depends on the size alone: every named substrate of one size has \
the same style. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrate"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrate", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efb8f1db-ebe4-4923-85a6-886b8da11374"],
 " applies it, and so does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomCausalGraph"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomCausalGraph", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64fa4243-b884-4d78-8113-df0c39f29ee5"],
 ", with the size chosen by the number of events (",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "690cf339-3775-4f97-9c07-02d5cedc1ffd"],
 " up to 250, ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "484628c1-9ada-4691-8d5f-b8d2eb7c6c6a"],
 " up to 800, ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e43aff6e-941a-4471-832b-0a65decb3d9f"],
 " beyond). A layout given by ",
 Cell[BoxData["VertexCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbdd299-e8c2-4085-9030-92920831b110"],
 ", as under ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "968f4c07-63bc-40d7-bec1-41c92a4a557c"],
 ", takes precedence over the layered embedding."
}], "Notes",ExpressionUUID->"34c3b4e5-044b-4137-ba83-89566bfffc1f"]
}, Open  ]],

