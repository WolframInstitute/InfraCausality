Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "929bd51d-7689-445d-aa5b-a42e12ed26a0"],
 " option rules, the same for every named substrate of a size, with time \
upward."
}], "ExampleText",ExpressionUUID->"f5123115-09c7-48f8-82c3-483d1e051832"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
     " ", "\"\<Large\>\""}], "}"}], ",", " ", 
   RowBox[{"size", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"style", " ", "=", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"style", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"_Rule", " ", "|", " ", "_RuleDelayed"}], ")"}], " ", 
           ".."}], "}"}]}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Options", "[", "Graph", "]"}]}], ",", " ", 
         RowBox[{"Keys", "[", "style", "]"}]}], "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
         RowBox[{"name", " ", "|->", " ", 
          RowBox[{
           RowBox[{"CausalSubstrateStyle", "[", 
            RowBox[{"name", ",", " ", "size"}], "]"}], " ", "===", " ", 
           "style"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"GraphLayout", " ", "/.", " ", "style"}], ")"}], " ", "===", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
          RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], 
         "}"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5ceb7bc1-208b-4858-bbd7-6e74fd619275"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2cc68acd-cbb3-402b-9d78-4dd1151b2122"]
}, Open  ]],

Cell["\<\
A random causal graph of 25 events carries the \"Small\" style, and in that \
style every edge points upward.\
\>", "ExampleText",ExpressionUUID->"aa4ee2b1-cea5-4f55-aab0-cf21f89967d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", "25", "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"Options", "[", 
        RowBox[{"g", ",", " ", "GraphLayout"}], "]"}]}], ")"}], " ", "===", 
     " ", 
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}], ")"}]}],
     " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{"e", " ", "|->", " ", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
        RowBox[{"y", "[", 
         RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4cb77717-382b-4b91-a256-275877b0ab02"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a74a746f-7b5c-4038-b52a-88bd127bee5d"]
}, Open  ]]
}, Open  ]],

