Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93a7f40f-a24c-4c6b-a79b-b98d1506e45b"],
 " option rules, the same for every named substrate of a size, with time \
upward."
}], "ExampleText",ExpressionUUID->"84b72919-77d5-424a-8cf1-b6acb5692d2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
     " ", "\"\<Large\>\""}], "}"}], ",", " ", 
   RowBox[{"size", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"style", " ", "=", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"style", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"_Rule", " ", "|", " ", "_RuleDelayed"}], ")"}], " ", 
           ".."}], "}"}]}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Options", "[", "Graph", "]"}]}], ",", " ", 
         RowBox[{"Keys", "[", "style", "]"}]}], "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
         RowBox[{"name", " ", "|->", " ", 
          RowBox[{
           RowBox[{"CausalSubstrateStyle", "[", 
            RowBox[{"name", ",", " ", "size"}], "]"}], " ", "===", " ", 
           "style"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"GraphLayout", " ", "/.", " ", "style"}], ")"}], " ", "===", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
          RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], 
         "}"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"93fcbb12-01a0-4613-900b-eb36c164e597"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b96313d2-6f60-4ecd-8206-fa2b8521cdc5"]
}, Open  ]],

Cell["\<\
A random causal graph of 25 events carries the \"Small\" style, and in that \
style every edge points upward.\
\>", "ExampleText",ExpressionUUID->"fb0a055b-21cc-46a5-a406-b4700967ed58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", "25", "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"Options", "[", 
        RowBox[{"g", ",", " ", "GraphLayout"}], "]"}]}], ")"}], " ", "===", 
     " ", 
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}], ")"}]}],
     " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{"e", " ", "|->", " ", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
        RowBox[{"y", "[", 
         RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"063c25d4-8a01-4d40-ac83-dfa3c83b0836"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"917d6a08-fcf5-444c-b46b-abc15452162c"]
}, Open  ]]
}, Open  ]],

