Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a587f5-d12f-43ac-95e8-9dfd5e5d893a"],
 " option rules, the same for every named substrate of a size, with time \
upward."
}], "ExampleText",ExpressionUUID->"ced73b98-7d3f-49f9-bfbb-1ef457a7d55c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
     " ", "\"\<Large\>\""}], "}"}], ",", " ", 
   RowBox[{"size", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"style", " ", "=", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"style", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"_Rule", " ", "|", " ", "_RuleDelayed"}], ")"}], " ", 
           ".."}], "}"}]}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Options", "[", "Graph", "]"}]}], ",", " ", 
         RowBox[{"Keys", "[", "style", "]"}]}], "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
         RowBox[{"name", " ", "|->", " ", 
          RowBox[{
           RowBox[{"CausalSubstrateStyle", "[", 
            RowBox[{"name", ",", " ", "size"}], "]"}], " ", "===", " ", 
           "style"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"GraphLayout", " ", "/.", " ", "style"}], ")"}], " ", "===", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
          RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], 
         "}"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55420f78-2c4a-4231-8d95-97edaabcbd14"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1b043ca9-c4e3-43f8-8197-7632c66749a1"]
}, Open  ]],

Cell["\<\
A random causal graph of 25 events carries the \"Small\" style, and in that \
style every edge points upward.\
\>", "ExampleText",ExpressionUUID->"1233ca32-ab23-40c1-8e8d-4a1b73d734b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", "25", "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"Options", "[", 
        RowBox[{"g", ",", " ", "GraphLayout"}], "]"}]}], ")"}], " ", "===", 
     " ", 
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}], ")"}]}],
     " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{"e", " ", "|->", " ", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
        RowBox[{"y", "[", 
         RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"211bc6bb-5ebe-404c-baf9-1bca4522ec09"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"02c0bb79-1f15-4dc8-bbb0-961e9091f0c7"]
}, Open  ]]
}, Open  ]],

