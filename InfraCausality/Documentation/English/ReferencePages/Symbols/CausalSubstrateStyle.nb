Cell[TextData[{
 "The style is a list of ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3383ef7b-7cc7-4cf5-8516-f25cdfea7eb5"],
 " option rules, the same for every named substrate of a size, with time \
upward."
}], "ExampleText",ExpressionUUID->"e5035c67-5ca3-47f9-8a84-299373476d04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
     " ", "\"\<Large\>\""}], "}"}], ",", " ", 
   RowBox[{"size", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"style", " ", "=", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"style", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"_Rule", " ", "|", " ", "_RuleDelayed"}], ")"}], " ", 
           ".."}], "}"}]}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Options", "[", "Graph", "]"}]}], ",", " ", 
         RowBox[{"Keys", "[", "style", "]"}]}], "]"}], " ", "&&", "\n", 
       "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"CausalSubstrate", "[", "All", "]"}], ",", " ", 
         RowBox[{"name", " ", "|->", " ", 
          RowBox[{
           RowBox[{"CausalSubstrateStyle", "[", 
            RowBox[{"name", ",", " ", "size"}], "]"}], " ", "===", " ", 
           "style"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"GraphLayout", " ", "/.", " ", "style"}], ")"}], " ", "===", 
        " ", 
        RowBox[{"{", 
         RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
          RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Bottom"}]}], 
         "}"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c4ef58e6-86bc-4e54-9150-9dae22173a89"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5da62204-96de-4808-ad38-c5585ebdb79c"]
}, Open  ]],

Cell["\<\
A random causal graph of 25 events carries the \"Small\" style, and in that \
style every edge points upward.\
\>", "ExampleText",ExpressionUUID->"7897c3ae-4a2e-4be4-b354-55670837ce52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomCausalGraph", "[", "25", "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"Options", "[", 
        RowBox[{"g", ",", " ", "GraphLayout"}], "]"}]}], ")"}], " ", "===", 
     " ", 
     RowBox[{"(", 
      RowBox[{"GraphLayout", " ", "/.", " ", 
       RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}], ")"}]}],
     " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{"e", " ", "|->", " ", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"Last", " ", "@", " ", "e"}], "]"}], " ", ">", " ", 
        RowBox[{"y", "[", 
         RowBox[{"First", " ", "@", " ", "e"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9b0cb1fc-014d-47d5-8528-9ee747fd785d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d546bf6e-26a4-487a-8d51-70e219c3989e"]
}, Open  ]]
}, Open  ]],

