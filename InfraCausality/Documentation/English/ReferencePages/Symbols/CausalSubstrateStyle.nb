Cell["The style of a \"Small\" substrate.", "ExampleText",ExpressionUUID->"c08677f1-24c3-413a-b78f-69288e69ee30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CausalSubstrateStyle", "[", "\"\<Small\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"05625511-061b-465b-947e-bcd900b553a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EdgeStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> GrayLevel[0.62]|>,
       "GrayLevelColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.5`", "]"}], ",", 
      RowBox[{"Arrowheads", "[", "0.02`", "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      TemplateBox[<|"color" -> GrayLevel[0.62]|>,
       "GrayLevelColorSwatchTemplate"], ",", 
      RowBox[{"Opacity", "[", "0.6`", "]"}], ",", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[<|"color" -> RGBColor[0.248, 0.248, 0.248]|>,
          "RGBColorSwatchTemplate"], ",", 
         RowBox[{"Opacity", "[", "0.65`", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"VertexSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Scaled\"\>", ",", "0.015`"}], "}"}]}], ",", 
   RowBox[{"GraphLayout", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"LayeredDigraphEmbedding\"\>", ",", 
      RowBox[{"\<\"Orientation\"\>", "\[Rule]", "Bottom"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2fda8d79-f759-4c33-bb01-0345b4f0b424"]
}, Open  ]],

Cell["A plain directed graph drawn in the style of each size.", "ExampleText",ExpressionUUID->"e761053e-7a64-491b-94eb-f07b78d2c2a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalSubstrateStyle", "[", "size", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"size", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"5a28c879-c28b-4609-9fa7-473d4ad08751"],

