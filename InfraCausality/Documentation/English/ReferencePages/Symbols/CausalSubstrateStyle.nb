    BaseStyle->"InlineFormula"], "[", 
   StyleBox["size", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6946ebd-606f-44ae-bc23-94f8f66adb7d"],
 "\[LineSeparator]",
 "gives the ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696dde0b-ab41-4b9c-8570-c2cb3a6c131a"],
 " options a causal substrate of size ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03b9defb-18c2-44f2-87a7-130d2cb881b0"],
 ", ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a98349d8-0d2e-4377-aae3-e9ebd3c7d797"],
 " or ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b62fb47c-eb7e-4749-ab5d-99f292fe8b01"],
 " is drawn with.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fa8b3767-f008-4903-a9d4-e2edf2d0603b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CausalSubstrateStyle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateStyle", 
