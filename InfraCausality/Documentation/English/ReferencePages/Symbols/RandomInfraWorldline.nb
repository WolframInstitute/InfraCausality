Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cb5848-f54b-4e1e-9ed4-d3ca0302b998"],
 " gives ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128ae26f-c0c8-4967-a359-b87a7ef212d9"],
 " distinct members, each a chain of \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") + 1 events that passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldlineQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41c0f1a9-ba78-433f-8d41-3c13c876f5fa"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dae477b-6606-4e49-a63f-51f138ef6275"],
 "."
}], "ExampleText",ExpressionUUID->"e8cb09cc-56ce-42ad-aed2-cd5eff19f3c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Length\>\""}], "]"}], " ", "+", " ", "1"}], "}"}]}], 
       " ", "&&", "\n", "      ", 
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"members", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "#"}], "]"}], " ",
           "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f38895e-1595-42da-a383-98efb3ef7582"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c1f36538-1d2d-4238-a946-da79a570b5ac"]
}, Open  ]],

Cell["\<\
The default draw is uniform: over 1500 draws each of the three worldlines \
from {0, 0} to {1, 2} of the diamond lattice appears with frequency within \
0.05 of 1/3.\
\>", "ExampleText",ExpressionUUID->"9e6cae2e-53cc-4efd-8ca8-eecb2825c6f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1500"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], "]"}], " ", "===", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWorldline", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}]}], 
    " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#", "/", "1500"}], " ", "-", " ", 
          RowBox[{"1", "/", "3"}]}], "]"}], " ", "<", " ", "0.05"}], " ", 
       "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fa952041-f0b1-4530-851a-a25e6df56f63"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b5e67385-677a-4edf-94b5-4e252f802623"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0024c647-269e-4e16-a94a-fb5280d7bb91"],
 " takes the members in sorted order, and the same seed gives the same draw."
}], "ExampleText",ExpressionUUID->"92eac7c2-f268-464b-8145-de61b4dbf407"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"3", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Cardinality\>\""}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n", ",", " ", 
          
          RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
           "Identity"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}],
           ",", " ", "n"}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}], " ", "===", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"cbbeabb2-3986-4977-8540-03875817afa6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7f022126-71cd-4b4d-b274-ba03157f7ab4"]
}, Open  ]],

Cell["\<\
Every worldline lies in the causal diamond of its endpoints, and the \
worldlines of the whole graph run from a source to a sink.\
\>", "ExampleText",ExpressionUUID->"0e445473-b248-4235-b15d-a407f6b13a20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalDiamond", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", "member"}], ",", " ", 
              RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], ",", " ", 
            "member"}], "]"}], " ", "&&", "\n", "        ", 
          RowBox[{
           RowBox[{"VertexInDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"VertexOutDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b8a2fa05-bda0-46a5-8f41-574c4ea6152a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"80969530-55b3-4da4-97ac-3dce9eea92f4"]
}, Open  ]]
}, Open  ]],

