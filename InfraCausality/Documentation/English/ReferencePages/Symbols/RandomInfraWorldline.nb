}], "ExampleText",ExpressionUUID->"359a6cfa-58d6-417c-a04b-fed564dfcb55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Length\>\""}], "]"}], " ", "+", " ", "1"}], "}"}]}], 
       " ", "&&", "\n", "      ", 
       RowBox[{"InfraWorldlineQ", "[", 
        RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"members", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "#"}], "]"}], " ",
           "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4891458-67e7-43b2-9005-437d952922db"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"be88c77a-8258-4e99-babb-f0cb990ea37f"]
}, Open  ]],

Cell["\<\
The default draw is uniform: over 1500 draws each of the three worldlines \
from {0, 0} to {1, 2} of the diamond lattice appears with frequency within \
0.05 of 1/3.\
\>", "ExampleText",ExpressionUUID->"a225abaf-cb8b-4cf7-877d-d8cf5320f37a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1500"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], "]"}], " ", "===", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWorldline", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}]}], 
    " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"Counts", " ", "@", " ", "draws"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#", "/", "1500"}], " ", "-", " ", 
          RowBox[{"1", "/", "3"}]}], "]"}], " ", "<", " ", "0.05"}], " ", 
       "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a9577d45-c8ac-4860-810c-5b98d6ae0486"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5323f4d9-4f09-464e-b707-d64d6bacea7b"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72c4dcaf-742c-4fc2-bb44-015aabbe687f"],
 " takes the members in sorted order, and the same seed gives the same draw."
}], "ExampleText",ExpressionUUID->"d6b200f7-027f-4ed9-a545-80f2d5d3ba27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"UniversalTime", "[", "g", "]"}], "]"}], " ", "-", 
                 " ", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"3", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Cardinality\>\""}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomInfraWorldline", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraWorldline", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n", ",", " ", 
          
          RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
           "Identity"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}],
           ",", " ", "n"}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}], " ", "===", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraWorldline", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "n"}], "]"}]}], 
         ")"}]}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"03f61645-756a-4b77-be0d-2706a8b9fcff"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"6a15f405-b730-4386-aace-c74f4a1b53e8"]
}, Open  ]],

Cell["\<\
Every worldline lies in the causal diamond of its endpoints, and the \
worldlines of the whole graph run from a source to a sink.\
\>", "ExampleText",ExpressionUUID->"8a95461b-c0c7-4164-9e42-eaca46ac2c9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalDiamond", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", "member"}], ",", " ", 
              RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], ",", " ", 
            "member"}], "]"}], " ", "&&", "\n", "        ", 
          RowBox[{
           RowBox[{"VertexInDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"VertexOutDegree", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Last", " ", "@", " ", "member"}]}], "]"}], " ", "==", 
           " ", "0"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"487e3ad0-c80f-4d17-a80e-33a3a4952d8d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"ed289ce3-a760-4aed-a452-064f5784b368"]
}, Open  ]]
}, Open  ]],

