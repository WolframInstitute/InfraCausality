Cell[TextData[{
 "Definition: the members of a worldline head are its longest chains, the \
paths from source to sink of ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "7034abff-13cc-4287-921c-f612ddee9262"],
 ". A member is a vertex list ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " = ",
 StyleBox["q", "TI"],
 " in causal order, with ",
 StyleBox["k", "TI"],
 " = \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "). The same sampler draws every form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba28855c-2c9c-47e5-ace5-6c006decf78f"],
 ": the two-event form, the whole-graph form, and the experimental polyline \
and from-event forms."
}], "Notes",ExpressionUUID->"86be4f1f-b174-4c44-bf06-8f3e06483b88"],

Cell[TextData[{
 "The default draw is uniform over the members. It descends the graph of the \
head from a source, choosing each next event with probability proportional to \
the number of members through it, which dynamic programming counts once; so \
each member is drawn with probability 1/",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8cc93ff-76e1-46f6-9627-2834f8054a46"],
 ". Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa959ae3-077f-46be-90bd-1c386ef9eec0"],
 " to reproduce a draw."
}], "Notes",ExpressionUUID->"db1d928e-56d2-4a4f-a1b1-f40bf1a33457"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e1902fe-6291-4adb-ab0d-51b406fbf782"],
 " sampler shares:"
}], "Notes",ExpressionUUID->"87e98fb6-02df-43d6-b26b-ffc7675225c5"],

