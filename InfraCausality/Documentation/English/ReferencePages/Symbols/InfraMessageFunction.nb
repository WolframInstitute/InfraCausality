Cell[TextData[{
 "On the lattice the message k-factors of the resting chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and the chain {((",
 StyleBox["p", "TI"],
 " + 1)",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["pm", "TI"],
 ")} of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) are 1/",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " + 1, the ratios of their tick rates; their product (",
 StyleBox["p", "TI"],
 " + 1)/",
 StyleBox["p", "TI"],
 " is the square of the Bondi factor, which the echo reads directly."
}], "ExampleText",ExpressionUUID->"d5a8ee12-f781-48d7-87a0-4669ea0a43ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p", " ", "+", " ", "1"}], ")"}], " ", "m"}], ",", 
              " ", 
              RowBox[{"p", " ", "m"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"m", ",", " ", "1", ",", " ", 
              RowBox[{"Floor", "[", 
               RowBox[{"6", "/", 
                RowBox[{"(", 
                 RowBox[{"p", " ", "+", " ", "1"}], ")"}]}], "]"}]}], "}"}]}],
            "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}]}]}], 
        "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
           " ", "\"\<KFactor\>\""}], "]"}], ",", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"b", ",", " ", "a"}], "]"}], ",", 
           " ", "\"\<KFactor\>\""}], "]"}], ",", "\n", "        ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
             " ", "\"\<KFactor\>\""}], "]"}], " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"b", ",", " ", "a"}], "]"}], ",", 
             " ", "\"\<KFactor\>\""}], "]"}]}], " ", "==", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", "v"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "v"}], ")"}]}]}]}], "}"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"23f28827-3033-47e0-8cc2-eae606ff7283"],

