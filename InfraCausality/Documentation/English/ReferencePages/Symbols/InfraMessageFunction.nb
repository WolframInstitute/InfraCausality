Cell[TextData[{
 "The message relation on the sprinkling. The first tick reaches two ticks of \
",
 StyleBox["b", "TI"],
 "; the last four reach none."
}], "ExampleText",ExpressionUUID->"f451edd4-fee5-4bb5-a5ac-aefb343ef6bd"],

