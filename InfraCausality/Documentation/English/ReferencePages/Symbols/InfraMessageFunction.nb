Cell["Defects and the k-factor", "ExampleSubsection",ExpressionUUID->"e715604b-6149-43a3-8cda-18f67f501faa"],

Cell[TextData[{
 "The lattice observers at rest, the chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and its parallel {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 2)}, exchange their ticks one to one: on the interior window the four \
defects vanish and the k-factor is 1."
}], "ExampleText",ExpressionUUID->"5b5cefa0-0241-46e5-8afe-774de6112aeb"],

Cell[CellGroupData[{

