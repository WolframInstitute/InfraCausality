         " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"f", " ", "|->", " ", 
         RowBox[{"InfraMessageFunctionQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
