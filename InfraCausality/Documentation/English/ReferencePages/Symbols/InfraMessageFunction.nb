           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Normal", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMessageFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Relation\>\""}], "]"}]}], ",", " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "images"}], "}"}], " ", "|->", "\n", 
         "      ", 
         RowBox[{
          RowBox[{"Sort", "[", "images", "]"}], " ", "===", " ", 
          RowBox[{"Intersection", "[", 
           RowBox[{"b", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b6f44d72-1cee-411e-ab43-b2ec108e2ae7"],

