Cell["\<\
Sending every tick to its earliest image is always a message function.\
\>", "ExampleText",ExpressionUUID->"8c97401e-2e8a-4469-86ec-4593e7aab28b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraMessageFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", "\n", "      ", 
       RowBox[{"First", " ", "/@", " ", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraMessageFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
            " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
          RowBox[{"{", "}"}]}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
