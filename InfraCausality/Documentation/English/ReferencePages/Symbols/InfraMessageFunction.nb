    }], "TableText",ExpressionUUID->"ab40a1c9-92e0-428a-adb6-2d8b5362f729"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4d1cfe87-95a5-41ba-b2f3-e0bd379ffacc"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d5551021-443d-48ae-a069-ac674e631bd3"]], "TableText",ExpressionUUID->
     "2d974a78-906f-4c11-935d-bc27d979b75f"], Cell[TextData[{
     "the directed graph ",
     StyleBox["v", "TI"],
     " \[RightArrow] ",
     StyleBox["w", "TI"],
     " of the relation"
    }], "TableText",ExpressionUUID->"35f98f10-f587-4c58-8f2c-8d83e8974e08"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "32333ca0-795a-4bdb-903c-763260e3e45d"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
