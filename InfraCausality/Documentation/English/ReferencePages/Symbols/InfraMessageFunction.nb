Cell["\<\
The defects lie in the unit interval, and the injectivity defect is at least \
the domain defect.\
\>", "ExampleText",ExpressionUUID->"8d2ee627-a12b-4999-8f44-b74533b76cf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"defects", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "p"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<DomainDefect\>\"", ",", " ", "\"\<FunctionDefect\>\"",
              ",", " ", "\"\<InjectivityDefect\>\"", ",", 
             " ", "\"\<OrderDefect\>\""}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"defects", ",", " ", 
        RowBox[{
         RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
         "&"}]}], "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"defects", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", ">=", " ", 
       RowBox[{"defects", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2fbf9fb3-cb53-4dd3-897a-b44ff4183592"],

