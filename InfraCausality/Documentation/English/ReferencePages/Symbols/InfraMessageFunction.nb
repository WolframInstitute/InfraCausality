     "d14aea46-cea8-461d-8c57-f2fe09e1d6f0"]], "TableText",ExpressionUUID->
     "309c328b-1a80-4302-baed-7b7fca5fa9a4"], Cell[TextData[{
     "the number of message functions, by dynamic programming over the ticks \
of ",
     StyleBox["a", "TI"]
    }], "TableText",ExpressionUUID->"3feeceec-7738-457e-8050-fb934f2934fd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e7ac6566-7a9d-461c-8ca3-827e933c654b"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c253df85-3722-426d-ba09-58f56eaa9568"]], "TableText",ExpressionUUID->
     "d9ee932e-f7d1-4b3d-afc6-11c23475dda6"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "004e8af9-6cd6-415b-a767-a74c578f3c24"]], "TableText",ExpressionUUID->
     "05597701-7374-434a-b19a-159dc71c6467"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c9c0b563-e070-41e0-8710-\
7c81faa5ad4c"],

Cell[TextData[{
 "A member is an association from the ticks of ",
 StyleBox["a", "TI"],
 " with a message to ticks of ",
 StyleBox["b", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d3ded740-b204-40dc-93d3-2de5ef408790"],
 " recognises one, and the experimental ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55257660-aef0-4de9-b3e2-d849ba57fbd3"],
 " draws members uniformly or enumerates them. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ef4134c-98c9-4cac-9a9b-2e034d48a00c"],
 " draws the head as the light rays that carry its messages."
}], "Notes",ExpressionUUID->"f4402ee9-54f6-489d-83f1-7ea82fd09449"],

Cell[TextData[{
 "Experimental: the EPS defects measure how far the relation is from a \
monotone bijection of ",
 StyleBox["a", "TI"],
 " onto ",
 StyleBox["b", "TI"],
 ", the message function of two inertial observers in Minkowski space. They \
are read on a window of ",
 StyleBox["a", "TI"],
 ", the ticks that remain after the option ",
 Cell[BoxData[
  RowBox[{"\"\<Boundary\>\"", " ", "->", " ", "b"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96b390b1-94be-4512-bba1-b0a440f1087c"],
 " drops ",
 StyleBox["b", "TI"],
 " ticks at each end (default 0), given as a fourth argument; the images stay \
in the whole of ",
 StyleBox["b", "TI"],
 ". With ",
 StyleBox["M", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") the image of a window tick and ",
 StyleBox["n", "TI"],
 " the window size:"
}], "Notes",ExpressionUUID->"e4e82f1e-0ac8-4874-8156-203dd2234f8c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9892c862-8c71-40eb-9193-d48d8254b06b"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"49bd6fab-60a3-4551-a7ed-6a5d63e3c8ae"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"7a0de4b8-7c41-4317-a66b-9601519f02a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aa1adffd-3ad0-49f0-bdb5-2f31b7dcd14c"], Cell[TextData[Cell[
    BoxData["\"\<DomainDefect\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "33d6c586-6a7a-4b36-9f1f-9538c84caf75"]], "TableText",ExpressionUUID->
     "fe9e13cc-2e1e-4334-9e4b-7eeeeb614f65"], Cell[TextData[{
     "#{",
     StyleBox["v", "TI"],
     " : ",
     StyleBox["M", "TI"],
     "(",
     StyleBox["v", "TI"],
     ") = \[EmptySet]} / ",
     StyleBox["n", "TI"],
     ", the fraction of ticks without a message"
    }], "TableText",ExpressionUUID->"005529fc-c041-4ffc-a896-c2dee842d999"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6db05831-6e19-4807-b285-a038e3902fb7"], Cell[TextData[Cell[
    BoxData["\"\<FunctionDefect\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e391fa2d-842b-438e-b851-aea6ee1e34cf"]], "TableText",ExpressionUUID->
     "8026f142-a35e-480f-ab4d-50386009dfaf"], Cell[TextData[{
     "the mean over the window of max(0, |",
     StyleBox["M", "TI"],
     "(",
     StyleBox["v", "TI"],
     ")| \[Minus] 1) / max(1, |",
     StyleBox["M", "TI"],
     "(",
     StyleBox["v", "TI"],
     ")|), zero exactly when every image has at most one tick"
    }], "TableText",ExpressionUUID->"f16265a8-f1a8-415b-966d-b8538553c50c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "45e50b61-2d9e-4bf6-a5e1-7924e3584d78"], Cell[TextData[Cell[
    BoxData["\"\<InjectivityDefect\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "887f81b8-4d0c-4b20-8ecd-8ac36b8e459c"]], "TableText",ExpressionUUID->
     "4c842a67-5601-4e81-955f-e5ef66bd19a8"], Cell[TextData[{
     "1 \[Minus] \[Nu] / ",
     StyleBox["n", "TI"],
     ", with \[Nu] the size of a maximum matching of the bipartite graph of \
the relation"
    }], "TableText",ExpressionUUID->"997f3689-1518-4e8c-b626-9b0ce155a06b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bfd74500-9610-4307-bfe8-032c102d78e1"], Cell[TextData[Cell[
    BoxData["\"\<OrderDefect\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "98ba41e4-81b9-400e-baae-38bc16a4799a"]], "TableText",ExpressionUUID->
     "d0cdc371-7b97-4bd8-a3bd-f9fa7ff31d65"], Cell[TextData[{
     "the fraction of ordered tick pairs ",
     StyleBox["v", "TI"],
     " before ",
     StyleBox["w", "TI"],
     " in the window for which some image of ",
     StyleBox["v", "TI"],
     " comes after some image of ",
     StyleBox["w", "TI"],
     " on ",
     StyleBox["b", "TI"]
    }], "TableText",ExpressionUUID->"59ec4d29-0d8e-4f58-8ef4-1d81fefee12f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "562b296f-c258-4df6-a085-fb1904ddc101"], Cell[TextData[Cell[
    BoxData["\"\<KFactor\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ec5918a7-c8c5-42aa-b770-6baddbd1a376"]], "TableText",ExpressionUUID->
     "ac086525-1aa6-4dba-98e1-a2a6a4dbd7a3"], Cell[TextData[{
     "the ratio of received to sent tick spans of the earliest-image \
selection: with ",
     StyleBox["v", "TI"],
     ", ",
     StyleBox["w", "TI"],
     " the first and last window ticks that have a message, (pos ",
     StyleBox["f", "TI"],
     "(",
     StyleBox["w", "TI"],
     ") \[Minus] pos ",
     StyleBox["f", "TI"],
     "(",
     StyleBox["v", "TI"],
     ")) / (pos ",
     StyleBox["w", "TI"],
     " \[Minus] pos ",
     StyleBox["v", "TI"],
     "), positions counted on ",
     StyleBox["b", "TI"],
     " and on ",
     StyleBox["a", "TI"]
    }], "TableText",ExpressionUUID->"4aeef286-e79a-41d5-b89e-2ba820664298"]}
  }]], "2ColumnTableMod",ExpressionUUID->"893ae5bd-dddc-47b7-b4c7-\
18df54ec1f6f"],

Cell[TextData[{
 "The four defects lie in [0, 1]; the injectivity defect is at least the \
domain defect, since a matching uses no tick without a message. The k-factor \
is the graph form of the Bondi factor: in Minkowski space an inertial \
observer receding at speed ",
 StyleBox["v", "TI"],
 " receives the ticks of another at ",
 StyleBox["k", "TI"],
 " = \[Sqrt]((1 + ",
 StyleBox["v", "TI"],
 ")/(1 \[Minus] ",
 StyleBox["v", "TI"],
 ")) proper seconds per second sent. On a graph the tick spans are chain \
lengths, so the reading is a clock-rate statement, and it is the Bondi factor \
only where ticks count proper time. On the diamond lattice the chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} at rest sends its ticks one to one to the chain {(2",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} of velocity 1/3, k-factor 1 instead of \[Sqrt]2, because that chain's \
ticks are \[Sqrt]2 times longer in proper time; the echo read on the resting \
clock alone recovers \[Sqrt]2, see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1fe3523-c396-4a07-9cbd-4c20afc30f7f"],
 "."
}], "Notes",ExpressionUUID->"adb622c6-21a6-4ba6-b1f4-0ee592af40dc"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"256d1c9d-3a61-4098-a43a-a3527bd25305"],

