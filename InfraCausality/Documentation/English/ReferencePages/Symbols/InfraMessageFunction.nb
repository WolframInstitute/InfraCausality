     "2a5cbe3c-4b55-4834-a293-759e52fbe3fc"], Cell[
    "Message function", "TableText",ExpressionUUID->
     "2b84524f-72cb-4f27-843d-989809619183"], Cell[TextData[{
     "The map from a particle ",
     StyleBox["P", "TI"],
     " to a particle ",
     StyleBox["Q", "TI"],
     " that sends an event of ",
     StyleBox["P", "TI"],
     " to the event of ",
     StyleBox["Q", "TI"],
     " reached by a light signal from it; with the echo it defines radar \
coordinates."
    }], "TableText",ExpressionUUID->"a53d3ebf-93e6-45e9-8b19-e960b4dc6259"]}
  }]], "3ColumnTableMod",ExpressionUUID->"2f535553-7fe1-4534-a4f1-\
fab35a8f8001"]
}, Open  ]],

