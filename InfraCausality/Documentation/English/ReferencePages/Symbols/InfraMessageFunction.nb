Cell[TextData[{
 "Between two parallel null lines of the diamond lattice the message function \
is unique: the tick {0, ",
 StyleBox["j", "TI"],
 "} is sent to {2, ",
 StyleBox["j", "TI"],
 "}."
}], "ExampleText",ExpressionUUID->"3b9812d1-3f5e-4358-ac44-67d059c66369"],

