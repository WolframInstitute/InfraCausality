Cell["\<\
Each light ray from the staircase meets the shifted staircase in two \
consecutive ticks, so the function defect of the interior window is exactly \
1/2; the two pairs of consecutive ticks with the same two images make the \
order defect 2/10 on a window of five ticks.\
\>", "ExampleText",ExpressionUUID->"2237ac4e-7d51-4537-9f93-e2bff437b4e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "i"}], "}"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "2"}], "}"}]}], ")"}], " ", "&"}], " ", "/@",
         " ", "a"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], " ", "<=", " ", "6"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMessageFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "p", ",", " ", 
       RowBox[{"\"\<Boundary\>\"", " ", "->", " ", "4"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<DomainDefect\>\"", ",", " ", "\"\<FunctionDefect\>\"", ",",
          " ", "\"\<InjectivityDefect\>\"", ",", " ", "\"\<OrderDefect\>\""}],
         "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"60865f07-57e6-431a-8c8e-f6111c00abbd"],

