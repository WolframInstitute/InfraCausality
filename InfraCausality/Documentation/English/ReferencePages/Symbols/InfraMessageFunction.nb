Cell["\<\
The experimental defects lie in the unit interval, and the injectivity defect \
is at least the domain defect.\
\>", "ExampleText",ExpressionUUID->"8444f2f7-daf2-48d4-b81f-7279ac3c2d25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"defects", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "p"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<DomainDefect\>\"", ",", " ", "\"\<FunctionDefect\>\"",
              ",", " ", "\"\<InjectivityDefect\>\"", ",", 
             " ", "\"\<OrderDefect\>\""}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"defects", ",", " ", 
        RowBox[{
         RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
         "&"}]}], "]"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"defects", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", ">=", " ", 
       RowBox[{"defects", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"ef128c8a-6e7e-4340-8fe2-921779415d9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"3cf16f36-9ee0-4603-a42a-5d3c5d020579"]
}, Open  ]],

Cell[TextData[{
 "On the lattice the message k-factors of the resting chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and the chain {((",
 StyleBox["p", "TI"],
 " + 1)",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["pm", "TI"],
 ")} of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) are 1/",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " + 1, the ratios of their tick rates; their product (",
 StyleBox["p", "TI"],
 " + 1)/",
 StyleBox["p", "TI"],
 " is the square of the Bondi factor, which the echo reads directly."
}], "ExampleText",ExpressionUUID->"d9b38502-ec28-460c-9d79-42544a9ef3b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p", " ", "+", " ", "1"}], ")"}], " ", "m"}], ",", 
              " ", 
              RowBox[{"p", " ", "m"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"m", ",", " ", "1", ",", " ", 
              RowBox[{"Floor", "[", 
               RowBox[{"6", "/", 
                RowBox[{"(", 
                 RowBox[{"p", " ", "+", " ", "1"}], ")"}]}], "]"}]}], "}"}]}],
            "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}]}]}], 
        "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
           " ", "\"\<KFactor\>\""}], "]"}], ",", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"b", ",", " ", "a"}], "]"}], ",", 
           " ", "\"\<KFactor\>\""}], "]"}], ",", "\n", "        ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
             " ", "\"\<KFactor\>\""}], "]"}], " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraMessageFunction", "[", 
              RowBox[{"b", ",", " ", "a"}], "]"}], ",", 
             " ", "\"\<KFactor\>\""}], "]"}]}], " ", "==", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", "v"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "v"}], ")"}]}]}]}], "}"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"38b554a3-3240-40d2-84d8-6eea0125b88b"],

