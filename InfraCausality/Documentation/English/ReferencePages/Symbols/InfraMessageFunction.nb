Cell[TextData[{
 "The lattice observers at rest, the chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and its parallel {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 2)}, exchange their ticks one to one: on the interior window the four \
defects vanish and the k-factor is 1."
}], "ExampleText",ExpressionUUID->"ccbd6ef6-f75a-42a1-a891-b970e27c289a"],

