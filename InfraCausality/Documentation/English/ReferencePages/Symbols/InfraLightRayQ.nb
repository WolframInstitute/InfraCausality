    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76eaf994-2c02-4416-b1d5-fc44415ed1c5"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d4d5bc3-d698-4765-9cec-f0eb36bdfe8e"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 " equal to the causal diamond of its first and last events.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c42fb7f2-de3b-4b6a-92dd-a57a543e15d0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cded7d6-9b25-44e4-a517-5b03d0cb99c2"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"ccdc39d1-721a-4ef7-93c7-11a4f6c93cbf"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a light ray when it is a saturated chain of ",
 StyleBox["g", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldlineQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldlineQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f87fdb83-c0e1-4cab-801a-7100ec29ae26"],
 " tests, and the diamond [",
 StyleBox["e", "TI"],
 "0, ",
 StyleBox["ek", "TI"],
 "] has exactly ",
 StyleBox["k", "TI"],
 " + 1 events: no event lies between ",
 StyleBox["e", "TI"],
 "0 and ",
 StyleBox["ek", "TI"],
 " off the chain, so the chain is the only route from ",
 StyleBox["e", "TI"],
 "0 to ",
 StyleBox["ek", "TI"],
 "."
}], "Notes",ExpressionUUID->"d4e6ffb2-2ab5-4c29-91bd-c99f82f9f18c"],

Cell[TextData[{
 "This is the discrete analogue of null separation: there is no room beside \
the ray for a second path. Equivalently, the chain is saturated and ",
 StyleBox["ek", "TI"],
 " lies on the future light cone ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0); then every event of the chain lies on ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0) and on the past light cone ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["ek", "TI"],
 "). A light ray need not be inextendible: an initial segment of a member of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8592cbd4-80d6-45df-9893-9b05ded6867f"],
 " is a light ray too."
}], "Notes",ExpressionUUID->"fe48ee2b-6708-4224-b324-0d0c9d315292"],

Cell[TextData[{
 "The condition is symmetric in time, so the predicate accepts the outgoing \
rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab84e7e0-61c7-4ca7-a8b1-e8b62cfd0d8a"],
 ", listed from ",
 StyleBox["v", "TI"],
 ", and the incoming rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPastLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraPastLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea0c8746-2f38-4c12-92ed-ed209de32bcb"],
 ", listed in causal order up to ",
 StyleBox["v", "TI"],
 ". A single event is a light ray; the empty list is not. The predicate takes \
a chain, never an object."
}], "Notes",ExpressionUUID->"b31dbf0b-6821-4bf5-9edb-899243164f21"],

Cell["\<\
A light ray is the strongest condition of the chain hierarchy, each condition \
stronger than the next:\
\>", "Notes",ExpressionUUID->"020e185a-f691-4485-a3d6-c8fb0591de0b"],

