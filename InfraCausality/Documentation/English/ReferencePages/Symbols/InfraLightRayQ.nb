Cell["\<\
On each substrate: an outgoing light ray passes, and a worldline from the \
same event to the event four slices up with the largest diamond fails, since \
the diamond of its ends is larger than the chain.\
\>", "ExampleText",ExpressionUUID->"2d2fe191-12b3-4313-bbac-a6bac29ac5c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"RandomInfraCausalFuture", "[", 
             RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}], ",", 
          " ", 
          RowBox[{"e", " ", "|->", " ", 
           RowBox[{"Length", " ", "@", " ", 
            RowBox[{"RandomInfraCausalDiamond", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "e"}], "]"}]}]}]}], 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ray", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomInfraFutureLightCone", "[", 
          RowBox[{"g", ",", " ", "v"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"member", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraLightRayQ", "[", 
        RowBox[{"g", ",", " ", "ray"}], "]"}], ",", " ", 
       RowBox[{"InfraLightRayQ", "[", 
        RowBox[{"g", ",", " ", "member"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"RandomInfraCausalDiamond", "[", 
          RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}], "]"}], " ", "==",
         " ", 
        RowBox[{"Length", "[", "member", "]"}]}]}], "}"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4d47df9e-6791-4a71-b3ce-accb009a2e98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False", ",", "False"}], "}"}]}], "}"}]], "Output",
