Cell[CellGroupData[{
Cell["InfraLightRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92c566d4-0a2a-49ab-bb99-42d1e09fb45d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "937690fc-9a4f-4fda-8728-fef9e70bb4f3"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e949cfd2-ade5-415a-8eb3-c3662dd2301c"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 " equal to the causal diamond of its first and last events.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2e3fd5fc-57c1-4d71-b95a-09aa17e65ef7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ae68944-8f91-433b-a295-f77d575b4581"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"2a561fad-df0b-4a3b-87a7-79c967f5b1ee"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a light ray when it is a saturated chain of ",
 StyleBox["g", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1be6b272-aadd-4048-8a9c-6f7a6057a8f6"],
 " tests, and the diamond [",
 StyleBox["e", "TI"],
 "0, ",
 StyleBox["ek", "TI"],
 "] has exactly ",
 StyleBox["k", "TI"],
 " + 1 events: no event lies between ",
 StyleBox["e", "TI"],
 "0 and ",
 StyleBox["ek", "TI"],
 " off the chain, so the chain is the only route from ",
 StyleBox["e", "TI"],
 "0 to ",
 StyleBox["ek", "TI"],
 "."
}], "Notes",ExpressionUUID->"9208be24-379d-4b08-83ec-e1b9528e13cb"],

Cell[TextData[{
 "This is the discrete analogue of null separation: there is no room beside \
the ray for a second path. Equivalently, the chain is saturated and ",
 StyleBox["ek", "TI"],
 " lies on the future light cone ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0); then every event of the chain lies on ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0) and on the past light cone ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["ek", "TI"],
 "). A light ray need not be inextendible: an initial segment of a member of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26f682b6-8755-4393-ae3f-0826922f6d08"],
 " is a light ray too."
}], "Notes",ExpressionUUID->"c7a3ce2e-2cd9-49ae-adab-4082cee5e277"],

Cell[TextData[{
 "The condition is symmetric in time, so the predicate accepts the outgoing \
rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "80bba3ef-77c5-4c59-a370-7a069c246855"],
 ", listed from ",
 StyleBox["v", "TI"],
 ", and the incoming rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPastLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraPastLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd94159c-9210-4563-8dea-afdecee33c09"],
 ", listed in causal order up to ",
 StyleBox["v", "TI"],
 ". A single event is a light ray; the empty list is not. The predicate takes \
a chain, never an object."
}], "Notes",ExpressionUUID->"42a0dc59-9f09-4122-969a-40904f7deba8"],

Cell["\<\
A light ray is the strongest condition of the chain hierarchy, each condition \
stronger than the next:\
\>", "Notes",ExpressionUUID->"f6ae9985-13a1-48ec-9342-11e06d85dfca"],

