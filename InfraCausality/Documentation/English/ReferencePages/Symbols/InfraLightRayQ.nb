Cell[CellGroupData[{
Cell["InfraLightRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c53e3ef2-8963-401b-8f3d-8a2e12bff5f2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
