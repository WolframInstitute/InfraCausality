Cell[CellGroupData[{
Cell["InfraLightRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ab1b614-5f16-45ae-936e-1bb625b595f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c96698ca-8505-42ca-b51c-4a147f5ca926"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657aa600-93b1-42f0-86b2-a7cd2ce29e21"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 " equal to the causal diamond of its first and last events.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"deb8bda5-8b4e-4484-a91e-796160354f2e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "788e43fb-7973-40fb-9885-284ffbe989ba"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"c9fc3a68-6cd7-4f9b-b3b4-96768decaa04"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a light ray when it is a saturated chain of ",
 StyleBox["g", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e92f6b45-914c-4de1-bb5d-31067a74e509"],
 " tests, and the diamond [",
 StyleBox["e", "TI"],
 "0, ",
 StyleBox["ek", "TI"],
 "] has exactly ",
 StyleBox["k", "TI"],
 " + 1 events: no event lies between ",
 StyleBox["e", "TI"],
 "0 and ",
 StyleBox["ek", "TI"],
 " off the chain, so the chain is the only route from ",
 StyleBox["e", "TI"],
 "0 to ",
 StyleBox["ek", "TI"],
 "."
}], "Notes",ExpressionUUID->"f47bfe67-bf14-41ff-ab51-e89dd1c4898d"],

Cell[TextData[{
 "This is the discrete analogue of null separation: there is no room beside \
the ray for a second path. Equivalently, the chain is saturated and ",
 StyleBox["ek", "TI"],
 " lies on the future light cone ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0); then every event of the chain lies on ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0) and on the past light cone ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["ek", "TI"],
 "). A light ray need not be inextendible: an initial segment of a member of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8db7082f-ee8a-4a46-8091-ae87bcf08815"],
 " is a light ray too."
}], "Notes",ExpressionUUID->"c0aaaf47-5450-4c89-87c1-bd7dcd6a410a"],

Cell[TextData[{
 "The condition is symmetric in time, so the predicate accepts the outgoing \
rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da746093-6992-4608-b091-c776d906c54e"],
 ", listed from ",
 StyleBox["v", "TI"],
 ", and the incoming rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPastLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraPastLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "309a6fe6-8c83-4270-b8c3-bc48ed29455b"],
 ", listed in causal order up to ",
 StyleBox["v", "TI"],
 ". A single event is a light ray; the empty list is not. The predicate takes \
a chain, never an object."
}], "Notes",ExpressionUUID->"f94ef102-a0d6-47d1-ba9b-875674451ced"],

Cell["\<\
A light ray is the strongest condition of the chain hierarchy, each condition \
stronger than the next:\
\>", "Notes",ExpressionUUID->"8f9e63a4-7b4e-4543-a95c-81c817f7606c"],

