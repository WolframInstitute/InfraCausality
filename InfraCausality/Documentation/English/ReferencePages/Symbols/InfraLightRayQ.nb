Cell["\<\
A saturated chain is a light ray exactly when its last event lies on the \
future light cone of its first. Checked on every path of the graph between \
two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"1e71eab6-5c6e-4a0a-b708-87226c8862a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}]}], "]"}], ",", 
           " ", 
           RowBox[{"w", " ", "|->", "\n", "        ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"FindPath", "[", 
               RowBox[{
               "g", ",", " ", "v", ",", " ", "w", ",", " ", "Infinity", ",", 
                " ", "All"}], "]"}], ",", " ", 
              RowBox[{"chain", " ", "|->", "\n", "          ", 
               RowBox[{
                RowBox[{"InfraLightRayQ", "[", 
                 RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"Keys", " ", "@", " ", 
                   RowBox[{"InfraMeasurement", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "w"}], 
                 "]"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8f297b6-d984-43da-8785-6c3574573a1b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"29ce6a7c-2345-44b0-9f67-450086a41c55"]
}, Open  ]],

Cell["\<\
Every light ray is a worldline: the only chain between its ends is also the \
longest.\
\>", "ExampleText",ExpressionUUID->"1cb8b7bc-02a1-4a59-973b-a8b771dfde3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"RandomInfraFutureLightCone", "[", 
            RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{"InfraWorldlineQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraWorldline", "[", 
                 RowBox[{
                  RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                  RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], ",", 
                " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
              "1"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ee5e5f21-f142-41e0-b78d-92a9a9314cb9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"422ca31b-b010-46de-8533-7ddbab5f3296"]
}, Open  ]],

Cell["The events of a light ray form a causal diamond.", "ExampleText",ExpressionUUID->"f994a7d9-0539-43b6-8886-4eda58b03a9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"RandomInfraPastLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomInfraCausalDiamond", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], " ", "===", 
              " ", 
              RowBox[{"Sort", "[", "ray", "]"}]}], " ", "&&", " ", 
             RowBox[{"InfraCausalDiamondQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}]}]}]}], "]"}]}]}], "]"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"696a533c-bc2a-4475-a86d-2d902f173db3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"b4fb497e-39cb-44d3-8092-6153faae7e1f"]
}, Open  ]]
}, Open  ]],

