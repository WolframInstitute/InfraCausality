Cell["\<\
A saturated chain is a light ray exactly when its last event lies on the \
future light cone of its first. Checked on every path of the graph between \
two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"4b7a5e51-12b6-4ce7-a035-d75d8d2813ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "4", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", " ", 
           RowBox[{"w", " ", "|->", "\n", "        ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"FindPath", "[", 
               RowBox[{
               "g", ",", " ", "v", ",", " ", "w", ",", " ", "Infinity", ",", 
                " ", "All"}], "]"}], ",", " ", 
              RowBox[{"chain", " ", "|->", "\n", "          ", 
               RowBox[{
                RowBox[{"InfraLightRayQ", "[", 
                 RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"Keys", " ", "@", " ", 
                   RowBox[{"InfraMeasurement", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "w"}], 
                 "]"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"77d93064-5f9b-4a33-b50a-7166740cf533"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b9a115a4-3427-4487-94a1-8b52ac2806cc"]
}, Open  ]],

Cell["\<\
Every light ray is a timelike geodesic: the only chain between its ends is \
also the longest.\
\>", "ExampleText",ExpressionUUID->"6a0abae0-247e-4d03-a318-b0fa9e619dac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
