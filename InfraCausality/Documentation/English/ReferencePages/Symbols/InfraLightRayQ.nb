Cell["\<\
On each substrate: an outgoing light ray passes, and a timelike geodesic from \
the same event to the event four slices up with the largest diamond fails, \
since the diamond of its ends is larger than the chain.\
\>", "ExampleText",ExpressionUUID->"3bf79752-ce06-4f19-85c0-ecab856dc483"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalFuture", "[", "v", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "5", "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"e", " ", "|->", " ", 
           RowBox[{"Length", " ", "@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCausalDiamond", "[", 
                RowBox[{"v", ",", " ", "e"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ray", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomInfraFutureLightCone", "[", 
          RowBox[{"g", ",", " ", "v"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"member", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraLightRayQ", "[", 
        RowBox[{"g", ",", " ", "ray"}], "]"}], ",", " ", 
       RowBox[{"InfraLightRayQ", "[", 
        RowBox[{"g", ",", " ", "member"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"v", ",", " ", "w"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", "member", "]"}]}]}], "}"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6d2a740f-9c36-41b2-88b2-1ae8fd1956c6"],

