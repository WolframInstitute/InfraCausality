Cell[CellGroupData[{
Cell["InfraLightRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8808b7b8-fd29-4908-8315-0f7000b07fb2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["chain", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9eda8e9-9f65-4689-96bf-35647e0c2685"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c66f4002-d658-4edf-b6f5-5f0ec64ef532"],
 " if the vertex list ",
 StyleBox["chain", "TI"],
 " is a saturated chain of ",
 StyleBox["g", "TI"],
 " equal to the causal diamond of its first and last events.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bf30ccc7-7e6f-41ab-bf40-fe44cbbdd862"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLightRayQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraLightRayQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["chain1", "TI"], ",", " ", 
      StyleBox["chain2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd548768-7f82-42fb-b1bb-90a5ebc6b3b2"],
 "\[LineSeparator]",
 "tests every chain in the list."
}], "Usage",ExpressionUUID->"e0a05855-44d7-4597-bce7-4b4fe78b83a3"],

Cell[TextData[{
 "Statement: a vertex list ",
 StyleBox["e", "TI"],
 "0, \[Ellipsis], ",
 StyleBox["ek", "TI"],
 " is a light ray when it is a saturated chain of ",
 StyleBox["g", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraObserverQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraObserverQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b123393-fc7a-4d3c-8030-1fce2ab3a0ec"],
 " tests, and the diamond [",
 StyleBox["e", "TI"],
 "0, ",
 StyleBox["ek", "TI"],
 "] has exactly ",
 StyleBox["k", "TI"],
 " + 1 events: no event lies between ",
 StyleBox["e", "TI"],
 "0 and ",
 StyleBox["ek", "TI"],
 " off the chain, so the chain is the only route from ",
 StyleBox["e", "TI"],
 "0 to ",
 StyleBox["ek", "TI"],
 "."
}], "Notes",ExpressionUUID->"f02f7304-340a-457c-8e5a-6485503027ea"],

Cell[TextData[{
 "This is the discrete analogue of null separation: there is no room beside \
the ray for a second path. Equivalently, the chain is saturated and ",
 StyleBox["ek", "TI"],
 " lies on the future light cone ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0); then every event of the chain lies on ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["e", "TI"],
 "0) and on the past light cone ",
 StyleBox["E", "TI"],
 "\:207b(",
 StyleBox["ek", "TI"],
 "). A light ray need not be inextendible: an initial segment of a member of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f590e05-6359-4b54-a045-86095864f657"],
 " is a light ray too."
}], "Notes",ExpressionUUID->"f44741ea-4682-4e8a-9d89-96532f1bb16f"],

Cell[TextData[{
 "The condition is symmetric in time, so the predicate accepts the outgoing \
rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFutureLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraFutureLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfa0208b-c9da-44fa-928d-692474ff3e32"],
 ", listed from ",
 StyleBox["v", "TI"],
 ", and the incoming rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPastLightCone"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraPastLightCone", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8ed5d812-bd87-4011-bbfd-409693624a4c"],
 ", listed in causal order up to ",
 StyleBox["v", "TI"],
 ". A single event is a light ray; the empty list is not. The predicate takes \
a chain, never an object."
}], "Notes",ExpressionUUID->"a3c04c8d-3d90-4172-80d1-bc7ed6afa0f1"],

Cell["\<\
A light ray is the strongest condition of the chain hierarchy, each condition \
stronger than the next:\
\>", "Notes",ExpressionUUID->"92bd9a35-8f36-497a-9786-3458199af7a5"],

