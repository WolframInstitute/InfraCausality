Cell["\<\
A saturated chain is a light ray exactly when its last event lies on the \
future light cone of its first. Checked on every path of the graph between \
two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"32f05d65-e8a6-4b9c-b317-2732a37ecc71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}]}], "]"}], ",", 
           " ", 
           RowBox[{"w", " ", "|->", "\n", "        ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"FindPath", "[", 
               RowBox[{
               "g", ",", " ", "v", ",", " ", "w", ",", " ", "Infinity", ",", 
                " ", "All"}], "]"}], ",", " ", 
              RowBox[{"chain", " ", "|->", "\n", "          ", 
               RowBox[{
                RowBox[{"InfraLightRayQ", "[", 
                 RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"Keys", " ", "@", " ", 
                   RowBox[{"InfraMeasurement", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "w"}], 
                 "]"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d6dad8e7-5720-46a5-b286-11bc34752079"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c307444b-0048-4f96-bb7d-62165661f410"]
}, Open  ]],

Cell["\<\
Every light ray is a worldline: the only chain between its ends is also the \
longest.\
\>", "ExampleText",ExpressionUUID->"3db1db6b-442b-45d0-b7da-9b3c1d23a289"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"RandomInfraFutureLightCone", "[", 
            RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{"InfraWorldlineQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraWorldline", "[", 
                 RowBox[{
                  RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                  RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], ",", 
                " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
              "1"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"084d19b0-bb6b-4458-be1d-02b8ba2109d1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"feeddb56-6456-45ec-a77b-af3a24fcc2cd"]
}, Open  ]],

Cell["The events of a light ray form a causal diamond.", "ExampleText",ExpressionUUID->"50fefa78-78d1-4f2d-ad0b-f88cb7ec9661"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"RandomInfraPastLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomInfraCausalDiamond", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], " ", "===", 
              " ", 
              RowBox[{"Sort", "[", "ray", "]"}]}], " ", "&&", " ", 
             RowBox[{"InfraCausalDiamondQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}]}]}]}], "]"}]}]}], "]"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"70a0f903-b399-4c5d-9708-10c0e13a54dc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"8328bb6a-2590-4e33-b477-89e11543ca61"]
}, Open  ]]
}, Open  ]],

