           RowBox[{"RandomInfraFutureLightCone", "[", 
            RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{"InfraTimelikeGeodesicQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraTimelikeGeodesic", "[", 
                 RowBox[{
                  RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                  RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], ",", 
                " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
              "1"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e09438c-2f9d-4183-a73a-311eba7d11a0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"06f89942-0d31-4912-8c17-b599976ad1bd"]
}, Open  ]],

Cell["The events of a light ray form a causal diamond.", "ExampleText",ExpressionUUID->"9e2005a8-8015-484b-bf48-a2ece42b7f0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"RandomInfraPastLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Keys", " ", "@", " ", 
               RowBox[{"InfraMeasurement", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraCausalDiamond", "[", 
                  RowBox[{
                   RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                   RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], ",", 
                 " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
              RowBox[{"Sort", "[", "ray", "]"}]}], " ", "&&", " ", 
             RowBox[{"InfraCausalDiamondQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}]}]}]}], "]"}]}]}], "]"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8256fb54-c054-4880-a04c-2332eaf84dfe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"5ad72296-7c03-441e-a362-c330e2d26041"]
}, Open  ]]
}, Open  ]],

