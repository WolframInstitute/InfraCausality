Cell["\<\
A saturated chain is a light ray exactly when its last event lies on the \
future light cone of its first. Checked on every path of the graph between \
two events of each substrate.\
\>", "ExampleText",ExpressionUUID->"8e62dd76-0b82-4ce9-9c17-113cb0452d43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"RandomInfraCausalFuture", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}]}], "]"}], ",", 
           " ", 
           RowBox[{"w", " ", "|->", "\n", "        ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"FindPath", "[", 
               RowBox[{
               "g", ",", " ", "v", ",", " ", "w", ",", " ", "Infinity", ",", 
                " ", "All"}], "]"}], ",", " ", 
              RowBox[{"chain", " ", "|->", "\n", "          ", 
               RowBox[{
                RowBox[{"InfraLightRayQ", "[", 
                 RowBox[{"g", ",", " ", "chain"}], "]"}], " ", "===", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"Keys", " ", "@", " ", 
                   RowBox[{"InfraMeasurement", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "w"}], 
                 "]"}]}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9ab769e6-3daa-437e-afa4-ab04f779c821"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"48ca1b9a-8075-4ab8-b0fd-07aa82b1187a"]
}, Open  ]],

Cell["\<\
Every light ray is a worldline: the only chain between its ends is also the \
longest.\
\>", "ExampleText",ExpressionUUID->"dafd8c91-ff9d-459c-b5e7-e2a761848c10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"RandomInfraFutureLightCone", "[", 
            RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{"InfraWorldlineQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraWorldline", "[", 
                 RowBox[{
                  RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                  RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], ",", 
                " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
              "1"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f91239a4-ea57-4b59-bda4-66ec68172e07"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c17f4b9a-579c-4cf9-95d6-568657333a82"]
}, Open  ]],

Cell["The events of a light ray form a causal diamond.", "ExampleText",ExpressionUUID->"e5dd3ac7-8868-40dd-9757-11891d56536e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"RandomInfraPastLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"ray", " ", "|->", "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomInfraCausalDiamond", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
                RowBox[{"Last", " ", "@", " ", "ray"}]}], "]"}], " ", "===", 
              " ", 
              RowBox[{"Sort", "[", "ray", "]"}]}], " ", "&&", " ", 
             RowBox[{"InfraCausalDiamondQ", "[", 
              RowBox[{"g", ",", " ", "ray"}], "]"}]}]}]}], "]"}]}]}], "]"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f8f70d14-684e-42f7-8537-8bb575f6dabb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"de86d3ab-a61c-4f64-9c39-4886caf2857f"]
}, Open  ]]
}, Open  ]],

