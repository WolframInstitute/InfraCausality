          RowBox[{"#", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "2"}], "}"}]}], ")"}], " ", "&"}], " ", "/@",
         " ", "s"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], " ", "<=", " ", "6"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
