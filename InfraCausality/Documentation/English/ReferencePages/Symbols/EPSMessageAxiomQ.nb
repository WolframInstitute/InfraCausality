Cell["\<\
Each light ray from the staircase meets the shifted staircase in two \
consecutive ticks, so the axiom fails on every window.\
\>", "ExampleText",ExpressionUUID->"353a3917-984a-4296-8eb7-45725e998a6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
