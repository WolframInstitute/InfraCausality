  "7ec41864-c5d7-4b57-be54-3df915426843"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6330abf-e893-41c6-9b4f-4dd9b2b8488d"],
 " if axiom D1 holds exactly on ",
 StyleBox["g", "TI"],
 ": every tick of ",
 StyleBox["a", "TI"],
 " has one message image on ",
 StyleBox["b", "TI"],
 ", and the images strictly increase along ",
 StyleBox["a", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1c0a20d3-5608-439f-a837-0d44aeba0005"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EPSMessageAxiomQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/EPSMessageAxiomQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a143d40-9746-46ef-a068-cfc17d1460bb"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b636330e-78f6-45ce-bd92-79f5b3b88838"],
 " if every tick of ",
 StyleBox["a", "TI"],
 " has one echo via ",
 StyleBox["b", "TI"],
 ", and the echoes strictly increase along ",
 StyleBox["a", "TI"],
 "."
}], "Usage",ExpressionUUID->"662f3400-85a6-434a-b66e-03e71c809777"],

Cell[TextData[{
 "Statement: with ",
 StyleBox["M", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") \:2229 ",
 StyleBox["b", "TI"],
 " the message relation of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b346f7b-17d0-49a6-8472-37f5af5c65c4"],
 ", the pair of observers satisfies axiom D1 on the window ",
 StyleBox["a'", "TI"],
 " of ",
 StyleBox["a", "TI"],
 " when ",
 "|",
 StyleBox["M", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")",
 "|",
 " = 1 for every ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["a'", "TI"],
 " and the position of the image on ",
 StyleBox["b", "TI"],
 " strictly increases along ",
 StyleBox["a'", "TI"],
 "; the relation is then a monotone injection of the window into ",
 StyleBox["b", "TI"],
 ", the message function of two inertial observers in Minkowski space. For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bea241e1-f02b-497e-8d31-dd0488b7ac49"],
 " the relation is ",
 StyleBox["v", "TI"],
 " \[RightArrow] Echo(",
 StyleBox["v", "TI"],
 "), with the echoes anywhere on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"83eb5704-b3a0-462f-a8e6-d59dd9058f0e"],

Cell[TextData[{
 "The predicate tests the pair of observers; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a84f685-2ca5-41ab-8098-05c660903952"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d4509c5-0267-46df-ba5c-25b95ed01a19"],
 " test a candidate map against the pair. When the axiom holds the relation \
has one member, the map itself, and the two tests agree on it."
}], "Notes",ExpressionUUID->"33404e28-a07c-4ebe-97bb-d871fd515cf1"],

