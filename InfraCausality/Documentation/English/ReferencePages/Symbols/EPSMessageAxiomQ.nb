Cell[TextData[{
 "The lattice observers at rest, {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 2)}, exchange their ticks one to one on the interior window, both ways \
and in the echo."
}], "ExampleText",ExpressionUUID->"48f8bc18-1c57-4f94-871e-040830777b07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"m", " ", "+", " ", "2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"EPSMessageAxiomQ", "[", 
      RowBox[{"g", ",", " ", "#", ",", " ", 
       RowBox[{"\"\<Margin\>\"", " ", "->", " ", "2"}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraMessageFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
      RowBox[{"InfraMessageFunction", "[", 
       RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", 
      RowBox[{"InfraEchoFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
      RowBox[{"InfraEchoFunction", "[", 
       RowBox[{"b", ",", " ", "a"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"410467fd-fc52-4d3f-adcd-ecd8891d1f3c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"102a8576-c49b-48a0-b960-063d310b219e"]
}, Open  ]],

Cell[TextData[{
 "Without the margin the two top ticks of {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} send their light out of the lattice, so the axiom fails from that chain \
and holds towards it."
}], "ExampleText",ExpressionUUID->"bded676e-133f-4daa-8f47-ac21e15d14df"],

