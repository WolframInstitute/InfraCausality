    }], "TableText",ExpressionUUID->"7d4fbe58-68d2-4797-9ae6-0d6b84603d52"]}
  }]], "3ColumnTableMod",ExpressionUUID->"a551bf84-5f57-4b48-8cb8-\
75a08f36822c"],

Cell[TextData[{
 "The predicate is the vanishing of the four defects of the head read with \
the same ",
 Cell[BoxData["\"\<Margin\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56784058-d5ef-424d-9e9a-9ac64d6b9e86"],
 ": ",
 Cell[BoxData["\"\<DomainDefect\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "606cd0aa-35cf-417b-b41a-c0df8edbe865"],
 " 0 is every window tick with an image, ",
 Cell[BoxData["\"\<FunctionDefect\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b870551b-269f-4a6c-9549-c3523fd17924"],
 " 0 is at most one image each, ",
 Cell[BoxData["\"\<InjectivityDefect\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "834ebd58-b4e1-43c4-923f-5b5697ed05c5"],
 " 0 with these is distinct images, and ",
 Cell[BoxData["\"\<OrderDefect\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b20639bb-9e01-4098-97af-745afc6c58a6"],
 " 0 with these is images in weakly increasing order, which with distinctness \
is strictly increasing. On an empty window the axiom holds vacuously."
}], "Notes",ExpressionUUID->"7d761be4-6ca8-4a70-8fea-b46dcc76a045"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"80b87bed-4051-4913-8dc2-906a22c07da8"],

