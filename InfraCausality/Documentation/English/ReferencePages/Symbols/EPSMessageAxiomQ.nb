Cell["\<\
The predicate is the vanishing of the four defects read with the same margin.\
\
\>", "ExampleText",ExpressionUUID->"ba45dabd-82db-4841-af94-a8390fd1b823"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
