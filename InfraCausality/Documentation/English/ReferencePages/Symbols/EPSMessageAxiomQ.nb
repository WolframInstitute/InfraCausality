Cell[TextData[{
 "The window of ",
 Cell[BoxData[
  RowBox[{"\"\<Margin\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "723074e3-dbf9-4f21-8e05-9bb0ed0c5d31"],
 " is ",
 StyleBox["a", "TI"],
 " with ",
 StyleBox["k", "TI"],
 " ticks removed at each end; for a message head the answer equals the answer \
for the head whose first observer is the window."
}], "ExampleText",ExpressionUUID->"b61e3c9b-79b0-4420-87d0-a11a4e1de097"],

