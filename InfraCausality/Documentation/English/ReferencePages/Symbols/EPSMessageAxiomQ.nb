Cell[TextData[{
 "On the lattice the chain {((",
 StyleBox["p", "TI"],
 " + 1)",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["pm", "TI"],
 ")} of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) signals the resting chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} tick for tick, while the resting chain reaches only every ",
 StyleBox["p", "TI"],
 "-th tick of it."
}], "ExampleText",ExpressionUUID->"e2e361da-8043-4f2d-9f9f-b07ff224f57c"],

