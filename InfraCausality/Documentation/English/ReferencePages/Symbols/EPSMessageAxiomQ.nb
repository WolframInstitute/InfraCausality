          RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"EPSMessageAxiomQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraEchoFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
