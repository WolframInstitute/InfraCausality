Cell[TextData[{
 "Definition: the members of a future light cone are the outgoing light rays \
of ",
 StyleBox["v", "TI"],
 ", the root-to-leaf paths of its tree ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraFutureLightCone", "[", 
     StyleBox["v", "TI"], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2c3e5de-6d83-41c2-9218-46bbd5cb00ae"],
 ". A ray is a chain ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] ",
 StyleBox["e", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " whose diamond [",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["ek", "TI"],
 "] is the ray itself, and which cannot be continued: every event after ",
 StyleBox["ek", "TI"],
 " is reached from ",
 StyleBox["v", "TI"],
 " by a second route. The events of the rays are the light cone ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ")."
}], "Notes",ExpressionUUID->"6f2f6623-53cb-4266-b420-9d1de04193da"],

Cell[TextData[{
 "The default draw is uniform over the rays: each next event is chosen with \
probability proportional to the number of rays through it. Since the graph is \
a tree, a ray is determined by its last event, and the draw is the uniform \
choice of a leaf. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a92407e8-98b5-4cb4-9a13-771bf2c32164"],
 " to reproduce a draw."
}], "Notes",ExpressionUUID->"7d151687-d9ed-4169-8789-bd2300b165b9"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0871503b-8344-4232-993b-30f30d7f3014"],
 " sampler shares:"
}], "Notes",ExpressionUUID->"002667e6-7db4-46f3-8568-3374ab40f245"],

