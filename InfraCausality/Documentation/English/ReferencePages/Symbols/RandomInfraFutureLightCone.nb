                   RowBox[{"g", ",", " ", 
                    RowBox[{"Take", "[", 
                    RowBox[{"ray", ",", " ", "k"}], "]"}]}], "]"}]}]}], "]"}],
                " ", "&&", " ", 
               RowBox[{
                RowBox[{"VertexOutDegree", "[", 
