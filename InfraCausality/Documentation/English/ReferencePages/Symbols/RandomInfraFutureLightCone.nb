   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ec7133d-784e-4420-91a2-024558293b77"],
 ", and together they cover the light cone."
}], "ExampleText",ExpressionUUID->"93ba4b1c-54a1-43fa-917e-1ed388416a1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rays", " ", "=", " ", 
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "rays", "]"}], " ", "==", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
               " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", 
            "          ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"rays", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "v"}], " ",
                "&"}]}], "]"}], " ", "&&", " ", 
            RowBox[{"InfraLightRayQ", "[", 
             RowBox[{"g", ",", " ", "rays"}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"rays", ",", " ", 
              RowBox[{
               RowBox[{"InfraMemberQ", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", " ", 
                 "#"}], "]"}], " ", "&"}]}], "]"}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"Union", " ", "@@", " ", "rays"}], " ", "===", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}]}], "]"}]}]}], 
       "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7735fabb-41d2-474a-8a62-6079106cbaef"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"16cb3aa4-0a69-4c34-95b1-f7d697b12ca3"]
}, Open  ]],

Cell[TextData[{
 "A ray cannot be continued along the light cone: every out-neighbour of its \
last event lies off the light cone of ",
 StyleBox["v", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"e28bfd08-c4e5-425d-a6ce-e91e7fd3fdb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cone", " ", "=", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"InfraMeasurement", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
                " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"ray", " ", "|->", " ", 
              RowBox[{"!", " ", 
               RowBox[{"IntersectingQ", "[", 
                RowBox[{
                 RowBox[{"VertexOutComponent", "[", 
                  RowBox[{"g", ",", " ", 
                   RowBox[{"Last", " ", "@", " ", "ray"}], ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", "cone"}], 
                "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
