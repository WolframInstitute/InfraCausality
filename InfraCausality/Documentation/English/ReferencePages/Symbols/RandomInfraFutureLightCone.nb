Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14995c5e-d9ca-411c-80b3-588298038850"],
 " replaces the uniform descent as it does for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraTimelikeGeodesic"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraTimelikeGeodesic", 
