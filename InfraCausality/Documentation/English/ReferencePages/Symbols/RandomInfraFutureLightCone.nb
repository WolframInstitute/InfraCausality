Cell["\<\
Every initial segment of a ray is a light ray, and the last event of every \
ray is a leaf of the tree.\
\>", "ExampleText",ExpressionUUID->"ce1a6da8-0b9b-4496-aad2-5af08e3016f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"v", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tree", " ", "=", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraFutureLightCone", "[", "v", "]"}], ",", 
               " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "        ", 
           
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"RandomInfraFutureLightCone", "[", 
              RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}], ",", " ", 
             
             RowBox[{"ray", " ", "|->", "\n", "          ", 
              RowBox[{
               RowBox[{"AllTrue", "[", 
                RowBox[{
                 RowBox[{"Range", " ", "@", " ", 
                  RowBox[{"Length", " ", "@", " ", "ray"}]}], ",", " ", 
                 RowBox[{"k", " ", "|->", " ", 
