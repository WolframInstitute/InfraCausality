Cell["\<\
Every outgoing light ray of the first event of the sprinkling. Most of them \
are single links.\
\>", "ExampleText",ExpressionUUID->"d1b755c9-1d43-4940-aabf-2a9b92991353"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "0", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"RandomInfraFutureLightCone", "[", 
    RowBox[{"g", ",", " ", "v", ",", " ", "All"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0beeb171-2b1d-4a5a-b827-307d8eb0a86f"],

