 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afb7acab-819c-4658-bade-83099017dc0c"],
 " enumerates the rays in sorted order, ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9490d7b-578d-40e1-8651-e722bca0316f"],
 " in shuffled order, ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40070b43-b3e0-4d1d-8009-84b9a6314806"],
 " draws random walks (not combined with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073f4fa3-a0af-42b1-94f8-d54b6b5837e7"],
 "), and a function ",
 StyleBox["f", "TI"],
 " of the sorted next events sets or prunes the search."
}], "Notes",ExpressionUUID->"43e18619-86d7-4082-9ed1-a2b1c6fc6b6e"],

