lightAngle], 
          Cos[
          WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle]}], 
       TagSet[WolframInstitute`InfraCausality`LightDirection, 
        MessageName[WolframInstitute`InfraCausality`LightDirection, "usage"], 
        "LightDirection[phi, right] gives the unit direction of a light ray \
at angle phi to the time axis, pointing to positive x when right is True."]}; 
     Typeset`initDone$$ = True),
