event, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`event[
                "Side"] === "observer"]], "Point"]], 
           If[
           WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
velocity != 0, 
            WolframInstitute`InfraCausality`PackageScope`drawLabel[
             Row[{"\[Beta] = ", 
               NumberForm[
                N[
                WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
velocity], {3, 2}]}], 
             WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
maxArc WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`dir + 
             0.05 WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
maxArc WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`normal, 9],
             Nothing]}, 
          OptionValue[ImageSize], 0.06]], 
       Options[WolframInstitute`InfraCausality`LightClockConstruction] = {
        "LightAngle" -> Pi/4, "ClockLength" -> 0.12, "StartArcLength" -> 0.1, 
         ImageSize -> 550}, 
       TagSet[WolframInstitute`InfraCausality`LightClockConstruction, 
        MessageName[
        WolframInstitute`InfraCausality`LightClockConstruction, "usage"], 
        "LightClockConstruction[v, n] draws a transverse light clock carried \
by the observer of velocity v, with n bounces between observer and mirror."], 
       WolframInstitute`InfraCausality`LightDirection[
         Pattern[
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle, 
          Blank[]], 
         Optional[
          Pattern[
          WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
rightgoing, 
           Blank[]], True]] := 
       If[WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
rightgoing, {
          Sin[
          WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle], 
