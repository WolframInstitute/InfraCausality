Cell[BoxData[
 RowBox[{"BondiViewer", "[", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89912365-c729-48f0-ade3-080dab104f53"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{
    WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$ = 8,
     WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`construction$\
$ = "Clock", 
    WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`lightAngle$$ =
     Rational[1, 4] Pi, 
    WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`v2$$ = 0.3, 
    WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$ = 
    0.4, Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
       Hold[
       WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
construction$$], "Clock", "Construction"}, {
      "Clock", "Doppler", "Time Dilation", "Simultaneity", 
       "Length Contraction", "Velocity Addition", "Light Clock"}, ControlType -> 
      SetterBar}, {{
       Hold[
       WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$]\
, 0.4, "\[Beta]"}, 0.05, 0.9, ControlType -> Manipulator}, {{
       Hold[
       WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`lightAngle$\
$], Rational[1, 4] Pi, "\[Phi] (light angle)"}, 0.15, 1.5207963267948965`, 
      ControlType -> Manipulator}, {{
       Hold[
       WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$],
        8, "Bounces / Pulses"}, 3, 15, 1, ControlType -> Manipulator}, {{
       Hold[WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`v2$$],
        0.3, 
       Subscript["\[Beta]", "2"]}, 0.05, 0.85, ControlType -> Manipulator}}, 
    Typeset`size$$ = Automatic, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = False, Typeset`keyframeActionsQ$$ = False, 
    Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {
       WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$ = 
        8, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
construction$$ = "Clock", 
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$ = Rational[1, 4] Pi, 
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`v2$$ = 
        0.3, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
velocity$$ = 0.4}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Switch[WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
construction$$, "Clock", 
        WolframInstitute`InfraCausality`BondiClock[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$, 
         "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Doppler", 
        WolframInstitute`InfraCausality`DopplerConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$, 
         "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Time Dilation", 
        WolframInstitute`InfraCausality`TimeDilationConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Simultaneity", 
        WolframInstitute`InfraCausality`SimultaneityConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Length Contraction", 
        WolframInstitute`InfraCausality`LengthContractionConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Velocity Addition", 
        WolframInstitute`InfraCausality`VelocityAdditionConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`v2$$, 
         "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480], "Light Clock", 
        WolframInstitute`InfraCausality`LightClockConstruction[
        WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`velocity$$\
, WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`bounces$$, 
         "LightAngle" -> 
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
lightAngle$$, ImageSize -> 480]], 
      "Specifications" :> {{{
         WolframInstitute`InfraCausality`BondiFigures`PackagePrivate`\
construction$$, "Clock", "Construction"}, {
         "Clock", "Doppler", "Time Dilation", "Simultaneity", 
          "Length Contraction", "Velocity Addition", "Light Clock"}, 
         ControlType -> SetterBar}, 
