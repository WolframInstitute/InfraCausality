Cell[TextData[{
 "The sliders are the velocity ",
 StyleBox["\[Beta]", "TI"],
 " \[Element] [0.05, 0.9] (initially 0.4), the light angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " \[Element] [0.15, \[Pi]/2 \[Minus] 0.05] (initially \[Pi]/4), the bounces \
or pulses ",
 StyleBox["n", "TI"],
 " \[Element] {3, \[Ellipsis], 15} (initially 8) and the second velocity ",
 StyleBox["\[Beta]", "TI"],
 "2 \[Element] [0.05, 0.85] (initially 0.3), used by the velocity addition \
only. The result has ",
 Cell[BoxData[
  RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e53b501-e8c8-48bf-b11e-424c641163bb"],
 ", so it keeps working in a fresh session."
}], "Notes",ExpressionUUID->"a9893260-7026-4e7c-9006-8128690fbda9"]
}, Open  ]],

