}], "ExampleText",ExpressionUUID->"5c8228c6-a5c1-42c2-a5ad-587be0f90ded"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.05", ",", " ", "0.4", ",", " ", "0.9"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.15", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], " ", "-", " ", "0.05"}]}], "}"}]}], "}"}], 
    "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bob", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"BondiClock", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Disk", "[", 
               RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
              " ", "Infinity"}], "]"}], ",", " ", 
           RowBox[{"c", " ", "|->", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Ratios", "[", 
            RowBox[{"Map", "[", 
             RowBox[{"Norm", ",", " ", "bob"}], "]"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], "]"}], 
        " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a0930b5f-80f5-4e3e-9533-a865721d2f6f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b1516ab5-f478-496f-b243-e0a3a4c40aaa"]
}, Open  ]],

Cell[TextData[{
 "Over the slider ranges the velocity addition frame composes the velocities: \
Carol's reception is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae9c7e0b-b8bc-4586-895d-5516c60f3be5"],
 " times Alice's emission in proper time."
}], "ExampleText",ExpressionUUID->"e8595f4b-000d-4e4e-a298-fb681cafdb48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.05", ",", " ", "0.4", ",", " ", "0.9"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.05", ",", " ", "0.3", ",", " ", "0.85"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.15", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], " ", "-", " ", "0.05"}]}], "}"}]}], "}"}], 
    "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", " ", "v2", ",", " ", "phi"}], "}"}], " ", "|->", 
     "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"VelocityAdditionConstruction", "[", 
            RowBox[{"v1", ",", " ", "v2", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
            " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", " ", "+", " ", 
                RowBox[{"v1", " ", "v2"}]}], ")"}]}], ",", " ", "phi"}], 
            "]"}], " ", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"d", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], "/", 
            RowBox[{"d", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"KFactor", "[", "v1", "]"}], " ", 
           RowBox[{"KFactor", "[", "v2", "]"}]}]}], "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1d5a701a-b9f5-4ac2-8b8c-3a41aa96c77a"],

