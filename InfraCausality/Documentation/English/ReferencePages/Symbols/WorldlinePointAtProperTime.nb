\>", "Notes",ExpressionUUID->"5fd7f9bf-99a5-4c36-a3f4-698264d07c45"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlinePoint"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlinePoint", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{
     StyleBox["\[Tau]", "TR"], " ", "/", " ", 
     RowBox[{"ProperTimeScale", "[", 
      RowBox[{
       StyleBox["v", "TI"], ",", " ", 
       StyleBox["\[CurlyPhi]", "TR"]}], "]"}]}], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a728345b-b069-45b6-afc1-5da058b69fbf"],
 ", the point whose radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ddfccc-56f6-430d-a31b-9bf691982e76"],
 " for the rest observer is ",
 StyleBox["\[Tau]", "TI"],
 ". Points at equal proper-time steps are equally spaced along the \
worldline."
}], "Notes",ExpressionUUID->"d1f93a0a-959b-4000-9c5b-b5897dc11150"]
