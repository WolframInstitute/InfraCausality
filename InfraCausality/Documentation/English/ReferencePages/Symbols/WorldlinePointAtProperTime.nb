Cell["\<\
The radar interval of the point is its proper time, at every velocity and \
light angle.\
\>", "ExampleText",ExpressionUUID->"26b30439-8539-493f-816d-8ffcf59679ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"WorldlinePointAtProperTime", "[", 
           RowBox[{"v", ",", " ", "tau", ",", " ", "phi"}], "]"}], ",", " ", 
          "phi"}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{"tau", "^", "2"}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"tau", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"899c645e-874d-4a34-8d07-3ceb0fb100b4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"845c4fdd-d167-4921-bc2b-da3c95d94b48"]
}, Open  ]],

Cell[TextData[{
 "The radar time of the point is \[Gamma] ",
 StyleBox["\[Tau]", "TI"],
 ": time dilation."
}], "ExampleText",ExpressionUUID->"31faf4bd-5bca-40a8-b072-85da31db6648"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"BondiRadarCoordinates", "[", 
      RowBox[{
       RowBox[{"WorldlinePointAtProperTime", "[", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", " ", "tau", ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
    " ", "==", " ", 
    RowBox[{
     RowBox[{"LorentzGamma", "[", 
      RowBox[{"3", "/", "5"}], "]"}], " ", "tau"}]}], ",", " ", 
   RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"921a15db-b7ff-47ed-b4c8-625d22d98404"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d777a1f0-de1d-41d1-8d81-2b95dc90f856"]
}, Open  ]]
}, Open  ]],

