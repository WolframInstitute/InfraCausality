c579bfbc9dee"],

Cell[TextData[{
 "The scalars satisfy the relations of special-relativistic kinematics in \
light-cone coordinates: ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 ". A pair with a zero projection is massless and has velocity \
\[PlusMinus]1."
}], "Notes",ExpressionUUID->"369a0baa-3564-43a4-8435-d7a96e4b4839"],

