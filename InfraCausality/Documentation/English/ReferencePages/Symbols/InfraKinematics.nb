Cell["\<\
A longest chain of the diamond lattice, three timelike geodesics from the \
bottom that end at {3, 3}, {1, 5} and {5, 1}, and the kinematics of the three \
pairs of targets.\
\>", "ExampleText",ExpressionUUID->"40115b2a-3aeb-4b18-8558-25c346507d87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"targets", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", 
            RowBox[{
             RowBox[{"RandomInfraPoint", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}], ",", " ", 
             "end"}], "]"}]}], "]"}]}], ")"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"end", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"5", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraKinematics", "[", 
    RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"af90327e-c20c-4057-9a52-6fe4e8a2281d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Projections\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["5", "13"], ",", 
      FractionBox["6", "13"], ",", 
      FractionBox["3", "13"]}], "}"}]}], ",", 
   RowBox[{"\<\"Energy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["11", "26"], ",", 
      FractionBox["4", "13"], ",", 
      FractionBox["9", "26"]}], "}"}]}], ",", 
   RowBox[{"\<\"Momentum\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "26"]}], ",", 
      FractionBox["1", "13"], ",", 
      FractionBox["3", "26"]}], "}"}]}], ",", 
   RowBox[{"\<\"Mass\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       SqrtBox["30"], "13"], ",", 
      FractionBox[
       SqrtBox["15"], "13"], ",", 
      FractionBox[
       RowBox[{"3", " ", 
        SqrtBox["2"]}], "13"]}], "}"}]}], ",", 
   RowBox[{"\<\"Interval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["30", "169"], ",", 
      FractionBox["15", "169"], ",", 
      FractionBox["18", "169"]}], "}"}]}], ",", 
   RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "11"]}], ",", 
      FractionBox["1", "4"], ",", 
      FractionBox["1", "3"]}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d61a9ef7-a85d-4d72-b2bd-e7d6a73c950d"]
}, Open  ]],

Cell["The same reference chain and targets drawn on the lattice.", \
"ExampleText",ExpressionUUID->"cac54c21-45e1-4948-998f-3a41c31679aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"targets", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
