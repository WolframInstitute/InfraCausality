Cell["\<\
The projections of a longest chain onto two observers of the sprinkling and \
onto two of the cylinder lattice, with their mass and velocity.\
\>", "ExampleText",ExpressionUUID->"f018f066-8119-498a-9e0f-44cc011893eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ref", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"targets", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", "]"}], ",", " ", "2"}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"InfraKinematics", "[", 
        RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<Projections\>\"", ",", " ", "\"\<Mass\>\"", ",", 
         " ", "\"\<Velocity\>\""}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"cfdd4b1b-86b9-4062-bda0-cd1e463399e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["3", "4"], ",", 
        FractionBox["3", "4"]}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       FractionBox["3", "4"], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", "0", "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["2", "7"], ",", "1"}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       SqrtBox[
        FractionBox["2", "7"]], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"-", 
        FractionBox["5", "9"]}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"8a5eaa77-d5b9-4e92-a737-bf99e4cf913c"]
}, Open  ]]
}, Open  ]],

