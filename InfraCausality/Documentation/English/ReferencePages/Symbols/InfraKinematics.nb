c68c7e3cc8a2"],

Cell[TextData[{
 "The scalars satisfy the relations of special-relativistic kinematics in \
light-cone coordinates: ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 ". A pair with a zero projection is massless and has velocity \
\[PlusMinus]1."
}], "Notes",ExpressionUUID->"66589899-5410-4d01-940e-e621b72bb357"],

