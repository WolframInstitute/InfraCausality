Cell["\<\
A longest chain of the diamond lattice, three worldlines from the bottom that \
end at {3, 3}, {1, 5} and {5, 1}, and the kinematics of the three pairs of \
targets.\
\>", "ExampleText",ExpressionUUID->"6fd6eecb-1f5e-4b10-a16f-62d8b0f7ff01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"targets", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{
             RowBox[{"RandomChoice", " ", "@", " ", 
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ",", " ", 
             "end"}], "]"}]}], "]"}]}], ")"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"end", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"5", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraKinematics", "[", 
    RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3cd2f92b-8e9e-48d8-8fec-0c2fd3c2fc1c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Projections\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["5", "13"], ",", 
      FractionBox["6", "13"], ",", 
      FractionBox["3", "13"]}], "}"}]}], ",", 
   RowBox[{"\<\"Energy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["11", "26"], ",", 
      FractionBox["4", "13"], ",", 
      FractionBox["9", "26"]}], "}"}]}], ",", 
   RowBox[{"\<\"Momentum\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "26"]}], ",", 
      FractionBox["1", "13"], ",", 
      FractionBox["3", "26"]}], "}"}]}], ",", 
   RowBox[{"\<\"Mass\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       SqrtBox["30"], "13"], ",", 
      FractionBox[
       SqrtBox["15"], "13"], ",", 
      FractionBox[
       RowBox[{"3", " ", 
        SqrtBox["2"]}], "13"]}], "}"}]}], ",", 
   RowBox[{"\<\"Interval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["30", "169"], ",", 
      FractionBox["15", "169"], ",", 
      FractionBox["18", "169"]}], "}"}]}], ",", 
   RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "11"]}], ",", 
      FractionBox["1", "4"], ",", 
      FractionBox["1", "3"]}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5ea027ff-6550-4fdd-8a21-3ba64a5f26f1"]
}, Open  ]],

Cell["The same reference chain and targets drawn on the lattice.", \
"ExampleText",ExpressionUUID->"82e04005-d81b-4084-acd1-d398b0fac4cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"targets", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
