Cell[TextData[{
 "The projections are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChainProjection"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96ef1eb8-0bbb-4db0-acaa-c20509211674"],
 ", and the scalars satisfy ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 " wherever ",
 StyleBox["E", "TI"],
 " \[NotEqual] 0, under either method."
}], "ExampleText",ExpressionUUID->"7c9f5a7e-d3f1-4991-a059-88c6bc5ba7f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraTimelikeGeodesic", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
        ",", " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Cone\>\"", ",", " ", "\"\<LightRays\>\""}], "}"}], ",", 
        " ", 
        RowBox[{"method", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", " ", "=", " ", 
             RowBox[{"InfraKinematics", "[", 
              RowBox[{"g", ",", " ", "ref", ",", " ", "targets", ",", " ", 
               RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}]}], "}"}],
            ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], " ", "==", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ChainProjection", "[", 
                 RowBox[{"g", ",", " ", "ref", ",", " ", "#", ",", " ", 
                  RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], " ", 
                "&"}], " ", "/@", " ", "targets"}], ")"}]}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], "^", "2"}]}], " ",
              "==", " ", 
             RowBox[{"k", "[", "\"\<Interval\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", "\"\<Mass\>\"", "]"}], "^", "2"}], " ", "==", 
             " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"k", "[", "\"\<Interval\>\"", "]"}], "]"}]}], " ", "&&",
             "\n", "          ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", "p", ",", " ", "b"}], "}"}], " ", "|->",
                 " ", 
                RowBox[{
                 RowBox[{"e", " ", "==", " ", "0"}], " ", "||", " ", 
                 RowBox[{"b", " ", "==", " ", 
                  RowBox[{"p", "/", "e"}]}]}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}]}], "}"}]}], 
              "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7b8e884-a4fd-474e-9591-ef2e0e5fcdb2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3a638457-a4e1-4855-b4dd-107a9bb06658"]
}, Open  ]],

Cell["\<\
The energy of a pair is the mean of its projections, and every projection \
lies in [0, 1], so energies lie in [0, 1] and velocities in [\[Minus]1, 1].\
\>", "ExampleText",ExpressionUUID->"7cd9476e-96a9-4f44-85a2-b87ecf1493b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraTimelikeGeodesic", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
        ",", " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"InfraKinematics", "[", 
         RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mean", " ", "/@", " ", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
          "&"}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}], ",", " ", 
           "Indeterminate"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], " ", "<=", " ", "#", " ", "<=", " ", "1"}], 
          " ", "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4d943db5-2d0f-4ad6-be45-a34ffcb3aefd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3c36284b-143b-44ed-afb8-35b80e6a56f9"]
