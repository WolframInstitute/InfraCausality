Notebook[{

Cell[CellGroupData[{
Cell["InfraKinematics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"67f76242-4750-49e3-b1ae-17c409e33c4f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraKinematics"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraKinematics", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", 
      StyleBox["b2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d313f23-320b-4635-b612-c69753781780"],
 "\[LineSeparator]",
 "gives the projections of the chain ",
 StyleBox["ref", "TI"],
 " onto the target chains ",
 StyleBox["bi", "TI"],
 " and, for every pair of them, the Knuth energy, momentum, mass, interval \
and velocity, as an association.",
 "\n"
}], "Usage",ExpressionUUID->"c9d5bf29-b9d5-4bdd-a4b8-36d14bd9e2f3"],

Cell[TextData[{
 "Experimental: Knuth kinematics. The scalars follow Knuth and Bahreyni \
(arXiv:1005.4172), where two projections of one chain play the role of the \
light-cone coordinates ",
 StyleBox["u", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " \[Minus] ",
 StyleBox["x", "TI"],
 "; which pairs of target chains carry a physical meaning is not settled, so \
every pair is reported and the reading may change."
}], "Notes",ExpressionUUID->"8e623fb3-272b-437e-964a-94f061681f79"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["pi", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChainProjection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    StyleBox["bi", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1839948-c3cf-4762-8aa0-85c61e286219"],
 ". For each pair (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") of projections, in the order of ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "p2", ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b7489ea-0688-4280-98ff-0f6a45d7103e"],
 ", the association holds:"
}], "Notes",ExpressionUUID->"ce26c056-1332-4345-a366-2a5f408748f4"],

