Cell[CellGroupData[{
Cell["InfraKinematics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3c2cd66d-78a4-47f8-b3b9-7400b88f6da6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraKinematics"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraKinematics", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", 
      StyleBox["b2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e68ae96-58c4-4dc6-9f04-cb39ece38f5c"],
 "\[LineSeparator]",
 "gives the projections of the chain ",
 StyleBox["ref", "TI"],
 " onto the target chains ",
 StyleBox["bi", "TI"],
 " and, for every pair of them, the Knuth energy, momentum, mass, interval \
and velocity, as an association.",
 "\n"
}], "Usage",ExpressionUUID->"749b940a-5018-4338-b252-642552ff7ebd"],

Cell[TextData[{
 "Experimental: Knuth kinematics. The scalars follow Knuth and Bahreyni \
(arXiv:1005.4172), where two projections of one chain play the role of the \
light-cone coordinates ",
 StyleBox["u", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " \[Minus] ",
 StyleBox["x", "TI"],
 "; which pairs of target chains carry a physical meaning is not settled, so \
every pair is reported and the reading may change."
}], "Notes",ExpressionUUID->"209706a5-298c-4048-bfde-c8201ef56eb6"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["pi", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChainProjection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    StyleBox["bi", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb8bad68-2227-4e12-9174-c518461b007f"],
 ". For each pair (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") of projections, in the order of ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "p2", ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b4e7695-e19a-499d-b4a4-d4c94c6c205a"],
 ", the association holds:"
}], "Notes",ExpressionUUID->"b60088d5-5af5-4a59-8223-d8e217096649"],

