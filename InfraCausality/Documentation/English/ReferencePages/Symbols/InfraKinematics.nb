Cell[TextData[{
 "The projections are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChainProjection"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d565af24-7668-4820-9b70-6577cc42bcbd"],
 ", and the scalars satisfy ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 " wherever ",
 StyleBox["E", "TI"],
 " \[NotEqual] 0, under either method."
}], "ExampleText",ExpressionUUID->"95f1fada-8f42-4f0d-b7d5-5fa6f6c85633"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Cone\>\"", ",", " ", "\"\<LightRays\>\""}], "}"}], ",", 
        " ", 
        RowBox[{"method", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", " ", "=", " ", 
             RowBox[{"InfraKinematics", "[", 
              RowBox[{"g", ",", " ", "ref", ",", " ", "targets", ",", " ", 
               RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
              "]"}]}], "}"}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], " ", "==", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ChainProjection", "[", 
                 RowBox[{"g", ",", " ", "ref", ",", " ", "#", ",", " ", 
                  RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
                 "]"}], " ", "&"}], " ", "/@", " ", "targets"}], ")"}]}], " ",
             "&&", "\n", "          ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], "^", "2"}]}], " ",
              "==", " ", 
             RowBox[{"k", "[", "\"\<Interval\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", "\"\<Mass\>\"", "]"}], "^", "2"}], " ", "==", 
             " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"k", "[", "\"\<Interval\>\"", "]"}], "]"}]}], " ", "&&",
             "\n", "          ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", "p", ",", " ", "b"}], "}"}], " ", "|->",
                 " ", 
                RowBox[{
                 RowBox[{"e", " ", "==", " ", "0"}], " ", "||", " ", 
                 RowBox[{"b", " ", "==", " ", 
                  RowBox[{"p", "/", "e"}]}]}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}]}], "}"}]}], 
              "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"af3fbc64-194e-4c3f-8bfd-9b9a16e72f2d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"82d40ee3-d596-4bed-a028-05743bdc06fa"]
}, Open  ]],

Cell["\<\
The energy of a pair is the mean of its projections, and every projection \
lies in [0, 1], so energies lie in [0, 1] and velocities in [\[Minus]1, 1].\
\>", "ExampleText",ExpressionUUID->"7d490272-ff66-461c-bb1e-ff1784f0d382"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"InfraKinematics", "[", 
         RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mean", " ", "/@", " ", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
          "&"}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}], ",", " ", 
           "Indeterminate"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], " ", "<=", " ", "#", " ", "<=", " ", "1"}], 
          " ", "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0cef6c9d-f498-491b-bdef-76f4e7ff1ddd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"eb5fdac7-556a-47bb-9cfd-f736d0e5a66a"]
