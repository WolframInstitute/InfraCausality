Notebook[{

Cell[CellGroupData[{
Cell["InfraKinematics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e56ed9a9-1e7b-4262-8537-b3cfbfe21507"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraKinematics"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraKinematics", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", 
      StyleBox["b2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abbc4ea8-6c96-4b0e-99e4-3b5a70411407"],
 "\[LineSeparator]",
 "gives the projections of the chain ",
 StyleBox["ref", "TI"],
 " onto the target chains ",
 StyleBox["bi", "TI"],
 " and, for every pair of them, the Knuth energy, momentum, mass, interval \
and velocity, as an association.",
 "\n"
}], "Usage",ExpressionUUID->"af9201d7-1731-42e8-a278-d72ad59f20a7"],

Cell[TextData[{
 "Experimental: Knuth kinematics. The scalars follow Knuth and Bahreyni \
(arXiv:1005.4172), where two projections of one chain play the role of the \
light-cone coordinates ",
 StyleBox["u", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " \[Minus] ",
 StyleBox["x", "TI"],
 "; which pairs of target chains carry a physical meaning is not settled, so \
every pair is reported and the reading may change."
}], "Notes",ExpressionUUID->"0941cf65-eeb0-40b8-9520-70b2c0b03ccb"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["pi", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChainProjection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    StyleBox["bi", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ed871d-8ffd-441b-a29b-c0925ef581c5"],
 ". For each pair (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") of projections, in the order of ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "p2", ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "254ca17d-41f1-4f87-979e-d02bd0139a22"],
 ", the association holds:"
}], "Notes",ExpressionUUID->"75f54d2e-2ca2-4eb3-a652-141090234d3f"],

