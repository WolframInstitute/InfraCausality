bccfc6989014"],

Cell[TextData[{
 "The scalars satisfy the relations of special-relativistic kinematics in \
light-cone coordinates: ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 ". A pair with a zero projection is massless and has velocity \
\[PlusMinus]1."
}], "Notes",ExpressionUUID->"9709e9d8-b78a-4860-ae1c-bfe43f469f07"],

