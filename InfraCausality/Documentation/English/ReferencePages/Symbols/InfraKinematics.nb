Cell[TextData[{
 "The projections are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChainProjection"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90284246-0217-433f-904b-e47f1a5604e3"],
 ", and the scalars satisfy ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 " wherever ",
 StyleBox["E", "TI"],
 " \[NotEqual] 0, under either method."
}], "ExampleText",ExpressionUUID->"9823a892-3ce6-43af-95a6-bdc6fc75950b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Cone\>\"", ",", " ", "\"\<LightRays\>\""}], "}"}], ",", 
        " ", 
        RowBox[{"method", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", " ", "=", " ", 
             RowBox[{"InfraKinematics", "[", 
              RowBox[{"g", ",", " ", "ref", ",", " ", "targets", ",", " ", 
               RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
              "]"}]}], "}"}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], " ", "==", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ChainProjection", "[", 
                 RowBox[{"g", ",", " ", "ref", ",", " ", "#", ",", " ", 
                  RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
                 "]"}], " ", "&"}], " ", "/@", " ", "targets"}], ")"}]}], " ",
             "&&", "\n", "          ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], "^", "2"}]}], " ",
              "==", " ", 
             RowBox[{"k", "[", "\"\<Interval\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", "\"\<Mass\>\"", "]"}], "^", "2"}], " ", "==", 
             " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"k", "[", "\"\<Interval\>\"", "]"}], "]"}]}], " ", "&&",
             "\n", "          ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", "p", ",", " ", "b"}], "}"}], " ", "|->",
                 " ", 
                RowBox[{
                 RowBox[{"e", " ", "==", " ", "0"}], " ", "||", " ", 
                 RowBox[{"b", " ", "==", " ", 
                  RowBox[{"p", "/", "e"}]}]}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}]}], "}"}]}], 
              "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f6df18a-a66e-482f-a731-7fb61ca29f23"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2ce8ea38-ca76-42dc-bec4-5c58fee545ea"]
}, Open  ]],

Cell["\<\
The energy of a pair is the mean of its projections, and every projection \
lies in [0, 1], so energies lie in [0, 1] and velocities in [\[Minus]1, 1].\
\>", "ExampleText",ExpressionUUID->"20337b19-96ef-4cae-bdb6-db423e67d632"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"InfraKinematics", "[", 
         RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mean", " ", "/@", " ", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
          "&"}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}], ",", " ", 
           "Indeterminate"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], " ", "<=", " ", "#", " ", "<=", " ", "1"}], 
          " ", "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"27e707fc-f7cf-476f-b5ae-9d1a70f65e34"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"83677ef8-89fa-4032-8c73-2ba076578f08"]
