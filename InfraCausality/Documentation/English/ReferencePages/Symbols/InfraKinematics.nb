d566da57df6e"],

Cell[TextData[{
 "The scalars satisfy the relations of special-relativistic kinematics in \
light-cone coordinates: ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 ". A pair with a zero projection is massless and has velocity \
\[PlusMinus]1."
}], "Notes",ExpressionUUID->"e64be4bc-a9f4-47a6-9a87-39be31a29922"],

