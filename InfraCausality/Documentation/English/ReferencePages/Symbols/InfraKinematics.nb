Cell[TextData[{
 "The projections are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChainProjection"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ee04248-28d8-43d9-87e1-6a14d14a9344"],
 ", and the scalars satisfy ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 " wherever ",
 StyleBox["E", "TI"],
 " \[NotEqual] 0, under either method."
}], "ExampleText",ExpressionUUID->"fe7704ba-bbce-4c9e-955a-9d686273c480"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraTimelikeGeodesic", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
        ",", " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Cone\>\"", ",", " ", "\"\<LightRays\>\""}], "}"}], ",", 
        " ", 
        RowBox[{"method", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", " ", "=", " ", 
             RowBox[{"InfraKinematics", "[", 
              RowBox[{"g", ",", " ", "ref", ",", " ", "targets", ",", " ", 
               RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}]}], "}"}],
            ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], " ", "==", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ChainProjection", "[", 
                 RowBox[{"g", ",", " ", "ref", ",", " ", "#", ",", " ", 
                  RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], " ", 
                "&"}], " ", "/@", " ", "targets"}], ")"}]}], " ", "&&", "\n", 
            "          ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], "^", "2"}]}], " ",
              "==", " ", 
             RowBox[{"k", "[", "\"\<Interval\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", "\"\<Mass\>\"", "]"}], "^", "2"}], " ", "==", 
             " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"k", "[", "\"\<Interval\>\"", "]"}], "]"}]}], " ", "&&",
             "\n", "          ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", "p", ",", " ", "b"}], "}"}], " ", "|->",
                 " ", 
                RowBox[{
                 RowBox[{"e", " ", "==", " ", "0"}], " ", "||", " ", 
                 RowBox[{"b", " ", "==", " ", 
                  RowBox[{"p", "/", "e"}]}]}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}]}], "}"}]}], 
              "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c2394d9-503a-42c2-b0d2-f3dc4c68d77d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d3369c4c-91c6-4a9d-bfde-6c68252559ff"]
}, Open  ]],

Cell["\<\
The energy of a pair is the mean of its projections, and every projection \
lies in [0, 1], so energies lie in [0, 1] and velocities in [\[Minus]1, 1].\
\>", "ExampleText",ExpressionUUID->"66e71d35-3728-4470-a387-14a014b33d8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraTimelikeGeodesic", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", "]"}]}], "]"}]}], ")"}]}], 
        ",", " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"InfraKinematics", "[", 
         RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mean", " ", "/@", " ", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
          "&"}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}], ",", " ", 
           "Indeterminate"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], " ", "<=", " ", "#", " ", "<=", " ", "1"}], 
          " ", "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a0897d04-e4ad-458f-8179-befc4137cad9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0d16c3f0-3abc-4ba6-bdff-0a1171342329"]
