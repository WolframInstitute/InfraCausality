Cell[TextData[{
 "The projections are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChainProjection"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b42f05c-2ec1-4f46-8d05-a4427d53ee2e"],
 ", and the scalars satisfy ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 " wherever ",
 StyleBox["E", "TI"],
 " \[NotEqual] 0, under either method."
}], "ExampleText",ExpressionUUID->"4db0d61a-b19b-4f91-927f-1f9fb3f756ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Cone\>\"", ",", " ", "\"\<LightRays\>\""}], "}"}], ",", 
        " ", 
        RowBox[{"method", " ", "|->", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", " ", "=", " ", 
             RowBox[{"InfraKinematics", "[", 
              RowBox[{"g", ",", " ", "ref", ",", " ", "targets", ",", " ", 
               RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
              "]"}]}], "}"}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], " ", "==", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ChainProjection", "[", 
                 RowBox[{"g", ",", " ", "ref", ",", " ", "#", ",", " ", 
                  RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}]}], 
                 "]"}], " ", "&"}], " ", "/@", " ", "targets"}], ")"}]}], " ",
             "&&", "\n", "          ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{
               RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], "^", "2"}]}], " ",
              "==", " ", 
             RowBox[{"k", "[", "\"\<Interval\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"k", "[", "\"\<Mass\>\"", "]"}], "^", "2"}], " ", "==", 
             " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"k", "[", "\"\<Interval\>\"", "]"}], "]"}]}], " ", "&&",
             "\n", "          ", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", "p", ",", " ", "b"}], "}"}], " ", "|->",
                 " ", 
                RowBox[{
                 RowBox[{"e", " ", "==", " ", "0"}], " ", "||", " ", 
                 RowBox[{"b", " ", "==", " ", 
                  RowBox[{"p", "/", "e"}]}]}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Momentum\>\"", "]"}], ",", " ", 
                 RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}]}], "}"}]}], 
              "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0e27ad54-7280-4277-9f3d-1310c983fb83"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"54c65346-ff14-4cea-b963-007754b3ca46"]
}, Open  ]],

Cell["\<\
The energy of a pair is the mean of its projections, and every projection \
lies in [0, 1], so energies lie in [0, 1] and velocities in [\[Minus]1, 1].\
\>", "ExampleText",ExpressionUUID->"8179d973-9e01-40ff-b1f2-179c8ab7e86d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ref", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWorldline", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"targets", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"RandomInfraObserver", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"InfraKinematics", "[", 
         RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mean", " ", "/@", " ", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Projections\>\"", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"k", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
          "&"}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"k", "[", "\"\<Velocity\>\"", "]"}], ",", " ", 
           "Indeterminate"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], " ", "<=", " ", "#", " ", "<=", " ", "1"}], 
          " ", "&"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bb4792ff-cf47-41f1-ab6b-6c35cb7f199e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f4b61338-bec6-47e8-8f31-71f2d88d51f5"]
}, Open  ]]
