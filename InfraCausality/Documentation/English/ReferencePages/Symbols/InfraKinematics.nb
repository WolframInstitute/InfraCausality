b331be0301c0"],

Cell[TextData[{
 "The scalars satisfy the relations of special-relativistic kinematics in \
light-cone coordinates: ",
 StyleBox["E", "TI"],
 "\.b2 \[Minus] ",
 StyleBox["P", "TI"],
 "\.b2 = ",
 StyleBox["I", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "\.b2 = ",
 "|",
 StyleBox["I", "TI"],
 "|",
 " and \[Beta] = ",
 StyleBox["P", "TI"],
 "/",
 StyleBox["E", "TI"],
 ". A pair with a zero projection is massless and has velocity \
\[PlusMinus]1."
}], "Notes",ExpressionUUID->"047f77fd-ea85-4f3f-9169-757d33f21997"],

