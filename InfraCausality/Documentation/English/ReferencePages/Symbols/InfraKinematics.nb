Cell["\<\
The projections of a longest chain onto two observers of the sprinkling and \
onto two of the cylinder lattice, with their mass and velocity.\
\>", "ExampleText",ExpressionUUID->"f1449ee1-d09e-4cf1-b00f-eabd62bf15a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ref", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"targets", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", "]"}], ",", " ", "2"}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"InfraKinematics", "[", 
        RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<Projections\>\"", ",", " ", "\"\<Mass\>\"", ",", 
         " ", "\"\<Velocity\>\""}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c9792f66-6729-43b3-91d7-89820654837a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["3", "4"], ",", 
        FractionBox["3", "4"]}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       FractionBox["3", "4"], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", "0", "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["2", "7"], ",", "1"}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       SqrtBox[
        FractionBox["2", "7"]], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"-", 
        FractionBox["5", "9"]}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a36ff7bc-f097-4256-98cf-75a6a16edc66"]
}, Open  ]]
}, Open  ]],

