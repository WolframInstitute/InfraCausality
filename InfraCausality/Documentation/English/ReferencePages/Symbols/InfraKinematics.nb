Notebook[{

Cell[CellGroupData[{
Cell["InfraKinematics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f4ba8fe-a31c-4618-ba48-7380096875c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraKinematics"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraKinematics", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", 
      StyleBox["b2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa464a02-d161-44dc-b7f8-c0600145a4e6"],
 "\[LineSeparator]",
 "gives the projections of the chain ",
 StyleBox["ref", "TI"],
 " onto the target chains ",
 StyleBox["bi", "TI"],
 " and, for every pair of them, the Knuth energy, momentum, mass, interval \
and velocity, as an association.",
 "\n"
}], "Usage",ExpressionUUID->"962615d8-501c-4312-8d55-4359ff93890d"],

Cell[TextData[{
 "Experimental: Knuth kinematics. The scalars follow Knuth and Bahreyni \
(arXiv:1005.4172), where two projections of one chain play the role of the \
light-cone coordinates ",
 StyleBox["u", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " \[Minus] ",
 StyleBox["x", "TI"],
 "; which pairs of target chains carry a physical meaning is not settled, so \
every pair is reported and the reading may change."
}], "Notes",ExpressionUUID->"ddbc532b-e308-4e1b-bb6c-3dd0d0837ab8"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["pi", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChainProjection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    StyleBox["bi", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef2bdc5f-f249-4c77-9760-c08143a5a7e4"],
 ". For each pair (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") of projections, in the order of ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "p2", ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83507dac-559b-4fec-b71a-dfb15101003b"],
 ", the association holds:"
}], "Notes",ExpressionUUID->"6580f9d5-2b8d-42f6-ae8d-03c7ae2f102e"],

