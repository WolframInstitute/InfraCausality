Cell["\<\
The projections of a longest chain onto two observers of the sprinkling and \
onto two of the cylinder lattice, with their mass and velocity.\
\>", "ExampleText",ExpressionUUID->"1cc4ce52-83d9-4e98-b72f-0d2192784e7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ref", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"targets", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", "]"}], ",", " ", "2"}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"InfraKinematics", "[", 
        RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<Projections\>\"", ",", " ", "\"\<Mass\>\"", ",", 
         " ", "\"\<Velocity\>\""}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e8f9fa72-6031-4ba1-9ca1-027e8f6ac395"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["3", "4"], ",", 
        FractionBox["3", "4"]}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       FractionBox["3", "4"], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", "0", "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["2", "7"], ",", "1"}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       SqrtBox[
        FractionBox["2", "7"]], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"-", 
        FractionBox["5", "9"]}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"d5c94a56-bf53-4908-850c-bba0a02b2b09"]
}, Open  ]]
}, Open  ]],

