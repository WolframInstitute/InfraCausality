Cell["\<\
The projections of a longest chain onto two observers of the sprinkling and \
onto two of the cylinder lattice, with their mass and velocity.\
\>", "ExampleText",ExpressionUUID->"3e20be4d-672a-4e54-9a61-409e2d6bf179"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"ref", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"targets", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
         RowBox[{"RandomInfraObserver", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraObserver", "[", "]"}], ",", " ", "2"}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"InfraKinematics", "[", 
        RowBox[{"g", ",", " ", "ref", ",", " ", "targets"}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<Projections\>\"", ",", " ", "\"\<Mass\>\"", ",", 
         " ", "\"\<Velocity\>\""}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f3c27d48-b7bf-49d4-b260-70f800de0932"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["3", "4"], ",", 
        FractionBox["3", "4"]}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       FractionBox["3", "4"], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", "0", "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Projections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["2", "7"], ",", "1"}], "}"}]}], ",", 
     RowBox[{"\<\"Mass\"\>", "\[Rule]", 
      RowBox[{"{", 
       SqrtBox[
        FractionBox["2", "7"]], "}"}]}], ",", 
     RowBox[{"\<\"Velocity\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"-", 
        FractionBox["5", "9"]}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"d41ea5f1-8add-41fc-bd85-939e97b2e73c"]
}, Open  ]]
}, Open  ]],

