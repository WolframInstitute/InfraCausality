Notebook[{

Cell[CellGroupData[{
Cell["InfraKinematics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e4d9def2-0d42-4758-abbf-9a69fd2ad6d9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraKinematics"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraKinematics", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", 
      StyleBox["b2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34acb019-2320-4f36-b67d-dcaefbd74335"],
 "\[LineSeparator]",
 "gives the projections of the chain ",
 StyleBox["ref", "TI"],
 " onto the target chains ",
 StyleBox["bi", "TI"],
 " and, for every pair of them, the Knuth energy, momentum, mass, interval \
and velocity, as an association.",
 "\n"
}], "Usage",ExpressionUUID->"6568e853-7279-4567-97b9-153a96d95974"],

Cell[TextData[{
 "Experimental: Knuth kinematics. The scalars follow Knuth and Bahreyni \
(arXiv:1005.4172), where two projections of one chain play the role of the \
light-cone coordinates ",
 StyleBox["u", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " + ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " = ",
 StyleBox["t", "TI"],
 " \[Minus] ",
 StyleBox["x", "TI"],
 "; which pairs of target chains carry a physical meaning is not settled, so \
every pair is reported and the reading may change."
}], "Notes",ExpressionUUID->"9759753c-f7a5-44c8-9522-e7c0b00ed23a"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["pi", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChainProjection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ChainProjection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ref", "TI"], ",", " ", 
    StyleBox["bi", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b94009ce-099f-45fa-b2d9-226526c4e88f"],
 ". For each pair (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") of projections, in the order of ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "p2", ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd2ecb4b-ea42-4abd-b0d5-c31ae0236968"],
 ", the association holds:"
}], "Notes",ExpressionUUID->"cac9fca9-210e-444f-b1b5-b0d2d090941b"],

