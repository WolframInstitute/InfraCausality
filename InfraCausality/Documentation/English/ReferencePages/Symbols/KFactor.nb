Cell["The angular form does not depend on the light angle.", "ExampleText",ExpressionUUID->"ae29cd8c-507f-40f8-ad2e-981eace3a0e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TrigExpand", "[", 
     RowBox[{
      RowBox[{"KFactor", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], "]"}], " ", "==", 
    " ", 
    RowBox[{
     RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"04df789f-e56a-44aa-b6ec-629f275a1436"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c13a1848-1903-45db-ae88-c065d27ada04"]
}, Open  ]],

Cell["Reversing the velocity inverts the k-factor.", "ExampleText",ExpressionUUID->"2caf4dc6-299d-4fb8-b770-05c1ac7ed6db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KFactor", "[", 
     RowBox[{"-", "v"}], "]"}], " ", "==", " ", 
    RowBox[{"1", "/", 
     RowBox[{"KFactor", "[", "v", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<", " ", "v", " ", "<", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bbc03d3e-ea2b-4775-a440-c4597251d11d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"806b063f-b6a0-4d05-8eb4-a8ac880da263"]
}, Open  ]],

Cell["\<\
The k-factors of two velocities multiply to the k-factor of their \
relativistic sum.\
\>", "ExampleText",ExpressionUUID->"f7a2a6ba-8a58-4b92-9dc5-09cbdb8e0b3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"KFactor", "[", "v1", "]"}], " ", 
     RowBox[{"KFactor", "[", "v2", "]"}]}], " ", "==", " ", 
    RowBox[{"KFactor", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6b08e8b8-fe63-4dc2-846b-cb889f931be6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"8e9f6293-ef72-417a-a3f6-f1ac9bef0e81"]
}, Open  ]],

Cell[TextData[{
 "The arc-length ratios of the outgoing and the incoming light multiply to ",
 StyleBox["k", "TI"],
 "\.b2."
}], "ExampleText",ExpressionUUID->"0ce81bac-6a6b-41ac-a5ce-ceb2931a1d58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TrigExpand", "[", 
     RowBox[{
      RowBox[{"OutgoingRatio", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
      RowBox[{"IncomingRatio", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"49300f38-ca21-428e-97ce-a8ac1be78899"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"1c0216a1-7f6f-4a24-bea6-9f8fa39f7927"]
}, Open  ]],

Cell[TextData[{
 "The k-factor inverts ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c01846e-8a06-4388-bc49-c4b71061072e"],
 " and is the exponential of the rapidity."
}], "ExampleText",ExpressionUUID->"5bcd035e-c326-47b1-99eb-5c4d73875172"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"KFactor", "[", 
      RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", "k"}], 
    " ", "&&", " ", 
    RowBox[{
     RowBox[{"KFactor", "[", "v", "]"}], " ", "==", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"Rapidity", "[", "v", "]"}], "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<", " ", "v", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"519e4360-2966-440b-960b-806b535731e6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"8bb5aaf3-327f-43bd-897e-23d8e24f4259"]
}, Open  ]]
}, Open  ]],

