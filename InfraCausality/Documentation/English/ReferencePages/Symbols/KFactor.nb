Cell[TextData[{
 "The k-factor over the velocity, on a logarithmic scale, where ",
 StyleBox["k", "TI"],
 "(\[Minus]",
 StyleBox["v", "TI"],
 ") = 1/",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is a reflection."
}], "ExampleText",ExpressionUUID->"4206eb19-5709-4e23-ac5e-3e05a9725284"],

