Cell[CellGroupData[{
Cell["KFactor", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1312a5e3-3105-4f25-a57e-30c9c99e9549"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2eb0f0d-a059-4c46-a19b-e8788321e337"],
 "\[LineSeparator]",
 "gives the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f184bfa9-6a24-4305-9400-96e6f49109f9"],
 " of the velocity ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d2d7e951-5538-43b0-8c49-7f3783149276"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90b82407-539e-4a4d-a2e4-add4f03187f9"],
 "\[LineSeparator]",
 "gives its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18b28311-edfa-41f2-8665-9a28fb29bba5"],
 " in the Euclidean picture with light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ", where ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ffcf9f-a533-4902-8e8a-400a7a3f2bb9"],
 "."
}], "Usage",ExpressionUUID->"20757036-0a02-4c55-9203-d3a46855a9a6"],

Cell[TextData[{
 "Definition: two inertial observers meet at an event. When one emits light \
signals at proper-time interval ",
 StyleBox["T", "TI"],
 ", the other receives them at proper-time interval ",
 StyleBox["kT", "TI"],
 "; the constant ",
 StyleBox["k", "TI"],
 " is the Bondi factor, and the symmetry of the two observers makes it the \
same in both directions. Radar then gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69e1e0f5-9f7a-4413-8d45-5c12f7877003"],
 " for the relative velocity ",
 StyleBox["v", "TI"],
 ", in units with the speed of light 1."
}], "Notes",ExpressionUUID->"8e5a94b1-b07b-4bb8-b5d7-501632eaf534"],

Cell[TextData[{
 "In the Euclidean picture of the guide the observer at rest is the time \
axis, light runs at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to it, and the observer of velocity ",
 StyleBox["v", "TI"],
 " is the ray at the angle ",
 StyleBox["\[Alpha]", "TI"],
 " with tan ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 StyleBox["v", "TI"],
 " tan ",
 StyleBox["\[CurlyPhi]", "TI"],
 ". The angular form is the k-factor read off this picture, and it does not \
depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 ": the picture is a family of drawings of one Minkowski plane."
}], "Notes",ExpressionUUID->"bc649ee5-94da-48c4-a64b-07cc992e0813"],

Cell[TextData[{
 StyleBox["k", "TI"],
 " > 1 for a receding observer (0 < ",
 StyleBox["v", "TI"],
 " < 1), ",
 StyleBox["k", "TI"],
 " = 1 at rest and ",
 StyleBox["k", "TI"],
 " < 1 for an approaching one; ",
 StyleBox["k", "TI"],
 "(\[Minus]",
 StyleBox["v", "TI"],
 ") = 1/",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 "). Velocities compose by multiplying their k-factors."
}], "Notes",ExpressionUUID->"2d68df81-8241-4f1f-b7d0-b7039243f866"]
}, Open  ]],

