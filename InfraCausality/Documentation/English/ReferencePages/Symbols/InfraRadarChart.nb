Cell["\<\
Radar time never decreases along an edge of the domain, and radar distance is \
never negative.\
\>", "ExampleText",ExpressionUUID->"8d411d3a-bf2e-47a2-a827-6bda0d2e2464"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"time", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Time\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
           " ", "\"\<Subgraph\>\""}], "]"}]}], ",", " ", 
        RowBox[{"edge", " ", "|->", " ", 
         RowBox[{
          RowBox[{"time", "[", 
           RowBox[{"First", " ", "@", " ", "edge"}], "]"}], " ", "<=", " ", 
          RowBox[{"time", "[", 
           RowBox[{"Last", " ", "@", " ", "edge"}], "]"}]}]}]}], "]"}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
          " ", "\"\<Distance\>\""}], "]"}], ",", " ", "NonNegative"}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2fb238e8-8741-4577-948a-6177810d75ba"],

