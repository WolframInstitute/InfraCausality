Cell["\<\
A worldline between two inner events of the diamond lattice charts only their \
causal diamond; the rest of the lattice stays grey.\
\>", "ExampleText",ExpressionUUID->"511a0926-6434-43c6-ae52-8336faff2763"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraRadarChart", "[", "a", "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2db0b8f4-57db-462a-bcb3-c2cd5c8f8748"],

