Cell["\<\
The radar domain is the causal diamond of the first and the last tick, and \
the fibers of the observer space partition it.\
\>", "ExampleText",ExpressionUUID->"7cc920f9-7b92-4039-8344-a475cb9bf8ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"domain", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"domain", " ", "===", " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", "a"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "a"}]}], "]"}]}], " ", "&&", "\n", 
      "      ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Join", " ", "@@", " ", 
