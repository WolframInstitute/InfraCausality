              " ", "\"\<Fibration\>\""}], "]"}]}]}], "]"}]}], "]"}], " ", "===",
        " ", "domain"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
