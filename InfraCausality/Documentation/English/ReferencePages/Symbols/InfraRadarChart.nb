Cell[TextData[{
 "A random worldline of the substrate (blue) and its radar chart (purple), on \
the diamond lattice, a sprinkling into two-dimensional Minkowski space and \
the cylinder lattice. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9042b3c7-0803-4f7f-b0a6-ba051a8f3341"],
 " draws a chart by its radar domain, the events it charts."
}], "ExampleText",ExpressionUUID->"4292be5e-053f-430c-a84e-0df18031842c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraRadarChart", "[", "a", "]"}], " ", "->", " ", 
           "StandardPurple"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
