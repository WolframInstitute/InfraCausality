Cell[TextData[{
 "A tick of the observer is its own emission and reception: the ",
 StyleBox["m", "TI"],
 "-th tick has radar time ",
 StyleBox["m", "TI"],
 " and distance 0."
}], "ExampleText",ExpressionUUID->"ac1d9d1c-de8a-4f6b-96c5-6f346d68a76d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"coordinates", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Coordinates\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"coordinates", " ", "/@", " ", "a"}], " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"Length", " ", "@", " ", "a"}]}], "}"}]}], "]"}]}]}], "]"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e0500378-8b0b-47e5-a99a-cdd46c136762"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8f43497f-e4d7-4d94-9320-423777585d76"]
}, Open  ]],

Cell["\<\
Radar time never decreases along an edge of the domain, and radar distance is \
never negative.\
\>", "ExampleText",ExpressionUUID->"c66f735e-407f-4532-a164-561c89b5f4f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"time", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Time\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
           " ", "\"\<Subgraph\>\""}], "]"}]}], ",", " ", 
        RowBox[{"edge", " ", "|->", " ", 
         RowBox[{
          RowBox[{"time", "[", 
           RowBox[{"First", " ", "@", " ", "edge"}], "]"}], " ", "<=", " ", 
          RowBox[{"time", "[", 
           RowBox[{"Last", " ", "@", " ", "edge"}], "]"}]}]}]}], "]"}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
          " ", "\"\<Distance\>\""}], "]"}], ",", " ", "NonNegative"}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f7f60648-f856-48ec-9662-ddaf63ef4f05"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"28625d44-29e0-43fd-9bb3-56c5056d30c9"]
}, Open  ]],

Cell["\<\
The radar domain is the causal diamond of the first and the last tick, and \
the fibers of the observer space partition it.\
\>", "ExampleText",ExpressionUUID->"f1d74b03-d412-4fc8-be55-f9d208f46d94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"domain", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"domain", " ", "===", " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", "a"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "a"}]}], "]"}]}], " ", "&&", "\n", 
      "      ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Join", " ", "@@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"VertexList", " ", "/@", " ", 
           RowBox[{"InfraFibers", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
              " ", "\"\<Fibration\>\""}], "]"}]}]}], "]"}]}], "]"}], " ", "===",
        " ", "domain"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9369cdd3-5ca0-46ae-9201-52f8849c6b75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"31ff8da8-41f0-4f36-8208-6edad2ea575d"]
}, Open  ]]
}, Open  ]],

