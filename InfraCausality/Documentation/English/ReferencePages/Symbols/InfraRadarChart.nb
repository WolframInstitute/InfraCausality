Notebook[{

Cell[CellGroupData[{
Cell["InfraRadarChart", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8d456ab1-ee14-4c9d-8a7b-fd6ff735d17e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRadarChart"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02b06def-c918-424f-8c1d-c363e4366dd9"],
 "\[LineSeparator]",
 "is the radar chart of the observer ",
 StyleBox["a", "TI"],
 ": it gives every event between the first and the last tick of ",
 StyleBox["a", "TI"],
 " its radar time and radar distance.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"15734dab-bd72-4901-889a-e377cc9d3da6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRadarChart"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["a", "TI"], ",", " ", 
     StyleBox["b", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9960ce18-e381-470d-9f15-16b5ec796ce7"],
 "\[LineSeparator]",
 "joins the radar charts of several observers on the events they all chart."
}], "Usage",ExpressionUUID->"6ef366ea-b83e-4ef5-999c-f4093b13bbb2"],

Cell[TextData[{
 "Definition: for an observer ",
 StyleBox["a", "TI"],
 " = (",
 StyleBox["a", "TI"],
 "1 \[Precedes] ",
 StyleBox["a", "TI"],
 "2 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ak", "TI"],
 "), a chain given as a vertex list in causal order, and an event ",
 StyleBox["e", "TI"],
 " of the radar domain [",
 StyleBox["a", "TI"],
 "1, ",
 StyleBox["ak", "TI"],
 "], the emission tick is ",
 StyleBox["i", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") = max{",
 StyleBox["i", "TI"],
 " : ",
 StyleBox["ai", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["e", "TI"],
 "}, the latest tick that can signal ",
 StyleBox["e", "TI"],
 ", and the reception tick is ",
 StyleBox["j", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") = min{",
 StyleBox["j", "TI"],
 " : ",
 StyleBox["e", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["aj", "TI"],
 "}, the earliest tick ",
 StyleBox["e", "TI"],
 " can signal. The radar time of ",
 StyleBox["e", "TI"],
 " is (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2 and its radar distance (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2."
}], "Notes",ExpressionUUID->"b7152ef2-ce6e-4184-8154-05c9b1d28bae"],

Cell["\<\
This is the radar construction of special relativity, made with the ticks of \
a clock instead of the readings of a continuous one: an event on the observer \
is its own emission and reception, at distance 0 and at its own tick; an \
event off it is seen by the latest signal that can reach it and answers the \
earliest signal it can send. Radar time is weakly monotone along every edge \
and radar distance is never negative. Radar distance is unsigned, so a single \
observer cannot tell left from right: the chart of a symmetric observer folds \
the graph along it. Joining the charts of several observers separates what \
one of them identifies.\
\>", "Notes",ExpressionUUID->"3ac381af-0256-4d82-86ee-bf6efa82d642"],

Cell[TextData[{
 "The head holds its observers and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d5d47cc-a694-4974-98dd-0ffc3e23c763"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"3aa9cbde-7ef1-4e59-a1d5-ffa3f0393f1d"],

