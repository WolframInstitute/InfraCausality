 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "A tick of the observer is its own emission and reception: the ",
 StyleBox["m", "TI"],
 "-th tick has radar time ",
 StyleBox["m", "TI"],
 " and distance 0."
}], "ExampleText",ExpressionUUID->"c2d2250b-c4b9-4050-86a2-4188dea1eb38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"coordinates", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Coordinates\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"coordinates", " ", "/@", " ", "a"}], " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"Length", " ", "@", " ", "a"}]}], "}"}]}], "]"}]}]}], "]"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b7fc3059-7322-4d3b-a118-964f7b5b7127"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"983a03b5-8c80-4ae8-a339-6c7cff3d2c8d"]
}, Open  ]],

Cell["\<\
Radar time never decreases along an edge of the domain, and radar distance is \
never negative.\
\>", "ExampleText",ExpressionUUID->"b24cc6b4-7480-49e7-9cf1-c8cb4eea439e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"time", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Time\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
           " ", "\"\<Subgraph\>\""}], "]"}]}], ",", " ", 
        RowBox[{"edge", " ", "|->", " ", 
         RowBox[{
          RowBox[{"time", "[", 
           RowBox[{"First", " ", "@", " ", "edge"}], "]"}], " ", "<=", " ", 
          RowBox[{"time", "[", 
           RowBox[{"Last", " ", "@", " ", "edge"}], "]"}]}]}]}], "]"}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
          " ", "\"\<Distance\>\""}], "]"}], ",", " ", "NonNegative"}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4f4a98b9-be18-48ef-8b77-d72a775cf3d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"59d3e7ff-1bdd-48ca-99a8-7c2c8db5a0a2"]
}, Open  ]],

Cell["\<\
The radar domain is the causal diamond of the first and the last tick, and \
the fibers of the observer space partition it.\
\>", "ExampleText",ExpressionUUID->"48f7f81f-a143-45c8-b828-3556dc0d5e80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"domain", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
         " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"domain", " ", "===", " ", 
       RowBox[{"RandomInfraCausalDiamond", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", "a"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "a"}]}], "]"}]}], " ", "&&", "\n", 
      "      ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Join", " ", "@@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"VertexList", " ", "/@", " ", 
           RowBox[{"InfraFibers", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
              " ", "\"\<Fibration\>\""}], "]"}]}]}], "]"}]}], "]"}], " ", "===",
        " ", "domain"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b94481db-0a43-49bf-8fb5-2e017badf858"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"bafc6405-36b2-4ecd-a584-dd323d7a2380"]
}, Open  ]]
}, Open  ]],

