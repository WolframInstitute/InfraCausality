Cell["\<\
A second observer separates what the first one identifies: on the events both \
observers chart, the joined chart of the sprinkling has more cells than the \
chart of the first observer.\
\>", "ExampleText",ExpressionUUID->"61dd731f-7d76-40c5-b087-9ad372c1b4a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"domain", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", 
       " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "domain"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
            " ", "\"\<Coordinates\>\""}], "]"}], ",", " ", "domain"}], 
         "]"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", 
          " ", "\"\<Coordinates\>\""}], "]"}]}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"6f7d46d8-017a-4471-b10f-0199f085cf1e"],

