Cell["\<\
The proper time and the number of timelike geodesics between the same events.\
\
\>", "ExampleText",ExpressionUUID->"75934310-9b88-4318-8be1-f88f16ef487a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{
             RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
             RowBox[{"InfraSlice", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", " ",
                "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraTimelikeGeodesic", "[", 
         RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Length\>\"", ",", " ", "\"\<Cardinality\>\""}], "}"}]}],
        "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8b95b985-5cb2-41c9-a15f-bc61dd818f6c"],

