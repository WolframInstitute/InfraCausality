Cell["\<\
The timelike geodesics from an event at height 1 to an event of its future \
one slice below the top, on the diamond lattice, a sprinkling into \
two-dimensional Minkowski space and the cylinder lattice. An edge is drawn as \
strongly as the number of longest chains through it.\
\>", "ExampleText",ExpressionUUID->"0d0ca498-abef-45b4-8fa1-387cbdb3f502"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraIntersection", "[", 
             RowBox[{
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
              RowBox[{"InfraSlice", "[", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", 
                " ", "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a85df39c-1453-4276-b1a5-5323e5405e28"],

