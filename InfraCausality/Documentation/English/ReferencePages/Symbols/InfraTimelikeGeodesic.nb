Cell["\<\
A polyline on the sprinkling, through an event of the first slice, an event \
of its future and an event of that one's future.\
\>", "ExampleText",ExpressionUUID->"5dca037f-23c8-42f1-af1f-acb57915a2d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "4", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "q", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "7", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraTimelikeGeodesic", "[", 
        RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", " ", "p", ",",
        " ", "q", ",", " ", "r"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"50fc73df-c1e6-43ba-a46a-515feb72f7c1"],

