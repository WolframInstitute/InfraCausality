Cell["\<\
The graph of the timelike geodesics on the sprinkling. Every longest chain is \
a path through it from its source to its sink.\
\>", "ExampleText",ExpressionUUID->"dd953037-e5ff-45b0-a105-64591b4922fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntersection", "[", 
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
           RowBox[{"InfraSlice", "[", "6", "]"}]}], "]"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTimelikeGeodesic", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fd2f0202-fea9-45db-a76e-ffa05f9dcaaa"],

