Cell["\<\
The longest chains starting at an event of the diamond lattice all end at the \
top corner; their proper time is the height of the event's future.\
\>", "ExampleText",ExpressionUUID->"cf59c56a-31a2-4894-a068-97ce2e6034ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraTimelikeGeodesic", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
