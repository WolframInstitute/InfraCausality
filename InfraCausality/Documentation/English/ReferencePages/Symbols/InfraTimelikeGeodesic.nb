Cell[TextData[{
 "The longest chains starting at ",
 StyleBox["p", "TI"],
 " are timelike geodesics from ",
 StyleBox["p", "TI"],
 " to events of its future at the largest proper time from ",
 StyleBox["p", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"257edb12-5fb3-48b9-ad41-160f82fa294e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraTimelikeGeodesic", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", "p", "]"}], ",", " ", "All"}],
          "]"}]}], ",", "\n", "     ", 
       RowBox[{"height", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", 
              RowBox[{"p", ",", " ", "#"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", "p", "]"}], ",", 
         " ", "\"\<Length\>\""}], "]"}], " ", "==", " ", "height"}], " ", "&&",
       "\n", "      ", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
       
       RowBox[{"{", 
        RowBox[{"height", " ", "+", " ", "1"}], "}"}]}], " ", "&&", " ", 
      RowBox[{"InfraTimelikeGeodesicQ", "[", 
       RowBox[{"g", ",", " ", "members"}], "]"}], " ", "&&", "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{
         RowBox[{"InfraMemberQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", "p", "]"}], ",", " ", "#"}], 
          "]"}], " ", "&"}]}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"489ca122-6123-4859-8185-627ab87fe682"],

