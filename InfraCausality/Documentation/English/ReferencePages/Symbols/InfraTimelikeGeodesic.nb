     "9fa5cd39-fb02-4a55-8f50-d28aed2bf9c5"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "331b0823-f19b-45c8-aef0-a275fad5dab7"]], "TableText",ExpressionUUID->
     "b4f33a50-ffc9-4ae4-8732-1526f07fe2c9"], Cell[TextData[{
     "the directed acyclic graph whose ",
     StyleBox["p", "TI"],
     "-to-",
     StyleBox["q", "TI"],
     " paths are the longest chains"
    }], "TableText",ExpressionUUID->"582bac78-5796-4bf6-af89-7f86ff3e303e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10bee623-c943-424a-bc63-2100dab3c198"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f2482e04-c7bf-4d81-abba-3f0ad8fbbf64"]], "TableText",ExpressionUUID->
     "3d3588e6-4951-4b91-84ef-61e9131642ac"], Cell[TextData[{
     "the proper time \[Tau](",
     StyleBox["p", "TI"],
     ", ",
     StyleBox["q", "TI"],
     "); ",
     Cell[BoxData[
      RowBox[{"-", "Infinity"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d6c7b9d-285b-4745-8c62-0dc38dc7afee"],
     " when ",
     StyleBox["q", "TI"],
     " does not follow ",
     StyleBox["p", "TI"]
    }], "TableText",ExpressionUUID->"068fc91f-af51-4b16-84f3-e295926e4d7f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07e4e261-702c-443d-893f-347f7a452842"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cda76386-934f-4366-9969-fee630a203df"]], "TableText",ExpressionUUID->
     "78e76031-98c5-461f-b0bf-becbd823790a"], Cell[
    "the number of longest chains", "TableText",ExpressionUUID->
     "cea4a059-f5cf-4380-941f-071216ea4f8f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b260f172-4098-4213-96fa-a79ba88b4800"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cb4d5d0b-d8de-4314-a06c-30c13669cf92"]], "TableText",ExpressionUUID->
     "327c47bb-afd8-4dc4-a5d7-16dc27ec0b4a"], Cell[
    "for each event, the number of longest chains through it", "TableText",
     ExpressionUUID->"eaa6bca1-4a40-48cb-b645-9be42b9c0dd1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a99fb73f-8a7b-400e-9efe-2b8ba45a8aa0"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
