           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{
             RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
             RowBox[{"InfraSlice", "[", "3", "]"}]}], "]"}]}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{
             RowBox[{"InfraCausalFuture", "[", "q", "]"}], ",", " ", 
             RowBox[{"InfraSlice", "[", "5", "]"}]}], "]"}]}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraTimelikeGeodesic", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", " ", 
          "All"}], "]"}]}], ",", "\n", "     ", 
       RowBox[{"cuts", " ", "=", " ", 
        RowBox[{"Accumulate", " ", "@", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}], ",", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTimelikeGeodesic", "[", 
              RowBox[{"q", ",", " ", "r"}], "]"}], ",", 
             " ", "\"\<Length\>\""}], "]"}]}], "}"}]}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", "\n", "        ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"q", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}]}], " ", "&&", "\n", "      ", 
      
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{"p", ",", " ", "q", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<Length\>\""}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"Last", "[", "cuts", "]"}], " ", "-", " ", "1"}]}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"members", ",", " ", 
        RowBox[{"member", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraTimelikeGeodesicQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"member", ",", " ", 
              RowBox[{"cuts", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}]}], "]"}]}],
            "]"}], " ", "&&", " ", 
          RowBox[{"InfraTimelikeGeodesicQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"member", ",", " ", 
              RowBox[{"cuts", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}]}], "]"}]}],
            "]"}]}]}]}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a0ff893d-6edf-403b-9e26-63c921f0cf00"],

