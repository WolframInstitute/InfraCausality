Cell["\<\
The members are vertex lists. Three of the 20 timelike geodesics from the \
bottom row to the top row of the cylinder lattice, each drawn as a walk.\
\>", "ExampleText",ExpressionUUID->"b06eb9e7-b9d2-4297-a85f-a2b775f7766f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", "3"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraWalk", "[", "member", "]"}], "}"}]}], "]"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"member", ",", " ", "members"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"04a47396-6106-4b9d-a0e1-4da24f8165c1"],

