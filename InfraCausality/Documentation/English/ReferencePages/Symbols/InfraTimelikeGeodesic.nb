     FontWeight->Bold,ExpressionUUID->"6307c1c9-1d77-4af3-850f-cbdad829f1d4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d47af5d6-9a6d-4542-8e58-5d5e1c2370e7"], Cell[
    "Minkowski space", "TableText",ExpressionUUID->
     "51b27ead-5f6c-4abf-a18c-dce1ec2d6e63"], Cell[
    "Timelike geodesic", "TableText",ExpressionUUID->
     "7df8629d-3746-4589-a131-358c7c424a41"], Cell["\<\
Between two timelike-separated events the straight worldline is the unique \
causal curve of maximal proper time.\
\>", "TableText",ExpressionUUID->"9e96b30f-ea8d-451c-8084-daafc19cfd93"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7e568f4c-5468-41c3-92dc-343d2c0abc70"], Cell[
    "Causal sets", "TableText",ExpressionUUID->
     "5dff3989-3e0d-46b6-b7f2-88bee02e26e6"], Cell[
    "Longest chain", "TableText",ExpressionUUID->
     "525c2df3-61de-4c48-9b95-580a98ae5bf4"], Cell["\<\
The length of a longest chain between two elements of a sprinkling estimates \
the proper time between them.\
\>", "TableText",ExpressionUUID->"30b1b723-40b3-4461-ace5-86f784f9c8c9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d01b77e9-0f3a-4e8a-a0ab-8173fbfc1d7c"], Cell[
    "EPS", "TableText",ExpressionUUID->
     "e0ba7859-49b6-4f3d-b570-b70bdc6646e5"], Cell[
    "Free particle", "TableText",ExpressionUUID->
     "54993c3b-5ed3-4ac2-aa26-3214bd821347"], Cell["\<\
The worldlines of freely falling particles are the geodesics of the \
projective structure.\
\>", "TableText",ExpressionUUID->"4f277fae-d01c-43d0-8243-940247760df7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f04a2945-707e-47d8-8ed2-\
0b433037cea9"]
}, Open  ]],

