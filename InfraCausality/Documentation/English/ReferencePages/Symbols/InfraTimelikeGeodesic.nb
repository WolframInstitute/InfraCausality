Cell[TextData[{
 "The cardinality is the number of members, and every member is a chain of \
\[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") + 1 events that passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTimelikeGeodesicQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesicQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bf152bc-1d14-4126-8b45-06894efed53f"],
 "."
}], "ExampleText",ExpressionUUID->"88526e9d-213c-426a-bdb3-d0a78c61ff11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{
             RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", " ", 
             RowBox[{"InfraSlice", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"CausalHeight", "[", "g", "]"}], "]"}], " ", "-", " ",
                "1"}], "]"}]}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"members", " ", "=", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Length", " ", "/@", " ", "members"}], "]"}], " ", "==", " ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Length\>\""}],
           "]"}], " ", "+", " ", "1"}], "}"}]}], " ", "&&", "\n", "      ", 
      RowBox[{"InfraTimelikeGeodesicQ", "[", 
       RowBox[{"g", ",", " ", "members"}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"37b6db30-f31d-4393-a39d-e5f80ee781b6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8f5c201f-c6f9-442e-9b56-5182c676f2ac"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice every maximal chain from {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} to {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 "} is longest, and there are Binomial[(",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") + (",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 "), ",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 "] of them."
}], "ExampleText",ExpressionUUID->"60364367-19d8-495b-bdd8-1028463d2927"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"p", " ", "<=", " ", "q"}], "]"}]}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"q", " ", "-", " ", "p"}], "]"}], ",", " ", 
          RowBox[{"First", "[", 
           RowBox[{"q", " ", "-", " ", "p"}], "]"}]}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"361bd784-c703-4c23-8b90-720178a60eb2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8f24a2eb-6d76-4ea9-beb9-122eb8ffd6cb"]
}, Open  ]],

Cell[TextData[{
 "The proper time is the causal height of ",
 StyleBox["q", "TI"],
 " in the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "], whose only source is ",
 StyleBox["p", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"1a6f7b73-ab27-4886-af32-9de1a7f46435"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", " ", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraCausalFuture", "[", "p", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", "q"}], 
          "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTimelikeGeodesic", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Length\>\""}], 
         "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"CausalHeight", "[", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCausalDiamond", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<Subgraph\>\""}], "]"}], "]"}], "[", "q", "]"}]}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e240ce49-6f42-43f3-af0a-08b852d11054"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a2f017f1-4c18-4246-ad23-87023100c575"]
}, Open  ]],

Cell["\<\
The members of a polyline are the concatenations of one timelike geodesic per \
leg: the cardinality is the product of the legs' cardinalities, the proper \
time their sum, and splitting a member at the knots gives a timelike geodesic \
on each leg.\
\>", "ExampleText",ExpressionUUID->"297a807f-96b1-46eb-805c-4d50c7daffd3"],

