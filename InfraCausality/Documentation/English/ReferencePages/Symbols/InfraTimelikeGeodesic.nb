Cell["\<\
The longest chains starting at an event of the sprinkling, and their proper \
time.\
\>", "ExampleText",ExpressionUUID->"f6765bf1-e69d-49ad-a80b-e781511c55a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSlice", "[", "1", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraTimelikeGeodesic", "[", "p", "]"}], ",", " ", "p"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTimelikeGeodesic", "[", "p", "]"}], ",", 
       " ", "\"\<Length\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"378d2308-79d7-48ae-acf4-6b4f95eaf0a6"],

