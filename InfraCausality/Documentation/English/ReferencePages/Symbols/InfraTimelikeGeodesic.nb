     "25d387ec-5f30-4b9a-b271-293fa8e3ced2"]], "TableText",ExpressionUUID->
     "02dce4e9-05be-46cf-b941-a31bcf77df0b"], Cell[
    "for each edge, the number of longest chains through it", "TableText",
