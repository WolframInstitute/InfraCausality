Cell[CellGroupData[{

Cell["Experimental: piecewise geodesics", "ExampleSubsection",ExpressionUUID->"90e8a2f3-542f-4b92-be9b-58e240c00851"],

Cell["\<\
The piecewise geodesics through three knots of the diamond lattice: a \
timelike geodesic from the first knot to the second, then from the second to \
the third. Every member passes the middle knot.\
\>", "ExampleText",ExpressionUUID->"fabf1d8e-2b03-46a5-bf79-61178e5b518e"],

Cell[CellGroupData[{

