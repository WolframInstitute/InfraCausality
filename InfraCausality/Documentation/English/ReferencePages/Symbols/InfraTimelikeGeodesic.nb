Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53253745-027f-470a-a192-0e7bee8fdf0f"],
 " is the same construction on the whole graph: the chains from a source to a \
sink whose length is the height of the graph, the maximum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalHeight"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalHeight", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29ad4dca-f314-4aad-b73c-2de21319ed63"],
 "."
}], "Notes",ExpressionUUID->"259b257d-dbd7-411f-8acc-63d822a79f0b"],

Cell[TextData[{
 "A member is a vertex list in causal order; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraTimelikeGeodesic"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraTimelikeGeodesic", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfff7411-3287-4ebd-bdf2-5d5e0deb64f2"],
 " draws members uniformly, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTimelikeGeodesicQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesicQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec0a1ebd-5902-414b-81f9-0f8e298bb7fb"],
 " recognises one. Every timelike geodesic is a worldline, a saturated chain; \
see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWorldline"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraWorldline", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42ee18ef-9c58-42f2-ab77-bf656099c2c2"],
 "."
}], "Notes",ExpressionUUID->"fed174d9-2cff-4b07-a1d9-7f0dbf49df0b"],

Cell[TextData[{
 "Experimental: the two further call forms are the same construction on other \
graphs. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56d612f-503b-47e9-8f77-a88686960a8f"],
 ", with ",
 StyleBox["k", "TI"],
 " \[GreaterEqual] 3, is the polyline whose legs are the timelike geodesics \
from ",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*"}]]], "InlineFormula",ExpressionUUID->
  "bfda3eae-b2c7-4ce0-9537-d2385ea284ad"],
 " to ",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "i", "*", 
    RowBox[{"+", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "f9b7881e-69da-40d9-bd81-c16cc2184c22"],
 "; its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4abcb4df-0b03-4adf-b048-a181758796ef"],
 " is the union of the legs' graphs, which meet only at the knots, so every \
path from ",
 StyleBox["p", "TI"],
 "1 to ",
 StyleBox["pk", "TI"],
 " passes every knot and is a member, ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4688013e-aebf-4f4b-ab66-a216cdc71ceb"],
 " is the sum \[Tau](",
 StyleBox["p", "TI"],
 "1, ",
 StyleBox["p", "TI"],
 "2) + \[Ellipsis] + \[Tau](",
 StyleBox["p", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "k", "*", 
    RowBox[{"\[Minus]", "1"}]}]]], "InlineFormula",ExpressionUUID->
  "f06e3fa4-5a18-4622-8f1b-a8b58bfafaf5"],
 ", ",
 StyleBox["pk", "TI"],
 ") of the legs' proper times and ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a90483ca-e479-4260-84a9-4b2b8a936414"],
 " the product of their cardinalities. A member is a piecewise geodesic, the \
discrete twin who turns at the knots; between the same endpoints it is at \
most as long as a timelike geodesic. When some knot does not precede the next \
the family is empty. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc3d7555-f3ad-41e4-ac5e-335b1f57d48e"],
 " is the family of longest chains that start at ",
 StyleBox["p", "TI"],
 ": with ",
 StyleBox["h", "TI"],
 " the largest proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") over the causal future of ",
 StyleBox["p", "TI"],
 ", its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57c0ee09-fd96-4c78-aec2-9ced7402b1b7"],
 " keeps the events ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") with \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") + \[Tau]\:207b(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["h", "TI"],
 ", where \[Tau]\:207b(",
 StyleBox["v", "TI"],
 ") is the longest chain from ",
 StyleBox["v", "TI"],
 " inside ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 "), and the edges along which \[Tau](",
 StyleBox["p", "TI"],
 ", \[CenterDot]) rises by one; its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59032f44-9485-4057-a34e-49a8005b7500"],
 " is ",
 StyleBox["h", "TI"],
 ". Both forms are sampled by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraTimelikeGeodesic"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraTimelikeGeodesic", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4591515-f022-4373-85e8-77d8995f20d0"],
 " and recognised by ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e199aa-2a9b-4631-b0b9-3cf6f163caa2"],
 " like the two-event form."
}], "Notes",ExpressionUUID->"efd0f23e-d274-4917-8cb4-2a3dab965183"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"f0e1881f-f17d-4b1b-b933-8772f75ea136"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8e9aebcd-50cb-4bb6-a1d6-3da7504c82f9"], Cell["System", "TableText",
