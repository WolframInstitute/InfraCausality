Cell[CellGroupData[{
Cell["InfraTimelikeGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8115f558-bdda-4125-9aed-1006f170237c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d0360da-d227-4d9c-84a7-a637fc22e0bc"],
 "\[LineSeparator]",
 "is the family of timelike geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every longest chain from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"553dc6ac-89d6-4601-a254-ad7b6a43a90d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4217c4b-21e4-4c7b-b8db-67b1081c5a61"],
 "\[LineSeparator]",
 "is the family of longest chains of the whole graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3060369e-e4fe-4e90-8cac-96d25fdf543d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ff76815-4c1e-46d3-b5f9-50ff9dccb0a3"],
 "\[LineSeparator]",
 "is the family of piecewise geodesics through the knots ",
 StyleBox["p", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["pk", "TI"],
 ": a longest chain from each knot to the next, concatenated.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2641b326-557d-4651-b76d-6a3449033c02"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTimelikeGeodesic"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraTimelikeGeodesic", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5523e394-eab7-4103-a970-f0bd39c80208"],
 "\[LineSeparator]",
 "is the family of longest chains starting at ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"923c81ea-d3f2-4d8f-a827-385e5415d6eb"],

Cell[TextData[{
 "Definition: a timelike geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a chain ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["e", "TI"],
 "0 \[Precedes] ",
 StyleBox["e", "TI"],
 "1 \[Precedes] \[Ellipsis] \[Precedes] ",
 StyleBox["ek", "TI"],
 " = ",
 StyleBox["q", "TI"],
 " of maximal length ",
 StyleBox["k", "TI"],
 ". The maximal length is the proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "), the number of edges of a longest directed path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"2e598a5c-1a1b-418a-bc87-1300fec3c62b"],

Cell["\<\
The proper time is the discrete analogue of the length of a timelike curve, \
and a longest chain is the analogue of a timelike geodesic: in Minkowski \
space the straight worldline between two events maximises the proper time, \
and every other route is shorter. On a graph the longest chain is rarely \
unique. The head carries all of them, equally admissible, so nothing \
distinguishes one.\
\>", "Notes",ExpressionUUID->"da4c2e19-4209-47ce-8a96-7b6bc3398634"],

Cell[TextData[{
 "The head holds its two events and computes nothing. Its graph, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["geo", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "986718d5-b6db-45c6-87d1-de23a84514ce"],
 ", keeps the events ",
 StyleBox["v", "TI"],
 " of the diamond [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] with \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") + \[Tau](",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") = \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") and the edges along which \[Tau](",
 StyleBox["p", "TI"],
 ", \[CenterDot]) rises by one. Its paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " are exactly the longest chains, each once, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1067115-7883-41cb-85b3-07a257403dab"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64094190-cab4-45c8-81d3-2cdea412b48b"],
 ", and every count is read off that graph by dynamic programming, never by \
enumeration."
}], "Notes",ExpressionUUID->"4e4360ed-eedb-4785-8eba-990bc8261038"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "90929786-57c4-4394-9344-7ae08f1bb8da"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"066ca793-63d9-49f2-aa50-cae56c6007d9"],
