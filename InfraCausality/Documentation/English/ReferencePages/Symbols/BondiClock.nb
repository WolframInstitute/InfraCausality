      RowBox[{"0.4", ",", " ", "8"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Cases", "[", 
