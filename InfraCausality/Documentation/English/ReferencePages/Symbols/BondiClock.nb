Cell[CellGroupData[{
Cell["BondiClock", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6e97d38c-418a-4422-8c26-953c955e7465"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6b10b43-91e7-4cb7-9b38-3e28abd3bb91"],
 "\[LineSeparator]",
 "draws the rest worldline and the worldline of velocity ",
 StyleBox["v", "TI"],
 " with a light signal bouncing ",
 StyleBox["n", "TI"],
 " times between them, and their proper-time ticks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"93142a23-3eb9-43a9-88ad-08cc1bc603b8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2add2b50-5862-4837-a1aa-55b230d31610"],
 "\[LineSeparator]",
 "draws 8 bounces."
}], "Usage",ExpressionUUID->"3435ea90-4ab8-4cab-8304-6ce392e6ca5a"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"480540de-9785-4479-9fa8-0889d3828667"],

Cell[TextData[{
 "Definition: the figure draws the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69f66386-6f23-4319-a55e-7c5ab1d0a3c8"],
 " of velocity ",
 StyleBox["v", "TI"],
 " from the emission arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41dd1b36-e828-4364-8be3-26034ecb7328"],
 ": the rest worldline (\"Alice\", blue), the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red), the light (yellow) and its reflection events (purple). The \
proper times of the successive events are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    StyleBox["k", "TI"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc632d0a-9721-4069-9e7e-0bd602ed6034"],
 ", each reception ",
 StyleBox["k", "TI"],
 " times the emission before it; on Alice's worldline, where proper time is \
arc length, the reflections are spaced by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58335fda-523b-4a56-846d-979a436b7be4"],
 ", so the number of bounces is logarithmic in the drawn length. The ticks \
mark the integer proper times on each worldline, at arc lengths ",
 StyleBox["\[Tau]", "TI"],
 " / ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e4b8d00-6ca2-409a-9e0a-6f9c6af23e3e"],
 ", so they are evenly spaced on each worldline and farther apart on the \
moving one."
}], "Notes",ExpressionUUID->"4fcd08fb-c1e6-4f3a-9977-2e453553b8b6"],

