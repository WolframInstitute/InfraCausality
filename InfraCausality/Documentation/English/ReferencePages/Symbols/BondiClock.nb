Cell[CellGroupData[{
Cell["BondiClock", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01e89b18-e201-4360-b053-720c89f6322c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3157f409-e1d7-4f8c-820a-9b9aca199ad8"],
 "\[LineSeparator]",
 "draws the rest worldline and the worldline of velocity ",
 StyleBox["v", "TI"],
 " with a light signal bouncing ",
 StyleBox["n", "TI"],
 " times between them, and their proper-time ticks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8782dc5b-b93b-430a-80e1-9146bb95eeae"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887bc6d3-e123-4225-ad5c-b2ef633d3d05"],
 "\[LineSeparator]",
 "draws 8 bounces."
}], "Usage",ExpressionUUID->"53c520da-4e05-42d9-8d01-34a34d3f89c6"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"b0872808-f478-4978-9c4a-10f5f7238b1b"],

Cell[TextData[{
 "Definition: the figure draws the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01fb6130-841f-403e-b2f1-85cba20b5cbd"],
 " of velocity ",
 StyleBox["v", "TI"],
 " from the emission arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aea5316-1417-496c-af8b-7b236293a12a"],
 ": the rest worldline (\"Alice\", blue), the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red), the light (yellow) and its reflection events (magenta). \
The proper times of the successive events are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    StyleBox["k", "TI"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "329497ef-c0b4-4de8-ab53-4c850e3363b0"],
 ", each reception ",
 StyleBox["k", "TI"],
 " times the emission before it; on Alice's worldline, where proper time is \
arc length, the reflections are spaced by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc9f5c54-a998-4922-94f1-337f80f8b67a"],
 ", so the number of bounces is logarithmic in the drawn length. The ticks \
mark the integer proper times on each worldline, at arc lengths ",
 StyleBox["\[Tau]", "TI"],
 " / ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "068c5c4c-b1b8-4e31-a0bd-36f2dc1ef557"],
 ", so they are evenly spaced on each worldline and farther apart on the \
moving one."
}], "Notes",ExpressionUUID->"dcdde1e0-50d3-4af0-b99f-7f1c8ef839b1"],

