Cell[CellGroupData[{
Cell["BondiClock", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"02049257-31ac-4730-8a2a-56e0d5c4c5d3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42a80c95-d52c-4a58-a32f-466d493e8d51"],
 "\[LineSeparator]",
 "draws the rest worldline and the worldline of velocity ",
 StyleBox["v", "TI"],
 " with a light signal bouncing ",
 StyleBox["n", "TI"],
 " times between them, and their proper-time ticks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cf72577c-68d8-4639-8102-559abe03bd2c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd2bd6e1-a28e-4350-8cd5-588badf7a2fb"],
 "\[LineSeparator]",
 "draws 8 bounces."
}], "Usage",ExpressionUUID->"4dd64fa5-d441-4f63-820b-9f59887a16ee"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"6643fe6a-3be1-42c0-8cf2-3f4a4dd0fec3"],

Cell[TextData[{
 "Definition: the figure draws the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1bc35ef9-73de-4039-a023-ad918c5447e5"],
 " of velocity ",
 StyleBox["v", "TI"],
 " from the emission arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "103b184f-0d52-42dd-82c1-23097f243ab5"],
 ": the rest worldline (\"Alice\", blue), the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red), the light (yellow) and its reflection events (purple). The \
proper times of the successive events are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    StyleBox["k", "TI"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "898a539c-f0d0-412d-aa5d-2e3ba0e7279a"],
 ", each reception ",
 StyleBox["k", "TI"],
 " times the emission before it; on Alice's worldline, where proper time is \
arc length, the reflections are spaced by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31fde6e1-4caf-48ad-8a46-fdb60e1865f2"],
 ", so the number of bounces is logarithmic in the drawn length. The ticks \
mark the integer proper times on each worldline, at arc lengths ",
 StyleBox["\[Tau]", "TI"],
 " / ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abee6c63-7b1a-4161-9faf-79da9de5e3a7"],
 ", so they are evenly spaced on each worldline and farther apart on the \
moving one."
}], "Notes",ExpressionUUID->"5340152b-6713-470c-b0f7-fa5f315fcc00"],

