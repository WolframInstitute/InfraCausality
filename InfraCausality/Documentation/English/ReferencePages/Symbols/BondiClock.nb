               RowBox[{"BondiKFactor", "[", "0.4", "]"}], "^", 
               RowBox[{"-", "4"}]}]}], "]"}], ",", " ", "8"}], "]"}], ",", 
          " ", "\"\<Point\>\""}], "]"}], "]"}]}], "]"}], "]"}], " ", "<", " ", 
    RowBox[{"10", "^", 
