           RowBox[{"Disk", "[", 
            RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
          " ", "Infinity"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{"0.4", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"0.05", ",", " ", 
              RowBox[{
               RowBox[{"KFactor", "[", "0.4", "]"}], "^", 
               RowBox[{"-", "4"}]}]}], "]"}], ",", " ", "8"}], "]"}], ",", 
          " ", "\"\<Point\>\""}], "]"}], "]"}]}], "]"}], "]"}], " ", "<", " ", 
    RowBox[{"10", "^", 
