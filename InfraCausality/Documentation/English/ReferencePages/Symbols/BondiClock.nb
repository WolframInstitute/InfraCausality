           RowBox[{"Disk", "[", 
            RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
          " ", "Infinity"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{"0.4", ",", " ", 
            RowBox[{"Max", "[", 
