     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bob", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"BondiClock", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Disk", "[", 
               RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
              " ", "Infinity"}], "]"}], ",", " ", 
           RowBox[{"c", " ", "|->", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bob", "]"}], " ", "==", " ", "4"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bob", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
                 RowBox[{"WorldlineAngle", "[", 
                  RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}], ",", 
               " ", "4"}], "]"}]}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Ratios", "[", 
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], "]"}], " ", "-", " ", 
            
            RowBox[{
             RowBox[{"BondiKFactor", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ddca4f34-4fba-4440-8a4a-941cb231d621"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5c1bdf06-4869-485b-9bd8-0963322c98cd"]
}, Open  ]],

Cell[TextData[{
 "Read in proper time, every event of the zigzag is ",
 StyleBox["k", "TI"],
 " times the one before, the labels ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83cffdfa-aded-4828-8bc3-5669b72b9fb7"],
 "."
}], "ExampleText",ExpressionUUID->"8ab6c862-708a-4c3d-bf6d-1fbe4f8cfaa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"taus", " ", "=", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], ",", 
               " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"ProperTimeScale", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
                RowBox[{"Norm", "[", "c", "]"}]}]}], "]"}]}], ",", "\n", 
            "      ", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"BondiClock", "[", 
               RowBox[{"v", ",", " ", "8", ",", " ", 
                RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], 
               "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
               " ", "Infinity"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Ratios", "[", "taus", "]"}], " ", "-", " ", 
           RowBox[{"BondiKFactor", "[", "v", "]"}]}], "]"}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f87167d3-3eed-4fc7-a73d-4a8f41605044"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"37a5a545-be9d-4fcf-80e2-d721c604aff7"]
}, Open  ]],

