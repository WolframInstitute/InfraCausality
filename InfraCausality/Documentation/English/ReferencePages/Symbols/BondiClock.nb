   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BondiClock", "[", 
      RowBox[{"0.4", ",", " ", "8"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
          " ", "Infinity"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{"0.4", ",", " ", 
            RowBox[{"Max", "[", 
