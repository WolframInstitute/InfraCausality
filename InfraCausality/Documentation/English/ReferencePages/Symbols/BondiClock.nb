Cell[CellGroupData[{
Cell["BondiClock", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6435e69f-ade2-4eaa-9201-e1fe970d32cf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48177800-62df-422b-b951-6a8d08ea7de7"],
 "\[LineSeparator]",
 "draws the rest worldline and the worldline of velocity ",
 StyleBox["v", "TI"],
 " with a light signal bouncing ",
 StyleBox["n", "TI"],
 " times between them, and their proper-time ticks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3e2d0777-063a-43d4-9cec-2ae2e5ed0bf6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84528bdd-b024-43a6-87e4-cc2950426818"],
 "\[LineSeparator]",
 "draws 8 bounces."
}], "Usage",ExpressionUUID->"1330af34-9b64-4986-ae60-7072a69363ea"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"65efb45d-6812-4b36-a8e9-447adaf13a2b"],

Cell[TextData[{
 "Definition: the figure draws the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d75a1fa2-66e9-4077-a538-4f00754405ec"],
 " of velocity ",
 StyleBox["v", "TI"],
 " from the emission arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37b20591-1367-447d-bc4d-9646adde7382"],
 ": the rest worldline (\"Alice\", blue), the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red), the light (yellow) and its reflection events (purple). The \
proper times of the successive events are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    StyleBox["k", "TI"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5632319-2d4a-44be-af47-77184a174fa3"],
 ", each reception ",
 StyleBox["k", "TI"],
 " times the emission before it; on Alice's worldline, where proper time is \
arc length, the reflections are spaced by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75a01a55-66f5-45e7-b607-c7ddc303f9a8"],
 ", so the number of bounces is logarithmic in the drawn length. The ticks \
mark the integer proper times on each worldline, at arc lengths ",
 StyleBox["\[Tau]", "TI"],
 " / ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d7f074f-70f8-4f7b-82d7-8ceda9c04240"],
 ", so they are evenly spaced on each worldline and farther apart on the \
moving one."
}], "Notes",ExpressionUUID->"fd649520-b51d-4565-9bda-ee37d6da86a0"],

