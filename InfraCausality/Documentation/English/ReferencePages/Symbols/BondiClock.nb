      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bob", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"BondiClock", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Disk", "[", 
               RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
              " ", "Infinity"}], "]"}], ",", " ", 
           RowBox[{"c", " ", "|->", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bob", "]"}], " ", "==", " ", "4"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bob", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", "4"}], 
              "]"}]}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Ratios", "[", 
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], "]"}], " ", "-", " ", 
            
            RowBox[{
             RowBox[{"KFactor", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f9f5a09e-250b-400e-af82-e1fa5e1201fe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"284c1f43-f926-4a90-9df3-7df3dbffb69f"]
}, Open  ]],

Cell[TextData[{
 "Read in proper time, every event of the zigzag is ",
 StyleBox["k", "TI"],
 " times the one before, the labels ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e577fed-ab85-44b3-adb7-6ebac8ccaf68"],
 "."
}], "ExampleText",ExpressionUUID->"8b192d05-3e5a-4ae3-b991-94ef567165af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"taus", " ", "=", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], ",", 
               " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"ProperTimeScale", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
                RowBox[{"Norm", "[", "c", "]"}]}]}], "]"}]}], ",", "\n", 
            "      ", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"BondiClock", "[", 
               RowBox[{"v", ",", " ", "8", ",", " ", 
                RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], 
               "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
               " ", "Infinity"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Ratios", "[", "taus", "]"}], " ", "-", " ", 
           RowBox[{"KFactor", "[", "v", "]"}]}], "]"}], "]"}], " ", "<", " ", 
        
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a8de6b08-f111-4eeb-882f-2cfa67aed339"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6bbc1e0f-1144-458c-836f-096fd7382201"]
}, Open  ]],

