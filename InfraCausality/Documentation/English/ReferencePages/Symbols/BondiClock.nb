 "."
}], "ExampleText",ExpressionUUID->"202e6873-1850-47e8-a69f-449a5126ab6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"taus", " ", "=", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], ",", 
               " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"ProperTimeScale", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
                RowBox[{"Norm", "[", "c", "]"}]}]}], "]"}]}], ",", "\n", 
            "      ", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"BondiClock", "[", 
               RowBox[{"v", ",", " ", "8", ",", " ", 
                RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], 
               "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
               " ", "Infinity"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Ratios", "[", "taus", "]"}], " ", "-", " ", 
           RowBox[{"KFactor", "[", "v", "]"}]}], "]"}], "]"}], " ", "<", " ", 
        
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aafb132a-d904-4a68-bf3d-3197f640c5d3"],

