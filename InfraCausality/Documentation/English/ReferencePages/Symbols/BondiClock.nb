Cell[CellGroupData[{
Cell["BondiClock", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2a8f3db-b382-463f-84ae-f1b412e2f20a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec4aa3a7-44fa-4582-95de-3f8aef6a539e"],
 "\[LineSeparator]",
 "draws the rest worldline and the worldline of velocity ",
 StyleBox["v", "TI"],
 " with a light signal bouncing ",
 StyleBox["n", "TI"],
 " times between them, and their proper-time ticks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ce32214a-aed5-4d2d-9cc4-e5c2c3b7e2c7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BondiClock"]], 
     "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78afe793-e798-4f85-ab7a-897b87ecec07"],
 "\[LineSeparator]",
 "draws 8 bounces."
}], "Usage",ExpressionUUID->"94f9000b-3e2b-425e-b86f-487fcceb9502"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"49f49d83-c8f5-40be-bf86-e856a1da62d4"],

Cell[TextData[{
 "Definition: the figure draws the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6dbd3e13-7054-49be-8d7e-04826b1e801b"],
 " of velocity ",
 StyleBox["v", "TI"],
 " from the emission arc length ",
 Cell[BoxData["\"\<EmitArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27b9d908-c878-4a8d-b163-66f9333a5a0f"],
 ": the rest worldline (\"Alice\", blue), the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red), the light (yellow) and its reflection events (magenta). \
The proper times of the successive events are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   RowBox[{
    StyleBox["k", "TI"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36df310d-51f9-4f46-8f7f-ada7ac581853"],
 ", each reception ",
 StyleBox["k", "TI"],
 " times the emission before it; on Alice's worldline, where proper time is \
arc length, the reflections are spaced by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81b6701c-3aac-4dcb-ac53-2134c5c9ed5f"],
 ", so the number of bounces is logarithmic in the drawn length. The ticks \
mark the integer proper times on each worldline, at arc lengths ",
 StyleBox["\[Tau]", "TI"],
 " / ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68549f47-1054-49b9-87cf-6b1c1b12b83c"],
 ", so they are evenly spaced on each worldline and farther apart on the \
moving one."
}], "Notes",ExpressionUUID->"add0835a-03bb-4c54-aa1d-e74024f533d8"],

