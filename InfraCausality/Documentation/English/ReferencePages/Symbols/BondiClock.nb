      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bob", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"BondiClock", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Disk", "[", 
               RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
              " ", "Infinity"}], "]"}], ",", " ", 
           RowBox[{"c", " ", "|->", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bob", "]"}], " ", "==", " ", "4"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bob", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", "4"}], 
              "]"}]}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Ratios", "[", 
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "bob"}], "]"}], "]"}], " ", "-", " ", 
            
            RowBox[{
             RowBox[{"KFactor", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"175d77ce-d367-4ccb-9da9-b61ff1a63168"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"77330e06-aab7-4f68-87fe-6935cf7e5d3e"]
}, Open  ]],

Cell[TextData[{
 "Read in proper time, every event of the zigzag is ",
 StyleBox["k", "TI"],
 " times the one before, the labels ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09abe736-45c0-49bd-9123-6ab291eb2f4c"],
 "."
}], "ExampleText",ExpressionUUID->"66c3d26d-46da-4ba9-99cb-c388990d63ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"taus", " ", "=", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], ",", 
               " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"ProperTimeScale", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
                RowBox[{"Norm", "[", "c", "]"}]}]}], "]"}]}], ",", "\n", 
            "      ", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"BondiClock", "[", 
               RowBox[{"v", ",", " ", "8", ",", " ", 
                RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], 
               "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
               " ", "Infinity"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Ratios", "[", "taus", "]"}], " ", "-", " ", 
           RowBox[{"KFactor", "[", "v", "]"}]}], "]"}], "]"}], " ", "<", " ", 
        
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ea7293e7-d96b-4d0b-89af-24b58387b7df"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e0a234c3-5830-441b-9187-fe0d0e9d4edb"]
}, Open  ]],

