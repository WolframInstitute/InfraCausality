Cell[TextData[{
 "The worldline angle of the velocity 3/5 at the default light angle, and the \
angle as a function of ",
 StyleBox["v", "TI"],
 " at the light angle \[Pi]/3."
}], "ExampleText",ExpressionUUID->"02a1ae86-93d6-432c-b431-a2381b41d754"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"WorldlineAngle", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"WorldlineAngle", "[", 
    RowBox[{"v", ",", " ", 
     RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e9d48aea-06a9-4609-b009-8dbf76661d4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ArcTan", "[", 
    FractionBox["3", "5"], "]"}], ",", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     SqrtBox["3"], " ", "v"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8b431b2a-be8d-4047-85cd-1806974eb276"]
}, Open  ]],

Cell[TextData[{
 "The worldline angle over the velocity for three light angles; each curve \
tends to its light angle as ",
 StyleBox["v", "TI"],
 " tends to 1."
}], "ExampleText",ExpressionUUID->"24b9189b-3c00-4310-be45-ddd7b653454c"],

