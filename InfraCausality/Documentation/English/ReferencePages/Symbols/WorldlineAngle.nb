Cell["\<\
The tangent of the worldline angle is the velocity times the tangent of the \
light angle.\
\>", "ExampleText",ExpressionUUID->"096d83a4-921e-415d-9f53-76d67f016166"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Tan", "[", 
      RowBox[{"WorldlineAngle", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"v", " ", 
      RowBox[{"Tan", "[", "phi", "]"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
      RowBox[{"Pi", "/", "2"}]}]}]}], "]"}], " ", "&&", " ", 
  RowBox[{
   RowBox[{"WorldlineAngle", "[", "v", "]"}], " ", "==", " ", 
   RowBox[{"ArcTan", "[", "v", "]"}]}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a7cd4d2f-271c-4593-a932-7102f15ab07c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7005fb9d-673a-47df-abf5-ac77e3b11200"]
}, Open  ]],

Cell[TextData[{
 "Every point of the worldline of velocity ",
 StyleBox["v", "TI"],
 " has radar distance ",
 StyleBox["v", "TI"],
 " times its radar time."
}], "ExampleText",ExpressionUUID->"6249199c-501f-479d-9894-05ee5b09dd7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"s", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"WorldlineAngle", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], ",", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"WorldlineAngle", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}]}], "}"}]}], ",", 
         " ", "phi"}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], " ", "==", " ", 
      RowBox[{"v", " ", 
       RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}]}]}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"s", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4443af23-41f7-4f8f-8032-79fb735fec0a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b2960187-df80-49f7-a313-2b41b2004bcc"]
}, Open  ]]
}, Open  ]],

