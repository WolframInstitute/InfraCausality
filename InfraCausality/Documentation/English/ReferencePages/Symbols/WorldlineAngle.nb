Notebook[{

Cell[CellGroupData[{
Cell["WorldlineAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e984402f-cd45-42c7-87dc-3d0d0e5a7619"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6393f234-34b8-4b14-9f66-118fe3cc8671"],
 "\[LineSeparator]",
 "gives the Euclidean angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dd0443c-1eea-4104-861b-fbd2a891873d"],
 " between the worldline of velocity ",
 StyleBox["v", "TI"],
 " and the time axis, for light at angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4c86d483-5767-49a8-a9cc-fbe519eae670"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4945393a-ac70-4e16-a217-b180fc4c0335"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"3e738e93-290d-4b59-bf85-c871ed0cae54"],

Cell[TextData[{
 "Definition: in the Euclidean picture the observer at rest is the time axis \
and light runs at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " to it. The worldline of velocity ",
 StyleBox["v", "TI"],
 " through the origin is the ray along which the radar distance is ",
 StyleBox["v", "TI"],
 " times the radar time; since radar distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["cot",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dafb1a05-3e0b-455f-94cb-3b3df85c6e98"],
 " and radar time is ",
 StyleBox["y", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15606644-597c-4879-86f4-974352c1e3c6"],
 "), the ray has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "/", 
   StyleBox["y", "TI"], "=", 
   StyleBox["v", "TI"], 
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6a56535-1cb0-4916-beea-28f80225beb9"],
 ", the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86f48ae8-3966-4b2e-ba0b-ad6f32f916e1"],
 "."
}], "Notes",ExpressionUUID->"82b10972-39f7-45e7-93c1-44093f459bcd"],

Cell[TextData[{
 "For 0 < ",
 StyleBox["v", "TI"],
 " < 1 the angle lies strictly between 0 and ",
 StyleBox["\[CurlyPhi]", "TI"],
 ": the worldline lies inside the light cone. The light angle is a choice of \
drawing: ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 is the familiar Minkowski diagram, and every other ",
 StyleBox["\[CurlyPhi]", "TI"],
 " draws the same Minkowski plane with the space axis rescaled by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577eac73-64e4-45de-bde3-fc6111354d24"],
 "."
}], "Notes",ExpressionUUID->"15fef8bb-c233-446a-94f2-9dd57a2cef1b"]
}, Open  ]],

