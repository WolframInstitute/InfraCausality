      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSlice", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
           RowBox[{"Lighter", "[", 
            RowBox[{"StandardBlue", ",", " ", "0.5"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"InfraSlice", "[", "3", "]"}], " ", "->", " ", 
           "StandardOrange"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
