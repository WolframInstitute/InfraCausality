Cell[TextData[{
 "At every time the slice and the earlier band are disjoint, their union is \
the band up to ",
 StyleBox["k", "TI"],
 ", and the slices of all times exhaust the events."
}], "ExampleText",ExpressionUUID->"2c3d333f-406b-4f4c-807b-41a77991bd5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"height", " ", "=", " ", 
        RowBox[{"Max", " ", "@", " ", 
         RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "height"}], "]"}], ",", " ", 
         RowBox[{"k", " ", "|->", "\n", "      ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"slice", " ", "=", " ", 
               RowBox[{"RandomInfraSlice", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}]}], ",", " ", 
              RowBox[{"earlier", " ", "=", " ", 
               RowBox[{"Keys", " ", "@", " ", 
                RowBox[{"InfraMeasurement", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"InfraSlice", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"k", " ", "-", " ", "1"}]}], "}"}], "]"}], ",", 
                  " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "}"}], ",", 
            "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Intersection", "[", 
               RowBox[{"slice", ",", " ", "earlier"}], "]"}], " ", "===", " ", 
              RowBox[{"{", "}"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Union", "[", 
               RowBox[{"slice", ",", " ", "earlier"}], "]"}], " ", "===", " ", 
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "k"}], "}"}], "]"}]}], "]"}]}]}]}], 
           "]"}]}]}], "]"}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Catenate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "#", "]"}]}], "]"}], " ", "&"}], " ",
            "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "height"}], "]"}]}], "]"}], "]"}], " ", "===",
         " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"VertexList", "[", "g", "]"}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ab9733d-217b-40ab-9448-ba805dac50a8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0e2b6fd3-e262-49af-ad6e-f37224549078"]
}, Open  ]],

Cell[TextData[{
 "Every slice is an antichain, and every event of slice ",
 StyleBox["k", "TI"],
 " > 0 has an in-neighbour in slice ",
 StyleBox["k", "TI"],
 " \[Minus] 1 and its whole strict past in the earlier band."
}], "ExampleText",ExpressionUUID->"06267e33-cb56-4438-b361-b8ee6e3d19ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "]"}], ",", " ", 
        RowBox[{"k", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraAntichainQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}]}], "]"}], " ", "&&",
           "\n", "        ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", " ", "==", " ", "0"}], " ", "||", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], ",", " ", 
              RowBox[{"v", " ", "|->", "\n", "          ", 
               RowBox[{
                RowBox[{"IntersectingQ", "[", 
                 RowBox[{
                  RowBox[{"VertexInComponent", "[", 
                   RowBox[{"g", ",", " ", "v", ",", " ", 
                    RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
                  RowBox[{"RandomInfraSlice", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"InfraSlice", "[", 
                    RowBox[{"k", " ", "-", " ", "1"}], "]"}]}], "]"}]}], 
                 "]"}], " ", "&&", "\n", "            ", 
                RowBox[{"SubsetQ", "[", 
                 RowBox[{
                  RowBox[{"RandomInfraSlice", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"InfraSlice", "[", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"k", " ", "-", " ", "1"}]}], "}"}], "]"}]}], 
                   "]"}], ",", " ", 
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{
                    RowBox[{"RandomInfraCausalPast", "[", 
                    RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", "v"}], 
                   "]"}]}], "]"}]}]}]}], "]"}]}], ")"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"46e2de8f-c078-444d-a13d-a778ffa6be50"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"61710dda-2c22-47e2-87df-84d226f1ee10"]
}, Open  ]],

