Cell[TextData[{
 "Definition: the frame at time ",
 StyleBox["k", "TI"],
 " draws, with ",
 Cell[BoxData["InfraSubstrateHighlight"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc40373-2514-4058-8a9f-dddd9c113da1"],
 ", the slice {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["k", "TI"],
 "} of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalTime"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalTime", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3111bc91-cdf5-4a46-bf51-592653e15673"],
 " ",
 StyleBox["t", "TI"],
 " in orange over the band {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") < ",
 StyleBox["k", "TI"],
 "} in light blue. The label gives ",
 StyleBox["k", "TI"],
 " and the sizes of the slice and of the band. The slider runs from 0 to the \
height of ",
 StyleBox["g", "TI"],
 ", the largest universal time."
}], "Notes",ExpressionUUID->"66dea5ea-42de-4302-85a9-4285cb73ff71"],

Cell[TextData[{
 "The universal time ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is the length of a longest chain ending at ",
 StyleBox["v", "TI"],
 ", and its level sets are the slices of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalFoliation"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalFoliation", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "06656770-fb8b-4a3f-ac12-79a0a7124449"],
 ". The result is a ",
 Cell[BoxData["Manipulate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db61b3f1-570d-413a-8f34-4e2f1a361de3"],
 " with ",
 Cell[BoxData[
  RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6419ab5-1309-45e5-917b-1dd38d75e9c4"],
 "; it needs the Wolfram notebook front end to move the slider."
}], "Notes",ExpressionUUID->"0381db41-ec49-4e73-ab52-bbe0a912aa3b"]
}, Open  ]],

