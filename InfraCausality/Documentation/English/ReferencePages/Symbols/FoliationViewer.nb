           WolframInstitute`InfraCausality`InfraSlice[
            WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k$$] -> 
           StandardOrange}], 
         Row[{
          "t = ", WolframInstitute`InfraCausality`CausalViewers`\
PackagePrivate`k$$, ",  slice ", 
           Length[
            
            WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`\
reading$["Slice"]], " events,  earlier ", 
           Length[
            
            WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`\
reading$["Earlier"]], " events"}], Top]], 
      "Specifications" :> {{{
         WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k$$, 0, 
          "Time"}, 0, 6, 1, Appearance -> "Labeled"}}, 
      "Options" :> {
       TrackedSymbols :> {
         WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k$$}}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({
      Attributes[
        WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`reading$]\
 = {Temporary}, 
       WolframInstitute`InfraCausality`PackageScope`foliationReading[
         Pattern[
         WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`g, 
          Blank[Graph]], 
         Pattern[
         WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k, 
          Blank[Integer]]] := <|
        "Time" -> 
         WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k, 
         "Slice" -> Keys[
           WolframInstitute`InfraGeometry`InfraMeasurement[
           WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`g, 
            WolframInstitute`InfraCausality`InfraSlice[
            WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`k], 
            "VertexDensity"]], "Earlier" -> Keys[
           WolframInstitute`InfraGeometry`InfraMeasurement[
           WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`g, 
            
            WolframInstitute`InfraCausality`InfraSlice[{
             0, WolframInstitute`InfraCausality`CausalViewers`PackagePrivate`\
k - 1}], "VertexDensity"]]|>, 
       WolframInstitute`InfraGeometry`InfraMeasurement[
         Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`graph, 
          Blank[Graph]], 
         WolframInstitute`InfraGeometry`InfraArc[
          Pattern[
          WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`center, 
           Blank[]], 
          Pattern[
          WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`pts, 
           Alternatives[{
             Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`p, 
              Blank[]], 
             BlankNullSequence[], 
             Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`p, 
              Blank[]]}, {
             Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`p, 
              Blank[]]}]], 
          Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`opts, 
           BlankNullSequence[Rule]]], "Graph"] := 
       With[{WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`dist = 
          AssociationThread[
            VertexList[
            WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`graph], 
            GraphDistance[
            WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`graph, 
             WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`center]], 
          WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`delta = 
          Replace[
            
            Lookup[{WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`\
opts}, "RadiusDelta", 0], 
            Pattern[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`d, 
              
              Except[
               Blank[List]]] :> {
             0, WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`d}]}, {
         WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`rmin = 
          Max[1, Lookup[
             WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`dist, 
              Key[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`p]] - 
            First[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`\
delta]], WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`rmax = 
          Lookup[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`dist, 
             
             Key[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`p]] + 
           Last[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`delta]}\
, {WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`local = 
          Subgraph[
           WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`graph, 
            Select[
             VertexList[
             WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`graph], 
             Lookup[WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`\
dist, 
               Key[#]] <= 
             WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`rmax + 
              1& ]]}, {
         WolframInstitute`InfraGeometry`InfraArc`PackagePrivate`outward = 
          SelectFirst[
            SortBy[
             Select[
