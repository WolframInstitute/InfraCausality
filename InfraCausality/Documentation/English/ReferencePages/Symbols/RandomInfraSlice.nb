Cell["\<\
The slice at height 3 on the diamond lattice, a sprinkling into \
two-dimensional Minkowski space and the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"51ecbb8f-2a05-4ea3-8059-18a43969d380"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"RandomInfraSlice", "[", 
    RowBox[{
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraSlice", "[", "3", "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5d6c6147-f39b-4e1a-bce7-7f18499f7503"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12", ",", "13", ",", "14", ",", "15", ",", "16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "3"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0b2dabc0-0057-424b-939d-601442bb774a"]
}, Open  ]],

Cell["\<\
The band from height 2 to height 4 of the sprinkling, drawn with a random \
event of the slice at height 3 and its causal past.\
\>", "ExampleText",ExpressionUUID->"5ce5e47f-4ab1-410e-81e1-9e9c956d852a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomChoice", " ", "@", " ", 
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", "3"}], "]"}]}]}], ")"}]}], "}"}], ",", "\n", 
   "  ", 
