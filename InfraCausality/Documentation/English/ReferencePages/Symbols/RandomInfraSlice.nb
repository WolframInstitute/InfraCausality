 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dc20dff-35b4-47ff-b246-58ed13b92fc2"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", "}"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc8cf812-7b61-46e3-8b61-0bb107546863"],
 "."
}], "Notes",ExpressionUUID->"ac8e1e42-bc67-434f-abc5-bebe327f1242"],

Cell[TextData[{
 "The draw involves no randomness. The option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65344b2f-27ec-405b-9d33-548ce100f768"],
 " is accepted with the values of the chain samplers and changes nothing \
here; ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomChoice"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9065faa-03f5-43b8-847d-447d1ba34685"],
 " together with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c92f81be-e88d-43c8-9401-bc51a42fcd72"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"108b1257-2ad2-4c09-87cf-64a91ae468f3"],

