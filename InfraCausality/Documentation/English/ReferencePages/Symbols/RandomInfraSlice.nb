   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSlice", "[", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["k1", "TI"], ",", " ", 
       StyleBox["k2", "TI"]}], "}"}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8ea80-ac13-455e-9d59-6244c9e9cc11"],
 "\[LineSeparator]",
 "gives the band of the slices from height ",
 StyleBox["k1", "TI"],
 " to height ",
 StyleBox["k2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"789d64ca-9df1-4988-aed2-300d8787a349"],
 Cell[BoxData[
