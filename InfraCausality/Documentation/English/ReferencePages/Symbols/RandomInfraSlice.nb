Cell[TextData[{
 "Definition: a slice denotes one vertex set, its support {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["k", "TI"],
 "}, or {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["k1", "TI"],
 " \[LessEqual] ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[LessEqual] ",
 StyleBox["k2", "TI"],
 "} for a band, where ",
 StyleBox["t", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalTime"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalTime", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4dbdb36d-b702-41fb-9c36-59e510774a94"],
 ". The sampler returns that support as a sorted vertex list."
}], "Notes",ExpressionUUID->"e005c9b8-ae7f-40cb-b8d2-40d2205eadc1"],

Cell[TextData[{
 "The count contract is the one every ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c01ac5b-2d2a-43af-a3d0-6d49a1b29787"],
 " sampler shares. With a single member it reads:"
}], "Notes",ExpressionUUID->"f03b1144-3c65-431a-9202-74e71b1b2674"],

