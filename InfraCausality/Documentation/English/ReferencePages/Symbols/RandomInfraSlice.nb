Cell[TextData[{
 "The slices of all heights are the universal foliation, and each passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSliceQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraSliceQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f36abadf-1e3c-4d63-aaed-785b0de8c8a8"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntichainQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraAntichainQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb941a20-a745-4b7c-9b5f-8871c092e149"],
 "."
}], "ExampleText",ExpressionUUID->"4a5fa59d-9353-4b38-aeb4-306f1b8ef771"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"slices", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomInfraSlice", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", 
            RowBox[{"Max", " ", "@", " ", 
             RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"slices", " ", "===", " ", 
        RowBox[{"UniversalFoliation", "[", "g", "]"}]}], " ", "&&", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"slices", ",", " ", 
         RowBox[{"s", " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraSliceQ", "[", 
            RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
           RowBox[{"InfraAntichainQ", "[", 
            RowBox[{"g", ",", " ", "s"}], "]"}]}]}]}], "]"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b2b11f0c-ee1c-433c-8042-1c67c640578f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dc066b29-e535-4d28-a8f0-979f4758dcdc"]
}, Open  ]],

Cell[TextData[{
 "The support is the key set of the vertex density, its only member: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10ef7c98-87ff-4778-a40b-ec9e7a748ef0"],
 " accepts it in any order and the cardinality is 1."
}], "ExampleText",ExpressionUUID->"bb35ff90-61b2-41ee-a1f5-45028f3ee964"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"k", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], " ", "===", " ", 
           
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSlice", "[", "k", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], "]"}]}]}], " ", "&&", "\n", 
          "        ", 
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSlice", "[", "k", "]"}], ",", " ", 
            RowBox[{"Reverse", " ", "@", " ", 
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}]}]}], "]"}], " ",
           "&&", "\n", "        ", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "k", "]"}], ",", 
             " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", "1"}]}]}]}],
        "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1419a49c-6ca4-42db-a97b-296bd3ffef49"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9b7927c7-f54b-4bf8-9fcb-5e612aadd6e8"]
}, Open  ]],

Cell["A band is the union of its slices.", "ExampleText",ExpressionUUID->"c8dec6ab-eee2-4791-ac28-8feb6afe2ff5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Max", " ", "@", " ", 
             RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"Apply", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k1", ",", " ", "k2"}], "}"}], " ", "|->", "\n", "      ", 
          
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"k1", ",", " ", "k2"}], "}"}]}], "]"}], " ", "===", " ", 
           RowBox[{"Union", " ", "@@", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", "k"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "k1", ",", " ", "k2"}], "}"}]}], 
             "]"}]}]}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"826c5724-1ea5-4aa4-8668-a6b441ef3bf6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"78945510-6d5f-4ab0-b87a-f6c521f4083e"]
}, Open  ]],

Cell["\<\
The causal past of a slice lies in the band below it, and on the two lattices \
it is the whole band: every event below the slice can signal it.\
\>", "ExampleText",ExpressionUUID->"6453fe83-cdff-437c-958e-43dcf766ac69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"k", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "k"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", "k"}], "]"}]}], "]"}]}], "]"}], " ", "&&",
           "\n", "        ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "name", " ", "===", " ", "\"\<MinkowskiSprinkling2D\>\""}], " ", "||",
             " ", 
            RowBox[{
             RowBox[{"RandomInfraSlice", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "k"}], "}"}]}], "]"}], " ", "===", " ", 
             RowBox[{"RandomInfraCausalPast", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"RandomInfraSlice", "[", 
                RowBox[{"g", ",", " ", "k"}], "]"}]}], "]"}]}]}], ")"}]}]}]}],
        "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3881cfe1-a93a-4e50-9964-2114bdae7a08"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"fcdfb0ed-a798-4a2d-adc6-eee2b365fd7d"]
}, Open  ]],

Cell["\<\
In general the band below a slice is its causal past exactly when every event \
of the band can signal some event of the slice. On the sprinkling this fails \
at five of the eight heights.\
\>", "ExampleText",ExpressionUUID->"aaf9190d-8e64-4954-a505-656e21997978"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"UniversalTime", "[", "g", "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"k", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "k"}], "}"}]}], "]"}], " ", "===", " ", 
            
            RowBox[{"RandomInfraCausalPast", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"RandomInfraSlice", "[", 
               RowBox[{"g", ",", " ", "k"}], "]"}]}], "]"}]}], ")"}], " ", "===",
           "\n", "        ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"RandomInfraSlice", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "k"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"e", " ", "|->", " ", 
             RowBox[{"IntersectingQ", "[", 
              RowBox[{
               RowBox[{"VertexOutComponent", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"{", "e", "}"}]}], "]"}], ",", " ", 
               RowBox[{"RandomInfraSlice", "[", 
                RowBox[{"g", ",", " ", "k"}], "]"}]}], "]"}]}]}], "]"}]}]}]}],
        "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"a74d86b8-1103-4228-9480-c659f20d54c0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"ecc01d15-b1cd-4d30-be1a-89f9cd329527"]
