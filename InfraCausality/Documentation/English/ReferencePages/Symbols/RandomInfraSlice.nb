Cell[TextData[{
 "A height above the longest chain, or below zero, has the empty slice: the \
count-less call gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4e126e6-7032-4e02-a4e4-9d34a9d82189"],
