Cell["\<\
The light segments run along the two light directions alternately.\
\>", "ExampleText",ExpressionUUID->"2eca11a0-cc58-4130-beab-83d2089ef146"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ray", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"LightClockConstruction", "[", 
             RowBox[{"v", ",", " ", "8", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"pts_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
              "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"Normalize", ",", " ", 
             RowBox[{"Differences", "[", "ray", "]"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"i", " ", "|->", " ", 
              RowBox[{"LightDirection", "[", 
               RowBox[{"phi", ",", " ", 
                RowBox[{"OddQ", "[", "i", "]"}]}], "]"}]}], ",", " ", 
             RowBox[{"Range", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], " ", "<",
         " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f4b8a20-536f-417b-8faa-cfcbfebf977c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9376966a-4fdc-417e-bb35-01358d2d1811"]
}, Open  ]],

Cell["\<\
The ticks lie on the moving worldline at equal steps of its proper time, and \
the rest observer's radar time between ticks is \[Gamma] times that step.\
\>", "ExampleText",ExpressionUUID->"8738cb0d-efc1-4e78-8729-1e502956ec31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ticks", " ", "=", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"LightClockConstruction", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"pts_", " ", "/;", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
               "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"steps", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"Map", "[", 
            RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"ticks", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "ticks"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
               RowBox[{"Length", "[", "ticks", "]"}]}], "]"}]}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"steps", " ", "-", " ", 
            RowBox[{"First", "[", "steps", "]"}]}], "]"}], "]"}], " ", "<", 
         " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Differences", "[", 
              RowBox[{"ticks", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
             "steps"}], " ", "-", " ", 
            RowBox[{"LorentzGamma", "[", "v", "]"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c518a73a-d4a9-4f8a-9edc-62b2af3e4c93"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ac15599d-4374-4192-be76-630b1adde43a"]
}, Open  ]]
}, Open  ]],

