Cell["\<\
The light segments run along the two light directions alternately.\
\>", "ExampleText",ExpressionUUID->"b7d51872-ee3b-4224-8132-a76600f7e6ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ray", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"LightClockConstruction", "[", 
             RowBox[{"v", ",", " ", "8", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"pts_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
              "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"Normalize", ",", " ", 
             RowBox[{"Differences", "[", "ray", "]"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"i", " ", "|->", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OddQ", "[", "i", "]"}], ",", " ", "1", ",", " ", 
                   RowBox[{"-", "1"}]}], "]"}], " ", 
                 RowBox[{"Sin", "[", "phi", "]"}]}], ",", " ", 
                RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}], ",", " ", 
             RowBox[{"Range", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], " ", "<",
         " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"03250d76-8e36-4613-9fdc-22beda54e4d8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2848a338-9485-4919-b625-4ea53c8a94df"]
}, Open  ]],

Cell["\<\
The ticks lie on the moving worldline at equal steps of its proper time, and \
the rest observer's radar time between ticks is \[Gamma] times that step.\
\>", "ExampleText",ExpressionUUID->"cc3c5700-2f84-49b9-9a9f-873f4e1a640a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ticks", " ", "=", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"LightClockConstruction", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"pts_", " ", "/;", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
               "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"steps", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"Map", "[", 
            RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"ticks", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "ticks"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
                 RowBox[{"WorldlineAngle", "[", 
                  RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}], ",", 
               " ", 
               RowBox[{"Length", "[", "ticks", "]"}]}], "]"}]}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"steps", " ", "-", " ", 
            RowBox[{"First", "[", "steps", "]"}]}], "]"}], "]"}], " ", "<", 
         " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Differences", "[", 
              RowBox[{"ticks", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
             "steps"}], " ", "-", " ", 
            RowBox[{"LorentzFactor", "[", "v", "]"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4985e66c-3907-4bae-9388-cc4a366b451a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"900af61b-d61b-41f1-afec-ede48b09f14b"]
}, Open  ]]
}, Open  ]],

