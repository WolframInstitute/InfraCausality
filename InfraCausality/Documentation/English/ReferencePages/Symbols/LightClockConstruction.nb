Cell["\<\
The light segments run along the two light directions alternately.\
\>", "ExampleText",ExpressionUUID->"607e695c-dfe3-4254-b697-b3fbf82fea6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ray", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"LightClockConstruction", "[", 
             RowBox[{"v", ",", " ", "8", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"pts_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
              "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"Normalize", ",", " ", 
             RowBox[{"Differences", "[", "ray", "]"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"i", " ", "|->", " ", 
              RowBox[{"LightDirection", "[", 
               RowBox[{"phi", ",", " ", 
                RowBox[{"OddQ", "[", "i", "]"}]}], "]"}]}], ",", " ", 
             RowBox[{"Range", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], " ", "<",
         " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a51229fd-e899-48bd-af3a-1480efb93fbe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aff47c8d-2de6-445f-a1ce-8c7e58e7f64c"]
}, Open  ]],

Cell["\<\
The ticks lie on the moving worldline at equal steps of its proper time, and \
the rest observer's radar time between ticks is \[Gamma] times that step.\
\>", "ExampleText",ExpressionUUID->"eebdedf9-8f1e-4f38-9d56-682856f65b4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ticks", " ", "=", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"LightClockConstruction", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"pts_", " ", "/;", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
               "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"steps", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"Map", "[", 
            RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"ticks", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "ticks"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
               RowBox[{"Length", "[", "ticks", "]"}]}], "]"}]}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"steps", " ", "-", " ", 
            RowBox[{"First", "[", "steps", "]"}]}], "]"}], "]"}], " ", "<", 
         " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Differences", "[", 
              RowBox[{"ticks", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
             "steps"}], " ", "-", " ", 
            RowBox[{"LorentzGamma", "[", "v", "]"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"46a410c4-b1a8-45ab-a181-ffdf2544fa1e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"134cc4de-30f9-456a-beaf-d130f69d6358"]
}, Open  ]]
}, Open  ]],

