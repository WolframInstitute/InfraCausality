  FontSize->0.9 Inherited,ExpressionUUID->
  "02208093-f6b2-4c3a-9c8c-fdeae6735b0e"],
 "\[LineSeparator]",
 "draws a transverse light clock carried by the observer of velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " bounces between the observer and a mirror.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b866069b-73b3-4f40-9bf6-861ece940af8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
