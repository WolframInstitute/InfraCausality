Cell["\<\
The light segments run along the two light directions alternately.\
\>", "ExampleText",ExpressionUUID->"15f82e80-a38c-4104-b607-ba718b7c2e05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.2", ",", " ", "0.5", ",", " ", "0.8"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ray", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"LightClockConstruction", "[", 
             RowBox[{"v", ",", " ", "8", ",", " ", 
              RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"pts_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
              "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"Normalize", ",", " ", 
             RowBox[{"Differences", "[", "ray", "]"}]}], "]"}], " ", "-", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"i", " ", "|->", " ", 
              RowBox[{"LightDirection", "[", 
               RowBox[{"phi", ",", " ", 
                RowBox[{"OddQ", "[", "i", "]"}]}], "]"}]}], ",", " ", 
             RowBox[{"Range", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], " ", "<",
         " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5dea6c4a-aae0-4020-8966-a2e9dc7760f6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e632ab97-b6a4-4d89-b6b8-907145c25fee"]
}, Open  ]],

Cell["\<\
The ticks lie on the moving worldline at equal steps of its proper time, and \
the rest observer's radar time between ticks is \[Gamma] times that step.\
\>", "ExampleText",ExpressionUUID->"5e28e45e-0388-400f-af7d-75a34960bad1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", "0.7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.1"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ticks", " ", "=", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"LightClockConstruction", "[", 
              RowBox[{"v", ",", " ", "8", ",", " ", 
               RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}],
              ",", " ", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"pts_", " ", "/;", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
               "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"steps", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"Map", "[", 
            RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"ticks", " ", "-", " ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{"Norm", ",", " ", "ticks"}], "]"}], " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"WorldlineDirection", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
               RowBox[{"Length", "[", "ticks", "]"}]}], "]"}]}]}], "]"}], 
          "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"steps", " ", "-", " ", 
            RowBox[{"First", "[", "steps", "]"}]}], "]"}], "]"}], " ", "<", 
         " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Differences", "[", 
              RowBox[{"ticks", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
             "steps"}], " ", "-", " ", 
            RowBox[{"LorentzGamma", "[", "v", "]"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"86967ff1-b142-40c8-a6d7-4012c9484451"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5c30b796-5fc5-4754-9a3f-34a0c58057b2"]
}, Open  ]]
}, Open  ]],

