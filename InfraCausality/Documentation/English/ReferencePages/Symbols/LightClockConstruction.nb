Cell["LightClockConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1f2c6401-3785-4b7e-966e-20613b2a5e3c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
