Cell[TextData[{
 "On the cylinder lattice the first two ticks of ",
 StyleBox["a", "TI"],
 " reach ",
 StyleBox["b", "TI"],
 " at ticks that answer and at ticks that do not, so the echo functions have \
domains of zero, one and two ticks."
}], "ExampleText",ExpressionUUID->"6a443a7b-7f4a-4bc3-a685-b3cf46bf9a11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
