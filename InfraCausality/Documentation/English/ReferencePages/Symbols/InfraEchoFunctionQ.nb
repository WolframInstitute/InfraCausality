Cell[CellGroupData[{
Cell["InfraEchoFunctionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"896bd28d-1e53-4cab-a127-64971debd462"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunctionQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e77abff-5cf9-4377-9fa4-7a144fa644b3"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "320cbc08-5061-4802-b76b-d7679a9f53f7"],
 " if the association ",
 StyleBox["f", "TI"],
 " is the composition of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " back to ",
 StyleBox["a", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d1e43172-9547-4f3f-a9dd-6301b3c2c5db"],

Cell[TextData[{
 "Statement: an association ",
 StyleBox["f", "TI"],
 " from ticks of ",
 StyleBox["a", "TI"],
 " to ticks of ",
 StyleBox["a", "TI"],
 " is an echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 " when there are message functions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "62976e3d-ce70-4103-8ca5-d5e5bfaa75e2"],
 " from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "79ecf4dc-7a74-4589-9c8e-8f5b68aa19b3"],
 " from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 ", in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af2ab109-27bb-4936-b98e-09cc0190d622"],
 ", with ",
 StyleBox["f", "TI"],
 " = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "6a9f6c90-b056-4019-93b3-4e6579b7153d"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "e6fc8082-f9a3-4d67-9841-5d7469108bc1"],
 ": the keys of ",
 StyleBox["f", "TI"],
 " are the ticks ",
 StyleBox["v", "TI"],
 " whose message ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "5a93e69b-9e5a-4ea6-b3a3-720eeb346ec6"],
 "(",
 StyleBox["v", "TI"],
 ") has a return, and ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "998cc700-2037-45b6-85ef-a9fa3bd117de"],
 "(",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "e4913e88-008c-4444-bad3-5678e023077e"],
 "(",
 StyleBox["v", "TI"],
 ")). This is the EPS echo: a light signal sent from ",
 StyleBox["a", "TI"],
 ", reflected at ",
 StyleBox["b", "TI"],
 " and received back on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"1b5439db-9e42-4247-9f6e-27ec3e4a13ff"],

Cell[TextData[{
 "The domain of an echo function depends on the message function chosen: a \
tick whose light reaches ",
 StyleBox["b", "TI"],
 " both at a tick that answers and at one that does not lies in the domain of \
some echo functions and not of others. The empty association is an echo \
function when some message function to ",
 StyleBox["b", "TI"],
 " sends every tick to a tick with no return."
}], "Notes",ExpressionUUID->"b85a4c60-3c04-42b5-8b4d-acaa8501d6ff"],

Cell[TextData[{
 "Being a monotone selection of the echo relation, the ",
 Cell[BoxData["\"\<Relation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a70abdcd-e547-425f-8c3a-d8f9ff01ab7f"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8f8239d-d59f-49f1-a472-e93c7e98a816"],
 ", is necessary and not sufficient. The predicate decides the composition \
without enumerating the message functions: it walks the ticks of ",
 StyleBox["a", "TI"],
 " through the layers of admissible images on ",
 StyleBox["b", "TI"],
 ", keeping only images that move forward along ",
 StyleBox["b", "TI"],
 ", or stay at a tick of ",
 StyleBox["b", "TI"],
 " whose return is already fixed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "abee443f-69b3-4a35-9ba6-341649dbbdf7"],
 " on the head is this predicate. It tests a candidate map against the pair \
of observers; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EPSMessageAxiomQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/EPSMessageAxiomQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a732db97-1656-406c-881d-f9babb420ec5"],
 " of the echo head tests the pair itself, whether every tick has one echo \
and the echoes strictly increase."
}], "Notes",ExpressionUUID->"355bc444-835c-418d-b29e-17aed370996c"]
}, Open  ]],

