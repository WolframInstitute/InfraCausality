    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{"RandomInfraEchoFunction", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraEchoFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e87776b-390d-4322-9999-0f7413bf7541"],

