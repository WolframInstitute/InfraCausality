Cell[TextData[{
 "On the cylinder lattice the first two ticks of ",
 StyleBox["a", "TI"],
 " reach ",
 StyleBox["b", "TI"],
 " at ticks that answer and at ticks that do not, so the echo functions have \
domains of zero, one and two ticks."
}], "ExampleText",ExpressionUUID->"e27c170c-ab37-4983-b8c1-e19e1e0d0593"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{"RandomInfraEchoFunction", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraEchoFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7e8da72c-85e9-4a03-bd39-465e1c7a471a"],

