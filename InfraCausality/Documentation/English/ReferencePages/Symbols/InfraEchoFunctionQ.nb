Cell[TextData[{
 "A monotone selection of the echo relation that is no composition. On the \
diamond lattice the staircase ",
 StyleBox["a", "TI"],
 " sends light to the staircase ",
 StyleBox["b", "TI"],
 " two steps up; every value of ",
 StyleBox["f", "TI"],
 " lies in the echo relation and the values move forward along ",
 StyleBox["a", "TI"],
 ", but no pair of message functions composes to ",
 StyleBox["f", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"3448bbdb-2fc2-411e-a7a3-3242ca62d606"],

