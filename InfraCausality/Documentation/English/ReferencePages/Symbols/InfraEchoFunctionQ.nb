Cell[TextData[{
 "The echo functions are exactly the compositions of two message functions, \
enumerated by brute force from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "696cdc0a-6449-4bbd-96f1-dbd7b448c802"],
 ", and the compositions pass; on the lattice, with 168 of them, the first \
forty are checked."
}], "ExampleText",ExpressionUUID->"fb474acf-2b56-484f-84b6-68fff48dff2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"compositions", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", "\n", "      ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", "compositions", "]"}], " ", "===", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
         "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"compositions", ",", " ", 
           RowBox[{"UpTo", "[", "40", "]"}]}], "]"}], ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1054ee17-52a8-4fd4-9cb9-f120c04c2210"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8091cfd-a337-46b2-b301-8d1f0427b81c"]
}, Open  ]],

Cell["\<\
Among the compositions of arbitrary single-valued selections, the predicate \
accepts exactly those of two message functions. Checked on the sprinkling and \
the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"d12c46c9-fbb6-4022-b009-5516bbc5cf87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "|->", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"relation", " ", "=", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"InfraMeasurement", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraMessageFunction", "[", 
                  RowBox[{"x", ",", " ", "y"}], "]"}], ",", 
                 " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"KeySort", " ", "/@", " ", 
         RowBox[{"RandomInfraEchoFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "1"}], "]"}]}]}], 
        ",", "\n", "      ", 
        RowBox[{"f", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"members", ",", " ", "f"}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"989d4520-8fa2-4e90-8076-23f37efd1194"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d1100490-22cf-464c-858b-38f7da5281d7"]
