Cell[TextData[{
 "On the diamond lattice, a sprinkling into two-dimensional Minkowski space \
and the cylinder lattice, an observer ",
 StyleBox["a", "TI"],
 " and an observer ",
 StyleBox["b", "TI"],
 " of the rest of the substrate. On each: a random echo function, the \
earliest echoes of the echo relation, and an echo function with one of its \
returns moved to a tick that is not an echo."
}], "ExampleText",ExpressionUUID->"6ce227b6-7c3c-46e0-bb7d-2e560edc1487"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomChoice", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"RandomInfraEchoFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraEchoFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"e", " ", "|->", " ", 
             RowBox[{"e", " ", "=!=", " ", 
              RowBox[{"<|", "|>"}]}]}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraEchoFunctionQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraEchoFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"InfraEchoFunctionQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraEchoFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
         RowBox[{"First", " ", "/@", " ", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraEchoFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
              " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
            RowBox[{"{", "}"}]}], "]"}]}]}], "]"}], ",", "\n", "     ", 
       RowBox[{"InfraEchoFunctionQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraEchoFunction", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"Keys", " ", "@", " ", "f"}], "]"}], " ", "->", " ", 
            RowBox[{"First", "[", "a", "]"}]}]}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73330855-82bb-450e-a9d6-bca1107ed97b"],

