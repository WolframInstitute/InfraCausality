Cell[CellGroupData[{
Cell["InfraEchoFunctionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a2c35b65-0728-4acf-9662-75b0c16b59e0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunctionQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ae21029-9f4c-46fa-ae86-c66ddb1dadb1"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313feb5c-5af0-4af7-af73-3682361a8a66"],
 " if the association ",
 StyleBox["f", "TI"],
 " is the composition of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " back to ",
 StyleBox["a", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"be5c2c26-63b1-4720-868a-ae0306ba920a"],

Cell[TextData[{
 "Statement: an association ",
 StyleBox["f", "TI"],
 " from ticks of ",
 StyleBox["a", "TI"],
 " to ticks of ",
 StyleBox["a", "TI"],
 " is an echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 " when there are message functions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "8825831d-73ec-4a97-9a81-3ca950cc8ffd"],
 " from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "5cf7bef1-9706-4a71-a059-72262d379bd1"],
 " from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 ", in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6dcc4a3d-8b6b-4b71-ae83-76c7a54f5942"],
 ", with ",
 StyleBox["f", "TI"],
 " = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "d805ad42-a621-488a-9ca3-2d937b8391e1"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "88871d1f-bda9-4364-9995-9e22248ce327"],
 ": the keys of ",
 StyleBox["f", "TI"],
 " are the ticks ",
 StyleBox["v", "TI"],
 " whose message ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "3da97401-066a-4662-bd2f-7b00d68704fd"],
 "(",
 StyleBox["v", "TI"],
 ") has a return, and ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "f5875b80-97e4-4bab-9ed3-6aa0c3b79822"],
 "(",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "d800522e-748f-488b-9a0b-4449af7b7e17"],
 "(",
 StyleBox["v", "TI"],
 ")). This is the EPS echo: a light signal sent from ",
 StyleBox["a", "TI"],
 ", reflected at ",
 StyleBox["b", "TI"],
 " and received back on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"127cea30-ceb6-4dbd-b42a-3a19ee3fc158"],

Cell[TextData[{
 "The domain of an echo function depends on the message function chosen: a \
tick whose light reaches ",
 StyleBox["b", "TI"],
 " both at a tick that answers and at one that does not lies in the domain of \
some echo functions and not of others. The empty association is an echo \
function when some message function to ",
 StyleBox["b", "TI"],
 " sends every tick to a tick with no return."
}], "Notes",ExpressionUUID->"09964fd9-0f40-4d6d-ad19-34f2a970b15b"],

Cell[TextData[{
 "Being a monotone selection of the echo relation, the ",
 Cell[BoxData["\"\<Relation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "922e2ced-9a65-47e2-bb01-87b254d86549"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b57641f1-2fb8-46d5-8d8d-1046a574f49e"],
 ", is necessary and not sufficient. The predicate decides the composition \
without enumerating the message functions: it walks the ticks of ",
 StyleBox["a", "TI"],
 " through the layers of admissible images on ",
 StyleBox["b", "TI"],
 ", keeping only images that move forward along ",
 StyleBox["b", "TI"],
 ", or stay at a tick of ",
 StyleBox["b", "TI"],
 " whose return is already fixed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb9a90e1-e104-4826-909a-57715134a809"],
 " on the head is this predicate."
}], "Notes",ExpressionUUID->"e6c6b6e4-2171-4248-a651-36c69dfea436"]
}, Open  ]],

