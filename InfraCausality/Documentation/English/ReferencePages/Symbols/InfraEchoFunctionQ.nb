Cell[TextData[{
 "The echo functions are exactly the compositions of two message functions, \
enumerated by brute force from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e3009e0f-e4c6-48b7-9b52-b9bf4fd1d05e"],
 ", and the compositions pass; on the lattice, with 168 of them, the first \
forty are checked."
}], "ExampleText",ExpressionUUID->"462028bd-3513-4197-b34e-efd3fd28b123"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"compositions", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", "\n", "      ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", "compositions", "]"}], " ", "===", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
         "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"compositions", ",", " ", 
           RowBox[{"UpTo", "[", "40", "]"}]}], "]"}], ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"33233523-0ddd-4805-8924-34a4cd81437d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f3ed1c14-02b9-4cec-b203-535f59205021"]
}, Open  ]],

Cell["\<\
Among the compositions of arbitrary single-valued selections, the predicate \
accepts exactly those of two message functions. Checked on the sprinkling and \
the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"abfe9c86-da8e-414b-8055-5772eff43cca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "|->", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"relation", " ", "=", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"InfraMeasurement", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraMessageFunction", "[", 
                  RowBox[{"x", ",", " ", "y"}], "]"}], ",", 
                 " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"KeySort", " ", "/@", " ", 
         RowBox[{"RandomInfraEchoFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "1"}], "]"}]}]}], 
        ",", "\n", "      ", 
        RowBox[{"f", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"members", ",", " ", "f"}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2a41bb95-4181-44c4-9424-e7340f654fb9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9063e7af-386e-41ba-b03a-91f185529e0f"]
}, Open  ]],

