Cell[TextData[{
 "The echo functions are exactly the compositions of two message functions, \
enumerated by brute force from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "918222d4-9970-4d02-8f3b-93f4711efcda"],
 ", and the compositions pass; on the lattice, with 168 of them, the first \
forty are checked."
}], "ExampleText",ExpressionUUID->"29d3f8a1-be55-4d25-858f-a39bb7f4358c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"compositions", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", "\n", "      ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", "compositions", "]"}], " ", "===", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
         "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"compositions", ",", " ", 
           RowBox[{"UpTo", "[", "40", "]"}]}], "]"}], ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dab22227-d72f-455c-9876-466c5b6890c8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2e9d211c-745b-4f9b-ac4d-52ebeb183b1b"]
}, Open  ]],

Cell["\<\
Among the compositions of arbitrary single-valued selections, the predicate \
accepts exactly those of two message functions. Checked on the sprinkling and \
the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"4daf6378-698d-49e0-91d5-6f254b21cd17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "|->", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"relation", " ", "=", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"InfraMeasurement", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraMessageFunction", "[", 
                  RowBox[{"x", ",", " ", "y"}], "]"}], ",", 
                 " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"KeySort", " ", "/@", " ", 
         RowBox[{"RandomInfraEchoFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "1"}], "]"}]}]}], 
        ",", "\n", "      ", 
        RowBox[{"f", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"members", ",", " ", "f"}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c88f8c1a-f48f-4035-aa9f-6e1d36b8a78d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"36e06404-21f3-4297-a2e1-bc1dcd65596c"]
