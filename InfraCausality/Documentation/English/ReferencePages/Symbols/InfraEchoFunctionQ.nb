Cell[TextData[{
 "The echo functions are exactly the compositions of two message functions, \
enumerated by brute force from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraMessageFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RandomInfraMessageFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48b85982-81b1-46a6-a78b-7c69b3bea043"],
 ", and the compositions pass; on the lattice, with 168 of them, the first \
forty are checked."
}], "ExampleText",ExpressionUUID->"6e510370-58d2-4550-8d3a-95f70d6fc433"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"compositions", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", "\n", "      ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", "compositions", "]"}], " ", "===", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
         "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"compositions", ",", " ", 
           RowBox[{"UpTo", "[", "40", "]"}]}], "]"}], ",", " ", 
         RowBox[{"f", " ", "|->", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7d2bf9f6-41ce-4d66-8b70-13826143da9a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"34953e1f-a84f-4f89-95cc-6d3a1a1833bf"]
}, Open  ]],

Cell["\<\
Among the compositions of arbitrary single-valued selections, the predicate \
accepts exactly those of two message functions. Checked on the sprinkling and \
the cylinder lattice.\
\>", "ExampleText",ExpressionUUID->"259962ee-c93d-48e7-a396-5151b078edb1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"selections", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "|->", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"relation", " ", "=", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"InfraMeasurement", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraMessageFunction", "[", 
                  RowBox[{"x", ",", " ", "y"}], "]"}], ",", 
                 " ", "\"\<Relation\>\""}], "]"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", "relation"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{"Values", " ", "@", " ", "relation"}], "]"}]}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"KeySort", " ", "/@", " ", 
         RowBox[{"RandomInfraEchoFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"selections", "[", 
             RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "1"}], "]"}]}]}], 
        ",", "\n", "      ", 
        RowBox[{"f", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"members", ",", " ", "f"}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9c32dde3-7ad3-40b5-9c21-0fcdd0ea13f0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1d6a30f0-4ea1-4e7a-a073-461446b2f535"]
