Cell[TextData[{
 "A monotone selection of the echo relation that is no composition. On the \
diamond lattice the staircase ",
 StyleBox["a", "TI"],
 " sends light to the staircase ",
 StyleBox["b", "TI"],
 " two steps up; every value of ",
 StyleBox["f", "TI"],
 " lies in the echo relation and the values move forward along ",
 StyleBox["a", "TI"],
 ", but no pair of message functions composes to ",
 StyleBox["f", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"2ee5a157-8faa-454c-ba44-b1ca51bb3d46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "i"}], "}"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "2"}], "}"}]}], ")"}], " ", "&"}], " ", "/@",
         " ", "b"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], " ", "<=", " ", "6"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "6"}], "}"}]}]}], "|>"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"relation", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraEchoFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Relation\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "f", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"relation", "[", "v", "]"}], ",", " ", 
          RowBox[{"f", "[", "v", "]"}]}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraEchoFunctionQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraEchoFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"926ee2bc-bce0-42cf-a154-a1c8fa17a1ec"],

