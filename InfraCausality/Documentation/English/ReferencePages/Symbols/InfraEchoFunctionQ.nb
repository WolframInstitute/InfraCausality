Cell[TextData[{
 "On the cylinder lattice the first two ticks of ",
 StyleBox["a", "TI"],
 " reach ",
 StyleBox["b", "TI"],
 " at ticks that answer and at ticks that do not, so the echo functions have \
domains of zero, one and two ticks."
}], "ExampleText",ExpressionUUID->"fafa2ae6-a39f-4936-9c5f-4aca24069ce8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{"RandomInfraEchoFunction", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraEchoFunction", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8d6f4994-c9ba-4543-b5ac-a0793726f687"],

