   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7cb70d35-959d-4c5c-842f-b3ae4b6997e6"],
 " agrees with the predicate, on members and on members with one return moved \
back to the tick that sent it."
}], "ExampleText",ExpressionUUID->"52a74051-6e83-4d44-a9d7-4a3adbb8b5c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sample", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"UpTo", "[", "8", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"sample", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"f", " ", "|->", " ", 
             RowBox[{"Append", "[", 
              RowBox[{"f", ",", " ", 
               RowBox[{
                RowBox[{"First", "[", 
                 RowBox[{"Keys", " ", "@", " ", "f"}], "]"}], " ", "->", " ", 
                
                RowBox[{"First", "[", 
                 RowBox[{"Keys", " ", "@", " ", "f"}], "]"}]}]}], "]"}]}], ",",
             " ", 
            RowBox[{"Select", "[", 
             RowBox[{"sample", ",", " ", 
              RowBox[{"f", " ", "|->", " ", 
               RowBox[{"f", " ", "=!=", " ", 
                RowBox[{"<|", "|>"}]}]}]}], "]"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"f", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
