Cell[CellGroupData[{
Cell["InfraEchoFunctionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"294cf3a4-6027-43e6-bc8e-f76d7262fee9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunctionQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8432ed27-ede4-41c8-9032-60411d4cd678"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc9d1263-3dd1-4fd7-a0f8-2e050a16312f"],
 " if the association ",
 StyleBox["f", "TI"],
 " is the composition of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " back to ",
 StyleBox["a", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"03c6d5f2-cbc7-47a3-bd36-1707729a171f"],

Cell[TextData[{
 "Statement: an association ",
 StyleBox["f", "TI"],
 " from ticks of ",
 StyleBox["a", "TI"],
 " to ticks of ",
 StyleBox["a", "TI"],
 " is an echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 " when there are message functions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "7f61d389-bd59-44ae-ab3a-d803aa7f42ec"],
 " from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "cb4e910b-2338-457c-aebc-54b461bb6bc0"],
 " from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 ", in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c72de136-3aa3-42ba-a473-eead298a76bb"],
 ", with ",
 StyleBox["f", "TI"],
 " = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "b94e3aef-f7ff-454b-a899-8a291d310244"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "6c6631ba-1b2f-4b20-9bcc-6f30a11717f9"],
 ": the keys of ",
 StyleBox["f", "TI"],
 " are the ticks ",
 StyleBox["v", "TI"],
 " whose message ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "c781045d-dcc3-4988-84a8-7e1b67f5dc9a"],
 "(",
 StyleBox["v", "TI"],
 ") has a return, and ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "c8d179d0-2ac0-40a9-99ca-891f739d03a7"],
 "(",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "05424397-c818-4890-87dc-037dcc244697"],
 "(",
 StyleBox["v", "TI"],
 ")). This is the EPS echo: a light signal sent from ",
 StyleBox["a", "TI"],
 ", reflected at ",
 StyleBox["b", "TI"],
 " and received back on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"c4ace85c-27cc-4fea-bf98-07a87cab42b3"],

Cell[TextData[{
 "The domain of an echo function depends on the message function chosen: a \
tick whose light reaches ",
 StyleBox["b", "TI"],
 " both at a tick that answers and at one that does not lies in the domain of \
some echo functions and not of others. The empty association is an echo \
function when some message function to ",
 StyleBox["b", "TI"],
 " sends every tick to a tick with no return."
}], "Notes",ExpressionUUID->"5c737d9a-e71c-4d6a-b776-fac55b3bb35c"],

Cell[TextData[{
 "Being a monotone selection of the echo relation, the ",
 Cell[BoxData["\"\<Relation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f65219-4ac0-4681-bfcd-cb933bae512c"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97203488-498b-4305-b613-13ad75ca46cf"],
 ", is necessary and not sufficient. The predicate decides the composition \
without enumerating the message functions: it walks the ticks of ",
 StyleBox["a", "TI"],
 " through the layers of admissible images on ",
 StyleBox["b", "TI"],
 ", keeping only images that move forward along ",
 StyleBox["b", "TI"],
 ", or stay at a tick of ",
 StyleBox["b", "TI"],
 " whose return is already fixed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6eeb6021-5186-4c72-8cba-5c35347b64e6"],
 " on the head is this predicate."
}], "Notes",ExpressionUUID->"31658d04-dde5-4ec5-9f08-d000bdff639b"]
}, Open  ]],

