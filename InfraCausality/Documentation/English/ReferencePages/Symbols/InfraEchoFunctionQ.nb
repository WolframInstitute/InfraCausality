 " agrees with the predicate, on members and on members with one return moved \
back to the tick that sent it."
}], "ExampleText",ExpressionUUID->"6c82cadb-a577-4c62-a355-8c0f09b03cc3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sample", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraEchoFunction", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
            RowBox[{"UpTo", "[", "8", "]"}]}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"sample", ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"f", " ", "|->", " ", 
             RowBox[{"Append", "[", 
              RowBox[{"f", ",", " ", 
               RowBox[{
                RowBox[{"First", "[", 
                 RowBox[{"Keys", " ", "@", " ", "f"}], "]"}], " ", "->", " ", 
                
                RowBox[{"First", "[", 
                 RowBox[{"Keys", " ", "@", " ", "f"}], "]"}]}]}], "]"}]}], ",",
             " ", 
            RowBox[{"Select", "[", 
             RowBox[{"sample", ",", " ", 
              RowBox[{"f", " ", "|->", " ", 
               RowBox[{"f", " ", "=!=", " ", 
                RowBox[{"<|", "|>"}]}]}]}], "]"}]}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"f", " ", "|->", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], "]"}], " ",
           "===", " ", 
          RowBox[{"InfraEchoFunctionQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraEchoFunction", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "f"}], 
           "]"}]}]}]}], "]"}]}], "]"}]}]}], "]"}]], "Input",
