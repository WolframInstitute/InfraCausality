Cell[CellGroupData[{
Cell["InfraEchoFunctionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c375d941-37a0-4659-87bf-368c07d930a7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunctionQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "502d69ef-d18e-4df5-afd9-5e461fb5cc17"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc65fd1d-5b3e-47ae-8283-024dad7fe548"],
 " if the association ",
 StyleBox["f", "TI"],
 " is the composition of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " back to ",
 StyleBox["a", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a5eec109-67e4-48dc-851f-8adbc7d90a0d"],

Cell[TextData[{
 "Statement: an association ",
 StyleBox["f", "TI"],
 " from ticks of ",
 StyleBox["a", "TI"],
 " to ticks of ",
 StyleBox["a", "TI"],
 " is an echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 " when there are message functions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "6da5d4b3-ce8c-4795-8690-af55aa0f035c"],
 " from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "e38ea827-81c2-4082-9ed0-36c57ec63385"],
 " from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 ", in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b9833e8-36f9-4574-873c-45643966b682"],
 ", with ",
 StyleBox["f", "TI"],
 " = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "bae5ccba-c1e4-4a11-ba10-18a031d39424"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "3536af3a-efda-4d1d-8dc0-34141493b8b0"],
 ": the keys of ",
 StyleBox["f", "TI"],
 " are the ticks ",
 StyleBox["v", "TI"],
 " whose message ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "402f0c18-ad84-44a2-b622-a0a96b1d2f4f"],
 "(",
 StyleBox["v", "TI"],
 ") has a return, and ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "862a9b3a-0c08-418c-920c-29b2e586ea77"],
 "(",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "5d0ef282-caa2-4963-a3d3-6b582ccb196e"],
 "(",
 StyleBox["v", "TI"],
 ")). This is the EPS echo: a light signal sent from ",
 StyleBox["a", "TI"],
 ", reflected at ",
 StyleBox["b", "TI"],
 " and received back on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"3f62a02f-a04f-43c7-a584-9f3d1583f508"],

Cell[TextData[{
 "The domain of an echo function depends on the message function chosen: a \
tick whose light reaches ",
 StyleBox["b", "TI"],
 " both at a tick that answers and at one that does not lies in the domain of \
some echo functions and not of others. The empty association is an echo \
function when some message function to ",
 StyleBox["b", "TI"],
 " sends every tick to a tick with no return."
}], "Notes",ExpressionUUID->"e9caef77-d5ec-4dd0-addc-9ace12aef318"],

Cell[TextData[{
 "Being a monotone selection of the echo relation, the ",
 Cell[BoxData["\"\<Relation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87792583-cf17-4d06-a707-36d60c415ea5"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33393520-634d-4822-94d2-daa90159ea7e"],
 ", is necessary and not sufficient. The predicate decides the composition \
without enumerating the message functions: it walks the ticks of ",
 StyleBox["a", "TI"],
 " through the layers of admissible images on ",
 StyleBox["b", "TI"],
 ", keeping only images that move forward along ",
 StyleBox["b", "TI"],
 ", or stay at a tick of ",
 StyleBox["b", "TI"],
 " whose return is already fixed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c059636-ebd1-4139-a177-ccdc6746f684"],
 " on the head is this predicate."
}], "Notes",ExpressionUUID->"442fbf83-cd20-452b-aca1-987dc54d5dee"]
}, Open  ]],

