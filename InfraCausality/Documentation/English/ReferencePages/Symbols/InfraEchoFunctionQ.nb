Cell[CellGroupData[{
Cell["InfraEchoFunctionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bcb6389a-e8f7-431f-9da4-d86b4c0fc180"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunctionQ"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d93afc6f-a7ff-471b-b0db-7460366bf0f1"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcf2facb-59dd-4580-bf62-d682590be075"],
 " if the association ",
 StyleBox["f", "TI"],
 " is the composition of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " back to ",
 StyleBox["a", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2d09076d-68ca-4ea9-8eaf-32a37ababbbf"],

Cell[TextData[{
 "Statement: an association ",
 StyleBox["f", "TI"],
 " from ticks of ",
 StyleBox["a", "TI"],
 " to ticks of ",
 StyleBox["a", "TI"],
 " is an echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 " when there are message functions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "521d8122-821c-4a26-9d3d-ecd3caad6d81"],
 " from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "aaa6825d-ce50-4a87-b091-0277b76732aa"],
 " from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 ", in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMessageFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraMessageFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "344c2788-5bdb-4e14-b6f5-a9ad89f992e1"],
 ", with ",
 StyleBox["f", "TI"],
 " = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "4f6d18f0-f416-4b50-bfb7-831d553bfd55"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "2d8a75b4-0340-49d1-93d0-94ffba4eeb8f"],
 ": the keys of ",
 StyleBox["f", "TI"],
 " are the ticks ",
 StyleBox["v", "TI"],
 " whose message ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "df6e3008-86f2-40ea-9b89-8ed75533a9a7"],
 "(",
 StyleBox["v", "TI"],
 ") has a return, and ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "1b4251a5-2eb5-493b-8530-81ae5689f94a"],
 "(",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "72ff11a6-853a-42d7-bc44-dc66be3c9e3e"],
 "(",
 StyleBox["v", "TI"],
 ")). This is the EPS echo: a light signal sent from ",
 StyleBox["a", "TI"],
 ", reflected at ",
 StyleBox["b", "TI"],
 " and received back on ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"b992ad56-42b2-4649-b378-4c4ae90206cf"],

Cell[TextData[{
 "The domain of an echo function depends on the message function chosen: a \
tick whose light reaches ",
 StyleBox["b", "TI"],
 " both at a tick that answers and at one that does not lies in the domain of \
some echo functions and not of others. The empty association is an echo \
function when some message function to ",
 StyleBox["b", "TI"],
 " sends every tick to a tick with no return."
}], "Notes",ExpressionUUID->"0ca49f54-bf09-4606-9c8a-6ed10b1164de"],

Cell[TextData[{
 "Being a monotone selection of the echo relation, the ",
 Cell[BoxData["\"\<Relation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62276751-f381-4e85-b678-87597e8201e2"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da673ee2-835b-40d0-8d4b-74a9fb8856d6"],
 ", is necessary and not sufficient. The predicate decides the composition \
without enumerating the message functions: it walks the ticks of ",
 StyleBox["a", "TI"],
 " through the layers of admissible images on ",
 StyleBox["b", "TI"],
 ", keeping only images that move forward along ",
 StyleBox["b", "TI"],
 ", or stay at a tick of ",
 StyleBox["b", "TI"],
 " whose return is already fixed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "46b293a5-26a5-4308-8c00-a38c1c488a49"],
 " on the head is this predicate."
}], "Notes",ExpressionUUID->"cbd54c7d-9eaa-4c55-b402-90a05a81a2bd"]
}, Open  ]],

