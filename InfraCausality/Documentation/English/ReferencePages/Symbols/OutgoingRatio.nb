    FractionBox["17", "2"]], ",", 
   SqrtBox["13"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e0dca304-0b5c-4c0d-befa-02b0bf068f0a"]
}, Open  ]],

