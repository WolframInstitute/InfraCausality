Cell["\<\
The outgoing ratio of the velocity 3/5 at the default light angle and at the \
light angle \[Pi]/3: arc-length ratios depend on the drawing.\
\>", "ExampleText",ExpressionUUID->"efa5cf20-371a-4ecc-8d37-6e5ce4ac97f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"OutgoingRatio", "[", 
     RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
    RowBox[{"OutgoingRatio", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", 
      RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ed0ed97e-c3fd-47a5-9edd-c5907942b78a"],

Cell[BoxData[
