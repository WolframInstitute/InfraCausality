Cell["\<\
The outgoing ratio of the velocity 3/5 at the default light angle and at the \
light angle \[Pi]/3: arc-length ratios depend on the drawing.\
\>", "ExampleText",ExpressionUUID->"9b90a74f-b474-457b-8d5c-372fe37fc0d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"OutgoingRatio", "[", 
     RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
    RowBox[{"OutgoingRatio", "[", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", 
      RowBox[{"Pi", "/", "3"}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"70255d5b-3454-46e1-8d84-6fe4b457f92e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
