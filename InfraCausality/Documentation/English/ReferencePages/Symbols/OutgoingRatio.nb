Cell[CellGroupData[{
Cell["OutgoingRatio", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d21c1cc6-aea6-4c46-94bd-06727e31202a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "facf229c-80e6-4b4d-bd67-17213f84cef8"],
 "\[LineSeparator]",
 "gives the arc-length ratio ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "742a2505-5ed0-4ece-b2da-279d442b3fc3"],
 " from an emission on the rest worldline to its reception on the worldline \
of velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d99a964c-da96-4724-99ac-df05a74ea8bc"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7de56cd8-8e0f-436f-a567-665f29aa5c72"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac8eb67-66ec-4a58-bbb6-eb606cc48958"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"253985b9-e63b-499b-98e9-10e5c1544bb6"],

Cell[TextData[{
 "Definition: light emitted at Euclidean arc length ",
 StyleBox["s", "TI"],
 " on the rest worldline (the point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c84e8340-ab81-4e97-b411-44532929f4a8"],
 ") and running to the right at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " meets the worldline of velocity ",
 StyleBox["v", "TI"],
 " at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681cb6fc-682c-4f12-9bdb-06d03e241ce8"],
 ". In the triangle of the origin, the emission and the reception the angle \
at the origin is ",
 StyleBox["\[Alpha]", "TI"],
 " and the angle at the reception is ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "-", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3eca709-01a3-4150-872e-34def3af03e7"],
 ", so the sine rule gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e28f7f17-9836-40a1-9b61-3841730a5101"],
 "."
}], "Notes",ExpressionUUID->"b4d9ec2c-4e51-453d-8c9e-9e63007c22fb"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], 
   StyleBox[
    RowBox[{"o", "u", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05cd4a1c-4bb5-451d-8b44-51d3e3088920"],
 " is a ratio of Euclidean arc lengths, not of proper times. The proper time \
on the moving worldline is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f4a5675-630f-4c5e-94d4-a1ff83f9e0c0"],
 " times arc length, so the ratio of proper times is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "\[CenterDot]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd3d6eb3-c4da-41b4-ab54-bb06fb04818d"],
 " ",
 Cell[BoxData["ProperTimeScale"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30d5500d-1d6b-44eb-8ae5-9d8d2b26951b"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "632bf66f-0adc-4aea-8d1d-fba42536ec26"],
 ", the k-factor, at every light angle."
}], "Notes",ExpressionUUID->"27f078fb-5b1f-4310-94eb-a3bcb993742c"]
}, Open  ]],

