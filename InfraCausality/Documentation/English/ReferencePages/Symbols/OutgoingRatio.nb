Cell[TextData[{
 "The reception at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a518e458-2268-4570-8512-fb3bc7e4745b"],
 " lies on the rightgoing light ray from the emission ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5422c94-fe1b-4d50-a263-216c3d6ba7d6"],
 "."
}], "ExampleText",ExpressionUUID->"01363c1e-e024-43e4-a039-840c5f7208bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "s"}], "}"}]}], ",", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"s", " ", 
           RowBox[{"OutgoingRatio", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Det", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", " ", "-", " ", "e"}], ",", " ", 
            RowBox[{"LightDirection", "[", 
             RowBox[{"phi", ",", " ", "True"}], "]"}]}], "}"}], "]"}], "]"}], 
        " ", "===", " ", "0"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c6ce179c-bb2d-42c0-b3c4-3e8d271389e5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"265b9def-58c4-44b3-a2bc-38e29a93795b"]
}, Open  ]],

Cell["\<\
The ratio of proper times is the k-factor at every light angle.\
\>", "ExampleText",ExpressionUUID->"c72a7342-75a0-42fa-ae75-f39b8de59add"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"OutgoingRatio", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
        RowBox[{"ProperTimeScale", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}]}], ")"}], "^", "2"}], " ", "==",
      " ", 
     RowBox[{
      RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ee347c84-9e0a-4a03-8430-25267ccf7e0a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4248ce82-8694-46b2-9383-806cbcc0e84b"]
}, Open  ]],

Cell[TextData[{
 "The outgoing and incoming ratios multiply to ",
 StyleBox["k", "TI"],
 "\.b2, the round-trip factor."
}], "ExampleText",ExpressionUUID->"7e6098b7-8d4d-4772-a48d-5144c25f7dbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"OutgoingRatio", "[", "v", "]"}], " ", 
     RowBox[{"IncomingRatio", "[", "v", "]"}]}], " ", "==", " ", 
    RowBox[{
     RowBox[{"KFactor", "[", "v", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e2d1df5f-032b-42aa-8293-93408375fe93"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"b3c0d24e-0da7-43dd-9436-e62641d34b43"]
