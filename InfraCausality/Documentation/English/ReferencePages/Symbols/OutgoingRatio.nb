Cell[TextData[{
 "The reception at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c953d7e-f302-4394-9a20-f5aeb028ad41"],
 " lies on the rightgoing light ray from the emission ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e947a593-a36f-4a69-8352-81446f937e7a"],
 "."
}], "ExampleText",ExpressionUUID->"ad1ef489-783c-4645-aac9-d81769403475"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "s"}], "}"}]}], ",", " ", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"s", " ", 
           RowBox[{"OutgoingRatio", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
           RowBox[{"Through", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
             RowBox[{"WorldlineAngle", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}]}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Det", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", " ", "-", " ", "e"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", "phi", "]"}], ",", " ", 
              RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}], "}"}], "]"}], 
         "]"}], " ", "===", " ", "0"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ce768679-73f6-4be6-9f18-e7cb71a369b2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0a039dc6-d722-438f-a593-c576415264c8"]
}, Open  ]],

Cell["\<\
The ratio of proper times is the k-factor at every light angle.\
\>", "ExampleText",ExpressionUUID->"ee3248f1-19e6-4d27-b5dd-4cd75b56f9a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"OutgoingRatio", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
        RowBox[{"ProperTimeScale", "[", 
         RowBox[{"v", ",", " ", "phi"}], "]"}]}], ")"}], "^", "2"}], " ", "==",
      " ", 
     RowBox[{
      RowBox[{"BondiKFactor", "[", "v", "]"}], "^", "2"}]}], "]"}], ",", " ", 
   
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"68858a5d-322f-4a01-abf7-3e7249771b95"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"26fd07db-813d-46ec-886f-8d0a920ce477"]
}, Open  ]],

Cell[TextData[{
 "The outgoing and incoming ratios multiply to ",
 StyleBox["k", "TI"],
 "\.b2, the round-trip factor."
}], "ExampleText",ExpressionUUID->"25857f12-f1b1-430e-923e-fd836c9e0032"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"OutgoingRatio", "[", "v", "]"}], " ", 
     RowBox[{"IncomingRatio", "[", "v", "]"}]}], " ", "==", " ", 
    RowBox[{
     RowBox[{"BondiKFactor", "[", "v", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ab78f899-9028-4ed0-9a31-801d462614db"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"13cf8480-493c-4e32-99b5-e91258f4655e"]
