Cell[CellGroupData[{
Cell["OutgoingRatio", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d54edb04-a827-4a84-b927-3be96291e036"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c46b32c-56cf-417f-b173-a7ad83fc209b"],
 "\[LineSeparator]",
 "gives the arc-length ratio ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5881c328-643c-4ced-b3b1-97a6ad3151d7"],
 " from an emission on the rest worldline to its reception on the worldline \
of velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f9ae22d-96ea-4f36-ab9a-cf0602c9f07c"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ee3f778-a600-403b-a790-89963cd92bf6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OutgoingRatio"]], 
     "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296c5c03-b2d4-46ee-b267-9620a82e7103"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"45596bbf-939d-4030-beb7-474704c6f5fe"],

Cell[TextData[{
 "Definition: light emitted at Euclidean arc length ",
 StyleBox["s", "TI"],
 " on the rest worldline (the point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e18e169e-7996-407c-8eb0-719d60b4b9b7"],
 ") and running to the right at the angle ",
 StyleBox["\[CurlyPhi]", "TI"],
 " meets the worldline of velocity ",
 StyleBox["v", "TI"],
 " at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], " ", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae1a8f9b-97e2-45b6-a4c5-269b2e889047"],
 ". In the triangle of the origin, the emission and the reception the angle \
at the origin is ",
 StyleBox["\[Alpha]", "TI"],
 " and the angle at the reception is ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "-", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffd03520-0fd6-40a7-9de6-69fa4f1d696b"],
 ", so the sine rule gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbeb1bcf-9ac6-425e-890e-128a0092d740"],
 "."
}], "Notes",ExpressionUUID->"7fdf7f45-4f15-4cf4-b170-dd3f8c74b04d"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], 
   StyleBox[
    RowBox[{"o", "u", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fcade10-3181-4458-a3c7-781ca8ac194b"],
 " is a ratio of Euclidean arc lengths, not of proper times. The proper time \
on the moving worldline is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "116fafc5-32d0-44f1-81d6-cbaa5f358ae7"],
 " times arc length, so the ratio of proper times is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "\[CenterDot]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69413c74-585d-4cb4-a9cc-36ae6c1e54ca"],
 " ",
 Cell[BoxData["ProperTimeScale"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bedf1f71-5cbb-4134-9c4d-47afcfd9e289"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a2feeea-19d4-4987-ba18-3c935089be22"],
 ", the k-factor, at every light angle."
}], "Notes",ExpressionUUID->"a8e84ecf-a431-4a44-8d20-8ce9913b83cf"]
}, Open  ]],

