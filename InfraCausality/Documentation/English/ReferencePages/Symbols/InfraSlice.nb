Notebook[{

Cell[CellGroupData[{
Cell["InfraSlice", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0d5c765-fff0-412c-be31-14473a4fff7c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSlice"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraSlice", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd8c57f-dbbf-4a6f-835f-151458377bb5"],
 "\[LineSeparator]",
 "is the slice of the universal time at height ",
 StyleBox["k", "TI"],
 ": the events whose longest chain from a source has ",
 StyleBox["k", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a5d96cee-7f0d-4f4b-b4bf-575a7a918d6c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSlice"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraSlice", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["k1", "TI"], ",", " ", 
     StyleBox["k2", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9aec57-4f41-4911-abfa-318d278846cd"],
 "\[LineSeparator]",
 "is the band of the slices from height ",
 StyleBox["k1", "TI"],
 " to height ",
 StyleBox["k2", "TI"],
 "."
}], "Usage",ExpressionUUID->"07573d85-1b32-484c-b65a-92610ab9030b"],

Cell[TextData[{
 "Definition: the slice at height ",
 StyleBox["k", "TI"],
 " of a directed acyclic graph is {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["k", "TI"],
 "}, where ",
 StyleBox["t", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalTime"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalTime", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b8e2ea7-c6bc-4d4b-b93e-69d72aa35b20"],
 " is the height, the number of edges of a longest chain from a source to ",
 StyleBox["v", "TI"],
 ". The band {",
 StyleBox["k1", "TI"],
 ", ",
 StyleBox["k2", "TI"],
 "} is {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["k1", "TI"],
 " \[LessEqual] ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[LessEqual] ",
 StyleBox["k2", "TI"],
 "}."
}], "Notes",ExpressionUUID->"194cec79-bbb8-4210-9fc6-1aae09942d3a"],

Cell[TextData[{
 "The height increases by at least one along every edge, so no two events of \
a slice are comparable: every slice is an antichain, the discrete analogue of \
a spacelike hypersurface, and the slices of all heights partition the events. \
They are the leaves of the universal foliation, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniversalFoliation"]], 
    "paclet:WolframInstitute/InfraCausality/ref/UniversalFoliation", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5428e214-7340-4c70-adb2-58f6153b22c2"],
 ". A slice is the set of events an observer who counts the longest chains \
from the beginning would call simultaneous."
}], "Notes",ExpressionUUID->"6dccd80f-a976-47cf-82ea-cc2092764b06"],

Cell[TextData[{
 "The head holds its height and computes nothing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70defeba-435a-495f-9f1a-2c122cd8b5b9"],
 " reads it on a graph:"
}], "Notes",ExpressionUUID->"088a69a5-9970-4819-b62c-585566dc1d2a"],

