Cell["\<\
The universal foliation of the sprinkling, every slice in its own colour.\
\>", "ExampleText",ExpressionUUID->"1e01d887-85ef-4a5c-968f-0e643f5f82f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraSlice", "[", "k", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "}"}]}], "]"}]}],
     "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f2543ddb-3534-49cc-8abe-e609ce9517d8"],

