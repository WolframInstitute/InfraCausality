Cell["\<\
The slices are antichains that partition the events, and they are the leaves \
of the universal foliation.\
\>", "ExampleText",ExpressionUUID->"5bc2c34f-7cb1-4946-9c5b-dd38120d681b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"slices", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", 
           RowBox[{"Max", " ", "@", " ", 
            RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "}"}]}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"slices", " ", "===", " ", 
       RowBox[{"UniversalFoliation", "[", "g", "]"}]}], " ", "&&", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"slices", ",", " ", 
        RowBox[{"s", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraAntichainQ", "[", 
           RowBox[{"g", ",", " ", "s"}], "]"}], " ", "&&", " ", 
          RowBox[{"InfraSliceQ", "[", 
           RowBox[{"g", ",", " ", "s"}], "]"}]}]}]}], "]"}], " ", "&&", "\n", 
      "      ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Join", " ", "@@", " ", "slices"}], "]"}], " ", "===", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}]}]}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4f6632e-ace5-402c-b456-04201fffcf72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9bba6b53-5e1d-4531-8eb2-ada9aeb97fdc"]
}, Open  ]],

Cell["A band is the union of its slices.", "ExampleText",ExpressionUUID->"e8fc92cf-0c5e-4e6a-9f0c-c4b11313ad44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"Apply", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k1", ",", " ", "k2"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{
        RowBox[{"RandomInfraSlice", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSlice", "[", 
           RowBox[{"{", 
            RowBox[{"k1", ",", " ", "k2"}], "}"}], "]"}]}], "]"}], " ", "===",
         " ", 
        RowBox[{"Union", " ", "@@", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomInfraSlice", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "k1", ",", " ", "k2"}], "}"}]}], 
          "]"}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4f12ef8b-5f33-4e16-997c-c9158e919b83"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e2a468ec-b173-4589-b4fd-7d386075cc88"]
}, Open  ]],

Cell[TextData[{
 "On the diamond lattice the slice at height ",
 StyleBox["k", "TI"],
 " is the antidiagonal ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 " = ",
 StyleBox["k", "TI"],
 ", and on the cylinder lattice it is the row ",
 StyleBox["k", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"eeb868b5-00a9-479f-b610-70b710301037"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "12"}], "]"}], ",", " ", 
       RowBox[{"k", " ", "|->", " ", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], " ", "===", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"v", " ", "|->", " ", 
             RowBox[{
              RowBox[{"Total", "[", "v", "]"}], " ", "==", " ", "k"}]}]}], 
           "]"}]}]}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "6"}], "]"}], ",", " ", 
       RowBox[{"k", " ", "|->", " ", 
        RowBox[{
         RowBox[{"RandomInfraSlice", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "k", "]"}]}], "]"}], " ", "===", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"v", " ", "|->", " ", 
             RowBox[{
              RowBox[{"Last", "[", "v", "]"}], " ", "==", " ", "k"}]}]}], 
           "]"}]}]}]}]}], "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1e82093f-5926-49a6-aa1d-6e7048eeb6da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fe8f10e6-250a-46c2-a81b-bd684e1f1f04"]
}, Open  ]],

Cell["A slice spans no edge.", "ExampleText",ExpressionUUID->"82f1d8b5-cee9-4147-a162-cae2e82f065f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"k", " ", "|->", " ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSlice", "[", "k", "]"}], ",", 
           " ", "\"\<EdgeDensity\>\""}], "]"}], " ", "===", " ", 
         RowBox[{"<|", "|>"}]}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"210c4cf4-3ccc-44e0-bf0a-366d8a6d61fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"c9e62849-f906-42ab-8bc0-120ea4fdc1e2"]
