Cell["The number of events of every slice of the diamond lattice.", \
"ExampleText",ExpressionUUID->"99bb1401-1ad5-46f8-89d0-1beec88fd0b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSlice", "[", "k", "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"Max", " ", "@", " ", 
        RowBox[{"UniversalTime", " ", "@", " ", "g"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"daf0d4a9-159f-4b9f-94f2-fe2c33a43e93"],

