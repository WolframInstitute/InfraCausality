LengthContractionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2160b17b-195a-4a00-9bdd-55e0e8596b71"],
 "\[LineSeparator]",
 "draws the radar measurement of a rod moving at velocity ",
 StyleBox["v", "TI"],
 " by the rest observer, illustrating the contracted length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df9c978-ca15-4d41-a5ca-ba69038e425d"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"1c009edc-86c9-440f-8b56-8416f820106e"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"df16eb3e-a0b2-4731-8973-b27a1d0fe25c"],

Cell[TextData[{
 "Definition: the rod's front end moves on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) and its back end on the parallel worldline (dashed) at the \
Minkowski distance ",
 Cell[BoxData["\"\<RodRestLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27843810-c260-4e58-bc42-19eb804d48c1"],
 " ",
 StyleBox["L", "TI"],
 " along Bob's line of simultaneity, the direction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c80b79-b2d4-45b6-8921-9863adc9de28"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b80ab06-8a74-4666-b8ac-6af87be1b7c9"],
 ": the Euclidean offset is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f6aeeb2-95f1-409b-b4dc-0fe56e48f3d3"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2fe606a-521e-4d39-908b-2f65462e5369"],
 ". At the front event ",
 StyleBox["F", "TI"],
 " at arc length ",
 Cell[BoxData["\"\<MeasureArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca0454c0-f49b-4f59-82d2-fabd89b2ebdd"],
 " the rod is drawn as a thick red segment from ",
 StyleBox["F", "TI"],
 " to its back end, of rest length ",
 StyleBox["L", "TI"],
 ". The rest observer (\"Alice\", blue) measures the rod at one radar time, \
the radar time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b33ffde-5073-4a80-b8ec-bd89defe9207"],
 " of ",
 StyleBox["F", "TI"],
 ": the orange bar is her line of simultaneity through ",
 StyleBox["F", "TI"],
 " (horizontal) to the back end's worldline, and the four faded light rays \
are her radar rays to the two ends of the bar. In her radar coordinates the \
two worldlines are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c66d59c5-b25f-4722-8e64-981f98f6ad54"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"], "+", 
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84bd1e80-3769-4c1a-8ea5-7d35881ba648"],
 ", so the bar has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b006191-eca7-4d2d-a410-762b81cc0ec7"],
 ", which the label prints."
}], "Notes",ExpressionUUID->"fa9c5bde-8778-4749-9a7e-2bc88027c84e"],

