Cell[TextData[{
 "Read off the drawing, with the Minkowski length of a spacelike Euclidean \
vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b08eb570-0afc-4909-b5bc-7f7b41b7d7f9"],
 " being ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], "/", 
       StyleBox["tan",
        FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cd3bb22-59ea-4ddf-8757-60dfbe6a4c41"],
 ": the rod, the segment along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bd71641-cc47-41cd-98bf-9d1c46690bef"],
 ", has rest length ",
 StyleBox["L", "TI"],
 ", and the orange bar, the horizontal segment, has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "709e5827-38f8-4928-9901-5deb3c8e9265"],
 ", and both start at the front event."
}], "ExampleText",ExpressionUUID->"8a124c55-64c9-42c0-a761-374ac0c46985"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"3", "/", "20"}]}], ",", " ", 
         RowBox[{"length", " ", "=", " ", 
          RowBox[{"pq", " ", "|->", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
                
                RowBox[{"Tan", "[", "phi", "]"}]}], ")"}], "^", "2"}], " ", "-",
              " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "^", 
              "2"}]}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}], ",", " ", 
             
             RowBox[{"\"\<RodRestLength\>\"", " ", "->", " ", "len"}], ",", 
             " ", 
             RowBox[{"\"\<MeasureArcLength\>\"", " ", "->", " ", 
              RowBox[{"3", "/", "5"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rod", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", " ", "@", " ", 
                 RowBox[{"Det", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], 
                    "}"}]}], "}"}], "]"}]}], "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"rod", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
         RowBox[{"bar", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"length", "[", "rod", "]"}], " ", "==", " ", "len"}], ",",
             " ", 
            RowBox[{
             RowBox[{"length", "[", "bar", "]"}], " ", "==", " ", 
             RowBox[{"len", "/", 
              RowBox[{"LorentzGamma", "[", "v", "]"}]}]}]}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "True"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cc6a1718-6b5f-4efa-82e3-fc4453ccd8bf"],

