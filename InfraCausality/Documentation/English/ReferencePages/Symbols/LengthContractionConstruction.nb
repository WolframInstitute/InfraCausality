Cell["\<\
The two ends of the orange bar have the same radar time, and the faded light \
rays are their radar rays: they leave and return to Alice's worldline at the \
emission and return arc lengths of the ends.\
\>", "ExampleText",ExpressionUUID->"bbba86ba-004e-41d9-a55b-765ac7dae036"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                 
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], " ", "<",
                " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"axis", " ", "=", " ", 
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"lines", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "!=", " ", "0"}]}]}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"bar", ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"e", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a102e417-706c-4d0f-a4ce-aeabc8f46d9b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"690dce0e-efcb-4cca-83ad-e8b8ae97a189"]
}, Open  ]],

Cell[TextData[{
 "Read off the drawing, with the Minkowski length of a spacelike Euclidean \
vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52b199d6-9bf9-4c4d-b86e-478f84d5e1d9"],
 " being ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], "/", 
       StyleBox["tan",
        FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17238011-a595-42e5-aa4f-51cb2a07a5bd"],
 ": the rod, the segment along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1fdae6-77bb-4e5c-8c67-172bfa7583c8"],
 ", has rest length ",
 StyleBox["L", "TI"],
 ", and the orange bar, the horizontal segment, has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a18225c-4083-4e2c-9670-b1d949e26c00"],
 ", and both start at the front event."
}], "ExampleText",ExpressionUUID->"fcb71dd5-626b-4d74-8708-b11b406eeba6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"3", "/", "20"}]}], ",", " ", 
         RowBox[{"length", " ", "=", " ", 
          RowBox[{"pq", " ", "|->", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
                
                RowBox[{"Tan", "[", "phi", "]"}]}], ")"}], "^", "2"}], " ", "-",
              " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "^", 
              "2"}]}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}], ",", " ", 
             
             RowBox[{"\"\<RodRestLength\>\"", " ", "->", " ", "len"}], ",", 
             " ", 
             RowBox[{"\"\<MeasureArcLength\>\"", " ", "->", " ", 
              RowBox[{"3", "/", "5"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rod", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", " ", "@", " ", 
                 RowBox[{"Det", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], 
                    "}"}]}], "}"}], "]"}]}], "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"rod", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
         RowBox[{"bar", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"length", "[", "rod", "]"}], " ", "==", " ", "len"}], ",",
             " ", 
            RowBox[{
             RowBox[{"length", "[", "bar", "]"}], " ", "==", " ", 
             RowBox[{"len", "/", 
              RowBox[{"LorentzGamma", "[", "v", "]"}]}]}]}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "True"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f99adf6-1890-4d75-bac8-918f994b5e9c"],

