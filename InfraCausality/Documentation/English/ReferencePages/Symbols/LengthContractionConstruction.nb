Cell[CellGroupData[{
Cell["LengthContractionConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b57c2779-01c7-4e3a-970e-dd7ff8e55639"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LengthContractionConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/\
LengthContractionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ca25071-d2a4-4b17-8dfb-4b9f0679fcb0"],
 "\[LineSeparator]",
 "draws the radar measurement of a rod moving at velocity ",
 StyleBox["v", "TI"],
 " by the rest observer, illustrating the contracted length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cf8de51-7128-481f-af51-23a797d6820e"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e3dac868-c9bc-4b55-94e5-81cd1d6ea7fa"],

Cell["\<\
Experimental: figure. The figure's layout and options may change, and its \
printed value is not yet a reading of the drawing (below).\
\>", "Notes",ExpressionUUID->"e1f75fbd-e07f-4e8d-8778-e08ac9d38b41"],

Cell[TextData[{
 "Definition: the rod's front end moves on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) and its back end on the parallel worldline (dashed) at the \
Euclidean distance ",
 Cell[BoxData["\"\<RodRestLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f86fc47-923e-4f15-862d-1fbdc2e5ca46"],
 " ",
 StyleBox["L", "TI"],
 " along ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineNormal"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c052272-cb19-4406-a9d9-9ae5ed3a8479"],
 ". At the front event at arc length ",
 Cell[BoxData["\"\<MeasureArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca186317-3d9c-4188-8798-49faf03d86c3"],
 " the rod is drawn as a thick segment to the back end; the rest observer \
(\"Alice\", blue) radar-locates both ends (four faded light rays), and the \
orange bar on her worldline spans the radar times of the two ends. The label \
prints ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "016e262c-d4bb-46ed-9806-64a42ad92126"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9df137c-1cb5-4a88-90ad-d3399d54633e"],
 "."
}], "Notes",ExpressionUUID->"5d751093-611f-46f5-84e8-8d1d895fc79d"],

Cell[TextData[{
 "Length contraction holds for the drawn rod: Alice's length of it, the \
difference of the radar distances of its two worldlines at one radar time, is \
its rest length (the Minkowski length across the two worldlines along Bob's \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4cb3b91-c90d-4e35-882a-7b0bc9ee15e6"],
 ") divided by \[Gamma]. But the Euclidean normal is not Bob's line of \
simultaneity, so the drawn rod's rest length is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], 
   StyleBox["v", "TI"], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7345f401-282f-438d-bab1-ef1281d31bee"],
 " (",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineAngle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e8cd3e74-452d-4a36-b1ec-9398e539cfdd"],
 "), not ",
 StyleBox["L", "TI"],
 ", and Alice's length of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["v", "TI"], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512f8381-5a8e-4db5-8e66-d6a8d799d801"],
 "; at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   SqrtBox[
    RowBox[{"1", "+", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02bcc1db-d1f8-4fa8-a10d-204b8a7952a0"],
 ". The printed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6577216d-2342-45b5-9441-fb6897f2c8c5"],
 " is the contraction of a rod of rest length ",
 StyleBox["L", "TI"],
 ", not a measurement read off the drawing, and the orange bar is a \
difference of radar times, not a length."
}], "Notes",ExpressionUUID->"4195888f-3342-4d37-b73d-1d88e505dd94"],

