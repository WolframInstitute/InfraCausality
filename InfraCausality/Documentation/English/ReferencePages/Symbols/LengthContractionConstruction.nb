Cell["\<\
The two ends of the orange bar have the same radar time, and the faded light \
rays are their radar rays: they leave and return to Alice's worldline at the \
emission and return arc lengths of the ends.\
\>", "ExampleText",ExpressionUUID->"bd4c728e-e603-4fd4-a8a6-e033f8b920e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                 
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], " ", "<",
                " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"axis", " ", "=", " ", 
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"lines", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "!=", " ", "0"}]}]}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"bar", ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"e", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4cfa7218-1b00-45c1-b30c-035ffb03b91b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e865dbed-8fca-4c2c-b20f-80dcea5b59b2"]
