LengthContractionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7291a9b0-8030-413c-9ff2-f8abf23e10b3"],
 "\[LineSeparator]",
 "draws the radar measurement of a rod moving at velocity ",
 StyleBox["v", "TI"],
 " by the rest observer, illustrating the contracted length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cc67d5b-f637-459b-8911-eb4d1226552d"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"16548555-3c0a-4de1-98e3-3a86f1d77c4c"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"6dd84b5c-27d5-4966-a490-13bec01abb36"],

Cell[TextData[{
 "Definition: the rod's front end moves on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) and its back end on the parallel worldline (dashed) at the \
Minkowski distance ",
 Cell[BoxData["\"\<RodRestLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d988330-bda6-4c01-9f0f-181590586219"],
 " ",
 StyleBox["L", "TI"],
 " along Bob's line of simultaneity, the direction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b16e290a-436a-4236-af89-1affec25a2e9"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2a1d8dc2-0638-4355-80c0-f102e6cc362a"],
 ": the Euclidean offset is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f372c233-f4e6-49ff-9406-5a96dd59566d"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6354cfb-3916-4a5d-b3ae-9f07e0b60852"],
 ". At the front event ",
 StyleBox["F", "TI"],
 " at arc length ",
 Cell[BoxData["\"\<MeasureArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f1a6af0-76e0-4407-8fd8-ab2b793a578c"],
 " the rod is drawn as a thick red segment from ",
 StyleBox["F", "TI"],
 " to its back end, of rest length ",
 StyleBox["L", "TI"],
 ". The rest observer (\"Alice\", blue) measures the rod at one radar time, \
the radar time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a14c531c-1e2d-4bb6-8c46-f50ec4fe6f48"],
 " of ",
 StyleBox["F", "TI"],
 ": the orange bar is her line of simultaneity through ",
 StyleBox["F", "TI"],
 " (horizontal) to the back end's worldline, and the four faded light rays \
are her radar rays to the two ends of the bar. In her radar coordinates the \
two worldlines are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2c7b111-dec0-4147-a581-9375cb8117b8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"], "+", 
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487898b0-2138-4737-a05c-a1b534108062"],
 ", so the bar has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bec55127-d4f1-430f-b786-d42025d978e4"],
 ", which the label prints."
}], "Notes",ExpressionUUID->"e11ffbdc-c0ed-49bf-a2f4-ad0534421cee"],

