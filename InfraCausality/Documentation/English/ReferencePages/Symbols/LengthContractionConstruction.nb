Cell["\<\
The faded light rays are the radar rays of the two ends: they leave and \
return to Alice's worldline at the emission and return arc lengths of the \
ends.\
\>", "ExampleText",ExpressionUUID->"568dd766-8a7d-4d84-a5a4-7999c15a660d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"LengthContractionConstruction", "[", 
          RowBox[{"v", ",", " ", 
           RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ends", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
               " ", "Infinity"}], "]"}], ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
           "]"}]}], ",", "\n", "     ", 
         RowBox[{"axis", " ", "=", " ", 
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{
                  RowBox[{"Line", "[", "pts_", "]"}], " ", ":>", " ", "pts"}],
                  ",", " ", "Infinity"}], "]"}], ",", " ", "1"}], "]"}], ",", 
             " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "!=", " ", "0"}]}]}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"ends", ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"e", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f75dc690-cf06-4e32-bfdd-1ecd0d5ed260"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f14991bf-e079-48db-96c8-a7ee4f90e564"]
}, Open  ]],

Cell[TextData[{
 "Length contraction on the drawn rod: Alice's length, the difference of the \
radar distances of the two end worldlines at one radar time, is the rest \
length along Bob's line of simultaneity divided by \[Gamma]; the rest length \
is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], 
   StyleBox["v", "TI"], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a98225e6-aab6-49eb-9e8a-16eea476dc3c"],
 "."
}], "ExampleText",ExpressionUUID->"f1352efc-e9e6-4223-ae29-c9f3a7aa845f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"3", "/", "20"}]}], ",", " ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"WorldlineDirection", "[", 
           RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"len", " ", 
           RowBox[{"WorldlineNormal", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}]}], ",", " ", 
         RowBox[{"radar", " ", "=", " ", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{"Values", " ", "@", " ", 
            RowBox[{"KeyTake", "[", 
             RowBox[{
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<RadarTime\>\"", ",", 
                " ", "\"\<RadarDistance\>\""}], "}"}]}], "]"}]}]}]}]}], "}"}],
        ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"alice", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"radar", "[", "n", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"v", " ", 
            RowBox[{
             RowBox[{"radar", "[", "n", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", "\n", "     ", 
         RowBox[{"across", " ", "=", " ", 
          RowBox[{"radar", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"LinearSolve", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"u", ",", " ", 
                  RowBox[{"-", "d"}]}], "}"}], "]"}], ",", " ", "n"}], 
              "]"}]}], " ", "u"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"rest", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"across", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"across", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"alice", " ", "==", " ", 
            RowBox[{"rest", "/", 
             RowBox[{"LorentzGamma", "[", "v", "]"}]}]}], ",", " ", 
           RowBox[{"rest", " ", "==", " ", 
            RowBox[{
             RowBox[{"LorentzGamma", "[", "v", "]"}], " ", "len", " ", 
             RowBox[{"v", "/", 
              RowBox[{"Sin", "[", 
               RowBox[{"WorldlineAngle", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}]}]}]}]}], "}"}], 
         "]"}], " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "True"}], "}"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"273e74df-28c4-4044-8cef-f739b305c619"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1b73519e-613d-4287-88a1-09e04261dd26"]
}, Open  ]]
