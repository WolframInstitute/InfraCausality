Cell["\<\
The two ends of the orange bar have the same radar time, and the faded light \
rays are their radar rays: they leave and return to Alice's worldline at the \
emission and return arc lengths of the ends.\
\>", "ExampleText",ExpressionUUID->"d0876ef1-a7f7-46f8-a6fb-748d9011aec7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                 
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], " ", "<",
                " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"axis", " ", "=", " ", 
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"lines", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "!=", " ", "0"}]}]}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"bar", ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"e", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"881346d3-a4ca-4e81-90fe-d8a001b966e8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"da43d3bf-c5fa-4f36-b2ba-54bc04bcf94c"]
}, Open  ]],

Cell[TextData[{
 "Read off the drawing, with the Minkowski length of a spacelike Euclidean \
vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7406fd06-436a-4d25-8390-ddbb3692853f"],
 " being ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], "/", 
       StyleBox["tan",
        FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df5a8f95-21c1-4eab-9301-a65462c1b995"],
 ": the rod, the segment along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3f1ac41-ec31-467d-b710-07f3278d93c9"],
 ", has rest length ",
 StyleBox["L", "TI"],
 ", and the orange bar, the horizontal segment, has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92b243fe-c9a8-4768-8d07-eb6ffe89d9de"],
 ", and both start at the front event."
}], "ExampleText",ExpressionUUID->"1b226c08-f84d-4835-96c7-7b2a8260493a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"3", "/", "20"}]}], ",", " ", 
         RowBox[{"length", " ", "=", " ", 
          RowBox[{"pq", " ", "|->", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
                
                RowBox[{"Tan", "[", "phi", "]"}]}], ")"}], "^", "2"}], " ", "-",
              " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "^", 
              "2"}]}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}], ",", " ", 
             
             RowBox[{"\"\<RodRestLength\>\"", " ", "->", " ", "len"}], ",", 
             " ", 
             RowBox[{"\"\<MeasureArcLength\>\"", " ", "->", " ", 
              RowBox[{"3", "/", "5"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rod", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", " ", "@", " ", 
                 RowBox[{"Det", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], 
                    "}"}]}], "}"}], "]"}]}], "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"rod", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
         RowBox[{"bar", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"length", "[", "rod", "]"}], " ", "==", " ", "len"}], ",",
             " ", 
            RowBox[{
             RowBox[{"length", "[", "bar", "]"}], " ", "==", " ", 
             RowBox[{"len", "/", 
              RowBox[{"LorentzFactor", "[", "v", "]"}]}]}]}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "True"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a43cbc9f-c850-48fc-9e2d-4b24917e4c43"],

