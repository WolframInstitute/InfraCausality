Cell["\<\
The two ends of the orange bar have the same radar time, and the faded light \
rays are their radar rays: they leave and return to Alice's worldline at the \
emission and return arc lengths of the ends.\
\>", "ExampleText",ExpressionUUID->"90010fc0-6c1b-4b72-826b-56ae77c930ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                 
                 RowBox[{"pq", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], " ", "<",
                " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"axis", " ", "=", " ", 
          RowBox[{"Union", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"lines", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "!=", " ", "0"}]}]}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"bar", ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"BondiRadarCoordinates", "[", 
               RowBox[{"e", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"axis", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", 
                 " ", 
                 RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "]"}], 
               "]"}], " ", "<", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e1f566ce-247b-48e8-b55d-913dce1c571d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f9fdc94e-aee7-44ba-a605-a79cb799e88e"]
}, Open  ]],

Cell[TextData[{
 "Read off the drawing, with the Minkowski length of a spacelike Euclidean \
vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081ab982-dabe-4094-92e2-96a001f263e7"],
 " being ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], "/", 
       StyleBox["tan",
        FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea37cd37-60fa-4096-927c-2d4b0d5aed37"],
 ": the rod, the segment along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77c08dcd-9dfd-43ca-8cea-4f62d21a833c"],
 ", has rest length ",
 StyleBox["L", "TI"],
 ", and the orange bar, the horizontal segment, has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2a6cfc1-3c5c-4310-b413-aa18b1795af8"],
 ", and both start at the front event."
}], "ExampleText",ExpressionUUID->"c9b1766e-e8c5-4725-8859-ade573346ccc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "6"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"3", "/", "20"}]}], ",", " ", 
         RowBox[{"length", " ", "=", " ", 
          RowBox[{"pq", " ", "|->", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
                
                RowBox[{"Tan", "[", "phi", "]"}]}], ")"}], "^", "2"}], " ", "-",
              " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                RowBox[{"pq", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "^", 
              "2"}]}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"lines", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"LengthContractionConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}], ",", " ", 
             
             RowBox[{"\"\<RodRestLength\>\"", " ", "->", " ", "len"}], ",", 
             " ", 
             RowBox[{"\"\<MeasureArcLength\>\"", " ", "->", " ", 
              RowBox[{"3", "/", "5"}]}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"pq", " ", ":", " ", 
              RowBox[{"{", 
               RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", " ", 
            "pq"}], ",", " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rod", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", " ", "@", " ", 
                 RowBox[{"Det", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], 
                    "}"}]}], "}"}], "]"}]}], "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"bar", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", " ", 
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"pq", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}], " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"rod", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
         RowBox[{"bar", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"length", "[", "rod", "]"}], " ", "==", " ", "len"}], ",",
             " ", 
            RowBox[{
             RowBox[{"length", "[", "bar", "]"}], " ", "==", " ", 
             RowBox[{"len", "/", 
              RowBox[{"LorentzGamma", "[", "v", "]"}]}]}]}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "True"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e529aea4-3ac6-4f13-9003-858dfbb3c506"],

