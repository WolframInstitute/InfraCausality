LengthContractionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7086a6d5-acbc-4aeb-96fe-205480884a45"],
 "\[LineSeparator]",
 "draws the radar measurement of a rod moving at velocity ",
 StyleBox["v", "TI"],
 " by the rest observer, illustrating the contracted length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c204a62-9586-4ace-879e-2b27e017dc95"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ac0bc866-0544-4e3f-b379-ac03b7af6ed8"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"63daf0e1-890b-439b-acd2-d44e3d3d2d1e"],

Cell[TextData[{
 "Definition: the rod's front end moves on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) and its back end on the parallel worldline (dashed) at the \
Minkowski distance ",
 Cell[BoxData["\"\<RodRestLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656045c1-3cc7-485b-bbec-81120e4e4c40"],
 " ",
 StyleBox["L", "TI"],
 " along Bob's line of simultaneity, the direction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe043eed-8348-49a6-a109-12c49dc69b82"],
 " of his line of simultaneity: the Euclidean offset is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dbd7364-b96e-438f-aa78-4e5ea26cb491"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d455bf6-1f72-4177-bb48-887aa5d70cac"],
 ". At the front event ",
 StyleBox["F", "TI"],
 " at arc length ",
 Cell[BoxData["\"\<MeasureArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a61c9fb-7705-40dc-8cf5-4c30c6262bef"],
 " the rod is drawn as a thick red segment from ",
 StyleBox["F", "TI"],
 " to its back end, of rest length ",
 StyleBox["L", "TI"],
 ". The rest observer (\"Alice\", blue) measures the rod at one radar time, \
the radar time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9972acea-ab4a-4be1-95fe-5e5ba26e52b6"],
 " of ",
 StyleBox["F", "TI"],
 ": the orange bar is her line of simultaneity through ",
 StyleBox["F", "TI"],
 " (horizontal) to the back end's worldline, and the four faded light rays \
are her radar rays to the two ends of the bar. In her radar coordinates the \
two worldlines are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc9e9948-0d15-4b03-9896-83ca418f2534"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"], "+", 
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a7a11e-a4d6-4c3e-a7f0-3e0f2f2c991b"],
 ", so the bar has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6edf97f8-c846-4ff8-9212-5e20fd303aeb"],
 ", which the label prints."
}], "Notes",ExpressionUUID->"88cc2845-23f7-4dbc-90e5-0875d8936dd2"],

