LengthContractionConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca0a18ac-0cd0-4dbc-bd7e-f5c21e491486"],
 "\[LineSeparator]",
 "draws the radar measurement of a rod moving at velocity ",
 StyleBox["v", "TI"],
 " by the rest observer, illustrating the contracted length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131f27c5-4903-4f6e-b925-fbdec3869387"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"81f6d96f-1005-4abb-85b7-8ee92da21a1e"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"9aa2a329-05bc-4f3b-8609-3ee96afff96e"],

Cell[TextData[{
 "Definition: the rod's front end moves on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) and its back end on the parallel worldline (dashed) at the \
Minkowski distance ",
 Cell[BoxData["\"\<RodRestLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1297e149-17f8-43ee-bbf3-1712af188582"],
 " ",
 StyleBox["L", "TI"],
 " along Bob's line of simultaneity, the direction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d4003c-e53a-48fc-b90c-d0ca70e8859b"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee0604a8-c153-4296-a99d-0f181504b8f0"],
 ": the Euclidean offset is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["L", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37238004-e84e-4de6-bad7-573a1f1d6b24"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8438c634-908d-448a-8b71-09e3e9d0a173"],
 ". At the front event ",
 StyleBox["F", "TI"],
 " at arc length ",
 Cell[BoxData["\"\<MeasureArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "074c7757-dcc7-4265-ac96-5653a1b4d0e6"],
 " the rod is drawn as a thick red segment from ",
 StyleBox["F", "TI"],
 " to its back end, of rest length ",
 StyleBox["L", "TI"],
 ". The rest observer (\"Alice\", blue) measures the rod at one radar time, \
the radar time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d186b3af-d5d5-4011-b218-68914becc425"],
 " of ",
 StyleBox["F", "TI"],
 ": the orange bar is her line of simultaneity through ",
 StyleBox["F", "TI"],
 " (horizontal) to the back end's worldline, and the four faded light rays \
are her radar rays to the two ends of the bar. In her radar coordinates the \
two worldlines are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1971199d-6894-48bb-bb71-d9222ee8cd61"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["T", "TI"], "+", 
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f323ab42-ca34-4180-bf41-12f575547771"],
 ", so the bar has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e95439e-2b4c-434c-8e3a-2c018aee3a9d"],
 ", which the label prints."
}], "Notes",ExpressionUUID->"cd6e71e2-9194-413c-abf6-1c857c9ca82d"],

