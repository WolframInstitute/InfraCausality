Cell[CellGroupData[{
Cell["WorldlineNormal", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a2149c4-1522-43e9-8c91-d6a60abff56d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineNormal"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "919aa68b-04bd-4798-aeab-f9c2f67b425d"],
 "\[LineSeparator]",
 "gives the unit normal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", 
    RowBox[{"-", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5596389-5cd1-432d-809b-f1a7ceec6f2e"],
 " to the worldline of velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "759cef27-0deb-4a6a-901d-514ab65232b3"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e8ffd56-6555-4e17-80c7-555ff1704da4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineNormal"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "018f7a92-7cd7-4379-a172-249de2be0754"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"91818ca7-2899-4b42-8cab-7563e2873260"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"e870b8d6-c1c7-42d1-82d0-6e446b9d4499"],

Cell[TextData[{
 "Definition: the Euclidean unit vector perpendicular to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineDirection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineDirection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c926e08-6c2b-4c2b-9edd-caf26fdd7cf2"],
 ", pointing to the right. The figures use it to place ticks and labels and \
the mirror of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightClockConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightClockConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6469853-cf12-469d-9602-0f1df3adbc78"],
 "."
}], "Notes",ExpressionUUID->"d9caf420-6054-4fde-b528-af8847633ad1"],

Cell[TextData[{
 "The Euclidean normal is a property of the drawing, not of the Minkowski \
plane: the observer's line of simultaneity is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cb5faa-80e6-4750-9b3e-ddc0491b4990"],
 ", along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ab6a9c1-76a4-471b-8266-e733addf220d"],
 ", and the two agree only at rest. A length at rest for the moving observer, \
such as the rod of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LengthContractionConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/\
LengthContractionConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9de77183-33d5-454e-8d12-1ea182494ff9"],
 ", is laid along the line of simultaneity, not along the normal."
}], "Notes",ExpressionUUID->"ba6d2eba-b9e9-4a57-8fc5-2962e7590547"]
}, Open  ]],

