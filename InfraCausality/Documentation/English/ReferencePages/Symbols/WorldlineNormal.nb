Cell["The normal is a unit vector perpendicular to the worldline.", \
"ExampleText",ExpressionUUID->"eb7008f4-2f2c-4006-b8d1-f8d9db642ac0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], " ", ".", " ", 
      RowBox[{"WorldlineDirection", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}]}], " ", "==", " ", "0"}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], " ", "==", " ", "1"}]}], 
   ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9134ec05-7f68-4c63-9334-2508add3f895"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f0a091cf-bc11-4efe-b8b2-374cae4b2a00"]
}, Open  ]],

Cell["It points along the line of simultaneity only at rest.", "ExampleText",ExpressionUUID->"ffdcbd5c-8438-4564-af70-74417fcb13eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", 
         RowBox[{"Pi", "/", "3"}], "]"}], ",", " ", "0"}], "}"}]}], "}"}], 
    "]"}], " ", "==", " ", "0"}], " ", "&&", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"WorldlineNormal", "[", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tan", "[", 
          RowBox[{"Pi", "/", "3"}], "]"}], ",", " ", 
         RowBox[{"3", "/", "5"}]}], "}"}]}], "}"}], "]"}], "]"}], " ", "!=", 
   " ", "0"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c34e33d5-d460-42ba-977d-c826b73cbba1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fcd6aefb-8f33-4c8a-ade3-947de905b2a7"]
}, Open  ]]
}, Open  ]],

