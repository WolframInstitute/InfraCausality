Cell["The normal is a unit vector perpendicular to the worldline.", \
"ExampleText",ExpressionUUID->"c5469e7b-25c3-4564-943e-d80899549cd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], " ", ".", " ", 
      RowBox[{"WorldlineDirection", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}]}], " ", "==", " ", "0"}], " ", "&&",
     " ", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], " ", "==", " ", "1"}]}], 
   ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3344c8bb-11dc-43b9-9b0d-8dc0e625daa3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a8bf3fb1-9b44-4125-b1e9-48fb72fd9a05"]
}, Open  ]],

Cell["It points along the line of simultaneity only at rest.", "ExampleText",ExpressionUUID->"4f05df42-2d0b-4b73-8401-3c749ed3ec15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"WorldlineNormal", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", 
         RowBox[{"Pi", "/", "3"}], "]"}], ",", " ", "0"}], "}"}]}], "}"}], 
    "]"}], " ", "==", " ", "0"}], " ", "&&", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"WorldlineNormal", "[", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tan", "[", 
          RowBox[{"Pi", "/", "3"}], "]"}], ",", " ", 
         RowBox[{"3", "/", "5"}]}], "}"}]}], "}"}], "]"}], "]"}], " ", "!=", 
   " ", "0"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"deda5261-f835-4695-92e6-59674807e03d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1391ea31-cba9-4ec0-b892-fa3424944f5a"]
}, Open  ]]
}, Open  ]],

