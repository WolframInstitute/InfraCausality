Cell[CellGroupData[{
Cell["WorldlineNormal", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a96337d-be67-441b-b912-bd4e0d6e04cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineNormal"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a830fc60-e982-4600-956d-0e6aa05a1d34"],
 "\[LineSeparator]",
 "gives the unit normal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", 
    RowBox[{"-", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b07723b1-738f-4b59-8132-b569d13bf4b6"],
 " to the worldline of velocity ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["\[Alpha]", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineAngle"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfa71884-a559-4be1-bcdf-a1bca40206e8"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ca202ff-2945-44e0-ad69-b3e1f9f3858c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineNormal"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineNormal", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a090da6d-5150-4675-b645-40dc0ca49c88"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4."
}], "Usage",ExpressionUUID->"9e182187-8c02-4419-b574-1b79c7f087a2"],

Cell["\<\
Experimental: drawing helper. The helpers behind the Bondi figures may change.\
\>", "Notes",ExpressionUUID->"43971cf4-488b-4167-aafd-b23f1fef915a"],

Cell[TextData[{
 "Definition: the Euclidean unit vector perpendicular to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WorldlineDirection"]], 
     "paclet:WolframInstitute/InfraCausality/ref/WorldlineDirection", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7498a12e-c328-46d7-a70d-42ad51b6a1c2"],
 ", pointing to the right. The figures use it to place ticks and labels, the \
mirror of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightClockConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightClockConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6558ac08-7b9d-407a-9f4f-4359186fddb3"],
 " and the rod of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LengthContractionConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/\
LengthContractionConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "826d2f15-49af-4bd6-b50d-ab9b472503f6"],
 "."
}], "Notes",ExpressionUUID->"eb8e0c61-5468-4f91-8978-11f3dec10ba6"],

Cell[TextData[{
 "The Euclidean normal is a property of the drawing, not of the Minkowski \
plane: the observer's line of simultaneity is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cadcd997-8c29-43d8-a2f6-0f1a2e39ceca"],
 ", along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2404b834-7437-4395-9ec7-1f07d08191cb"],
 ", and the two agree only at rest."
}], "Notes",ExpressionUUID->"c9951973-d7dd-41c2-811e-1dc07fa1c3f5"]
}, Open  ]],

