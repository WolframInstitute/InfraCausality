Cell["The rapidity of the k-factor 2.", "ExampleText",ExpressionUUID->"a8c689b7-9c32-4403-97c4-6dba08dd636a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RapidityFromK", "[", "2", "]"}]], "Input",
