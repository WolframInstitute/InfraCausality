Notebook[{

Cell[CellGroupData[{
Cell["RapidityFromK", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d7791e6e-824f-4d4d-87c1-f22c49d7a398"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RapidityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3f546e-13ca-4acb-a927-74bd43a787dc"],
 "\[LineSeparator]",
 "gives the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "207d34c3-b17e-4a7a-a46e-f8e95297897f"],
 " of the Bondi factor ",
 StyleBox["k", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5462c75f-11cc-4480-8eba-1c054e8df1fd"],

Cell[TextData[{
 "Definition: the rapidity of the velocity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1c9eecd-a8ef-44da-a36b-f9cffc452f4f"],
 ", which is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0403d22-48cb-4c8a-999f-7f9ecd00ec14"],
 ". The logarithm turns the multiplication of k-factors under velocity \
addition into the addition of rapidities."
}], "Notes",ExpressionUUID->"9cd7622e-51b7-43f2-b28c-2802478d1c4f"],

Cell[TextData[{
 "It also counts bounces: the emission arc lengths of a light zigzag between \
the observer at rest and the observer with k-factor ",
 StyleBox["k", "TI"],
 " grow by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8224948d-5d1b-4402-a971-1663ffe277fd"],
 " per round trip (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc21d254-2198-464f-abb0-5364f590db63"],
 "), so from the arc length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99c3c31c-5063-42c5-af64-7536c10f9cd8"],
 " the zigzag needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7eb92ea-408b-47fc-901d-47e7be1b0950"],
 " round trips to reach the arc length ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"4a630db7-42e8-458e-8200-c69c6494997d"]
}, Open  ]],

