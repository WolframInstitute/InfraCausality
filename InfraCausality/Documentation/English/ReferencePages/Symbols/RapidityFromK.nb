 RowBox[{"Log", "[", "2", "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3abbbc7b-71fb-4d3a-86d7-aae0788287ea"]
}, Open  ]],

Cell["\<\
The number of round trips of a light zigzag from arc length 1 to arc length \
64 between the observers with k-factor 2.\
\>", "ExampleText",ExpressionUUID->"079a39ad-d081-4b11-b520-596c6a4f8193"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Log", "[", "64", "]"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", 
     RowBox[{"RapidityFromK", "[", "2", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0f355a71-c783-40f1-8f4e-04d8333fef57"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"24e31538-dd91-46b7-894b-0f58e0df637d"]
}, Open  ]]
}, Open  ]],

