Cell["Rapidities add when k-factors multiply.", "ExampleText",ExpressionUUID->"a60e08ef-42a8-4ea8-92a4-235fe430c6f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RapidityFromK", "[", 
     RowBox[{"k1", " ", "k2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"RapidityFromK", "[", "k1", "]"}], " ", "+", " ", 
     RowBox[{"RapidityFromK", "[", "k2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"00419b7a-3ded-4673-b474-b267b2c12372"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"edf5b1ed-89c5-489e-ba84-aa7f69542463"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["RapidityFromK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e05c9592-a062-4581-aa0e-423732e27c40"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f699214d-9e52-45d6-8ab9-35ac6462a34b"],
 " of the velocity of the k-factor."
}], "ExampleText",ExpressionUUID->"07611936-7eae-4fad-be3a-3f7b78835ae1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
     RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", 
    RowBox[{"RapidityFromK", "[", "k", "]"}]}], ",", " ", 
   RowBox[{"k", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"87222152-ae25-4a9d-8b16-bfd4db617d08"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d8fdb577-a28b-4db5-a723-788d0a58f09c"]
}, Open  ]],

Cell[TextData[{
 "The round trips of the zigzag of velocity 3/5 from arc length 1 reach the \
arc lengths ",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bafeb6c7-4421-49c9-b245-f258758ee3da"],
 ", so their count is a logarithm of the arc length."
}], "ExampleText",ExpressionUUID->"2c8d7353-4d40-48b2-b4f9-22a6bb35dd42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"LightZigzag", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
           " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
       " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Log", "[", "arcs", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"RapidityFromK", "[", 
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "]"}]}], ")"}]}], "]"}], " ", "==", 
    " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d870b01d-58cc-4d3b-a0fa-26d5789180cd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e9926259-eaed-4a97-acd4-ec10d8d9eaef"]
}, Open  ]]
}, Open  ]],

