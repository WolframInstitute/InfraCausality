Cell["The rapidity of the k-factor 2.", "ExampleText",ExpressionUUID->"219c62e2-f56e-48b5-9c9c-eb490e7d5e6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RapidityFromK", "[", "2", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67ad5f7b-be96-4c86-979c-376689ca66ca"],

