 CellLabel->"Out[1]= ",ExpressionUUID->"ce51a6ea-6501-4c9e-9a87-161ad5f703e0"]
}, Open  ]],

Cell["\<\
The number of round trips of a light zigzag from arc length 1 to arc length \
64 between the observers with k-factor 2.\
\>", "ExampleText",ExpressionUUID->"364a0ed1-7978-4212-87fa-15f6224ddb5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Log", "[", "64", "]"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", 
     RowBox[{"RapidityFromK", "[", "2", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d3dc6176-bb7c-4830-b391-3271c5a0ccd9"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0a878e25-a5c6-4afd-88ff-0bc4c9508ad9"]
}, Open  ]]
}, Open  ]],

