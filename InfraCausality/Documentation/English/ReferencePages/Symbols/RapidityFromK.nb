Cell["Rapidities add when k-factors multiply.", "ExampleText",ExpressionUUID->"6110f183-4f2e-423b-a62f-55d314202670"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RapidityFromK", "[", 
     RowBox[{"k1", " ", "k2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"RapidityFromK", "[", "k1", "]"}], " ", "+", " ", 
     RowBox[{"RapidityFromK", "[", "k2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ebf5b954-c607-4a6a-94f3-f67d4e5cf8fd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4673e1b0-f251-491e-ba0e-669132658cd4"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["RapidityFromK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d34bc2b-dcb3-410d-8c3e-8c8e8e8669cb"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1568d1e-a37a-41da-8f8e-1b89f7ac05e4"],
 " of the velocity of the k-factor."
}], "ExampleText",ExpressionUUID->"7d66da4c-8769-4d3c-b832-c28d2a6bd0cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
     RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", 
    RowBox[{"RapidityFromK", "[", "k", "]"}]}], ",", " ", 
   RowBox[{"k", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4c6b52d9-7d56-4b6c-9e69-dcd09859260d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4945e786-e976-4d4a-9e1b-4a032903b5c3"]
}, Open  ]],

Cell[TextData[{
 "The round trips of the zigzag of velocity 3/5 from arc length 1 reach the \
arc lengths ",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98cdc340-1dfb-42ff-8a80-250683868eb6"],
 ", so their count is a logarithm of the arc length."
}], "ExampleText",ExpressionUUID->"56c9679d-5134-4e9a-91cb-47013cc67bcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"LightZigzag", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
           " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
       " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Log", "[", "arcs", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"RapidityFromK", "[", 
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "]"}]}], ")"}]}], "]"}], " ", "==", 
    " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4e499a0e-b968-4918-a3de-b94748c03e18"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"69799bf3-dda2-4dd7-8000-2a6d282074a0"]
}, Open  ]]
}, Open  ]],

