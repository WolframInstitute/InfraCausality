 RowBox[{"Log", "[", "2", "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"be863b1b-46cb-42c1-8adf-3a1ae60d5789"]
}, Open  ]],

Cell["\<\
The number of round trips of a light zigzag from arc length 1 to arc length \
64 between the observers with k-factor 2.\
\>", "ExampleText",ExpressionUUID->"eecc7d40-6d02-4622-b6bb-330de726f8bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Log", "[", "64", "]"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", 
     RowBox[{"RapidityFromK", "[", "2", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e98ba715-137a-4907-abc7-5a0a8b80e293"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d60e76ae-f288-4c81-9e0c-4051e42b7005"]
}, Open  ]]
}, Open  ]],

