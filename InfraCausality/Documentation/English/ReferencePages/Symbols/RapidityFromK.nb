Cell["Rapidities add when k-factors multiply.", "ExampleText",ExpressionUUID->"abeaf8c7-1d8d-4f8c-bba3-c625bad1461e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RapidityFromK", "[", 
     RowBox[{"k1", " ", "k2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"RapidityFromK", "[", "k1", "]"}], " ", "+", " ", 
     RowBox[{"RapidityFromK", "[", "k2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d01a93d-005c-47e3-8579-753b67f78f27"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6fd33813-ab40-4080-93e2-8222211ee7f6"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["RapidityFromK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be09d3ec-be88-4483-be9b-8a088c31a25b"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62b937c5-5847-4932-b28a-843c8bd227c5"],
 " of the velocity of the k-factor."
}], "ExampleText",ExpressionUUID->"db5ce580-687d-49c0-bb89-ce8c8e583a1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
     RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", 
    RowBox[{"RapidityFromK", "[", "k", "]"}]}], ",", " ", 
   RowBox[{"k", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3804ace9-490a-4b12-8721-abd6facd6b80"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"bd6d76d8-ee6f-45f2-beeb-a0308474a4ff"]
}, Open  ]],

Cell[TextData[{
 "The round trips of the zigzag of velocity 3/5 from arc length 1 reach the \
arc lengths ",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a18942c-efa1-4347-b301-14237a3f3400"],
 ", so their count is a logarithm of the arc length."
}], "ExampleText",ExpressionUUID->"7c4b675b-03bd-4336-a698-25c4b8f505e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"LightZigzag", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
           " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
       " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Log", "[", "arcs", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"RapidityFromK", "[", 
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "]"}]}], ")"}]}], "]"}], " ", "==", 
    " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4427eda9-2dc7-45c6-8ea6-b7516e771d9a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7b14294a-6f62-418d-8c8f-1c014dfd4b22"]
}, Open  ]]
}, Open  ]],

