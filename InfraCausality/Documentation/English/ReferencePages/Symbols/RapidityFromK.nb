 CellLabel->"Out[1]= ",ExpressionUUID->"96461285-abc2-4d12-b504-3b073d3139e1"]
}, Open  ]],

Cell["\<\
The number of round trips of a light zigzag from arc length 1 to arc length \
64 between the observers with k-factor 2.\
\>", "ExampleText",ExpressionUUID->"82b7de1a-8cf7-4689-a190-13a4a530d702"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Log", "[", "64", "]"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", 
     RowBox[{"RapidityFromK", "[", "2", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2db5f990-fe7e-4b67-8e25-a0d03a3e5877"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9b14bad2-4727-417c-b296-cbcd45d11792"]
}, Open  ]]
}, Open  ]],

