Cell["The rapidity of the k-factor 2.", "ExampleText",ExpressionUUID->"14646baf-bed9-4ad5-88dc-3baaa52d85ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RapidityFromK", "[", "2", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"caacdfd6-99b7-496a-9fff-397126ba7eb0"],

