Notebook[{

Cell[CellGroupData[{
Cell["RapidityFromK", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01bc3448-418d-4182-8bdb-e88b175900fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RapidityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9132780d-7398-45f6-81c4-922c14fa26a9"],
 "\[LineSeparator]",
 "gives the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df0baf9c-ef71-434a-b89a-a95c66667070"],
 " of the Bondi factor ",
 StyleBox["k", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5971fcc4-480b-4f13-8e2a-af9ae1d31f9c"],

Cell[TextData[{
 "Definition: the rapidity of the velocity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbaaa0e1-1ac7-4519-9d02-7a16deaa466a"],
 ", which is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c093268b-159e-4412-9ecd-6706f98f63cf"],
 ". The logarithm turns the multiplication of k-factors under velocity \
addition into the addition of rapidities."
}], "Notes",ExpressionUUID->"7a141ce3-6581-4d26-91cf-024130558e8f"],

Cell[TextData[{
 "It also counts bounces: the emission arc lengths of a light zigzag between \
the observer at rest and the observer with k-factor ",
 StyleBox["k", "TI"],
 " grow by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267f52e8-1685-4f77-aade-a45f4ff4121c"],
 " per round trip (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "425ceca4-4105-482a-959b-25c0934f75f3"],
 "), so from the arc length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf618d38-80ef-48bc-a260-5840414356e0"],
 " the zigzag needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "648ac8fd-6d99-4242-80f6-b411bce0f6c4"],
 " round trips to reach the arc length ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"aa83acfc-a9e7-48df-9eab-ad7b43e74b67"]
}, Open  ]],

