Notebook[{

Cell[CellGroupData[{
Cell["RapidityFromK", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ef2a402-9d16-4dca-a317-97bb1d03aa9a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RapidityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17fd852e-1a8a-4edf-b738-3da959f4d1b8"],
 "\[LineSeparator]",
 "gives the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92228594-821d-4eec-a7ab-98d34d8df644"],
 " of the Bondi factor ",
 StyleBox["k", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d35252ac-c19e-4e9c-acda-fc3816842a3c"],

Cell[TextData[{
 "Definition: the rapidity of the velocity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8c7ad18-7d6c-44c8-809e-944db25d6c51"],
 ", which is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebeddfb7-e5cd-4eac-93dd-67ca79087a64"],
 ". The logarithm turns the multiplication of k-factors under velocity \
addition into the addition of rapidities."
}], "Notes",ExpressionUUID->"4338105e-fdd6-4bc3-9173-056a77aec4b4"],

Cell[TextData[{
 "It also counts bounces: the emission arc lengths of a light zigzag between \
the observer at rest and the observer with k-factor ",
 StyleBox["k", "TI"],
 " grow by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f38d9cc-2c59-4182-b510-6a5a1cecdc01"],
 " per round trip (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4e4c3de-3dcb-4e7c-b67d-d214018c4f5c"],
 "), so from the arc length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d1ecff0-0fe2-4839-b067-06a1ca28c881"],
 " the zigzag needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24c6500d-8ee9-47c3-9e5d-b0c48ce10fda"],
 " round trips to reach the arc length ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"2b7f976f-9a20-4013-9dc8-38643333b170"]
}, Open  ]],

