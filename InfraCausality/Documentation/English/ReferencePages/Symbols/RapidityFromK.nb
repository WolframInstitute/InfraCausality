Notebook[{

Cell[CellGroupData[{
Cell["RapidityFromK", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a1bd79c-8819-4750-8a25-c9b8772862ee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RapidityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70dd891e-a388-4a19-9f47-98eb80db73dc"],
 "\[LineSeparator]",
 "gives the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c2b18d2-1956-469b-8f33-251711f0259b"],
 " of the Bondi factor ",
 StyleBox["k", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7c62f54a-c6e9-4a72-b92f-3beda1961be4"],

Cell[TextData[{
 "Definition: the rapidity of the velocity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e70ce5d-78da-4fff-8598-185007ccb8a0"],
 ", which is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574adcd8-6ac6-405b-899f-b41878e47efe"],
 ". The logarithm turns the multiplication of k-factors under velocity \
addition into the addition of rapidities."
}], "Notes",ExpressionUUID->"303f8d08-811e-496b-8770-96bcf85bbae5"],

Cell[TextData[{
 "It also counts bounces: the emission arc lengths of a light zigzag between \
the observer at rest and the observer with k-factor ",
 StyleBox["k", "TI"],
 " grow by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae92a907-d8af-43ce-ae29-9e307b3f6545"],
 " per round trip (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b7116d8-81d7-4d2c-9b7d-a3f173368e38"],
 "), so from the arc length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44f32ef7-de71-4866-a56d-0fca0d76ce92"],
 " the zigzag needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "/", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60045040-b57f-4668-abf8-2b0f1b0a98d4"],
 " round trips to reach the arc length ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"01708c67-7a7a-46f4-a57b-38b4253f4b5a"]
}, Open  ]],

