Cell["Rapidities add when k-factors multiply.", "ExampleText",ExpressionUUID->"9c5834de-b7bc-4239-9ea3-79525d9dbc98"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RapidityFromK", "[", 
     RowBox[{"k1", " ", "k2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"RapidityFromK", "[", "k1", "]"}], " ", "+", " ", 
     RowBox[{"RapidityFromK", "[", "k2", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e125883-2d12-4e92-8121-eeba32f57d80"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eeffbef4-957f-4035-a804-ea7c58451b58"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["RapidityFromK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d60aaf4-37b5-42af-8dec-4c896bc1ed36"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "332b13ee-fce5-4821-8f1b-abfdf9148c5c"],
 " of the velocity of the k-factor."
}], "ExampleText",ExpressionUUID->"4c457605-3b46-401b-9091-fe0f5ca5a78b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rapidity", "[", 
     RowBox[{"VelocityFromK", "[", "k", "]"}], "]"}], " ", "==", " ", 
    RowBox[{"RapidityFromK", "[", "k", "]"}]}], ",", " ", 
   RowBox[{"k", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cdabe793-695f-4aab-b583-907ba130aec9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"90b96b8d-f7f7-4e75-afca-57599c8c26f1"]
}, Open  ]],

Cell[TextData[{
 "The round trips of the zigzag of velocity 3/5 from arc length 1 reach the \
arc lengths ",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf54ad35-77f7-4214-a664-eec45229ded4"],
 ", so their count is a logarithm of the arc length."
}], "ExampleText",ExpressionUUID->"e12ca97c-7d8f-45ad-aa61-a2e17e7be426"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"LightZigzag", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
           " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
       " ", "\"\<ArcLength\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Log", "[", "arcs", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"RapidityFromK", "[", 
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "]"}]}], ")"}]}], "]"}], " ", "==", 
    " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8e6c616f-3e15-4802-b5e3-721faa8d0880"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a3602a46-dfb9-4897-ae03-70688bae1ad7"]
}, Open  ]]
}, Open  ]],

