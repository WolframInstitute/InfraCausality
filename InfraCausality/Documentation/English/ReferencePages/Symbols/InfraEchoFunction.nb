Cell["The number of echo functions for the same observers.", "ExampleText",ExpressionUUID->"4dd0b8e3-383b-4727-b676-fe26d3d2f6ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraEchoFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7416db5d-5f81-4a1b-807a-101b87065647"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"168", ",", "3", ",", "9"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9a726fbc-0aa4-4b70-ae69-a8c8616b6da3"]
