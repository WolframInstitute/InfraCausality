    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"KeySort", " ", "/@", " ", 
      RowBox[{"DeleteDuplicates", " ", "@", " ", 
       RowBox[{"Catenate", " ", "@", " ", 
