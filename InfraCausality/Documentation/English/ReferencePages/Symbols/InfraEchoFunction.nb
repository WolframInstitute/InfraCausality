Cell[TextData[{
 "The echoes of an observer ",
 StyleBox["a", "TI"],
 " (blue) via an observer ",
 StyleBox["b", "TI"],
 " (red), drawn as the outgoing and returning light rays (orange). The \
observer ",
 StyleBox["a", "TI"],
 " is a random longest chain of the substrate and ",
 StyleBox["b", "TI"],
 " a random longest chain of the rest of it. On the diamond lattice, a \
sprinkling into two-dimensional Minkowski space and the cylinder lattice:"
}], "ExampleText",ExpressionUUID->"9f6ac97f-9bbc-4297-9038-cd2c8ae5668f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c88517f6-4cc1-43fd-a047-01994a164caa"],

