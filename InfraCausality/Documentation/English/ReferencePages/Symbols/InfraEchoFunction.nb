Cell[TextData[{
 "The Lorentz check on the lattice: the resting chain echoed by the chain {(2",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} of velocity 1/3 reads the Bondi factor \[Sqrt]2, by {(3",
 StyleBox["m", "TI"],
 ", 2",
 StyleBox["m", "TI"],
 ")} of velocity 1/5 the factor \[Sqrt](3/2)."
}], "ExampleText",ExpressionUUID->"c31e8a63-8338-499a-a2f6-42c228c87867"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p", " ", "+", " ", "1"}], ")"}], " ", "m"}], ",", 
              " ", 
              RowBox[{"p", " ", "m"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"m", ",", " ", "1", ",", " ", 
              RowBox[{"Floor", "[", 
               RowBox[{"6", "/", 
                RowBox[{"(", 
                 RowBox[{"p", " ", "+", " ", "1"}], ")"}]}], "]"}]}], "}"}]}],
            "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}]}]}], 
        "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
           " ", "\"\<KFactor\>\""}], "]"}], ",", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", "v"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "v"}], ")"}]}], "]"}]}], "}"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"949ea9f1-27cb-4c5f-92b0-f0e33307dc94"],

Cell[BoxData[
 RowBox[{"{", 
