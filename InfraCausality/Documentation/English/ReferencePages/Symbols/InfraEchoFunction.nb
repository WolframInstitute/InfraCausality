 "Every echo of a tick lies strictly after the tick on ",
 StyleBox["a", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"bfbe3ad8-cc56-493d-8f79-5d272243e89b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"VertexDelete", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Normal", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraEchoFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Relation\>\""}], "]"}]}], ",", " ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "echoes"}], "}"}], " ", "|->", "\n", 
         "      ", 
         RowBox[{"AllTrue", "[", 
