Cell["Defects and the k-factor", "ExampleSubsection",ExpressionUUID->"36b36571-2953-463d-9e0b-d4caeda39598"],

Cell[TextData[{
 "The lattice observers at rest, {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} and {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 2)}, echo each other tick for tick: the four echo defects vanish on the \
interior window and the k-factor is 1."
}], "ExampleText",ExpressionUUID->"f08e5669-dfaf-46a7-a200-1810981c1696"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"m", " ", "+", " ", "2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraEchoFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "p", ",", " ", 
       RowBox[{"\"\<Margin\>\"", " ", "->", " ", "2"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<DomainDefect\>\"", ",", " ", "\"\<FunctionDefect\>\"", ",",
          " ", "\"\<InjectivityDefect\>\"", ",", " ", "\"\<OrderDefect\>\"", ",",
          " ", "\"\<KFactor\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"9523932d-443e-4563-9e00-d7b0b57aeafa"],

