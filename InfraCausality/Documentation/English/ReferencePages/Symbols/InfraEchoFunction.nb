        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "2"}], "}"}]}], ")"}], " ", "&"}], " ", "/@",
         " ", "a"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], " ", "<=", " ", "6"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"there", " ", "=", " ", 
