               RowBox[{"a", ",", " ", "u"}], "]"}], "]"}], " ", ">", " ", 
             RowBox[{"First", "[", 
              RowBox[{"FirstPosition", "[", 
               RowBox[{"a", ",", " ", "v"}], "]"}], "]"}]}]}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
