Cell[TextData[{
 "The cardinality is the number of members, every member passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8910fe34-e9e1-469e-ba93-f54a334625eb"],
 ", and there are at most as many members as pairs of message functions."
}], "ExampleText",ExpressionUUID->"2ca0d7cc-f975-4370-ba46-2fd49e0aa9f5"],

