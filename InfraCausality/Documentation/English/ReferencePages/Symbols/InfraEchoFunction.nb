     FontWeight->Bold,ExpressionUUID->"a115c179-0d7a-4fb4-b142-2382f072ba8d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "82c52ea6-615c-4bd7-8b73-92d4645654ef"], Cell[
    "Minkowski space", "TableText",ExpressionUUID->
     "1db582e1-488b-4915-9adf-1a6915153eb0"], Cell[
    "Radar echo", "TableText",ExpressionUUID->
     "e31d8ea9-e281-4a37-a7aa-66f0462a0c05"], Cell[TextData[{
     "A light signal sent from an observer at time ",
     StyleBox["t", "TI"],
     "1, reflected at an event, returns at time ",
     StyleBox["t", "TI"],
     "2; the event has radar time (",
     StyleBox["t", "TI"],
     "1 + ",
     StyleBox["t", "TI"],
     "2)/2 and radar distance (",
     StyleBox["t", "TI"],
     "2 \[Minus] ",
     StyleBox["t", "TI"],
     "1)/2."
    }], "TableText",ExpressionUUID->"73552f2a-b49a-4cd8-892d-02741ada6e85"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "df0f7832-0835-4b78-b696-0a678d502b5e"], Cell[
    "EPS", "TableText",ExpressionUUID->
     "1ae5f766-dbb2-431d-9e55-44c6e59f1da6"], Cell[
    "Echo", "TableText",ExpressionUUID->
     "44539647-19b8-48d7-94cb-99739fb71172"], Cell[TextData[{
     "The composition of the message from a particle ",
     StyleBox["P", "TI"],
     " to a particle ",
     StyleBox["Q", "TI"],
     " with the message from ",
     StyleBox["Q", "TI"],
     " back to ",
     StyleBox["P", "TI"],
     ", a map of ",
     StyleBox["P", "TI"],
     " to itself that increases its clock."
    }], "TableText",ExpressionUUID->"5bc1d79e-fbda-4a67-9168-20947dfbe2ee"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e1593a74-fe06-4255-83aa-\
e23509455851"]
}, Open  ]],

