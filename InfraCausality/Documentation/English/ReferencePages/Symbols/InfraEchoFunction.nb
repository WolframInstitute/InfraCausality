Cell["\<\
Every member is the composite of two members of the message heads, and every \
such composite is a member.\
\>", "ExampleText",ExpressionUUID->"a570e76d-7848-4b18-9c5f-3d1f1435cdee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "i"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "i"}], "}"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "2"}], "}"}]}], ")"}], " ", "&"}], " ", "/@",
         " ", "a"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], " ", "<=", " ", "6"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"there", " ", "=", " ", 
      RowBox[{"RandomInfraMessageFunction", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}]}], ",",
      " ", 
     RowBox[{"back", " ", "=", " ", 
      RowBox[{"RandomInfraMessageFunction", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"KeySort", " ", "/@", " ", 
      RowBox[{"DeleteDuplicates", " ", "@", " ", 
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
           RowBox[{"DeleteMissing", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
              " ", "s"}], "]"}]}], ",", " ", "there", ",", " ", "back", ",", 
          " ", "1"}], "]"}]}]}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", "[", 
     RowBox[{"KeySort", " ", "/@", " ", 
      RowBox[{"RandomInfraEchoFunction", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraEchoFunction", "[", 
         RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
