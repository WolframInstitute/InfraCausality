     "d4878806-1a61-46e8-87f4-a63341d9d27c"], Cell[
    "Minkowski space", "TableText",ExpressionUUID->
     "04f58ce3-0669-4006-adf5-1af9a7f7d762"], Cell[
    "Radar echo", "TableText",ExpressionUUID->
     "d8561d6f-85f1-4619-9b3e-7609de3b7ab3"], Cell[TextData[{
     "A light signal sent from an observer at time ",
     StyleBox["t", "TI"],
     "1, reflected at an event, returns at time ",
     StyleBox["t", "TI"],
     "2; the event has radar time (",
     StyleBox["t", "TI"],
     "1 + ",
     StyleBox["t", "TI"],
     "2)/2 and radar distance (",
     StyleBox["t", "TI"],
     "2 \[Minus] ",
     StyleBox["t", "TI"],
     "1)/2."
    }], "TableText",ExpressionUUID->"bd5283a0-2ca8-4f4c-81b8-0cfdf6194ff1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8fa75122-6203-4077-90ce-922c3d4c409d"], Cell[
    "EPS", "TableText",ExpressionUUID->
     "bf3d7cec-bf6c-4ef5-94cd-2482e321de26"], Cell[
    "Echo", "TableText",ExpressionUUID->
     "d6aaad5d-f7e1-4dc3-ab7c-2f2b0c910403"], Cell[TextData[{
     "The composition of the message from a particle ",
     StyleBox["P", "TI"],
     " to a particle ",
     StyleBox["Q", "TI"],
     " with the message from ",
     StyleBox["Q", "TI"],
     " back to ",
     StyleBox["P", "TI"],
     ", a map of ",
     StyleBox["P", "TI"],
     " to itself that increases its clock."
    }], "TableText",ExpressionUUID->"c212a0ba-618a-45f0-a441-e10951a077cb"]}
  }]], "3ColumnTableMod",ExpressionUUID->"0146351d-7cc5-44c2-8460-\
218e673e7203"]
}, Open  ]],

