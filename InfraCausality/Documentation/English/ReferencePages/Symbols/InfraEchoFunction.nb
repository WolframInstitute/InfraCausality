Cell[TextData[{
 "On the diamond lattice a light signal can travel only along the two null \
directions, so two parallel null lines exchange no echo: the signal from {0, ",
 StyleBox["j", "TI"],
 "} reaches {2, ",
 StyleBox["j", "TI"],
 "}, but nothing returns."
}], "ExampleText",ExpressionUUID->"4fbf9bd0-b5a7-4785-b642-9e5e55d2bcf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "j"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "j"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Union", " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraEchoFunction", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Relation\>\""}], 
      "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"e74f2663-7225-4d63-bc71-371a321ee827"],

