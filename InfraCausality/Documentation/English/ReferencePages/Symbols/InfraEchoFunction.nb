Cell[TextData[{
 "An order-preserving map with admissible images need not be an echo \
function. This one sends no signal from {3, 5} back but returns the later \
tick {4, 5} to {5, 6}, which forces the message from {3, 5} to the later \
image {6, 5} and the message from {4, 5} to the earlier {5, 5}; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "955ecd2b-f85e-4315-a5a8-9eb45a6969e6"],
 " rejects it without enumerating the members."
}], "ExampleText",ExpressionUUID->"ccdfe14d-2f94-4cc9-bd0e-75652bbbcffd"],

