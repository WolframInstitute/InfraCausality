                RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
            "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"now", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
