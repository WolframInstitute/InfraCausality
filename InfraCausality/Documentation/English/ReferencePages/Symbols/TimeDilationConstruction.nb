        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"First", "[", "now", "]"}], " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"b", "[", 
