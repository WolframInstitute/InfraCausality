Cell[CellGroupData[{
Cell["TimeDilationConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a43fa68-4ef3-4e0e-8d16-6a9d4ec727aa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TimeDilationConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd3c18b4-3843-4471-81de-a3e3a6c9e867"],
 "\[LineSeparator]",
 "draws the radar construction of one event on the worldline of velocity ",
 StyleBox["v", "TI"],
 ", illustrating the time dilation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be363326-9e82-423f-94d0-850ea6f01338"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"db9b78ba-30cb-4c3d-9699-85f425eaaea2"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"0cb845bc-b4c6-4279-b46e-36beb8ff0732"],

Cell[TextData[{
 "Definition: the event ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a6d54d1-b5b0-4c37-be4f-11e0902a6a1e"],
 " at arc length ",
 Cell[BoxData["\"\<EventArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8019904-45e1-49b0-95b0-2b99e65b92f8"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) is radar-located by the rest observer (\"Alice\", blue): \
she sends light at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"e", "m", "i", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ac5d200-8220-4226-8477-f49e78d39b03"],
 ", it reaches ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e075a58-80c3-441f-997c-a2984249d7b2"],
 " and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4134ff7e-2b1d-4e13-972c-28d4c4a66432"],
 ", and her radar time of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5f73f67-1568-40f7-a65a-adcf71eb87e3"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"e", "m", "i", "t"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3cde204-eced-4ca0-a596-c3ec934ad54c"],
 ". The dashed orange line is Alice's line of simultaneity (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33ea632f-786e-40f0-b5ff-f7fe6115ed40"],
 ") from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6e4d719-4149-419d-9ff4-aa3e3a75e3f0"],
 " through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c73e989e-6a39-4f93-8ba7-884b68f76c13"],
 ". Bob's own clock reads ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3652e0-efc5-4999-9daf-d91ec5bcad30"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "364d4df7-96d0-4b61-9461-0c741797333a"],
 " times the arc length at ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f1a3ba9-fabc-4e10-890a-e48c04f6bcf0"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["B", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae105e0-6873-4416-a1d1-71f9a86a3bca"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "751442c9-bff7-4778-936a-074f5102345e"],
 ", printed in the corner."
}], "Notes",ExpressionUUID->"176036da-95f9-429a-8748-c1a03e2f0764"],

Cell[TextData[{
 "Both worldlines carry proper-time ticks at equal steps; by default the step \
is a quarter of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58860318-30a0-47b6-955d-a7509be69ed7"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19e65424-09b4-4f5c-86ae-9fd92c18ef21"],
 " is Bob's fourth tick, and Alice's ticks run \[Gamma] times as many steps \
to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73732e48-95be-45bf-94b6-6b0027b178dd"],
 ". The worldlines are drawn past ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761e53f2-12b9-4451-93d4-2c23a3e91fef"],
 " and past the return, and every tick lies on them."
}], "Notes",ExpressionUUID->"de22b5d0-4cb2-4255-8e66-98e1fcc356f8"],

