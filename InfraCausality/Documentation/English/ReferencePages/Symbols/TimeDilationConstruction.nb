Cell[CellGroupData[{
Cell["TimeDilationConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc3af513-de8a-4378-bee1-debe2990cf08"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TimeDilationConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db00a72a-15fc-46fe-95d9-5505230d61e5"],
 "\[LineSeparator]",
 "draws the radar construction of one event on the worldline of velocity ",
 StyleBox["v", "TI"],
 ", illustrating the time dilation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "458aebc9-4e35-40ed-8e81-7156bfe0c037"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"57ae38c1-5a95-4370-b12a-bdfce8aa3ff1"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"7c3cfdd1-bb0b-40a8-8912-fe741e8c81f5"],

Cell[TextData[{
 "Definition: the event ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "158d36e5-0b9d-4102-8fc9-46047e3fe1e7"],
 " at arc length ",
 Cell[BoxData["\"\<EventArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78005b36-6243-40e4-9d86-a0f13c76ed46"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) is radar-located by the rest observer (\"Alice\", blue): \
she sends light at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"e", "m", "i", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a790849-e85d-43b1-ad73-e5172858f953"],
 ", it reaches ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b705333f-9868-476a-9d14-a69b5a4b4c10"],
 " and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b42a0033-62ff-4906-a898-01a66d296902"],
 ", and her radar time of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b3d23e4-dff9-4c25-a2b1-d520a05a74ab"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"e", "m", "i", "t"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea4c125-50ec-4fcd-921e-0cdea8e01292"],
 ". The dashed orange line is Alice's line of simultaneity from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a7ca32a-86a9-46e4-8f24-2b422ad6a7f8"],
 " through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a88594-ccca-4327-b4f1-26c1180e7645"],
 ". Bob's own clock reads ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e530290c-8849-4937-8477-923cf9fb3c4c"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22c32991-6142-461f-9d27-c1dd6bddda63"],
 " times the arc length at ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61b9f075-e512-44a9-969a-cca9bbb0d5a8"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["B", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e98ce093-3f47-4148-b0ff-14120e7a5a95"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzFactor"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzFactor", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9c79409-7a6d-431f-9600-745a0c79ae3f"],
 ", printed in the corner."
}], "Notes",ExpressionUUID->"12d55999-ae4a-4b83-97d9-d3f01f98b1e0"],

Cell[TextData[{
 "Both worldlines carry proper-time ticks at equal steps; by default the step \
is a quarter of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ec5ecc3-b070-4fd4-8af0-2042829ff1c0"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e38223a5-822d-4f91-9bc4-48538b167a75"],
 " is Bob's fourth tick, and Alice's ticks run \[Gamma] times as many steps \
to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea63c68c-88a2-4cc6-a551-1976000abeb0"],
 ". The worldlines are drawn past ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e477500-a7d4-4bae-be44-6518f273c6a4"],
 " and past the return, and every tick lies on them."
}], "Notes",ExpressionUUID->"fd825ba0-f9e7-4aeb-b19f-b660f2839699"],

