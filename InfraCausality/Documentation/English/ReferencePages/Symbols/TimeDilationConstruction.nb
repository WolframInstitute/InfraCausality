Cell[CellGroupData[{
Cell["TimeDilationConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3715c206-838e-44f7-92af-7772cf1cea90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TimeDilationConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74268c14-336f-4896-bd79-5f0ccd4b2cd6"],
 "\[LineSeparator]",
 "draws the radar construction of one event on the worldline of velocity ",
 StyleBox["v", "TI"],
 ", illustrating the time dilation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f7af87e-bbdb-463d-8448-10b2aca23fc1"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c34b1d5b-ce9f-4412-bb74-3085d5380957"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"41187885-40f4-424e-8c86-72f9d648a675"],

Cell[TextData[{
 "Definition: the event ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb7bb939-a5cf-420d-9d5d-5b77adceaf38"],
 " at arc length ",
 Cell[BoxData["\"\<EventArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a08500a7-c59b-4365-b5e0-5e557f8edd2c"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) is radar-located by the rest observer (\"Alice\", blue): \
she sends light at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"e", "m", "i", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46e81bdf-6f77-4c74-bd74-aacff6363aee"],
 ", it reaches ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f06086fa-16bd-4297-8a0a-0fc9292851e6"],
 " and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d62cfd3-e8f8-4664-9a9d-b3a5580fe490"],
 ", and her radar time of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a1b1701-0a6a-4bee-8102-f38a76f2f1e7"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"e", "m", "i", "t"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61ae29ef-e0b6-4dd5-965d-1cb301cee9d5"],
 ". The dashed orange line is Alice's line of simultaneity (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b36760c-6688-43dd-86ab-6ddf3c8c8e37"],
 ") from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f37776-f18b-4f27-9ed5-f39033afe3dc"],
 " through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55c3a033-5638-40e8-a461-f99892060b8a"],
 ". Bob's own clock reads ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "944bd2f8-49d8-4f80-aeac-1bfd0df262de"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d1efdc5-010a-46eb-8208-1c6ca46a0a21"],
 " times the arc length at ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a61a7ba-e6a5-4140-94ea-d6a69e1fce3c"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["B", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b514f8-ef5b-4043-89aa-58a6f5882110"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43f3a85c-bedd-45ea-bb02-005b8ba09dfc"],
 ", printed in the corner."
}], "Notes",ExpressionUUID->"3aec3bda-3df4-40a3-b76d-785a4007a055"],

Cell[TextData[{
 "Both worldlines carry proper-time ticks at equal steps; by default the step \
is a quarter of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5831c078-d76c-4cc7-8255-fa2d7bf706e5"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9ef43d3-83a9-46c1-ab7a-0b79d0c4dfbb"],
 " is Bob's fourth tick, and Alice's ticks run \[Gamma] times as many steps \
to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30ee5739-d042-45e7-b0f7-e95f7d007530"],
 ". The worldlines are drawn past ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97b46db3-f33c-4502-8cc5-ee19ee630089"],
 " and past the return, and every tick lies on them."
}], "Notes",ExpressionUUID->"16c91c39-96df-412b-baaf-f55a49678742"],

