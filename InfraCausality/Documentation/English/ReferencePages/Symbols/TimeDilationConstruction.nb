Cell[CellGroupData[{
Cell["TimeDilationConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"91e7c3a4-faca-4ee6-94dd-f99c2d4a87d6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TimeDilationConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "398bd378-d0fd-4718-a025-e2965f21d3b3"],
 "\[LineSeparator]",
 "draws the radar construction of one event on the worldline of velocity ",
 StyleBox["v", "TI"],
 ", illustrating the time dilation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe01e32-5c7b-402e-aa33-bb24ec222ab3"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4033f3bf-544a-4cde-a153-8fe5f5523fc3"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"ec813281-188c-47cb-b224-c63622f5f270"],

Cell[TextData[{
 "Definition: the event ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6b8fceb-33c8-4699-83bc-758a4e992260"],
 " at arc length ",
 Cell[BoxData["\"\<EventArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a757daa2-0573-4737-b54d-ec73031e06e7"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) is radar-located by the rest observer (\"Alice\", blue): \
she sends light at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"e", "m", "i", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60df240e-d16b-4ddf-b45c-f3956f607edc"],
 ", it reaches ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9bedd0e-600e-4eb5-9102-3f02d49ded4a"],
 " and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80a913b5-7c92-4a13-b3b1-91c38b238f9c"],
 ", and her radar time of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2d954eb-3b4e-4a66-912c-306cabe1ae56"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"e", "m", "i", "t"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50d76097-f01d-4a66-b01a-87948c49b71e"],
 ". The dashed orange line is Alice's line of simultaneity (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f68645cc-2388-4c72-b995-ae6c8cfa5498"],
 ") from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de2930c0-9c12-4ecb-93b6-7b69456f14e8"],
 " through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c85ed34-2818-4899-8ef0-90e554c2f4ce"],
 ". Bob's own clock reads ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663a634e-5604-4899-996f-3d4ba957ddb8"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "726690c8-1634-43dd-98d9-7b9075e08bf1"],
 " times the arc length at ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc5f002c-0462-4c47-b4c0-2f14c513b773"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["B", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b890856-4751-4afc-a892-1f60d0bec2a9"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3388075-f4ed-4b59-8736-162408f0e5e4"],
 ", printed in the corner."
}], "Notes",ExpressionUUID->"18e16d60-e9cf-46e1-84f9-7b09fd4024d6"],

Cell[TextData[{
 "Both worldlines carry proper-time ticks at equal steps; by default the step \
is a quarter of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b88cc47e-25bd-45bd-a7b1-da59d06e436d"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b496b510-95ef-427f-8d20-acd297758959"],
 " is Bob's fourth tick, and Alice's ticks run \[Gamma] times as many steps \
to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d7f9955-d86a-4e96-b842-b96f9ed899b5"],
 ". The worldlines are drawn past ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7077542f-1baa-44f3-b87a-de47d3e4ea73"],
 " and past the return, and every tick lies on them."
}], "Notes",ExpressionUUID->"15a7c319-7742-4e2c-9fea-f31d8393cd13"],

