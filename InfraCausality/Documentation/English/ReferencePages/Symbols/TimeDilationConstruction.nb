                RowBox[{"Line", "[", "pts_", "]"}]}], "}"}], " ", ":>", " ", 
              "pts"}], ",", " ", "Infinity"}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"First", "[", "now", "]"}], " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"b", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "now", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "<", " ", 
