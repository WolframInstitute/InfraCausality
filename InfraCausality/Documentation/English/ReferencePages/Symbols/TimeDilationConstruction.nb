        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"taus", "[", 
            RowBox[{"[", "4", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"0.6", " ", 
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v", ",", " ", "phi"}], "]"}]}]}], "]"}], " ", "<", " ", 
         
         RowBox[{"10", "^", 
