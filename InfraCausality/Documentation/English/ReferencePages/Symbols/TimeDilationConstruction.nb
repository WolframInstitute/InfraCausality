               ",", " ", "Infinity"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
            "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"now", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Cases", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{"{", 
