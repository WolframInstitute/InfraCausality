Cell[CellGroupData[{
Cell["TimeDilationConstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"61d73db8-5c06-4516-9cf2-79eda3468251"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TimeDilationConstruction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40cd496d-6d10-43c4-92a5-bbff21d4dcab"],
 "\[LineSeparator]",
 "draws the radar construction of one event on the worldline of velocity ",
 StyleBox["v", "TI"],
 ", illustrating the time dilation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80730e3f-8d40-4104-ac37-9c7e5279a768"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0c4e1c8e-c07d-43db-8dde-23ca73525832"],

Cell["\<\
Experimental: figure. The figure's layout and options may change.\
\>", "Notes",ExpressionUUID->"36fb2bc6-5b86-49b9-9629-fe9851018516"],

Cell[TextData[{
 "Definition: the event ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65f48589-564d-4eca-94de-b33a2a2179d5"],
 " at arc length ",
 Cell[BoxData["\"\<EventArcLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9aa1888e-d93e-4348-a552-4140fbc85810"],
 " on the worldline of velocity ",
 StyleBox["v", "TI"],
 " (\"Bob\", red) is radar-located by the rest observer (\"Alice\", blue): \
she sends light at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"e", "m", "i", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138c1091-d336-44c0-8c30-42d8da2a6bb8"],
 ", it reaches ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "658d56f4-254f-4290-b8bf-4ca2a73b6be0"],
 " and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0546fd75-8350-4bbd-bce1-e574a581f70a"],
 ", and her radar time of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8f64f53-b46a-4f0b-9625-c7ee75330e9c"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"e", "m", "i", "t"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     StyleBox[
      RowBox[{"r", "e", "t", "u", "r", "n"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ebdf651-d5ae-4c6b-b344-1e79f34d4275"],
 ". The dashed orange line is Alice's line of simultaneity (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c994094d-6639-421d-967c-7d4b89140ee3"],
 ") from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "951dbe6a-1650-4d39-b2d6-99a7dc52b9c0"],
 " through ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8e71f6a-06b4-497c-ab91-08f88162a9be"],
 ". Bob's own clock reads ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79413a5e-6a64-4522-b7b3-d8eda63f5ea0"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProperTimeScale"]], 
     "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["\[CurlyPhi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96efa165-cd17-4d28-842f-054be837b533"],
 " times the arc length at ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2439b1b2-be38-4c92-bf98-03b8d187ce12"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox[
     RowBox[{"r", "a", "d", "a", "r"}], "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["B", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ab16c82-357d-4864-986f-e121ec4622ce"],
 " with \[Gamma] = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LorentzGamma"]], 
     "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["v", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de9fb475-efc7-4ffd-9f80-e708089366df"],
 ", printed in the corner."
}], "Notes",ExpressionUUID->"b0ec2e49-0e95-4a99-bf0f-5447e038b32a"],

Cell[TextData[{
 "Both worldlines carry proper-time ticks at equal steps; by default the step \
is a quarter of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "535ac4a0-37d6-4dd3-a814-1c2a31589a57"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e73969a-ff83-424c-859c-07f76d48580b"],
 " is Bob's fourth tick, and Alice's ticks run \[Gamma] times as many steps \
to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox[
    RowBox[{"r", "a", "d", "a", "r"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1a9fd5a-a744-4a79-b028-100c1e8ffc22"],
 ". The worldlines are drawn past ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b207e1ec-f5a5-455f-badb-a67f003d31dd"],
 " and past the return, and every tick lies on them."
}], "Notes",ExpressionUUID->"943ef941-20a1-47d0-935f-dc97c78c9d29"],

