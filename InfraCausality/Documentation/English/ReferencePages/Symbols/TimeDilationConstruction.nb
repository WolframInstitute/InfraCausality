Cell["\<\
Alice's radar time of the event is \[Gamma] times Bob's proper time of it, \
and her three marked events are its emission, return and radar time.\
\>", "ExampleText",ExpressionUUID->"f025ad76-acfb-4068-96ef-2305b0a17771"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.4", ",", " ", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"disks", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"TimeDilationConstruction", "[", 
            RowBox[{"v", ",", " ", 
             RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",",
            " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"disks", ",", " ", 
            RowBox[{"c", " ", "|->", " ", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"b", ",", " ", "phi"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"b", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"ProperTimeScale", "[", 
               RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
              RowBox[{"Norm", "[", "b", "]"}]}], ")"}]}], " ", "-", " ", 
           RowBox[{"LorentzGamma", "[", "v", "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", "\n", "      ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Sort", "[", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{"disks", ",", " ", 
                RowBox[{"c", " ", "|->", " ", 
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], 
               "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
            " ", 
            RowBox[{"Sort", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"r", "[", "\"\<EmitArcLength\>\"", "]"}], ",", " ", 
               RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], ",", " ", 
               RowBox[{"r", "[", "\"\<ReturnArcLength\>\"", "]"}]}], "}"}], 
             "]"}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c9a7e00a-008b-4a7d-9657-7036ef6aafcc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8927785d-d4cb-46f1-b19a-8de56264c10f"]
}, Open  ]],

Cell["\<\
The ticks on the moving worldline are equal proper-time steps, the event is \
the fourth, and every tick lies on the drawn worldline.\
\>", "ExampleText",ExpressionUUID->"0721fd56-fc0f-4506-8101-04eeb0423fa2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.4", ",", " ", "0.8", ",", " ", "0.95"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", " ", "=", " ", 
          RowBox[{"TimeDilationConstruction", "[", 
           RowBox[{"v", ",", " ", 
            RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}]}], 
         ",", " ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"WorldlineDirection", "[", 
           RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", 
         RowBox[{"cross", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], " ", "|->", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", 
             RowBox[{"b", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"b", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"taus", " ", "=", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"pq", " ", "|->", " ", 
              RowBox[{
               RowBox[{"ProperTimeScale", "[", 
                RowBox[{"v", ",", " ", "phi"}], "]"}], " ", 
               RowBox[{"Norm", "[", 
                RowBox[{"Mean", "[", "pq", "]"}], "]"}]}]}], ",", "\n", 
             "      ", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{
                  RowBox[{"Line", "[", 
                   RowBox[{"pq", " ", ":", " ", 
                    RowBox[{"{", 
                    RowBox[{"_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":>", 
                  " ", "pq"}], ",", " ", "Infinity"}], "]"}], ",", " ", 
               RowBox[{"pq", " ", "|->", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{"pq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", ".", " ", 
                    "d"}], "]"}], " ", "<", " ", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"cross", "[", 
                    RowBox[{
                    RowBox[{"Mean", "[", "pq", "]"}], ",", " ", "d"}], "]"}], 
                   "]"}], " ", "<", " ", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "9"}]}]}]}]}]}], "]"}]}], "]"}]}]}], ",", 
         "\n", "     ", 
         RowBox[{"drawn", " ", "=", " ", 
          RowBox[{"Max", " ", "@", " ", 
           RowBox[{"Map", "[", 
            RowBox[{"Norm", ",", " ", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{
                  RowBox[{"Line", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"0", " ", "|", " ", "0."}], ",", " ", 
                    RowBox[{"0", " ", "|", " ", "0."}]}], "}"}], ",", " ", 
                    "q_"}], "}"}], "]"}], " ", ":>", " ", "q"}], ",", " ", 
                 "Infinity"}], "]"}], ",", " ", 
               RowBox[{"q", " ", "|->", " ", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"cross", "[", 
                   RowBox[{"q", ",", " ", "d"}], "]"}], "]"}], " ", "<", " ", 
                 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "9"}]}]}]}]}], "]"}]}], "]"}]}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "taus", "]"}], " ", ">=", " ", "4"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"taus", "/", 
             RowBox[{"First", "[", "taus", "]"}]}], " ", "-", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "taus", "]"}], "]"}]}], "]"}], "]"}], " ",
          "<", " ", 
         RowBox[{"10", "^", 
