The dashed line starts at Alice's radar time of the event and runs through \
the event.\
\>", "ExampleText",ExpressionUUID->"55cc33cf-f63b-49ec-893e-7e971b46a802"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.4", ",", " ", "0.8", ",", " ", "0.95"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", "1.2"}], "}"}]}], "}"}], "]"}], ",",
    " ", 
   RowBox[{"Apply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "phi"}], "}"}], " ", "|->", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"TimeDilationConstruction", "[", 
          RowBox[{"v", ",", " ", 
           RowBox[{"\"\<LightAngle\>\"", " ", "->", " ", "phi"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Cases", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], 
               ",", " ", "Infinity"}], "]"}], ",", " ", 
             RowBox[{"c", " ", "|->", " ", 
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
            "]"}]}]}], ",", "\n", "     ", 
         RowBox[{"now", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Cases", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Dashed", ",", " ", "___", ",", " ", 
                RowBox[{"Line", "[", "pts_", "]"}]}], "}"}], " ", ":>", " ", 
              "pts"}], ",", " ", "Infinity"}], "]"}]}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"First", "[", "now", "]"}], " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"b", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], " ", "<",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "now", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"b", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "now", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", 
         RowBox[{"b", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
