          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "now", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"b", "[", 
