           RowBox[{"0.6", " ", 
            RowBox[{"ProperTimeScale", "[", 
             RowBox[{"v", ",", " ", "phi"}], "]"}]}]}], "]"}], " ", "<", " ", 
         
         RowBox[{"10", "^", 
