    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdcbd41e-667a-4161-a8af-eba18c895044"],
 "\[LineSeparator]",
 "gives a random echo function of ",
 StyleBox["a", "TI"],
 " via ",
 StyleBox["b", "TI"],
 ", an association, drawn uniformly from the distinct echo functions.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a26ab8ff-7c36-4efc-ae2a-1aab7a51cbd9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEchoFunction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraEchoFunction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraEchoFunction", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f59365c-4461-40e6-8d4f-bef0122989b0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77380bd4-9d9b-46c2-975c-a2a6fb6bd328"],
 " of ",
 StyleBox["n", "TI"],
 " distinct echo functions, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6f64a3e-0de5-420e-b42e-5a35de145fb1"],
 " when there are fewer; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "500220b5-91c1-4e33-a344-0cd77f7ff408"],
 " gives at most ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2a6c31d-7ea5-437e-bd71-e1247fbda7fa"],
 " gives every one."
}], "Usage",ExpressionUUID->"699cb18e-51f2-4dd0-ac17-b6aa73bcd8cd"],

Cell["Experimental: selections.", "Notes",ExpressionUUID->"b060236d-a7ae-42cd-aed5-72346c2120f0"],

Cell[TextData[{
 "Definition: the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEchoFunction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1587d79-2f52-47ff-aac6-45e0fb5496cc"],
 " are the distinct compositions ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ba", "*"}]]], "InlineFormula",ExpressionUUID->
  "7e43239a-f304-4e84-84d5-ee7524a46625"],
 " \[SmallCircle] ",
 StyleBox["f", "TI"],
 Cell[BoxData[
  SubscriptBox["", 
   RowBox[{"*", "ab", "*"}]]], "InlineFormula",ExpressionUUID->
  "dd08cf0c-0bff-4451-8c18-3c7772c3fe8b"],
 " of a message function from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " with a message function from ",
 StyleBox["b", "TI"],
 " to ",
 StyleBox["a", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunctionQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunctionQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb78b2cb-7848-41ac-b954-a07c06affae8"],
 "). Different pairs of message functions can compose to the same echo \
function, so the members are counted after removing duplicates; the ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6881b2f-45b3-4e4c-b987-cce7722c9a4e"],
 " of the head is their number, at most the product of the numbers of message \
functions each way."
}], "Notes",ExpressionUUID->"fc63a874-ddbf-483f-bf88-c2cb12996c48"],

Cell["\<\
The sampler enumerates the compositions and draws from the distinct ones \
uniformly:\
\>", "Notes",ExpressionUUID->"afca5ad0-2478-4332-aef4-e3ea6d1fd41a"],

