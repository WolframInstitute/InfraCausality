Cell[TextData[{
 "A random echo function of an observer ",
 StyleBox["a", "TI"],
 " (blue) via an observer ",
 StyleBox["b", "TI"],
 " (red): the ticks of ",
 StyleBox["a", "TI"],
 " that send (orange) and the ticks they receive the echo at (purple), on the \
diamond lattice, a sprinkling into two-dimensional Minkowski space and the \
cylinder lattice."
}], "ExampleText",ExpressionUUID->"acadd3f5-33a2-4de1-beb1-bd003cbff840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomChoice", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"RandomInfraEchoFunction", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraEchoFunction", "[", 
                RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}],
              ",", " ", 
             RowBox[{"e", " ", "|->", " ", 
              RowBox[{"e", " ", "=!=", " ", 
               RowBox[{"<|", "|>"}]}]}]}], "]"}]}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
           "StandardRed"}], ",", " ", 
          RowBox[{
           RowBox[{"Keys", "[", "f", "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", " ", 
          RowBox[{
           RowBox[{"Values", "[", "f", "]"}], " ", "->", " ", 
           "StandardPurple"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8586b82-ba20-4b92-a102-9e814c6b9d86"],

