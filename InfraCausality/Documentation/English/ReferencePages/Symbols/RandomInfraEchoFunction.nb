Cell[TextData[{
 "The cardinality is at most the product of the message cardinalities, and an \
echo always returns strictly later on ",
 StyleBox["a", "TI"],
 ", to a tick of the echo relation."
}], "ExampleText",ExpressionUUID->"0f1d8ba0-de77-4365-a0c3-b306460cecb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"relation", " ", "=", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
           " ", "\"\<Relation\>\""}], "]"}]}], ",", " ", 
        RowBox[{"position", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"a", ",", " ", 
           RowBox[{"Range", " ", "@", " ", 
            RowBox[{"Length", "[", "a", "]"}]}]}], "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraEchoFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], " ", "<=", "\n", "      ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraMessageFunction", "[", 
            RowBox[{"b", ",", " ", "a"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}]}]}], " ", "&&", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"RandomInfraEchoFunction", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraEchoFunction", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], ",",
          " ", 
         RowBox[{"f", " ", "|->", "\n", "        ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "f", "]"}], ",", " ", 
            RowBox[{"v", " ", "|->", " ", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"relation", "[", "v", "]"}], ",", " ", 
                RowBox[{"f", "[", "v", "]"}]}], "]"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"position", "[", 
                RowBox[{"f", "[", "v", "]"}], "]"}], " ", ">", " ", 
               RowBox[{"position", "[", "v", "]"}]}]}]}]}], "]"}]}]}], 
        "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c1ec85af-7b91-4f74-973e-b25df4990088"],

