Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
     " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
     " ", "\"\<CylinderLatticeGraph\>\""}], "}"}], ",", " ", 
   RowBox[{"name", " ", "|->", "\n", "  ", 
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraWorldline", "[", 
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"members", " ", "=", " ", 
        RowBox[{"RandomInfraEchoFunction", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraEchoFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"compositions", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", " ", "@", " ", 
         RowBox[{"Catenate", " ", "@", " ", 
          RowBox[{"Outer", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "t"}], "}"}], " ", "|->", " ", 
             RowBox[{"KeySort", " ", "@", " ", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
                 " ", "s"}], "]"}]}]}], ",", "\n", "      ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", 
            RowBox[{"RandomInfraMessageFunction", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraMessageFunction", "[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", "members", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "[", "members", "]"}], " ", "==", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraEchoFunction", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}]}], " ", "&&", "\n", "      ", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"KeySort", " ", "/@", " ", "members"}], "]"}], " ", "===", 
        " ", 
        RowBox[{"Sort", "[", "compositions", "]"}]}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"132e7e79-b6dc-4a7a-be7e-86689bbd6dc1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bee1ee63-ea97-4399-9ca6-8ff0236c9ed0"]
