Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cd3a6982-a7f7-4dcb-860c-32fed8d96021"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEchoFunction"]], 
     "paclet:WolframInstitute/InfraCausality/ref/RandomInfraEchoFunction", 
