Cell[TextData[{
 "The enumeration grows with the product of the message cardinalities; on the \
staircases of the Small diamond lattice it gives 699 members out of 81 \
\[Times] 81 pairs. The sampler takes no ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "484a0700-da85-45ba-9aa1-c1ee5afe0699"],
 "."
}], "Notes",ExpressionUUID->"e29524d4-30dc-4745-add0-406ff12bd2fb"]
}, Open  ]],

