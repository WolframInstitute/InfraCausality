Cell[TextData[{
 "A random timelike geodesic of the substrate (blue) and its radar \
coordinates (purple), on the diamond lattice, a sprinkling into \
two-dimensional Minkowski space and the cylinder lattice. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91f28b48-d5c2-497a-994a-59049b70cb61"],
 " draws the head by its radar domain, the events it charts."
}], "ExampleText",ExpressionUUID->"9df84953-88ad-4f60-96a2-2ae05ce6e48a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], " ", "->", " ", 
           "StandardPurple"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6db17bd0-7330-41ed-9832-620a21d4a599"],

