}, Open  ]],

Cell["\<\
Radar time never decreases along an edge of the domain, and radar distance is \
never negative.\
\>", "ExampleText",ExpressionUUID->"e2c3263e-eef7-4bc3-ae5d-03f8865d8621"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"time", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
         " ", "\"\<Time\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
           " ", "\"\<Subgraph\>\""}], "]"}]}], ",", " ", 
        RowBox[{"edge", " ", "|->", " ", 
         RowBox[{
          RowBox[{"time", "[", 
           RowBox[{"First", " ", "@", " ", "edge"}], "]"}], " ", "<=", " ", 
          RowBox[{"time", "[", 
           RowBox[{"Last", " ", "@", " ", "edge"}], "]"}]}]}]}], "]"}], " ", "&&",
       "\n", "      ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
          " ", "\"\<Distance\>\""}], "]"}], ",", " ", "NonNegative"}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6a9432c6-1f0d-4fc6-8f40-4e504285c240"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b6335024-c553-4114-9b10-1132e67d7291"]
}, Open  ]],

Cell["\<\
The radar domain is the causal diamond of the first and the last tick, and \
the fibers of the observer space partition it.\
\>", "ExampleText",ExpressionUUID->"7ba33ba9-7257-4c60-90a9-ae8ccf876a0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"CausalSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"domain", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
         " ", "\"\<Domain\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"domain", " ", "===", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCausalDiamond", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", "a"}], ",", " ", 
            RowBox[{"Last", " ", "@", " ", "a"}]}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}], " ", "&&", "\n", 
      "      ", 
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
           " ", "\"\<Subgraph\>\""}], "]"}]}]}], " ", "===", " ", "domain"}], 
      " ", "&&", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"e", " ", "|->", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", " ", "e"}],
            "]"}], " ", "===", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"domain", ",", " ", "e"}], "]"}]}]}]}], "]"}], " ", "&&", 
      "\n", "      ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Join", " ", "@@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"VertexList", " ", "/@", " ", 
           RowBox[{"InfraFibers", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
              " ", "\"\<Fibration\>\""}], "]"}]}]}], "]"}]}], "]"}], " ", "===",
        " ", "domain"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
       " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
       " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8403ecb0-5293-4b54-b8b6-0e2d418880fc"],

