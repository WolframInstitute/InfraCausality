 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"935a36db-cf2a-49bf-bad3-2a99fa9c7068"]
