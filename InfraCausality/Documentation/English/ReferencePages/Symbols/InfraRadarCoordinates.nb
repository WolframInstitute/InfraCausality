Cell[TextData[{
 "The radar domain is the set the chart is defined on: ",
 Cell[BoxData[
  RowBox[{"InfraMemberQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraRadarCoordinates", "[", 
     StyleBox["a", "TI"], "]"}], ",", " ", 
    StyleBox["e", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c02379b-0339-4f61-a145-0182d4bc4144"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d540c902-a4f0-448a-bf75-6f3f7d0a9fe7"],
 " exactly on its events, ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraRadarCoordinates", "[", 
     StyleBox["a", "TI"], "]"}], ",", " ", "\"\<Subgraph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e811380-61f1-4d97-9562-e62aaae69d32"],
 " is the subgraph induced on it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "111aecce-ff14-4237-8271-4a39880687d5"],
 " draws it by its vertex density."
}], "Notes",ExpressionUUID->"09dd44d6-d0fa-485e-bec0-79520f4eb932"],

Cell[TextData[{
 "The fibers of the observer space are the events the observers cannot tell \
apart; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibers"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibers", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cf046b50-10e0-4b9d-9993-15245241465e"],
 " lists them and the fiber-bundle functions of InfraGeometry read sections, \
connections and holonomy on them. The coordinates are a chart of the domain, \
axiom D2, exactly when every fiber is one event; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EPSRadarAxiomQ"]], 
    "paclet:WolframInstitute/InfraCausality/ref/EPSRadarAxiomQ", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "957ab5d0-47ef-4d5e-911a-39e355f2ca1b"],
 " tests it for one observer or for a list."
}], "Notes",ExpressionUUID->"fcca14e8-2869-41cb-a336-ad27894e9990"],

Cell["Corresponding notions:", "Notes",ExpressionUUID->"c1c4276b-b30a-463f-b5e1-b3e5584145cc"],

