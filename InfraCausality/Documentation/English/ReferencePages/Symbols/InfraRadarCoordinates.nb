Cell["\<\
The radar coordinates of the first events of the sprinkling: the ticks 1, 2 \
and 10 of the observer lie at distance 0.\
\>", "ExampleText",ExpressionUUID->"793387a1-6a69-4e06-b040-d344abd56a51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
        " ", "\"\<Coordinates\>\""}], "]"}]}], ",", " ", "10"}], "]"}]}], 
  "]"}]], "Input",
