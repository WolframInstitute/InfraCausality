Cell["\<\
A timelike geodesic between two inner events of the diamond lattice charts \
only their causal diamond; the rest of the lattice stays grey.\
\>", "ExampleText",ExpressionUUID->"b7e4f606-3329-41a5-a51a-5397459ae23f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c3412610-0b7b-490c-9878-836676c25666"],

