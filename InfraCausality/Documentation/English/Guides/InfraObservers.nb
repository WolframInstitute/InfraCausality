  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "103de70e-b0ec-4fbf-b265-f2ef7d4a922a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[Function]", 
   SuperscriptBox[
    StyleBox["E", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f303adc8-3ebc-4beb-acf6-89a3a6ea9e44"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"1ade9fb7-a357-45b0-81e6-8b1eb040f6c4"],

