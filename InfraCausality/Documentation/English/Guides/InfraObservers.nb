 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e219699-6b65-41d9-90d5-95b471cdd3da"],
 " returned to ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0a7246f-c241-4197-ab01-144a647659dc"],
 ", whose members are the compositions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"b", "a"}], "TI"]], "\[SmallCircle]", 
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
