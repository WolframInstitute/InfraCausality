  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5934b38e-2074-4a8c-8493-77b822e03b3b"],
 " \[LongDash] ",
 "the echo relation of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cb96abb-109d-4feb-b3e6-6b14d871ff1b"],
 " via ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3de8d06-8d30-4a83-bfc8-381f27edf236"],
 ", a message to ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df2f7cbc-1ba8-4637-9a98-6bf2fe57d552"],
 " returned to ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "339fffb2-866d-4ae9-a046-7ea3bff9f0ad"],
 ", whose members are the compositions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"b", "a"}], "TI"]], "\[SmallCircle]", 
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"a", "b"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c238ecce-a70d-44f0-8112-f528ed64a3ea"],
 " of two message functions"
}], "GuideText",ExpressionUUID->"8468428d-6d82-4fa8-a28a-012748b05a87"],

