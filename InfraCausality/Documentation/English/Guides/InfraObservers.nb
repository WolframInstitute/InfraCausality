Cell[CellGroupData[{

Cell["Experimental: EPS defects", "GuideFunctionsSubsection",ExpressionUUID->"5081fe6b-4d9a-42c2-864d-ff962a3caf88"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
