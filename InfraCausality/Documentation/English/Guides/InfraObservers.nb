  FontSize->0.9 Inherited,ExpressionUUID->
  "f1e50d2f-ae4d-4acf-b960-d3c96b6c5035"],
 " of two message functions"
}], "GuideText",ExpressionUUID->"b89b7fbe-c0e9-4206-ad8a-978a6cc5ad1c"],

