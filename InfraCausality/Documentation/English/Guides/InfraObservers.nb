Cell[CellGroupData[{

Cell["Experimental: EPS defects", "GuideFunctionsSubsection",ExpressionUUID->"b52ebdd8-e76d-44e5-993c-8dde55214f0c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
