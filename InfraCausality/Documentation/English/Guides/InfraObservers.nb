  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0ac540dd-06d3-4706-96d4-28d8ffcf4ff6"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "of a message or echo relation: \"DomainDefect\", \"FunctionDefect\", \
\"InjectivityDefect\", \"OrderDefect\", how far the relation is from a \
monotone bijection on the window left by the option \"Boundary\", and \
\"KFactor\", the Bondi factor of two observers from their tick-span ratios, \
exact on the lattice for the chains ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["p", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["m", "TI"]}], ",", 
    StyleBox[
     RowBox[{"p", "m"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cf357b2-a870-41ab-9728-37d4f86ef1d4"],
 " of velocity ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["p", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb63f3e0-5cb9-4273-8f51-24562f08d18d"]
}], "GuideText",ExpressionUUID->"25239458-441c-4d59-970c-3e767eea1b43"]
