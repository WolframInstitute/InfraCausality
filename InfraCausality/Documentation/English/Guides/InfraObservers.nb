   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "040c7cfa-1d99-421a-8779-4999b2589c96"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"884f7706-aa95-4b30-ad20-102d40c51e4c"],

