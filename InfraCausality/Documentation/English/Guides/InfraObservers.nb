 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[Function]", 
   SuperscriptBox[
    StyleBox["E", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0af44554-b8d6-4a87-9180-c86f45848ff9"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"2152ce2f-6551-45e4-a130-51fe5439eb21"],

