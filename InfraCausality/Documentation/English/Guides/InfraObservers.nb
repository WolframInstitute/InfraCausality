 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70120d32-8b52-497a-ae20-9650c06946ce"],
 " returned to ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65f63c0e-e845-41a6-9378-66898b329dba"],
