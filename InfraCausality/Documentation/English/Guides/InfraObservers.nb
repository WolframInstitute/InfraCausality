  FontSize->0.9 Inherited,ExpressionUUID->
  "57875880-1acd-4c80-acc6-6d44bf0ac84f"],
 " of two message functions"
}], "GuideText",ExpressionUUID->"976171cf-e4d4-4be3-a919-cdef663ce950"],

