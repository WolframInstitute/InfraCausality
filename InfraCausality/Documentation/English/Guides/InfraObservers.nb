 "the echo relation of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d37b2c-6375-4442-8826-caa8cc253b51"],
 " via ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9bc9602-d771-4229-a642-db7852ba13dd"],
