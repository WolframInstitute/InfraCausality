 " \[LongDash] ",
 "the echo relation of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577c283f-7491-4c7f-bb73-4865c983fecd"],
 " via ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d640a4c-2493-45f4-a4af-035c79ba098b"],
 ", a message to ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec156628-cc6d-4134-8f15-50a497a261b2"],
 " returned to ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50615c37-73d6-4fce-abf9-4caef9df8c30"],
 ", whose members are the compositions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"b", "a"}], "TI"]], "\[SmallCircle]", 
   SubscriptBox[
