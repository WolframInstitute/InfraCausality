 " \[LongDash] ",
 "the echo relation of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8000fa5-35b1-4430-abb3-8b34c6e01cfc"],
 " via ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cb83219-fbf5-4d22-b788-bd2c05371d7c"],
