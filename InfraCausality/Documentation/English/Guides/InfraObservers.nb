  RowBox[{
   StyleBox["v", "TI"], "\[Function]", 
   SuperscriptBox[
    StyleBox["E", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2997fdfb-89c9-4748-848c-587e64ddbe33"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"fb08bad7-eb88-4877-b25a-ca0fa34252cf"],

