  FontSize->0.9 Inherited,ExpressionUUID->
  "ce90a544-ce3f-475d-bc13-c4d72fadae7f"],
 ", whose members are the monotone compositions of two selections"
}], "GuideText",ExpressionUUID->"cd634531-88ab-4907-8971-9f34365d2705"],

