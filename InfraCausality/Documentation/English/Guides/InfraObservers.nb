 " \[LongDash] ",
 "the echo relation of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae3bc7b-447a-451b-9384-c219cf28cbee"],
 " via ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e6ccafc-7405-4e33-a9f3-2578dec2be9b"],
 ", a message to ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c1a5e02-daad-4e5d-bbe9-70a21929cddb"],
 " returned to ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e551003-2360-4c28-a3f8-3074cd066739"],
 ", whose members are the compositions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"b", "a"}], "TI"]], "\[SmallCircle]", 
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox[
     RowBox[{"a", "b"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96b75042-bf77-47aa-b483-a664ae6b719f"],
 " of two message functions"
}], "GuideText",ExpressionUUID->"0dc56e7e-a19a-4900-afa7-ee71ac921f2e"],

