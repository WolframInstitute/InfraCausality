  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a7f03a-5d91-454d-b2d7-95454184ef3b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[Function]", 
   SuperscriptBox[
    StyleBox["E", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8915480-e543-45cf-9d6d-0762ae739064"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"8b35f99b-c7ff-462f-b3fe-7c2cde85de0d"],

Cell[TextData[{
 Cell[BoxData[
