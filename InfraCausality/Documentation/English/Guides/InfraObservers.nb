 " \[LongDash] ",
 "the message relation from observer ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44403091-9156-473b-9515-5b2c4329db34"],
 " to observer ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2524127c-a00e-4961-968d-d4fc80af40b5"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[Function]", 
   SuperscriptBox[
    StyleBox["E", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Intersection]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "206b8b48-4e44-4adc-b7ae-5de2fcf876e1"],
 ", whose members are its monotone single-valued selections"
}], "GuideText",ExpressionUUID->"d97775bc-b683-4127-97b5-d6b7bfa8370f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEchoFunction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraEchoFunction", 
    "WolframInstitute/InfraCausality Package Symbol"},
