  "6ba93371-52ec-482b-8a2e-3838e2b851ef"],
 " \[LongDash] ",
 "the radar chart of one observer: radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7a45f62-97d5-44a0-8943-b89c5182fa2a"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "-", 
    StyleBox["i", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "175c0cf4-f661-441c-8c1c-c3ad0ce4ddad"],
 " of every event in the radar domain, with its time and distance marginals, \
its domain, the directed subgraph on the domain and the base graph on the \
coordinate cells"
}], "GuideText",ExpressionUUID->"9b7b17da-db3c-410a-9662-8f87077497ca"]
}, Open  ]],

