  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "46546905-19cf-4fb0-a7fc-a327a050b293"],
 " \[LongDash] ",
 "the radar chart of one observer: radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "702153f5-85c0-4ca7-b42a-38e0ab79584f"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "-", 
    StyleBox["i", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ac2ec4-eb66-4cad-b905-51a4ffd0a0ea"],
 " of every event in the radar domain, with its time and distance marginals, \
its domain, the directed subgraph on the domain and the base graph on the \
coordinate cells"
}], "GuideText",ExpressionUUID->"7aeb6458-97f0-42c0-a6f2-14d8a0f5e0c7"]
}, Open  ]],

