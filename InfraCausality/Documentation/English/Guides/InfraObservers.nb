  "21c6975c-ec89-4982-a8d3-3133fdb7cfa7"],
 " \[LongDash] ",
 "the radar chart of one observer: radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
