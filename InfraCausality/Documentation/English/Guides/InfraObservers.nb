  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e577f026-4dd4-4399-89a0-1e5e162c5f5e"],
 " \[LongDash] ",
 "the radar chart of one observer: radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4979c840-27aa-40b3-a813-709713e36259"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "-", 
    StyleBox["i", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1d810bd-4510-4b2f-99c5-a68d199c2535"],
 " of every event in the radar domain, with its time and distance marginals, \
its domain, the directed subgraph on the domain and the base graph on the \
coordinate cells"
}], "GuideText",ExpressionUUID->"ea8ae39f-504d-473e-96fb-3ed28f6faa0b"]
}, Open  ]],

