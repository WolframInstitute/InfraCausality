Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "17573ac0-3464-4834-99b3-e584493e276c"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "a property of a causal head on a graph: \"Graph\", \"Cardinality\", \
\"Length\", \"VertexDensity\", \"EdgeDensity\", \"Subgraph\", \
\"CountingMeasure\"; ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", "head", ",", " ", "\"\<VertexDensity\>\""}], 
