Cell[CellGroupData[{

Cell["Reading a construction on a graph", "GuideFunctionsSubsection",ExpressionUUID->"ac7d6de9-d3ee-496b-bc9f-994a85acc1f2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "d9d25c8c-1e32-487c-9eb8-db8fd4f8e99d"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "a property of a causal head on a graph: \"Graph\", \"Cardinality\", \
\"Length\", \"VertexDensity\", \"EdgeDensity\", \"Subgraph\", \
\"CountingMeasure\"; ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
