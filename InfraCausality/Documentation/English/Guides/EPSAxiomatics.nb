Cell[CellGroupData[{

Cell["Distance from the axioms", "GuideFunctionsSubsection",ExpressionUUID->"fb50da76-e32a-43ac-8bc2-0c1f9d1248f4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "eb47262c-0218-4a35-a616-ef97efcbd339"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "of a message or echo relation: \"DomainDefect\", \"FunctionDefect\", \
\"InjectivityDefect\", \"OrderDefect\", how far the relation is from a \
monotone bijection on the window of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5b9dc0-ac83-46ac-ac32-a2979ac496b6"],
 " left by the option \"Margin\", all four zero exactly under axiom D1; a tie \
of single images counts against injectivity, not order"
}], "GuideText",ExpressionUUID->"694509dd-72b9-47b6-a245-f758a1f94275"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "362afebe-7cc7-4431-a7bc-8aeacd9a6894"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "of a message or echo relation: \"KFactor\", the Bondi factor of two \
observers from their tick-span ratios, exact on the lattice for the echo of \
",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d66e9a-f789-4d4a-82d6-72190b0588ac"],
 " via the chains ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["p", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["m", "TI"]}], ",", 
    StyleBox[
     RowBox[{"p", "m"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b88106be-ceaa-4ace-81c8-07422af855b7"],
 " of velocity ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["p", "TI"], "+", "1"}], 
