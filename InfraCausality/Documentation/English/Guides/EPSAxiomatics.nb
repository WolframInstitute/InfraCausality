Cell[CellGroupData[{

Cell["Distance from the axioms", "GuideFunctionsSubsection",ExpressionUUID->"d46433ae-9922-4cce-8292-4fa15782921d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "a33ca3eb-0d35-4c22-a0f7-1a9357af15ac"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "of a message or echo relation: \"DomainDefect\", \"FunctionDefect\", \
\"InjectivityDefect\", \"OrderDefect\", how far the relation is from a \
monotone bijection on the window of ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "982e235a-f823-4952-8d98-3cb418bd2537"],
 " left by the option \"Margin\", all four zero exactly under axiom D1; a tie \
of single images counts against injectivity, not order"
}], "GuideText",ExpressionUUID->"169a4ef3-ab8b-4817-bc12-648071ce5ca9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "357d989a-c6e8-4736-b33e-0cb55f20d238"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "of a message or echo relation: \"KFactor\", the Bondi factor of two \
observers from their tick-span ratios, exact on the lattice for the echo of \
",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ec147b9-4d03-4249-9913-138f5e0c31c0"],
 " via the chains ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["p", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["m", "TI"]}], ",", 
    StyleBox[
     RowBox[{"p", "m"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bad18f5d-5569-4255-b13f-35b136f1d86f"],
 " of velocity ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
