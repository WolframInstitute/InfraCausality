Notebook[{

Cell[CellGroupData[{
Cell["Experimental Functions", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Research functions not yet settled into a category: the Knuth kinematics of \
chain pairs, the extremal events of each slice, the exponential enumeration \
of monotone message and echo selections, and the Bondi figures with the \
drawing helpers behind them. Reserved: the causal-set estimators on a diamond \
and the EPS defects.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

