  FontSize->0.9 Inherited,ExpressionUUID->
  "5a06e44e-22e6-4c6d-b354-4630bc893812"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbf7c600-83c9-43ba-9308-15089f6e20d8"]
}], "GuideText",ExpressionUUID->"b97b18c9-e713-4c19-b4ee-8138582e020f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
