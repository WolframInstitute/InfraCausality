  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "13a44e9e-bcd0-4455-914c-b56aad128b68"],
 " \[LongDash] ",
 "the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9263ee4-71ff-45c7-b04a-0e06a88aeb23"]
}], "GuideText",ExpressionUUID->"f173a964-80d0-4b53-b6e5-ac96a22ecd3e"],

