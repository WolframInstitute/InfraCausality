  FontSize->0.9 Inherited,ExpressionUUID->
  "7f78fef2-9dce-4e00-b99f-40140cd2b5b9"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85aa07ac-c2af-4dd0-8b66-e5619c8965f2"]
}], "GuideText",ExpressionUUID->"7f78f6cf-468f-4461-bd7c-227ca3a45d54"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
