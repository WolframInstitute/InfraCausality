  FontSize->0.9 Inherited,ExpressionUUID->
  "27025f8a-5d6e-46bd-b097-2a7beeb84072"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4a0fafe-7630-4551-b71c-adca6f0668be"]
}], "GuideText",ExpressionUUID->"d73effb1-41f8-4bed-ac0a-9484eaa562dc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
