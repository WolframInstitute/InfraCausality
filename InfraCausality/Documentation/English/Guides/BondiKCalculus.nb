 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9033aee-2f04-4f35-b8be-ed32f4ce2cdf"]
}], "GuideText",ExpressionUUID->"600a849d-cf30-48e0-b1ea-6a9f431660d8"],

