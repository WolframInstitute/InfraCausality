 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "41e661ce-68de-40f9-af14-9e9fca882df4"],
 " \[LongDash] ",
 "the arc-length ratios ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a3fbda1-90cd-44ff-8bf2-1d482f952c1d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31e16f80-8d6a-43bf-8dc8-e39fba51972c"],
 ", whose product is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c490021-ed8a-4e89-a70c-086b97b80825"]
}], "GuideText",ExpressionUUID->"152da42e-4539-4b1d-a7bd-cc822002970e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "90c3a36c-8870-44d4-87d7-c0ac432cc09f"],
 " \[LongDash] ",
 "the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "+", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "-", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0535a5a3-09e8-4aef-bd10-b7c88707d867"],
 " of proper time to Euclidean arc length on the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d0e68f-90ae-46ca-abbc-dcdf28c921b4"]
}], "GuideText",ExpressionUUID->"0459f25f-70cb-46e7-95a4-c063cdfed9b6"]
