Notebook[{

Cell[CellGroupData[{
Cell["Bondi k-Calculus", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Bondi's k-calculus derives special relativity from the ratio ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "053cca55-8913-4e67-ab83-e91bbc5116cb"],
 " between the period of a light signal as sent and as received. Drawn in the \
Euclidean plane with two straight worldlines from a common origin and light \
at a fixed angle, the k-factor is a ratio of arc lengths, proper time is a \
fixed multiple of arc length on each worldline, and the bounces of a light \
zigzag grow geometrically, so their count is a logarithm of arc length. These \
functions are the continuum anchor of the paclet and take no graph; the graph \
analogue of the radar construction is ",
 Cell[BoxData["InfraRadarCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438135d4-8a3f-41fe-965c-ef8db89b6660"],
 " of the EPS Axiomatics guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["The k-factor", "GuideFunctionsSubsection",ExpressionUUID->"aed62c7a-b044-4555-ae30-0a71e0bdf373"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiKFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiKFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "fdc22220-3b21-405d-94af-b2d3c73836ed"],
 " \[LongDash] ",
 "the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8c09c1e-750d-471f-9d93-7b07912e037e"],
 ", or its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4789ed15-8107-4f65-ace6-4fdea2b21d0b"]
}], "GuideText",ExpressionUUID->"f0f1290c-8790-47d2-9e63-d65a1e97b017"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "7d5395ab-1bf8-4a50-87da-7767c5163086"],
 " \[LongDash] ",
 "the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b8a159f-08bf-4fac-a6c2-df43711239fd"]
}], "GuideText",ExpressionUUID->"f5a852c4-86b6-43b0-9452-f0e0981dbff9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "88b8f47c-b733-4a66-a60f-c229b1648051"],
 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c71a447d-72b1-43ee-8fc8-99c4e073f203"]
}], "GuideText",ExpressionUUID->"acf3bf0e-4007-4570-962a-352849dca0b4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData[
      StyleBox["ArcTanh", FontSlant -> "Italic"]]], "paclet:ref/ArcTanh"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "8f6a0885-a3a2-4d66-b511-2da03e5790e1"],
 " (WL)"
}], "GuideText",ExpressionUUID->"13fd6442-f613-43af-a992-3867d1cd5bae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worldlines in the Euclidean picture", "GuideFunctionsSubsection",ExpressionUUID->"382ccaef-23fd-471c-acf8-1b423293c0a8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineAngle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "68ec8406-cd89-4db9-97a8-9cfa88ea46ce"],
 " \[LongDash] ",
 "the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0590174b-0c92-41b5-9fc4-cad6bb964b50"],
 " of the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c548a919-324b-4caa-b120-9be85391eb63"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84ac9efd-6d9e-4495-a075-b5f1b51bd64e"]
}], "GuideText",ExpressionUUID->"c012660f-6e42-4d62-a4ee-a27f277bdaef"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "682fdeb0-abe0-4a9e-994b-e16a07a18f04"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "30ff3f05-c532-4c02-aabf-cf85e63d265d"],
 " \[LongDash] ",
 "the arc-length ratios ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd00aa3f-34d4-4a14-8a05-b5207918ad29"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0af22cb8-2c86-45fe-a2d6-d23c2e0b9449"],
 ", whose product is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c6ec7f5-b8f3-4576-b43c-eaf5ac3d211f"]
}], "GuideText",ExpressionUUID->"4900949e-a93c-4fad-96a2-2ea4642d18ea"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "552c7293-1709-4d2d-b8cd-9974a7ee7cb6"],
 " \[LongDash] ",
 "the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "+", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "-", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fdbabd6-8b65-4ead-92d7-fc418248af85"],
 " of proper time to Euclidean arc length on the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8eaee1e-1fe1-4e62-a441-245088d26f33"]
}], "GuideText",ExpressionUUID->"00f4de6a-8e0c-4d51-a862-60ec628d4130"]
}, Open  ]],

