 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2514d976-8f5a-42d3-8974-ba50d4d600dc"]
}], "GuideText",ExpressionUUID->"702e8e3e-2188-4231-b56f-f42a6ab835a0"],

