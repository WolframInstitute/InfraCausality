Notebook[{

Cell[CellGroupData[{
Cell["Bondi k-Calculus", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Bondi's k-calculus derives special relativity from the ratio ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfc9052e-ec0d-4da8-9db6-5687ddb220b7"],
 " between the period of a light signal as sent and as received. Drawn in the \
Euclidean plane with two straight worldlines from a common origin and light \
at a fixed angle, the k-factor is a ratio of arc lengths, proper time is a \
fixed multiple of arc length on each worldline, and the bounces of a light \
zigzag grow geometrically, so their count is a logarithm of arc length. These \
functions are the continuum anchor of the paclet and take no graph; the graph \
analogue of the radar construction is the radar chart of the Infra Observers \
guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["The k-factor", "GuideFunctionsSubsection",ExpressionUUID->"674a117a-c47b-4604-856c-53dae22c51fb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "fdddf71e-8e94-4eb9-bec4-0c1f2857c6ab"],
 " \[LongDash] ",
 "the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cee97f81-aa6c-4f8a-b99c-ad05f7d83124"],
 ", or its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30fbad27-51e4-4f69-8c59-2847298c28e5"]
}], "GuideText",ExpressionUUID->"0133991d-e652-4319-ae4b-1df1c819d69d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "dba44fe8-4f4d-478e-8f8b-9adfc000546c"],
 " \[LongDash] ",
 "the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eea053bc-7842-4eb3-98e4-20dc2fc770c5"]
}], "GuideText",ExpressionUUID->"ced6f77d-c008-4268-82d3-efe074c74132"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "30dd3f52-35ee-4027-8132-3839016e7efa"],
 " \[LongDash] ",
 "the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3552456-812c-4134-8f79-a15504567840"]
}], "GuideText",ExpressionUUID->"29986edc-02e2-4b76-af50-963a16d6cd26"],

