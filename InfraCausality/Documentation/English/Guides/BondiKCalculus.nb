 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "81d7afe6-ff72-47bc-a028-8489b8dc0c57"],
 " \[LongDash] ",
 "the arc-length ratios ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce4614d-4177-42ed-a360-44693907a4a8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c750d7ca-2b73-49e7-96fa-dc5ebae15aa5"],
 ", whose product is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1c05326-69c6-466f-89c4-eef88a6b0af4"]
}], "GuideText",ExpressionUUID->"738b1441-3ac4-4514-8a4a-9c4637efcf25"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "58124ba1-fde1-4964-baa8-cef89bf39f26"],
 " \[LongDash] ",
 "the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "+", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "-", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58286899-f0a3-4f04-99a4-96515fbf8643"],
 " of proper time to Euclidean arc length on the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "909fba6b-cc18-4bb2-baa3-3483f0ff38e2"]
}], "GuideText",ExpressionUUID->"bd0540c2-9bee-4473-8268-429d789a47ca"]
