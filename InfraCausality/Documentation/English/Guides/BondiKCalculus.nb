 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc525a77-1e6f-43a6-85ad-720c847867b5"]
}], "GuideText",ExpressionUUID->"0fe9da9b-e0eb-4df0-acd1-256d51a850b7"],

