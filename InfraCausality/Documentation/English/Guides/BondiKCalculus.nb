  FontSize->0.9 Inherited,ExpressionUUID->
  "5de11d8e-233a-476d-8c2a-afe4cf059ff0"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf622eca-86d1-4cc8-af61-b6107017223a"]
}], "GuideText",ExpressionUUID->"1818fba9-04a4-45d7-8aaf-71473640e3ac"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
