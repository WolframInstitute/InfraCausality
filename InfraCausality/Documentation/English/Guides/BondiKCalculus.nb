Notebook[{

Cell[CellGroupData[{
Cell["Bondi k-Calculus", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Bondi's k-calculus derives special relativity from the ratio ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfba1e67-e542-4abe-b423-ccb3b04027ea"],
 " between the period of a light signal as sent and as received. Drawn in the \
Euclidean plane with two straight worldlines from a common origin and light \
at a fixed angle, the k-factor is a ratio of arc lengths, and proper time is \
a logarithm of arc length. These functions are the continuum anchor of the \
paclet and take no graph; the graph analogue of the radar construction is the \
radar chart of the Infra Observers guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["The k-factor", "GuideFunctionsSubsection",ExpressionUUID->"733f905a-f589-4b68-a4bb-516c57b42ccf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e6b0471f-c061-4069-858b-351135689301"],
 " \[LongDash] ",
 "the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac01d6a2-45bb-4e4b-b59c-d0cd92d3f51a"],
 ", or its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7baaace7-bed0-4074-9888-9df8a4f3d2c0"]
}], "GuideText",ExpressionUUID->"13824f46-6ed6-4ab7-a993-6d03950c142d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "2031cf9d-0a1f-452c-8ee0-82a6451be78d"],
 " \[LongDash] ",
 "the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "039a8a51-421b-4500-91eb-413bcc5c0557"]
}], "GuideText",ExpressionUUID->"ef506a1c-496e-485f-bbc0-4bae1018b8a7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5c34ca98-e29a-445f-bdf1-e51e7552a5cb"],
 " \[LongDash] ",
 "the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c55d8f69-4098-4e24-97b0-8a2b4ddb10ab"]
}], "GuideText",ExpressionUUID->"659198c3-d739-4638-858b-e291a639f3c3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "2a2cdc39-1e25-44ff-9d80-c9ffd6369f74"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RapidityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "b382fe03-b349-4755-99d6-3d6e3227279e"],
 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40149499-b4cc-4bbb-9eb4-082b1c1469db"]
}], "GuideText",ExpressionUUID->"fb627047-c817-4882-b6be-3992d282eb74"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData[
      StyleBox["ArcTanh", FontSlant -> "Italic"]]], "paclet:ref/ArcTanh"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5c4fc66c-ef73-4d80-9145-61fc56e3783f"],
 " (WL)"
}], "GuideText",ExpressionUUID->"d031f4ec-3d69-49cc-b0ee-1bc7d7fa050f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worldlines in the Euclidean picture", "GuideFunctionsSubsection",ExpressionUUID->"e6525f20-2acc-4126-b0fe-51edd0d96376"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineAngle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ee9a8b02-1cff-470f-866a-9820848503b3"],
 " \[LongDash] ",
 "the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b3396aa-ac1b-48e6-995c-2c2b3d05ae5f"],
 " of the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d3b3ab-ca60-4428-b659-6b254e949de3"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ffb5993-83a3-4f4c-8cbf-d75c37b4eb04"]
}], "GuideText",ExpressionUUID->"ec30baa4-9568-4139-a489-b6c5272c2a0f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "40959eab-a4e8-42d1-ac46-eb1418e01722"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "cd9729e7-92a7-45eb-919e-fc7c85237a5c"],
 " \[LongDash] ",
 "the arc-length ratios ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d2f9436-2fb8-4c67-b30f-9bdb6f791b7b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2bd566e-283b-4f2a-9eb5-942b4261e3b9"],
 ", whose product is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e599f861-5a2d-4cfd-98bf-62ee1b6f3c12"]
}], "GuideText",ExpressionUUID->"18fd0dc5-7bc5-4c21-b5bd-2c80bfab729e"]
