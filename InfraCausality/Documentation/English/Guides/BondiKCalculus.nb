 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93c98431-45ef-42b7-baf0-d179b3f73576"]
}], "GuideText",ExpressionUUID->"ad91989a-a0c9-4b85-9442-a8ebdade0b83"],

