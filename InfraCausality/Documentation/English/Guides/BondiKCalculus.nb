  "4127d941-396b-4e53-b31d-68f25e58d253"],
 " against the time axis, for light at angle ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4251e7-bc1b-4265-bcef-cd9d154f7d07"]
}], "GuideText",ExpressionUUID->"cdcfd6f9-bbd3-4a13-8570-017779fe6628"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
