  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "20627b29-ffd9-41d5-8272-56b29bd46b71"],
 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d05a6290-b102-4bbd-9d6c-f3e73f5f178a"]
}], "GuideText",ExpressionUUID->"a7a88329-b160-4f61-be0a-7afd8d0f2194"],

