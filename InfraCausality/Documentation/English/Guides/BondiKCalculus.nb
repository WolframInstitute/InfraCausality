Notebook[{

Cell[CellGroupData[{
Cell["Bondi k-Calculus", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Bondi's k-calculus derives special relativity from the ratio ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e20cfb28-ecb3-4ac9-a4c0-042d0af8e299"],
 " between the period of a light signal as sent and as received. Drawn in the \
Euclidean plane with two straight worldlines from a common origin and light \
at a fixed angle, the k-factor is a ratio of arc lengths, proper time is a \
fixed multiple of arc length on each worldline, and the bounces of a light \
zigzag grow geometrically, so their count is a logarithm of arc length. These \
functions are the continuum anchor of the paclet and take no graph; the graph \
analogue of the radar construction is the radar chart of the Infra Observers \
guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["The k-factor", "GuideFunctionsSubsection",ExpressionUUID->"0b72e249-38be-40a2-8d9f-903f2c482c5d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "19bcfb5f-0ccb-49bf-8cb8-56b40ceee25d"],
 " \[LongDash] ",
 "the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c213a423-13fc-4a0a-a41a-0e9794070325"],
 ", or its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46ce6c58-5448-46bb-bf77-5c8155d19313"]
}], "GuideText",ExpressionUUID->"1ea58585-f7c2-41e9-aa42-1d671f6ae560"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ff5426a1-7cf0-47fa-8399-2e0b92bb9825"],
 " \[LongDash] ",
 "the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f03f9ce-57f8-4930-befb-5a452763e865"]
}], "GuideText",ExpressionUUID->"b70b773b-2a0e-47ea-8862-030177d2e3aa"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
