Notebook[{

Cell[CellGroupData[{
Cell["Bondi k-Calculus", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Bondi's k-calculus derives special relativity from the ratio ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3513c1a-11cd-4789-b558-cd7bd81d874d"],
 " between the period of a light signal as sent and as received. Drawn in the \
Euclidean plane with two straight worldlines from a common origin and light \
at a fixed angle, the k-factor is a ratio of arc lengths, proper time is a \
fixed multiple of arc length on each worldline, and the bounces of a light \
zigzag grow geometrically, so their count is a logarithm of arc length. These \
functions are the continuum anchor of the paclet and take no graph; the graph \
analogue of the radar construction is the radar chart of the Infra Observers \
guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["The k-factor", "GuideFunctionsSubsection",ExpressionUUID->"16688299-75c0-4192-80c0-f2d3669ca9ed"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "3aa4229a-3286-4d8d-acf6-47eecb947fdf"],
 " \[LongDash] ",
 "the Bondi factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71716d5e-76b2-413e-9e6a-e6580ea96f23"],
 ", or its angular form ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "+", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CurlyPhi]", "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "845f326c-9038-4dc2-8ecc-8c362933b8a1"]
}], "GuideText",ExpressionUUID->"1f7b5f05-cd3f-4240-83b9-95ca788bd6cc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "6cbc7b17-b953-4b4c-89aa-5816759d9857"],
 " \[LongDash] ",
 "the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4d1cf98-a049-47c9-95e8-f367c7a16a1f"]
}], "GuideText",ExpressionUUID->"3309881b-8e1a-4ee3-8bbc-3959d08348f3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5382897d-3b71-46e8-b936-37fad6193cbd"],
 " \[LongDash] ",
 "the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0755e432-3d50-4eb1-9c34-33db5387fd35"]
}], "GuideText",ExpressionUUID->"028a8431-cd33-4822-a5df-a56b020e1403"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
