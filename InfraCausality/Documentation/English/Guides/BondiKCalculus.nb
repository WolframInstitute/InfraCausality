 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "66599c3d-d729-4ae5-a917-6c1056eb4bb0"],
 " \[LongDash] ",
 "the arc-length ratios ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "-", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3eea010-7764-4aee-bb8a-8d3fd309315d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CurlyPhi]", "+", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cc32387-ffc6-4852-a060-73c6188563c3"],
 ", whose product is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3aa474f-d140-42d5-bad3-36be3a33c5d6"]
}], "GuideText",ExpressionUUID->"8f529dee-ed6e-4144-958e-7ce476307a3e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0824e465-5963-4f0b-b7d7-13ca29a0846a"],
 " \[LongDash] ",
 "the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "+", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", "-", 
      StyleBox["\[Alpha]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f0948bf-bead-4574-95cf-e488b0e11074"],
 " of proper time to Euclidean arc length on the worldline of velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11741e98-bce5-4f07-ace9-b06e130d1788"]
}], "GuideText",ExpressionUUID->"597cd96a-a064-4757-a7aa-158266709f7d"]
}, Open  ]],

