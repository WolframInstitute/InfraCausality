  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e656f983-7bd5-4250-8067-afebb46a2656"],
 " \[LongDash] ",
 "the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
