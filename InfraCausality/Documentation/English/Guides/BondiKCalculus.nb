  "1df9baca-184a-4936-a663-4f701732cf79"],
 " \[LongDash] ",
 "the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
