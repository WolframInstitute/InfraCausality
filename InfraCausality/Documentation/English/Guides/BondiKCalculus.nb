  "66c6befd-be5c-4b5d-9b66-4c11c78defad"],
 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192b3209-675d-4f39-9e47-fdf861cf108a"]
}], "GuideText",ExpressionUUID->"3e6b3fe3-b16d-489d-91f8-dee997d21380"],

