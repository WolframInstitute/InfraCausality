    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89115b68-80c7-4104-8f6b-68334ae913cf"],
 " of the worldline of velocity ",
 Cell[BoxData[
