Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WorldlineAngle"]], 
    "paclet:WolframInstitute/InfraCausality/ref/WorldlineAngle", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ebcf6527-0bc2-4fdc-a5ac-31261958a613"],
 " \[LongDash] ",
 "the angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], 
    StyleBox["tan",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
