  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "39150430-8b28-4ac4-a772-10e985dd68e7"],
 " \[LongDash] ",
 "the rapidity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["artanh",
    FontSlant->"Plain"], 
   StyleBox["v", "TI"], "=", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5d7482-bd0a-470a-93ce-5c362d5cffdf"]
}], "GuideText",ExpressionUUID->"df84d96e-8128-49bc-bf93-046bff06b1ad"],

