Notebook[{

Cell[CellGroupData[{
Cell["Causal Time", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A time function on a causal graph is a map to the integers that increases \
along every edge. The causal height of an event is the least such function: \
the number of edges of a longest chain from a source to the event, zero on \
the sources. Its level sets, the slices of the height foliation, are \
antichains that partition the events, and the slice through an event is the \
discrete analogue of a simultaneity surface. A slice is an inert set head \
read like a ball: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraSlice", "[", "k", "]"}], ",", " ", "\"\<Subgraph\>\""}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "390620c7-9676-4ac6-ba95-1dc2682d7b50"],
 " is its induced subgraph, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraSlice", "[", "k", "]"}], ",", 
     " ", "\"\<VertexDensity\>\""}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1ed893-594e-4765-8e6e-5176d3b542e3"],
 " its support as a sorted vertex list, and ",
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraSlice", "[", "k", "]"}], ",", " ", "n"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba23bbb-5075-46cf-8d69-46ed4b05270b"],
 " draws random events of it."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

