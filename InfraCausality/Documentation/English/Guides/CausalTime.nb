  RowBox[{
   StyleBox["t", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderscriptBox[
    StyleBox["max",
     FontSlant->"Plain"], 
    StyleBox["s", "TI"],
    LimitsPositioning->False], "\[ThinSpace]", 
   StyleBox["\[Tau]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f945612-36a1-4ca8-9cb0-68147060bf3d"],
 " over the sources ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0a9114f-0a80-4fe1-a561-ba14d935da47"],
 ", zero on the sources"
}], "GuideText",ExpressionUUID->"94c09422-0c1d-422b-886f-885aded9540b"],

