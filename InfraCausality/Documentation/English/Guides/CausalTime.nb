    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7c55890-61b4-48d1-ab6b-a830d4b13613"],
 " over the sources ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23e739ed-0f7f-4935-9574-277c4acd9528"],
 ", zero on the sources"
}], "GuideText",ExpressionUUID->"19ea3c6e-dd5f-40a2-97a3-c4528b84e5dc"],

