  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e4740704-4c4d-4717-87f4-6a25876732b2"],
 " \[LongDash] ",
 "a random causal set of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1423c344-a058-487b-a2b6-0e23649cb379"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "950e4620-5985-49e3-be26-92cc59eb8521"],
 ", of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4062fb53-a19c-415a-8704-76276b9e26ae"],
 " edges, or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf438a1a-ca69-47ec-9a01-84bce766b015"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"e47d9ea7-c79e-4ce9-b0e8-65a3c65a8295"],

