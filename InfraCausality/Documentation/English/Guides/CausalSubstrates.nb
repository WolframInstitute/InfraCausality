 " \[LongDash] ",
 "a random causal set of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "567c4df1-396f-40bd-93a7-4328fa1cb269"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5670d8f7-673d-4de1-b0f8-400bacdb279d"],
 ", of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0db94d23-d436-4462-981c-a2b1b7f87cc5"],
 " edges, or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec4ee8dc-8357-4f6f-9c82-4f80bb939a8f"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"324cc01a-f0b2-4d17-8ef5-892f66be0e1f"],

