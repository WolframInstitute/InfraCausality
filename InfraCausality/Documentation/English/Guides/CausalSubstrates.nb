Cell[CellGroupData[{

Cell["Causal graphs from Riemannian substrates", "GuideFunctionsSubsection",ExpressionUUID->"d84ff92e-040d-4af3-abff-ac6ac1e45744"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "f10e983e-213b-4aa4-836a-a88c0cb26f1c"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the rank DAG of an undirected substrate from a base point, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Rule]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0318d722-255d-4373-b3ef-92a37235f5bd"],
 " iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11bd4581-5daf-45a3-89e3-80e5d4f11dce"]
}], "GuideText",ExpressionUUID->"6edfea62-219f-40ee-a11d-449c74c8ec77"],

