Cell[CellGroupData[{

Cell["Causal graphs from Riemannian substrates", "GuideFunctionsSubsection",ExpressionUUID->"bb419d64-05d9-45db-b398-6a4b335d7079"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "dd12ed3d-4c12-427d-b880-362dcbac90e2"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the rank DAG of an undirected substrate from a base point, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Rule]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0a06657-ff58-4243-8a70-4e7a29bee3e5"],
 " iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "328fd982-146c-4eaa-ac4d-fb6bb3326782"]
}], "GuideText",ExpressionUUID->"1800d820-3c44-4746-aa25-5024b8849e95"],

