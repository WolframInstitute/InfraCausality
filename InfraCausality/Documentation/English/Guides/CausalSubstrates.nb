Cell[CellGroupData[{

Cell["Causal graphs from Riemannian substrates", "GuideFunctionsSubsection",ExpressionUUID->"21bc3c63-cb81-442c-9cf5-aaba774305cc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "1120fe14-7fab-4bcd-8306-a585a6001959"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the rank DAG of an undirected substrate from a base point, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Rule]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f1c05e3-449b-41c6-8b98-133f0c25ddf9"],
 " iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2bd2af4-aa90-45e7-a171-cbe5c4eb7d02"]
}], "GuideText",ExpressionUUID->"d80b68d6-e3ec-4025-8319-bb77f868ab19"],

