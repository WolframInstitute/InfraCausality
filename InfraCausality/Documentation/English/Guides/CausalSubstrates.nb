Cell[CellGroupData[{

Cell["Causal graphs from Riemannian substrates", "GuideFunctionsSubsection",ExpressionUUID->"c4ffc9cd-23d9-4068-81f3-2ddcc2825c61"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "f8f5a3b0-c333-438e-9c4e-ec01cfdf8a1d"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the rank DAG of an undirected substrate from a base point, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Rule]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b700b75-4e7b-45b8-9ef6-6580b687373f"],
 " iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a5f597a-31ba-4c53-a011-21df688414c0"]
}], "GuideText",ExpressionUUID->"8729e7ae-473f-4f43-af28-785f517c7c39"],

