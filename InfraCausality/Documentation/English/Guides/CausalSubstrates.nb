  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519e8bba-b574-4f20-9e48-2cc3628f8b1f"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"cbb4257c-01c9-4d8b-ac40-2ffa8ed34627"],

