    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "dc0b9b6e-99ea-46f7-8272-b5c2dc17d072"],
 " \[LongDash] ",
 "the held code that builds a named causal substrate"
}], "GuideText",ExpressionUUID->"7d4dbf52-0f1e-4398-ac23-54b78108dc06"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Random causal graphs", "GuideFunctionsSubsection",ExpressionUUID->"a735464d-18e1-4381-8c99-9314588fd7cb"],

Cell[TextData[{
