 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3d65a2-0609-418a-b971-85e3b4a76103"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8dde59b-5d61-4b9f-9662-5034ccfc163a"],
 ", of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8595f77e-4d2a-4c04-9b58-99fd35ffc0a1"],
 " edges, or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04362759-c036-4df2-b419-bfa2216ded06"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"88d235ec-7669-4c58-96a7-0f90be11c044"],

