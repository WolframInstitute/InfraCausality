  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "b7ba5762-1241-4f29-b20a-f544754db77d"],
 " \[LongDash] ",
 "a random causal set of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "984ebaef-3434-48f0-8bfd-248714d716ba"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de6b0a5-02a5-491c-b437-af2c2847a6b7"],
 ", of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59c34a71-3b4b-44f9-9576-bc11ffc3de52"],
 " edges, or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a4137d9-6430-4c8c-b9e6-e2a39cb0655e"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"4f4b5ad1-2b22-45c0-8582-3b3eb2117a9a"],

