  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "2bc71ae9-5d9d-4aa7-9a5f-7c56a2ef6f0c"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the rank DAG of an undirected substrate from a base point, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Rule]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c63ef1c-59dc-4299-a743-caaa1de84546"],
 " iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9153290-7865-4739-90cc-8f374e711e72"]
}], "GuideText",ExpressionUUID->"e697f97e-a25d-4c82-aa94-5b53ed979346"],

