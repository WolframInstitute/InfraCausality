  "b570e203-5f7c-4da9-8f85-ac3649ded152"],
 " \[LongDash] ",
 "the options a causal substrate is drawn with at a given size"
}], "GuideText",ExpressionUUID->"88148f3c-b409-4056-992f-fe88dbae5492"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrateCode"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateCode", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "139c71a9-9dfd-4070-9367-6a196692304e"],
 " \[LongDash] ",
 "the held code that builds a named causal substrate"
}], "GuideText",ExpressionUUID->"0f94515c-e77d-42e4-b3ea-9b025d792f5a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Random causal graphs", "GuideFunctionsSubsection",ExpressionUUID->"ab95c0d5-e5e5-42e9-9b25-4a08f4cf1601"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
