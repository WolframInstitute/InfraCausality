  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "080c3cbf-5d5c-4557-bb54-ec87fbaeb6cf"],
 " \[LongDash] ",
 "a random causal set of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42bf603f-14c4-49af-80a5-b52c2c1a1328"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67fb3020-0345-45da-b8e9-403769110083"],
 " (",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Percolation\>\"", ",", " ", "p"}], "}"}]}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "148b8e2b-bd7a-4edd-8a77-909028824d5d"],
 "), of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74656fee-1f52-4532-b9a6-93258ed0263d"],
 " edges (",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"n", ",", " ", "m"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94e7ca55-e469-484e-b554-a34ad877b54f"],
 "), or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "047920ce-7616-4036-b623-204bcad21264"],
 "-dimensional Minkowski space (",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Sprinkling\>\"", ",", " ", "d"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9826f4aa-d9c1-4154-a46c-ec093ade4483"],
 ")"
}], "GuideText",ExpressionUUID->"d1dd6953-9aa8-4166-8920-7e29608acdb1"],

