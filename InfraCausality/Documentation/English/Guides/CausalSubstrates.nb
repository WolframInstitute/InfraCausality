  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a2b563a-1f1c-4d51-ae8b-dd938ea84b23"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"539fe0f3-47a9-46e5-b4d3-5a9765927a7a"],

