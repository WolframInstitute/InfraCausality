  "7ba237f0-80f2-41bb-8fb6-c37fd4d2eb2f"],
 " \[LongDash] ",
 "the options a causal substrate is drawn with at a given size"
}], "GuideText",ExpressionUUID->"b90320d7-694e-4f38-8a0a-94d3a88b360c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CausalSubstrateCode"]], 
    "paclet:WolframInstitute/InfraCausality/ref/CausalSubstrateCode", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "d52cd9dc-ec45-4d52-8ec2-d13443da14fa"],
 " \[LongDash] ",
 "the held code that builds a named causal substrate"
}], "GuideText",ExpressionUUID->"2016e30d-e0b5-4bf1-9afa-54ccb4a19ec8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Random causal graphs", "GuideFunctionsSubsection",ExpressionUUID->"b04ab3fa-9744-4fe5-9ee9-ec12a80f24d2"],

Cell[TextData[{
