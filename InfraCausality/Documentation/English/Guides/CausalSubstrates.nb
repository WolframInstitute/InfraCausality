 " \[LongDash] ",
 "a random causal set of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f40af568-ca8b-402c-b1c2-1e9bacbb7ddf"],
 " events: the Hasse diagram of a transitive percolation with link \
probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ecfc9de-5eb0-4bf2-ac61-d47ba6e3bc1c"],
 ", of a random acyclic orientation with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c8a5cd7-ac4b-492d-b569-946859834b5d"],
 " edges, or of a sprinkling into ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e6489c6-8e94-4bc3-9173-6547d4125dc7"],
 "-dimensional Minkowski space"
}], "GuideText",ExpressionUUID->"b543abc1-f1fc-4c23-8539-2513595ccc70"],

