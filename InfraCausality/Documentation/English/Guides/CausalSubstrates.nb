  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "6948918b-d11c-470b-bcf5-9cf5f021285b"],
 " (InfraGeometry)",
 " \[LongDash] ",
 "the named undirected substrates"
}], "GuideText",ExpressionUUID->"df342b14-2a3a-4853-ba17-7c665ed06809"]
}, Open  ]],

