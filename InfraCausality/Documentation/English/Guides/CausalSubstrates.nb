Cell[CellGroupData[{

Cell["Causal graphs from Riemannian substrates", "GuideFunctionsSubsection",ExpressionUUID->"0d563f85-c4f4-4cb9-9580-4119e3e60519"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
