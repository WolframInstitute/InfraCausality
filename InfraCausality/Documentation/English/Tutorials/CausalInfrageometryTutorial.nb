Cell[TextData[{
 "A substrate is transitively reduced: its edges are the covering pairs, the \
steps with no event between. On the diamond lattice the order is the product \
order (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") \[PrecedesSlantEqual] (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ") \[DoubleLongLeftRightArrow] ",
 StyleBox["i", "TI"],
 " \[LessEqual] ",
 StyleBox["k", "TI"],
 " and ",
 StyleBox["j", "TI"],
 " \[LessEqual] ",
 StyleBox["l", "TI"],
 ", the closed light cone in the coordinates ",
 StyleBox["x", "TI"],
 " = (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2, ",
 StyleBox["t", "TI"],
 " = (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2."
}], "Item",ExpressionUUID->"d9099e28-2ca5-45e4-84c0-a627c69c4a9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "v", "}"}]}], "]"}]}], " ", "===", " ", 
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"w", " ", "|->", " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"v", " ", "<=", " ", "w"}], "]"}]}]}]}], "]"}]}]}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"122c0652-3fe6-495a-8a2d-5a1c91ad8024"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"519b9418-005e-4112-ba98-b498698f9ada"]
}, Open  ]],

Cell["Cones and diamonds", "Section",ExpressionUUID->"056a741a-51d6-41ed-965c-f4222603232d"],

Cell[TextData[{
 "The ",
 StyleBox["causal future",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") is the set of events ",
 StyleBox["p", "TI"],
 " can influence, the ",
 StyleBox["causal past",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the set that can influence ",
 StyleBox["q", "TI"],
 ", and the ",
 StyleBox["causal diamond",
  FontWeight->"Bold"],
 " [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the events between them. The ",
 StyleBox["future light cone",
  FontWeight->"Bold"],
 " ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") keeps the events reached from ",
 StyleBox["p", "TI"],
 " by a light ray, a chain that cannot be lengthened between its ends."
}], "Item",ExpressionUUID->"d4abb836-53d0-4491-8639-d54b85b708b9"],

Cell["\<\
On the lattice: the future of {1, 0} (orange), the past of {5, 4} (blue), \
their diamond (green), and the light cone of {1, 0} (red), its two null lines.\
\>", "Item",ExpressionUUID->"cf4f173f-66c7-40a5-a170-1fa2ed4972a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalPast", "[", 
            RowBox[{"{", 
             RowBox[{"5", ",", " ", "4"}], "}"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalDiamond", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraFutureLightCone", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"400726ab-64e9-480b-a3fa-416f95c6dc4b"],

