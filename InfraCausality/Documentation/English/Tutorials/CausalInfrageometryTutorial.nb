Cell["\<\
Here the observer space is not a fibration. The base edge from the cell {1, \
0} of the first tick into the loop's cell {4, 3} lifts at (1, 1), the first \
event of the ray, and at no other event of the fiber: the loop's interior \
events are not adjacent to (0, 0).\
\>", "Item",ExpressionUUID->"0df0e384-1832-4719-a8c5-a800eff2ada9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}],
        ",", " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{
       RowBox[{"InfraFibers", "[", "fib", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", "[", "loop", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"loop", ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"EdgeQ", "[", 
         RowBox[{
          RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "v"}], "]"}]}], 
         "]"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"abd09d36-e83d-45ae-bdbc-fe14a2041afc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "5"}], "}"}]}], "}"}], ",", "False", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"724fedb6-cd26-4ff9-b6e3-99c9f0b70366"]
}, Open  ]],

Cell["\<\
Being a fibration is thus a property of the substrate as well as of the \
observer. On the sprinkling, too, the chart of a longest chain identifies \
events, 23 events on 15 cells, and is no fibration.\
\>", "Item",ExpressionUUID->"8d5be5d0-199f-4c01-ab57-9c1dea387087"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
        " ", "\"\<Domain\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[25]:= ",ExpressionUUID->"32b271d0-931d-4fb9-b959-c393277224e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"23", ",", "15", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"54c4532c-9f45-4161-8447-8ae0a5188a84"]
}, Open  ]],

Cell["Open questions", "Section",ExpressionUUID->"fa3a455f-2d92-4f28-aa23-62d72b82016a"],

Cell[TextData[{
 "The observer space is handed to InfraGeometry as an undirected fibration, \
because its bundle functions test undirected edges; the causal direction \
survives only in the ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e14e719a-6fe7-4b39-8860-eea1345007a4"],
 " and ",
 Cell[BoxData["\"\<BaseGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df3a4da0-42ea-48ec-ac24-3f2580940c8f"],
 " readings of the chart. Which bundle notions keep their meaning on the \
directed domain?"
}], "Item",ExpressionUUID->"f87452d4-bdbc-4004-bd74-b974d2fc9cbf"],

Cell["\<\
On the sprinkling a single longest chain identifies events and fails the \
lifting condition. How many observers does a joined chart need before the \
observer space of a sprinkling becomes a fibration, and how does that number \
grow with the density?\
\>", "Item",ExpressionUUID->"a0b41bf8-ef35-4822-b666-9acb3fa353c5"],

