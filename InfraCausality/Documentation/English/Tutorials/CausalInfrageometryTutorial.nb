Cell[TextData[{
 "The fibers are the mirror pairs {(",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 ")} and the single events of the diagonal. The fold is a fibration, every \
base edge lifts at every point, but no fiber bundle, since the fibers have \
two sizes. Its two continuous sections are the two sides of the diagonal."
}], "Item",ExpressionUUID->"19bbdc30-037d-4281-b5c5-0e207261fa6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}],
        ",", " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sides", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Values", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", "#"}]}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"RandomInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
        RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", "[", "sides", "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"v", " ", "|->", " ", 
            RowBox[{
             RowBox[{"First", "[", "v", "]"}], " ", ">=", " ", 
             RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"v", " ", "|->", " ", 
            RowBox[{
             RowBox[{"First", "[", "v", "]"}], " ", "<=", " ", 
             RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}]}], "}"}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"58c9ca87-0ba5-4ea6-bfc4-5c2f17a6307d"],

