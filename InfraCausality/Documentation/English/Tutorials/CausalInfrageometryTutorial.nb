Cell["Worldlines and observers", "Section",ExpressionUUID->"2d09986e-0f42-4f17-9c3d-94982c961d7e"],

Cell[TextData[{
 "An ",
 StyleBox["observer",
  FontWeight->"Bold"],
 " is a saturated chain, a directed path of the substrate; its positions are \
the ticks of a clock. A ",
 StyleBox["worldline",
  FontWeight->"Bold"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a longest chain between them, the discrete inertial observer: its \
number of steps is the proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "). The hierarchy of the chain predicates is light ray \
\[DoubleLongRightArrow] worldline \[DoubleLongRightArrow] observer \
\[DoubleLongRightArrow] chain."
}], "Item",ExpressionUUID->"8f927e00-a266-48f9-88a7-70a7d620c184"],

Cell["\<\
A worldline from {0, 0} to {6, 6}, drawn with the diamond it lies in.\
\>", "Item",ExpressionUUID->"bae9a703-cc5c-4cc2-9d8d-23475645be48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalDiamond", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardRed"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"b3dfa9e7-5921-4a2d-b411-80cfa8377983"],

