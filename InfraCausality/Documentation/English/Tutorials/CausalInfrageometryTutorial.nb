Cell[TextData[{
 "The diamond of {1, 0} and {5, 4} is a 5 \[Times] 5 square of the lattice: \
[(",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ")] has (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "Item",ExpressionUUID->"ed0f0dc5-9620-4c9e-a210-e2e0fc93414b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     " ", "\"\<CountingMeasure\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d1a792fb-ded0-4ad0-9c05-7322f29c7d04"],

Cell[BoxData["25"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"c5e95cea-347e-467a-a169-27e9c9b5cff7"]
}, Open  ]],

Cell["\<\
On the sprinkling the light cone of an event is a tree of light rays, not two \
lines: a ray is a maximal chain between its ends, and several can leave an \
event in each direction.\
\>", "Item",ExpressionUUID->"e138390f-133a-41fa-b58c-7df2db17acf2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalFuture", "[", "2", "]"}], " ", "->", " ", 
        RowBox[{"Lighter", "[", 
         RowBox[{"Red", ",", " ", "0.6"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"InfraFutureLightCone", "[", "2", "]"}], " ", "->", " ", 
        "Red"}], ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"86e01c8f-9b00-48f4-a184-72838025b32d"],

