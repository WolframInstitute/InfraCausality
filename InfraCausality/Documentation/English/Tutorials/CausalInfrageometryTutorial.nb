Cell[TextData[{
 "A substrate is transitively reduced: its edges are the covering pairs, the \
steps with no event between. On the diamond lattice the order is the product \
order (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") \[PrecedesSlantEqual] (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ") \[DoubleLongLeftRightArrow] ",
 StyleBox["i", "TI"],
 " \[LessEqual] ",
 StyleBox["k", "TI"],
 " and ",
 StyleBox["j", "TI"],
 " \[LessEqual] ",
 StyleBox["l", "TI"],
 ", the closed light cone in the coordinates ",
 StyleBox["x", "TI"],
 " = (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2, ",
 StyleBox["t", "TI"],
 " = (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2."
}], "Item",ExpressionUUID->"74b37750-a7e2-48bb-8f68-fa1f5c42ac35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "v", "}"}]}], "]"}]}], " ", "===", " ", 
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"w", " ", "|->", " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"v", " ", "<=", " ", "w"}], "]"}]}]}]}], "]"}]}]}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4be6cee4-6212-4956-ae74-135d498666aa"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"91a622c3-e9b1-450b-9eea-c8bfdfab4242"]
}, Open  ]],

Cell["Cones and diamonds", "Section",ExpressionUUID->"2bdee1db-e5e5-4751-ac2f-906b5d1183b4"],

Cell[TextData[{
 "The ",
 StyleBox["causal future",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") is the set of events ",
 StyleBox["p", "TI"],
 " can influence, the ",
 StyleBox["causal past",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the set that can influence ",
 StyleBox["q", "TI"],
 ", and the ",
 StyleBox["causal diamond",
  FontWeight->"Bold"],
 " [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the events between them. The ",
 StyleBox["future light cone",
  FontWeight->"Bold"],
 " ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") keeps the events reached from ",
 StyleBox["p", "TI"],
 " by a light ray, a chain that cannot be lengthened between its ends."
}], "Item",ExpressionUUID->"6c213853-dd1a-45da-8a27-34a28d1816fa"],

Cell["\<\
On the lattice: the future of {1, 0} (red), the past of {5, 4} (blue), their \
diamond (green), and the light cone of {1, 0} (red), its two null lines.\
\>", "Item",ExpressionUUID->"2ad66ca5-76d3-4b02-8fc8-1777cdaf5518"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "Red"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalPast", "[", 
            RowBox[{"{", 
             RowBox[{"5", ",", " ", "4"}], "}"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalDiamond", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraFutureLightCone", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "Red"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"66b12874-75be-489e-aceb-3c2f4a26f1a8"],

