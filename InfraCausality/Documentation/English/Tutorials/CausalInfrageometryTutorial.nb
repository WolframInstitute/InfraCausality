Cell["The radar chart", "Section",ExpressionUUID->"91b57d28-9024-401c-a3ee-5f05c6f73cb8"],

Cell[TextData[{
 "The radar chart of an observer ",
 StyleBox["a", "TI"],
 " = (",
 StyleBox["a", "TI"],
 "1, \[Ellipsis], ",
 StyleBox["ak", "TI"],
 ") gives every event ",
 StyleBox["e", "TI"],
 " of its radar domain [",
 StyleBox["a", "TI"],
 "1, ",
 StyleBox["ak", "TI"],
 "] the emission tick ",
 StyleBox["i", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the latest tick that can signal ",
 StyleBox["e", "TI"],
 ", and the reception tick ",
 StyleBox["j", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the earliest tick ",
 StyleBox["e", "TI"],
 " can signal; its radar time is (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2 and its radar distance (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2. A tick is its own emission and reception."
}], "Item",ExpressionUUID->"a9dab51a-017e-4152-84d5-6ae12c5fe5ac"],

Cell["\<\
The worldline on the lattice (left) and the radar domain redrawn at its chart \
positions, distance across and time up (right). The worldline becomes the \
vertical axis and the lattice unfolds to one side of it.\
\>", "Item",ExpressionUUID->"42807646-c7ea-4eeb-8cdf-4385bcaa9dad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardRed"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardRed"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"abf48a39-c2da-450f-9101-6a5eefa42182"],

