Cell["\<\
On the lattice every observer from corner to corner has twelve steps, so the \
924 = (12 choose 6) observers are all worldlines. On the sprinkling only 21 \
of the 49 observers from the first to the last event are longest chains.\
\>", "Item",ExpressionUUID->"2920193c-c9a2-4c7b-aab7-7b397a2fd4ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lattice", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"sprinkling", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"4cab8c8a-aba7-4416-bf2d-e085732bf761"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"924", ",", "924"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "49"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"02c319f8-00c2-4c61-8add-8b6b2c04cfd1"]
}, Open  ]],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain and no observer: each step (",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ") \[Precedes] (",
 StyleBox["m", "TI"],
 " + 1, ",
 StyleBox["m", "TI"],
 " + 1) has two events between. It will matter below, since the radar chart \
accepts any chain."
}], "Item",ExpressionUUID->"c9203469-cc4e-42ac-8dbd-18adc061d4c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
