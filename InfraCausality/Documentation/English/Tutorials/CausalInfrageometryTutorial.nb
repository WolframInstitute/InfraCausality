     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "5"}], "}"}]}], "}"}], ",", "False", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"e02085eb-b7a6-4105-8d85-f73af45fd560"]
}, Open  ]],

Cell["\<\
Being a fibration is thus a property of the substrate as well as of the \
observer. On the sprinkling, too, the chart of a longest chain identifies \
events, 23 events on 15 cells, and is no fibration.\
\>", "Item",ExpressionUUID->"4aed9b56-4109-4100-8162-1455b6ef02b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", "g", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
        " ", "\"\<Domain\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[25]:= ",ExpressionUUID->"15718e87-d6c6-4624-842d-22a3eb2a9a5c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"23", ",", "15", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"2b926fad-d005-4d6b-bbee-96f165bbe9ee"]
}, Open  ]],

Cell["Open questions", "Section",ExpressionUUID->"e7547e6b-7716-48fc-8f10-0528cd93b26d"],

Cell[TextData[{
 "The observer space is handed to InfraGeometry as an undirected fibration, \
because its bundle functions test undirected edges; the causal direction \
survives only in the ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14263f30-c701-447d-b4ce-749d90478a6a"],
 " and ",
 Cell[BoxData["\"\<BaseGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4d01074-5e09-43c5-a0e1-1c2ef2ea8b6e"],
 " readings of the chart. Which bundle notions keep their meaning on the \
directed domain?"
}], "Item",ExpressionUUID->"6d2f254a-a6eb-4ac8-bad2-f6814f4bb866"],

Cell["\<\
On the sprinkling a single longest chain identifies events and fails the \
lifting condition. How many observers does a joined chart need before the \
observer space of a sprinkling becomes a fibration, and how does that number \
grow with the density?\
\>", "Item",ExpressionUUID->"a7cf8802-2763-498e-a659-92b2979c9fe5"],

