Cell["The cylinder loop", "Subsection",ExpressionUUID->"1ed6a149-2c1e-4fd6-a5f1-ce8387e4a898"],

Cell[TextData[{
 "On the cylinder lattice light can go round the universe. The column {(0, ",
 StyleBox["t", "TI"],
 ")} is a worldline; the light ray (0, 0) \[RightArrow] (1, 1) \[RightArrow] \
\[Ellipsis] \[RightArrow] (5, 5) leaves it and returns to it at (0, 6), so \
the five events of the ray have emission tick 1 and reception tick 7 and \
share the cell {4, 3}. The column (red), its radar domain (green) and the \
loop (orange), beside the base graph."
}], "Item",ExpressionUUID->"91ac9d61-f508-4b6c-ae0c-902d6d930fcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"column", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "column", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraRadarChart", "[", "column", "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "column", "]"}], " ", "->", " ", 
           "StandardRed"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Values", "[", 
              RowBox[{"VertexList", " ", "/@", " ", 
               RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], ",", " ", 
             RowBox[{"f", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Length", "[", "f", "]"}], " ", ">", " ", "1"}]}]}], 
            "]"}], " ", "->", " ", "StandardOrange"}]}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarChart", "[", "column", "]"}], ",", 
        " ", "\"\<BaseGraph\>\""}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"374347ef-fefe-40a2-b460-87de499f9fe7"],

