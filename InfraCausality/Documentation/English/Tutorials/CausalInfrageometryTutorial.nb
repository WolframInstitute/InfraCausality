 CellLabel->"Out[5]= ",ExpressionUUID->"eed819c8-e909-4ef7-aa29-d8e555a7786e"]
}, Open  ]],

Cell["\<\
On the sprinkling the light cone of an event is a tree of light rays, not two \
lines: a ray is a maximal chain between its ends, and several can leave an \
event in each direction.\
\>", "Item",ExpressionUUID->"5cdac494-1ad8-4537-834c-a26ace39679b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalFuture", "[", "2", "]"}], " ", "->", " ", 
        RowBox[{"Lighter", "[", 
         RowBox[{"Red", ",", " ", "0.6"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"InfraFutureLightCone", "[", "2", "]"}], " ", "->", " ", 
        "Red"}], ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"ab6034b6-a1f0-4b23-acd6-85822e0fe10e"],

