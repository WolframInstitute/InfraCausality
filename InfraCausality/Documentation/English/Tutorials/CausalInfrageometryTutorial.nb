Cell["Worldlines and timelike geodesics", "Section",ExpressionUUID->"81271ff8-427a-49e7-838a-6d28fc08e92e"],

Cell[TextData[{
 "A ",
 StyleBox["worldline",
  FontWeight->"Bold"],
 " is a saturated chain, a directed path of the substrate; an ",
 StyleBox["observer",
  FontWeight->"Bold"],
 " is a worldline whose positions are read as the ticks of a clock. A ",
 StyleBox["timelike geodesic",
  FontWeight->"Bold"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a longest chain between them, the discrete inertial observer: its \
number of steps is the proper time \[Tau](",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "). The hierarchy of the chain predicates is light ray \
\[DoubleLongRightArrow] timelike geodesic \[DoubleLongRightArrow] worldline \
\[DoubleLongRightArrow] chain."
}], "Item",ExpressionUUID->"ef9ef37d-c1b7-4ca3-82a5-fdf8242ebeb5"],

Cell["\<\
A timelike geodesic from {0, 0} to {6, 6}, drawn with the diamond it lies in.\
\
\>", "Item",ExpressionUUID->"1e302fd7-fa81-4812-b603-03ae78683fd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalDiamond", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"4c414b73-e7ce-4750-9ae3-e5d6ec9f3bfe"],

