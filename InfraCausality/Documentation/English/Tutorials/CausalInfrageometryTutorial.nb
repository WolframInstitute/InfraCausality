Cell["The observer fibration", "Section",ExpressionUUID->"ef640a6c-353d-40ab-8b58-c62ef2f3986d"],

Cell[TextData[{
 "The ",
 StyleBox["observer space",
  FontWeight->"Bold"],
 " is the radar domain fibered over the chart: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75bde51c-ed19-4982-b2a8-ebed97e5fb3a"],
 " whose total graph is the undirected radar domain and whose projection is \
the chart. Its fibers are the coordinate cells, the events the observer \
cannot tell apart, and the bundle functions of InfraGeometry apply to it \
unchanged. A ",
 StyleBox["section",
  FontWeight->"Bold"],
 " picks one event in every fiber; it is continuous when it maps base edges \
to edges."
}], "Item",ExpressionUUID->"e6cd9a3e-4d5b-442b-a798-c2196ca32454"],

Cell["\<\
For the worldline every fiber is a single event: the fibration is a fiber \
bundle with a point as fiber, and it has exactly one continuous section, the \
inverse of the chart.\
\>", "Item",ExpressionUUID->"ca77e1f6-02cf-40bc-aa8c-f8ee3a35a3ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"e81acfaf-62da-4c88-acc3-9e853f54add4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "True", ",", "True", ",", "1", ",", "True"}],
   "}"}]], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"e7e2c469-6cfe-408c-a636-653d51c7ecce"]
}, Open  ]],

Cell["The diagonal fold", "Subsection",ExpressionUUID->"ebae1343-8f9b-4b35-91a6-77d7935f9ae9"],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain at rest in the middle of the lattice. Radar distance is \
unsigned, so its chart cannot tell left from right: the events (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") and (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 ") get the same coordinates. The lattice with the diagonal (green) and the \
events left of it (blue), beside the domain at its chart positions, where the \
two halves lie on top of each other."
}], "Item",ExpressionUUID->"9bf4b135-3237-4813-adea-c343999853cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{"v", " ", "|->", " ", 
              RowBox[{
               RowBox[{"First", "[", "v", "]"}], " ", "<", " ", 
               RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
           "StandardGreen"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "diagonal", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
          "StandardGreen"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[19]:= ",ExpressionUUID->"c3d44cec-7017-4122-846b-d279540db008"],

