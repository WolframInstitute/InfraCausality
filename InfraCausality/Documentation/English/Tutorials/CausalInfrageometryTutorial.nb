Cell["Message functions", "Section",ExpressionUUID->"475e77ca-5d29-4282-841a-c76ba188eba8"],

Cell[TextData[{
 "Two observers ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " exchange light. The ",
 StyleBox["message relation",
  FontWeight->"Bold"],
 " sends a tick ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["a", "TI"],
 " to the ticks ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") \:2229 ",
 StyleBox["b", "TI"],
 " of ",
 StyleBox["b", "TI"],
 " on its light cone, and a ",
 StyleBox["message function",
  FontWeight->"Bold"],
 " is a single-valued selection of it that preserves the order of the ticks, \
the discrete form of the Ehlers\[Dash]Pirani\[Dash]Schild axiom D1. An ",
 StyleBox["echo function",
  FontWeight->"Bold"],
 " is a message function to ",
 StyleBox["b", "TI"],
 " composed with one back to ",
 StyleBox["a", "TI"],
 "."
}], "Item",ExpressionUUID->"acc3170d-17d6-4f8e-b344-96505be69419"],

Cell[TextData[{
 "The worldline ",
 StyleBox["a", "TI"],
 " above (blue) and a longest chain ",
 StyleBox["b", "TI"],
 " of the rest of the lattice (red), with the light rays that carry the \
messages from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " (orange)."
}], "Item",ExpressionUUID->"f4361838-f7e6-4068-952f-e034e1deb846"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", 
        "StandardOrange"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
        "StandardRed"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"39701965-c1c4-4208-a799-a713003d0ce4"],

