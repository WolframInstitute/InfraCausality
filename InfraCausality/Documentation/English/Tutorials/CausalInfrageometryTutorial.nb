Cell["The observer fibration", "Section",ExpressionUUID->"4b475a77-8d5d-4a88-80cb-f4bad5470ef4"],

Cell[TextData[{
 "The ",
 StyleBox["observer space",
  FontWeight->"Bold"],
 " is the radar domain fibered over the chart: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b4f6589-dcae-47cd-8479-5781afedef45"],
 " whose total graph is the undirected radar domain and whose projection is \
the chart. Its fibers are the coordinate cells, the events the observer \
cannot tell apart, and the bundle functions of InfraGeometry apply to it \
unchanged. A ",
 StyleBox["section",
  FontWeight->"Bold"],
 " picks one event in every fiber; it is continuous when it maps base edges \
to edges."
}], "Item",ExpressionUUID->"2b6f0811-efab-4e14-a302-ce635c0f1db9"],

Cell["\<\
For the worldline every fiber is a single event: the fibration is a fiber \
bundle with a point as fiber, and it has exactly one continuous section, the \
inverse of the chart.\
\>", "Item",ExpressionUUID->"195eac07-8103-499f-8bb2-839b892639a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"83ac7dd1-9c13-4fed-817b-902e8d42021e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "True", ",", "True", ",", "1", ",", "True"}],
   "}"}]], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"3d219452-a3b5-4811-9020-3063f171257e"]
}, Open  ]],

Cell["The diagonal fold", "Subsection",ExpressionUUID->"647db10a-2b7e-4fd3-a832-2bee26136f5d"],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain at rest in the middle of the lattice. Radar distance is \
unsigned, so its chart cannot tell left from right: the events (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") and (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 ") get the same coordinates. The lattice with the diagonal (red) and the \
events left of it (blue), beside the domain at its chart positions, where the \
two halves lie on top of each other."
}], "Item",ExpressionUUID->"1ce61cb9-61b2-4be6-a214-6a23c7a17714"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{"v", " ", "|->", " ", 
              RowBox[{
               RowBox[{"First", "[", "v", "]"}], " ", "<", " ", 
               RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "diagonal", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
          "StandardRed"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"2eecf752-318a-4f00-8edc-db5e91a43700"],

