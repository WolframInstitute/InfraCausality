Cell[TextData[{
 "The chart of this worldline is injective: the 49 events get 49 distinct \
coordinates. Radar time never decreases along an edge, and the ticks sit at {",
 StyleBox["m", "TI"],
 ", 0}."
}], "Item",ExpressionUUID->"ea9265f7-5842-44a6-b5c0-78b675ac3e5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Coordinates\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "coordinates", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", "[", "coordinates", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
       RowBox[{"e", " ", "|->", " ", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"First", " ", "@", " ", "e"}], "]"}], "]"}], " ", "<=", 
         " ", 
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"Last", " ", "@", " ", "e"}], "]"}], "]"}]}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"coordinates", " ", "/@", " ", "a"}], " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"987d83e7-b4b5-41e6-ad30-70335c613430"],

