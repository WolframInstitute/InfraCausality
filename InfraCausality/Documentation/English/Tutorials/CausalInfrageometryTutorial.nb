Cell["\<\
On the lattice every worldline from corner to corner has twelve steps, so the \
924 = (12 choose 6) worldlines are all timelike geodesics. On the sprinkling \
only 21 of the 49 worldlines from the first to the last event are longest \
chains.\
\>", "Item",ExpressionUUID->"7cfce266-df0e-47c6-ae50-d84db9fa7beb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lattice", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"sprinkling", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"4b042fea-4861-4a58-b93b-a6ea08170704"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"924", ",", "924"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "49"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"3f41c852-0b3b-49a3-8098-77dda69b5894"]
}, Open  ]],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain and no worldline: each step (",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ") \[Precedes] (",
 StyleBox["m", "TI"],
 " + 1, ",
 StyleBox["m", "TI"],
 " + 1) has two events between. It will matter below, since the radar \
coordinates accept any chain."
}], "Item",ExpressionUUID->"48c6c354-b385-4917-bfa8-79ea1fd9c366"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", "diagonal"}], "]"}], ",", " ", 
     RowBox[{"InfraWorldlineQ", "[", 
      RowBox[{"g", ",", " ", "diagonal"}], "]"}], ",", " ", 
     RowBox[{"InfraTimelikeGeodesicQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraTimelikeGeodesic", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTimelikeGeodesic", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], 
        ")"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"3658f47d-0037-4064-a566-6b0fc0eb249d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"7687d187-09d2-440e-bf71-e762644c68ed"]
}, Open  ]],

Cell["Causal height", "Section",ExpressionUUID->"b64d4df8-c2c7-43b8-b3a7-ea847e5073fb"],

Cell[TextData[{
 "The ",
 StyleBox["causal height",
  FontWeight->"Bold"],
 " of an event is the length of a longest chain from a source to it, and its \
level sets, the ",
 StyleBox["slices",
  FontWeight->"Bold"],
 ", are antichains that partition the events. They are the simultaneity \
surfaces that need no observer. On the lattice the slices are the \
antidiagonals; on the sprinkling they are ragged."
}], "Item",ExpressionUUID->"78c842e1-b978-4743-941a-5aae2849842b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"CausalHeightFoliation", "[", "g", "]"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"0807a5ae-83a6-4a35-9e0d-32a9fdceff1d"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
