Cell[TextData[{
 "The chart of this observer is injective, axiom D2: the 49 events get 49 \
distinct coordinates. Radar time never decreases along an edge, and the ticks \
sit at {",
 StyleBox["m", "TI"],
 ", 0}."
}], "Item",ExpressionUUID->"27a535a5-c452-4b98-8266-38bed91688c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
       " ", "\"\<Coordinates\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EPSRadarAxiomQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "a", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "coordinates", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", "[", "coordinates", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
       RowBox[{"e", " ", "|->", " ", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"First", " ", "@", " ", "e"}], "]"}], "]"}], " ", "<=", 
         " ", 
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"Last", " ", "@", " ", "e"}], "]"}], "]"}]}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"coordinates", " ", "/@", " ", "a"}], " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"f8b20420-a7ad-400c-a89d-eeb0cdedda74"],

