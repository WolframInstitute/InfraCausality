Notebook[{

Cell[CellGroupData[{
Cell["\<\
Causal Infrageometry: from a Causal Graph to the Observer Space\
\>", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["causal graph",
  FontWeight->"Bold"],
 " is a directed acyclic graph whose vertices are events and whose directed \
paths are the causal relation: ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 " when a path leads from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Everything below is read off the graph alone."
}], "Item",ExpressionUUID->"4b672a2b-8488-452f-a13d-45eca83de662"],

Cell["\<\
The pipeline: causal graph \[RightArrow] cones and diamonds \[RightArrow] \
worldlines and timelike geodesics \[RightArrow] causal height \[RightArrow] \
message functions \[RightArrow] radar coordinates \[RightArrow] the observer \
space fibered over the chart.\
\>", "Item",ExpressionUUID->"854c4d66-0abe-4cd2-93f8-0c23297b9075"],

Cell[TextData[{
 "Each construction is an inert head, such as ",
 Cell[BoxData[
  RowBox[{"InfraCausalDiamond", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb8260dc-0516-474f-b9ca-08c1c5053a5d"],
 " or ",
 Cell[BoxData[
  RowBox[{"InfraRadarCoordinates", "[", "a", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8aef682c-3c9a-4c4f-8cb0-fdc164a23a92"],
 ", that holds its data and computes nothing; ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ac89840-0f3d-4a7d-a72b-19231e9df27b"],
 " reads it on a graph, a ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fb476c-9c0a-4bde-a989-23a993b50852"],
 " sampler draws the members of a chain head and ",
 Cell[BoxData["InfraSubstrateHighlight"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02d6ba8b-3088-45bd-abd2-9eee4edef0c7"],
 " draws it."
}], "Item",ExpressionUUID->"5f542b27-1df6-4691-aa99-fea4ee0e5fcb"],

Cell["\<\
The running example is the diamond lattice at size \"Small\", the 7 \[Times] \
7 light-cone lattice of 1 + 1 Minkowski space; a sprinkling and the cylinder \
lattice show where the lattice is special.\
\>", "Item",ExpressionUUID->"ecff0652-d429-4a78-8cae-3c4afc3756ff"],

Cell["Setup", "Section",ExpressionUUID->"133ba0f3-ea65-4ba9-a59d-c270a9d55a02"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraCausality`\>\"", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"81647ffd-3752-4694-84c8-6420642a23b0"],

Cell["The causal graph", "Section",ExpressionUUID->"24eda952-383e-4249-b157-a531fc9f0998"],

Cell["\<\
The three substrates of the documentation: the diamond lattice, the Hasse \
diagram of the product order on {0, \[Ellipsis], 6}\.b2; a sprinkling of 25 \
points into a causal diamond of two-dimensional Minkowski space; and the \
cylinder lattice, a light-cone lattice closed in space. Time runs upward.\
\>", "Item",ExpressionUUID->"a638483a-305f-4fdd-8a30-fa325d7a3a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", 
     RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a030baf4-0291-43fe-85ff-3ac9040865e4"],

