Cell["\<\
Here the observer space is not a fibration. The base edge from the cell {1, \
0} of the first tick into the loop's cell {4, 3} lifts at (1, 1), the first \
event of the ray, and at no other event of the fiber: the loop's interior \
events are not adjacent to (0, 0).\
\>", "Item",ExpressionUUID->"1b7cf1e2-c7bc-4a85-acd9-e25dbf6093dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}],
        ",", " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{
       RowBox[{"InfraFibers", "[", "fib", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", "[", "loop", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"loop", ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"EdgeQ", "[", 
         RowBox[{
          RowBox[{"InfraTotalSpace", "[", "fib", "]"}], ",", " ", 
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "v"}], "]"}]}], 
         "]"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"3f0acc29-92c5-452b-a2bc-52c4d4d65e5b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "5"}], "}"}]}], "}"}], ",", "False", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"11b2b4c6-a56a-4975-9768-18be1f31b393"]
}, Open  ]],

Cell["\<\
Being a fibration is thus a property of the substrate as well as of the \
observer. On the sprinkling, too, the chart of a longest chain identifies \
events, 23 events on 15 cells, and is no fibration.\
\>", "Item",ExpressionUUID->"16336679-4767-42b9-8073-11199e87e218"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", "g", "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
        " ", "\"\<Domain\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[25]:= ",ExpressionUUID->"c665f7e4-1ec6-41c5-baf3-14242b60e6c4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"23", ",", "15", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"0850f660-f00a-405a-8375-014415034a3d"]
}, Open  ]],

Cell["Open questions", "Section",ExpressionUUID->"fb98ea69-d82a-42a2-b78f-19a65bd18d95"],

Cell[TextData[{
 "The observer space is handed to InfraGeometry as an undirected fibration, \
because its bundle functions test undirected edges; the causal direction \
survives only in the ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f74f9262-bfe8-422d-bb2a-edd5597a934b"],
 " and ",
 Cell[BoxData["\"\<BaseGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d87374ab-367f-493a-987d-2fdda643cb4c"],
 " readings of the chart. Which bundle notions keep their meaning on the \
directed domain?"
}], "Item",ExpressionUUID->"d0981074-e95b-4257-ae93-5d393f3131e8"],

Cell["\<\
On the sprinkling a single longest chain identifies events and fails the \
lifting condition. How many observers do joined radar coordinates need before \
the observer space of a sprinkling becomes a fibration, and how does that \
number grow with the density?\
\>", "Item",ExpressionUUID->"38c8840b-3caf-490e-9b9c-11c6582950a5"],

