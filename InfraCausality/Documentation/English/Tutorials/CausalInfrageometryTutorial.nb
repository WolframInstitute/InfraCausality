Cell[TextData[{
 "The fibers are the mirror pairs {(",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 ")} and the single events of the diagonal. The fold is a fibration, every \
base edge lifts at every point, but no fiber bundle, since the fibers have \
two sizes. Its two continuous sections are the two sides of the diagonal."
}], "Item",ExpressionUUID->"7a009e0c-952b-4a8a-bbd8-43c100be2061"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}],
        ",", " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sides", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Values", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", "#"}]}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"FindInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", "[", "sides", "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"v", " ", "|->", " ", 
            RowBox[{
             RowBox[{"First", "[", "v", "]"}], " ", ">=", " ", 
             RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}], ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"v", " ", "|->", " ", 
            RowBox[{
             RowBox[{"First", "[", "v", "]"}], " ", "<=", " ", 
             RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}]}], "}"}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"fe441a30-6e1c-4bec-9640-be6fc27a4a56"],

