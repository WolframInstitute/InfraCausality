Cell["\<\
Here the observer space is not a fibration. The base edge from the cell {1, \
0} of the first tick into the loop's cell {4, 3} lifts at (1, 1), the first \
event of the ray, and at no other event of the fiber: the loop's interior \
events are not adjacent to (0, 0).\
\>", "Item",ExpressionUUID->"1d5ef4b3-b27a-4caa-8194-1199703179af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}],
        ",", " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{
       RowBox[{"InfraFibers", "[", "fib", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", "[", "loop", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"loop", ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"EdgeQ", "[", 
         RowBox[{
          RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "v"}], "]"}]}], 
         "]"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"c836804c-2ee9-48f3-8fba-26d8b6c1a1f2"],

