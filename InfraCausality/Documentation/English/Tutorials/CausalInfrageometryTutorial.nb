Cell[TextData[{
 "A second observer unfolds the mirror. The chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 1)} runs beside the diagonal; on the 36 events both observers chart, the \
joined chart, the two charts concatenated, is injective, and every fiber is a \
single event."
}], "Item",ExpressionUUID->"55d4b428-8d3c-4b67-90c3-cde2835b2232"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chart", " ", "=", " ", 
     RowBox[{"InfraRadarChart", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", 
            RowBox[{"m", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "chart", ",", " ", "\"\<Coordinates\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "coordinates", "]"}], ",", " ", 
     RowBox[{"DuplicateFreeQ", " ", "@", " ", 
      RowBox[{"Values", "[", "coordinates", "]"}]}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "chart", ",", " ", "\"\<Fibration\>\""}], 
          "]"}]}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"04a98992-7dad-49c9-bc0f-444b3576fe09"],

