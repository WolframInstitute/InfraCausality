          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], " ", "->", " ", 
        "StandardGreen"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
