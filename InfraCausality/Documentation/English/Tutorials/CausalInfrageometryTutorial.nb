Cell[TextData[{
 "The diamond of {1, 0} and {5, 4} is a 5 \[Times] 5 square of the lattice: \
[(",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ")] has (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "Item",ExpressionUUID->"187559ca-836f-47a0-9239-2f03de4c20fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     " ", "\"\<CountingMeasure\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"be1650be-730b-4e78-a159-87a16a639c01"],

