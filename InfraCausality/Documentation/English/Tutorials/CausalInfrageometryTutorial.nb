Cell["The radar chart", "Section",ExpressionUUID->"e8890dc8-e4f8-4cbd-aade-ae38164be142"],

Cell[TextData[{
 "The radar chart of an observer ",
 StyleBox["a", "TI"],
 " = (",
 StyleBox["a", "TI"],
 "1, \[Ellipsis], ",
 StyleBox["ak", "TI"],
 ") gives every event ",
 StyleBox["e", "TI"],
 " of its radar domain [",
 StyleBox["a", "TI"],
 "1, ",
 StyleBox["ak", "TI"],
 "] the emission tick ",
 StyleBox["i", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the latest tick that can signal ",
 StyleBox["e", "TI"],
 ", and the reception tick ",
 StyleBox["j", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the earliest tick ",
 StyleBox["e", "TI"],
 " can signal; its radar time is (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2 and its radar distance (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2. A tick is its own emission and reception."
}], "Item",ExpressionUUID->"c01b6f6a-3ad7-4a63-8501-c7edebfae46b"],

Cell["\<\
The worldline on the lattice (left) and the radar domain redrawn at its chart \
positions, distance across and time up (right). The worldline becomes the \
vertical axis and the lattice unfolds to one side of it.\
\>", "Item",ExpressionUUID->"8cf78e80-b6fb-4444-9e4c-088bdb228419"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardBlue"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardBlue"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[15]:= ",ExpressionUUID->"69683f79-2c6a-41ad-8c88-009494f2d060"],

