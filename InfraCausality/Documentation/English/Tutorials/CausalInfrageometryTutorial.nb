Cell[TextData[{
 "The chart of this worldline is injective: the 49 events get 49 distinct \
coordinates. Radar time never decreases along an edge, and the ticks sit at {",
 StyleBox["m", "TI"],
 ", 0}."
}], "Item",ExpressionUUID->"3f03168b-8e0c-4e58-aa25-c8f1c0e89454"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "a", "]"}], ",", 
       " ", "\"\<Coordinates\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "coordinates", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", "[", "coordinates", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
       RowBox[{"e", " ", "|->", " ", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"First", " ", "@", " ", "e"}], "]"}], "]"}], " ", "<=", 
         " ", 
         RowBox[{"First", "[", 
          RowBox[{"coordinates", "[", 
           RowBox[{"Last", " ", "@", " ", "e"}], "]"}], "]"}]}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"coordinates", " ", "/@", " ", "a"}], " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"20a40b9a-b966-408f-a30a-c5e32f13af2d"],

Cell[BoxData[
 RowBox[{"{", 
