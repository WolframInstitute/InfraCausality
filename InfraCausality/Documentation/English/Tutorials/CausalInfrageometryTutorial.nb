Cell["Axiom D1: message and echo functions", "Section",ExpressionUUID->"e4f37a24-20fc-4c97-87d1-67bceaf61ad0"],

Cell[TextData[{
 "Two observers ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " exchange light. The ",
 StyleBox["message relation",
  FontWeight->"Bold"],
 " sends a tick ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["a", "TI"],
 " to the ticks ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["v", "TI"],
 ") \:2229 ",
 StyleBox["b", "TI"],
 " of ",
 StyleBox["b", "TI"],
 " on its light cone, and a ",
 StyleBox["message function",
  FontWeight->"Bold"],
 " is a single-valued selection of it that preserves the order of the ticks, \
the discrete form of the EPS axiom D1. An ",
 StyleBox["echo function",
  FontWeight->"Bold"],
 " is a message function to ",
 StyleBox["b", "TI"],
 " composed with one back to ",
 StyleBox["a", "TI"],
 "."
}], "Item",ExpressionUUID->"5c3552a5-d9d2-4743-968f-4e526cf379ff"],

Cell[TextData[{
 "The geodesic ",
 StyleBox["a", "TI"],
 " above (blue) and a longest chain ",
 StyleBox["b", "TI"],
 " of the rest of the lattice (green), with the light rays that carry the \
messages from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " (red)."
}], "Item",ExpressionUUID->"d1f3ae78-8fb3-47c5-99a0-39a83616d190"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", "Red"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
        "StandardGreen"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"e77ade4c-c2af-4965-bc17-0cb2bed34463"],

