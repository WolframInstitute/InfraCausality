Cell["Universal time", "Section",ExpressionUUID->"89a87020-20df-4140-b716-13134e90f397"],

Cell[TextData[{
 "The ",
 StyleBox["universal time",
  FontWeight->"Bold"],
 " of an event is the length of a longest chain from a source to it, and its \
level sets, the ",
 StyleBox["slices",
  FontWeight->"Bold"],
 ", are antichains that partition the events. They are the simultaneity \
surfaces that need no observer. On the lattice the slices are the \
antidiagonals; on the sprinkling they are ragged."
}], "Item",ExpressionUUID->"2694742a-8fd8-46a0-a44c-cb32b1be52bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"UniversalFoliation", "[", "g", "]"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"da61d15b-2e65-4bc9-958c-6f6dc060ce76"],

