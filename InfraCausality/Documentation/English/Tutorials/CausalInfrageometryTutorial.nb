Cell["The observer space", "Section",ExpressionUUID->"a143c557-4eaf-4628-8d9e-628ee012b8b7"],

Cell[TextData[{
 "The ",
 StyleBox["observer space",
  FontWeight->"Bold"],
 " is the radar domain fibered over the chart: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88a6e9d4-c5d6-4806-b3f3-79df8fe729e5"],
 " whose total graph is the undirected radar domain and whose projection is \
the chart. Its fibers are the coordinate cells, the events the observer \
cannot tell apart, and the bundle functions of InfraGeometry apply to it \
unchanged. A ",
 StyleBox["section",
  FontWeight->"Bold"],
 " picks one event in every fiber; it is continuous when it maps base edges \
to edges."
}], "Item",ExpressionUUID->"3e5212c9-3358-425b-9154-fcc8b997dbb0"],

Cell[TextData[{
 "For the observer ",
 StyleBox["a", "TI"],
 " every fiber is a single event: the fibration is a fiber bundle with a \
point as fiber, and it has exactly one continuous section, the inverse of the \
chart."
}], "Item",ExpressionUUID->"4b027daa-c6c2-45f1-ae7e-8a9d2b419b92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
        RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"d5748896-f6fd-4d0c-8d25-183bafa4d840"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "True", ",", "True", ",", "1", ",", "True"}],
   "}"}]], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"2fbd96de-40fe-4a47-a030-36bbfe82fa32"]
}, Open  ]],

Cell["The diagonal fold", "Subsection",ExpressionUUID->"4032d929-5a74-4c8a-b8d1-d5afe245b558"],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain at rest in the middle of the lattice. Radar distance is \
unsigned, so its chart cannot tell left from right: the events (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") and (",
 StyleBox["j", "TI"],
 ", ",
 StyleBox["i", "TI"],
 ") get the same coordinates. The lattice with the diagonal (green) and the \
events left of it (blue), beside the domain at its chart positions, where the \
two halves lie on top of each other."
}], "Item",ExpressionUUID->"6c73e41b-0607-4b6b-8748-af5bb64ac5e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{"v", " ", "|->", " ", 
              RowBox[{
               RowBox[{"First", "[", "v", "]"}], " ", "<", " ", 
               RowBox[{"Last", "[", "v", "]"}]}]}]}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
           "StandardGreen"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarCoordinates", "[", "diagonal", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "diagonal", "]"}], " ", "->", " ", 
          "StandardGreen"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",\

 CellLabel->
