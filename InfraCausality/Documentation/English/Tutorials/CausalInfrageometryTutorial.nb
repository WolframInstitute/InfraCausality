Cell["The cylinder loop", "Subsection",ExpressionUUID->"775ebc3c-febf-4be0-a10c-c9064287074f"],

Cell[TextData[{
 "On the cylinder lattice light can go round the universe. The column {(0, ",
 StyleBox["t", "TI"],
 ")} is a timelike geodesic; the light ray (0, 0) \[RightArrow] (1, 1) \
\[RightArrow] \[Ellipsis] \[RightArrow] (5, 5) leaves it and returns to it at \
(0, 6), so the five events of the ray have emission tick 1 and reception tick \
7 and share the cell {4, 3}. The column (blue), its radar domain (purple) and \
the loop (green), beside the base graph."
}], "Item",ExpressionUUID->"53c01154-c823-4f78-a74a-7bf5782451ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"column", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarCoordinates", "[", "column", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraRadarCoordinates", "[", "column", "]"}], " ", "->", 
           " ", "StandardPurple"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "column", "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Values", "[", 
              RowBox[{"VertexList", " ", "/@", " ", 
               RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], ",", " ", 
             RowBox[{"f", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Length", "[", "f", "]"}], " ", ">", " ", "1"}]}]}], 
            "]"}], " ", "->", " ", "StandardGreen"}]}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarCoordinates", "[", "column", "]"}], ",", 
        " ", "\"\<BaseGraph\>\""}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"1977b985-6bd4-414f-9e28-13419819de06"],

