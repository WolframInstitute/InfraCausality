Cell[TextData[{
 "The ticks of a timelike geodesic from a source count the causal height: the \
",
 StyleBox["m", "TI"],
 "-th tick of the geodesic ",
 StyleBox["a", "TI"],
 " above lies on the slice ",
 StyleBox["m", "TI"],
 " \[Minus] 1."
}], "Item",ExpressionUUID->"2c6c9371-ce4a-44dc-b725-cd12feff7273"],

