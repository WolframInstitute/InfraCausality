Cell[TextData[{
 "The ticks of a worldline from a source count universal time: the ",
 StyleBox["m", "TI"],
 "-th tick of the worldline above lies on the slice ",
 StyleBox["m", "TI"],
 " \[Minus] 1."
}], "Item",ExpressionUUID->"51de668e-9fcf-49f3-b39e-bb19cab180b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"UniversalTime", "[", "g", "]"}], " ", "/@", " ", "a"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"57bc20c1-6bf5-42eb-bdd1-96ba7f5d874e"],

