Cell[TextData[{
 "A second observer unfolds the mirror. The chain {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " + 1)} runs beside the diagonal; on the 36 events both observers chart, the \
joined radar coordinates, the two charts concatenated, are injective, and \
every fiber is a single event."
}], "Item",ExpressionUUID->"36847680-81af-4429-b758-a558c4f54356"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chart", " ", "=", " ", 
     RowBox[{"InfraRadarCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", 
            RowBox[{"m", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "chart", ",", " ", "\"\<Coordinates\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "coordinates", "]"}], ",", " ", 
     RowBox[{"DuplicateFreeQ", " ", "@", " ", 
      RowBox[{"Values", "[", "coordinates", "]"}]}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "chart", ",", " ", "\"\<Fibration\>\""}], 
          "]"}]}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
