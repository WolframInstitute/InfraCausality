    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWorldline", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}], "]"}]}], ")"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraMessageFunction", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", "Red"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
        "StandardBlue"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraWalk", "[", "b", "]"}], " ", "->", " ", 
        "StandardGreen"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
