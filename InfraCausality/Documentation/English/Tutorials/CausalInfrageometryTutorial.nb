Cell["\<\
On the lattice every observer from corner to corner has twelve steps, so the \
924 = (12 choose 6) observers are all worldlines. On the sprinkling only 21 \
of the 49 observers from the first to the last event are longest chains.\
\>", "Item",ExpressionUUID->"8d576e5a-cbb2-489b-b5bb-ed3fecd1f872"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lattice", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"sprinkling", " ", "=", " ", 
      RowBox[{"CausalSubstrate", "[", 
       RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"lattice", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraWorldline", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"sprinkling", ",", " ", 
         RowBox[{"InfraObserver", "[", 
          RowBox[{"1", ",", " ", "25"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"6d937e0e-08f3-408b-bb8e-21f6d7e866dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"924", ",", "924"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"21", ",", "49"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"46e97a65-187d-46cf-b379-7b60a546f670"]
}, Open  ]],

Cell[TextData[{
 "The diagonal {(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ")} is a chain and no observer: each step (",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ") \[Precedes] (",
 StyleBox["m", "TI"],
 " + 1, ",
 StyleBox["m", "TI"],
 " + 1) has two events between. It will matter below, since the radar chart \
accepts any chain."
}], "Item",ExpressionUUID->"bc01c53e-aca7-4b15-8141-1b65d5f077f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraChainQ", "[", 
      RowBox[{"g", ",", " ", "diagonal"}], "]"}], ",", " ", 
     RowBox[{"InfraObserverQ", "[", 
      RowBox[{"g", ",", " ", "diagonal"}], "]"}], ",", " ", 
     RowBox[{"InfraWorldlineQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraWorldline", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraWorldline", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], 
        ")"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"21ea6c32-9ca2-44d2-b35a-72c8e9182f6a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"a07dd9d5-8f4f-4131-98a9-9e1df2a99672"]
}, Open  ]],

Cell["Universal time", "Section",ExpressionUUID->"9ebeacc4-c598-4716-ba01-3127635c923d"],

Cell[TextData[{
 "The ",
 StyleBox["universal time",
  FontWeight->"Bold"],
 " of an event is the length of a longest chain from a source to it, and its \
level sets, the ",
 StyleBox["slices",
  FontWeight->"Bold"],
 ", are antichains that partition the events. They are the simultaneity \
surfaces that need no observer. On the lattice the slices are the \
antidiagonals; on the sprinkling they are ragged."
}], "Item",ExpressionUUID->"4fd4c17f-c56c-4cd8-a8d6-a89166986daf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"CausalSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"UniversalFoliation", "[", "g", "]"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"4cf77f3e-40fa-42fe-b1de-b0e899477a1c"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
       NamespaceBox["NetworkGraphics",
