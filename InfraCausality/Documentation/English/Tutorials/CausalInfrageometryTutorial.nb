Cell["The cylinder loop", "Subsection",ExpressionUUID->"adeb711e-33d5-4480-9e21-e19f87be855a"],

Cell[TextData[{
 "On the cylinder lattice light can go round the universe. The column {(0, ",
 StyleBox["t", "TI"],
 ")} is a worldline; the light ray (0, 0) \[RightArrow] (1, 1) \[RightArrow] \
\[Ellipsis] \[RightArrow] (5, 5) leaves it and returns to it at (0, 6), so \
the five events of the ray have emission tick 1 and reception tick 7 and \
share the cell {4, 3}. The column (blue), its radar domain (purple) and the \
loop (green), beside the base graph."
}], "Item",ExpressionUUID->"c7abe568-e6ff-4208-b000-4b2b7718362b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<CylinderLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"column", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "t"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRadarChart", "[", "column", "]"}], ",", 
       " ", "\"\<Fibration\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraRadarChart", "[", "column", "]"}], " ", "->", " ", 
           "StandardPurple"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "column", "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Values", "[", 
              RowBox[{"VertexList", " ", "/@", " ", 
               RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], ",", " ", 
             RowBox[{"f", " ", "|->", " ", 
              RowBox[{
               RowBox[{"Length", "[", "f", "]"}], " ", ">", " ", "1"}]}]}], 
            "]"}], " ", "->", " ", "StandardGreen"}]}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraRadarChart", "[", "column", "]"}], ",", 
        " ", "\"\<BaseGraph\>\""}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"98e87492-b956-4acf-a374-203ace7bbe4a"],

