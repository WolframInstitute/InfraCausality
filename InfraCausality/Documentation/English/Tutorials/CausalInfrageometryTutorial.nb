Cell[TextData[{
 "The diamond of {1, 0} and {5, 4} is a 5 \[Times] 5 square of the lattice: \
[(",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "), (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ")] has (",
 StyleBox["k", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " + 1)(",
 StyleBox["l", "TI"],
 " \[Minus] ",
 StyleBox["j", "TI"],
 " + 1) events."
}], "Item",ExpressionUUID->"86cf40b7-71ff-439a-8fa0-38295c1b3801"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraCausalDiamond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     " ", "\"\<CountingMeasure\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d38791a2-080a-4a32-addc-114215039537"],

Cell[BoxData["25"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"33cb8755-14fd-492f-9b5e-3d84627173f7"]
}, Open  ]],

Cell["\<\
On the sprinkling the light cone of an event is a tree of light rays, not two \
lines: a ray is a maximal chain between its ends, and several can leave an \
event in each direction.\
\>", "Item",ExpressionUUID->"8744c4d2-fe77-434d-8a94-632a5ed1a0da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<MinkowskiSprinkling2D\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCausalFuture", "[", "2", "]"}], " ", "->", " ", 
        "StandardOrange"}], ",", " ", 
       RowBox[{
        RowBox[{"InfraFutureLightCone", "[", "2", "]"}], " ", "->", " ", 
        "StandardRed"}], ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"346af763-dbe2-4129-81b9-f6b491e86fbf"],

