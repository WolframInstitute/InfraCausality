Notebook[{

Cell[CellGroupData[{
Cell["\<\
Causal Infrageometry: from a Causal Graph to the Observer Space\
\>", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["causal graph",
  FontWeight->"Bold"],
 " is a directed acyclic graph whose vertices are events and whose directed \
paths are the causal relation: ",
 StyleBox["u", "TI"],
 " \[PrecedesSlantEqual] ",
 StyleBox["v", "TI"],
 " when a path leads from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Everything below is read off the graph alone."
}], "Item",ExpressionUUID->"260249b2-4fef-47e1-aae1-ca3f064a3e80"],

Cell["\<\
The pipeline: causal graph \[RightArrow] cones and diamonds \[RightArrow] \
worldlines and observers \[RightArrow] universal time \[RightArrow] message \
functions \[RightArrow] radar chart \[RightArrow] the observer space fibered \
over the chart.\
\>", "Item",ExpressionUUID->"293cd863-5e4b-4394-b836-5a6d6585ff25"],

Cell[TextData[{
 "Each construction is an inert head, such as ",
 Cell[BoxData[
  RowBox[{"InfraCausalDiamond", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eecf755-a81b-431e-b656-18a0d37886b9"],
 " or ",
 Cell[BoxData[
  RowBox[{"InfraRadarChart", "[", "a", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178e175a-9199-40fa-b1a9-98c90a17957e"],
 ", that holds its data and computes nothing; ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56746dd7-6615-4ffa-8583-7fb988373505"],
 " reads it on a graph, a ",
 Cell[BoxData["RandomInfra\[Ellipsis]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f07e4e21-70fd-42f1-bd79-5b6910ffffb1"],
 " sampler draws its members and ",
 Cell[BoxData["InfraSubstrateHighlight"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "098610ed-ec25-437f-9ecf-f227f57ca291"],
 " draws it."
}], "Item",ExpressionUUID->"50d7652c-9eb5-46cc-b911-15908feadcc4"],

Cell["\<\
The running example is the diamond lattice at size \"Small\", the 7 \[Times] \
7 light-cone lattice of 1 + 1 Minkowski space; a sprinkling and the cylinder \
lattice show where the lattice is special.\
\>", "Item",ExpressionUUID->"28581a87-b972-4259-a200-5e4caa765461"],

Cell["Setup", "Section",ExpressionUUID->"eeeb708c-c923-4b74-821c-e9e89c9180b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraCausality`\>\"", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"01c3c2fa-c077-4212-abdc-1286d55d9f10"],

Cell["The causal graph", "Section",ExpressionUUID->"ab21cf7a-c8b4-4d0c-9649-a29a3767df32"],

Cell["\<\
The three substrates of the documentation: the diamond lattice, the Hasse \
diagram of the product order on {0, \[Ellipsis], 6}\.b2; a sprinkling of 25 \
points into a causal diamond of two-dimensional Minkowski space; and the \
cylinder lattice, a light-cone lattice closed in space. Time runs upward.\
\>", "Item",ExpressionUUID->"7df30bf9-cae1-4643-83a3-2676b277262a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"CausalSubstrate", "[", 
     RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", 
        " ", "\"\<MinkowskiSprinkling2D\>\"", ",", 
        " ", "\"\<CylinderLatticeGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"59f50ce5-06dc-4211-8af4-256b1e3b1b68"],

