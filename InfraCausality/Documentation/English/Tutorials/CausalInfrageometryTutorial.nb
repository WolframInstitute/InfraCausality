Cell[TextData[{
 "A substrate is transitively reduced: its edges are the covering pairs, the \
steps with no event between. On the diamond lattice the order is the product \
order (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") \[PrecedesSlantEqual] (",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["l", "TI"],
 ") \[DoubleLongLeftRightArrow] ",
 StyleBox["i", "TI"],
 " \[LessEqual] ",
 StyleBox["k", "TI"],
 " and ",
 StyleBox["j", "TI"],
 " \[LessEqual] ",
 StyleBox["l", "TI"],
 ", the closed light cone in the coordinates ",
 StyleBox["x", "TI"],
 " = (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2, ",
 StyleBox["t", "TI"],
 " = (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2."
}], "Item",ExpressionUUID->"c10b5d81-5fb7-41bd-8bdd-f29135dae2f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "v", "}"}]}], "]"}]}], " ", "===", " ", 
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"w", " ", "|->", " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"v", " ", "<=", " ", "w"}], "]"}]}]}]}], "]"}]}]}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"bb1fc88d-6840-4a62-a7c8-d876a3e1b25c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"cb952e4d-f84c-4b22-bff4-623c683cfc08"]
}, Open  ]],

Cell["Cones and diamonds", "Section",ExpressionUUID->"08d38930-9a95-4f5b-9c3d-6871bb5aad02"],

Cell[TextData[{
 "The ",
 StyleBox["causal future",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") is the set of events ",
 StyleBox["p", "TI"],
 " can influence, the ",
 StyleBox["causal past",
  FontWeight->"Bold"],
 " ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the set that can influence ",
 StyleBox["q", "TI"],
 ", and the ",
 StyleBox["causal diamond",
  FontWeight->"Bold"],
 " [",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "] = ",
 StyleBox["J", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") \:2229 ",
 StyleBox["J", "TI"],
 "\:207b(",
 StyleBox["q", "TI"],
 ") the events between them. The ",
 StyleBox["future light cone",
  FontWeight->"Bold"],
 " ",
 StyleBox["E", "TI"],
 "\:207a(",
 StyleBox["p", "TI"],
 ") keeps the events reached from ",
 StyleBox["p", "TI"],
 " by a light ray, a chain that cannot be lengthened between its ends."
}], "Item",ExpressionUUID->"01baa213-aea2-4df3-b048-f07c10b33f42"],

Cell["\<\
On the lattice: the future of {1, 0} (red), the past of {5, 4} (blue), their \
diamond (green), and the light cone of {1, 0} (red), its two null lines.\
\>", "Item",ExpressionUUID->"078b9f56-6459-413f-8ed7-b84180ba468b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalFuture", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "Red"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraCausalPast", "[", 
            RowBox[{"{", 
             RowBox[{"5", ",", " ", "4"}], "}"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCausalDiamond", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraFutureLightCone", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
           "Red"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f04b26ec-ec54-4467-8631-7d5ecd1873ff"],

