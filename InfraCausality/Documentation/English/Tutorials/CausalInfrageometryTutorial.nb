Cell["Axiom D2: radar coordinates", "Section",ExpressionUUID->"6e594102-979a-45d4-857e-3ec8ed264278"],

Cell[TextData[{
 "The radar coordinates of an observer ",
 StyleBox["a", "TI"],
 " = (",
 StyleBox["a", "TI"],
 "1, \[Ellipsis], ",
 StyleBox["ak", "TI"],
 ") give every event ",
 StyleBox["e", "TI"],
 " of its radar domain [",
 StyleBox["a", "TI"],
 "1, ",
 StyleBox["ak", "TI"],
 "] the emission tick ",
 StyleBox["i", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the latest tick that can signal ",
 StyleBox["e", "TI"],
 ", and the reception tick ",
 StyleBox["j", "TI"],
 "(",
 StyleBox["e", "TI"],
 "), the earliest tick ",
 StyleBox["e", "TI"],
 " can signal; its radar time is (",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["j", "TI"],
 ")/2 and its radar distance (",
 StyleBox["j", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ")/2. A tick is its own emission and reception."
}], "Item",ExpressionUUID->"834c5735-ca09-412b-ad69-486b9d9a18a3"],

Cell[TextData[{
 "The observer ",
 StyleBox["a", "TI"],
 " on the lattice (left) and the radar domain redrawn at its chart positions, \
distance across and time up (right). The observer becomes the vertical axis \
and the lattice unfolds to one side of it."
}], "Item",ExpressionUUID->"706fbc78-8c47-49c1-99e7-48574b4b863c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CausalSubstrate", "[", 
      RowBox[{"\"\<DiamondLatticeGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraTimelikeGeodesic", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTimelikeGeodesic", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardBlue"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraRadarCoordinates", "[", "a", "]"}], ",", 
          " ", "\"\<Subgraph\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "a", "]"}], " ", "->", " ", 
          "StandardBlue"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",\

