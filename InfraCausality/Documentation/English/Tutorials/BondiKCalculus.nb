Cell[TextData[{
 "Read off the drawing, the reception intervals in Bob's proper time are ",
 StyleBox["k", "TI"],
 " = 2 times the emission intervals."
}], "Item",ExpressionUUID->"112d3280-4699-475a-8898-aea8be1a4ed4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"disks", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"DopplerConstruction", "[", "0.6", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Disk", "[", 
         RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
       " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"disks", ",", " ", 
          RowBox[{"c", " ", "|->", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"disks", ",", " ", 
        RowBox[{"c", " ", "|->", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"832a2801-b76f-4ad7-a02c-286fe2f407d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.`", ",", "2.`", ",", "2.`", ",", "1.9999999999999982`", ",", "2.`"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"8a60e6fd-a3b3-4f17-8a61-6ccebead0d46"]
}, Open  ]],

Cell["Proper time is linear in arc length", "Section",ExpressionUUID->"41e18542-b185-4d0d-b2f6-7988a032fda5"],

Cell[TextData[{
 "Bob's proper time is not his Euclidean arc length, but it is proportional \
to it: the event at arc length ",
 StyleBox["s", "TI"],
 " on his worldline has proper time ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04ff7326-7b44-40a1-a4b1-f7c15317668b"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[CurlyPhi]", "TI"],
 "] ",
 StyleBox["s", "TI"],
 ", with the scale ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51a7122b-9bac-494c-8e3d-6da65c179f7f"],
 ". This is the identity that makes the Euclidean picture honest; it is \
verified against the radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cca0d6-cfe9-4288-8796-2da9432b21e7"],
 " below."
}], "Item",ExpressionUUID->"fbde2848-ac1e-4a4d-9f20-558e41099287"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ProperTimeScale", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
        RowBox[{"s", "^", "2"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"fb276b8a-0f83-468a-8682-a59ec7bd981a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"d8059436-d654-40ea-a53a-dd166ec108d0"]
}, Open  ]],

Cell["Radar time and radar distance", "Section",ExpressionUUID->"e31954a4-55ac-4ec8-9ce1-edba9b982907"],

Cell[TextData[{
 "Alice locates an event by radar: she sends light at her proper time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bff74954-846f-4dc6-8933-d02645474dab"],
 ", it is echoed at the event and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ad1062c-52f9-48ed-9171-ac1176070b62"],
 ". The event's radar time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2eedb0a-0fff-462a-bf23-c16b58ecdbbe"],
 " and its radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2293407-1737-4aaa-8e98-0c8646e424c9"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b50eb132-98b1-4d02-ac59-8a96c0a1e2c2"],
 ")."
}], "Item",ExpressionUUID->"f1c22b71-cc41-4aa8-a010-f14c12692e41"],

Cell[TextData[{
 "Apply it to Bob. Alice sends at ",
 StyleBox["T", "TI"],
 "; Bob receives at ",
 StyleBox["kT", "TI"],
 " on his clock and echoes at once; Alice receives at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CenterDot]", 
   StyleBox["k", "TI"], 
   StyleBox["T", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a1469a7-3adf-41f6-8fe0-1e9d882f0753"],
 ". So Bob's reflection has radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a420e792-16b8-461b-9f14-eed3bb9ddfed"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd0e8b11-037e-4ddc-aac4-45a511831f77"],
 ", and Bob's velocity is their ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6dc0ff8-1710-48b2-8e8b-b143929675c7"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09ad6d9e-291a-4e4c-ae59-7a7c6520ff2e"],
 "). With ",
 StyleBox["k", "TI"],
 " = 2 and ",
 StyleBox["T", "TI"],
 " = 1:"
}], "Item",ExpressionUUID->"115c8fc1-bad8-444e-9a3b-ab5a4bb8904b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{"VelocityFromK", "[", "k", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"42888db1-141d-4740-b0a6-9f25c9ea95df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "2"], ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["3", "5"]}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"0a7d1d65-8d77-4e4f-b035-4cd49b6595b3"]
}, Open  ]],

Cell[TextData[{
 "The same numbers from the picture: the first reflection of a light zigzag (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "563751af-bf69-4baa-9e31-779c1531fea2"],
 ") from Alice's arc length 1 to Bob at velocity 3/5 has radar time 5/2 and \
radar distance 3/2, and Bob's clock reads ",
 StyleBox["kT", "TI"],
 " = 2 there."
}], "Item",ExpressionUUID->"a34b27fa-8eed-4356-adc1-06a936ef16ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bounce", " ", "=", " ", 
     RowBox[{
      RowBox[{"LightZigzag", "[", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "1"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"x", " ", "|->", " ", 
        RowBox[{"FullSimplify", " ", "@", " ", 
         RowBox[{"TrigExpand", " ", "@", " ", "x"}]}]}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"bounce", "[", "\"\<Point\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"3", "/", "5"}], "]"}], " ", 
       RowBox[{"bounce", "[", "\"\<ArcLength\>\"", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"55f734a0-4bfc-43f0-ba4c-5f71113f261c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RadarTime\"\>", "\[Rule]", 
      FractionBox["5", "2"]}], ",", 
     RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
      FractionBox["3", "2"]}]}], "\[RightAssociation]"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"9de3579a-1996-4f66-a2b1-e3829c64a694"]
}, Open  ]],

Cell["Time dilation", "Section",ExpressionUUID->"2571bbc8-0eb0-4dee-b813-562241e051d5"],

Cell[TextData[{
 "In the computation above Bob's clock read ",
 StyleBox["kT", "TI"],
 " at the reflection, while Alice's radar time of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10d6b538-ce70-402d-afdf-e1cd42c33a7f"],
 ". Their ratio is the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "=", "1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "991bc94b-513e-4d28-b06f-de0ee9db9c0b"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b96f4b0-2676-47c6-8463-e563d381204f"],
 "): Alice assigns every event on Bob's worldline \[Gamma] times Bob's own \
reading. At ",
 StyleBox["v", "TI"],
 " = 3/5, \[Gamma] = (2 + 1/2)/2 = 5/4."
}], "Item",ExpressionUUID->"e5daf8c6-08a9-4948-a860-70b45ea461bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"WorldlinePointAtProperTime", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "tau", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"5", "/", "4"}], " ", "tau"}]}], ",", " ", 
     RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"141046bf-4901-47e7-90da-82d197c5adb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"fbf48568-712c-4dfd-a3c4-258a688e9141"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TimeDilationConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0340adbb-9ae0-4ad0-b3d3-f8266047270f"],
 " draws the radar measurement of one event ",
 StyleBox["B", "TI"],
 " of Bob's. Both worldlines carry ticks at equal proper-time steps, a \
quarter of Bob's reading at ",
 StyleBox["B", "TI"],
 "; Alice's ticks reach her radar time of ",
 StyleBox["B", "TI"],
 " after \[Gamma] times as many steps, and the dashed line is her \
simultaneity line through ",
 StyleBox["B", "TI"],
 "."
}], "Item",ExpressionUUID->"a2e1e4fc-f277-449c-88b0-bea9ced25fba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TimeDilationConstruction", "[", "0.6", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"0097f2c6-5f26-4fff-b580-0d5c47538176"],

