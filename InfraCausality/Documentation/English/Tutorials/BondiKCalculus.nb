   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b4fb893-d3c9-4d55-b25e-20c370ac02c0"],
 " draws six pulses from Alice to Bob at ",
 StyleBox["v", "TI"],
 " = 0.6. The first emission interval \[CapitalDelta]\[Tau] and its reception \
interval ",
 StyleBox["k", "TI"],
 "\[CapitalDelta]\[Tau] are marked."
}], "Item",ExpressionUUID->"d97dce7a-9c83-4638-ac94-0bf74867eb7a"],

