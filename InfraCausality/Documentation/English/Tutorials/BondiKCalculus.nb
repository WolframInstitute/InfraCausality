Cell["The Bondi clock", "Section",ExpressionUUID->"f4987c7b-7cd8-4bf5-8f25-9943b423d3dd"],

Cell[TextData[{
 "Let the light bounce back and forth between Alice and Bob (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiClock"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiClock", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22ad0b42-fd99-4ae2-bd8d-b66e1d1dc183"],
 "). Each event's proper time is ",
 StyleBox["k", "TI"],
 " times the one before, so Alice's reception arc lengths grow by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8a0e7da-524b-497f-8b88-aa65a0b9eb4b"],
 " per round trip: the reflections are spaced geometrically, while the \
proper-time ticks on each worldline are evenly spaced. The labels ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b50b0588-77e0-4923-9db1-f3bd44bdc51e"],
 " give the proper times in units of the first emission."
}], "Item",ExpressionUUID->"605f49aa-19ec-4cee-b720-7d488015e227"],

