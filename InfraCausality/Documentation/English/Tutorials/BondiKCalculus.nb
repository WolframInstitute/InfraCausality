Cell["Velocity addition", "Section",ExpressionUUID->"79eb00b0-47f0-4004-a0b2-d0d3f9ea2848"],

Cell[TextData[{
 "Carol moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8e0230-9dc1-47a0-bb3a-bdbf713bc04e"],
 " relative to Bob, who moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24c620d2-d72d-4dd7-baaa-9400402d0f33"],
 " relative to Alice. A signal from Alice to Carol passing Bob is received by \
Bob at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e0b11ee-e599-4aa2-a5d1-bdea5220a61a"],
 " times its emission and by Carol at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e58718c5-27e0-4789-8cf3-5962c7381894"],
 " times Bob's reception, so the k-factor of Carol relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a2c53ea-e378-43c7-be84-2d93012c97af"],
 ": k-factors multiply, and the composed velocity is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9764b774-f625-4d18-8933-9a769cf17191"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["v", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "1"], 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08969770-5772-4134-90c0-524aa6fcfa72"],
 ". The rapidities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da65e17-a3d5-476a-bc2b-2d22e8b9f628"],
 " add (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RapidityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b78084f-0a5e-4d76-a57d-699421c5320c"],
 ")."
}], "Item",ExpressionUUID->"3fe337e0-bb36-442a-b3c7-33f77348ca38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VelocityFromK", "[", 
      RowBox[{
       RowBox[{"KFactor", "[", "v1", "]"}], " ", 
       RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
      RowBox[{"Rapidity", "[", "v2", "]"}]}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"2e522500-98ab-49f7-a58c-ddd319d18883"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"84e6576f-5dfb-486e-8622-b3c8601a628f"]
}, Open  ]],

