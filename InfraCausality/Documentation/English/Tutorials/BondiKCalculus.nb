Cell["\<\
The ratio of Alice's radar-time steps to Bob's proper-time steps between \
consecutive ticks is \[Gamma] = 5/4.\
\>", "Item",ExpressionUUID->"d7dd265a-3333-44a6-8fdc-0b664fa18295"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ticks", " ", "=", " ", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"LightClockConstruction", "[", "0.6", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"pts_", " ", "/;", " ", 
            RowBox[{
             RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
           "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", 
        RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{"ticks", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"c09364fc-b145-488a-a66a-5f458d7e30c9"],

