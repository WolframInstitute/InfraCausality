Cell["The k-factor and the Doppler effect", "Section",ExpressionUUID->"29e28dbe-85f7-469d-b4a5-45175af6fa4f"],

Cell[TextData[{
 "Alice emits pulses at equal intervals of her proper time; Bob receives them \
at equal intervals of his, ",
 StyleBox["k", "TI"],
 " times longer. By symmetry the same ",
 StyleBox["k", "TI"],
 " relates Bob's emissions to Alice's receptions. Radar gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c15a7ba8-f1b2-42b5-9a3c-8461990de430"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "614a69c6-f442-4401-8041-ec1355510eee"],
 "), the relativistic Doppler factor: the velocity 3/5 has ",
 StyleBox["k", "TI"],
 " = 2."
}], "Item",ExpressionUUID->"177b9cbe-32d1-41d3-8259-e615b333faee"],

Cell[TextData[{
 "In the picture, light emitted at arc length ",
 StyleBox["s", "TI"],
 " on Alice's worldline reaches Bob at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8b90544-e52a-48f2-9e55-dd9efdef4351"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c18c301c-8c3e-44b4-af5c-d9f5888489f8"],
 "), and light from Bob at ",
 StyleBox["s", "TI"],
 " reaches Alice at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef7b6196-ec27-41c8-9ced-ac71c750c159"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "353c6020-def6-44f1-8e0e-634fcbf66d4c"],
 "). These are Euclidean ratios and depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 "; the k-factor ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"i", "n"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c90b802-084c-44df-8a93-6a52cade4422"],
 " does not."
}], "Item",ExpressionUUID->"9db22efe-e529-422e-b464-81c570dfde9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KFactor", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
