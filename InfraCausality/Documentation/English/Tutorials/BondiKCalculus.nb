Cell[TextData[{
 "From Alice's arc length 1 at velocity 3/5, her reception arc lengths are \
the powers of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e089e197-155f-48c6-a07a-bee366e8d34a"],
 ", so the number of round trips to the arc length ",
 StyleBox["s", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["s", "TI"], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1325aec5-f4d8-46c7-8329-b199acdc0557"],
 ", a logarithm of the arc length."
}], "Item",ExpressionUUID->"d4489c59-ee22-4f48-85f4-1da7e2105442"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8"}], "]"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
            " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
        " ", "\"\<ArcLength\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arcs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "arcs", "]"}], "/", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "^", "2"}], "]"}]}], " ", "//", " ",
       "FullSimplify"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"4ef2dd47-ffd0-4a78-b0b4-fb953ffd3267"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "16", ",", "64", ",", "256"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"5b21f44e-c4ee-4817-b444-0c838cb27177"]
}, Open  ]],

Cell["From the plane to graphs", "Section",ExpressionUUID->"3e38cc32-cb31-4d82-81ec-f5f4b38dc9e1"],

Cell[TextData[{
 "On a causal graph the same radar rule gives the radar chart of an observer \
chain, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "455ce39d-82bb-493c-8e2c-fa7947735c77"],
 ", whose time and distance are the half-sum and half-difference of the \
emission and reception ticks; the Causal Infrageometry tutorial builds it. \
The k-factor has a graph reading as well: on the diamond lattice the chain at \
rest echoed by a chain of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) reads ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["p", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fa654a-b05e-4e25-a265-d7b5546f88a1"],
 ", the Bondi factor of that velocity."
}], "Item",ExpressionUUID->"23e89d91-2ac4-4435-bb80-3e470f454021"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KFactor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "==",
     " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", " ", "+", " ", "1"}], ")"}], "/", "p"}], "]"}]}], ",", 
   " ", 
   RowBox[{"p", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"6a982690-161c-43be-8930-b05e9d745789"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"f699be95-d202-4076-a200-dabbc23f7981"]
}, Open  ]],

