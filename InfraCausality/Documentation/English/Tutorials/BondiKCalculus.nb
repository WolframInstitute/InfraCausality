Cell["Velocity addition", "Section",ExpressionUUID->"77826c4f-1991-428e-8204-12f151df750f"],

Cell[TextData[{
 "Carol moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "821d58c9-477c-4a78-82c9-17f5e1bf38e8"],
 " relative to Bob, who moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "329120c6-c4dc-4ed8-ba51-646369ef4519"],
 " relative to Alice. A signal from Alice to Carol passing Bob is received by \
Bob at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6832b672-eedf-4cc4-83c5-ba4a0447bd56"],
 " times its emission and by Carol at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05c9da37-a795-492c-9f20-27d6fb2c52c1"],
 " times Bob's reception, so the k-factor of Carol relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9e5a55a-5d69-470f-b43e-2b0d09a5732e"],
 ": k-factors multiply, and the composed velocity is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], "1"], 
       SubscriptBox[
        StyleBox["k", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], "1"], 
       SubscriptBox[
        StyleBox["k", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], 
    SubscriptBox[
     StyleBox["v", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87132bfe-18d3-4f06-8815-56db6cf54143"],
 ". The rapidities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff39bd2-5083-4704-ba5d-19062d8143d7"],
 " add (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rapidity"]], 
    "paclet:WolframInstitute/InfraCausality/ref/Rapidity", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2b515f6-8c6b-4cff-9021-8fb4632ef27e"],
 ")."
