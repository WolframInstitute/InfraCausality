Cell[TextData[{
 "Every point of Bob's line has its radar midpoint at ",
 StyleBox["B", "TI"],
 ": here ",
 StyleBox["B", "TI"],
 " is at arc length ",
 StyleBox["s", "TI"],
 " and the point at the end of the line, for every velocity and light angle."
}], "Item",ExpressionUUID->"3a03a941-2a7e-4381-9a00-fd4e90d50bc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"midpoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SimultaneityLine", "[", 
          RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}],
          "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
       "]"}], " ", "==", " ", "s"}], ",", " ", 
     RowBox[{
      RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
       RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"f6f0ed32-d728-45f5-a188-a3ae5bbf1ed9"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"fef4e6ed-b4df-4494-83cf-0d669ef3ba79"]
}, Open  ]],

Cell["Length contraction", "Section",ExpressionUUID->"35ef845b-d3be-45e1-a2a1-645239b6bd79"],

Cell[TextData[{
 "A rod at rest for Bob has two parallel worldlines. Its rest length ",
 StyleBox["L", "TI"],
 " is measured across them along Bob's line of simultaneity; Alice measures \
across them at one of her radar times, and she finds ",
 StyleBox["L", "TI"],
 "/\[Gamma]. The computation in radar coordinates, for ",
 StyleBox["L", "TI"],
 " = 1 and ",
 StyleBox["v", "TI"],
 " = 3/5: the back end is displaced along Bob's simultaneity direction by \
Minkowski length 1, and Alice's length is the difference of the radar \
distances of the two worldlines at one radar time."
}], "Item",ExpressionUUID->"d1a97e1d-7621-4825-88ed-e45e88fb5466"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"3", "/", "5"}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"radar", " ", "=", " ", 
      RowBox[{"p", " ", "|->", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
           "}"}]}], "]"}]}]}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"radar", "[", "n", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"v", " ", 
        RowBox[{
         RowBox[{"radar", "[", "n", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"LorentzGamma", "[", "v", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"1faeda55-fafe-4e6e-9f69-c91e348a9bdf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["4", "5"], ",", 
   FractionBox["4", "5"]}], "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"6722737d-61ac-4a62-b846-8de5005c8802"]
}, Open  ]],

