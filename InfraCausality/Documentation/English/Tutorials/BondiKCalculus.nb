Cell[TextData[{
 "Read off the drawing, the reception intervals in Bob's proper time are ",
 StyleBox["k", "TI"],
 " = 2 times the emission intervals."
}], "Item",ExpressionUUID->"d6445875-4a08-4fbb-839e-9e5803918f83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"disks", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"DopplerConstruction", "[", "0.6", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Disk", "[", 
         RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
       " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"disks", ",", " ", 
          RowBox[{"c", " ", "|->", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"disks", ",", " ", 
        RowBox[{"c", " ", "|->", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"4e0e2644-69b9-4767-abe0-faff3be8e6c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.`", ",", "2.`", ",", "2.`", ",", "1.9999999999999982`", ",", "2.`"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"f53aaef9-6981-46a4-8851-e7d9064587c0"]
}, Open  ]],

Cell["Proper time is linear in arc length", "Section",ExpressionUUID->"2a90acb8-0f96-44ed-ae5a-1e189eec1fa3"],

Cell[TextData[{
 "Bob's proper time is not his Euclidean arc length, but it is proportional \
to it: the event at arc length ",
 StyleBox["s", "TI"],
 " on his worldline has proper time ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "065089aa-8c67-4db0-b95c-16e9f629694e"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[CurlyPhi]", "TI"],
 "] ",
 StyleBox["s", "TI"],
 ", with the scale ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cd3b399-8610-4bae-b0c4-2c26ab0d58e5"],
 ". This is the identity that makes the Euclidean picture honest; it is \
verified against the radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d9fc450-1cdc-43cd-b8b3-4fbe1930fc59"],
 " below."
}], "Item",ExpressionUUID->"f609e409-3512-4025-ba62-a6b64ad647b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ProperTimeScale", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
        RowBox[{"s", "^", "2"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"5efdd777-99f6-4089-bbbc-349fad7d0ef3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"0183ff0c-9401-4703-83f2-6527231dab8a"]
}, Open  ]],

Cell["Radar time and radar distance", "Section",ExpressionUUID->"4d70f63d-0e46-4efc-a43f-775312717e10"],

Cell[TextData[{
 "Alice locates an event by radar: she sends light at her proper time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "645530bf-21cf-4d73-b462-0d8ae2d0139a"],
 ", it is echoed at the event and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eccfb0-74ad-45e4-b95a-dd9f562e79aa"],
 ". The event's radar time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c67e6b5c-80fe-490f-971a-855761a6c0b2"],
 " and its radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a777273-c937-484f-af7a-f81d1e49bc30"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b90691c8-89fd-4c0e-b780-719907f4c648"],
 ")."
}], "Item",ExpressionUUID->"fe3e6aef-4cd2-4207-81ca-2f13558d1dd8"],

Cell[TextData[{
 "Apply it to Bob. Alice sends at ",
 StyleBox["T", "TI"],
 "; Bob receives at ",
 StyleBox["kT", "TI"],
 " on his clock and echoes at once; Alice receives at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CenterDot]", 
   StyleBox["k", "TI"], 
   StyleBox["T", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b033164-281c-4509-9245-84939845492b"],
 ". So Bob's reflection has radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c284df9e-0a46-4261-aea6-b89a28f057ce"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8a0397d-25a9-4ce0-a7d4-b091541804de"],
 ", and Bob's velocity is their ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b02d610b-4cc8-4412-bdb5-b21263fbae58"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d5adf30e-d4b1-47ec-b16b-834197c6df78"],
 "). With ",
 StyleBox["k", "TI"],
 " = 2 and ",
 StyleBox["T", "TI"],
 " = 1:"
}], "Item",ExpressionUUID->"6ac96a6a-080f-47d4-8ada-77976622d26d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{"VelocityFromK", "[", "k", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"3904e47f-0eaa-41e8-bca4-b6346274f51d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "2"], ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["3", "5"]}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"5377b503-ea9d-428c-a0f6-fa521312633d"]
}, Open  ]],

Cell[TextData[{
 "The same numbers from the picture: the first reflection of a light zigzag (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e86f039-1eaf-4d7d-9e79-37657c75e473"],
 ") from Alice's arc length 1 to Bob at velocity 3/5 has radar time 5/2 and \
radar distance 3/2, and Bob's clock reads ",
 StyleBox["kT", "TI"],
 " = 2 there."
}], "Item",ExpressionUUID->"8edb00d6-3f41-4a3e-a243-f55ce5e891c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bounce", " ", "=", " ", 
     RowBox[{
      RowBox[{"LightZigzag", "[", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "1"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"x", " ", "|->", " ", 
        RowBox[{"FullSimplify", " ", "@", " ", 
         RowBox[{"TrigExpand", " ", "@", " ", "x"}]}]}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"bounce", "[", "\"\<Point\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"3", "/", "5"}], "]"}], " ", 
       RowBox[{"bounce", "[", "\"\<ArcLength\>\"", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"4357dad6-1e58-4167-b793-a63ac62a3df4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RadarTime\"\>", "\[Rule]", 
      FractionBox["5", "2"]}], ",", 
     RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
      FractionBox["3", "2"]}]}], "\[RightAssociation]"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"67c65373-e053-4ac4-ad8b-b8eddf1ff04d"]
}, Open  ]],

Cell["Time dilation", "Section",ExpressionUUID->"aacded88-6b8a-4891-8db7-0a41134ef277"],

Cell[TextData[{
 "In the computation above Bob's clock read ",
 StyleBox["kT", "TI"],
 " at the reflection, while Alice's radar time of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "822bef0d-406d-45f0-9ab5-9449053286bc"],
 ". Their ratio is the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "=", "1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4645348-3b3d-461a-a26a-4c2cf8e5fec2"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20c97de1-9fbf-45aa-8ade-526f155bf578"],
 "): Alice assigns every event on Bob's worldline \[Gamma] times Bob's own \
reading. At ",
 StyleBox["v", "TI"],
 " = 3/5, \[Gamma] = (2 + 1/2)/2 = 5/4."
}], "Item",ExpressionUUID->"eda35a25-9537-4626-a2a1-f351de6dfc70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"WorldlinePointAtProperTime", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "tau", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"5", "/", "4"}], " ", "tau"}]}], ",", " ", 
     RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"fcd3dfe4-2d1e-4bbe-afbc-1a6efab9a0e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"8a0f1931-f9bd-4ca8-9d7c-99fdc246fd39"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TimeDilationConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "de2a0a3b-6c6b-4c2b-9c26-cfcf9d7734c1"],
 " draws the radar measurement of one event ",
 StyleBox["B", "TI"],
 " of Bob's. Both worldlines carry ticks at equal proper-time steps, a \
quarter of Bob's reading at ",
 StyleBox["B", "TI"],
 "; Alice's ticks reach her radar time of ",
 StyleBox["B", "TI"],
 " after \[Gamma] times as many steps, and the dashed line is her \
simultaneity line through ",
 StyleBox["B", "TI"],
 "."
}], "Item",ExpressionUUID->"f00d4d5b-0bb0-4ebe-a9b3-059d6b81fb1e"],

Cell[CellGroupData[{

