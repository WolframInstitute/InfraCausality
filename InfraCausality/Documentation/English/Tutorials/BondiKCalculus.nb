 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LengthContractionConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/\
LengthContractionConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e2b6c4f-7669-4e11-aa6c-38750d0928a0"],
 " draws this at ",
 StyleBox["v", "TI"],
 " = 0.6: the rod (thick red) of rest length ",
 StyleBox["L", "TI"],
 " = 0.15 along Bob's line of simultaneity through its front event, and \
Alice's measurement of it (orange) along her own line of simultaneity through \
that event, at one radar time, with her four radar rays. The orange bar is \
the rod of length ",
 StyleBox["L", "TI"],
 "/\[Gamma] = 0.12 that she measures; its reference page reads both lengths \
off the drawing."
}], "Item",ExpressionUUID->"a9090040-1b1f-4aaf-8382-25198a29c76e"],

