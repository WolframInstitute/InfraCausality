Cell["\<\
The ratio of Alice's radar-time steps to Bob's proper-time steps between \
consecutive ticks is \[Gamma] = 5/4.\
\>", "Item",ExpressionUUID->"4e53dbd2-b4aa-49ca-b965-176f23dfc741"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ticks", " ", "=", " ", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"LightClockConstruction", "[", "0.6", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"pts_", " ", "/;", " ", 
            RowBox[{
             RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
           "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", 
        RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{"ticks", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"919cd765-c97d-4d9c-8e5f-e8f14f45238b"],

