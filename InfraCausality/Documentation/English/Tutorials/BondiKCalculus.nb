Cell[TextData[{
 "From Alice's arc length 1 at velocity 3/5, her reception arc lengths are \
the powers of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97864808-569d-4ed1-8ec6-7481ff2b52ae"],
 ", so the number of round trips to the arc length ",
 StyleBox["s", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["s", "TI"], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fac83db6-2ded-4be1-a5d0-c6aa9775a5ea"],
 ", a logarithm of the arc length."
}], "Item",ExpressionUUID->"d6434d98-92bb-48fc-a798-8724d9d0678d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8"}], "]"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
            " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
        " ", "\"\<ArcLength\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arcs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "arcs", "]"}], "/", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "^", "2"}], "]"}]}], " ", "//", " ",
       "FullSimplify"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"89dd558b-11eb-4b5d-9a52-5ca4324186f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "16", ",", "64", ",", "256"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"d9af34c4-923d-48ad-b52b-b5e7866ae577"]
}, Open  ]],

Cell["From the plane to graphs", "Section",ExpressionUUID->"54c74e39-c61a-42b2-ad83-296fae0ec9cf"],

Cell[TextData[{
 "On a causal graph the same radar rule gives the radar chart of an observer \
chain, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33fd9929-fa34-4089-87d8-96544e43c6a4"],
 ", whose time and distance are the half-sum and half-difference of the \
emission and reception ticks; the Causal Infrageometry tutorial builds it. \
The k-factor has a graph reading as well: on the diamond lattice the chain at \
rest echoed by a chain of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) reads ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["p", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28bedde5-bab2-4e80-ab9e-faa1e06b119a"],
 ", the Bondi factor of that velocity."
}], "Item",ExpressionUUID->"c8916fee-5085-4874-8696-b04c4fb2bbee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KFactor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "==",
     " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", " ", "+", " ", "1"}], ")"}], "/", "p"}], "]"}]}], ",", 
   " ", 
   RowBox[{"p", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"9e120e78-1a0a-4778-813a-af55ef4f670b"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"bbaef7c1-e377-4267-b1ad-f8ea02f545f5"]
}, Open  ]],

