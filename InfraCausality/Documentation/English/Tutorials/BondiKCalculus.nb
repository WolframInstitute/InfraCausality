Cell["The k-factor and the Doppler effect", "Section",ExpressionUUID->"a0f4b027-c7e1-4969-8216-9385fa1a333d"],

Cell[TextData[{
 "Alice emits pulses at equal intervals of her proper time; Bob receives them \
at equal intervals of his, ",
 StyleBox["k", "TI"],
 " times longer. By symmetry the same ",
 StyleBox["k", "TI"],
 " relates Bob's emissions to Alice's receptions. Radar gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49bfaf3e-1e9b-4ff0-ba5f-44cefa08feb1"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9efe675f-4c8a-4189-9298-a9ca5586441c"],
 "), the relativistic Doppler factor: the velocity 3/5 has ",
 StyleBox["k", "TI"],
 " = 2."
}], "Item",ExpressionUUID->"548ba4da-3576-4f88-9734-1e9d22944086"],

Cell[TextData[{
 "In the picture, light emitted at arc length ",
 StyleBox["s", "TI"],
 " on Alice's worldline reaches Bob at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d47586ff-4dfd-4ec7-a07a-b2a0db0674ef"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3873a89-f173-48fd-a20f-aba39dc20016"],
 "), and light from Bob at ",
 StyleBox["s", "TI"],
 " reaches Alice at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e93fcab-db32-46b7-aac4-0cc0e35329b5"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed39a8c7-d1e9-42fa-8c21-14bf2b59ae09"],
 "). These are Euclidean ratios and depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 "; the k-factor ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"i", "n"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3623d81-3ada-47ad-9f47-f09102892964"],
 " does not."
}], "Item",ExpressionUUID->"7e1df392-3bc2-47b5-8c34-673e46cf106e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KFactor", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
