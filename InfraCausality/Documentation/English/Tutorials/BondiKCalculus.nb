Cell[TextData[{
 "Read off the drawing, the reception intervals in Bob's proper time are ",
 StyleBox["k", "TI"],
 " = 2 times the emission intervals."
}], "Item",ExpressionUUID->"0e81dca4-71aa-4397-a196-b42ccf3c61a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"disks", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"DopplerConstruction", "[", "0.6", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Disk", "[", 
         RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
       " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"disks", ",", " ", 
          RowBox[{"c", " ", "|->", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"disks", ",", " ", 
        RowBox[{"c", " ", "|->", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"7a79d2fa-801b-4913-b1a7-8aab56ff853a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.`", ",", "2.`", ",", "2.`", ",", "1.9999999999999982`", ",", "2.`"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"90110146-0a6a-4b3c-bdbd-1617dbee6f3b"]
}, Open  ]],

Cell["Proper time is linear in arc length", "Section",ExpressionUUID->"52a8b22c-0bd9-44bf-8ca7-d22f95d3ff08"],

Cell[TextData[{
 "Bob's proper time is not his Euclidean arc length, but it is proportional \
to it: the event at arc length ",
 StyleBox["s", "TI"],
 " on his worldline has proper time ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "381bcb19-bff7-40b9-8338-644b2ebad117"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[CurlyPhi]", "TI"],
 "] ",
 StyleBox["s", "TI"],
 ", with the scale ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2a1f0d0-6ad8-4c81-9589-9e423770941d"],
 ". This is the identity that makes the Euclidean picture honest; it is \
verified against the radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1015a37-5fff-4513-abb3-dc5b057e1c8b"],
 " below."
}], "Item",ExpressionUUID->"cf70516b-51a4-4a38-a987-29a543b3b1c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ProperTimeScale", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
        RowBox[{"s", "^", "2"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"b2e4d843-b896-4a9d-a2b6-de10847a1df3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"a30b3158-9850-4ff1-94ae-e48da96cf955"]
}, Open  ]],

Cell["Radar time and radar distance", "Section",ExpressionUUID->"8f451fd8-4634-47b5-8f30-b78faffd8fa5"],

Cell[TextData[{
 "Alice locates an event by radar: she sends light at her proper time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abfa055-4c7c-4e23-9bca-e86878f5750c"],
 ", it is echoed at the event and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cb8cae3-c09a-4178-aaf8-e51ba8dd8e0f"],
 ". The event's radar time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c47e6b7-8f28-4ab5-b797-26a31f29c3fc"],
 " and its radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0f9fc7e-60a5-467a-a61f-57886fb299cc"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fc25d3c-525a-4c06-ba68-c3ca38d418d1"],
 ")."
}], "Item",ExpressionUUID->"0c704917-0390-4fa5-a6a8-6dc912724b0b"],

Cell[TextData[{
 "Apply it to Bob. Alice sends at ",
 StyleBox["T", "TI"],
 "; Bob receives at ",
 StyleBox["kT", "TI"],
 " on his clock and echoes at once; Alice receives at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CenterDot]", 
   StyleBox["k", "TI"], 
   StyleBox["T", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5401bd9f-a0b1-465b-9680-2389c630a835"],
 ". So Bob's reflection has radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3d16fa7-f3e7-4fdb-82cc-5c05d5163557"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b2ab32d-1343-4fd1-a333-a25b0e3b9621"],
 ", and Bob's velocity is their ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d68c72c8-0363-4ea7-b655-94374e81362a"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "384f7552-aea0-44e1-95d9-d4ed456c31ce"],
 "). With ",
 StyleBox["k", "TI"],
 " = 2 and ",
 StyleBox["T", "TI"],
 " = 1:"
}], "Item",ExpressionUUID->"7dbdc7cb-76d2-4aff-8551-8174d9bf9429"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{"VelocityFromK", "[", "k", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"c4829a22-171c-4cf6-9eb3-89e9f5dcef8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "2"], ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["3", "5"]}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"f14b5a4b-d05d-4138-9c06-95f72a728030"]
}, Open  ]],

Cell[TextData[{
 "The same numbers from the picture: the first reflection of a light zigzag (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3454728-5ffb-4165-8803-03334aacc6e9"],
 ") from Alice's arc length 1 to Bob at velocity 3/5 has radar time 5/2 and \
radar distance 3/2, and Bob's clock reads ",
 StyleBox["kT", "TI"],
 " = 2 there."
}], "Item",ExpressionUUID->"1a8208ae-1024-40ce-a3bf-d81c03840d31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bounce", " ", "=", " ", 
     RowBox[{
      RowBox[{"LightZigzag", "[", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "1"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"x", " ", "|->", " ", 
        RowBox[{"FullSimplify", " ", "@", " ", 
         RowBox[{"TrigExpand", " ", "@", " ", "x"}]}]}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"bounce", "[", "\"\<Point\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"3", "/", "5"}], "]"}], " ", 
       RowBox[{"bounce", "[", "\"\<ArcLength\>\"", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"47ac50a4-f6a4-437c-bd3f-ebe30441ba0f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RadarTime\"\>", "\[Rule]", 
      FractionBox["5", "2"]}], ",", 
     RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
      FractionBox["3", "2"]}]}], "\[RightAssociation]"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"6c0405ad-8d17-45ea-9ca2-a4a2495fdeb8"]
}, Open  ]],

Cell["Time dilation", "Section",ExpressionUUID->"10a5b896-f972-489d-ae98-32ac8b72deab"],

Cell[TextData[{
 "In the computation above Bob's clock read ",
 StyleBox["kT", "TI"],
 " at the reflection, while Alice's radar time of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb0d46a9-0311-494e-b090-75d22333de4e"],
 ". Their ratio is the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "=", "1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4debe498-bb63-42c3-8492-fae24ba55c97"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73a82b34-0a6a-478a-a2cf-a4523f546714"],
 "): Alice assigns every event on Bob's worldline \[Gamma] times Bob's own \
reading. At ",
 StyleBox["v", "TI"],
 " = 3/5, \[Gamma] = (2 + 1/2)/2 = 5/4."
}], "Item",ExpressionUUID->"a6f5374d-195a-4020-9bad-a389ae31a648"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"WorldlinePointAtProperTime", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "tau", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"5", "/", "4"}], " ", "tau"}]}], ",", " ", 
     RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"a4bccac6-8e01-4f66-9795-8d9b6c5ba155"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"67b93a05-c6b7-428b-ad31-e008a3b723f2"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TimeDilationConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10508b7a-872d-4193-b186-b9bc96650ae9"],
 " draws the radar measurement of one event ",
 StyleBox["B", "TI"],
 " of Bob's. Both worldlines carry ticks at equal proper-time steps, a \
quarter of Bob's reading at ",
 StyleBox["B", "TI"],
 "; Alice's ticks reach her radar time of ",
 StyleBox["B", "TI"],
 " after \[Gamma] times as many steps, and the dashed line is her \
simultaneity line through ",
 StyleBox["B", "TI"],
 "."
}], "Item",ExpressionUUID->"11cfac62-a51f-4fb7-9047-e4d47d1e9104"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TimeDilationConstruction", "[", "0.6", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"eba5fec0-74b7-41bc-ae40-391849ebb377"],

