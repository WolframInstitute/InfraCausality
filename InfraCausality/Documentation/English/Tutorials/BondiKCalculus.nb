Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", " ", "=", " ", 
         RowBox[{
          RowBox[{"BondiKFactor", "[", "v1", "]"}], " ", 
          RowBox[{"BondiKFactor", "[", "v2", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}]}]}], "]"}], 
     " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
