Cell["Velocity addition", "Section",ExpressionUUID->"7e881e96-2f12-43bc-b3bc-e617702c033a"],

Cell[TextData[{
 "Carol moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e69b6d1-8a99-422b-8f8a-5718e7ab3653"],
 " relative to Bob, who moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc8be0b6-d8e3-47ec-93fb-ce7e2e385013"],
 " relative to Alice. A signal from Alice to Carol passing Bob is received by \
Bob at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3cecb69-97f8-42c5-83d5-8e97659b5ec3"],
 " times its emission and by Carol at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "643924b3-b2b2-41bb-90f3-c922bb1c9c7e"],
 " times Bob's reception, so the k-factor of Carol relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba93e362-1576-4948-a171-6d0d640a397a"],
 ": k-factors multiply, and the composed velocity is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad84efba-47d8-4c78-9e1c-91cbe64db804"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["v", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "1"], 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f575840-38f5-454a-9b1c-fc96117c4c64"],
 ". The rapidities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "100422b6-28bb-49e3-b290-f31b26226633"],
 " add (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RapidityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4791183b-6f1f-4e41-bc23-01a9007de58f"],
 ")."
}], "Item",ExpressionUUID->"cbb46fe6-bd3d-49d3-a6f0-f6324c27530b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VelocityFromK", "[", 
      RowBox[{
       RowBox[{"KFactor", "[", "v1", "]"}], " ", 
       RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
      RowBox[{"Rapidity", "[", "v2", "]"}]}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"626577ce-a84c-40e8-9886-0224ebf50b96"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"ef5204f6-2145-4371-81ba-77084962b4cb"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityAdditionConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityAdditionConstruction",
