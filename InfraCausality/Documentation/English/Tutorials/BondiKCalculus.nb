Cell[TextData[{
 "Every point of Bob's line has its radar midpoint at ",
 StyleBox["B", "TI"],
 ": here ",
 StyleBox["B", "TI"],
 " is at arc length ",
 StyleBox["s", "TI"],
 " and the point at the end of the line, for every velocity and light angle."
}], "Item",ExpressionUUID->"e78684d2-1048-4166-8e33-ee6ca528a420"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"midpoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SimultaneityLine", "[", 
          RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}],
          "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
       "]"}], " ", "==", " ", "s"}], ",", " ", 
     RowBox[{
      RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
       RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"c97961f0-b8a5-42be-8c85-e1c566a404b8"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"baef1d1e-99c4-4385-97b7-8adf9e1b7037"]
}, Open  ]],

Cell["Length contraction", "Section",ExpressionUUID->"7e4fcbba-9e4f-4540-a83e-8b296aa9f5d2"],

Cell[TextData[{
 "A rod at rest for Bob has two parallel worldlines. Its rest length ",
 StyleBox["L", "TI"],
 " is measured across them along Bob's line of simultaneity; Alice measures \
across them at one of her radar times, and she finds ",
 StyleBox["L", "TI"],
 "/\[Gamma]. The computation in radar coordinates, for ",
 StyleBox["L", "TI"],
 " = 1 and ",
 StyleBox["v", "TI"],
 " = 3/5: the back end is displaced along Bob's simultaneity direction by \
Minkowski length 1, and Alice's length is the difference of the radar \
distances of the two worldlines at one radar time."
}], "Item",ExpressionUUID->"58ced630-8fbf-4d5a-864b-ea8a8de0e0c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"3", "/", "5"}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"radar", " ", "=", " ", 
      RowBox[{"p", " ", "|->", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
           "}"}]}], "]"}]}]}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"radar", "[", "n", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"v", " ", 
        RowBox[{
         RowBox[{"radar", "[", "n", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"LorentzGamma", "[", "v", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"21f33890-03c4-4d01-9881-992da0e67017"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["4", "5"], ",", 
   FractionBox["4", "5"]}], "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"2205e132-2971-4130-ae76-88e7798b6439"]
}, Open  ]],

