Cell["The light clock", "Section",ExpressionUUID->"3be439e9-84d1-45a2-8df4-b59c9bbf375d"],

Cell[TextData[{
 "Bob carries a mirror on a parallel worldline and bounces light between \
himself and it. Each round trip is the same translate along his worldline, so \
his ticks are equally spaced in his proper time, while Alice's radar times of \
the ticks are \[Gamma] times further apart: time dilation again, now of a \
physical clock (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightClockConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightClockConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae7d14f1-def0-4d20-a451-5fee56dcf1f3"],
 ")."
}], "Item",ExpressionUUID->"4df3e8df-73fd-4313-ae8c-a024a4889121"],

