Cell[TextData[{
 "From Alice's arc length 1 at velocity 3/5, her reception arc lengths are \
the powers of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbbe73c1-b5aa-4362-b263-0e9fa7c66d53"],
 ", so the number of round trips to the arc length ",
 StyleBox["s", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["s", "TI"], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d19dc205-7ba2-4d1e-ab19-c5339260beee"],
 ", a logarithm of the arc length."
}], "Item",ExpressionUUID->"2f02c0a1-f6e9-4da0-9d53-10b5e26c6907"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8"}], "]"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
            " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
        " ", "\"\<ArcLength\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arcs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "arcs", "]"}], "/", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "^", "2"}], "]"}]}], " ", "//", " ",
       "FullSimplify"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"9a585f49-15dc-46c9-9be0-9581828f6e37"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "16", ",", "64", ",", "256"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"ade0fa03-6b56-47b8-ade6-208e8bcd4ade"]
}, Open  ]],

Cell["From the plane to graphs", "Section",ExpressionUUID->"596e2cf9-e122-475e-82b8-8b3016d53ec4"],

Cell[TextData[{
 "On a causal graph the same radar rule gives the radar chart of an observer \
chain, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81038c2e-4de6-4daa-818b-60113c1fad51"],
 ", whose time and distance are the half-sum and half-difference of the \
emission and reception ticks; the Causal Infrageometry tutorial builds it. \
The k-factor has a graph reading as well: on the diamond lattice the chain at \
rest echoed by a chain of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) reads ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["p", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed4f7ce9-9ae7-4f6c-8888-6d63244aee40"],
 ", the Bondi factor of that velocity."
}], "Item",ExpressionUUID->"b64f099d-5713-4de6-83b5-f20ed1f7b088"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KFactor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "==",
     " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", " ", "+", " ", "1"}], ")"}], "/", "p"}], "]"}]}], ",", 
   " ", 
   RowBox[{"p", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"9068fab5-0006-48f5-840b-bba841f05213"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"fcd1730f-6ff5-4e0f-bba5-cd1e1dfbc90c"]
}, Open  ]],

