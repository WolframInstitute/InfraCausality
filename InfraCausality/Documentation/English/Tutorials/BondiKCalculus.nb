Cell[TextData[{
 "Read off the drawing, the reception intervals in Bob's proper time are ",
 StyleBox["k", "TI"],
 " = 2 times the emission intervals."
}], "Item",ExpressionUUID->"2cd4fbc0-e3ab-4dc7-ba66-fb322e49bc73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"disks", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"DopplerConstruction", "[", "0.6", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Disk", "[", 
         RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
       " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"disks", ",", " ", 
          RowBox[{"c", " ", "|->", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"disks", ",", " ", 
        RowBox[{"c", " ", "|->", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"24c3b5fc-de12-4273-b62f-d32dd9e0e4c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.`", ",", "2.`", ",", "2.`", ",", "1.9999999999999982`", ",", "2.`"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"7f153a9c-9373-44d5-9dcc-5c4528c884c9"]
}, Open  ]],

Cell["Proper time is linear in arc length", "Section",ExpressionUUID->"12af4007-b778-41c7-9a3b-7a38ee908121"],

Cell[TextData[{
 "Bob's proper time is not his Euclidean arc length, but it is proportional \
to it: the event at arc length ",
 StyleBox["s", "TI"],
 " on his worldline has proper time ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a43b94d-fb44-4c93-ac1d-d9d48b09605d"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[CurlyPhi]", "TI"],
 "] ",
 StyleBox["s", "TI"],
 ", with the scale ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05522d30-54cd-4920-b5bd-525c2f5245f3"],
 ". This is the identity that makes the Euclidean picture honest; it is \
verified against the radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ac7a743-8962-40c0-9a31-a2e9964a0729"],
 " below."
}], "Item",ExpressionUUID->"7d29c80c-7282-4ec9-ad54-3b146a745619"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"WorldlineDirection", "[", 
            RowBox[{"v", ",", " ", "phi"}], "]"}]}], ",", " ", "phi"}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ProperTimeScale", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
        RowBox[{"s", "^", "2"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"e74362c9-b50e-4fe9-a39f-57b80a04eb97"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"db3d3dea-40c5-4805-bece-e393eeff2f47"]
}, Open  ]],

Cell["Radar time and radar distance", "Section",ExpressionUUID->"6e039a30-7661-4157-9594-6cc1285dbb8e"],

Cell[TextData[{
 "Alice locates an event by radar: she sends light at her proper time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "099f705f-6dc0-4dbf-aab9-b6ac6a9ae36d"],
 ", it is echoed at the event and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca805332-2add-4d72-9a59-7bef3f7dcbdc"],
 ". The event's radar time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7ccda2a-07d3-40eb-b20f-56a1b1b93eea"],
 " and its radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ae734fb-e017-4adf-8b99-153f98cbfd98"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89ea2063-32b1-4e63-9adf-6349c45da3ad"],
 ")."
}], "Item",ExpressionUUID->"d51409dc-42df-42e9-8e43-9e5b631c2595"],

Cell[TextData[{
 "Apply it to Bob. Alice sends at ",
 StyleBox["T", "TI"],
 "; Bob receives at ",
 StyleBox["kT", "TI"],
 " on his clock and echoes at once; Alice receives at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CenterDot]", 
   StyleBox["k", "TI"], 
   StyleBox["T", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25afe8a8-9d08-4e9c-b8c3-cf4e405ea715"],
 ". So Bob's reflection has radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccfe920e-eff7-4dfd-86aa-4c09dc491e82"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4b5a55-7ce7-4bd2-b3a7-6d952205d310"],
 ", and Bob's velocity is their ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdc26a00-e840-495f-bdc8-f9fa4d2a85b6"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VelocityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09552a83-d287-453f-86e8-399ede4e4212"],
 "). With ",
 StyleBox["k", "TI"],
 " = 2 and ",
 StyleBox["T", "TI"],
 " = 1:"
}], "Item",ExpressionUUID->"444a2d83-7317-4f24-856c-f918c41017c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{"VelocityFromK", "[", "k", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"18a0d996-3536-4698-a08e-2699fcb294d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "2"], ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["3", "5"]}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"a1395ef5-0425-4861-876c-d8dc98cf0ff3"]
}, Open  ]],

Cell[TextData[{
 "The same numbers from the picture: the first reflection of a light zigzag (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e9e92d3-4b92-4975-b144-02769d17c7e3"],
 ") from Alice's arc length 1 to Bob at velocity 3/5 has radar time 5/2 and \
radar distance 3/2, and Bob's clock reads ",
 StyleBox["kT", "TI"],
 " = 2 there."
}], "Item",ExpressionUUID->"294dcb5d-1b5f-4f7e-b1a2-32113050c585"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bounce", " ", "=", " ", 
     RowBox[{
      RowBox[{"LightZigzag", "[", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "1"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"x", " ", "|->", " ", 
        RowBox[{"FullSimplify", " ", "@", " ", 
         RowBox[{"TrigExpand", " ", "@", " ", "x"}]}]}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"bounce", "[", "\"\<Point\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"3", "/", "5"}], "]"}], " ", 
       RowBox[{"bounce", "[", "\"\<ArcLength\>\"", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"27035318-8f27-44f5-b92d-01e8158e3569"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RadarTime\"\>", "\[Rule]", 
      FractionBox["5", "2"]}], ",", 
     RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
      FractionBox["3", "2"]}]}], "\[RightAssociation]"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"e4dc0a46-ea6d-47c6-9f95-9c6db503a093"]
}, Open  ]],

Cell["Time dilation", "Section",ExpressionUUID->"06296ed0-3fe5-4436-9093-96af05ef587a"],

Cell[TextData[{
 "In the computation above Bob's clock read ",
 StyleBox["kT", "TI"],
 " at the reflection, while Alice's radar time of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ce59b64-a500-47c9-a2df-f6c9fcb20956"],
 ". Their ratio is the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "=", "1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e5fea9-0ff6-4204-b724-1fc60f5f5b04"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzGamma"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzGamma", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93dd1073-7781-400d-a61c-1ee703a6a12c"],
 "): Alice assigns every event on Bob's worldline \[Gamma] times Bob's own \
reading. At ",
 StyleBox["v", "TI"],
 " = 3/5, \[Gamma] = (2 + 1/2)/2 = 5/4."
}], "Item",ExpressionUUID->"01374b63-5cb4-4e86-b116-150c3e4cab75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzGamma", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{"WorldlinePointAtProperTime", "[", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", " ", "tau", ",", " ", 
           RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"5", "/", "4"}], " ", "tau"}]}], ",", " ", 
     RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"cc82b4e7-33a2-4151-9010-b341e03e1a70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"c2d1bac5-0ffc-400c-be7e-c4dec9bcfb02"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TimeDilationConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "832caf7f-4bf7-4bd1-a8de-d90f230c4946"],
 " draws the radar measurement of one event ",
 StyleBox["B", "TI"],
 " of Bob's. Both worldlines carry ticks at equal proper-time steps, a \
quarter of Bob's reading at ",
 StyleBox["B", "TI"],
 "; Alice's ticks reach her radar time of ",
 StyleBox["B", "TI"],
 " after \[Gamma] times as many steps, and the dashed line is her \
simultaneity line through ",
 StyleBox["B", "TI"],
 "."
}], "Item",ExpressionUUID->"227a7db8-81fa-4e1c-8273-5b4a76e23925"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TimeDilationConstruction", "[", "0.6", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"b3b4eef0-c379-477a-b02f-98c6e2f75f48"],

