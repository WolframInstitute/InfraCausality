Cell[TextData[{
 "Every point of Bob's line has its radar midpoint at ",
 StyleBox["B", "TI"],
 ": here ",
 StyleBox["B", "TI"],
 " is at arc length ",
 StyleBox["s", "TI"],
 " and the point at the end of the line, for every velocity and light angle."
}], "Item",ExpressionUUID->"ed71e001-ca35-441a-92c0-83d43fa91d8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"midpoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SimultaneityLine", "[", 
          RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}],
          "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
       "]"}], " ", "==", " ", "s"}], ",", " ", 
     RowBox[{
      RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
       RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"e503feca-e7ba-4e2b-9474-2dd4fee0604d"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"1d01d012-7db6-46b0-b9cf-23e77f3cce8a"]
}, Open  ]],

Cell["Length contraction", "Section",ExpressionUUID->"215750e1-6df6-4756-b557-14a78b3f5499"],

Cell[TextData[{
 "A rod at rest for Bob has two parallel worldlines. Its rest length ",
 StyleBox["L", "TI"],
 " is measured across them along Bob's line of simultaneity; Alice measures \
across them at one of her radar times, and she finds ",
 StyleBox["L", "TI"],
 "/\[Gamma]. The computation in radar coordinates, for ",
 StyleBox["L", "TI"],
 " = 1 and ",
 StyleBox["v", "TI"],
 " = 3/5: the back end is displaced along Bob's simultaneity direction by \
Minkowski length 1, and Alice's length is the difference of the radar \
distances of the two worldlines at one radar time."
}], "Item",ExpressionUUID->"2f206e3d-e7c7-4a6a-9cf8-fc71577d37c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"3", "/", "5"}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"radar", " ", "=", " ", 
      RowBox[{"p", " ", "|->", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
           "}"}]}], "]"}]}]}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"radar", "[", "n", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"v", " ", 
        RowBox[{
         RowBox[{"radar", "[", "n", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"LorentzGamma", "[", "v", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"725b641e-67dd-450b-94b0-80c7e17d1dff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["4", "5"], ",", 
   FractionBox["4", "5"]}], "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"7893d623-bb57-475b-8f4f-55626035c15a"]
}, Open  ]],

