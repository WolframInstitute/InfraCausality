Cell["\<\
The ratio of Alice's radar-time steps to Bob's proper-time steps between \
consecutive ticks is \[Gamma] = 5/4.\
\>", "Item",ExpressionUUID->"6c9f9895-dfb1-4529-9b53-00f42d0f06fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ticks", " ", "=", " ", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"LightClockConstruction", "[", "0.6", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"pts_", " ", "/;", " ", 
            RowBox[{
             RowBox[{"Length", "[", "pts", "]"}], " ", ">", " ", "3"}]}], 
           "]"}], " ", ":>", " ", "pts"}], ",", " ", "Infinity"}], "]"}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", 
        RowBox[{"-", "1"}], " ", ";;", " ", "2"}], "]"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{"ticks", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", "ticks"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"0abee0f7-0989-47b5-a0f3-1eaa5343b1b5"],

