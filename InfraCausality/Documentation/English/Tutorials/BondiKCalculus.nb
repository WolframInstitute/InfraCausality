Cell[TextData[{
 "Read off the drawing, the reception intervals in Bob's proper time are ",
 StyleBox["k", "TI"],
 " = 2 times the emission intervals."
}], "Item",ExpressionUUID->"a2e0c545-bbd9-4520-ae99-667b0d8afe7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"disks", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"DopplerConstruction", "[", "0.6", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Disk", "[", 
         RowBox[{"c_", ",", " ", "_"}], "]"}], " ", ":>", " ", "c"}], ",", 
       " ", "Infinity"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"ProperTimeScale", "[", "0.6", "]"}], " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"disks", ",", " ", 
          RowBox[{"c", " ", "|->", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}]}]}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"disks", ",", " ", 
        RowBox[{"c", " ", "|->", " ", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "0"}]}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"fc2780d9-d6b8-4a0a-899c-52248a39015a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.`", ",", "2.`", ",", "2.`", ",", "1.9999999999999982`", ",", "2.`"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"e41343ef-8082-4598-82ca-cd938bb85c1f"]
}, Open  ]],

Cell["Proper time is linear in arc length", "Section",ExpressionUUID->"e7962aa8-b2e3-4701-a615-5164956ca235"],

Cell[TextData[{
 "Bob's proper time is not his Euclidean arc length, but it is proportional \
to it: the event at arc length ",
 StyleBox["s", "TI"],
 " on his worldline has proper time ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProperTimeScale"]], 
    "paclet:WolframInstitute/InfraCausality/ref/ProperTimeScale", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6cf58ba8-c388-46b1-bf74-3e058cca4f19"],
 "[",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[CurlyPhi]", "TI"],
 "] ",
 StyleBox["s", "TI"],
 ", with the scale ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6a62681-d386-4926-b603-49e82d908967"],
 ". This is the identity that makes the Euclidean picture honest; it is \
verified against the radar interval ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac4cd718-0276-48f3-b386-04424b1a99c2"],
 " below."
}], "Item",ExpressionUUID->"0ba9c3e0-e531-4b28-a868-54a95f2a2e1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"BondiRadarCoordinates", "[", 
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"Through", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
             RowBox[{"WorldlineAngle", "[", 
              RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}]}], ",", " ",
           "phi"}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarTime\>\"", "]"}], "^", "2"}], " ", "-", 
        " ", 
        RowBox[{
         RowBox[{"r", "[", "\"\<RadarDistance\>\"", "]"}], "^", "2"}]}], " ", 
       "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ProperTimeScale", "[", 
          RowBox[{"v", ",", " ", "phi"}], "]"}], "^", "2"}], " ", 
        RowBox[{"s", "^", "2"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
     RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"4df8f935-edf8-4d77-8988-3a7a8559b3c5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"064a5092-fc1d-4568-a1b0-e0423d35e29f"]
}, Open  ]],

Cell["Radar time and radar distance", "Section",ExpressionUUID->"1bb104f5-388f-4923-a133-46344ac1f5c9"],

Cell[TextData[{
 "Alice locates an event by radar: she sends light at her proper time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "382d9276-2e87-4984-8a8c-70eed4dd8e94"],
 ", it is echoed at the event and returns at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a644489-e5e5-48ed-9b3c-f2796176a163"],
 ". The event's radar time is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3940251b-5ba6-4638-ae58-03285473143d"],
 " and its radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c550890-a018-4a7f-9add-43291b632277"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68647d61-3185-42d0-b8d8-15f641d94a87"],
 ")."
}], "Item",ExpressionUUID->"12e3f4da-107e-40af-b442-a7f0cd2ae55d"],

Cell[TextData[{
 "Apply it to Bob. Alice sends at ",
 StyleBox["T", "TI"],
 "; Bob receives at ",
 StyleBox["kT", "TI"],
 " on his clock and echoes at once; Alice receives at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[CenterDot]", 
   StyleBox["k", "TI"], 
   StyleBox["T", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd6cd8d7-faeb-4baf-a747-60e54bf1b6b7"],
 ". So Bob's reflection has radar time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ed6cb6a-617b-4414-b17a-dd452f1f87d2"],
 " and radar distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47287c66-9d49-42d9-b7f5-7325e6e4cce0"],
 ", and Bob's velocity is their ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bd97f71-bcb0-4f22-9647-7032c71f9109"],
 ", the inverse of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiKFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiKFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c113c4c2-7718-4c0d-9758-d6762a0e82a6"],
 ". With ",
 StyleBox["k", "TI"],
 " = 2 and ",
 StyleBox["T", "TI"],
 " = 1:"
}], "Item",ExpressionUUID->"ea87c21f-06ab-451e-8d19-752097adb856"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"T", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}]}], ",", " ", 
     RowBox[{"BondiKFactor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], " ", "-", " ", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], " ", "+", " ", "1"}], ")"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"033bb6fc-6086-48d0-9dd5-44d059fac301"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "2"], ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["3", "5"], ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"163ce7bc-ca71-4af7-93ae-d33c45fae372"]
}, Open  ]],

Cell[TextData[{
 "The same numbers from the picture: the first reflection of a light zigzag (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LightZigzag"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LightZigzag", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b29a7bbf-da88-47ff-86c3-ccac9efbc3c0"],
 ") from Alice's arc length 1 to Bob at velocity 3/5 has radar time 5/2 and \
radar distance 3/2, and Bob's clock reads ",
 StyleBox["kT", "TI"],
 " = 2 there."
}], "Item",ExpressionUUID->"6616470f-5054-4e24-b078-90d8702504c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bounce", " ", "=", " ", 
     RowBox[{
      RowBox[{"LightZigzag", "[", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "1"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"x", " ", "|->", " ", 
        RowBox[{"FullSimplify", " ", "@", " ", 
         RowBox[{"TrigExpand", " ", "@", " ", "x"}]}]}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"BondiRadarCoordinates", "[", 
          RowBox[{"bounce", "[", "\"\<Point\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ProperTimeScale", "[", 
        RowBox[{"3", "/", "5"}], "]"}], " ", 
       RowBox[{"bounce", "[", "\"\<ArcLength\>\"", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"d7f54307-7a4d-49a4-889e-f0df2f7cb502"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RadarTime\"\>", "\[Rule]", 
      FractionBox["5", "2"]}], ",", 
     RowBox[{"\<\"RadarDistance\"\>", "\[Rule]", 
      FractionBox["3", "2"]}]}], "\[RightAssociation]"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"2173cdd6-4124-4f46-a965-d2888242e137"]
}, Open  ]],

Cell["Time dilation", "Section",ExpressionUUID->"37e3feae-1ece-4a1e-8994-2d66c28f300f"],

Cell[TextData[{
 "In the computation above Bob's clock read ",
 StyleBox["kT", "TI"],
 " at the reflection, while Alice's radar time of it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec073b94-629b-4e36-9546-8a8627374852"],
 ". Their ratio is the Lorentz factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "+", "1", "/", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "=", "1", "/", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbfab6de-b0c1-4a0b-bedf-1300ef927a91"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LorentzFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/LorentzFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40d12d1b-20c0-437a-9cd6-baae03511d17"],
 "): Alice assigns every event on Bob's worldline \[Gamma] times Bob's own \
reading. At ",
 StyleBox["v", "TI"],
 " = 3/5, \[Gamma] = (2 + 1/2)/2 = 5/4."
}], "Item",ExpressionUUID->"cd45d7b9-d1a1-4de2-820a-4f6c19742737"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LorentzFactor", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"BondiRadarCoordinates", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tau", "/", 
           RowBox[{"ProperTimeScale", "[", 
            RowBox[{
             RowBox[{"3", "/", "5"}], ",", " ", 
             RowBox[{"Pi", "/", "3"}]}], "]"}]}], " ", 
          RowBox[{"Through", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
            RowBox[{"WorldlineAngle", "[", 
             RowBox[{
              RowBox[{"3", "/", "5"}], ",", " ", 
              RowBox[{"Pi", "/", "3"}]}], "]"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], "[", "\"\<RadarTime\>\"", "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"5", "/", "4"}], " ", "tau"}]}], ",", " ", 
     RowBox[{"tau", " ", ">", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"0e932015-c126-4c7a-8e84-81dbd0b8caa9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["5", "4"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"7222ffdf-b265-4f50-a5e0-82f00ddf1536"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TimeDilationConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/TimeDilationConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75369567-275c-430a-a640-80e44d4da08d"],
 " draws the radar measurement of one event ",
 StyleBox["B", "TI"],
 " of Bob's. Both worldlines carry ticks at equal proper-time steps, a \
quarter of Bob's reading at ",
 StyleBox["B", "TI"],
 "; Alice's ticks reach her radar time of ",
 StyleBox["B", "TI"],
 " after \[Gamma] times as many steps, and the dashed line is her \
simultaneity line through ",
 StyleBox["B", "TI"],
 "."
}], "Item",ExpressionUUID->"0775d672-3368-4f08-a107-d36b3965ba67"],

