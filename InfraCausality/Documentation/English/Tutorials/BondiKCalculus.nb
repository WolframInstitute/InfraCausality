Cell["Velocity addition", "Section",ExpressionUUID->"996b3f20-11ff-4789-b33c-0f9335f7153d"],

Cell[TextData[{
 "Carol moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ed8b1e4-48b5-430e-bd35-a6c3145896db"],
 " relative to Bob, who moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a6deae4-becf-4672-b34d-5c44199708f7"],
 " relative to Alice. A signal from Alice to Carol passing Bob is received by \
Bob at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b86df3d5-b1f5-4683-8866-49cce5ccda21"],
 " times its emission and by Carol at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea3983d5-f644-4dce-aa39-321d86d3a28b"],
 " times Bob's reception, so the k-factor of Carol relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b32309c4-9252-4c93-a2ba-f6a02df1f6d1"],
 ": k-factors multiply, and the composed velocity is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e59f4d95-25dc-46e5-8746-2fd20a930130"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["v", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "1"], 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ef23ccc-46bb-475e-ae1b-d857e31ba9ce"],
 ". The rapidities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb5b7d05-55eb-4507-9fbd-586bbe40a805"],
 " add (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RapidityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ddcfa0db-c9b8-4d5b-927e-ad1018f4b46a"],
 ")."
}], "Item",ExpressionUUID->"c2614355-09df-4fdc-8446-d5deb54c420c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VelocityFromK", "[", 
      RowBox[{
       RowBox[{"KFactor", "[", "v1", "]"}], " ", 
       RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
      RowBox[{"Rapidity", "[", "v2", "]"}]}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"ab813911-7a71-49d3-b504-db5318d450be"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"328d718a-15e4-44cc-9a35-ae29ff42a76a"]
}, Open  ]],

