Cell["Simultaneity", "Section",ExpressionUUID->"71324c57-a262-47e1-ab06-3f124218cb19"],

Cell[TextData[{
 "Bob calls an event simultaneous with his event ",
 StyleBox["B", "TI"],
 " when its radar emission and return on his worldline are equally far before \
and after ",
 StyleBox["B", "TI"],
 ". These events form a line through ",
 StyleBox["B", "TI"],
 ", along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bb73f6a-f714-40e0-a6e2-8059fa68c520"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37588c3b-5a8b-433a-b64d-70163e945078"],
 "): horizontal for Alice, and of slope ",
 StyleBox["v", "TI"],
 " at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 for Bob. Events simultaneous for one observer are not \
simultaneous for the other."
}], "Item",ExpressionUUID->"f4d5b677-478b-4abd-ad12-327f22cc01da"],

