Cell["The k-factor and the Doppler effect", "Section",ExpressionUUID->"be4d6906-a951-4338-b5d5-2bb3c02b90da"],

Cell[TextData[{
 "Alice emits pulses at equal intervals of her proper time; Bob receives them \
at equal intervals of his, ",
 StyleBox["k", "TI"],
 " times longer. By symmetry the same ",
 StyleBox["k", "TI"],
 " relates Bob's emissions to Alice's receptions. Radar gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80c6ad3a-89ff-493b-bc71-76b09df55230"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BondiKFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/BondiKFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "346e8147-eba4-4646-807e-f06499afde81"],
 "), the relativistic Doppler factor: the velocity 3/5 has ",
 StyleBox["k", "TI"],
 " = 2."
}], "Item",ExpressionUUID->"adb36409-f1d0-4e4a-8ed6-2b9c95909045"],

Cell[TextData[{
 "In the picture, light emitted at arc length ",
 StyleBox["s", "TI"],
 " on Alice's worldline reaches Bob at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4456d95-c867-4779-99cf-7713a1c60b3c"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e126d1b8-9d49-4d3e-b4f4-f1c81edc4a35"],
 "), and light from Bob at ",
 StyleBox["s", "TI"],
 " reaches Alice at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6978574-4a5f-4c8f-945e-57591e28103c"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bf44860a-a56d-40af-886b-fa7af3e4f5e5"],
 "). These are Euclidean ratios and depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 "; the k-factor ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"i", "n"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d34b7d9-23d6-4238-9225-946705cbf8a6"],
 " does not."
}], "Item",ExpressionUUID->"c31380da-3ca0-42e3-a8ff-783071021d41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
