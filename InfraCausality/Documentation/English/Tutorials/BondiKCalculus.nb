Cell["The k-factor and the Doppler effect", "Section",ExpressionUUID->"83f32eca-26c4-4422-a681-2fe7d84d9d29"],

Cell[TextData[{
 "Alice emits pulses at equal intervals of her proper time; Bob receives them \
at equal intervals of his, ",
 StyleBox["k", "TI"],
 " times longer. By symmetry the same ",
 StyleBox["k", "TI"],
 " relates Bob's emissions to Alice's receptions. Radar gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38bb58b2-fb90-493c-bdac-49487c654b83"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41d402d8-5da4-42c4-9bbd-71e686b1cd5b"],
 "), the relativistic Doppler factor: the velocity 3/5 has ",
 StyleBox["k", "TI"],
 " = 2."
}], "Item",ExpressionUUID->"0dffd3cd-9cf6-4982-93f1-6ee8741899c6"],

Cell[TextData[{
 "In the picture, light emitted at arc length ",
 StyleBox["s", "TI"],
 " on Alice's worldline reaches Bob at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9298b526-3363-49a0-bc11-d6cf9585f542"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "afa02ac7-6da2-4e8b-9fc9-e9c348be54b5"],
 "), and light from Bob at ",
 StyleBox["s", "TI"],
 " reaches Alice at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba3d0be2-dda8-4747-93a1-ee9f4d82b826"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7262e356-da91-4b6a-b1d7-6ca0f9f69a82"],
 "). These are Euclidean ratios and depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 "; the k-factor ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"i", "n"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97c335e4-d0b0-43ad-9dfc-a6ab6e9985bc"],
 " does not."
}], "Item",ExpressionUUID->"2ddadd4f-20ed-445c-8167-1ff9af67111f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KFactor", "[", 
