Cell[TextData[{
 "Every point of Bob's line has its radar midpoint at ",
 StyleBox["B", "TI"],
 ": here ",
 StyleBox["B", "TI"],
 " is at arc length ",
 StyleBox["s", "TI"],
 " and the point at the end of the line, for every velocity and light angle."
}], "Item",ExpressionUUID->"ecd07893-7fa1-473a-9d58-993d064fde9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"WorldlineDirection", "[", 
                 RowBox[{"v", ",", " ", "phi"}], "]"}], ",", " ", 
                RowBox[{"LightDirection", "[", 
                 RowBox[{"phi", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"midpoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SimultaneityLine", "[", 
          RowBox[{"v", ",", " ", "s", ",", " ", "phi", ",", " ", "c"}], "]"}],
          "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", "v", ",", " ", "phi"}], 
       "]"}], " ", "==", " ", "s"}], ",", " ", 
     RowBox[{
      RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
       RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"942b062c-c54f-4e22-904d-9d9867fe596a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"6deb97e1-7739-4813-acd9-b343fb682c0d"]
}, Open  ]],

Cell["Length contraction", "Section",ExpressionUUID->"b7741be8-ae02-4c13-9a29-7e32a44fc899"],

Cell[TextData[{
 "A rod at rest for Bob has two parallel worldlines. Its rest length ",
 StyleBox["L", "TI"],
 " is measured across them along Bob's line of simultaneity; Alice measures \
across them at one of her radar times, and she finds ",
 StyleBox["L", "TI"],
 "/\[Gamma]. The computation in radar coordinates, for ",
 StyleBox["L", "TI"],
 " = 1 and ",
 StyleBox["v", "TI"],
 " = 3/5: the back end is displaced along Bob's simultaneity direction by \
Minkowski length 1, and Alice's length is the difference of the radar \
distances of the two worldlines at one radar time."
}], "Item",ExpressionUUID->"d973a62f-fa5e-4d29-860e-6ecc4ce1c7ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"3", "/", "5"}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"radar", " ", "=", " ", 
      RowBox[{"p", " ", "|->", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
           "}"}]}], "]"}]}]}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"radar", "[", "n", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"v", " ", 
        RowBox[{
         RowBox[{"radar", "[", "n", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"LorentzGamma", "[", "v", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"828dcf0e-560f-4418-a01f-329befc13d4c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["4", "5"], ",", 
   FractionBox["4", "5"]}], "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"38d983ac-064b-4bea-b4a0-5d35471752b4"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LengthContractionConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/\
LengthContractionConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e43b8c2-2ef0-43e9-af3c-617567abd768"],
 " draws a rod at ",
 StyleBox["v", "TI"],
 " = 0.6 and its radar measurement by Alice. Its back end is offset along the \
Euclidean normal of Bob's worldline rather than his line of simultaneity, so \
the drawn rod is longer than the printed ",
 StyleBox["L", "TI"],
 ": its printed ",
 StyleBox["L", "TI"],
 "/\[Gamma] is the contraction of a rod of rest length ",
 StyleBox["L", "TI"],
 ", not a reading of the drawing (see its reference page)."
}], "Item",ExpressionUUID->"1890b596-c5f1-4695-834e-4c13de0d9d30"],

