       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Phi] = \>\"", ",", " ", "phi"}], "}"}], "]"}]}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"phi", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "3"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"758b90d5-1bfe-40b9-9a90-3637de9aca60"],

