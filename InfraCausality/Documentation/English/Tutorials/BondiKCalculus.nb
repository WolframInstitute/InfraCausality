Cell["Simultaneity", "Section",ExpressionUUID->"7d97753b-2518-4b60-8cc0-c1a3c030fcc9"],

Cell[TextData[{
 "Bob calls an event simultaneous with his event ",
 StyleBox["B", "TI"],
 " when its radar emission and return on his worldline are equally far before \
and after ",
 StyleBox["B", "TI"],
 ". These events form a line through ",
 StyleBox["B", "TI"],
 ", along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["tan",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ceaf7bd-3b3b-4666-9c1a-4b22e7bfbfed"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimultaneityLine"]], 
    "paclet:WolframInstitute/InfraCausality/ref/SimultaneityLine", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3acb13e6-e0bc-4afc-a55c-7a8cca1cbffd"],
 "): horizontal for Alice, and of slope ",
 StyleBox["v", "TI"],
 " at ",
 StyleBox["\[CurlyPhi]", "TI"],
 " = \[Pi]/4 for Bob. Events simultaneous for one observer are not \
simultaneous for the other."
}], "Item",ExpressionUUID->"46b533b4-8708-4370-95fa-631e66fcc783"],

