Cell["The k-factor and the Doppler effect", "Section",ExpressionUUID->"5dcd83d4-f877-48bf-89b6-93a60eda7b0f"],

Cell[TextData[{
 "Alice emits pulses at equal intervals of her proper time; Bob receives them \
at equal intervals of his, ",
 StyleBox["k", "TI"],
 " times longer. By symmetry the same ",
 StyleBox["k", "TI"],
 " relates Bob's emissions to Alice's receptions. Radar gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["v", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94630680-25f9-41cf-89cf-7bafe7be049e"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KFactor"]], 
    "paclet:WolframInstitute/InfraCausality/ref/KFactor", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3741a045-7551-47c1-ac1f-f816daf06c00"],
 "), the relativistic Doppler factor: the velocity 3/5 has ",
 StyleBox["k", "TI"],
 " = 2."
}], "Item",ExpressionUUID->"3762907f-bd0b-44f4-90b4-6ef37c39e56f"],

Cell[TextData[{
 "In the picture, light emitted at arc length ",
 StyleBox["s", "TI"],
 " on Alice's worldline reaches Bob at arc length ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7629c7fd-bde5-4a53-9e38-b9b7a13be8bb"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutgoingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/OutgoingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41debf82-9745-4b5f-b272-56424db1d77a"],
 "), and light from Bob at ",
 StyleBox["s", "TI"],
 " reaches Alice at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"]], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02c0bb17-ece2-4444-b59e-3942bc2ec0e6"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncomingRatio"]], 
    "paclet:WolframInstitute/InfraCausality/ref/IncomingRatio", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4b7797b-b262-42e0-857c-a97240a7c8f4"],
 "). These are Euclidean ratios and depend on ",
 StyleBox["\[CurlyPhi]", "TI"],
 "; the k-factor ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox[
      RowBox[{"i", "n"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abd4089a-f650-4323-b86e-75d4627c4a23"],
 " does not."
}], "Item",ExpressionUUID->"c23b7388-55a4-4f4d-b6de-a88f1d32dfcf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KFactor", "[", 
    RowBox[{"3", "/", "5"}], "]"}], ",", " ", 
