}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DopplerConstruction"]], 
    "paclet:WolframInstitute/InfraCausality/ref/DopplerConstruction", 
    "WolframInstitute/InfraCausality Package Symbol"},
