Cell[TextData[{
 "From Alice's arc length 1 at velocity 3/5, her reception arc lengths are \
the powers of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c82fe7d-2259-4903-9c50-39046d2068e9"],
 ", so the number of round trips to the arc length ",
 StyleBox["s", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["s", "TI"], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "510ceb2a-ceaf-437d-b12f-fb11473a825a"],
 ", a logarithm of the arc length."
}], "Item",ExpressionUUID->"f0b8ca23-940e-4fa1-aa36-923edaac44d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8"}], "]"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
            " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
        " ", "\"\<ArcLength\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arcs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "arcs", "]"}], "/", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"BondiKFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "^", "2"}], "]"}]}], " ", "//", " ",
       "FullSimplify"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"b3786f32-1376-45cf-95dc-cad2fe8ce0aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "16", ",", "64", ",", "256"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"8c07c361-c5f7-43b8-affc-c0d9eb54404e"]
}, Open  ]],

Cell["From the plane to graphs", "Section",ExpressionUUID->"3b68cfc3-f703-499f-8927-b1a6ebf62db1"],

Cell[TextData[{
 "On a causal graph the same radar rule gives the radar coordinates of an \
observer chain, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarCoordinates"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarCoordinates", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52b6cd2e-62c3-44df-99d6-33001b6bf496"],
 ", whose time and distance are the half-sum and half-difference of the \
emission and reception ticks; the Causal Infrageometry tutorial builds it. \
The k-factor has a graph reading as well: on the diamond lattice the chain at \
rest echoed by a chain of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) reads ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["p", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13fe697c-54a1-4add-bc61-e2de88d1a10b"],
 ", the Bondi factor of that velocity."
}], "Item",ExpressionUUID->"1dc60c28-ecdf-4a67-b5b3-7db03dd9680b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"BondiKFactor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "==",
     " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", " ", "+", " ", "1"}], ")"}], "/", "p"}], "]"}]}], ",", 
   " ", 
   RowBox[{"p", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"62ec5a38-759a-4c40-95d0-eaf23bdc03e8"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"3a9c534e-345e-406b-96f3-c7e87dc1fe56"]
}, Open  ]],

