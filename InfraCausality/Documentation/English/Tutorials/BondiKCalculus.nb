Cell["Velocity addition", "Section",ExpressionUUID->"bc21fd26-891e-4bdd-8364-15e94858ebeb"],

Cell[TextData[{
 "Carol moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c5f2353-ef03-45a7-9ff2-18a3b46d1e0b"],
 " relative to Bob, who moves at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["v", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "902a0bd6-d007-4639-8049-5f8a1e575977"],
 " relative to Alice. A signal from Alice to Carol passing Bob is received by \
Bob at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719f3dad-5707-4cf0-be3a-b5e0d56f3db4"],
 " times its emission and by Carol at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a5ccc06-043b-4fb8-8285-9d1fc43dfbb4"],
 " times Bob's reception, so the k-factor of Carol relative to Alice is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "1"], 
   SubscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5fcc471-2f5c-4d79-b082-b497163deea0"],
 ": k-factors multiply, and the composed velocity is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VelocityFromK"]], 
     "paclet:WolframInstitute/InfraCausality/ref/VelocityFromK", 
     "WolframInstitute/InfraCausality Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["k1", "TI"], " ", 
    StyleBox["k2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caa3b47d-8783-475f-ab4d-59b778fbe50f"],
 " ",
 Cell[BoxData[
  RowBox[{"=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["v", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["v", "TI"], "1"], 
     SubscriptBox[
      StyleBox["v", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185b8f12-f4b5-4872-a5f4-cf41a4529164"],
 ". The rapidities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d27349e9-f168-4c82-ab64-bf51d9dff834"],
 " add (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RapidityFromK"]], 
    "paclet:WolframInstitute/InfraCausality/ref/RapidityFromK", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "140ba180-9f06-47a3-b5eb-227cc79d4418"],
 ")."
}], "Item",ExpressionUUID->"95606e24-1669-423a-8d84-afd6f7feedba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VelocityFromK", "[", 
      RowBox[{
       RowBox[{"KFactor", "[", "v1", "]"}], " ", 
       RowBox[{"KFactor", "[", "v2", "]"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"v1", " ", "v2"}]}], ")"}]}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Rapidity", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", " ", "+", " ", "v2"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"v1", " ", "v2"}]}], ")"}]}], "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
      RowBox[{"Rapidity", "[", "v2", "]"}]}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"8f80b71f-629c-47e3-a361-1a2c61bbdbeb"],

