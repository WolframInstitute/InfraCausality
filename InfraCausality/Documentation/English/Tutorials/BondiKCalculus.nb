Cell[TextData[{
 "From Alice's arc length 1 at velocity 3/5, her reception arc lengths are \
the powers of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09dd8bd6-198c-4f95-9925-b91ad2197ba0"],
 ", so the number of round trips to the arc length ",
 StyleBox["s", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["s", "TI"], "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705f7a3d-ba69-4f7e-b9e3-c2abf07f9d1c"],
 ", a logarithm of the arc length."
}], "Item",ExpressionUUID->"2cf3de39-9371-48b2-826b-b38014f5ad75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"arcs", " ", "=", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"LightZigzag", "[", 
           RowBox[{
            RowBox[{"3", "/", "5"}], ",", " ", "1", ",", " ", "8"}], "]"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Observer\>\"", "]"}], " ", "===", 
            " ", "\"\<Alice\>\""}], " ", "&"}]}], "]"}], ",", 
        " ", "\"\<ArcLength\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arcs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "arcs", "]"}], "/", 
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"KFactor", "[", 
          RowBox[{"3", "/", "5"}], "]"}], "^", "2"}], "]"}]}], " ", "//", " ",
       "FullSimplify"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"e7ed1f92-a350-4438-8f02-fc58bf573002"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "16", ",", "64", ",", "256"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"b6125ce0-6ab1-4f49-bdc9-4bfc53d7a40d"]
}, Open  ]],

Cell["From the plane to graphs", "Section",ExpressionUUID->"f5a65586-50ad-455f-b6be-16e557dfb75b"],

Cell[TextData[{
 "On a causal graph the same radar rule gives the radar chart of an observer \
chain, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRadarChart"]], 
    "paclet:WolframInstitute/InfraCausality/ref/InfraRadarChart", 
    "WolframInstitute/InfraCausality Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9ac57bb-d2ab-482c-b14a-796757d00203"],
 ", whose time and distance are the half-sum and half-difference of the \
emission and reception ticks; the Causal Infrageometry tutorial builds it. \
The k-factor has a graph reading as well: on the diamond lattice the chain at \
rest echoed by a chain of velocity 1/(2",
 StyleBox["p", "TI"],
 " + 1) reads ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["p", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0687ff1d-acc3-4d7d-9206-4b87c83adb3f"],
 ", the Bondi factor of that velocity."
}], "Item",ExpressionUUID->"c9ea890e-0128-4ab1-8dc1-09e1b2438518"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KFactor", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "==",
     " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", " ", "+", " ", "1"}], ")"}], "/", "p"}], "]"}]}], ",", 
   " ", 
   RowBox[{"p", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"f2dc9339-601f-4848-a49e-00bed4186dd8"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"ad35c46f-f7cc-40d6-971b-27e2afe785bc"]
}, Open  ]],

