     RowBox[{
      RowBox[{"Rapidity", "[", "v1", "]"}], " ", "+", " ", 
      RowBox[{"Rapidity", "[", "v2", "]"}]}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "v1", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "v2", " ", "<", " ", "1"}]}]}], 
