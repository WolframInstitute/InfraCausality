Cell[TextData[{
 "Every point of Bob's line has its radar midpoint at ",
 StyleBox["B", "TI"],
 ": here ",
 StyleBox["B", "TI"],
 " is at arc length ",
 StyleBox["s", "TI"],
 " and the point at the end of the line, for every velocity and light angle."
}], "Item",ExpressionUUID->"31d3ad4a-6588-4efa-8009-f4a82637a940"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"midpoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "v", ",", " ", "phi"}], "}"}], " ", "|->", " ", 
      
      RowBox[{"Mean", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"right", " ", "|->", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Through", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
                  RowBox[{"WorldlineAngle", "[", 
                   RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}], ",", 
                " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{"right", ",", " ", "1", ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}], " ", 
                   RowBox[{"Sin", "[", "phi", "]"}]}], ",", " ", 
                  RowBox[{"Cos", "[", "phi", "]"}]}], "}"}]}], "}"}], "]"}], ",",
              " ", "p"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"midpoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"s", " ", 
          RowBox[{"Through", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Sin", ",", " ", "Cos"}], "}"}], "[", 
            RowBox[{"WorldlineAngle", "[", 
             RowBox[{"v", ",", " ", "phi"}], "]"}], "]"}], "]"}]}], " ", "+", 
         " ", 
         RowBox[{"c", " ", 
          RowBox[{"Normalize", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}], 
           "]"}]}]}], ",", " ", "v", ",", " ", "phi"}], "]"}], " ", "==", " ",
       "s"}], ",", " ", 
     RowBox[{
      RowBox[{"0", " ", "<", " ", "v", " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "phi", " ", "<", " ", 
       RowBox[{"Pi", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"de55f0ac-94e8-42b9-a14d-19f05ec9b868"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"1489c27f-5b37-41f9-907a-91ee82d5c18a"]
}, Open  ]],

Cell["Length contraction", "Section",ExpressionUUID->"6f3d332e-8161-47ac-baa4-9bcc71dc9c39"],

Cell[TextData[{
 "A rod at rest for Bob has two parallel worldlines. Its rest length ",
 StyleBox["L", "TI"],
 " is measured across them along Bob's line of simultaneity; Alice measures \
across them at one of her radar times, and she finds ",
 StyleBox["L", "TI"],
 "/\[Gamma]. The computation in radar coordinates, for ",
 StyleBox["L", "TI"],
 " = 1 and ",
 StyleBox["v", "TI"],
 " = 3/5: the back end is displaced along Bob's simultaneity direction by \
Minkowski length 1, and Alice's length is the difference of the radar \
distances of the two worldlines at one radar time."
}], "Item",ExpressionUUID->"f391017c-2bf1-49ac-800f-6169e603bbbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"3", "/", "5"}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"radar", " ", "=", " ", 
      RowBox[{"p", " ", "|->", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"BondiRadarCoordinates", "[", 
           RowBox[{"p", ",", " ", "phi"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<RadarTime\>\"", ",", " ", "\"\<RadarDistance\>\""}], 
           "}"}]}], "]"}]}]}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tan", "[", "phi", "]"}], ",", " ", "v"}], "}"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"radar", "[", "u", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"radar", "[", "n", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{"v", " ", 
        RowBox[{
         RowBox[{"radar", "[", "n", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"LorentzFactor", "[", "v", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"9809aa48-cf3b-4fda-a1d9-c220eb7f9eb0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["4", "5"], ",", 
   FractionBox["4", "5"]}], "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"cc524407-550e-4eb5-840c-6e194892f039"]
}, Open  ]],

